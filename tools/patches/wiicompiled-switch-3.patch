+        logged(ch[1].in, Load32(ch[1].in), Fctiwz(Mul(rp, outGain)));
+        lastInt = Fctiwz(Mul(sp2, outGain));
+        logged(ch[2].in, Load32(ch[2].in), lastInt);
+        ch[0].in += 4u; ch[1].in += 4u; ch[2].in += 4u;
+        if (busOutDesc != 0u) {
+            logged(o3, Load32(o3), Fctiwz(Mul(lp, sendGain)));
+            logged(o5, Load32(o5), Fctiwz(Mul(rp, sendGain)));
