+        k.one = LoadF(r2 - 32660u);
+        k.zero = LoadF(r2 - 32656u);
+        k.half = LoadF(r2 - 32644u);
+        k.su = LoadF(sp + 96u);
+        k.sv = LoadF(sp + 100u);
