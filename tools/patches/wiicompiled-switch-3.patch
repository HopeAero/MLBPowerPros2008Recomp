+            logged(o6, Load32(o6), lastInt);
+            o3 += 4u; o5 += 4u; o6 += 4u;
+        }
+        e0 = Step(e0, earlyLength); e1 = Step(e1, earlyLength); e2 = Step(e2, earlyLength);
+        if (predelayLength != 0u) pp = Step(pp, predelayLength);
+        cj[0] = Step(cj[0], combLength[0]); cj[1] = Step(cj[1], combLength[1]); cj[2] = Step(cj[2], combLength[2]);
+        lastK1 = ak[1];
+        ak[0] = Step(ak[0], allpassLength[0]); ak[1] = Step(ak[1], allpassLength[1]);
+    }
