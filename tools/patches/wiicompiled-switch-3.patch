+[[gnu::always_inline]] inline V PMerge01(V a, V b) { return vcopy_lane_f32(b, 1, a, 1); }  // {a.ps0, b.ps1}
+[[gnu::always_inline]] inline V PMerge10(V a, V b) { return vext_f32(b, a, 1); }           // {a.ps1, b.ps0}
+[[gnu::always_inline]] inline V PMerge11(V a, V b) { return vtrn1_f32(b, a); }             // {a.ps1, b.ps1}
+
+[[gnu::always_inline]] inline V Bc(uint32_t bits) { return vreinterpret_f32_u32(vdup_n_u32(bits)); }
+
+inline uint64_t Raw(V pair) { return vget_lane_u64(vreinterpret_u64_f32(pair), 0); }
+
+inline bool Wraps(uint32_t address, uint32_t length) { return address > UINT32_MAX - (length - 1u); }
+inline bool Overlap(uint32_t a, uint32_t alen, uint32_t b, uint32_t blen) {
+    return uint64_t{a} < uint64_t{b} + blen && uint64_t{b} < uint64_t{a} + alen;
+}
+inline bool Mmio(uint32_t address) { return (address & 0xFE000000u) == 0xCC000000u; }
+
+// The 5 constants (f29 f28 f27 f26 f25 at k): each zero or normal, magnitude below 2^8.
+[[gnu::always_inline]] inline bool GoodConstants(uint32_t k) {
+    const uint32x4_t first = vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(Host(k))));
+    const uint32x4_t fifth = vdupq_n_u32(Rd32(k + 16u));
+    const uint32x4_t any = vdupq_n_u32(0x7FFFFFFFu), limit = vdupq_n_u32(0x43800000u), normal = vdupq_n_u32(0x00800000u);
+    const uint32x4_t m1 = vandq_u32(first, any), m2 = vandq_u32(fifth, any);
+    const uint32x4_t ok1 = vandq_u32(vcltq_u32(m1, limit), vorrq_u32(vceqzq_u32(m1), vcgeq_u32(m1, normal)));
+    const uint32x4_t ok2 = vandq_u32(vcltq_u32(m2, limit), vorrq_u32(vceqzq_u32(m2), vcgeq_u32(m2, normal)));
+    return vminvq_u32(vandq_u32(ok1, ok2)) != 0u;
+}
+
+// The 64 dequantization singles: none NaN, infinite or of magnitude 2^23 or more. vld4 splits the
+// big-endian singles by byte; byte 0 holds the sign and the top 7 exponent bits: <= 74 means a
+// biased exponent below 150.
+[[gnu::always_inline]] inline bool GoodTable(uint32_t table) {
+    const uint8_t* const host = Host(table);
+    const uint8x16_t mask = vdupq_n_u8(0x7F);
+    const uint8x16_t a = vandq_u8(vld4q_u8(host).val[0], mask), b = vandq_u8(vld4q_u8(host + 64).val[0], mask),
+                     c = vandq_u8(vld4q_u8(host + 128).val[0], mask), d = vandq_u8(vld4q_u8(host + 192).val[0], mask);
+    return vmaxvq_u8(vmaxq_u8(vmaxq_u8(a, b), vmaxq_u8(c, d))) <= 74u;
+}
+
+// What the entry checks leave to the body.
+struct Plane {
+    uint32_t stride;  // *(r13-28640)
+    uint32_t out;     // *(r13-28608)
+};
+
+// The registers the natives read, and write on the fast path. The registered functions copy them from
+// and to the CpuContext with literal indexes (the translator derives the call contract from those).
+struct In {
+    uint32_t r1, r2, r3, r4, r13, cr, xer, gqr0;
+};
+struct Out {
+    uint32_t r0, r3, r4, r5, r6, r7, r8, r10, cr, ctr;
+    uint64_t f[14];  // f0-f13
+};
+
+// The entry checks. On success the back chain is stored; the body re-reads what it needs.
+[[gnu::always_inline]] inline bool Check(const In& in, bool y8, Plane& plane) {
+    if (GuestFlat::RequiresCheckedAccess() || in.gqr0 != 0u) return false;
+    const uint32_t r1 = in.r1;
+    Wr32(r1 - 128u, r1);  // stwu r1, -128(r1): the translation's first action (idempotent when it runs after us)
+    const uint32_t k = in.r2 - 30792u, g = in.r13 - 28672u, coef = in.r3;
+    if (Wraps(k, 20u) || Wraps(g, 68u) || Wraps(coef, 144u)) return false;
+    if (Overlap(g, 68u, kWorkspace, 256u) || Overlap(coef, 144u, kWorkspace, 256u)) return false;
+    const uint32_t table = Rd32(g);
+    if (Wraps(table, 264u) || Overlap(table, 264u, kWorkspace, 256u)) return false;
+    if (!GoodConstants(k) || !GoodTable(table)) return false;
+    const uint32_t stride = Rd32(g + 32u), out = Rd32(g + 64u);
+    const uint32_t first = (y8 ? (stride << 3) : 0u) + (in.r4 << 2);
+    const uint32_t o6 = out + first, o7 = o6 + (stride << 2);
+    if (Wraps(o6, 38u) || Wraps(o7, 38u) || Mmio(o6) || Mmio(o6 + 37u) || Mmio(o7) || Mmio(o7 + 37u)) return false;
+    if (Overlap(o6, 38u, kWorkspace, 256u) || Overlap(o7, 38u, kWorkspace, 256u) || Overlap(o6, 38u, o7, 38u)) return false;
+    plane = {stride, out};
+    return true;
+}
