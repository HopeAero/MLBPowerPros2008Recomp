diff --git a/runtime/src/platform/switch/switch_thread_placement.cpp b/runtime/src/platform/switch/switch_thread_placement.cpp
new file mode 100644
index 0000000..624bd23
--- /dev/null
+++ b/runtime/src/platform/switch/switch_thread_placement.cpp
@@ -0,0 +1,173 @@
+// Core 0 belongs to the game's main thread (the guest fibers, priority 0x2C).
+//
+// libnx starts every pthread (std::thread, SDL_CreateThread, Mesa's thrd_create, Dawn's workers)
+// through __syscall_thread_create: threadCreate(prio 0x3B, core -2) and then
+// svcSetThreadCoreMask(handle, -1, <process core mask>), i.e. allowed on cores 0, 1 and 2. Horizon
+// then runs those threads on core 0 whenever the main thread blocks for a moment (a fiber switch
+// wait, a FIFO handoff), and the main thread pays the switch back and the cache they evicted.
+// SwitchWakerHD (Wind Waker HD on Switch) measured 20 -> 28 fps in a CPU-bound scene by giving its
+// main thread a core of its own.
+//
+// Here that one libnx call is rewritten while the new thread is still suspended: its affinity
+// becomes WIICOMPILED_SWITCH_THREAD_MASK (default 0x6: cores 1 and 2; 0 keeps libnx's mask), ideal
+// core the highest core in it. Threads that pin themselves later (SwitchPinCurrentThread: the GX
+// FIFO worker, the frame worker, the presenter, the AX mixer, deko3d's shader worker) still do.
+// Linked with -Wl,--wrap=__syscall_thread_create -Wl,--wrap=svcSetThreadCoreMask
+// (PublicProducts.cmake); only the call made inside __syscall_thread_create is changed.
+//
+// WIICOMPILED_SWITCH_THREADS=1 (nxlink argument; N > 1: every N seconds, else every 60 s) prints
+// every thread created that way plus the main thread: ideal core, affinity mask, priority and CPU
+// time per interval ("[threads] ..." on stderr). entry/run are link-time addresses (nm -n of
+// WiiCompiled.elf): entry is the pthread start routine; for a std::thread, run is its _M_run.
+#if defined(__SWITCH__)
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <switch.h>
+
+extern "C" {
+int __real___syscall_thread_create(void* thread, void* (*func)(void*), void* arg, void* stack_addr,
+                                   size_t stack_size);
+Result __real_svcSetThreadCoreMask(Handle handle, s32 preferred_core, u32 affinity_mask);
+extern char __start__[];      // switch.ld: image start (code)
+extern char __rodata_start[]; // end of code
+extern char __relro_start[];  // .data.rel.ro (vtables) ...
+extern char __data_start[];   // ... ends here
+extern char* fake_heap_start; // libsysbase's heap bounds, set by libnx
+extern char* fake_heap_end;
+}
+
+namespace mlb_switch_threads {
+
+struct Created {
+    Handle handle;
+    u64 tid;
+    u64 entry, arg, run; // link-time addresses (run: std::thread _State's _M_run, else 0)
+    u64 lastTicks;
+    std::atomic<bool> ready;
+};
+
+constexpr int kMaxCreated = 96;
+Created g_created[kMaxCreated];
+std::atomic<int> g_count{0};  // slots handed out (a slot is valid once .ready)
+std::atomic<bool> g_dumperStarted{false};
+Thread g_dumper;
+
+// The pthread being created on this thread, between __syscall_thread_create and its core-mask call.
+thread_local void* (*t_start)(void*) = nullptr;
+thread_local void* t_arg = nullptr;
+
+u32 PlacementMask() {
+    const char* text = std::getenv("WIICOMPILED_SWITCH_THREAD_MASK");
+    return text ? u32(std::strtoul(text, nullptr, 0)) & 0x7u : 0x6u;
+}
+
+u64 LinkAddress(const void* p) {
+    return p ? u64(reinterpret_cast<uintptr_t>(p) - reinterpret_cast<uintptr_t>(__start__)) : 0;
+}
+
+// std::thread hands pthread a heap _State* whose vtable (in .data.rel.ro) has _M_run at slot 2.
+u64 StdThreadRun(void* arg) {
+    const auto a = reinterpret_cast<uintptr_t>(arg);
+    if (a % 8 || a < uintptr_t(fake_heap_start) || a + 8 > uintptr_t(fake_heap_end)) return 0;
+    const auto vtable = *reinterpret_cast<const uintptr_t*>(a);
+    if (vtable % 8 || vtable < uintptr_t(__relro_start) || vtable + 24 > uintptr_t(__data_start)) return 0;
+    const auto run = reinterpret_cast<const uintptr_t*>(vtable)[2];
+    if (run < uintptr_t(__start__) || run >= uintptr_t(__rodata_start)) return 0;
+    return u64(run - uintptr_t(__start__));
+}
+
+u64 ThreadTicks(Handle handle) {
+    u64 ticks = 0;
+    if (R_FAILED(svcGetInfo(&ticks, InfoType_ThreadTickCount, handle, u64(-1)))) return u64(-1);
+    return ticks;
+}
+
+void DumpOne(const char* label, Handle handle, u64& lastTicks) {
+    s32 ideal = -9, prio = -1;
+    u64 mask = 0, tid = 0;
+    const Result rm = svcGetThreadCoreMask(&ideal, &mask, handle);
+    svcGetThreadPriority(&prio, handle);
+    svcGetThreadId(&tid, handle);
+    const u64 ticks = ThreadTicks(handle);
+    const u64 delta = (ticks != u64(-1) && lastTicks != 0 && ticks >= lastTicks) ? ticks - lastTicks : 0;
+    if (ticks != u64(-1)) lastTicks = ticks;
+    std::fprintf(stderr, "[threads] %s tid=%lu ideal=%d mask=0x%lx prio=0x%x cpu_ms=%lu interval_ms=%lu%s\n",
+                 label, tid, ideal, mask, unsigned(prio), ticks == u64(-1) ? 0 : armTicksToNs(ticks) / 1000000,
+                 armTicksToNs(delta) / 1000000, R_FAILED(rm) ? " (handle gone)" : "");
+}
+
+void Dump() {
+    static u64 mainLast = 0;
+    const int count = g_count.load(std::memory_order_acquire);
+    std::fprintf(stderr, "[threads] dump: %d pthreads created, placement mask 0x%x, sampled on core %u\n",
+                 count, PlacementMask(), svcGetCurrentProcessorNumber());
+    DumpOne("main", envGetMainThreadHandle(), mainLast);
+    for (int i = 0; i < count && i < kMaxCreated; ++i) {
+        Created& c = g_created[i];
+        if (!c.ready.load(std::memory_order_acquire)) continue;
+        char label[96];
+        std::snprintf(label, sizeof label, "#%d created_tid=%lu entry=0x%lx run=0x%lx", i, c.tid, c.entry, c.run);
+        DumpOne(label, c.handle, c.lastTicks);
+    }
+    std::fflush(stderr);
+}
+
+void DumperMain(void*) {
+    const char* text = std::getenv("WIICOMPILED_SWITCH_THREADS");
+    const long every = text ? std::atol(text) : 0;
+    const u64 period = u64(every > 1 ? every : 60) * 1000000000ull;
+    for (;;) {
+        svcSleepThread(s64(period));
+        Dump();
+    }
+}
+
+void MaybeStartDumper() {
+    if (g_dumperStarted.load(std::memory_order_relaxed)) return;
+    const char* text = std::getenv("WIICOMPILED_SWITCH_THREADS");
+    if (text == nullptr || std::atol(text) <= 0 || g_dumperStarted.exchange(true)) return;
+    // Core 2, libnx's preemptive priority: it sleeps all the time and must stay off core 0.
+    if (R_SUCCEEDED(threadCreate(&g_dumper, DumperMain, nullptr, nullptr, 0x8000, 0x3B, 2)))
+        threadStart(&g_dumper);
+}
+
+} // namespace mlb_switch_threads
+
+extern "C" int __wrap___syscall_thread_create(void* thread, void* (*func)(void*), void* arg,
+                                              void* stack_addr, size_t stack_size) {
+    using namespace mlb_switch_threads;
+    MaybeStartDumper();
+    t_start = func;
+    t_arg = arg;
+    const int rc = __real___syscall_thread_create(thread, func, arg, stack_addr, stack_size);
+    t_start = nullptr;
+    t_arg = nullptr;
+    return rc;
+}
+
+extern "C" Result __wrap_svcSetThreadCoreMask(Handle handle, s32 preferred_core, u32 affinity_mask) {
+    using namespace mlb_switch_threads;
+    if (t_start == nullptr || preferred_core != -1) {
+        return __real_svcSetThreadCoreMask(handle, preferred_core, affinity_mask);
+    }
+    // libnx's own call for the thread __syscall_thread_create just made (not started yet).
+    const int slot = g_count.fetch_add(1, std::memory_order_relaxed);
+    if (slot < kMaxCreated) {
+        Created& c = g_created[slot];
+        c.handle = handle;
+        c.tid = 0;
+        svcGetThreadId(&c.tid, handle);
+        c.entry = LinkAddress(reinterpret_cast<void*>(t_start));
+        c.arg = reinterpret_cast<uintptr_t>(t_arg);
+        c.run = StdThreadRun(t_arg);
+        c.lastTicks = 0;
+        c.ready.store(true, std::memory_order_release);
+    }
+    t_start = nullptr;  // one call per creation
+    const u32 mask = PlacementMask() & affinity_mask;
+    if (mask == 0) return __real_svcSetThreadCoreMask(handle, preferred_core, affinity_mask);
+    const s32 ideal = 31 - __builtin_clz(mask);
+    return __real_svcSetThreadCoreMask(handle, ideal, mask);
+}
+#endif
diff --git a/runtime/src/platform/switch/switch_threads.cpp b/runtime/src/platform/switch/switch_threads.cpp
new file mode 100644
index 0000000..e8aa273
--- /dev/null
+++ b/runtime/src/platform/switch/switch_threads.cpp
@@ -0,0 +1,11 @@
+// Core and priority for threads that libnx would start at 0x3B on the default core
+// (aurora.cpp's frame worker and presenter, the AX mixer). Lower number = higher priority;
+// the game's main thread runs at 0x2C on core 0.
+#if defined(__SWITCH__)
+#include <switch.h>
+
+extern "C" void SwitchPinCurrentThread(int core, int priority) {
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1u << core);
+    svcSetThreadPriority(CUR_THREAD_HANDLE, priority);
+}
+#endif
