+                h.scratch = Add(Mul(out, fusedGain), early);
+            }
+        }
+        // Crosstalk between L, R, S; written back in place and to the bus.
+        const float l = ch[0].scratch, r = ch[1].scratch, sv = ch[2].scratch;
