+using System;
+using System.IO;
+using Translator.Core.Analysis;
+using Xunit;
+
+namespace Translator.Tests;
+
+/// <summary>
+/// The native effect analyzer reads each native's own body text. A native that reads pc/lr of the current context
+/// only to log an error keeps a narrow, signature-derived contract when that read lives in a helper function, and
+/// gets the whole-context contract when it is spelled in the body (the situation this split removes).
+/// </summary>
+public sealed class RuntimeNativeLogOnlyContextTests
+{
+    private static RuntimeNativeGuestEffectSet Analyze(string source)
+    {
+        var directory = Path.Combine(Path.GetTempPath(), $"mkw-native-logonly-{Guid.NewGuid():N}");
+        Directory.CreateDirectory(directory);
+        try
+        {
+            File.WriteAllText(Path.Combine(directory, "fixture.cpp"), source);
+            return RuntimeNativeGuestEffectAnalyzer.AnalyzeDirectory(directory);
+        }
+        finally
+        {
+            Directory.Delete(directory, recursive: true);
+        }
+    }
+
+    [Fact]
+    public void ContextReadInsideTheBodyGivesTheWholeContextContract()
+    {
+        var effects = Analyze("""
+            extern "C" void LogsInBody(uint32_t first, uint32_t second) {
+                if (first == 0) {
+                    auto* cpu = TryGetCpuContext();
+                    Log(cpu ? cpu->pc : 0u);
+                }
+                Work(first, second);
+            }
+            PPC_NATIVE_OVERRIDE_VOID(80001234, LogsInBody, (uint32_t first, uint32_t second), (first, second));
+            """);
+
+        var contract = effects.Contracts[0x80001234u];
+        Assert.True((contract.BoundaryFlags & GuestCallBoundaryFlags.RequiresCompleteContext) != 0);
+        Assert.NotEqual((1u << 3) | (1u << 4), contract.GprReadBeforeWriteMask);
+    }
+
+    [Fact]
+    public void ContextReadMovedToAHelperKeepsTheSignatureContract()
+    {
+        var effects = Analyze("""
+            __attribute__((noinline)) static void DiagPcLr(uint32_t& pc, uint32_t& lr) {
+                auto* cpu = TryGetCpuContext();
+                pc = cpu ? cpu->pc : 0u;
+                lr = cpu ? cpu->lr : 0u;
+            }
+            extern "C" void LogsInHelper(uint32_t first, uint32_t second) {
+                if (first == 0) {
+                    uint32_t pc, lr;
+                    DiagPcLr(pc, lr);
+                    Log(pc, lr);
+                }
+                Work(first, second);
+            }
+            PPC_NATIVE_OVERRIDE_VOID(80001234, LogsInHelper, (uint32_t first, uint32_t second), (first, second));
+            """);
+
+        var contract = effects.Contracts[0x80001234u];
+        Assert.False(contract.HasFullSynchronizationFence);
+        Assert.Equal((1u << 3) | (1u << 4), contract.GprReadBeforeWriteMask);
+        Assert.Equal(0u, contract.GprPossibleWriteMask);
+        Assert.Contains(0x80001234u, effects.PreciseContracts);
+    }
+}
