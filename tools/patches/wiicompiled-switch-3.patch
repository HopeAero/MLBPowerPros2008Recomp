+// GX__CallDisplayList_80172f64 (runtime/src/hle/gx/gx_dl.cpp): one per display-list call (P20).
+extern "C" void SwitchProfilerCountDl() { g_dlCalls.fetch_add(1, std::memory_order_relaxed); }
+
+extern "C" void SwitchProfilerDump() {
+    if (!g_running.exchange(false)) return;
+    threadWaitForExit(&g_thread);
+    threadClose(&g_thread);
+    std::fprintf(stderr, "[profile] anchor=0x%lx samples=%lu failed=%lu\n",
+                 reinterpret_cast<u64>(&SwitchProfilerStart), g_samples, g_failed);
+    for (const auto& [pc, count] : g_pc) std::fprintf(stderr, "[profile] P %lx %u\n", pc, count);
+    for (const auto& [lr, count] : g_lr) std::fprintf(stderr, "[profile] L %lx %u\n", lr, count);
+    std::fprintf(stderr, "[profile] late samples=%lu (host frame past 17 ms)\n", g_lateSamples);
+    for (const auto& [pc, count] : g_latePc) std::fprintf(stderr, "[profile] Q %lx %u\n", pc, count);
+    for (const auto& [lr, count] : g_lateLr) std::fprintf(stderr, "[profile] R %lx %u\n", lr, count);
