+using V = float32x2_t;
+
+constexpr uint32_t kWorkspace = 0x802B6860u;  // 64 singles, row-major, 32 bytes per row
+
+[[gnu::always_inline]] inline uint8_t* Host(uint32_t address) { return MKW_FLAT_GUEST_BASE + address; }
+
+[[gnu::always_inline]] inline uint32_t Rd32(uint32_t address) {
+    uint32_t value;
+    std::memcpy(&value, Host(address), sizeof value);
+    return __builtin_bswap32(value);
+}
+[[gnu::always_inline]] inline uint32_t Rd16(uint32_t address) {
+    uint16_t value;
+    std::memcpy(&value, Host(address), sizeof value);
+    return __builtin_bswap16(value);
+}
+[[gnu::always_inline]] inline void Wr32(uint32_t address, uint32_t value) {
+    value = __builtin_bswap32(value);
+    std::memcpy(Host(address), &value, sizeof value);
+}
