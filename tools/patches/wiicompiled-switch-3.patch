+
+// One instruction each, so nothing can be fused, reassociated or widened.
+[[gnu::always_inline]] inline float Mul(float a, float b) { float r; __asm__("fmul %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+[[gnu::always_inline]] inline float Add(float a, float b) { float r; __asm__("fadd %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+[[gnu::always_inline]] inline float Sub(float a, float b) { float r; __asm__("fsub %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+// fmax returns a NaN when either operand is one: the running "any NaN stored" test.
+[[gnu::always_inline]] inline float Max(float a, float b) { float r; __asm__("fmax %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+[[gnu::always_inline]] inline float FromInt(uint32_t v) { float r; __asm__("scvtf %s0, %w1" : "=w"(r) : "r"(v)); return r; }
+[[gnu::always_inline]] inline double Widen(float a) { double r; __asm__("fcvt %d0, %s1" : "=w"(r) : "w"(a)); return r; }
+// fctiwz of a single: saturating, toward zero, NaN -> 0x80000000 (PpcClampIntegerWordInline).
+[[gnu::always_inline]] inline uint32_t Fctiwz(float a) {
+    uint32_t r;
+    __asm__("fcvtzs %w0, %s1" : "=r"(r) : "w"(a));
+    return a != a ? 0x80000000u : r;
+}
+
+// ---- ranges ----
+
+// Cache hints (PRFM: no fault, no guest-visible effect). Run 26 profile: 78% of this function's samples sit on its
+// loads of the delay lines and sample buffers (about 40 streams, each one word per sample, each one new 64-byte line
+// per 16 samples, cold after the 3 ms the game runs between two calls). Every 16 samples the lines the next 16 need.
+[[gnu::always_inline]] inline void PfLine(uint32_t address) { __builtin_prefetch(MKW_FLAT_GUEST_BASE + address, 1, 3); }
+[[gnu::always_inline]] inline void PfAhead(uint32_t address, bool first) {
+    if (first) { PfLine(address); PfLine(address + 60u); }
+    PfLine(address + 64u);
+    PfLine(address + 124u);
+}
+
+struct Area { uint64_t lo, hi; };
+
+inline bool Plain(uint64_t lo, uint64_t hi) {
+    return hi <= 0x100000000ull && (hi <= 0xCC000000ull || lo >= 0xCE000000ull);
+}
+inline bool Overlap(uint64_t lo, uint64_t hi, const Area& a) { return lo < a.hi && a.lo < hi; }
+
+struct Guard {
+    Area stack, work, consts;
+    bool ok;
+    void Range(uint64_t lo, uint64_t hi) {
+        if (lo >= hi) return;
+        ok = ok && Plain(lo, hi) && !Overlap(lo, hi, stack) && !Overlap(lo, hi, work) && !Overlap(lo, hi, consts);
+    }
+    // The slots a line indexed by `index` (wrapping at `length`) touches over 96 samples.
+    void Line(uint32_t base, uint32_t index, uint32_t length) {
+        const uint64_t b = base;
+        if (index < length) {
+            if (length - index >= 96u) Range(b + 4ull * index, b + 4ull * index + 384u);
+            else Range(b, b + 4ull * length);
+        } else {  // index, then 0, 1, ... (only 0 when the length is 0)
+            Range(b + 4ull * index, b + 4ull * index + 4u);
+            Range(b, b + 4ull * (length == 0u ? 1u : (length < 96u ? length : 96u)));
+        }
+    }
+};
+
+[[gnu::always_inline]] inline uint32_t Step(uint32_t index, uint32_t length) {
+    const uint32_t next = index + 1u;
+    return next < length ? next : 0u;
+}
+
+// ---- rollback ----
+
+struct UndoEntry { uint32_t address, old; };
+constexpr uint32_t kUndoCapacity = 96u * 30u;  // per sample: 3 x (early, predelay, 3 combs, 3 all-passes) + 6 outputs
+UndoEntry g_undo[kUndoCapacity];
+
+// ---- the call ----
+
+struct Channel {
+    uint32_t early, predelay, comb[3], allpass[2], last;  // line base addresses
+    uint32_t lastIndex, lastLength;
+    float lowpass;
+    uint32_t in, busIn, out;                              // sample pointers
+    float scratch;                                        // [sp+20+4ch]
+};
+
+[[gnu::noinline, gnu::cold]] void Translated(CpuContext& context) { func_800BC3AC(&context); }
+
+// Returns false, with nothing written, when the translation must run the call.
+bool Run(CpuContext& c) {
+    const uint32_t r1 = c.gpr[1], r2 = c.gpr[2], r3 = c.gpr[3], w = c.gpr[4];
+    if (r1 < 112u || r2 < 30268u) return false;
+    const uint32_t sp = r1 - 112u;
+    const uint32_t kc = r2 - 30268u;
+    Guard g{{sp, uint64_t(sp) + 120u}, {w, uint64_t(w) + 0x148u}, {kc, uint64_t(kc) + 28u}, true};
+    if (!Plain(g.stack.lo, g.stack.hi) || !Plain(g.work.lo, g.work.hi) || !Plain(g.consts.lo, g.consts.hi)) return false;
+    if (Overlap(g.stack.lo, g.stack.hi, g.work) || Overlap(g.stack.lo, g.stack.hi, g.consts) ||
+        Overlap(g.work.lo, g.work.hi, g.consts))
+        return false;
+    if (Load32(w + 268u) != 0u) return false;  // the bypass path (clears bit 1): rare, translation
+    if (Load64(kc + 20u) != 0x4330000080000000ull) return false;
+
+    const uint32_t busInDesc = Load32(w + 312u), busOutDesc = Load32(w + 316u);
+    const auto descriptorOk = [&](uint32_t d) {
+        return Plain(d, uint64_t(d) + 12u) && !Overlap(d, uint64_t(d) + 12u, g.stack);
+    };
+    if (!descriptorOk(r3) || (busInDesc != 0u && !descriptorOk(busInDesc)) ||
