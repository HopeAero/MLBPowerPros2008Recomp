+[[gnu::always_inline]] inline uint32_t Rotl(uint32_t v, unsigned s) { return (v << s) | (v >> ((32u - s) & 31u)); }
+[[gnu::always_inline]] inline uint32_t Mulhw(uint32_t a, uint32_t b) {
+    return static_cast<uint32_t>((static_cast<int64_t>(static_cast<int32_t>(a)) * static_cast<int32_t>(b)) >> 32);
