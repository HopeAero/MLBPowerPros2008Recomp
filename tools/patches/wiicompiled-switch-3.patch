index 0000000..ab533ff
--- /dev/null
+++ b/runtime/src/hle/mlb/light_natives.cpp
@@ -0,0 +1,390 @@
+// MLB Power Pros 2008 (RL8E54): a native 0x80061220, the per-mesh light colours of the model
+// draw (P29 profile, heavy windows: 0.19 ms/frame self, plus ~0.15 ms in the callees below).
+//
+// void LightColors(?, Material* m) runs per mesh while the byte at r13-28816 (0x8031AFD0, set by
+// 0x80060C60) is set. Ambient: the bytes m+4..m+6 go to floats through the magic-number trick
+// (stw 0x43300000 / stw byte / lfd, fsubs the double at r2-30888), fmuls the scale at r2-30896,
+// the float at r2-30892 is the fourth component; the four are multiplied by the table at
+// 0x802B5910 (leaf 0x800562E4) and passed to 0x800459DC(gfx, v), gfx = [r13-30108]. Lights: the
+// bytes m+8..m+B (the same bytes for both) scaled and multiplied by the tables 0x802B5920 + 16 i
+// go to 0x80045BCC(gfx, i, v) for i = 0, 1. Both callees skip the GX call when the byte
+// gfx+0x2180 is set and 0x80056328 finds the four floats equal to their cache (ambient
+// gfx+0x2070, light i gfx+0x20C0 + 16 i). Otherwise they copy v to the cache, turn it into a
+// GXColor (0x8005643C: fmuls by r2-31112, fadds r2-31116, fctiwz, four stb) and call
+// GXSetChanAmbColor(4, &c) (0x800C655C), or build a GXLightObj on the stack (colour at +0xC,
+// position from gfx+0x20A0 + 16 i at +0x28) and call GXLoadLightObjImm(&obj, id) (0x800C64E0)
+// with id from r2-31488 / r2-31484.
+//
+// The translation spends ~1550 instructions on a call whose caches all hit (qemu count, see the
+// snippet header): five calls with their CpuContext syncs, the stack round trips of the scratch
+// slots, and the scalar-single emulation of 31 fsubs/fmuls (each fmuls rounds its second operand
+// to 25 bits, each result goes through a double and every stfs through Gekko's narrowing). Here
+// the chain is one function: every guest store of the chain is made (frame, register saves,
+// scratch slots, the four callee frames, the 0x8005643C frames, the cache copies, the GXLightObj
+// fields), the values it reads back from its own stack are forwarded, and the colours are
+// computed in host singles. The GX natives are called as the translated callees call them
+// (InvokeDirectCpu with r3/r4 set, the same guest memory in place).
+//
+// Why host singles give the translation's bits, on the fast path's inputs (the magic double is
+// 2^52 exactly; the scale, the alpha and the 12 table floats are zero or normal, the scale below
+// 2^110): byte + 2^52 - 2^52 is the byte exactly, so the colour is fmuls(scale, byte), whose
+// product is exact in a double (24 + 8 bits): one rounding to single, which is the single
+// multiply's (FPCR.FZ: both go through FPRound, flushing a tiny result before rounding, and no
+// input is subnormal; any rounding mode). The colour (finite, |c| < 2^118) and the table entry
+// are singles, so PpcForce25BitInline is the identity, the product is exact in a double, and
+// fmuls is again the single multiply: finite or infinite, never NaN. A single that is not NaN
+// survives stfs + lfs unchanged (subnormal only without FZ, where both are exact), so every
+// forwarded slot holds what the reload would give, and lfs is the same FCVT here as there. The
+// four lanes of a NEON fmul / fcmeq are the scalar instructions (AArch64 AdvSIMD honours FPCR's
+// FZ, DN and rounding mode; nothing reads the host's cumulative FPSR flags). The compare
+// (0x80056328) of two widened singles is the single compare (under FZ both flush a subnormal
+// cache value to zero). The miss path (0x8005643C, the cache copies, the light positions) and
+// the prologue's psq_st / epilogue's psq_l use the translation's helpers.
+//
+// Guards, all checked before the first store, any failure runs the translation (kept by
+// REGISTER_NATIVE_FUNCTION_AS) for the whole call: the inputs above; checked access mode; the
+// stack the chain writes ([sp-160, r1+8), sp the 16-byte aligned frame), the bytes near r13
+// (flag, gfx pointer), the material bytes, the constants [r2-31488, r2-30880), the tables
+// 0x802B5910..0x802B593F and the gfx area [gfx+0x2070, gfx+0x2181) (caches, light positions,
+// cache flag) are plain RAM (no wrap, outside the MMIO window), the stack is disjoint from all of
+// them and the gfx area from the other inputs. So no store of the chain changes an input, the
+// inputs can be read once, and the stack slots hold exactly what this function stored. The GX
+// natives read guest memory (the colour word, the GXLightObj) and write none.
+//
+// The CpuContext at return is the translation's, all of it: r0 (LR), r1, r3-r7 as the last
+// 0x80045BCC call leaves them, r10-r12, f0-f5 as the last compare, 0x8005643C or the light
+// position loads leave them, CR (CR0 = EQ|SO, the loop's last cmpw), XER (subfic's CA), r27-r31,
+// f30, f31 and LR as they came in. WIICOMPILED_MLB_LIGHT_NATIVE=0 runs the translation (A/B).
+// Cross-checked against the translated chain in qemu-aarch64 (local/tmp/cpu/LIGHT).
+//
+// This file builds like the translated code (-O2 -fno-fast-math -ffp-contract=off, outside the
+// unity build: runtime/CMakeLists.txt).
+#if defined(__SWITCH__)
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include <arm_neon.h>
+
+#include "abi_bridge.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+
+extern "C" void func_80061220(CpuContext* ctx);  // the translation (kept: _AS registration)
+
+namespace mlb_light {
+
+inline uint8_t* Host(uint32_t address) { return MKW_FLAT_GUEST_BASE + address; }
+
+inline uint8_t Load8(uint32_t address) { return *Host(address); }
+
+inline uint32_t Load32(uint32_t address) {
+    uint32_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap32(raw);
+}
+
+inline uint64_t Load64(uint32_t address) {
+    uint64_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap64(raw);
+}
+
+inline void Store32(uint32_t address, uint32_t value) {
+    const uint32_t raw = __builtin_bswap32(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
+}
+
+inline void Store64(uint32_t address, uint64_t value) {
+    const uint64_t raw = __builtin_bswap64(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
+}
+
+inline uint32_t Bits(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof bits);
+    return bits;
+}
+
+inline float Float(uint32_t bits) {
+    float value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+// lfs: the loaded single widened as FlatReadFloat32's caller does (FCVT; FZ flushes a subnormal).
+inline double Lfs(uint32_t bits) { return static_cast<double>(Float(bits)); }
+
+// stfs: Gekko's narrowing, as FlatWrite(Ram)Float32 stores it.
+inline uint32_t Stfs(double value) { return MemoryInline::ConvertPpcDoubleToSingleBits(value); }
+
+// Four big-endian words / singles at a guest address, and back.
+inline uint32x4_t LoadWords(uint32_t address) { return vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(Host(address)))); }
+inline void StoreWords(uint32_t address, float32x4_t value) {
+    vst1q_u8(Host(address), vrev32q_u8(vreinterpretq_u8_f32(value)));
+}
+
+// [address, address + length) neither wraps nor touches 0xCC000000-0xCDFFFFFF.
+inline bool Plain(uint32_t address, uint64_t length) {
+    const uint64_t end = static_cast<uint64_t>(address) + length;
+    return end <= 0x100000000ull && (end <= 0xCC000000ull || address >= 0xCE000000u);
+}
+
+inline bool Disjoint(uint64_t a, uint64_t aLength, uint64_t b, uint64_t bLength) {
+    return a + aLength <= b || b + bLength <= a;
+}
+
+// Zero or normal (not subnormal, infinite or NaN): one word, or all ones in the lanes that are not.
+inline bool Tame(uint32_t bits) {
+    const uint32_t exponent = bits & 0x7F800000u;
+    return exponent != 0x7F800000u && (exponent != 0 || (bits & 0x7FFFFFFFu) == 0);
+}
+
+inline uint32x4_t Wild(uint32x4_t bits) {
+    const uint32x4_t exponent = vandq_u32(bits, vdupq_n_u32(0x7F800000u));
+    return vorrq_u32(vceqq_u32(exponent, vdupq_n_u32(0x7F800000u)),
+                     vandq_u32(vceqzq_u32(exponent), vtstq_u32(bits, vdupq_n_u32(0x7FFFFFFFu))));
+}
+
+// 0x80056328(cache, v) compares the lfs pairs in order and stops at the first difference: equal
+// when all four lanes are (the double compare of two widened singles is the single compare, FZ
+// flushing a subnormal in both); its r6 is "the first two equal".
+inline uint32x4_t Equal(uint32_t cacheAt, float32x4_t v) {
+    return vceqq_f32(vreinterpretq_f32_u32(LoadWords(cacheAt)), v);
+}
+
+// 0x8005643C(v): GXColor from four lfs values, with the translation's helpers; the word (r3),
+// its r5 (red's fctiwz word) and the f0-f5 it leaves. Also its frame under sp (stwu r1,-48(r1);
+// four stb at +8..+11).
+struct Colour8 {
+    uint32_t word, r5;
+    double f[6];
+};
+
+[[gnu::noinline]] Colour8 ToColour(uint32_t sp, const double v[4], double scale, double bias) {
+    double f3 = PpcFmulsInline(scale, v[0]);
+    double f2 = PpcFmulsInline(scale, v[1]);
+    double f1 = PpcFmulsInline(scale, v[2]);
+    double f0 = PpcFmulsInline(scale, v[3]);
+    f3 = static_cast<double>(PpcForceSingleValueInline(bias + f3));
+    f2 = static_cast<double>(PpcForceSingleValueInline(bias + f2));
+    f1 = static_cast<double>(PpcForceSingleValueInline(bias + f1));
+    f0 = static_cast<double>(PpcForceSingleValueInline(bias + f0));
+    f3 = PPC_Fctiwz(f3);
+    f2 = PPC_Fctiwz(f2);
+    f1 = PPC_Fctiwz(f1);
+    f0 = PPC_Fctiwz(f0);
+    const uint32_t w0 = PPC_FprLowWordInline(f3), w1 = PPC_FprLowWordInline(f2);
+    const uint32_t w2 = PPC_FprLowWordInline(f1), w3 = PPC_FprLowWordInline(f0);
+    Colour8 c;
+    c.word = ((w0 & 255u) << 24) | ((w1 & 255u) << 16) | ((w2 & 255u) << 8) | (w3 & 255u);
+    c.r5 = w0;
+    c.f[0] = f0; c.f[1] = f1; c.f[2] = f2; c.f[3] = f3; c.f[4] = bias; c.f[5] = scale;
+    Store32(sp - 48u, sp);
+    Store32(sp - 40u, c.word);
+    return c;
+}
+
+// WIICOMPILED_MLB_LIGHT_NATIVE=0 runs the translation (A/B); on otherwise.
+int g_state = 0;  // 0 unresolved, 1 on, 2 off; guest code runs on one host thread
+
+[[gnu::noinline, gnu::cold]] void Resolve() {
+    const char* v = std::getenv("WIICOMPILED_MLB_LIGHT_NATIVE");
+    g_state = v != nullptr && v[0] == '0' ? 2 : 1;
+}
+
+constexpr uint32_t kTables = 0x802B5910u;  // ambient 4 floats, then 2 x 4 for the lights
+constexpr uint64_t kTablesLength = 48u;
+
+}  // namespace mlb_light
+
+extern "C" void MLB_LightColors_80061220(CpuContext* ctx) {
+    using namespace mlb_light;
+    HleTraceCall("MLB_LightColors_80061220");
+    if (g_state != 1) [[unlikely]] {
+        if (g_state == 0) Resolve();
+        if (g_state != 1) {
+            func_80061220(ctx);
+            return;
+        }
+    }
+    const uint32_t r1 = ctx->gpr[1], r2 = ctx->gpr[2], r4 = ctx->gpr[4], r13 = ctx->gpr[13];
+    const uint32_t sp = r1 - 128u - (r1 & 15u);  // clrlwi / subfic / stwux
+    // The stack the chain writes: 0x8005643C's back chain under 0x80045BCC's frame (sp-160) up to
+    // the LR save word at r1+4.
+    const uint32_t low = sp - 160u;
+    const uint64_t stackLength = static_cast<uint64_t>(r1) + 8u - low;
+    const uint32_t flagAt = r13 - 28816u;
+    if (GuestFlat::RequiresCheckedAccess() || r1 < 0x200u || r1 > 0xFFFFFF00u || !Plain(low, stackLength) ||
+        !Plain(flagAt, 1u) || !Disjoint(flagAt, 1u, low, stackLength)) [[unlikely]] {
+        func_80061220(ctx);
+        return;
+    }
+    const uint8_t enabled = Load8(flagAt);
+
+    uint32_t gfx = 0;
+    float32x4_t ambient{}, light0{}, light1{}, colour{};
+    uint32x4_t bytesA{}, bytesL{};
+    if (enabled != 0) {
+        const uint32_t gfxAt = r13 - 30108u, material = r4 + 4u, constants = r2 - 31488u;
+        constexpr uint64_t kMaterialLength = 8u, kConstantsLength = 31488u - 30880u, kAreaLength = 0x2181u - 0x2070u;
+        bool ok = Plain(gfxAt, 4u) && Disjoint(gfxAt, 4u, low, stackLength) && Plain(material, kMaterialLength) &&
+                  Plain(constants, kConstantsLength) && Disjoint(material, kMaterialLength, low, stackLength) &&
+                  Disjoint(constants, kConstantsLength, low, stackLength) &&
+                  Disjoint(kTables, kTablesLength, low, stackLength);
+        if (ok) {
+            gfx = Load32(gfxAt);
+            const uint32_t area = gfx + 0x2070u;
+            ok = Plain(area, kAreaLength) && Disjoint(area, kAreaLength, low, stackLength) &&
+                 Disjoint(area, kAreaLength, flagAt, 1u) && Disjoint(area, kAreaLength, gfxAt, 4u) &&
+                 Disjoint(area, kAreaLength, material, kMaterialLength) &&
+                 Disjoint(area, kAreaLength, constants, kConstantsLength) &&
+                 Disjoint(area, kAreaLength, kTables, kTablesLength);
+        }
+        if (ok) {
+            const uint32_t scaleBits = Load32(r2 - 30896u), alphaBits = Load32(r2 - 30892u);
+            const uint32x4_t t0 = LoadWords(kTables), t1 = LoadWords(kTables + 16u), t2 = LoadWords(kTables + 32u);
+            ok = Load64(r2 - 30888u) == 0x4330000000000000ull && Tame(scaleBits) &&
+                 (scaleBits & 0x7F800000u) < 0x76800000u && Tame(alphaBits) &&  // |scale| < 2^110
+                 vmaxvq_u32(vorrq_u32(Wild(t0), vorrq_u32(Wild(t1), Wild(t2)))) == 0;
+            // m+4 .. m+B as words; the colours (ucvtf is exact on a byte) and the products.
+            const uint16x8_t bytes = vmovl_u8(vld1_u8(Host(material)));
+            bytesA = vmovl_u16(vget_low_u16(bytes));
+            bytesL = vmovl_high_u16(bytes);
+            const float scale = Float(scaleBits);
+            const float32x4_t colourA = vsetq_lane_f32(Float(alphaBits), vmulq_n_f32(vcvtq_f32_u32(bytesA), scale), 3);
+            colour = vmulq_n_f32(vcvtq_f32_u32(bytesL), scale);
+            ambient = vmulq_f32(colourA, vreinterpretq_f32_u32(t0));
+            light0 = vmulq_f32(colour, vreinterpretq_f32_u32(t1));
+            light1 = vmulq_f32(colour, vreinterpretq_f32_u32(t2));
+        }
+        if (!ok) [[unlikely]] {
+            func_80061220(ctx);
+            return;
+        }
+    }
+
+    // Prologue: back chain, LR, f31/f30 as stfd + psq_st pairs, _savegpr_27.
+    const uint32_t lr = ctx->lr;
+    Store32(sp, r1);
+    Store32(r1 + 4u, lr);
+    Store64(r1 - 16u, ctx->fpr[31].raw);
+    PPC_PsqStStackInline<0u, 0u>(ctx, r1 - 8u, PPC_PsFromScalarInline(ctx->fpr[31].d));
+    Store64(r1 - 32u, ctx->fpr[30].raw);
+    PPC_PsqStStackInline<0u, 0u>(ctx, r1 - 24u, PPC_PsFromScalarInline(ctx->fpr[30].d));
+    for (uint32_t reg = 27; reg <= 31; ++reg) Store32(r1 - 52u + 4u * (reg - 27u), ctx->gpr[reg]);
+    Store32(sp + 48u, 0x43300000u);
+    Store32(sp + 56u, 0x43300000u);
+
+    uint32_t r3 = 0x43300000u;
+    if (enabled != 0) {
+        const uint8_t cached = Load8(gfx + 0x2180u);
+
+        // Ambient: v = (m+4, m+5, m+6 scaled, alpha) * table 0, at sp+32; 0x800459DC(gfx, sp+32).
+        StoreWords(sp + 32u, ambient);
+        Store32(sp + 52u, vgetq_lane_u32(bytesA, 0));
+        Store32(sp + 60u, vgetq_lane_u32(bytesA, 1));
+        const uint32_t s2 = sp - 32u;  // frame; LR 0x800612E0 at sp+4; r31, r30 saved
+        Store32(s2, sp);
+        Store32(sp + 4u, 0x800612E0u);
+        Store32(s2 + 28u, ctx->gpr[31]);
+        Store32(s2 + 24u, ctx->gpr[30]);
+        if (cached == 0 || vminvq_u32(Equal(gfx + 0x2070u, ambient)) == 0) {
+            float v[4];
+            vst1q_f32(v, ambient);
+            double copy[4];
+            for (uint32_t k = 0; k < 4; ++k) {
+                const uint32_t bits = Stfs(static_cast<double>(v[k]));
+                Store32(gfx + 0x2070u + 4u * k, bits);
+                copy[k] = Lfs(bits);
+            }
+            const Colour8 c = ToColour(s2, copy, Lfs(Load32(r2 - 31112u)), Lfs(Load32(r2 - 31116u)));
+            Store32(s2 + 12u, c.word);
+            Store32(s2 + 8u, c.word);
+            ctx->gpr[3] = 4u;
+            ctx->gpr[4] = s2 + 8u;
+            InvokeDirectCpu<0x800C655Cu>(ctx);  // GXSetChanAmbColor(GX_COLOR0A0, &c)
+        }
+
+        // Lights 0 and 1: v = (m+8 .. m+B scaled) * table 1 + i, at sp+16; 0x80045BCC(gfx, i, v).
+        const uint32_t id0 = Load32(r2 - 31488u), id1 = Load32(r2 - 31484u);
+        const uint32_t s3 = sp - 112u;  // frame; LR 0x80061378 at sp+4; r31/r30/r29 = 16 i, table, 2
+        Store32(sp + 52u, vgetq_lane_u32(bytesL, 0));
+        Store32(sp + 60u, vgetq_lane_u32(bytesL, 1));
+        uint32_t r4o = 0, r5o = 0, r6o = 0;
+        double f[6] = {};
+        for (uint32_t i = 0; i < 2; ++i) {
+            const float32x4_t light = i == 0 ? light0 : light1;
+            StoreWords(sp + 16u, light);
+            Store32(s3, sp);
+            Store32(sp + 4u, 0x80061378u);
+            Store32(s3 + 108u, 16u * i);
+            Store32(s3 + 104u, 0x802B5920u);
+            Store32(s3 + 100u, 2u);
+            Store32(s3 + 16u, id0);
+            Store32(s3 + 20u, id1);
+            const uint32_t cacheAt = gfx + 0x20C0u + 16u * i;
+            uint32x4_t equal = vdupq_n_u32(0);
+            if (cached != 0) {
+                equal = Equal(cacheAt, light);
+                if (vminvq_u32(equal) != 0) {
+                    r3 = 1;
+                    r4o = sp + 16u;
+                    r5o = 1;
+                    r6o = 1;
+                    f[0] = vgetq_lane_f32(light, 3);
+                    f[1] = Lfs(Load32(cacheAt + 12u));
+                    f[2] = vgetq_lane_f32(light, 2);
+                    f[3] = vgetq_lane_f32(colour, 2);
+                    f[4] = vgetq_lane_f32(light, 1);
+                    f[5] = vgetq_lane_f32(light, 0);
+                    continue;
+                }
+            }
+            float v[4];
+            vst1q_f32(v, light);
+            double reload[4];
+            for (uint32_t k = 0; k < 4; ++k) {
+                reload[k] = static_cast<double>(v[k]);
+                Store32(cacheAt + 4u * k, Stfs(reload[k]));
+            }
+            const Colour8 c = ToColour(s3, reload, Lfs(Load32(r2 - 31112u)), Lfs(Load32(r2 - 31116u)));
+            Store32(s3 + 8u, c.word);
+            Store32(s3 + 36u, c.word);  // GXInitLightColor (leaf 0x800C64D4)
+            const uint32_t position = gfx + 0x20A0u + 16u * i;
+            for (uint32_t k = 0; k < 3; ++k) {
+                f[1 + k] = Lfs(Load32(position + 4u * k));
+                Store32(s3 + 64u + 4u * k, Stfs(f[1 + k]));  // GXInitLightPos (leaf 0x800C64C4)
+            }
+            const uint32_t id = i == 0 ? id0 : id1;
+            r3 = s3 + 24u;
+            r4o = id;
+            r5o = c.r5;
+            r6o = cached != 0 ? (vgetq_lane_u32(equal, 0) & vgetq_lane_u32(equal, 1) & 1u) : id1;
+            f[0] = c.f[0]; f[4] = c.f[4]; f[5] = c.f[5];
+            ctx->gpr[3] = r3;
+            ctx->gpr[4] = id;
+            InvokeDirectCpu<0x800C64E0u>(ctx);  // GXLoadLightObjImm(&obj, id)
+        }
+        ctx->gpr[4] = r4o;
+        ctx->gpr[5] = r5o;
+        ctx->gpr[6] = r6o;
+        ctx->gpr[7] = id0;
+        for (uint32_t k = 0; k < 6; ++k) ctx->fpr[k].d = f[k];
+    }
+
+    // Epilogue: the psq_l pair (its value replaced by the lfd), _restgpr_27, LR from the frame.
+    const uint32_t gqr0 = ctx->gqr[0];
+    (void)PPC_PsqLGqrInline<0u, 0u>(ctx, gqr0, r1 - 8u);
+    (void)PPC_PsqLGqrInline<0u, 0u>(ctx, gqr0, r1 - 24u);
+    const uint32_t xer = ctx->xer;
+    ctx->gpr[0] = lr;
+    ctx->gpr[3] = r3;
+    ctx->gpr[10] = r1;
+    ctx->gpr[11] = r1 - 32u;
+    ctx->gpr[12] = r1;
+    ctx->cr = (ctx->cr & 0x0FFFFFFFu) | ((2u | (xer >> 31)) << 28);  // CR0: the last cmpw, equal
+    ctx->xer = xer | 0x20000000u;                                     // subfic's carry
+}
+REGISTER_NATIVE_FUNCTION_AS(0x80061220, MLB_LightColors_80061220, "LightColors");
+#endif
