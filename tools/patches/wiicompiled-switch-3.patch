+[[gnu::always_inline]] inline void Write32(uint8_t* base, uint32_t a, uint32_t v) {
+    if (MemoryInline::FlatWriteNeedsPolicy(a)) [[unlikely]] { MemoryInline::Write32Slow(a, v); return; }
