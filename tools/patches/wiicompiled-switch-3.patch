+[[gnu::always_inline]] inline Q QMsub(Q a, Q c, Q b) { return vfmaq_f32(vnegq_f32(b), a, c); }
+
+// The columns' 8 results, row i of the block (rows 0-3 go to the first half, 4-7 to the second).
+struct Columns {
+    Q out[8];
+    Q f[14];  // f0-f13 as the translation's last iteration leaves them (this group's lanes)
+};
+
+[[gnu::always_inline]] inline Columns Transform(const uint8_t* ws, Q k25, Q k26, Q k27, Q k28, Q k29) {
+    Columns r;
+    Q f10 = LdQ(ws + 0 * 32), f11 = LdQ(ws + 4 * 32), f12 = LdQ(ws + 2 * 32), f13 = LdQ(ws + 6 * 32);
+    Q f6 = vaddq_f32(f10, f11);
+    Q f8 = vsubq_f32(f10, f11);
+    f6 = vaddq_f32(f6, k25);
+    Q f7 = vaddq_f32(f12, f13);
+    Q f9 = vsubq_f32(f12, f13);
+    f8 = vaddq_f32(f8, k25);
+    Q f0 = vaddq_f32(f6, f7);
+    f9 = QMsub(f9, k29, f7);
+    Q f4 = LdQ(ws + 1 * 32);
+    Q f3 = vsubq_f32(f6, f7);
+    Q f5 = LdQ(ws + 3 * 32);
+    f6 = LdQ(ws + 5 * 32);
+    f7 = LdQ(ws + 7 * 32);
+    Q f1 = vaddq_f32(f8, f9);
+    Q f2 = vsubq_f32(f8, f9);
+    f8 = vaddq_f32(f6, f5);
+    f9 = vaddq_f32(f4, f7);
+    f6 = vsubq_f32(f6, f5);
+    f4 = vsubq_f32(f4, f7);
+    f7 = vaddq_f32(f9, f8);
+    f5 = vsubq_f32(f9, f8);
+    f8 = vaddq_f32(f6, f4);
+    f9 = vaddq_f32(f0, f7);
+    const Q f30 = vsubq_f32(f0, f7);
+    r.out[0] = f9;
+    r.out[7] = f30;
+    f8 = vmulq_f32(f8, k28);
+    f6 = vfmaq_f32(f8, f6, k26);
+    f4 = QMsub(f4, k27, f8);
+    f6 = vsubq_f32(f6, f7);
+    f9 = vaddq_f32(f1, f6);
+    f5 = QMsub(f5, k29, f6);
+    const Q f31 = vsubq_f32(f1, f6);
+    r.out[1] = f9;
+    r.out[6] = f31;
+    f8 = vaddq_f32(f2, f5);
+    f4 = vaddq_f32(f4, f5);
+    r.out[2] = f8;
+    f9 = vsubq_f32(f3, f4);
+    f0 = vaddq_f32(f3, f4);
+    r.out[3] = f9;
+    f1 = vsubq_f32(f2, f5);
+    r.out[4] = f0;
+    r.out[5] = f1;
+    r.f[0] = f0; r.f[1] = f1; r.f[2] = f2; r.f[3] = f3; r.f[4] = f4; r.f[5] = f5; r.f[6] = f6;
+    r.f[7] = f7; r.f[8] = f8; r.f[9] = f9; r.f[10] = f10; r.f[11] = f11; r.f[12] = f12; r.f[13] = f13;
+    return r;
+}
