+// ---- the idle-voice skip ----
+//
+// A voice is "idle" when its walk below does nothing but loads and the 4-word frame of the inlined
+// __MIXRmtUpdateSettings call: its channel entry has no AXVPB (word 0 == 0), or it has one and the entry
+// flags (+4) have none of 0xF0000000 (the 0x20000000 / 0x10000000 / 0x80000000 / 0x40000000 update
+// blocks) and the remote entry's first word has neither 0xC0000000 bit. That is nearly every voice of
+// nearly every call (one call per channel fader change, 64 voices each). The frame stores of an idle
+// voice with an AXVPB are the same four words for every voice (r1, LR = 0x800C1188, and the r30 / r31
+// the call saves, which the matching loads give back), so a run of idle voices stores them once.
+// Exact when none of the four words can be read by the run (no overlap with the globals, the channel
+// entries or the remote entries it loads: checked per run, else nothing is skipped) and the registers
+// the walk would leave are rebuilt: r5 / r4 / r3 of the last voice, r6 = r7 = 0 and r8 = the flags of
+// the last voice with an AXVPB (r6-r8 are untouched by a voice without one), r26 / r27 stepped.
+// CR0 / r0 are set by the loop test after it, and r1 / r30 / r31 / LR end as the epilogue loads them.
+struct Skipped {
+    uint32_t idx;      // first voice not skipped (the start voice when none was)
+    uint32_t chTab;    // r13-27112 as read
+    uint32_t rmTab;    // r13-27096 as read
+    uint32_t r3, r4;   // what the last skipped voice leaves in r3 / r4
+    uint32_t flags;    // r8 the last skipped voice with an AXVPB leaves
+    uint32_t any;      // a skipped voice had an AXVPB
+};
+
+[[gnu::always_inline]] inline uint32_t LoadP32(const uint8_t* p) {
+    uint32_t v; std::memcpy(&v, p, 4); return __builtin_bswap32(v);
+}
+
+// a if cond is nonzero else b, as one csel (no data-dependent branch per voice).
+[[gnu::always_inline]] inline const uint8_t* SelectIf(uint32_t cond, const uint8_t* a, const uint8_t* b) {
+    const uint8_t* r;
+    __asm__("cmp %w3, #0\n\tcsel %0, %1, %2, ne" : "=r"(r) : "r"(a), "r"(b), "r"(cond) : "cc");
+    return r;
+}
