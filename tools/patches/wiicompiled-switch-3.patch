+                if (count <= 0) continue;
+                if (!MeshFits(c, r30, r27, r26, static_cast<uint64_t>(count))) MLB_ENVMAP_ROLLBACK();
+                for (; static_cast<int32_t>(r24) < count; ++r24, r30 += 12u, r27 += 12u, r26 += 8u)
