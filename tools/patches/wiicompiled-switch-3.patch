+++ b/runtime/src/platform/switch/switch_profiler.cpp
@@ -0,0 +1,555 @@
+// Sampling profiler on Horizon: svcSetThreadActivity pauses the main thread (which runs the guest
+// fibers), svcGetThreadContext3 reads where it is, and it resumes. Started and dumped by the match
+// benchmark (match_benchmark_overlay.inc) when WIICOMPILED_SWITCH_PROFILE=1.
+//
+// S8 (switch phase 54): WIICOMPILED_SWITCH_SPIKES=<ms> (also starts the sampler) keeps the last ~4 s
+// of samples with their host frame (SwitchProfilerFrame) and, for every host frame longer than <ms>,
+// keeps that frame's samples: PC, LR and up to 6 return addresses found on the stack above SP (words
+// in the code segment right after a BL/BLR; the translated code is built -fomit-frame-pointer, so a
+// frame-pointer walk would skip every guest frame), plus the frame's file reads/opens, new aurora
+// pipelines, deko3d shader code growth and the longest time without an Audio_HLE_Tick. Printed with
+// the profile as "[spike] ..." lines (local/tmp/cpu/S8-test/prof_spikes.py names them). Without the
+// timed benchmark (WIICOMPILED_MATCH_SECONDS unset) the capture starts at the first host frame
+// (settings_overlay::Draw), marks every host frame and prints what it has every 30 s, so a normal game
+// played over nxlink shows its spikes; WIICOMPILED_SWITCH_SPIKES_MAX caps the spikes (default 40).
+#if defined(__SWITCH__)
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <unordered_map>
+#include <utility>
+#include <switch.h>
+
+#include <aurora/gfx.h>  // aurora_get_stats: createdPipelines
+
+extern "C" void SwitchProfilerStart();                // below: the anchor the dumps give
+extern "C" bool SwitchUsesDeko3d();                   // tools/switch/deko/aurora/dk_present.cpp
+extern "C" void SwitchSpikeIoEnable();                // switch_io.cpp
+extern "C" void SwitchSpikeIoTotals(u64 out[4]);      // switch_io.cpp: main count/ticks, others count/ticks
+namespace swdk {
+uint64_t frames_completed();  // tools/switch/deko/core/memory.cpp (takes the fence lock)
+uint32_t code_used();         // shader code memory in use (takes the code lock)
+} // namespace swdk
+
+namespace {
+std::atomic<bool> g_running{false};
+Thread g_thread;
+std::unordered_map<u64, u32> g_pc, g_lr;
+u64 g_samples = 0, g_failed = 0;
+// P12: optional paired core-1 PC/LR samples; the worker publishes its real handle once.
+std::atomic<Handle> g_gxThread{0};
+bool g_gxEnabled = false;
+u64 g_gxSamples = 0, g_gxPauseFailed = 0, g_gxReadFailed = 0, g_gxResumeFailed = 0;
+u64 g_gxUnregistered = 0, g_gxMainResumeFailed = 0, g_gxFrameChanged = 0;
+// samples taken while the host frame in progress is already past 17 ms (SwitchProfilerFrame marks each
+// frame's start): what the main thread does in the frames that miss a vblank
+std::atomic<u64> g_frameStart{0};
+std::unordered_map<u64, u32> g_latePc, g_lateLr;
+u64 g_lateSamples = 0;
+
+// ---- S8 spikes. Main thread: g_spkFrame, the request queue's tail. Sampler thread: everything else.
+constexpr u32 kSpkRa = 6;              // return addresses kept per sample
+constexpr u32 kSpkRing = 4096;         // the last ~4 s of samples
+constexpr u32 kSpkStore = 12288;       // samples kept over all the spikes
+constexpr u32 kSpkPerSpike = 256;      // samples kept per spike (a load frame: its last 256)
+constexpr u32 kSpkMax = 256;           // spikes kept
+constexpr u32 kSpkQueue = 32;          // spike requests the sampler has not taken yet
+constexpr u64 kSpkScanBytes = 16384;   // stack bytes scanned above SP
+constexpr u32 kSpkFrames = 64;         // per-frame context ring
+
+struct SpkSample {
+    u64 tick, pc, lr;
+    u64 gxTick, gxPc, gxLr;  // zero tick: no paired worker context
+    u64 ra[kSpkRa];
+    u32 frame, raCount;
+};
+// What the sampler saw when a frame began (first sample of it), and the frame's longest audio gap.
+struct SpkContext {
+    u32 frame = ~0u;
+    u64 io[4] = {};   // SwitchSpikeIoTotals
+    u32 pipelines = 0, codeBytes = 0;
+    u64 dkFrame = 0;
+    u64 audioGapTicks = 0;
+};
+struct SpkRequest {
+    u32 frame;
+    u64 start, end;
+};
+struct Spike {
+    SpkRequest request;
+    u32 first, count;
+    SpkContext begin, finish;  // finish: the next frame's begin
+};
+
+u64 g_spkThresholdNs = 0;  // 0: off
+u64 g_spkBenchStart = 0;
+std::atomic<u32> g_spkFrame{0};  // host frames ended since the start = the frame in progress
+u64 g_spkLastEnd = 0;
+SpkRequest g_spkQueue[kSpkQueue];
+std::atomic<u32> g_spkHead{0}, g_spkTail{0};
+u32 g_spkQueueFull = 0;
+std::atomic<u64> g_spkAudioTickAt{0};  // SwitchSpikeAudioTick
+SpkSample* g_spkRing = nullptr;
+u64 g_spkRingNext = 0;
+SpkSample* g_spkStore = nullptr;
+u32 g_spkStoreUsed = 0;
+Spike* g_spikes = nullptr;
+u32 g_spikeCount = 0, g_spikesDropped = 0;
+SpkContext g_spkFrames[kSpkFrames];
+u32 g_spkSeen = ~0u;
+u64 g_spkTextLo = 0, g_spkTextHi = 0;
+bool g_spkDeko = false;
+bool g_spkFree = false;     // started by the first host frame (no match benchmark): flushed every 30 s
+u32 g_spkLimit = 40;        // spikes per session (WIICOMPILED_SWITCH_SPIKES_MAX, at most kSpkMax)
+u32 g_spkTotal = 0;         // spikes recorded this session
+u64 g_spkLastFlush = 0;
+u64 g_spkUpperNs = 0;       // longer frames are loads, not spikes (WIICOMPILED_SWITCH_SPIKES_UPTO; free-running: 150)
+u32 g_spkLong = 0;          // frames skipped for that
+char* g_spkText = nullptr;  // one spike's lines, written with one fwrite
+constexpr size_t kSpkTextSize = 64 * 1024;  // P12: room for P + optional W at all 256 samples
+
+// A word on the stack that is a return address: in the code segment, right after a BL or BLR.
+bool SpkIsReturn(u64 a) {
+    if (a < g_spkTextLo + 4 || a >= g_spkTextHi || (a & 3) != 0) return false;
+    const u32 insn = *reinterpret_cast<const u32*>(a - 4);
+    return (insn & 0xFC000000u) == 0x94000000u || (insn & 0xFFFFFC1Fu) == 0xD63F0000u;
+}
+
+// While the main thread is paused: its stack from SP up, within the readable block SP is in (queried
+// every time: transfer memory taken from the heap changes the permissions of heap pages).
+u32 SpkScanStack(u64 sp, u64* out) {
+    MemoryInfo info{};
+    u32 page = 0;
+    if (R_FAILED(svcQueryMemory(&info, &page, sp)) || (info.perm & Perm_R) == 0 || info.type == MemType_Unmapped)
+        return 0;
+    const u64 end = std::min(info.addr + info.size, (sp & ~u64(7)) + kSpkScanBytes);
+    u32 n = 0;
+    for (u64 p = sp & ~u64(7); p < end && n < kSpkRa; p += 8) {
+        const u64 v = *reinterpret_cast<const volatile u64*>(p);
+        if (SpkIsReturn(v)) out[n++] = v;
+    }
+    return n;
+}
+
+void SpkSnapshot(SpkContext& c, u32 frame) {
+    c = {};
+    c.frame = frame;
+    SwitchSpikeIoTotals(c.io);
+    if (const AuroraStats* stats = aurora_get_stats()) {
+        c.pipelines = *reinterpret_cast<const volatile u32*>(&stats->createdPipelines);
+    }
+    if (g_spkDeko) {
+        c.codeBytes = swdk::code_used();
+        c.dkFrame = swdk::frames_completed();
+    }
+}
+
+// Sampler thread, after each sample: the frame's context, then the spikes whose next frame has begun.
+void SpkAfterSample(u32 frame, u64 tick) {
+    if (frame != g_spkSeen) {
+        SpkSnapshot(g_spkFrames[frame % kSpkFrames], frame);
+        g_spkSeen = frame;
+    }
+    SpkContext& now = g_spkFrames[frame % kSpkFrames];
+    const u64 audio = g_spkAudioTickAt.load(std::memory_order_relaxed);
+    if (audio && tick > audio) now.audioGapTicks = std::max(now.audioGapTicks, tick - audio);
+    for (u32 head = g_spkHead.load(std::memory_order_relaxed); head != g_spkTail.load(std::memory_order_acquire);
+         g_spkHead.store(++head, std::memory_order_release)) {
+        const SpkRequest r = g_spkQueue[head % kSpkQueue];
+        if (r.frame >= frame) return;  // the next frame's context comes with its first sample
+        if (g_spikeCount == kSpkMax || g_spkTotal >= g_spkLimit) { ++g_spikesDropped; continue; }
+        ++g_spkTotal;
+        Spike& s = g_spikes[g_spikeCount++];
+        s.request = r;
+        s.first = g_spkStoreUsed;
+        s.count = 0;
+        const u64 held = std::min<u64>(g_spkRingNext, kSpkRing);
+        u64 from = g_spkRingNext - held, matching = 0;
+        for (u64 i = from; i < g_spkRingNext; ++i) matching += g_spkRing[i % kSpkRing].frame == r.frame;
+        u64 skip = matching > kSpkPerSpike ? matching - kSpkPerSpike : 0;
+        for (u64 i = from; i < g_spkRingNext && g_spkStoreUsed < kSpkStore; ++i) {
+            const SpkSample& x = g_spkRing[i % kSpkRing];
+            if (x.frame != r.frame) continue;
+            if (skip) { --skip; continue; }
+            g_spkStore[g_spkStoreUsed++] = x;
+            ++s.count;
+        }
+        const SpkContext& b = g_spkFrames[r.frame % kSpkFrames];
+        const SpkContext& f = g_spkFrames[(r.frame + 1) % kSpkFrames];
+        s.begin = b.frame == r.frame ? b : SpkContext{};
+        s.finish = f.frame == r.frame + 1 ? f : SpkContext{};
+    }
+}
+
+// Main has already resumed. Never scan the worker stack or hold it while collecting other stats.
+void SampleGx(SpkSample& spike, bool mainResumed) {
+    spike.gxTick = 0;
+    if (!mainResumed) { ++g_gxMainResumeFailed; return; }
+    const Handle worker = g_gxThread.load(std::memory_order_acquire);
+    if (!worker) { ++g_gxUnregistered; return; }
+    if (R_FAILED(svcSetThreadActivity(worker, ThreadActivity_Paused))) { ++g_gxPauseFailed; return; }
+    const u32 frame = g_spkFrame.load(std::memory_order_relaxed);
+    const u64 tick = armGetSystemTick();
+    ThreadContext context{};
+    const bool read = frame == spike.frame && R_SUCCEEDED(svcGetThreadContext3(&context, worker));
+    const bool sameFrame = frame == spike.frame && g_spkFrame.load(std::memory_order_relaxed) == frame;
+    // Resume on every successful pause, including a failed read or a frame that advanced.
+    if (R_FAILED(svcSetThreadActivity(worker, ThreadActivity_Runnable))) ++g_gxResumeFailed;
+    if (!sameFrame) { ++g_gxFrameChanged; return; }
+    if (!read) { ++g_gxReadFailed; return; }
+    spike.gxTick = tick;
+    spike.gxPc = context.pc.x;
+    spike.gxLr = context.lr;
+    ++g_gxSamples;
+}
+
+// WIICOMPILED_SWITCH_PROFILE_DL=1 (with a free-running spike capture): main-thread PC histograms
+// bucketed by the previous host frame's GX__CallDisplayList calls (a proxy for the models on camera:
+// players, bats, the ball), cumulative, printed every 30 s ([pdl] lines), to find the code whose
+// per-frame cost grows with the players on screen. Buckets of kDlWidth calls; the sampler fills and
+// prints the histograms, the main thread only counts and picks the bucket once per host frame.
+constexpr u32 kDlBuckets = 16, kDlWidth = 40;
+std::atomic<u32> g_dlCalls{0}, g_dlBucket{0};
+std::atomic<u32> g_dlFrames[kDlBuckets];
+std::unordered_map<u64, u32> g_dlPc[kDlBuckets];
+u64 g_dlLastPrint = 0;
+bool DlProfileOn() {
+    static const bool on = [] {
+        const char* v = std::getenv("WIICOMPILED_SWITCH_PROFILE_DL");
+        return v != nullptr && v[0] == '1';
+    }();
+    return on;
+}
+void DlMaybePrint() {
+    if (!DlProfileOn() || !g_spkFree) return;
+    const u64 now = armGetSystemTick();
+    if (!g_dlLastPrint) g_dlLastPrint = now;
+    if (armTicksToNs(now - g_dlLastPrint) < 30'000'000'000ull) return;
+    g_dlLastPrint = now;
+    std::fprintf(stderr, "[pdl] anchor=0x%lx width=%u\n", reinterpret_cast<u64>(&SwitchProfilerStart), kDlWidth);
+    for (u32 b = 0; b < kDlBuckets; ++b) {
+        const u32 frames = g_dlFrames[b].load(std::memory_order_relaxed);
+        if (!frames) continue;
+        std::fprintf(stderr, "[pdl] bucket=%u frames=%u\n", b, frames);
+        for (const auto& [pc, count] : g_dlPc[b]) {
+            if (count >= 3) std::fprintf(stderr, "[pdl] P %u %lx %u\n", b, pc, count);
+        }
+    }
+    std::fflush(stderr);
+}
+
+void SampleOnce(Handle main) {
+    if (R_FAILED(svcSetThreadActivity(main, ThreadActivity_Paused))) { ++g_failed; return; }
+    ThreadContext context{};
+    const bool read = R_SUCCEEDED(svcGetThreadContext3(&context, main));
+    SpkSample* spike = nullptr;
+    if (read && g_spkThresholdNs) {  // the stack only while the main thread is paused
+        spike = &g_spkRing[g_spkRingNext % kSpkRing];
+        spike->frame = g_spkFrame.load(std::memory_order_relaxed);
+        spike->tick = armGetSystemTick();
+        spike->raCount = SpkScanStack(context.sp, spike->ra);
+    }
+    const bool resumed = R_SUCCEEDED(svcSetThreadActivity(main, ThreadActivity_Runnable));
+    if (!read) { ++g_failed; return; }
+    if (spike) {
+        spike->pc = context.pc.x;
+        spike->lr = context.lr;
+        if (g_gxEnabled) SampleGx(*spike, resumed);
+        ++g_spkRingNext;
+        SpkAfterSample(spike->frame, spike->tick);
+    }
+    ++g_pc[context.pc.x];
+    ++g_lr[context.lr];
+    ++g_samples;
+    if (DlProfileOn()) ++g_dlPc[g_dlBucket.load(std::memory_order_relaxed)][context.pc.x];
+    const u64 start = g_frameStart.load(std::memory_order_relaxed);
+    if (start && armTicksToNs(armGetSystemTick() - start) > 17'000'000) {
+        ++g_latePc[context.pc.x];
+        ++g_lateLr[context.lr];
+        ++g_lateSamples;
+    }
+}
+
+void SpkPrint();
+
+// Free-running (no benchmark dump at the end): the spikes so far every 30 s, or when the store could
+// not take another full spike. Printed from the sampler thread, one fwrite per spike.
+void SpkMaybeFlush() {
+    if (g_spkFree && g_spikeCount &&
+        (armTicksToNs(armGetSystemTick() - g_spkLastFlush) >= 30'000'000'000ull ||
+         g_spkStoreUsed + kSpkPerSpike > kSpkStore || g_spikeCount == kSpkMax)) {
+        SpkPrint();
+    }
+}
+
+// WIICOMPILED_SWITCH_PROFILE_WINDOW=<s> (with a free-running spike capture): the main thread's PC/LR
+// histograms of every <s> seconds of a played game, then cleared, so windows (fielding with many
+// players on screen, pitching) can be compared. Printed and cleared by the sampler thread that fills them.
+u64 g_winStart = 0, g_winSamples = 0, g_winLate = 0;
+void WindowMaybeFlush() {
+    static const u64 windowNs = [] {
+        const char* v = std::getenv("WIICOMPILED_SWITCH_PROFILE_WINDOW");
+        return v ? u64(std::strtod(v, nullptr) * 1e9) : u64(0);
+    }();
+    if (!windowNs || !g_spkFree) return;
+    const u64 now = armGetSystemTick();
+    if (!g_winStart) g_winStart = now;
+    if (armTicksToNs(now - g_winStart) < windowNs) return;
+    std::fprintf(stderr, "[pwin] anchor=0x%lx t=%.1f frame=%u samples=%lu\n", reinterpret_cast<u64>(&SwitchProfilerStart),
+                 double(armTicksToNs(now - g_spkBenchStart)) / 1e9, g_spkFrame.load(std::memory_order_relaxed),
+                 g_samples - g_winSamples);
+    for (const auto& [pc, count] : g_pc) std::fprintf(stderr, "[pwin] P %lx %u\n", pc, count);
+    for (const auto& [lr, count] : g_lr) std::fprintf(stderr, "[pwin] L %lx %u\n", lr, count);
+    std::fprintf(stderr, "[pwin] late=%lu\n", g_lateSamples - g_winLate);
+    for (const auto& [pc, count] : g_latePc) std::fprintf(stderr, "[pwin] Q %lx %u\n", pc, count);
+    std::fflush(stderr);
+    g_pc.clear();
+    g_lr.clear();
+    g_latePc.clear();
+    g_lateLr.clear();
+    g_winSamples = g_samples;
+    g_winLate = g_lateSamples;
+    g_winStart = now;
+}
+
+void Sample(void*) {
+    const Handle main = envGetMainThreadHandle();
+    while (g_running.load(std::memory_order_relaxed)) {
+        svcSleepThread(1'000'000);
+        SampleOnce(main);
+        SpkMaybeFlush();
+        WindowMaybeFlush();
+        DlMaybePrint();
+    }
+}
+} // namespace
+
+// Called by the GX FIFO worker after pinning itself; no extra thread or scheduling changes.
+extern "C" void SwitchProfilerRegisterGxThread() {
+    g_gxThread.store(threadGetCurHandle(), std::memory_order_release);
+}
+
+// Mode, renderer and clocks right now, so a report says whether it ran docked, handheld or
+// overclocked (sys-clk changes them under the game). Phase 25 puts it in the benchmark summary.
+extern "C" const char* SwitchClocks() {
+    static char text[160];
+    u32 hz[3] = {};
+    const PcvModuleId ids[3] = {PcvModuleId_CpuBus, PcvModuleId_GPU, PcvModuleId_EMC};
+    const bool clkrst = R_SUCCEEDED(clkrstInitialize());
+    for (int i = 0; clkrst && i < 3; ++i) {
+        ClkrstSession session;
+        if (R_SUCCEEDED(clkrstOpenSession(&session, ids[i], 3))) {
+            clkrstGetClockRate(&session, &hz[i]);
+            clkrstCloseSession(&session);
+        }
+    }
+    if (clkrst) clkrstExit();
+    const char* renderer = std::getenv("WIICOMPILED_SWITCH_RENDERER");
+    std::snprintf(text, sizeof text, "switch_mode=%s renderer=%s cpu_mhz=%u gpu_mhz=%u emc_mhz=%u",
+                  appletGetOperationMode() == AppletOperationMode_Console ? "docked" : "handheld",
+                  renderer ? renderer : "deko3d", hz[0] / 1000000, hz[1] / 1000000, hz[2] / 1000000);
+    return text;
+}
+
+extern "C" void SwitchIoLogStart();  // switch_io.cpp: WIICOMPILED_SWITCH_IO_LOG=1
+
+namespace {
+double SpikeMs() {
+    static const double ms = [] {
+        const char* v = std::getenv("WIICOMPILED_SWITCH_SPIKES");
+        return v ? std::strtod(v, nullptr) : 0.0;
+    }();
+    return ms;
+}
+
+// Before the sampler starts: the buffers, the code segment, the counters' sources.
+void SpkSetup(bool freeRunning) {
+    const double ms = SpikeMs();
+    if (!(ms > 0.0)) return;
+    MemoryInfo info{};
+    u32 page = 0;
+    g_spkRing = static_cast<SpkSample*>(std::calloc(kSpkRing, sizeof(SpkSample)));
+    g_spkStore = static_cast<SpkSample*>(std::calloc(kSpkStore, sizeof(SpkSample)));
+    g_spikes = static_cast<Spike*>(std::calloc(kSpkMax, sizeof(Spike)));
+    g_spkText = static_cast<char*>(std::malloc(kSpkTextSize));
+    if (!g_spkRing || !g_spkStore || !g_spikes || !g_spkText ||
+        R_FAILED(svcQueryMemory(&info, &page, reinterpret_cast<u64>(&SwitchProfilerStart)))) {
+        std::fprintf(stderr, "[spike] could not set up the spike capture\n");
+        return;
+    }
+    if (const char* v = std::getenv("WIICOMPILED_SWITCH_SPIKES_MAX")) {
+        g_spkLimit = std::min<u32>(u32(std::strtoul(v, nullptr, 10)), kSpkMax);
+    }
+    const char* upto = std::getenv("WIICOMPILED_SWITCH_SPIKES_UPTO");
+    g_spkUpperNs = u64((upto ? std::strtod(upto, nullptr) : freeRunning ? 150.0 : 0.0) * 1e6);
+    g_spkTextLo = info.addr;
+    g_spkTextHi = info.addr + info.size;
+    g_spkDeko = SwitchUsesDeko3d();
+    g_spkFree = freeRunning;
+    g_spkBenchStart = g_spkLastFlush = armGetSystemTick();
+    SwitchSpikeIoEnable();
+    g_spkThresholdNs = u64(ms * 1e6);
+    std::fprintf(stderr, "[spike] capture on: host frames over %.1f ms (up to %.0f ms; 0 = any), at most %u spikes, %s\n",
+                 ms, double(g_spkUpperNs) / 1e6, g_spkLimit, freeRunning ? "free-running (printed every 30 s)" : "printed with the benchmark's profile");
+}
+
+bool StartSampler() {
+    const char* gx = std::getenv("WIICOMPILED_SWITCH_PROFILE_GX");
+    g_gxEnabled = gx && gx[0] == '1' && gx[1] == '\0';
+    // Core 2, above the game's priority and the AX mix worker's (0x2B there: equal priority never
+    // preempts, so samples waited for the mix and landed after the game thread's join).
+    if (R_FAILED(threadCreate(&g_thread, Sample, nullptr, nullptr, 0x10000, 0x2A, 2)) ||
+        R_FAILED(threadStart(&g_thread))) {
+        g_running = false;
+        g_spkThresholdNs = 0;
+        std::fprintf(stderr, "[profile] could not start the sampler\n");
+        return false;
+    }
+    return true;
+}
+
+// Main thread, once per host frame: a frame over the threshold is queued for the sampler.
+void SpkMark(u64 now) {
+    if (g_spkThresholdNs == 0) return;
+    const u32 frame = g_spkFrame.fetch_add(1, std::memory_order_relaxed);  // the frame that just ended
+    const u64 start = std::exchange(g_spkLastEnd, now);
+    if (start == 0 || armTicksToNs(now - start) <= g_spkThresholdNs) return;
+    if (g_spkUpperNs && armTicksToNs(now - start) > g_spkUpperNs) { ++g_spkLong; return; }
+    const u32 tail = g_spkTail.load(std::memory_order_relaxed);
+    if (tail - g_spkHead.load(std::memory_order_acquire) >= kSpkQueue) { ++g_spkQueueFull; return; }
+    g_spkQueue[tail % kSpkQueue] = {frame, start, now};
+    g_spkTail.store(tail + 1, std::memory_order_release);
+}
+} // namespace
+
+extern "C" void SwitchProfilerStart() {
+    std::fprintf(stderr, "[match-bench] at start: %s\n", SwitchClocks());
+    SwitchIoLogStart();
+    const char* enabled = std::getenv("WIICOMPILED_SWITCH_PROFILE");
+    if ((enabled == nullptr || *enabled != '1') && !(SpikeMs() > 0.0)) return;
+    if (g_running.exchange(true)) return;  // already sampling (a free-running spike capture)
+    SpkSetup(false);
+    StartSampler();
+}
+
+// The match benchmark's recorded frames (phase 40).
+extern "C" void SwitchProfilerFrame() {
+    const u64 now = armGetSystemTick();
+    g_frameStart.store(now, std::memory_order_relaxed);
+    if (!g_spkFree) SpkMark(now);
+}
+
+// settings_overlay::Draw, every host frame (S8). WIICOMPILED_SWITCH_SPIKES=<ms> without the timed match
+// benchmark (WIICOMPILED_MATCH_SECONDS): the sampler starts at the first host frame and every host
+// frame is marked, so a normal game played over nxlink prints its spikes.
+extern "C" void SwitchProfilerHostFrame() {
+    static const bool wanted = [] {
+        const char* bench = std::getenv("WIICOMPILED_MATCH_SECONDS");
+        return SpikeMs() > 0.0 && (bench == nullptr || std::strtoul(bench, nullptr, 10) == 0);
+    }();
+    if (!wanted) return;
+    if (g_spkFree) {
+        const u64 hostNow = armGetSystemTick();
+        g_frameStart.store(hostNow, std::memory_order_relaxed);  // P26: late samples of played games
+        SpkMark(hostNow);
+        if (DlProfileOn()) {
+            const u32 bucket = std::min(g_dlCalls.exchange(0, std::memory_order_relaxed) / kDlWidth, kDlBuckets - 1);
+            g_dlBucket.store(bucket, std::memory_order_relaxed);
+            g_dlFrames[bucket].fetch_add(1, std::memory_order_relaxed);
+        }
+        return;
+    }
+    static bool tried = false;
+    if (tried) return;
+    tried = true;
+    if (g_running.exchange(true)) return;
+    SpkSetup(true);
+    if (!g_spkFree) {  // the setup failed
+        g_running = false;
+        return;
+    }
+    StartSampler();
+}
+
+// audio.cpp Audio_HLE_Tick (S8): when the game thread last ticked audio, for the spikes' audio gap.
+void SwitchSpikeAudioTick() { g_spkAudioTickAt.store(armGetSystemTick(), std::memory_order_relaxed); }
+
+namespace {
+// The spikes recorded since the last print (sampler thread while it runs, else the dump), then empty.
+void SpkPrint() {
+    const auto ms = [](u64 ticks) { return double(armTicksToNs(ticks)) / 1e6; };
+    std::fprintf(stderr,
+                 "[spike] anchor=0x%lx text=0x%lx-0x%lx threshold=%.1f ms spikes=%u session=%u/%u dropped=%u "
+                 "queue_full=%u longer_skipped=%u frames=%u\n",
+                 reinterpret_cast<u64>(&SwitchProfilerStart), g_spkTextLo, g_spkTextHi, double(g_spkThresholdNs) / 1e6,
+                 g_spikeCount, g_spkTotal, g_spkLimit, g_spikesDropped, g_spkQueueFull, g_spkLong,
+                 g_spkFrame.load(std::memory_order_relaxed));
+    if (g_gxEnabled) {
+        std::fprintf(stderr, "[spike] worker samples=%lu pause_failed=%lu read_failed=%lu resume_failed=%lu "
+                     "unregistered=%lu main_resume_failed=%lu frame_changed=%lu\n",
+                     g_gxSamples, g_gxPauseFailed, g_gxReadFailed, g_gxResumeFailed,
+                     g_gxUnregistered, g_gxMainResumeFailed, g_gxFrameChanged);
+    }
+    for (u32 i = 0; i < g_spikeCount; ++i) {
+        const Spike& s = g_spikes[i];
+        const SpkContext& b = s.begin;
+        const SpkContext& f = s.finish;
+        const bool both = b.frame != ~0u && f.frame != ~0u;
+        size_t o = 0;
+        const auto put = [&](const char* format, auto... values) {
+            if (o + 160 >= kSpkTextSize) return;
+            o += size_t(std::snprintf(g_spkText + o, kSpkTextSize - o, format, values...));
+        };
+        put("[spike] frame=%u ms=%.1f t=%.3f samples=%u dk=%lu..%lu audio_gap=%.1f io_main=%lu/%.2f "
+            "io_other=%lu/%.2f pipelines=+%u shader_code=+%u%s\n",
+            s.request.frame, ms(s.request.end - s.request.start),
+            double(armTicksToNs(s.request.start - g_spkBenchStart)) / 1e9, s.count, b.dkFrame, f.dkFrame,
+            ms(b.audioGapTicks), both ? f.io[0] - b.io[0] : u64(0), both ? ms(f.io[1] - b.io[1]) : 0.0,
+            both ? f.io[2] - b.io[2] : u64(0), both ? ms(f.io[3] - b.io[3]) : 0.0,
+            both ? f.pipelines - b.pipelines : 0u, both ? f.codeBytes - b.codeBytes : 0u, both ? "" : " (no context)");
+        for (u32 k = 0; k < s.count; ++k) {
+            const SpkSample& x = g_spkStore[s.first + k];
+            put("[spike] P %.2f %lx %lx", x.tick > s.request.start ? ms(x.tick - s.request.start) : 0.0, x.pc, x.lr);
+            for (u32 r = 0; r < x.raCount; ++r) put(" %lx", x.ra[r]);
+            put("\n");
+            if (x.gxTick) {
+                put("[spike] W %.2f %lx %lx\n",
+                    x.gxTick > s.request.start ? ms(x.gxTick - s.request.start) : 0.0, x.gxPc, x.gxLr);
+            }
+        }
+        std::fwrite(g_spkText, 1, o, stderr);
+    }
+    std::fprintf(stderr, "[spike] end\n");
+    std::fflush(stderr);
+    g_spikeCount = 0;
+    g_spkStoreUsed = 0;
+    g_spkLastFlush = armGetSystemTick();
+}
+
+void SpkDump() {
+    if (g_spkThresholdNs == 0) return;
+    SpkPrint();
+    g_spkThresholdNs = 0;
+}
+} // namespace
+
+// GX__CallDisplayList_80172f64 (runtime/src/hle/gx/gx_dl.cpp): one per display-list call (P20).
+extern "C" void SwitchProfilerCountDl() { g_dlCalls.fetch_add(1, std::memory_order_relaxed); }
+
+extern "C" void SwitchProfilerDump() {
+    if (!g_running.exchange(false)) return;
+    threadWaitForExit(&g_thread);
+    threadClose(&g_thread);
+    std::fprintf(stderr, "[profile] anchor=0x%lx samples=%lu failed=%lu\n",
+                 reinterpret_cast<u64>(&SwitchProfilerStart), g_samples, g_failed);
+    for (const auto& [pc, count] : g_pc) std::fprintf(stderr, "[profile] P %lx %u\n", pc, count);
+    for (const auto& [lr, count] : g_lr) std::fprintf(stderr, "[profile] L %lx %u\n", lr, count);
+    std::fprintf(stderr, "[profile] late samples=%lu (host frame past 17 ms)\n", g_lateSamples);
+    for (const auto& [pc, count] : g_latePc) std::fprintf(stderr, "[profile] Q %lx %u\n", pc, count);
+    for (const auto& [lr, count] : g_lateLr) std::fprintf(stderr, "[profile] R %lx %u\n", lr, count);
+    SpkDump();
+    std::fprintf(stderr, "[profile] end\n");
+    std::fflush(stderr);
+}
+#endif
