+// BuildProjectBin without the copy: `file` gets the new header (in memory) and, in order, the ranges
+// of the original and of the mod files that BuildProjectBin would write, with the same zero padding,
+// so reading it gives the bytes of the merged copy. The Switch serves it from the DVD layer
+// (dvd_contract.h DvdReadContract::Virtual) instead of writing 406 MB to the SD card. Keep the two in
+// step: tests compare them byte for byte (local/tmp/cpu/MODSW).
+bool PlanProjectBin(const std::filesystem::path& original, const std::map<std::string, std::filesystem::path>& replacements,
+                    const std::vector<NewFile>& added, DvdReadContract::Virtual::File& file, std::string& error) {
+    constexpr uint32_t kSector = 0x800;
+    std::ifstream src(original, std::ios::binary);
+    std::vector<char> head(0x40);
+    if (!src.read(head.data(), static_cast<std::streamsize>(head.size()))) {
+        error = "cannot read " + Utf8(original);
+        return false;
+    }
+    const uint32_t recordsOff = Be32(head, 0x14), orderOff = Be32(head, 0x28), namesOff = Be32(head, 0x2C),
+                   dataOff = Be32(head, 0x34);
+    if (Be32(head, 4) != kSector || !(recordsOff < orderOff && orderOff < namesOff && namesOff < dataOff)) {
+        error = "unexpected PROJECT.BIN header";
+        return false;
+    }
+    std::vector<char> header(dataOff);
+    src.seekg(0);
+    if (!src.read(header.data(), static_cast<std::streamsize>(header.size()))) {
+        error = "cannot read the header of " + Utf8(original);
+        return false;
+    }
+    std::error_code ec;
+    const uint64_t originalSize = std::filesystem::file_size(original, ec);
+    if (ec) {
+        error = "cannot read " + Utf8(original);
+        return false;
+    }
+    // The size of a mod file as BuildProjectBin reads it (an unreadable one gives no bytes).
+    auto sizeOf = [&](const std::filesystem::path& path, uint64_t& bytes) {
+        std::error_code sizeError;
+        bytes = std::filesystem::file_size(path, sizeError);
+        if (sizeError) bytes = 0;
+        if (bytes >= 0xFFFFF800u) {
+            error = Utf8(path) + " is too large";
+            return false;
+        }
+        return true;
+    };
+    file.AppendBytes(0, dataOff);  // the header, filled in at the end
+    uint32_t sector = 0;
+    size_t used = 0;
+    uint32_t slot = 1;
+    for (; orderOff + slot * 8 + 8 <= namesOff; ++slot) {
+        const uint32_t index = Be32(header, orderOff + slot * 8);
+        const uint32_t start = Be32(header, orderOff + slot * 8 + 4);
+        if (index == 0 && start == 0) break;
+        const size_t record = recordsOff + static_cast<size_t>(index) * 0x1C;
+        const size_t nameAt = namesOff + Be32(header, record + 4);
+        std::string name(header.data() + nameAt);
+        name = Lower(name.substr(name.rfind('/') == 0 ? 1 : 0));
+        uint64_t bytes = 0;
+        if (const auto it = replacements.find(name); it != replacements.end()) {
+            if (!sizeOf(it->second, bytes)) return false;
+            file.AppendSource(it->second, 0, bytes);
+            ++used;
+        } else {
+            bytes = Be32(header, record + 0x18);
+            const uint64_t from = uint64_t{dataOff} + uint64_t{start} * kSector;
+            if (from + bytes > originalSize) {
+                error = "PROJECT.BIN entry " + name + " lies past the end of the file";
+                return false;
+            }
+            file.AppendSource(original, from, bytes);
+        }
+        const uint32_t sectors = static_cast<uint32_t>((bytes + kSector - 1) / kSector);
+        file.AppendZeros(uint64_t{sectors} * kSector - bytes);
+        PutBe32(header, record + 8, sectors);
+        PutBe32(header, record + 0x18, static_cast<uint32_t>(bytes));
+        PutBe32(header, orderOff + slot * 8 + 4, sector);
+        sector += sectors;
+    }
+    const uint32_t buckets = Be32(header, 0x20);
+    const uint32_t lastBucket = orderOff + Be32(header, Be32(header, 0x18) + 4 * buckets);
+    if (!added.empty() && lastBucket + 8 + 8 * Be32(header, lastBucket) != orderOff + slot * 8) {
+        error = "unexpected PROJECT.BIN order buckets";
+        return false;
+    }
+    if (!added.empty()) PutBe32(header, lastBucket, Be32(header, lastBucket) + static_cast<uint32_t>(added.size()));
+    for (const NewFile& newFile : added) {
+        if (orderOff + (slot + 1) * 8 + 8 > namesOff) {
+            error = "PROJECT.BIN order table is full; too many new files";
+            return false;
+        }
+        const size_t record = recordsOff + static_cast<size_t>(newFile.id) * 0x1C;
+        if (record + 0x1C > orderOff) {
+            error = "new file id out of range";
+            return false;
