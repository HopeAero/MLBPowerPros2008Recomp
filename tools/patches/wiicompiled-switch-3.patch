+            // i r22 < n r29 over meshes r24 < r28; r30 steps the index stream table, r21 keeps M.
+            const uint32_t palette = Load32(sp + 0x10u);
+            r28 = meshes;
+            r30 = 0;
+            for (r24 = 0; static_cast<int32_t>(r24) < static_cast<int32_t>(r28); ++r24, r30 += 4u) {
+                Mesh mesh;
+                if (!ReadMesh(c, Load32(r31 + 24u), r24, mesh)) MLB_ENVMAP_ROLLBACK();
+                r25 = mesh.pos; r26 = mesh.nrm; r27 = mesh.uv;
+                // 0x80059280 only computes an address nobody reads.
+                const uint32_t streams = Load32(r31 + 32u);
+                if (!Clear(c, streams + r30, 4u)) MLB_ENVMAP_ROLLBACK();
+                r23 = Load32(streams + r30);
+                r29 = mesh.vertices;
+                r22 = 0;
+                const int32_t count = static_cast<int32_t>(r29);
+                if (count <= 0) continue;
+                if (!MeshFits(c, r25, r26, r27, static_cast<uint64_t>(count))) MLB_ENVMAP_ROLLBACK();
+                for (; static_cast<int32_t>(r22) < count; ++r22, ++r23, r25 += 12u, r26 += 12u, r27 += 8u) {
+                    if (!Clear(c, r23, 1u)) [[unlikely]] MLB_ENVMAP_ROLLBACK();
+                    const uint32_t matrix = palette + 48u * *Host(r23);
+                    if (!Clear(c, matrix, 48u)) [[unlikely]] MLB_ENVMAP_ROLLBACK();
+                    float mi[12];
+                    LoadMatrix(matrix, mi);
+                    if (!Vertex<true>(mi, mi, r25, r26, r27, k, s)) [[unlikely]] MLB_ENVMAP_ROLLBACK();
