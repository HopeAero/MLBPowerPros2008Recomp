@@ -0,0 +1,456 @@
+// The player's Wii disc image read in place on the Switch, for players who copy the NRO and their ISO
+// to the SD card and extract nothing (switch_disc_image.h). Used only when the configured DATA folder
+// does not exist: RuntimeConfigFile::ResolvedDvdRoot() then returns "mlbdisc:/", a read-only newlib
+// device laid out like the DATA folder (hle/wii_disc_image.h decrypts its clusters on demand with
+// libnx's hardware AES). Everything that reads the disc root through the C library or
+// std::filesystem (dvd.cpp's index and reads, mods.cpp's PROJECT.BIN index and virtual PROJECT.BIN,
+// nand_fs.cpp's RFLRes01.arc, the launcher's disc line) sees the same files and bytes as an
+// extracted folder.
+//
+// The image is looked for in sdmc:/switch/mlbpowerpros2008/: game.iso first, then any other .iso
+// whose disc id is RL8E54. The first time an image is used, every file it holds is hashed (its
+// decrypted contents: independent of the container, padding and junk; ~1.25 GB, under a minute)
+// and compared with the supported disc's digest; the answer is kept in UserData/DiscImageCheck.txt
+// with the image's size, modification time and a sampled fingerprint, so later starts skip it. The
+// launcher shows the progress and keeps PLAY until it passes; a modified image is never accepted.
+#if defined(__SWITCH__)
+#include "switch_disc_image.h"
+
+#include "hle/wii_disc_image.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/iosupport.h>
+#include <sys/stat.h>
+
+extern "C" {
+#include <switch/types.h>
+#include <switch/crypto/aes_cbc.h>
+#include <switch/crypto/sha256.h>
+}
+
+namespace {
+
+namespace fs = std::filesystem;
+
+constexpr const char* kDevice = "mlbdisc";
+constexpr const char* kRoot = "mlbdisc:/";
+constexpr const char* kGameId = "RL8E54";
+// WiiDisc::ContentDigest of MLB Power Pros 2008 (USA, RL8E54), affcb6ec...2bfe272d: the 33 files of
+// sys/ and files/, the same from the ISO and from a DATA folder extracted from it or from an NKit copy.
+constexpr uint8_t kExpectedDigest[32] = {0xaf, 0xfc, 0xb6, 0xec, 0xf5, 0x94, 0x43, 0x3c, 0xc6, 0x81, 0x35, 0xb7, 0x30, 0xbb, 0x2e, 0x9a,
+                                         0x0c, 0x11, 0xdc, 0x1a, 0x7e, 0x62, 0x47, 0xb2, 0x6b, 0x9e, 0xfc, 0xba, 0x2b, 0xfe, 0x27, 0x2d};
+
+class NxAes final : public WiiDisc::Cipher {
+public:
+    void SetKey(const uint8_t key[16]) override {
+        const uint8_t zero[16] = {};
+        aes128CbcContextCreate(&ctx_, key, zero, false);
+    }
+    void DecryptCbc(const uint8_t iv[16], const uint8_t* src, uint8_t* dst, size_t size) override {
+        aes128CbcContextResetIv(&ctx_, iv);
+        aes128CbcDecrypt(&ctx_, dst, src, size);
+    }
+
+private:
+    Aes128CbcContext ctx_{};
+};
+
+struct NxSha256 {
+    NxSha256() { sha256ContextCreate(&ctx); }
+    void Update(const void* data, size_t size) { sha256ContextUpdate(&ctx, data, size); }
+    void Final(uint8_t digest[32]) { sha256ContextGetHash(&ctx, digest); }
+    Sha256Context ctx{};
+};
+
+std::string Hex(const uint8_t* bytes, size_t size) {
+    static const char* digits = "0123456789abcdef";
+    std::string text;
+    for (size_t i = 0; i < size; ++i) {
+        text += digits[bytes[i] >> 4];
+        text += digits[bytes[i] & 15];
+    }
+    return text;
+}
+
+std::string Lower(std::string text) {
+    for (char& c : text) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return text;
+}
+
+bool OpenImage(const std::string& path, WiiDisc::Image& image, std::string& error) {
+    auto source = std::make_unique<WiiDisc::FileSource>();
+    if (!source->Open(path)) {
+        error = "cannot be opened";
+        return false;
+    }
+    return image.Open(std::move(source), std::make_unique<NxAes>(), WiiDisc::kRetailCommonKey, error);
+}
+
+// Everything below is set once by Mount() (under g_mountOnce) except the verification state.
+struct Disc {
+    std::string path;  // sdmc:/switch/mlbpowerpros2008/game.iso
+    std::string name;  // game.iso
+    WiiDisc::Image image;
+    bool mounted = false;
+    std::mutex mutex;
+    std::condition_variable done;
+    SwitchDiscImage::State state = SwitchDiscImage::State::None;
+    std::atomic<uint64_t> hashed{0};
+    std::atomic<uint64_t> total{1};
+    std::string es, en;  // the rejection, in both languages
+};
+// Never destroyed: the verification thread may still run while the process exits.
+Disc& g_disc = *new Disc;
+std::once_flag g_mountOnce;
+
+void Reject(std::string es, std::string en) {
+    std::lock_guard<std::mutex> lock(g_disc.mutex);
+    g_disc.state = SwitchDiscImage::State::Rejected;
+    g_disc.es = std::move(es);
+    g_disc.en = std::move(en);
+    g_disc.done.notify_all();
+}
+
+// ---- The newlib device ----------------------------------------------------------------------
+struct OpenFile {
+    int32_t node;
+    uint64_t position;
+};
+struct DirState {
+    int32_t node;
+    size_t next;
+};
+
+int32_t NodeOf(const char* path) {
+    const char* colon = std::strchr(path, ':');
+    return g_disc.image.Find(colon != nullptr ? colon + 1 : path);
+}
+
+void FillStat(int32_t index, struct stat* st) {
+    const WiiDisc::Node& node = g_disc.image.At(index);
+    std::memset(st, 0, sizeof(*st));
+    st->st_ino = static_cast<ino_t>(index + 1);
+    st->st_nlink = 1;
+    st->st_mode = node.directory ? (S_IFDIR | 0555) : (S_IFREG | 0444);
+    st->st_size = static_cast<off_t>(node.size);
+    st->st_blksize = static_cast<blksize_t>(WiiDisc::kClusterDataSize);
+    st->st_blocks = static_cast<blkcnt_t>((node.size + 511) / 512);
+}
+
+int DevOpen(struct _reent* r, void* fileStruct, const char* path, int flags, int) {
+    if ((flags & O_ACCMODE) != O_RDONLY) {
+        r->_errno = EROFS;
+        return -1;
+    }
+    const int32_t node = NodeOf(path);
+    if (node < 0) {
+        r->_errno = ENOENT;
+        return -1;
+    }
+    if (g_disc.image.At(node).directory) {
+        r->_errno = EISDIR;
+        return -1;
+    }
+    *static_cast<OpenFile*>(fileStruct) = {node, 0};
+    return 0;
+}
+
+int DevClose(struct _reent*, void*) { return 0; }
+
+ssize_t DevRead(struct _reent* r, void* fd, char* ptr, size_t len) {
+    auto* file = static_cast<OpenFile*>(fd);
+    const uint64_t size = g_disc.image.At(file->node).size;
+    if (file->position >= size || len == 0) return 0;
+    const size_t n = static_cast<size_t>(std::min<uint64_t>(len, size - file->position));
+    if (!g_disc.image.ReadFile(file->node, file->position, ptr, n)) {
+        r->_errno = EIO;
+        return -1;
+    }
+    file->position += n;
+    return static_cast<ssize_t>(n);
+}
+
+ssize_t DevWrite(struct _reent* r, void*, const char*, size_t) {
+    r->_errno = EBADF;
+    return -1;
+}
+
+off_t DevSeek(struct _reent* r, void* fd, off_t position, int whence) {
+    auto* file = static_cast<OpenFile*>(fd);
+    int64_t base = 0;
+    if (whence == SEEK_CUR) base = static_cast<int64_t>(file->position);
+    else if (whence == SEEK_END) base = static_cast<int64_t>(g_disc.image.At(file->node).size);
+    else if (whence != SEEK_SET) {
+        r->_errno = EINVAL;
+        return -1;
+    }
+    const int64_t target = base + static_cast<int64_t>(position);
+    if (target < 0) {
+        r->_errno = EINVAL;
+        return -1;
+    }
+    file->position = static_cast<uint64_t>(target);
+    return static_cast<off_t>(target);
+}
+
+int DevFstat(struct _reent*, void* fd, struct stat* st) {
+    FillStat(static_cast<OpenFile*>(fd)->node, st);
+    return 0;
+}
+
+int DevStat(struct _reent* r, const char* path, struct stat* st) {
+    const int32_t node = NodeOf(path);
+    if (node < 0) {
+        r->_errno = ENOENT;
+        return -1;
+    }
+    FillStat(node, st);
+    return 0;
+}
+
+DIR_ITER* DevDirOpen(struct _reent* r, DIR_ITER* dir, const char* path) {
+    const int32_t node = NodeOf(path);
+    if (node < 0 || !g_disc.image.At(node).directory) {
+        r->_errno = node < 0 ? ENOENT : ENOTDIR;
+        return nullptr;
+    }
+    *static_cast<DirState*>(dir->dirStruct) = {node, 0};
+    return dir;
+}
+
+int DevDirReset(struct _reent*, DIR_ITER* dir) {
+    static_cast<DirState*>(dir->dirStruct)->next = 0;
+    return 0;
+}
+
+int DevDirNext(struct _reent* r, DIR_ITER* dir, char* filename, struct stat* st) {
+    auto* state = static_cast<DirState*>(dir->dirStruct);
+    const std::vector<int32_t>& children = g_disc.image.At(state->node).children;
+    if (state->next >= children.size()) {
+        r->_errno = ENOENT;
+        return -1;
+    }
+    const int32_t child = children[state->next++];
+    std::snprintf(filename, NAME_MAX + 1, "%s", g_disc.image.At(child).name.c_str());
+    FillStat(child, st);
+    return 0;
+}
+
+int DevDirClose(struct _reent*, DIR_ITER*) { return 0; }
+
+devoptab_t MakeDevice() {
+    devoptab_t device{};
+    device.name = kDevice;
+    device.structSize = sizeof(OpenFile);
+    device.open_r = DevOpen;
+    device.close_r = DevClose;
+    device.write_r = DevWrite;
+    device.read_r = DevRead;
+    device.seek_r = DevSeek;
+    device.fstat_r = DevFstat;
+    device.stat_r = DevStat;
+    device.dirStateSize = sizeof(DirState);
+    device.diropen_r = DevDirOpen;
+    device.dirreset_r = DevDirReset;
+    device.dirnext_r = DevDirNext;
+    device.dirclose_r = DevDirClose;
+    device.lstat_r = DevStat;  // no links: std::filesystem's recursive walk asks lstat
+    return device;
+}
+const devoptab_t g_device = MakeDevice();
+
+// ---- The one-time check ---------------------------------------------------------------------
+fs::path CheckFile() { return RuntimeConfigFile::ApplicationDataDirectory() / "DiscImageCheck.txt"; }
+
+// Image size, modification time and the SHA-256 of 32 spread 4 KiB samples: what tells a later start
+// that the image checked before is the one still there.
+std::string Identity() {
+    struct stat st{};
+    if (::stat(g_disc.path.c_str(), &st) != 0) return {};
+    WiiDisc::FileSource source;
+    if (!source.Open(g_disc.path)) return {};
+    NxSha256 hash;
+    const uint64_t size = source.Size();
+    std::vector<uint8_t> sample(4096);
+    for (uint64_t i = 0; i < 32 && size >= sample.size(); ++i) {
+        if (!source.ReadAt((size - sample.size()) / 31 * i, sample.data(), sample.size())) return {};
+        hash.Update(sample.data(), sample.size());
+    }
+    uint8_t digest[32];
+    hash.Final(digest);
+    return "image=" + g_disc.name + "\nsize=" + std::to_string(size) + "\nmtime=" +
+           std::to_string(static_cast<long long>(st.st_mtime)) + "\nfingerprint=" + Hex(digest, 32) + "\n";
+}
+
+void Finish(const uint8_t digest[32]) {
+    if (std::memcmp(digest, kExpectedDigest, 32) == 0) {
+        std::lock_guard<std::mutex> lock(g_disc.mutex);
+        g_disc.state = SwitchDiscImage::State::Verified;
+        g_disc.done.notify_all();
+        return;
+    }
+    Reject(g_disc.name + " no es un volcado limpio de MLB Power Pros 2008 (RL8E54): sus archivos están modificados. "
+           "Hace falta una copia sin modificar del disco.",
+           g_disc.name + " is not a clean MLB Power Pros 2008 (RL8E54) dump: its files are modified. "
+           "An unmodified copy of the disc is needed.");
+}
+
+void Verify(std::string identity) {
+    const std::string kept = "# MLB Power Pros 2008: the disc image this console checked (delete to check again)\n" +
+                             identity;
+    {
+        std::ifstream in(CheckFile(), std::ios::binary);
+        const std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+        const std::string prefix = kept + "content=";
+        if (!identity.empty() && text.size() >= prefix.size() + 64 && text.compare(0, prefix.size(), prefix) == 0) {
+            uint8_t digest[32];
+            bool ok = true;
+            for (size_t i = 0; i < 64 && ok; ++i) {
+                const char c = text[prefix.size() + i];
+                const int v = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+                ok = v >= 0;
+                digest[i / 2] = static_cast<uint8_t>(i % 2 == 0 ? v << 4 : digest[i / 2] | v);
+            }
+            if (ok) {
+                RT_LOG(RT_TAG_DVD) << "disc image " << g_disc.name << ": checked before (" << RuntimeConfigFile::PathToUtf8(CheckFile())
+                                   << ")" << std::endl;
+                Finish(digest);
+                return;
+            }
+        }
+    }
+    WiiDisc::Image image;  // its own reader: the game's reads do not wait for the check's
+    std::string error;
+    uint8_t digest[32];
+    NxSha256 hash;
+    const auto start = std::chrono::steady_clock::now();
+    if (!OpenImage(g_disc.path, image, error) ||
+        !WiiDisc::ContentDigest(image, hash, digest, [](uint64_t done, uint64_t total) {
+            g_disc.total.store(std::max<uint64_t>(total, 1), std::memory_order_relaxed);
+            g_disc.hashed.store(done, std::memory_order_relaxed);
+            return true;
+        })) {
+        Reject("No se pudo leer " + g_disc.name + " en la tarjeta SD.", g_disc.name + " could not be read from the SD card.");
+        return;
+    }
+    RT_LOG(RT_TAG_DVD) << "disc image " << g_disc.name << ": content digest " << Hex(digest, 32) << " in "
+                       << std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count() << " s"
+                       << std::endl;
+    if (!identity.empty()) {
+        std::error_code ec;
+        fs::create_directories(CheckFile().parent_path(), ec);
+        std::ofstream out(CheckFile(), std::ios::binary | std::ios::trunc);
+        out << kept << "content=" << Hex(digest, 32) << "\n";
+    }
+    Finish(digest);
+}
+
+void Mount() {
+    const auto directory = RuntimeConfigFile::ExecutableDirectory();
+    if (!directory) return;
+    std::vector<fs::path> candidates;
+    std::error_code ec;
+    for (const fs::directory_entry& entry : fs::directory_iterator(*directory, ec)) {
+        std::error_code entryEc;
+        if (entry.is_regular_file(entryEc) && Lower(entry.path().extension().string()) == ".iso") {
+            candidates.push_back(entry.path());
+        }
+    }
+    if (candidates.empty()) return;
+    std::sort(candidates.begin(), candidates.end(), [](const fs::path& a, const fs::path& b) {
+        const bool ag = Lower(a.filename().string()) == "game.iso", bg = Lower(b.filename().string()) == "game.iso";
+        return ag != bg ? ag : a.filename().string() < b.filename().string();
+    });
+    std::string firstName, firstEs, firstEn;
+    for (const fs::path& candidate : candidates) {
+        const std::string name = candidate.filename().string();
+        std::string error;
+        if (OpenImage(candidate.string(), g_disc.image, error) && g_disc.image.GameId() == kGameId) {
+            g_disc.path = candidate.string();
+            g_disc.name = name;
+            break;
+        }
+        RT_LOG(RT_TAG_DVD) << "disc image " << name << ": not used ("
+                           << (error.empty() ? "disc id " + g_disc.image.GameId() : error) << ")" << std::endl;
+        if (firstName.empty()) {
+            firstName = name;
+            if (error.empty()) {
+                firstEs = name + " no es MLB Power Pros 2008 de Wii (USA, RL8E54): su ID es " + g_disc.image.GameId() + ".";
+                firstEn = name + " is not MLB Power Pros 2008 for Wii (USA, RL8E54): its ID is " + g_disc.image.GameId() + ".";
+            } else {
+                firstEs = name + " no es una imagen de disco de Wii que se pueda usar (" + error + ").";
+                firstEn = name + " is not a usable Wii disc image (" + error + ").";
+            }
+        }
+    }
+    if (g_disc.path.empty()) {
+        Reject(firstEs, firstEn);
+        return;
+    }
+    if (AddDevice(&g_device) < 0) {
+        Reject("No se pudo montar " + g_disc.name + ".", g_disc.name + " could not be mounted.");
+        return;
+    }
+    g_disc.mounted = true;
+    RT_LOG(RT_TAG_DVD) << "disc image " << g_disc.path << " mounted as " << kRoot << " (no extracted DATA folder)" << std::endl;
+    {
+        std::lock_guard<std::mutex> lock(g_disc.mutex);
+        g_disc.state = SwitchDiscImage::State::Verifying;
+    }
+    std::thread([] { Verify(Identity()); }).detach();
+}
+
+}  // namespace
+
+extern "C" const char* MlbSwitchDiscImageRoot(void) {
+    std::call_once(g_mountOnce, Mount);
+    return g_disc.mounted ? kRoot : nullptr;
+}
+
+namespace SwitchDiscImage {
+
+Status Current(bool spanish) {
+    std::lock_guard<std::mutex> lock(g_disc.mutex);
+    Status status;
+    status.state = g_disc.state;
+    if (status.state == State::Verifying) {
+        status.progress = static_cast<float>(static_cast<double>(g_disc.hashed.load(std::memory_order_relaxed)) /
+                                             static_cast<double>(g_disc.total.load(std::memory_order_relaxed)));
+        const int percent = static_cast<int>(status.progress * 100.0f);
+        status.message = spanish ? "Comprobando " + g_disc.name + " (solo la primera vez): " + std::to_string(percent) + " %"
+                                 : "Checking " + g_disc.name + " (first time only): " + std::to_string(percent) + "%";
+    } else if (status.state == State::Rejected) {
+        status.message = spanish ? g_disc.es : g_disc.en;
+    }
+    return status;
+}
+
+bool WaitVerified(std::string& message) {
+    (void)RuntimeConfigFile::ResolvedDvdRoot();  // mounts the image when there is no DATA folder
+    std::unique_lock<std::mutex> lock(g_disc.mutex);
+    g_disc.done.wait(lock, [] { return g_disc.state != State::Verifying; });
+    message = g_disc.state == State::Rejected ? g_disc.en : std::string();
+    return g_disc.state != State::Rejected;
+}
+
+}  // namespace SwitchDiscImage
+#endif
diff --git a/runtime/src/platform/switch/switch_io.cpp b/runtime/src/platform/switch/switch_io.cpp
new file mode 100644
index 0000000..f9801bc
--- /dev/null
+++ b/runtime/src/platform/switch/switch_io.cpp
@@ -0,0 +1,389 @@
+// Two main-thread costs on Horizon, linked in with -Wl,--wrap (PublicProducts.cmake):
+//
+// 1. WIICOMPILED_SWITCH_IO_LOG=1: every SD card operation goes through libnx's fs calls (fsdev's
+//    open/read/write/stat/close, romfs, SQLite, the shader caches). Each is an IPC to the fs
+//    service, a millisecond or more on the SD card. The wrappers count them per thread, time the
+//    main thread's (core 0, the game's fibers) and name their files; every 30 s a thread of its
+//    own prints the totals and the costliest paths to stderr. Off: one load and a getenv a second.
+// 2. SDL's Switch keyboard poll (SDL_switchkeyboard.c) calls SDL_SendKeyboardKey for each of the
+//    231 scancodes on every SDL_PumpEvents, with or without a keyboard. With no key down on the
+//    keyboard and none down in SDL's state, every one of those calls returns without doing anything
+//    (a key-up for a key that is up), so the poll is skipped then. A key down, or one SDL still
+//    holds down, runs it as before: the same events (repeats included) in the same order.
+#if defined(__SWITCH__)
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <SDL3/SDL_keyboard.h>
+#include <switch.h>
+
+namespace {
+enum Op { kOpen, kRead, kWrite, kFlush, kClose, kSize, kStat, kCreate, kDelete, kRename, kDir, kCommit, kOps };
+const char* const kOpNames[kOps] = {"open",   "read",   "write",  "flush", "close", "size",
+                                    "stat",   "create", "delete", "rename", "dir",  "commit"};
+
+struct Totals {
+    u64 count[kOps] = {};
+    u64 ns[kOps] = {};
+    u64 bytes = 0;
+    u64 Count() const { u64 n = 0; for (u64 c : count) n += c; return n; }
+    u64 Ns() const { u64 n = 0; for (u64 t : ns) n += t; return n; }
+};
+struct PathStats {
+    Totals totals;
+    u64 maxNs = 0;
+};
+
+// Never destroyed: threads may still reach the fs calls while the process exits.
+struct Log {
+    std::mutex mutex;
+    std::unordered_map<u64, std::string> names;  // open FsFile / FsDir (session, object id) -> path
+    std::unordered_map<std::string, PathStats> mainPaths;
+    Totals main, other;
+    u64 mainMaxNs = 0;
+    std::string mainMaxWhat;
+    u64 windowStart = 0;
+};
+Log& L() {
+    static Log* log = new Log;
+    return *log;
+}
+
+// 0: before this file's static initialisation (libnx mounts the SD card and romfs earlier), 1: off
+// so far (the variable comes from nxlink's arguments, which main() turns into the environment), 2: on.
+std::atomic<int> g_state{0};
+struct MarkInitialized {
+    MarkInitialized() { g_state.store(1, std::memory_order_release); }
+} g_markInitialized;
+
+// S8 (switch phase 54): file reads and opens counted and timed, main thread and other threads, while
+// WIICOMPILED_SWITCH_SPIKES is set (the profiler's start); the spike dumps take each frame's share.
+std::atomic<bool> g_spikeIo{false};
+std::atomic<u64> g_spikeIoTotals[4];  // main count, main ticks, others count, others ticks
+void SpikeIoNote(u64 ticks) {
+    const int i = threadGetCurHandle() == envGetMainThreadHandle() ? 0 : 2;
+    g_spikeIoTotals[i].fetch_add(1, std::memory_order_relaxed);
+    g_spikeIoTotals[i + 1].fetch_add(ticks, std::memory_order_relaxed);
+}
+
+void Report() {
+    Totals main, other;
+    std::vector<std::pair<std::string, PathStats>> paths;
+    u64 maxNs = 0;
+    std::string maxWhat;
+    u64 start = 0;
+    const u64 now = armGetSystemTick();
+    {
+        const std::lock_guard<std::mutex> lock(L().mutex);
+        main = std::exchange(L().main, {});
+        other = std::exchange(L().other, {});
+        paths.assign(L().mainPaths.begin(), L().mainPaths.end());
+        L().mainPaths.clear();
+        maxNs = std::exchange(L().mainMaxNs, 0);
+        maxWhat = std::move(L().mainMaxWhat);
+        L().mainMaxWhat.clear();
+        start = std::exchange(L().windowStart, now);
+    }
+    char ops[512];
+    int o = 0;
+    for (int i = 0; i < kOps; ++i) {
+        if (main.count[i] && o < int(sizeof ops)) {
+            o += std::snprintf(ops + o, sizeof ops - size_t(o), "%s%s %llu %.1f ms", o ? ", " : "", kOpNames[i],
+                               (unsigned long long)main.count[i], double(main.ns[i]) / 1e6);
+        }
+    }
+    std::fprintf(stderr,
+                 "[io] %.1f s: main thread %llu file ops, %.1f ms (%s), %.1f KiB; longest %.2f ms%s%s; other "
+                 "threads %llu ops, %.1f ms\n",
+                 double(armTicksToNs(now - start)) / 1e9, (unsigned long long)main.Count(), double(main.Ns()) / 1e6,
+                 o ? ops : "none", double(main.bytes) / 1024.0, double(maxNs) / 1e6, maxWhat.empty() ? "" : " ",
+                 maxWhat.c_str(), (unsigned long long)other.Count(), double(other.Ns()) / 1e6);
+    std::sort(paths.begin(), paths.end(),
+              [](const auto& a, const auto& b) { return a.second.totals.Ns() > b.second.totals.Ns(); });
+    for (size_t p = 0; p < paths.size() && p < 8; ++p) {
+        const Totals& t = paths[p].second.totals;
+        o = 0;
+        for (int i = 0; i < kOps; ++i) {
+            if (t.count[i] && o < int(sizeof ops)) {
+                o += std::snprintf(ops + o, sizeof ops - size_t(o), "%s%s %llu", o ? ", " : "", kOpNames[i],
+                                   (unsigned long long)t.count[i]);
+            }
+        }
+        std::fprintf(stderr, "[io]   main %8.2f ms (max %.2f) %5llu ops (%s) %8.1f KiB  %s\n", double(t.Ns()) / 1e6,
+                     double(paths[p].second.maxNs) / 1e6, (unsigned long long)t.Count(), ops, double(t.bytes) / 1024.0,
+                     paths[p].first.c_str());
+    }
+}
+
+void StartReporter() {
+    {
+        const std::lock_guard<std::mutex> lock(L().mutex);
+        L().windowStart = armGetSystemTick();
+    }
+    std::fprintf(stderr, "[io] WIICOMPILED_SWITCH_IO_LOG=1: SD card operations every 30 s (main thread by file)\n");
+    // a libnx thread: std::thread::detach throws on Horizon (pthread_detach is unsupported) and,
+    // without exceptions, terminated the NRO at the benchmark's start
+    static Thread reporter;
+    const auto loop = [](void*) {
+        for (;;) {
+            svcSleepThread(30'000'000'000LL);
+            Report();  // prints without the lock: its own writes (stderr on the SD card) come back here
+        }
+    };
+    if (R_FAILED(threadCreate(&reporter, loop, nullptr, nullptr, 0x10000, 0x3B, 2)) ||
+        R_FAILED(threadStart(&reporter))) {
+        std::fprintf(stderr, "[io] could not start the reporter thread\n");
+    }
+}
+
+// Turned on by SwitchIoLogStart (the match benchmark's start), never from inside an fs call: starting
+// the reporter (getenv, a thread, stderr) there crashed the NRO at boot.
+bool Enabled() { return g_state.load(std::memory_order_acquire) == 2; }
+} // namespace
+
+extern "C" void SwitchIoLogStart() {
+    const char* value = std::getenv("WIICOMPILED_SWITCH_IO_LOG");
+    if (value == nullptr || std::strcmp(value, "1") != 0) return;
+    int expected = 1;
+    if (g_state.compare_exchange_strong(expected, 2)) StartReporter();
+}
+
+extern "C" void SwitchSpikeIoEnable() { g_spikeIo.store(true, std::memory_order_relaxed); }
+extern "C" void SwitchSpikeIoTotals(u64 out[4]) {
+    for (int i = 0; i < 4; ++i) out[i] = g_spikeIoTotals[i].load(std::memory_order_relaxed);
+}
+
+namespace {
+
+u64 Key(const Service& s) { return (u64(s.session) << 32) | s.object_id; }
+
+void Record(Op op, const char* path, u64 key, u64 ticks, u64 bytes) {
+    const u64 ns = armTicksToNs(ticks);
+    const bool main = threadGetCurHandle() == envGetMainThreadHandle();
+    const std::lock_guard<std::mutex> lock(L().mutex);
+    Totals& totals = main ? L().main : L().other;
+    ++totals.count[op];
+    totals.ns[op] += ns;
+    totals.bytes += bytes;
+    if (!main) return;
+    std::string name;
+    if (path != nullptr) {
+        name = path;
+    } else if (const auto it = L().names.find(key); it != L().names.end()) {
+        name = it->second;
+    } else {
+        name = "(opened before the log started)";
+    }
+    PathStats& stats = L().mainPaths[name];
+    ++stats.totals.count[op];
+    stats.totals.ns[op] += ns;
+    stats.totals.bytes += bytes;
+    stats.maxNs = std::max(stats.maxNs, ns);
+    if (ns > L().mainMaxNs) {
+        L().mainMaxNs = ns;
+        L().mainMaxWhat = std::string(kOpNames[op]) + " " + name;
+    }
+}
+
+void Name(u64 key, const char* path) {
+    const std::lock_guard<std::mutex> lock(L().mutex);
+    L().names[key] = path;
+}
+
+void Forget(u64 key) {
+    const std::lock_guard<std::mutex> lock(L().mutex);
+    L().names.erase(key);
+}
+} // namespace
+
+extern "C" {
+Result __real_fsFsOpenFile(FsFileSystem* fs, const char* path, u32 mode, FsFile* out);
+Result __real_fsFileRead(FsFile* f, s64 off, void* buf, u64 read_size, u32 option, u64* bytes_read);
+Result __real_fsFileWrite(FsFile* f, s64 off, const void* buf, u64 write_size, u32 option);
+Result __real_fsFileFlush(FsFile* f);
+void __real_fsFileClose(FsFile* f);
+Result __real_fsFileGetSize(FsFile* f, s64* out);
+Result __real_fsFileSetSize(FsFile* f, s64 sz);
+Result __real_fsFsGetEntryType(FsFileSystem* fs, const char* path, FsDirEntryType* out);
+Result __real_fsFsGetFileTimeStampRaw(FsFileSystem* fs, const char* path, FsTimeStampRaw* out);
+Result __real_fsFsCreateFile(FsFileSystem* fs, const char* path, s64 size, u32 option);
+Result __real_fsFsDeleteFile(FsFileSystem* fs, const char* path);
+Result __real_fsFsRenameFile(FsFileSystem* fs, const char* cur_path, const char* new_path);
+Result __real_fsFsOpenDirectory(FsFileSystem* fs, const char* path, u32 mode, FsDir* out);
+Result __real_fsDirRead(FsDir* d, s64* total_entries, size_t max_entries, FsDirectoryEntry* buf);
+void __real_fsDirClose(FsDir* d);
+Result __real_fsFsCreateDirectory(FsFileSystem* fs, const char* path);
+Result __real_fsFsCommit(FsFileSystem* fs);
+void __real_SWITCH_PollKeyboard(Uint64 timestamp);
+
+Result __wrap_fsFsOpenFile(FsFileSystem* fs, const char* path, u32 mode, FsFile* out) {
+    if (!Enabled() && !g_spikeIo.load(std::memory_order_relaxed)) return __real_fsFsOpenFile(fs, path, mode, out);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsOpenFile(fs, path, mode, out);
+    const u64 ticks = armGetSystemTick() - t0;
+    if (g_spikeIo.load(std::memory_order_relaxed)) SpikeIoNote(ticks);
+    if (!Enabled()) return rc;
+    if (R_SUCCEEDED(rc)) Name(Key(out->s), path);
+    Record(kOpen, path, 0, ticks, 0);
+    return rc;
+}
+
+Result __wrap_fsFileRead(FsFile* f, s64 off, void* buf, u64 read_size, u32 option, u64* bytes_read) {
+    if (!Enabled() && !g_spikeIo.load(std::memory_order_relaxed))
+        return __real_fsFileRead(f, off, buf, read_size, option, bytes_read);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFileRead(f, off, buf, read_size, option, bytes_read);
+    const u64 ticks = armGetSystemTick() - t0;
+    if (g_spikeIo.load(std::memory_order_relaxed)) SpikeIoNote(ticks);
+    if (!Enabled()) return rc;
+    Record(kRead, nullptr, Key(f->s), ticks, R_SUCCEEDED(rc) && bytes_read ? *bytes_read : 0);
+    return rc;
+}
+
+Result __wrap_fsFileWrite(FsFile* f, s64 off, const void* buf, u64 write_size, u32 option) {
+    if (!Enabled()) return __real_fsFileWrite(f, off, buf, write_size, option);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFileWrite(f, off, buf, write_size, option);
+    Record(kWrite, nullptr, Key(f->s), armGetSystemTick() - t0, write_size);
+    return rc;
+}
+
+Result __wrap_fsFileFlush(FsFile* f) {
+    if (!Enabled()) return __real_fsFileFlush(f);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFileFlush(f);
+    Record(kFlush, nullptr, Key(f->s), armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+void __wrap_fsFileClose(FsFile* f) {
+    if (!Enabled()) return __real_fsFileClose(f);
+    const u64 key = Key(f->s);
+    const u64 t0 = armGetSystemTick();
+    __real_fsFileClose(f);
+    Record(kClose, nullptr, key, armGetSystemTick() - t0, 0);
+    Forget(key);
+}
+
+Result __wrap_fsFileGetSize(FsFile* f, s64* out) {
+    if (!Enabled()) return __real_fsFileGetSize(f, out);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFileGetSize(f, out);
+    Record(kSize, nullptr, Key(f->s), armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFileSetSize(FsFile* f, s64 sz) {
+    if (!Enabled()) return __real_fsFileSetSize(f, sz);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFileSetSize(f, sz);
+    Record(kSize, nullptr, Key(f->s), armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFsGetEntryType(FsFileSystem* fs, const char* path, FsDirEntryType* out) {
+    if (!Enabled()) return __real_fsFsGetEntryType(fs, path, out);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsGetEntryType(fs, path, out);
+    Record(kStat, path, 0, armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFsGetFileTimeStampRaw(FsFileSystem* fs, const char* path, FsTimeStampRaw* out) {
+    if (!Enabled()) return __real_fsFsGetFileTimeStampRaw(fs, path, out);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsGetFileTimeStampRaw(fs, path, out);
+    Record(kStat, path, 0, armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFsCreateFile(FsFileSystem* fs, const char* path, s64 size, u32 option) {
+    if (!Enabled()) return __real_fsFsCreateFile(fs, path, size, option);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsCreateFile(fs, path, size, option);
+    Record(kCreate, path, 0, armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFsDeleteFile(FsFileSystem* fs, const char* path) {
+    if (!Enabled()) return __real_fsFsDeleteFile(fs, path);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsDeleteFile(fs, path);
+    Record(kDelete, path, 0, armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFsRenameFile(FsFileSystem* fs, const char* cur_path, const char* new_path) {
+    if (!Enabled()) return __real_fsFsRenameFile(fs, cur_path, new_path);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsRenameFile(fs, cur_path, new_path);
+    Record(kRename, new_path, 0, armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFsOpenDirectory(FsFileSystem* fs, const char* path, u32 mode, FsDir* out) {
+    if (!Enabled()) return __real_fsFsOpenDirectory(fs, path, mode, out);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsOpenDirectory(fs, path, mode, out);
+    const u64 ticks = armGetSystemTick() - t0;
+    if (R_SUCCEEDED(rc)) Name(Key(out->s), path);
+    Record(kDir, path, 0, ticks, 0);
+    return rc;
+}
+
+Result __wrap_fsDirRead(FsDir* d, s64* total_entries, size_t max_entries, FsDirectoryEntry* buf) {
+    if (!Enabled()) return __real_fsDirRead(d, total_entries, max_entries, buf);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsDirRead(d, total_entries, max_entries, buf);
+    Record(kDir, nullptr, Key(d->s), armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+void __wrap_fsDirClose(FsDir* d) {
+    if (!Enabled()) return __real_fsDirClose(d);
+    const u64 key = Key(d->s);
+    const u64 t0 = armGetSystemTick();
+    __real_fsDirClose(d);
+    Record(kDir, nullptr, key, armGetSystemTick() - t0, 0);
+    Forget(key);
+}
+
+Result __wrap_fsFsCreateDirectory(FsFileSystem* fs, const char* path) {
+    if (!Enabled()) return __real_fsFsCreateDirectory(fs, path);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsCreateDirectory(fs, path);
+    Record(kCreate, path, 0, armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+Result __wrap_fsFsCommit(FsFileSystem* fs) {
+    if (!Enabled()) return __real_fsFsCommit(fs);
+    const u64 t0 = armGetSystemTick();
+    const Result rc = __real_fsFsCommit(fs);
+    Record(kCommit, "(commit)", 0, armGetSystemTick() - t0, 0);
+    return rc;
+}
+
+void __wrap_SWITCH_PollKeyboard(Uint64 timestamp) {
+    // The real poll: if hidGetKeyboardStates gives a state, SDL_SendKeyboardKey(pressed) for every
+    // scancode below HidKeyboardKey_RightGui. A failed read does nothing there either.
+    HidKeyboardState state;
+    if (hidGetKeyboardStates(&state, 1) == 0) return;
+    if ((state.keys[0] | state.keys[1] | state.keys[2] | state.keys[3]) == 0) {
+        int count = 0;
+        const bool* down = SDL_GetKeyboardState(&count);
+        if (down == nullptr || count <= 0 || std::memchr(down, 1, size_t(count)) == nullptr) return;
+    }
+    __real_SWITCH_PollKeyboard(timestamp);
+}
+}
+#endif
diff --git a/runtime/src/platform/switch/switch_mbedtls.cpp b/runtime/src/platform/switch/switch_mbedtls.cpp
new file mode 100644
index 0000000..d37b613
--- /dev/null
+++ b/runtime/src/platform/switch/switch_mbedtls.cpp
@@ -0,0 +1,21 @@
+// mbed TLS's platform hooks on Horizon (include/mbedtls_switch_config.h): entropy from libnx's CSRNG,
+// milliseconds from the monotonic clock.
+#if defined(__SWITCH__)
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+
+extern "C" void randomGet(void* buf, size_t len);  // libnx
+
+extern "C" int mbedtls_hardware_poll(void*, unsigned char* output, size_t length, size_t* written) {
+    randomGet(output, length);
+    *written = length;
+    return 0;
+}
+
+extern "C" int64_t mbedtls_ms_time(void) {  // mbedtls_ms_time_t
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return int64_t{now.tv_sec} * 1000 + now.tv_nsec / 1000000;
+}
+#endif
diff --git a/runtime/src/platform/switch/switch_posix.cpp b/runtime/src/platform/switch/switch_posix.cpp
new file mode 100644
index 0000000..e01a61b
--- /dev/null
+++ b/runtime/src/platform/switch/switch_posix.cpp
@@ -0,0 +1,49 @@
+// POSIX calls Horizon's SD card cannot honour, linked in with -Wl,--wrap (PublicProducts.cmake).
+// FAT32/exFAT keep no Unix permissions, so changing them succeeds with nothing to do; libnx's fsdev
+// answers ENOSYS instead, which made every std::filesystem::copy_file fail.
+//
+// FAT has no hard links either. The runtime links a finished temporary file to its final name to
+// publish it without replacing one already there; Horizon's rename refuses an existing destination,
+// so it gives the same result. POSIX rename does replace (atomic saves rely on it): when Horizon
+// refuses, the old file goes first. ponytail: not atomic, which FAT cannot be anyway.
+#if defined(__SWITCH__)
+#include <cerrno>
+#include <pthread.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+extern "C" {
+int __real_rename(const char* from, const char* to);
+
+int __wrap_chmod(const char*, mode_t) { return 0; }
+int __wrap_fchmod(int, mode_t) { return 0; }
+int __wrap_link(const char* from, const char* to) { return __real_rename(from, to); }
+
+int __wrap_rename(const char* from, const char* to) {
+    if (__real_rename(from, to) == 0) return 0;
+    if (errno != EEXIST || ::unlink(to) != 0) return -1;
+    return __real_rename(from, to);
+}
+
+// A thread that asks for no particular stack (std::thread never does) gets 128 KiB from libnx;
+// Dawn's shader compiler alone needs more (GCC gives tint's AnalyzeUniformity a ~110 KB frame).
+// Desktop systems give 1 MiB (Windows) to 8 MiB (Linux). ponytail: one size for every such thread.
+constexpr size_t kDefaultThreadStack = 2 * 1024 * 1024;
+
+int __real_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg);
+
+int __wrap_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg) {
+    size_t size = 0;
+    if (attr != nullptr) pthread_attr_getstacksize(attr, &size);
+    if (size != 0) return __real_pthread_create(thread, attr, start, arg);
+    pthread_attr_t sized;
+    if (attr != nullptr) {
+        sized = *attr;
+    } else {
+        pthread_attr_init(&sized);
+    }
+    pthread_attr_setstacksize(&sized, kDefaultThreadStack);
+    return __real_pthread_create(thread, &sized, start, arg);
+}
+}
+#endif
