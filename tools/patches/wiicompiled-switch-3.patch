+[[gnu::noinline]] Skipped SkipIdleVoices(uint8_t* base, uint32_t r1, uint32_t r13, uint32_t r30, uint32_t r31,
+                                         uint32_t first, uint32_t n) {
+    Skipped s = {first, 0u, 0u, 0u, 0u, 0u, 0u};
+    const uint32_t chTab = Load32(base, r13 - 27112u);
+    const uint32_t rmTab = Load32(base, r13 - 27096u);
+    s.chTab = chTab;
+    s.rmTab = rmTab;
+    // The words the run loads that its frame stores must not touch, and the frame, as 64-bit ranges.
+    const uint64_t last = static_cast<uint64_t>(n) - 1u;
+    const uint64_t gLo = static_cast<uint32_t>(r13 - 27112u), gHi = gLo + 20u;           // n, mode, tables, init
+    const uint64_t fLo = static_cast<uint64_t>(r1) - 16u, fHi = static_cast<uint64_t>(r1) + 8u;
+    const uint64_t cLo = static_cast<uint64_t>(chTab) + 112ull * first, cHi = static_cast<uint64_t>(chTab) + 112ull * last + 8u;
+    const uint64_t mLo = static_cast<uint64_t>(rmTab) + 68ull * first, mHi = static_cast<uint64_t>(rmTab) + 68ull * last + 4u;
+    constexpr uint64_t k4G = 0x100000000ull;
+    if (r1 < 16u || fHi > k4G || gHi > k4G || cHi > k4G || mHi > k4G || first >= n) return s;
+    if ((fLo < gHi && gLo < fHi) || (fLo < cHi && cLo < fHi) || (fLo < mHi && mLo < fHi)) return s;
+    const uint8_t* e = base + cLo;
+    const uint8_t* m = base + mLo;
+    const uint8_t* lastE = nullptr;  // the last voice with an AXVPB the run passed
+    uint32_t i = first;
+    for (; i < n; ++i, e += 112, m += 68) {
+        // The words as loaded (little-endian view of the big-endian words): bits 31..28 of a flags word are bits 7..4 of
+        // its first byte, i.e. 0xF0 here, and bits 31..30 of a remote word 0xC0.
+        uint32_t v0, f, w;
+        std::memcpy(&v0, e, 4);
+        std::memcpy(&f, e + 4, 4);
+        const uint32_t mask = 0u - static_cast<uint32_t>(v0 != 0u);  // all ones for a voice with an AXVPB
+        std::memcpy(&w, SelectIf(mask, m, e), 4);                     // no remote word is read for a voice without an AXVPB
+        if ((((f & 0xF0u) | (w & 0xC0u)) & mask) != 0u) break;
+        lastE = mask ? e : lastE;
+    }
+    s.idx = i;
+    if (i == first) return s;
+    // What the last skipped voice leaves in r3 / r4 and the last voice with an AXVPB in r8, from the words again.
+    const uint32_t lastVoice = i - 1u - first;
+    const uint32_t v0 = LoadP32(base + cLo + 112ull * lastVoice);
+    s.r4 = v0;
+    s.r3 = v0 != 0u ? LoadP32(base + mLo + 68ull * lastVoice) : 0u;
+    const uint32_t any = lastE != nullptr;
+    s.any = any;
+    if (any) {
+        s.flags = LoadP32(lastE + 4);
+        Store32(base, r1 - 16u, r1);
+        Store32(base, r1 + 4u, 0x800c1188u);
+        Store32(base, r1 - 4u, r31);
+        Store32(base, r1 - 8u, r30);
+    }
+    return s;
+}
