+// psq_l, GQR0 = 0: two singles, ps0 first in memory. Lane 1 = ps0, lane 0 = ps1: a 64-bit
+// byte reversal. NaN lanes are quieted by the translation; none reach here (see the header).
+[[gnu::always_inline]] inline V LdF(uint32_t address) {
+    return vreinterpret_f32_u8(vrev64_u8(vld1_u8(Host(address))));
+}
+
+// psq_l, GQR5 = 0x00070007: two signed 16-bit integers (ps0 first), scale 0, converted exactly.
+[[gnu::always_inline]] inline V LdS16(uint32_t address) {
+    const uint32_t packed = Rd32(address);
+    const int32x2_t lanes = {static_cast<int16_t>(packed), static_cast<int16_t>(packed >> 16)};
+    return vcvt_f32_s32(lanes);
+}
+
+// psq_st, GQR0 = 0: a single below the normal range keeps only its sign (the translation's
+// PpcStorePsqFloatBitsInline; NaN quieting never applies).
+[[gnu::always_inline]] inline void StF(uint32_t address, V value) {
+    const uint32x2_t bits = vreinterpret_u32_f32(value);
+    const uint32x2_t tiny = vclt_u32(vand_u32(bits, vdup_n_u32(0x7FFFFFFFu)), vdup_n_u32(0x00800000u));
+    const uint32x2_t stored = vbsl_u32(tiny, vand_u32(bits, vdup_n_u32(0x80000000u)), bits);
+    vst1_u8(Host(address), vrev64_u8(vreinterpret_u8_u32(stored)));
+}
+
+// The big-endian image psq_st type 0 writes for a pair (StF without the store), for a value stored more than once.
+[[gnu::always_inline]] inline uint8x8_t Img(V value) {
+    const uint32x2_t bits = vreinterpret_u32_f32(value);
+    const uint32x2_t tiny = vclt_u32(vand_u32(bits, vdup_n_u32(0x7FFFFFFFu)), vdup_n_u32(0x00800000u));
+    return vrev64_u8(vreinterpret_u8_u32(vbsl_u32(tiny, vand_u32(bits, vdup_n_u32(0x80000000u)), bits)));
+}
+[[gnu::always_inline]] inline void StI(uint32_t address, uint8x8_t image) { vst1_u8(Host(address), image); }
+
+[[gnu::always_inline]] inline V PAdd(V a, V b) { return vadd_f32(a, b); }
+[[gnu::always_inline]] inline V PSub(V a, V b) { return vsub_f32(a, b); }
+[[gnu::always_inline]] inline V PMul(V a, V b) { return vmul_f32(a, b); }
+[[gnu::always_inline]] inline V PMadd(V a, V c, V b) { return vfma_f32(b, a, c); }
+[[gnu::always_inline]] inline V PMsub(V a, V c, V b) { return vfma_f32(vneg_f32(b), a, c); }
+[[gnu::always_inline]] inline V PNmsub(V a, V c, V b) { return vneg_f32(vfma_f32(vneg_f32(b), a, c)); }
