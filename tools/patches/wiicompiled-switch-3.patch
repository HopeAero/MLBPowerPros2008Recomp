+    const float oneMinusLpf = Sub(kOne, lpf);  // f4
+    const float fusedGain = Mul(k06, fused);   // f5
+    const float cross = Mul(k05, crosstalk);   // f6
+
+    UndoEntry* undo = g_undo;
+    const auto logged = [&undo](uint32_t address, uint32_t old, uint32_t value) {
