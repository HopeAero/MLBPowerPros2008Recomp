+// One row of the block: 8 columns, x * 0.125 truncated and clamped to 0..255 (PpcQuantizePsqU8Scale61Inline;
+// FCVTZU gives 0 for negatives and NaN and saturates, the saturating narrows clamp at 255).
+[[gnu::always_inline]] inline void StoreRow(uint32_t address, Q left, Q right) {
+    const uint16x4_t lo = vqmovn_u32(vcvtq_u32_f32(vmulq_n_f32(left, 0.125f)));
+    const uint16x4_t hi = vqmovn_u32(vcvtq_u32_f32(vmulq_n_f32(right, 0.125f)));
+    vst1_u8(Host(address), vqmovn_u16(vcombine_u16(lo, hi)));
+}
