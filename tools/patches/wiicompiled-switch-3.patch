+// Standard output on Horizon (main.cpp's process transcript): over the network to nxlink's console on
+// the PC when nxlink started the game (nxlink -s), else nowhere but the log file.
+#if defined(__SWITCH__)
+#include <arpa/inet.h>  // nxlink.h uses struct in_addr without it
+#include <switch.h>
+
+extern "C" bool SwitchStdioToNxlink() {
+    if (__nxlink_host.s_addr == 0 || R_FAILED(socketInitializeDefault())) return false;
+    return nxlinkStdio() >= 0;
+}
