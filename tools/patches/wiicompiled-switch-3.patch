+        g.Line(h.early, e1, earlyLength);
+        g.Line(h.early, e2, earlyLength);
+        if (predelayLength != 0u) g.Line(h.predelay, pp, predelayLength);
+        for (uint32_t k = 0; k < 3; ++k) g.Line(h.comb[k], cj[k], combLength[k]);
+        for (uint32_t k = 0; k < 2; ++k) g.Line(h.allpass[k], ak[k], allpassLength[k]);
+        g.Line(h.last, h.lastIndex, h.lastLength);
