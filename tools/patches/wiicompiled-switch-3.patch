+// ---- guest memory, flat view (ranges proven plain before use) ----
+
+[[gnu::always_inline]] inline uint8_t* Host(uint32_t address) { return MKW_FLAT_GUEST_BASE + address; }
+
+[[gnu::always_inline]] inline uint32_t Bits(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof bits);
+    return bits;
+}
+
+[[gnu::always_inline]] inline float Float(uint32_t bits) {
+    float value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+[[gnu::always_inline]] inline uint32_t Load32(uint32_t address) {
+    uint32_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap32(raw);
+}
+
+[[gnu::always_inline]] inline uint64_t Load64(uint32_t address) {
+    uint64_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap64(raw);
+}
+
+[[gnu::always_inline]] inline void Store32(uint32_t address, uint32_t value) {
+    const uint32_t raw = __builtin_bswap32(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
