+// WIICOMPILED_NATIVE_MIX_FAST=0 turns the line prefetch in the sample loop off (read once at startup).
+const bool g_prefetch = [] {
+    const char* value = std::getenv("WIICOMPILED_NATIVE_MIX_FAST");
+    return !(value != nullptr && value[0] == '0');
+}();
