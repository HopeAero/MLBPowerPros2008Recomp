+using Q = float32x4_t;
+
+// Four columns of the second 1-D transform at once (the translation does two columns per iteration, in
+// the same operations: every op is lane-wise, so a column's results do not depend on its neighbours).
+// Memory order lanes: lane c = the column at ws + 4c. Rows are 32 bytes apart in the workspace.
+[[gnu::always_inline]] inline Q LdQ(const uint8_t* host) {
+    return vreinterpretq_f32_u8(vrev32q_u8(vld1q_u8(host)));
