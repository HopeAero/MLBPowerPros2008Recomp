+static void TestParse() {
+    auto m = ParseManifest(kManifest);
+    CHECK(m.has_value());
+    if (!m) return;
+    CHECK(m->version == "0.1.8");
+    CHECK(m->pieces.size() == 9);
+    CHECK(m->pieces[0].name == "core");
+    CHECK(m->pieces[0].file == "MLBPP-0.1.8-core.zip");
+    CHECK(m->pieces[0].sha256 == "aa");
+    CHECK(m->pieces[0].bytes == 1234);
+    CHECK(m->pieces[0].content == "h_core");
+    CHECK(m->discussionEs.size() && m->discussionEn.back() == '2');
+    CHECK(m->kits.size() == 2);
+    CHECK(m->kits[0].platform == "linux" && m->kits[0].bytes == 999 && m->kits[0].containerfile == "cf1");
+    CHECK(m->kits[1].platform == "steamdeck" && m->kits[1].containerfile.empty());
+    CHECK(!ParseManifest("").has_value());
+    CHECK(!ParseManifest("piece core a b 1 c d\n").has_value());
+    // CRLF tolerated
+    auto c = ParseManifest("version 1.2.3\r\npiece core f s 5 h r\r\n");
+    CHECK(c && c->version == "1.2.3" && c->pieces.size() == 1 && c->pieces[0].content == "h");
+    // payload-style placeholders
+    auto p = ParseManifest("version 0.1.8\npiece core - - 0 abcdef workspace/a;workspace/b\n");
+    CHECK(p && p->pieces.size() == 1);
+    if (p && p->pieces.size() == 1) {
+        CHECK(p->pieces[0].file == "-" && p->pieces[0].sha256 == "-");
+        CHECK(p->pieces[0].bytes == 0 && p->pieces[0].content == "abcdef");
+    }
+    // A leading UTF-8 BOM (Notepad, PowerShell 5.1's Set-Content -Encoding utf8) does not hide 'version'.
+    auto bom = ParseManifest("\xEF\xBB\xBFversion 0.1.9\npiece core f s 5 h r\n");
+    CHECK(bom && bom->version == "0.1.9" && bom->pieces.size() == 1);
+    // Piece and kit files are bare names in the download folder, never paths.
+    auto paths = ParseManifest("version 0.1.9\npiece a ../x.zip s 5 h r\npiece b ..\\x.zip s 5 h r\npiece c C:x.zip s 5 h r\n"
+                               "piece d .. s 5 h r\npiece e ok.zip s 5 h r\nkit linux ../k.tar.gz s 5\nkit steamdeck k.tar.gz s 5\n");
+    CHECK(paths && paths->pieces.size() == 1 && paths->pieces[0].name == "e");
+    CHECK(paths && paths->kits.size() == 1 && paths->kits[0].platform == "steamdeck");
+}
+
+static void TestCompare() {
+    CHECK(CompareVersions("0.1.10", "0.1.9") == 1);
+    CHECK(CompareVersions("0.1.9", "0.1.10") == -1);
+    CHECK(CompareVersions("v0.1.8", "0.1.8") == 0);
+    CHECK(CompareVersions("dev", "0.0.1") == -1);
+    CHECK(CompareVersions("0.0.1", "dev") == 1);
+    CHECK(CompareVersions("dev", "dev") == 0);
+    CHECK(CompareVersions("0.2", "0.1.9") == 1);
+}
+
+static void TestPieces() {
+    auto latest = *ParseManifest(kManifest);
+    auto installed = latest;
+    CHECK(PiecesToDownload(latest, installed).empty());
+    installed.pieces[0].content = "old";
+    auto d = PiecesToDownload(latest, installed);
+    CHECK(d.size() == 1 && d[0].name == "core");
+    installed.pieces.pop_back();  // licenses not installed
+    CHECK(PiecesToDownload(latest, installed).size() == 2);
+}
+
+static void TestPopup() {
+    CHECK(ShouldPopup("0.1.9", "0.1.8", ""));
+    CHECK(!ShouldPopup("0.1.9", "0.1.8", "0.1.9"));
+    CHECK(ShouldPopup("0.1.10", "0.1.8", "0.1.9"));
+    CHECK(!ShouldPopup("0.1.8", "0.1.8", ""));
+    CHECK(!ShouldPopup("0.1.7", "0.1.8", ""));
+}
+
+static void TestDiscussion() {
+    Manifest m;
+    m.version = "0.1.8";
+    CHECK(DiscussionUrl(m, true) == "https://github.com/HopeAero/MLBPowerPros2008Recomp/releases/tag/v0.1.8");
+    m.discussionEs = "https://es.invalid/d";
+    CHECK(DiscussionUrl(m, true) == "https://es.invalid/d");
+    CHECK(DiscussionUrl(m, false) == "https://es.invalid/d");
+    m.discussionEn = "https://en.invalid/d";
+    CHECK(DiscussionUrl(m, true) == "https://en.invalid/d");
+    CHECK(DiscussionUrl(m, false) == "https://es.invalid/d");
+    CHECK(ReleasePage("0.1.9") == "https://github.com/HopeAero/MLBPowerPros2008Recomp/releases/tag/v0.1.9");
+    CHECK(ReleasePage("v0.1.9") == ReleasePage("0.1.9"));
+    // Only web links reach ShellExecute / xdg-open.
+    Manifest bad;
+    bad.version = "0.1.9";
+    bad.discussionEs = "file:///C:/Windows/System32/calc.exe";
+    bad.discussionEn = "http://example.invalid/x";
+    CHECK(DiscussionUrl(bad, true) == ReleasePage("0.1.9"));
+    CHECK(DiscussionUrl(bad, false) == ReleasePage("0.1.9"));
+    bad.discussionEs = "https://github.com/x";
+    CHECK(DiscussionUrl(bad, true) == "https://github.com/x");
+}
