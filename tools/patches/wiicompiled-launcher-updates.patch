+                body.push_back({Tr("Además se reconstruye el contenedor (unos 1,5 GB): tardará más.",
+                                   "The container is rebuilt too (about 1.5 GB): it will take longer."), warn});
+            body.push_back({Tr("Tus partidas, ajustes y mods se conservan. ¿Actualizar ahora?",
+                               "Your saves, settings and mods are kept. Update now?"), plain});
+            buttons = {{Tr("Sí", "Yes"), UpdateAction::Yes}, {"No", UpdateAction::No}};
+        } else {
+#if defined(_WIN32)
+            body.push_back({Tr("Esta copia no puede actualizarse sola. Descarga el Setup de la versión nueva y reinstala "
+                               "una vez: desde entonces, las versiones nuevas se instalan desde aquí.",
+                               "This copy cannot update itself. Download the new version's Setup and reinstall once: "
+                               "from then on, new versions install from here."), plain});
+            buttons = {{Tr("Descargar el Setup", "Download the Setup"), UpdateAction::Setup}, {"No", UpdateAction::No}};
+#else
+            // No kit.txt (a git clone), a kit folder that is not on this machine (an install copied from
+            // another PC) or a release without this platform's kit.
+            body.push_back({Tr("Esta copia no puede actualizarse sola: hace falta una instalación hecha con el kit en "
+                               "este equipo, con su carpeta del kit. Descarga el kit nuevo o actualízala con git.",
+                               "This copy cannot update itself: that needs an install made with the kit on this "
+                               "machine, with its kit folder. Download the new kit or update it with git."), plain});
+            buttons = {{Tr("Descargar el kit", "Download the kit"), UpdateAction::Setup}, {"No", UpdateAction::No}};
