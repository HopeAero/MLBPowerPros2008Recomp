+Updater::Updater(Install install, std::string installedVersion)
+    : install_(std::move(install)), installed_(std::move(installedVersion)), stop_(new Stop) {}
+
+Updater::~Updater() {
+    stop_->Request();
+    if (worker_.joinable()) worker_.join();
+    delete stop_;
+}
+
+bool Updater::Busy() const {
+    return status_.state == Status::State::Checking || status_.state == Status::State::Running;
+}
+
+void Updater::Launch(std::function<void()> job) {
+    // Not busy: the previous worker already published its last state and is only returning.
+    if (worker_.joinable()) worker_.join();
+    {
+        std::lock_guard lock(stop_->mutex);
+        stop_->requested = false;
+        stop_->committed = false;
+    }
+    worker_ = std::thread(std::move(job));
+}
+
+void Updater::Check(std::string baseUrl) {
+    std::lock_guard lock(mutex_);
+    if (Busy()) return;
+    baseUrl_ = std::move(baseUrl);
+    status_.state = Status::State::Checking;
+    status_.error.clear();
+    Launch([this] { RunCheck(); });
+}
+
+bool Updater::Update(bool english) {
+    std::lock_guard lock(mutex_);
+    if (Busy() || !status_.latest || status_.mode != Mode::Update) return false;
+    status_.state = Status::State::Running;
+    status_.rollback = false;
+    status_.cancellable = true;
+    status_.error.clear();
+    status_.message.clear();
+    status_.percent = 0;
+    status_.step = 1;
+    Launch([this, english] { RunUpdate(english); });
+    return true;
+}
+
+bool Updater::Rollback(bool restoreSaves, bool english) {
+    std::lock_guard lock(mutex_);
+    if (Busy() || install_.previousVersion.empty()) return false;
+    status_.state = Status::State::Running;
+    status_.rollback = true;
+    status_.cancellable = false;  // a rollback only moves folders: never stopped halfway
+    status_.error.clear();
+    status_.message.clear();
+    status_.percent = 0;
+    status_.step = status_.steps = 1;
+    status_.downloading = false;
+    std::error_code ec;
+    if (!fs::is_regular_file(install_.script, ec)) {
+        // Without the script the Windows hand-off would close the launcher with nothing to reopen it:
+        // fail here, with the window still open (Failed, «Cerrar»).
+        status_.state = Status::State::Failed;
+        status_.error = std::string(english ? "The update script is missing: " : "Falta el script de actualización: ") +
+                        Utf8(install_.script) +
+#if defined(_WIN32)
+                        (english ? ". Use REINSTALL." : ". Usa REINSTALAR.");
+#else
+                        (english ? ". Run the kit installer again." : ". Vuelve a ejecutar el instalador del kit.");
+#endif
+        return true;
+    }
+    Launch([this, restoreSaves, english] { RunRollback(restoreSaves, english); });
+    return true;
+}
+
+void Updater::Cancel() { stop_->Request(); }
+
+Status Updater::Get() const {
+    Status s;
+    {
+        std::lock_guard lock(mutex_);
+        s = status_;
+    }
+    if (s.state == Status::State::Running && s.downloading) {
+        // MB done / total: the sizes of the files curl is writing, read every frame.
+        uint64_t done = 0;
+        std::error_code ec;
+        auto add = [&](const std::string& file, uint64_t bytes) {
+            const uintmax_t n = fs::file_size(install_.downloads / file, ec);
+            if (!ec) done += n < bytes ? n : bytes;
+            ec.clear();
+        };
+#if defined(_WIN32)
+        for (const Piece& p : s.pieces) add(p.file, p.bytes);
+#else
+        if (s.latest) {
+            for (const Kit& k : s.latest->kits)
+                if (k.platform == install_.kitPlatform) add(k.file, k.bytes);
+        }
+#endif
+        s.downloaded = done;
+    }
+    return s;
+}
+
+void Updater::RunCheck() {
+    std::error_code ec;
+    fs::create_directories(install_.cache, ec);
+    const fs::path part = install_.cache / "update-manifest.txt.part";
+    const fs::path file = install_.cache / "update-manifest.txt";
+    fs::remove(part, ec);
+    std::string last;
+    const int code = RunHidden({Curl(), "-sSfL", "--max-time", "10", "-o", Utf8(part), baseUrl_ + "update-manifest.txt"},
+                               [&](const std::string& line) { if (!line.empty()) last = line; }, *stop_);
+    auto fail = [&](const std::string& why) {
+        fs::remove(part, ec);
+        Set([&](Status& s) {
+            s.state = Status::State::CheckFailed;
+            s.error = why;
+        });
+    };
+    if (code != 0) return fail("curl exit " + std::to_string(code) + (last.empty() ? "" : ": " + last));
+    std::optional<Manifest> latest = ParseManifest(ReadText(part));
+    if (!latest) return fail("the manifest has no version line");
+    fs::rename(part, file, ec);
+
+    Status r;
+    r.mode = Decide(*latest, installed_, install_.canUpdate);
+#if defined(_WIN32)
+    Manifest installed;
+    if (auto m = ParseManifest(ReadText(install_.installedManifest))) installed = std::move(*m);
+    for (const Piece& p : PiecesToDownload(*latest, installed)) {
+        if (p.file.empty() || p.file == "-") continue;  // a payload placeholder, never downloadable
+        r.pieces.push_back(p);
+        r.downloadBytes += p.bytes;
+    }
+    r.quick = QuickUpdate(r.pieces);
+#else
+    bool container = install_.kitPlatform == "steamdeck";
+    for (const std::string& o : install_.kitOptions) container = container || o == "--container";
+    bool haveKit = false;
+    for (const Kit& k : latest->kits) {
+        if (k.platform != install_.kitPlatform) continue;
+        haveKit = true;
+        r.downloadBytes = k.bytes;
+        if (container && !k.containerfile.empty()) {
+            // update.sh rebuilds the container image when the kit's Containerfile changes.
+            std::string sum;
+            const fs::path cf = fs::path(install_.kitRoot) / "tools" / "linux" / "Containerfile";
+            RunHidden({"sha256sum", Utf8(cf)}, [&](const std::string& line) { if (sum.empty()) sum = line.substr(0, line.find(' ')); }, *stop_);
+            r.slowContainer = sum != k.containerfile;
+        }
+    }
+    // A release without this platform's kit cannot be installed from here: only the notice.
+    if (r.mode == Mode::Update && !haveKit) r.mode = Mode::Notify;
+#endif
+    Set([&](Status& s) {
+        s.state = Status::State::Checked;
+        s.latest = std::move(latest);
+        s.mode = r.mode;
+        s.pieces = std::move(r.pieces);
+        s.downloadBytes = r.downloadBytes;
+        s.quick = r.quick;
+        s.slowContainer = r.slowContainer;
+    });
+}
+
+int Updater::RunScript(const std::vector<std::string>& args, std::string& error) {
+    std::string last;
+    AppendLog(install_.log, "> " + [&] {
+        std::string all;
+        for (const std::string& a : args) all += a + " ";
+        return all;
+    }());
+    const int code = RunHidden(args, [&](const std::string& line) {
+        AppendLog(install_.log, line);
+        if (line == "@@COMMIT") {  // update.sh: folders start moving, SIGTERM is ignored from here on
+            stop_->Commit();
+            Set([](Status& s) { s.cancellable = false; });
+        } else if (line.rfind("@@ERROR ", 0) == 0) {
+            error = line.substr(8);
+        } else if (line.rfind("@@ ", 0) == 0) {
+            const size_t space = line.find(' ', 3);
+            const int percent = std::atoi(line.c_str() + 3);
+            std::string message = space == std::string::npos ? "" : line.substr(space + 1);
+            Set([&](Status& s) {
+                s.percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+                s.message = std::move(message);
+            });
+        } else if (!line.empty()) {
+            last = line.size() > 200 ? line.substr(0, 200) + "..." : line;
+        }
+    }, *stop_);
+    if (code != 0 && error.empty()) error = last;
+    return code;
+}
+
+void Updater::RunUpdate(bool english) {
+    auto T = [english](const char* es, const char* en) { return std::string(english ? en : es); };
+    const std::string lang = english ? "en" : "es";
+    std::vector<Piece> pieces;
+    Manifest latest;
+    {
+        std::lock_guard lock(mutex_);
+        pieces = status_.pieces;
+        latest = *status_.latest;
+    }
+    auto finish = [&](Status::State state, const std::string& error) {
+        if (state != Status::State::Done && stop_->Cancelled()) state = Status::State::Cancelled;
+        Set([&](Status& s) {
+            s.state = state;
+            s.downloading = false;
+            s.error = error;
+        });
+    };
+    auto fail = [&](const std::string& error) { finish(Status::State::Failed, error); };
+    auto download = [&](const std::string& file, uint64_t bytes) -> bool {
+        std::error_code ec;
+        const fs::path target = install_.downloads / file;
+        if (fs::file_size(target, ec) == bytes && !ec) return true;  // complete from an earlier try
+        std::string last;
+        const int code = RunHidden({Curl(), "-sSfL", "-o", Utf8(target), baseUrl_ + file},
+                                   [&](const std::string& line) { if (!line.empty()) last = line; }, *stop_);
+        if (code == 0) return true;
+        fail(T("No se pudo descargar ", "Could not download ") + file + (last.empty() ? "" : " (" + last + ")"));
+        return false;
+    };
+    std::error_code ec;
+    fs::create_directories(install_.downloads, ec);
+    if (ec) return fail(T("No se pudo crear la carpeta ", "Could not create the folder ") + Utf8(install_.downloads));
+    fs::remove(install_.log, ec);
+
+#if defined(_WIN32)
+    (void)latest;
+    // Zips an earlier try left that this update does not use (another version, a piece already
+    // applied) would stay forever: only this update's pieces (perhaps half downloaded) are kept.
+    for (const fs::directory_entry& e : fs::directory_iterator(install_.downloads, ec)) {
+        const std::string name = Utf8(e.path().filename());
+        bool keep = name == "update-manifest.txt" || !e.is_regular_file(ec);
+        for (const Piece& p : pieces) keep = keep || name == p.file;
+        if (!keep) fs::remove(e.path(), ec);
+    }
+    ec.clear();
+    // The fetched manifest goes with the zips: Update.ps1 apply checks them against it.
+    fs::copy_file(install_.cache / "update-manifest.txt", install_.downloads / "update-manifest.txt",
+                  fs::copy_options::overwrite_existing, ec);
+    if (ec) return fail(T("No se pudo copiar update-manifest.txt a ", "Could not copy update-manifest.txt to ") + Utf8(install_.downloads));
+    Set([&](Status& s) {
+        s.steps = 3;
+        s.step = 1;
+        s.downloading = true;
+    });
+    for (const Piece& p : pieces) {
+        if (stop_->Requested()) return fail("");
+        if (!download(p.file, p.bytes)) return;
+    }
+    const std::array<const char*, 2> phases{"apply", "build"};
+    for (size_t i = 0; i < phases.size(); ++i) {
+        if (stop_->Requested()) return fail("");
+        Set([&](Status& s) {
+            s.step = static_cast<int>(i) + 2;
+            s.downloading = false;
+            s.percent = 0;
+            s.message = i == 0 ? T("Aplicando las piezas nuevas...", "Applying the new pieces...")
+                               : T("Compilando la versión nueva...", "Building the new version...");
+        });
+        std::string error;
+        const int code = RunScript({PowerShell(), "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
+                                    "-File", Utf8(install_.script), "-Install", Utf8(install_.root), "-Phase", phases[i],
+                                    "-Lang", lang}, error);
+        if (code != 0) {
+            // A zip that failed its check would fail again: the next try downloads them anew.
+            if (i == 0) {
+                for (const Piece& p : pieces) fs::remove(install_.downloads / p.file, ec);
+            }
+            return fail(!error.empty() ? error
+                                       : T("Update.ps1 falló (código ", "Update.ps1 failed (code ") + std::to_string(code) +
+                                             T("). Revisa ", "). See ") + Utf8(install_.log));
+        }
+    }
+    // Last point where «Cancelar» stops the update. From the hand-off on the swap is Update.ps1's: a
+    // later cancel is ignored and the launcher exits as planned (Done), never "cancelled" with a
+    // detached swap still waiting for it.
+    if (!stop_->TryCommit()) return fail("");
+    Set([&](Status& s) {
+        s.cancellable = false;
+        s.percent = 100;
+        s.message = T("Cambiando de versión...", "Switching versions...");
+    });
+    // The swap moves Game, where this program runs from: Update.ps1 waits for this process to exit,
+    // swaps and starts the new version, whose launcher opens.
+    std::string error;
+    if (!StartDetached({PowerShell(), "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File",
+                        Utf8(install_.script), "-Install", Utf8(install_.root), "-Phase", "swap", "-WaitPid",
+                        std::to_string(GetCurrentProcessId()), "-Relaunch", "-Lang", lang},
+                       install_.root / "Update" / "swap.log", error))
+        return fail(T("No se pudo iniciar el cambio de versión: ", "Could not start switching versions: ") + error);  // zips kept for Reintentar
+    for (const Piece& p : pieces) fs::remove(install_.downloads / p.file, ec);  // handed off: the zips are done
+    finish(Status::State::Done, "");
+#else
+    const Kit* kit = nullptr;
+    for (const Kit& k : latest.kits)
+        if (k.platform == install_.kitPlatform) kit = &k;
+    if (kit == nullptr)
+        return fail(T("La versión nueva no trae un kit para ", "The new version has no kit for ") + install_.kitPlatform);
+    Set([&](Status& s) {
+        s.steps = 2;
+        s.step = 1;
+        s.downloading = true;
+    });
+    if (!download(kit->file, kit->bytes)) return;
+    if (stop_->Requested()) return fail("");
+    Set([&](Status& s) {
+        s.step = 2;
+        s.downloading = false;
+        s.percent = 0;
+        s.message = T("Comprobando la descarga...", "Checking the download...");
+    });
+    std::string error;
+    const fs::path tarball = install_.downloads / kit->file;
+    const int code = RunScript({"bash", Utf8(install_.script), "--lang", lang, Utf8(install_.root), Utf8(tarball), kit->sha256}, error);
+    if (code != 0) {
+        fs::remove(tarball, ec);  // a corrupt download would fail again
+        return fail(!error.empty() ? error : T("update.sh falló. Revisa ", "update.sh failed. See ") + Utf8(install_.log));
+    }
+    fs::remove(tarball, ec);
+    finish(Status::State::Done, "");
+#endif
+}
+
+void Updater::RunRollback(bool restoreSaves, bool english) {
+    auto T = [english](const char* es, const char* en) { return std::string(english ? en : es); };
+    const std::string lang = english ? "en" : "es";
+    std::string error;
+    bool ok = false;
+    stop_->Commit();  // never cancelled: the UI offers no «Cancelar» for a rollback
+#if defined(_WIN32)
+    // Same hand-off as the swap: Game is where this program runs from.
+    std::vector<std::string> args{PowerShell(), "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
+                                  "-File", Utf8(install_.script), "-Install", Utf8(install_.root), "-Phase", "rollback"};
+    if (restoreSaves) args.push_back("-RestoreSaves");
+    args.insert(args.end(), {"-WaitPid", std::to_string(GetCurrentProcessId()), "-Relaunch", "-Lang", lang});
+    ok = StartDetached(args, install_.root / "Update" / "rollback.log", error);
+    if (!ok) error = T("No se pudo iniciar la vuelta a la versión anterior: ", "Could not start going back: ") + error;
+#else
+    std::error_code ec;
+    fs::create_directories(install_.downloads, ec);
+    std::vector<std::string> args{"bash", Utf8(install_.script), "--lang", lang, "--rollback"};
+    if (restoreSaves) args.push_back("--restore-saves");
+    args.push_back(Utf8(install_.root));
+    const int code = RunScript(args, error);
+    ok = code == 0;
+    if (!ok && error.empty()) error = T("update.sh falló. Revisa ", "update.sh failed. See ") + Utf8(install_.log);
+#endif
+    const bool cancelled = stop_->Cancelled();
+    Set([&](Status& s) {
+        s.state = ok ? Status::State::Done : cancelled ? Status::State::Cancelled : Status::State::Failed;
+        s.error = ok ? "" : error;
+        if (ok) s.percent = 100;
+    });
+}
+
+bool Updater::Restart(char** argv) {
+#if defined(_WIN32)
+    (void)argv;
+    return false;
+#else
+    // The launcher shows again: the new version opens on it.
+    unsetenv("WIICOMPILED_SKIP_LAUNCHER");
+    const std::string path = Utf8(install_.exe);
+    execv(path.c_str(), argv);
+    return false;
+#endif
+}
