+                            ? Tr("Ya tienes la última versión (", "You have the latest version (") + current + ")."
+                            : std::string(Tr("No se pudo comprobar si hay una versión nueva. Revisa la conexión a Internet "
+                                             "e inténtalo más tarde.",
+                                             "Could not check for a new version. Check the Internet connection and try "
+                                             "again later.")),
+                        g.view == UpdateView::CheckFailed ? bad : plain});
+        buttons = {{Tr("Cerrar", "Close"), UpdateAction::Close}};
+        break;
+    case UpdateView::Notice:
+        title = Tr("Nueva versión ", "New version ") + latest;
+        link = true;
+        back = UpdateAction::No;
+        if (s.mode == Mode::Update) {
+            body.push_back({Tr("Tienes la ", "You have ") + current + ".", soft});
+            body.push_back({Tr("Descarga: ", "Download: ") + launcher_update::FormatMegabytes(s.downloadBytes, !english) + ".", plain});
+#if defined(_WIN32)
+            body.push_back({s.quick ? Tr("Actualización rápida: se vuelve a traducir el juego y se recompila solo lo que cambió (un par de minutos).",
+                                         "Quick update: the game is translated again and only what changed is recompiled (a couple of minutes).")
+                                    : Tr("Actualización completa: se recompila todo el juego y puede tardar bastante.",
+                                         "Full update: the whole game is rebuilt, which can take a while."),
+                            plain});
+#else
+            body.push_back({Tr("Se recompila lo que cambió; si cambió el traductor tarda como una instalación.",
+                               "Whatever changed is rebuilt; if the translator changed it takes as long as an install."),
+                            plain});
+#endif
