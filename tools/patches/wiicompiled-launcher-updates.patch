+static const char* kManifest =
+    "# update manifest\n"
+    "version 0.1.8\n"
+    "discussion_es https://github.com/HopeAero/MLBPowerPros2008Recomp/discussions/11\n"
+    "discussion_en https://github.com/HopeAero/MLBPowerPros2008Recomp/discussions/12\n"
+    "piece core MLBPP-0.1.8-core.zip aa 1234 h_core workspace/LocalBuild.ps1;workspace/config\n"
+    "piece studios MLBPP-0.1.8-studios.zip ab 11 h_studios workspace/TextureStudio.exe\n"
+    "piece translator MLBPP-0.1.8-translator.zip ac 22 h_translator toolkit/Translator\n"
+    "piece deps MLBPP-0.1.8-deps.zip ad 33 h_deps workspace/Dependencies\n"
