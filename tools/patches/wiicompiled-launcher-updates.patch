+std::string BaseUrl() {
+    std::string url = "https://github.com/HopeAero/MLBPowerPros2008Recomp/releases/latest/download/";
+    if (const char* env = std::getenv("MLBPP_UPDATE_URL"); env != nullptr && *env != '\0') url = env;
+    if (url.back() != '/') url.push_back('/');
+    return url;
+}
