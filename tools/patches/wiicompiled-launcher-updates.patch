+// A local server that accepts and never answers: curl waits (the check stays busy) until it is killed.
+struct SilentServer {
+#if defined(_WIN32)
+    SOCKET s = INVALID_SOCKET;
+    SilentServer() {
+        WSADATA w;
+        WSAStartup(MAKEWORD(2, 2), &w);
+#else
+    int s = -1;
+    SilentServer() {
+#endif
+        s = socket(AF_INET, SOCK_STREAM, 0);
+        sockaddr_in a{};
+        a.sin_family = AF_INET;
+        a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        a.sin_port = 0;
+        bind(s, reinterpret_cast<sockaddr*>(&a), sizeof(a));
+        listen(s, 4);
+    }
+    int Port() {
+        sockaddr_in a{};
+#if defined(_WIN32)
+        int n = sizeof(a);
+#else
+        socklen_t n = sizeof(a);
+#endif
+        getsockname(s, reinterpret_cast<sockaddr*>(&a), &n);
+        return ntohs(a.sin_port);
+    }
+    ~SilentServer() {
+#if defined(_WIN32)
+        closesocket(s);
+        WSACleanup();
+#else
+        close(s);
+#endif
+    }
+};
+
+// Sí / VOLVER A during the start-up check: refused (false), nothing starts, the UI keeps its window.
+static void TestBusyRefuses() {
+    const fs::path dir = Scratch("busy");
+    Install in;
+    in.cache = dir / "cache";
+    in.root = dir;
+    in.previousVersion = "0.1.7";
+    in.canUpdate = true;
+    {
+        Updater idle(in, "0.1.8");
+        CHECK(!idle.Update(false));  // no check yet: nothing to install
+    }
+    {
+        Install none = in;
+        none.previousVersion.clear();
+        Updater u(none, "0.1.8");
+        CHECK(!u.Rollback(false, false));  // nothing to go back to
+    }
+    {
+        // VOLVER A without the update script: fails in the window (nothing started, launcher stays).
+        Install noScript = in;
+        noScript.script = dir / "Build" / "workspace" / "Update.ps1";
+        Updater u(noScript, "0.1.8");
+        CHECK(u.Rollback(false, true));
+        const Status s = u.Get();
+        CHECK(s.state == Status::State::Failed && s.rollback && s.error.find("script is missing") != std::string::npos);
+    }
+    SilentServer server;
+    std::chrono::steady_clock::time_point stopping;
+    {
+        Updater u(in, "0.1.8");
+        u.Check("http://127.0.0.1:" + std::to_string(server.Port()) + "/");
+        CHECK(u.Get().state == Status::State::Checking);
+        CHECK(!u.Rollback(false, false));
+        CHECK(!u.Update(false));
+        CHECK(u.Get().state == Status::State::Checking && !u.Get().rollback);
+        stopping = std::chrono::steady_clock::now();
+    }
+    // The destructor stops the check (curl's job / process group): no 10 s wait.
+    CHECK(std::chrono::steady_clock::now() - stopping < std::chrono::seconds(5));
+    std::error_code ec;
+    fs::remove_all(dir, ec);
+}
+
+int main() {
+    TestParse(); TestCompare(); TestPieces(); TestPopup(); TestDiscussion(); TestDecide();
+    TestQuick(); TestConfigValue(); TestBytes(); TestLocate(); TestHandoffError(); TestBusyRefuses();
+    if (g_fail) { std::printf("%d failure(s)\n", g_fail); return 1; }
+    std::printf("launcher_update_tests: all passed\n");
+    return 0;
+}
