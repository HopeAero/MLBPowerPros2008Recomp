+// ---- Updates -----------------------------------------------------------------------------------
+// launcher_update.cpp checks GitHub's latest release and installs it; this draws the notice, the
+// progress, the «Nueva versión» marker and VOLVER A, in the launcher's own look.
+enum class UpdateView { Closed, Checking, Notice, UpToDate, CheckFailed, Running, Failed, RollbackAsk };
+enum class UpdateAction { Yes, No, Setup, Close, Cancel, Retry, RollbackYes, RollbackNo, Link };
+struct UpdateUi {
+    launcher_update::Updater* updater = nullptr;  // null in developer builds: no check at all
+    UpdateView view = UpdateView::Closed;
+    UpdateView drawn = UpdateView::Closed;  // the view drawn last frame: a new one ignores this frame's input
+    bool forced = false;                    // BUSCAR ACTUALIZACIONES: show the result even if notified
+    bool checkSeen = true;                  // the current check's result was handled
+    bool restoreSaves = false;              // the last rollback's choice (Reintentar repeats it)
+    bool cancelling = false;
+    std::string notified;                   // [update] notified
+    std::string restartError;               // Linux: the new program could not be started
+    std::string handoffError;               // Windows: the last swap / rollback failed after the launcher closed
+    bool handoffRollback = false;
+    int selected = 0;
+};
+UpdateUi g_update;
+
+std::string VersionText(std::string_view v) {
+    return !v.empty() && v[0] >= '0' && v[0] <= '9' ? "v" + std::string(v) : std::string(v);
+}
+
+// After VOLVER A, Previous holds the newer program: going there is a switch forward, not back.
+bool PreviousIsNewer() {
+    return g_update.updater != nullptr && launcher_update::CompareVersions(g_update.updater->Where().previousVersion, MlbppVersion()) > 0;
+}
+
+void OpenUrl(const std::string& url) {
+#if defined(_WIN32)
+    const std::wstring wide(url.begin(), url.end());  // GitHub URLs are ASCII
+    ShellExecuteW(nullptr, L"open", wide.c_str(), nullptr, nullptr, SW_SHOWNORMAL);
+#else
+    if (const pid_t child = fork(); child == 0) {
+        if (fork() == 0) {  // orphaned grandchild: no zombie left behind
+            execlp("xdg-open", "xdg-open", url.c_str(), static_cast<char*>(nullptr));
+        }
+        _exit(0);
+    } else if (child > 0) {
+        waitpid(child, nullptr, 0);
+    }
+#endif
+}
+
+// Once per process (Run() is rebuilt on a language change). Not for developer builds or the probes.
+void StartUpdateCheck() {
+    static bool started = false;
+    if (started) return;
+    started = true;
+    const char* probe = std::getenv("WIICOMPILED_LAUNCHER_PROBE");
+    if (std::string_view(MlbppVersion()) == "dev" || (probe != nullptr && *probe != '\0')) return;
+    const std::filesystem::path exe = launcher_update::ThisExecutable();
+    if (exe.empty()) return;
+    g_update.updater = new launcher_update::Updater(  // lives as long as the process (its thread too)
+        launcher_update::Locate(exe, RuntimeConfigFile::ApplicationDataDirectory() / "Cache"), MlbppVersion());
+    std::ifstream config(RuntimeConfigFile::ResolveConfigPath(), std::ios::binary);
+    const std::string text((std::istreambuf_iterator<char>(config)), std::istreambuf_iterator<char>());
+    g_update.notified = launcher_update::ConfigValue(text, "update", "notified");
+    // Windows: the swap / rollback Update.ps1 ran after the last launcher closed failed; say so once.
+    if (auto failed = launcher_update::TakeHandoffError(g_update.updater->Where())) {
+        RT_LOG(RT_TAG_RUNTIME) << "launcher: the last " << (failed->rollback ? "rollback" : "update") << " failed: " << failed->message << std::endl;
+        g_update.handoffError = failed->message;
+        g_update.handoffRollback = failed->rollback;
+        g_update.view = UpdateView::Failed;
+    }
+    // Closing the launcher stops a running download / update.sh before it commits (Windows: the job does it too).
+    std::atexit([] { if (g_update.updater != nullptr) g_update.updater->Cancel(); });
+    g_update.checkSeen = false;
+    g_update.updater->Check(launcher_update::BaseUrl());
+}
+
+void ForceUpdateCheck() {
+    if (g_update.updater == nullptr) return;
+    g_update.forced = true;
+    g_update.checkSeen = false;
+    g_update.view = UpdateView::Checking;
+    g_update.updater->Check(launcher_update::BaseUrl());
+}
+
+// Every frame: follows the check and a running update. True when the launcher must exit (Windows:
+// Update.ps1 took over the swap or the rollback and starts the program itself).
+bool UpdateTick(launcher_update::Status& s) {
+    UpdateUi& g = g_update;
+    if (g.updater == nullptr) return false;
+    using State = launcher_update::Status::State;
+    s = g.updater->Get();
+    if (!g.checkSeen && (s.state == State::Checked || s.state == State::CheckFailed)) {
+        g.checkSeen = true;
+        if (s.state == State::CheckFailed) {
+            RT_LOG(RT_TAG_RUNTIME) << "launcher: update check failed: " << s.error << std::endl;
+            if (g.forced && g.view == UpdateView::Checking) g.view = UpdateView::CheckFailed;
+        } else {
+            const std::string& latest = s.latest->version;
+            RT_LOG(RT_TAG_RUNTIME) << "launcher: latest release " << latest << ", installed " << MlbppVersion()
+                                   << (s.mode == launcher_update::Mode::Update ? " (can update)"
+                                       : s.mode == launcher_update::Mode::Notify ? " (notice only)" : "") << std::endl;
+            // Only over nothing (or BUSCAR's own «Buscando...»): a late result never replaces an open window.
+            if (g.forced && (g.view == UpdateView::Checking || g.view == UpdateView::Closed))
+                g.view = s.mode == launcher_update::Mode::None ? UpdateView::UpToDate : UpdateView::Notice;
+            else if (!g.forced && g.view == UpdateView::Closed && s.mode != launcher_update::Mode::None &&
+                     launcher_update::ShouldPopup(latest, MlbppVersion(), g.notified))
+                g.view = UpdateView::Notice;
+        }
+        g.forced = false;  // a window it opens picks its own first button (DrawUpdateWindow's «fresh»)
+    }
+    if (g.view != UpdateView::Running) return false;
+    if (s.state == State::Failed) {
+        RT_LOG(RT_TAG_RUNTIME) << "launcher: " << (s.rollback ? "rollback" : "update") << " failed: " << s.error << std::endl;
+        g.view = UpdateView::Failed;
+        g.selected = 0;
+    } else if (s.state == State::Cancelled) {
+        RT_LOG(RT_TAG_RUNTIME) << "launcher: update cancelled" << std::endl;
+        g.view = UpdateView::Closed;
+    } else if (s.state == State::Done) {
+#if defined(_WIN32)
+        RT_LOG(RT_TAG_RUNTIME) << "launcher: Update.ps1 takes over (" << (s.rollback ? "rollback" : "swap")
+                               << "); exiting so it can replace the program" << std::endl;
+        return true;
+#else
+        RT_LOG(RT_TAG_RUNTIME) << "launcher: " << (s.rollback ? "rollback" : "update") << " done; starting the program" << std::endl;
+        g.updater->Restart(g_argv);  // returns only on failure
+        g.restartError = std::string(Tr("No se pudo abrir el programa: ", "Could not start the program: ")) +
+                         RuntimeConfigFile::PathToUtf8(g.updater->Where().exe);
+        g.view = UpdateView::Failed;
+#endif
+    }
+    return false;
+}
+
+void UpdateAct(UpdateAction action, const launcher_update::Status& s) {
+    UpdateUi& g = g_update;
+    const bool english = g_lang == Lang::En;
+    g.selected = 0;
+    // Update() / Rollback() refuse while a check still runs (up to 10 s): the window then stays as it
+    // was and the button works again a moment later, never a «Preparando...» that nothing follows.
+    switch (action) {
+    case UpdateAction::Yes:
+        g.cancelling = false;
+        if (g.updater->Update(english)) g.view = UpdateView::Running;
+        break;
+    case UpdateAction::Setup:
+        if (s.latest) OpenUrl(launcher_update::ReleasePage(s.latest->version));
+        [[fallthrough]];
+    case UpdateAction::No:
+        // Asked once per version: the marker next to the version reopens the window.
+        if (s.latest) {
+            g.notified = s.latest->version;
+            RuntimeConfigFile::WriteSetting("update", "notified", RuntimeConfigFile::FormatString(g.notified));
+        }
+        g.view = UpdateView::Closed;
+        break;
+    case UpdateAction::Close:
+        g.view = UpdateView::Closed;
+        g.handoffError.clear();
+        break;
+    case UpdateAction::Cancel:
+        g.cancelling = true;
+        g.updater->Cancel();
+        break;
+    case UpdateAction::Retry:
+        g.cancelling = false;
+        if (s.rollback ? g.updater->Rollback(g.restoreSaves, english) : g.updater->Update(english)) g.view = UpdateView::Running;
+        break;
+    case UpdateAction::RollbackYes:
+    case UpdateAction::RollbackNo: {
+        g.restoreSaves = action == UpdateAction::RollbackYes;
+        g.cancelling = false;
+        const bool back = !PreviousIsNewer();
+        if (!g.updater->Rollback(g.restoreSaves, english)) break;
+        g.view = UpdateView::Running;
