+static void TestQuick() {
+    auto pieces = [](std::initializer_list<const char*> names) {
+        std::vector<Piece> out;
+        for (const char* n : names) out.push_back(Piece{n, "", "", 0, ""});
+        return out;
+    };
+    CHECK(QuickUpdate(pieces({"core"})));
+    CHECK(QuickUpdate(pieces({"core", "studios", "licenses", "powerupplus", "uniform"})));
+    CHECK(!QuickUpdate(pieces({"core", "translator"})));
+    CHECK(!QuickUpdate(pieces({"deps"})));
+    CHECK(!QuickUpdate(pieces({"llvm"})));
+    CHECK(!QuickUpdate(pieces({"buildtools"})));
+    // Nothing to download: Build already has the new sources (e.g. after VOLVER A); only the program rebuilds.
+    CHECK(QuickUpdate(pieces({})));
+}
