+static fs::path Scratch(const char* name) {
+    const fs::path dir = fs::temp_directory_path() / (std::string("mlbpp-update-tests-") + name);
+    std::error_code ec;
+    fs::remove_all(dir, ec);
+    fs::create_directories(dir);
+    return dir;
+}
+
+static void Touch(const fs::path& p, const std::string& text = "x") {
+    fs::create_directories(p.parent_path());
+    std::ofstream(p, std::ios::binary) << text;
+}
+
+// canUpdate needs the update script: an install copied from another PC (kit.txt pointing at a kit
+// folder that is not here) or a Build without Update.ps1 only gets the notice.
+static void TestLocate() {
+    const fs::path dir = Scratch("locate");
+#if defined(_WIN32)
+    const fs::path exe = dir / "Game" / "MLBPowerPros2008.exe";
+    Touch(dir / "Build" / "update-manifest.txt", "version 0.1.8\n");
+    CHECK(!Locate(exe, dir / "cache").canUpdate);
+    Touch(dir / "Build" / "workspace" / "Update.ps1");
+    CHECK(Locate(exe, dir / "cache").canUpdate);
+    CHECK(Locate(exe, dir / "cache").handoffError == dir / "Update" / "last-error.txt");
+#else
+    const fs::path install = dir / "Game dir";
+    const fs::path exe = install / "MLBPowerPros2008";
+    Touch(install / "kit.txt", "root=" + (dir / "kit").string() + "\nplatform=steamdeck\noptions=--container\n");
+    Install in = Locate(exe, dir / "cache");
+    CHECK(!in.canUpdate && in.kitPlatform == "steamdeck");
+    Touch(dir / "kit" / "tools" / "linux" / "update.sh");
+    CHECK(Locate(exe, dir / "cache").canUpdate);
+#endif
+    std::error_code ec;
+    fs::remove_all(dir, ec);
+}
+
+static void TestHandoffError() {
+    const fs::path dir = Scratch("handoff");
+    Install in;
+    in.handoffError = dir / "Update" / "last-error.txt";
+    CHECK(!TakeHandoffError(in));
+    Touch(in.handoffError, "rollback\r\nCould not move Previous\\launcher: in use\r\n");
+    auto e = TakeHandoffError(in);
+    CHECK(e && e->rollback && e->message == "Could not move Previous\\launcher: in use");
+    CHECK(!fs::exists(in.handoffError));  // shown once
+    CHECK(!TakeHandoffError(in));
+    Touch(in.handoffError, "swap\nThe launcher did not exit within 60 s.\n");
+    e = TakeHandoffError(in);
+    CHECK(e && !e->rollback && e->message == "The launcher did not exit within 60 s.");
+    std::error_code ec;
+    fs::remove_all(dir, ec);
+}
