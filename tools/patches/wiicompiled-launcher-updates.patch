diff --git a/runtime/include/launcher_update.h b/runtime/include/launcher_update.h
new file mode 100644
index 0000000..65df882
--- /dev/null
+++ b/runtime/include/launcher_update.h
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Launcher update support. The version comes from the repo's VERSION file (-DMLBPP_VERSION).
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+// "0.1.8", or "dev" when the build was configured without MLBPP_VERSION.
+const char* MlbppVersion();
+
+// Pure update logic (no I/O, no network): manifest parsing and decisions.
+namespace launcher_update {
+
+// "-" in file/sha256 (and bytes 0) = a piece of the payload's own manifest, not yet zipped.
+struct Piece { std::string name, file, sha256; uint64_t bytes = 0; std::string content; };
+struct Kit { std::string platform, file, sha256; uint64_t bytes = 0; std::string containerfile; };  // empty if absent
+struct Manifest { std::string version, discussionEs, discussionEn; std::vector<Piece> pieces; std::vector<Kit> kits; };
+
+// nullopt when the 'version' line is missing. Unknown lines and '#' comments are ignored, and so are
+// piece / kit lines whose file is not a bare file name ('/', '\\', ':' or "..": never a path).
+std::optional<Manifest> ParseManifest(std::string_view text);
+// -1/0/1; accepts a leading "v"; "dev" (or unparsable) sorts below everything else.
+int CompareVersions(std::string_view a, std::string_view b);
+// Pieces of 'latest' whose content hash differs from (or is absent in) 'installed'.
+std::vector<Piece> PiecesToDownload(const Manifest& latest, const Manifest& installed);
+// True when 'latest' is newer than 'installed' and was not already notified.
+bool ShouldPopup(std::string_view latest, std::string_view installed, std::string_view notified);
+// English -> Spanish -> the release page. Only https:// links from the manifest are opened.
+std::string DiscussionUrl(const Manifest& m, bool english);
+// The GitHub release page of a version (where the Setup is downloaded).
+std::string ReleasePage(std::string_view version);
+enum class Mode { None, Notify, Update };  // Notify = no Build/kit: link only
+Mode Decide(const Manifest& latest, std::string_view installed, bool canUpdate);
+// A quick update rebuilds only the program: none of the pieces re-translates the game or changes the
+// toolchain (translator, deps, buildtools, llvm). Empty (nothing to download) is quick too.
+bool QuickUpdate(const std::vector<Piece>& pieces);
+// The string value of key in [section] of a TOML text ("" when absent). Enough for Config.toml's
+// simple 'key = "value"' lines; the full parser lives in runtime_config.h.
+std::string ConfigValue(std::string_view toml, std::string_view section, std::string_view key);
+// "4.2 MB" / "4,2 MB" (MiB, one decimal).
+std::string FormatMegabytes(uint64_t bytes, bool decimalComma);
+
+// ---- The update itself: install layout, processes, downloads -------------------------------------
+// Standard library and OS calls only (no runtime dependency), so the test still links this file.
+
+// Where this copy lives and what it can do.
+//   Windows (Setup install): <Install>\Game\<exe>, <Install>\Build\update-manifest.txt (the installed
+//     pieces), <Install>\Build\workspace\Update.ps1, <Install>\Previous\version.txt after an update.
+//   Linux (kit install): <install>/<exe> with kit.txt (root=, platform=, options=), <kit root>/tools/
+//     linux/update.sh, <install>.previous/version.txt after an update.
+// canUpdate needs the update script too: an install copied to another PC (its kit.txt pointing at the
+// first one's kit folder) or a Build without Update.ps1 only gets the notice.
+struct Install {
+    std::filesystem::path exe;                // this program
+    std::filesystem::path root;               // Windows <Install>; Linux the install dir (the exe's)
+    std::filesystem::path installedManifest;  // Windows only
+    std::filesystem::path script;             // Update.ps1 / update.sh
+    std::filesystem::path downloads;          // Windows <Install>\Update\downloads; Linux <install>.download
+    std::filesystem::path cache;              // UserData\Cache (the fetched manifest)
+    std::filesystem::path log;                // the scripts' output (Windows <Install>\Update\update.log)
+    std::filesystem::path handoffError;       // Windows <Install>\Update\last-error.txt (a failed swap / rollback)
+    std::string kitPlatform, kitRoot;         // Linux, from kit.txt
+    std::vector<std::string> kitOptions;
+    bool canUpdate = false;
+    std::string previousVersion;              // the program kept by the last update ("" = none)
+};
+Install Locate(const std::filesystem::path& exe, const std::filesystem::path& cache);
+// What the detached Update.ps1 left when its swap / rollback failed after the launcher had exited
+// ("<phase>\n<message>"). Read once: the file is deleted. nullopt when there is none.
+struct HandoffError { bool rollback = false; std::string message; };
+std::optional<HandoffError> TakeHandoffError(const Install& install);
+// This program's path (empty where the OS gives no simple way: only Windows and Linux update).
+std::filesystem::path ThisExecutable();
+// MLBPP_UPDATE_URL (tests: file:///...) or the latest GitHub release, ending in '/'.
+std::string BaseUrl();
+
+// What the launcher draws: the check's result and a running update's progress.
+struct Status {
+    enum class State { Idle, Checking, Checked, CheckFailed, Running, Failed, Cancelled, Done };
+    State state = State::Idle;
+    bool rollback = false;           // the running / failed / done job is a rollback
+    bool cancellable = true;         // Running: false once folders move (hand-off, @@COMMIT, rollback)
+    std::optional<Manifest> latest;  // after a check
+    Mode mode = Mode::None;
+    std::vector<Piece> pieces;       // Windows: the zips to download
+    uint64_t downloadBytes = 0;      // the pieces or the kit
+    bool quick = false;              // see QuickUpdate (Windows)
+    bool slowContainer = false;      // Linux: the kit's Containerfile changed, the container is rebuilt
+    int step = 0, steps = 0;         // Running: 1-based
+    bool downloading = false;        // Running: in the download step (downloaded is valid)
+    uint64_t downloaded = 0;         // bytes on disk so far, read from the files' sizes
+    int percent = 0;                 // the script's last "@@ <percent>"
+    std::string message, error;      // the script's last "@@" text / "@@ERROR" text (or ours)
+};
+
+// The check and the update run on a worker thread; Get() is cheap enough for every frame.
+class Updater {
+public:
+    Updater(Install install, std::string installedVersion);
+    ~Updater();
+    Updater(const Updater&) = delete;
+    Updater& operator=(const Updater&) = delete;
+
+    const Install& Where() const { return install_; }
+    // Fetches update-manifest.txt (curl --max-time 10) into the cache. Ignored while busy.
+    void Check(std::string baseUrl);
+    // Windows: download the pieces, Update.ps1 apply and build, then hand the swap to a detached
+    // Update.ps1 -WaitPid <this process> -Relaunch (Done: the launcher must exit). Linux: download the
+    // kit, update.sh (Done: Restart()). Needs a Checked state with Mode::Update. False (nothing
+    // started) while a check or another job runs: the caller keeps its window as it was.
+    bool Update(bool english);
+    // Windows: hands rollback to a detached Update.ps1 (Done at once: exit). Linux: update.sh --rollback.
+    // False (nothing started) while busy or without a previous version.
+    bool Rollback(bool restoreSaves, bool english);
+    // Stops the running download / script (its whole process tree). Ignored once the job committed:
+    // the Windows hand-off is starting, update.sh printed "@@COMMIT", or it is a rollback.
+    void Cancel();
+    Status Get() const;
+    // Linux: replaces this process with the program in the install folder, launcher shown (the old
+    // inode moved away, so by path, not /proc/self/exe). Returns only on failure. Windows: no-op.
+    bool Restart(char** argv);
+
+    struct Stop;  // cancel token of the running child process
+
+private:
+    bool Busy() const;  // with mutex_ held
+    // With mutex_ held: joins the finished worker and runs job on a new one.
+    void Launch(std::function<void()> job);
+    void RunCheck();
+    void RunUpdate(bool english);
+    void RunRollback(bool restoreSaves, bool english);
+    // One hidden script run: "@@" lines go to status_, everything to the log. Returns the exit code.
+    int RunScript(const std::vector<std::string>& args, std::string& error);
+    // Sets a field of status_ under the lock.
+    template <typename F> void Set(F&& f) { std::lock_guard lock(mutex_); f(status_); }
+
+    Install install_;
+    std::string installed_;
+    std::string baseUrl_;
+    mutable std::mutex mutex_;
+    Status status_;
+    std::thread worker_;
+    Stop* stop_;
+};
+
+}  // namespace launcher_update
