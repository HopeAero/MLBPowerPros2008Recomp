+fs::path ThisExecutable() {
+#if defined(_WIN32)
+    std::wstring buffer(MAX_PATH, L'\0');
+    for (;;) {
+        const DWORD n = GetModuleFileNameW(nullptr, buffer.data(), static_cast<DWORD>(buffer.size()));
+        if (n == 0) return {};
+        if (n < buffer.size()) return fs::path(buffer.substr(0, n));
+        buffer.resize(buffer.size() * 2);
+    }
+#elif defined(__linux__)
+    std::error_code ec;
+    const fs::path exe = fs::read_symlink("/proc/self/exe", ec);
+    return ec ? fs::path() : exe;
+#else
+    return {};
+#endif
+}
+
+Install Locate(const fs::path& exe, const fs::path& cache) {
+    Install in;
+    in.exe = exe;
+    in.cache = cache;
+    std::error_code ec;
+    const fs::path dir = exe.parent_path();
+    fs::path previous;
+#if defined(_WIN32)
+    in.root = dir.parent_path();
+    in.installedManifest = in.root / "Build" / "update-manifest.txt";
+    in.script = in.root / "Build" / "workspace" / "Update.ps1";
+    in.downloads = in.root / "Update" / "downloads";
+    in.log = in.root / "Update" / "update.log";
+    in.handoffError = in.root / "Update" / "last-error.txt";
+    // Without Update.ps1 the hand-off would close the launcher with nothing to reopen it.
+    in.canUpdate = fs::is_regular_file(in.installedManifest, ec) && fs::is_regular_file(in.script, ec);
+    previous = in.root / "Previous" / "version.txt";
+#else
+    in.root = dir;
+    const fs::path kit = dir / "kit.txt";
+    const std::string kitText = ReadText(kit);  // Split's views point into it: not a temporary
+    for (std::string_view line : Split(kitText, '\n')) {
+        line = Trim(line);
+        if (line.substr(0, 5) == "root=") in.kitRoot = std::string(line.substr(5));
+        else if (line.substr(0, 9) == "platform=") in.kitPlatform = std::string(line.substr(9));
+        else if (line.substr(0, 8) == "options=") {
+            for (std::string_view o : Split(line.substr(8), ' ')) in.kitOptions.emplace_back(o);
+        }
+    }
+    in.script = fs::path(in.kitRoot) / "tools" / "linux" / "update.sh";
+    // kit.txt travels with an install copied to another PC (a Steam Deck) but its root= does not: only
+    // an existing kit folder can rebuild it.
+    in.canUpdate = fs::is_regular_file(kit, ec) && !in.kitRoot.empty() && fs::is_regular_file(in.script, ec);
+    in.downloads = fs::path(dir.native() + ".download");
+    in.log = in.downloads / "update.log";
+    previous = fs::path(dir.native() + ".previous") / "version.txt";
+#endif
+    if (fs::is_regular_file(previous, ec)) {
+        const std::string v(Trim(ReadText(previous)));
+        in.previousVersion = v.empty() ? "?" : v.substr(0, v.find_first_of(" \t\r\n"));
+    }
+    return in;
+}
+
+std::optional<HandoffError> TakeHandoffError(const Install& install) {
+    std::error_code ec;
+    if (install.handoffError.empty() || !fs::is_regular_file(install.handoffError, ec)) return std::nullopt;
+    const std::string text = ReadText(install.handoffError);
+    fs::remove(install.handoffError, ec);  // shown once
+    HandoffError e;
+    const size_t nl = text.find('\n');
+    const std::string_view phase = Trim(std::string_view(text).substr(0, nl));
+    e.rollback = phase == "rollback";
+    e.message = std::string(Trim(nl == std::string::npos ? std::string_view() : std::string_view(text).substr(nl + 1)));
+    while (!e.message.empty() && (e.message.back() == '\n' || e.message.back() == '\r')) e.message.pop_back();
+    if (e.message.empty()) e.message = std::string(phase);
+    return e;
+}
