+// The «Nueva versión vX.Y.Z» marker, right-aligned at (right, y). True when clicked.
+bool DrawUpdateMarker(ImDrawList* dl, float size, float right, float y, bool click, const launcher_update::Status& s) {
+    if (g_update.updater == nullptr || g_update.view != UpdateView::Closed || !s.latest || s.mode == launcher_update::Mode::None)
+        return false;
+    const std::string text = Tr("Nueva versión ", "New version ") + VersionText(s.latest->version);
+    const ImVec2 ts = TextSize(g_bold, size, text.c_str());
+    const float px = size * 0.6f, py = size * 0.18f;
+    const ImVec2 a(right - ts.x - 2 * px, y - py), b(right, y + ts.y + py);
+    const bool hot = Hovered(a, b);
+    Pill(dl, a, b, hot ? Rgba(255, 220, 120) : Rgba(255, 200, 90), hot ? Rgba(250, 140, 30) : Rgba(242, 118, 18), size / 24.0f);
+    ShadowedText(dl, g_bold, size, ImVec2(a.x + px, y), IM_COL32_WHITE, text.c_str());
+    return click && hot;
+}
