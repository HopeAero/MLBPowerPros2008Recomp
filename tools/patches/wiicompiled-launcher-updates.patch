+std::vector<std::string_view> Split(std::string_view s, char sep) {
+    std::vector<std::string_view> out;
+    size_t pos = 0;
+    while (pos <= s.size()) {
+        size_t e = s.find(sep, pos);
+        if (e == std::string_view::npos) e = s.size();
+        if (e > pos) out.push_back(s.substr(pos, e - pos));
+        pos = e + 1;
+    }
+    return out;
+}
+
+bool ParseU64(std::string_view s, uint64_t& v) {
+    auto r = std::from_chars(s.data(), s.data() + s.size(), v);
+    return r.ec == std::errc() && r.ptr == s.data() + s.size();
+}
+
+// Numeric dotted components; false when the string is not a version ("dev", empty, garbage).
+bool ParseVersion(std::string_view s, std::vector<uint64_t>& out) {
+    if (!s.empty() && (s[0] == 'v' || s[0] == 'V')) s.remove_prefix(1);
+    if (s.empty()) return false;
+    for (std::string_view part : Split(s, '.')) {
+        uint64_t n = 0;
+        if (!ParseU64(part, n)) return false;
+        out.push_back(n);
+    }
+    return !out.empty();
+}
+
+std::string_view Trim(std::string_view s) {
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t' || s.front() == '\r')) s.remove_prefix(1);
+    while (!s.empty() && (s.back() == ' ' || s.back() == '\t' || s.back() == '\r')) s.remove_suffix(1);
+    return s;
+}
+
+// A file of the download folder: a bare name, never a path ("-" is the payload placeholder).
+bool BareFileName(std::string_view name) {
+    return !name.empty() && name != "." && name != ".." && name.find_first_of("/\\:") == std::string_view::npos;
+}
+
+}  // namespace
+
+std::optional<Manifest> ParseManifest(std::string_view text) {
+    Manifest m;
+    bool haveVersion = false;
+    if (text.substr(0, 3) == "\xEF\xBB\xBF") text.remove_prefix(3);  // UTF-8 BOM
+    for (std::string_view line : Split(text, '\n')) {
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t')) line.remove_suffix(1);
+        if (line.empty() || line[0] == '#') continue;
+        auto f = Split(line, ' ');
+        if (f.empty()) continue;
+        std::string_view key = f[0];
+        if (key == "version" && f.size() >= 2) {
+            m.version = std::string(f[1]);
+            haveVersion = true;
+        } else if (key == "discussion_es" && f.size() >= 2) {
+            m.discussionEs = std::string(f[1]);
+        } else if (key == "discussion_en" && f.size() >= 2) {
+            m.discussionEn = std::string(f[1]);
+        } else if (key == "piece" && f.size() >= 7) {
+            Piece p;
+            p.name = std::string(f[1]);
+            p.file = std::string(f[2]);
+            p.sha256 = std::string(f[3]);
+            if (!ParseU64(f[4], p.bytes) || !BareFileName(p.file)) continue;
+            p.content = std::string(f[5]);
+            m.pieces.push_back(std::move(p));
+        } else if (key == "kit" && f.size() >= 5) {
+            Kit k;
+            k.platform = std::string(f[1]);
+            k.file = std::string(f[2]);
+            k.sha256 = std::string(f[3]);
+            if (!ParseU64(f[4], k.bytes) || !BareFileName(k.file)) continue;
+            if (f.size() >= 6) k.containerfile = std::string(f[5]);
+            m.kits.push_back(std::move(k));
+        }
+    }
+    if (!haveVersion) return std::nullopt;
+    return m;
+}
+
+int CompareVersions(std::string_view a, std::string_view b) {
+    std::vector<uint64_t> va, vb;
+    bool oka = ParseVersion(a, va), okb = ParseVersion(b, vb);
+    if (!oka || !okb) return oka == okb ? 0 : (oka ? 1 : -1);
+    size_t n = va.size() > vb.size() ? va.size() : vb.size();
+    for (size_t i = 0; i < n; ++i) {
+        uint64_t x = i < va.size() ? va[i] : 0, y = i < vb.size() ? vb[i] : 0;
+        if (x != y) return x < y ? -1 : 1;
+    }
+    return 0;
+}
+
+std::vector<Piece> PiecesToDownload(const Manifest& latest, const Manifest& installed) {
+    std::unordered_map<std::string, std::string> have;
+    for (const Piece& p : installed.pieces) have[p.name] = p.content;
+    std::vector<Piece> out;
+    for (const Piece& p : latest.pieces) {
+        auto it = have.find(p.name);
+        if (it == have.end() || it->second != p.content) out.push_back(p);
+    }
+    return out;
+}
+
+bool ShouldPopup(std::string_view latest, std::string_view installed, std::string_view notified) {
+    if (CompareVersions(latest, installed) <= 0) return false;
+    if (!notified.empty() && CompareVersions(latest, notified) <= 0) return false;
+    return true;
+}
+
+std::string ReleasePage(std::string_view version) {
+    std::string v(version);
+    if (v.empty() || (v[0] != 'v' && v[0] != 'V')) v.insert(v.begin(), 'v');
+    return "https://github.com/HopeAero/MLBPowerPros2008Recomp/releases/tag/" + v;
+}
+
+std::string DiscussionUrl(const Manifest& m, bool english) {
+    // The link is handed to ShellExecute / xdg-open: a web page, nothing else.
+    auto web = [](const std::string& url) { return url.rfind("https://", 0) == 0; };
+    if (english && web(m.discussionEn)) return m.discussionEn;
+    if (web(m.discussionEs)) return m.discussionEs;
+    return ReleasePage(m.version);
+}
+
+Mode Decide(const Manifest& latest, std::string_view installed, bool canUpdate) {
+    if (CompareVersions(latest.version, installed) <= 0) return Mode::None;
+    return canUpdate ? Mode::Update : Mode::Notify;
+}
+
+bool QuickUpdate(const std::vector<Piece>& pieces) {
+    // Nothing to download (Build already holds the new sources, e.g. after VOLVER A): only the program rebuilds.
+    for (const Piece& p : pieces) {
+        if (p.name == "translator" || p.name == "deps" || p.name == "buildtools" || p.name == "llvm") return false;
+    }
+    return true;
+}
+
+std::string ConfigValue(std::string_view toml, std::string_view section, std::string_view key) {
+    bool inSection = false;
+    for (std::string_view line : Split(toml, '\n')) {
+        line = Trim(line);
+        if (line.empty() || line[0] == '#') continue;
+        if (line[0] == '[') {
+            const size_t close = line.find(']');
+            inSection = close != std::string_view::npos && Trim(line.substr(1, close - 1)) == section;
+            continue;
+        }
+        const size_t eq = line.find('=');
+        if (!inSection || eq == std::string_view::npos || Trim(line.substr(0, eq)) != key) continue;
+        std::string_view value = Trim(line.substr(eq + 1));
+        if (!value.empty() && (value[0] == '"' || value[0] == '\'')) {
+            const size_t end = value.find(value[0], 1);
+            return std::string(value.substr(1, end == std::string_view::npos ? std::string_view::npos : end - 1));
+        }
+        return std::string(Trim(value.substr(0, value.find('#'))));
+    }
+    return {};
+}
+
+std::string FormatMegabytes(uint64_t bytes, bool decimalComma) {
+    char text[32];
+    std::snprintf(text, sizeof(text), "%.1f MB", static_cast<double>(bytes) / (1024.0 * 1024.0));
+    std::string out = text;
+    if (decimalComma) {
+        for (char& c : out)
+            if (c == '.') c = ',';
+    }
+    return out;
+}
+
+// ==== The update itself ===========================================================================
+namespace fs = std::filesystem;
+
+namespace {
+
+std::string Utf8(const fs::path& p) {
+    const std::u8string s = p.u8string();
+    return std::string(s.begin(), s.end());
+}
+
+std::string ReadText(const fs::path& path) {
+    std::ifstream file(path, std::ios::binary);
+    return std::string((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+}
+
+}  // namespace
+
+// The running child: Cancel() kills its whole tree (Windows job, POSIX process group).
+// Once committed (folders about to move) a cancel is ignored and the job's own result stands.
+struct Updater::Stop {
+    std::mutex mutex;
+    bool requested = false;
+    bool committed = false;
+#if defined(_WIN32)
+    HANDLE job = nullptr;
+#else
+    pid_t group = 0;
+#endif
+    void Request() {
+        std::lock_guard lock(mutex);
+        if (committed) return;
+        requested = true;
+#if defined(_WIN32)
+        if (job != nullptr) TerminateJobObject(job, 1);
+#else
+        if (group > 0) kill(-group, SIGTERM);
+#endif
+    }
+    bool Requested() {
+        std::lock_guard lock(mutex);
+        return requested;
+    }
+    // Windows hand-off: commits unless a cancel came first.
+    bool TryCommit() {
+        std::lock_guard lock(mutex);
+        if (requested) return false;
+        committed = true;
+        return true;
+    }
+    // update.sh printed "@@COMMIT" (it ignores SIGTERM from there on) / a rollback: commits regardless.
+    void Commit() {
+        std::lock_guard lock(mutex);
+        committed = true;
+    }
+    // The job ended because of «Cancelar» (not after a commit).
+    bool Cancelled() {
+        std::lock_guard lock(mutex);
+        return requested && !committed;
+    }
+};
+
+namespace {
+
+using LineFn = std::function<void(const std::string&)>;
+
+// Splits a byte stream into lines (LF or CRLF) for onLine.
+struct Lines {
+    std::string pending;
+    void Feed(const char* data, size_t size, const LineFn& onLine) {
+        pending.append(data, size);
+        for (size_t nl; (nl = pending.find('\n')) != std::string::npos;) {
+            std::string line = pending.substr(0, nl);
+            pending.erase(0, nl + 1);
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            onLine(line);
+        }
+    }
+    void Finish(const LineFn& onLine) {
+        if (!pending.empty()) onLine(pending);
+        pending.clear();
+    }
+};
+
+#if defined(_WIN32)
+std::wstring Wide(const std::string& s) {
+    if (s.empty()) return {};
+    const int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), static_cast<int>(s.size()), nullptr, 0);
+    std::wstring out(static_cast<size_t>(n), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, s.data(), static_cast<int>(s.size()), out.data(), n);
+    return out;
+}
+
+// CommandLineToArgvW's quoting rules.
+std::wstring QuoteArg(const std::wstring& a) {
+    if (!a.empty() && a.find_first_of(L" \t\"") == std::wstring::npos) return a;
+    std::wstring out = L"\"";
+    size_t backslashes = 0;
+    for (wchar_t c : a) {
+        if (c == L'\\') {
+            ++backslashes;
+            continue;
+        }
+        out.append(c == L'"' ? backslashes * 2 + 1 : backslashes, L'\\');
+        backslashes = 0;
+        out.push_back(c);
+    }
+    out.append(backslashes * 2, L'\\');
+    out.push_back(L'"');
+    return out;
+}
+
+std::wstring CommandLine(const std::vector<std::string>& args) {
+    std::wstring out;
+    for (const std::string& a : args) {
+        if (!out.empty()) out.push_back(L' ');
+        out += QuoteArg(Wide(a));
+    }
+    return out;
+}
+
+// Windows' own curl.exe / powershell.exe by full path: no copy next to the game or in the working
+// folder is picked up instead.
+std::string SystemTool(const wchar_t* relative, const char* fallback) {
+    wchar_t dir[MAX_PATH]{};
+    const UINT n = GetSystemDirectoryW(dir, MAX_PATH);
+    if (n == 0 || n >= MAX_PATH) return fallback;
+    const fs::path tool = fs::path(dir) / relative;
+    std::error_code ec;
+    return fs::is_regular_file(tool, ec) ? Utf8(tool) : fallback;
+}
+std::string Curl() { return SystemTool(L"curl.exe", "curl.exe"); }
+std::string PowerShell() { return SystemTool(L"WindowsPowerShell\\v1.0\\powershell.exe", "powershell.exe"); }
+
+// PROC_THREAD_ATTRIBUTE_JOB_LIST / _HANDLE_LIST, which mingw hides below _WIN32_WINNT 0x0A00.
+constexpr DWORD_PTR kJobListAttribute = 0x0002000D;
+constexpr DWORD_PTR kHandleListAttribute = 0x00020002;
+
+// A hidden child whose stdout and stderr go to onLine. It starts inside its own kill-on-close job
+// (PROC_THREAD_ATTRIBUTE_JOB_LIST, as PowerUp+ in launcher.cpp and the Setup do: never
+// CREATE_SUSPENDED + ResumeThread, which antivirus behaviour rules flag), so Cancel() stops it and
+// everything it started. Only the pipe and NUL are inherited. Returns the exit code, -1 when it could
+// not start, -2 when cancelled before starting.
+int RunHidden(const std::vector<std::string>& args, const LineFn& onLine, Updater::Stop& stop) {
+    std::wstring command = CommandLine(args);
+    SECURITY_ATTRIBUTES sa{sizeof(sa), nullptr, TRUE};
+    HANDLE readPipe = nullptr, writePipe = nullptr;
+    if (!CreatePipe(&readPipe, &writePipe, &sa, 0)) return -1;
+    SetHandleInformation(readPipe, HANDLE_FLAG_INHERIT, 0);
+    HANDLE nul = CreateFileW(L"NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, 0, nullptr);
+    HANDLE job = CreateJobObjectW(nullptr, nullptr);
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits{};
+    limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    if (job != nullptr) SetInformationJobObject(job, JobObjectExtendedLimitInformation, &limits, sizeof(limits));
+
+    HANDLE inherit[2] = {writePipe, nul};
+    const DWORD inheritCount = nul != INVALID_HANDLE_VALUE ? 2 : 1;
+    SIZE_T attributeSize = 0;
+    InitializeProcThreadAttributeList(nullptr, 2, 0, &attributeSize);
+    std::vector<char> attributes(attributeSize);
+    STARTUPINFOEXW si{};
+    si.StartupInfo.cb = sizeof(si);
+    si.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+    si.StartupInfo.hStdOutput = writePipe;
+    si.StartupInfo.hStdError = writePipe;
+    si.StartupInfo.hStdInput = nul != INVALID_HANDLE_VALUE ? nul : nullptr;
+    si.lpAttributeList = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attributes.data());
+    InitializeProcThreadAttributeList(si.lpAttributeList, 2, 0, &attributeSize);
+    if (job != nullptr) UpdateProcThreadAttribute(si.lpAttributeList, 0, kJobListAttribute, &job, sizeof(job), nullptr, nullptr);
+    UpdateProcThreadAttribute(si.lpAttributeList, 0, kHandleListAttribute, inherit, inheritCount * sizeof(HANDLE), nullptr, nullptr);
+
+    PROCESS_INFORMATION pi{};
+    bool started = false;
+    {
+        std::lock_guard lock(stop.mutex);
+        if (!stop.requested) {
+            started = CreateProcessW(nullptr, command.data(), nullptr, nullptr, TRUE,
+                                     CREATE_NO_WINDOW | EXTENDED_STARTUPINFO_PRESENT, nullptr, nullptr,
+                                     &si.StartupInfo, &pi) != FALSE;
+            if (started) stop.job = job;
+        }
+    }
+    const bool cancelled = !started && stop.Requested();
+    DeleteProcThreadAttributeList(si.lpAttributeList);
+    CloseHandle(writePipe);
+    if (nul != INVALID_HANDLE_VALUE) CloseHandle(nul);
+    if (!started) {
+        CloseHandle(readPipe);
+        if (job != nullptr) CloseHandle(job);
+        return cancelled ? -2 : -1;
+    }
+    CloseHandle(pi.hThread);
+    Lines lines;
+    char buffer[4096];
+    DWORD got = 0;
+    while (ReadFile(readPipe, buffer, sizeof(buffer), &got, nullptr) && got > 0) lines.Feed(buffer, got, onLine);
+    lines.Finish(onLine);
+    CloseHandle(readPipe);
+    WaitForSingleObject(pi.hProcess, INFINITE);
+    DWORD code = 1;
+    GetExitCodeProcess(pi.hProcess, &code);
+    CloseHandle(pi.hProcess);
+    {
+        std::lock_guard lock(stop.mutex);
+        stop.job = nullptr;
+    }
+    if (job != nullptr) CloseHandle(job);  // kills whatever the child left behind
+    return static_cast<int>(code);
+}
+
+// The swap / rollback hand-off: a hidden PowerShell that must outlive the launcher, so it is started
+// outside any job (CREATE_BREAKAWAY_FROM_JOB when this process is in one, e.g. started by the Setup),
+// with its output in a log file.
+bool StartDetached(const std::vector<std::string>& args, const fs::path& log, std::string& error) {
+    std::wstring command = CommandLine(args);
+    std::error_code ec;
+    fs::create_directories(log.parent_path(), ec);
+    SECURITY_ATTRIBUTES sa{sizeof(sa), nullptr, TRUE};
+    HANDLE out = CreateFileW(log.c_str(), GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, CREATE_ALWAYS,
+                             FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (out == INVALID_HANDLE_VALUE) {
+        error = "cannot write " + Utf8(log);
+        return false;
+    }
+    SIZE_T attributeSize = 0;
+    InitializeProcThreadAttributeList(nullptr, 1, 0, &attributeSize);
+    std::vector<char> attributes(attributeSize);
+    STARTUPINFOEXW si{};
+    si.StartupInfo.cb = sizeof(si);
+    si.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+    si.StartupInfo.hStdOutput = out;
+    si.StartupInfo.hStdError = out;
+    si.lpAttributeList = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attributes.data());
+    InitializeProcThreadAttributeList(si.lpAttributeList, 1, 0, &attributeSize);
+    UpdateProcThreadAttribute(si.lpAttributeList, 0, kHandleListAttribute, &out, sizeof(out), nullptr, nullptr);
+    BOOL inJob = FALSE;
+    IsProcessInJob(GetCurrentProcess(), nullptr, &inJob);
+    const DWORD flags = CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP | EXTENDED_STARTUPINFO_PRESENT;
+    PROCESS_INFORMATION pi{};
+    bool started = inJob && CreateProcessW(nullptr, command.data(), nullptr, nullptr, TRUE, flags | CREATE_BREAKAWAY_FROM_JOB,
+                                           nullptr, nullptr, &si.StartupInfo, &pi);
+    // A job that does not allow breaking away: the process still lives on unless that job kills on close.
+    if (!started) started = CreateProcessW(nullptr, command.data(), nullptr, nullptr, TRUE, flags, nullptr, nullptr, &si.StartupInfo, &pi);
+    const DWORD code = started ? 0 : GetLastError();
+    DeleteProcThreadAttributeList(si.lpAttributeList);
+    CloseHandle(out);
+    if (!started) {
+        error = "CreateProcess error " + std::to_string(code);
+        return false;
+    }
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return true;
+}
+#else
+std::string Curl() { return "curl"; }
+
+// POSIX counterpart: the child leads its own process group so Cancel() stops what it started.
+int RunHidden(const std::vector<std::string>& args, const LineFn& onLine, Updater::Stop& stop) {
+    std::vector<char*> argv;
+    for (const std::string& a : args) argv.push_back(const_cast<char*>(a.c_str()));
+    argv.push_back(nullptr);
+    int fds[2];
+    if (pipe(fds) != 0) return -1;
+    fcntl(fds[0], F_SETFD, FD_CLOEXEC);
+    fcntl(fds[1], F_SETFD, FD_CLOEXEC);
+    pid_t pid = -1;
+    {
+        std::lock_guard lock(stop.mutex);
+        if (stop.requested) {
+            close(fds[0]);
+            close(fds[1]);
+            return -2;
+        }
+        pid = fork();
+        if (pid == 0) {
+            setpgid(0, 0);
+            dup2(fds[1], 1);
+            dup2(fds[1], 2);
+            const int nul = open("/dev/null", O_RDONLY);
+            if (nul >= 0) dup2(nul, 0);
+            execvp(argv[0], argv.data());
+            _exit(127);
+        }
+        if (pid > 0) {
+            setpgid(pid, pid);
+            stop.group = pid;
+        }
+    }
+    close(fds[1]);
+    if (pid < 0) {
+        close(fds[0]);
+        return -1;
+    }
+    Lines lines;
+    char buffer[4096];
+    for (ssize_t got; (got = read(fds[0], buffer, sizeof(buffer))) != 0;) {
+        if (got < 0) {
+            if (errno == EINTR) continue;
+            break;
+        }
+        lines.Feed(buffer, static_cast<size_t>(got), onLine);
+    }
+    lines.Finish(onLine);
+    close(fds[0]);
+    int status = 0;
+    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {
+    }
+    {
+        std::lock_guard lock(stop.mutex);
+        stop.group = 0;
+    }
+    return WIFEXITED(status) ? WEXITSTATUS(status) : 128 + (WIFSIGNALED(status) ? WTERMSIG(status) : 0);
+}
+#endif
