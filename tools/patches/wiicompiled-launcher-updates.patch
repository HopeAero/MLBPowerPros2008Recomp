+static void TestDecide() {
+    Manifest m;
+    m.version = "0.1.9";
+    CHECK(Decide(m, "0.1.8", false) == Mode::Notify);
+    CHECK(Decide(m, "0.1.8", true) == Mode::Update);
+    CHECK(Decide(m, "0.1.9", true) == Mode::None);
+    CHECK(Decide(m, "0.2.0", false) == Mode::None);
+}
