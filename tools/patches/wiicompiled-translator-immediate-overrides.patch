diff --git a/translator/tests/Translator.Tests/ImmediateOverrideTests.cs b/translator/tests/Translator.Tests/ImmediateOverrideTests.cs
new file mode 100644
index 0000000..9c57946
--- /dev/null
+++ b/translator/tests/Translator.Tests/ImmediateOverrideTests.cs
@@ -0,0 +1,51 @@
+using System;
+using System.Collections.Generic;
+using Translator.Core.Translation;
+using Xunit;
+
+namespace Translator.Tests;
+
+// translation.immediate_overrides: a listed cmpwi/cmplwi reads its immediate from the runtime
+// (WiicompiledImmediate(address, original)) instead of the constant in the instruction.
+public sealed class ImmediateOverrideTests
+{
+    private const uint Entry = 0x80001000;
+
+    private static string Translate(IReadOnlyDictionary<uint, long>? overrides)
+    {
+        var image = TranslatorCppTestHarness.CreateImage(
+            (Entry + 0x00, 0x2C030009), // cmpwi r3, 9
+            (Entry + 0x04, 0x41820008), // beq +8
+            (Entry + 0x08, 0x38600001), // li r3, 1
+            (Entry + 0x0C, 0x4E800020)); // blr
+        return new FunctionTranslator(image).Translate(
+            Entry,
+            TranslationOptions.Default with
+            {
+                MaxBytes = 0x10,
+                AllowUnsupportedInstructions = true,
+                ImmediateOverrides = overrides
+            }).CxxCode;
+    }
+
+    [Fact]
+    public void ListedCompareReadsItsImmediateFromTheRuntime()
+    {
+        var code = Translate(new Dictionary<uint, long> { [Entry] = 9 });
+        Assert.Contains("WiicompiledImmediate(0x80001000u, 9)", code, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void UnlistedCompareKeepsItsConstant()
+    {
+        var code = Translate(null);
+        Assert.DoesNotContain("WiicompiledImmediate", code, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void ExpectedImmediateMismatchFailsNamingTheAddress()
+    {
+        var error = Assert.ThrowsAny<Exception>(() => Translate(new Dictionary<uint, long> { [Entry] = 8 }));
+        Assert.Contains("0x80001000", error.ToString(), StringComparison.Ordinal);
+    }
+}
