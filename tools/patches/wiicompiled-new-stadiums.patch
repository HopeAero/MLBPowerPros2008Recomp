+// Name banner of a stadium added by a mod: a 512x64 C8 texture in the layout the stadium select
+// screen uses for the game's own names (env_stadium_menu.pack): texture header at 0x20, pixels at
+// 0x60, palette colours after them, palette header at 0x8260. Drawn with a system font (never a
+// game asset): bold slanted letters, green fill with a vertical gradient and a dark green outline.
+#include "mods.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "imstb_truetype.h"
+
+namespace mods {
+namespace {
+
+constexpr int kWidth = 512, kHeight = 64;
+constexpr uint32_t kP = 0x40000000u;
+
+void Put32(std::vector<uint8_t>& d, size_t at, uint32_t v) {
+    for (int i = 0; i < 4; ++i) d[at + i] = static_cast<uint8_t>(v >> (24 - 8 * i));
+}
+
+void Put16(std::vector<uint8_t>& d, size_t at, uint16_t v) {
+    d[at] = static_cast<uint8_t>(v >> 8);
+    d[at + 1] = static_cast<uint8_t>(v);
+}
+
+std::vector<uint32_t> Codepoints(const std::string& text) {
+    std::vector<uint32_t> out;
+    for (size_t i = 0; i < text.size();) {
+        const auto c = static_cast<unsigned char>(text[i]);
+        const int n = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+        uint32_t cp = n == 1 ? c : c & (0xFF >> (n + 1));
+        for (int k = 1; k < n && i + k < text.size(); ++k) cp = (cp << 6) | (text[i + k] & 0x3F);
+        out.push_back(cp);
+        i += n;
+    }
+    return out;
+}
+
+std::vector<uint8_t> ReadFont() {
+#if defined(_WIN32)
+    const char* candidates[] = {"C:/Windows/Fonts/ariblk.ttf", "C:/Windows/Fonts/arialbd.ttf",
+                                "C:/Windows/Fonts/segoeuib.ttf"};
+#else
+    const char* candidates[] = {"/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
+                                "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf"};
+#endif
+    for (const char* path : candidates) {
+        std::ifstream in(path, std::ios::binary);
+        std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+        if (!data.empty()) return data;
+    }
+    return {};
+}
+
+// Text coverage (0..1) at kWidth x kHeight, upper case and slanted, placed like the game's names:
+// capitals 23 px tall from y 7 (the lower part of the texture stays empty), centred, smaller only
+// when the name would not fit.
+std::vector<float> RenderText(const std::vector<uint8_t>& font, const std::string& text) {
+    std::vector<float> cover(kWidth * kHeight, 0.0f);
+    stbtt_fontinfo info;
+    if (!stbtt_InitFont(&info, font.data(), stbtt_GetFontOffsetForIndex(font.data(), 0))) return cover;
+    auto cps = Codepoints(text);
+    // Small capitals, like the game: every letter upper case, the ones inside a word at 80 %.
+    std::vector<float> size(cps.size(), 1.0f);
+    for (size_t i = 0; i < cps.size(); ++i) {
+        uint32_t& cp = cps[i];
+        const bool lower = (cp >= 'a' && cp <= 'z') || (cp >= 0xE0 && cp <= 0xFE && cp != 0xF7);
+        const bool upper = (cp >= 'A' && cp <= 'Z') || (cp >= 0xC0 && cp <= 0xDE && cp != 0xD7);
+        if (lower) cp -= 0x20;
+        if ((lower || upper) && i > 0 && cps[i - 1] != ' ') size[i] = 0.8f;
+    }
+    constexpr float kSlant = 0.15f, kMargin = 40.0f, kTop = 7.0f;
+    int boxX0 = 0, boxY0 = 0, boxX1 = 0, capUnits = 0;
+    stbtt_GetCodepointBox(&info, 'H', &boxX0, &boxY0, &boxX1, &capUnits);
+    float capHeight = 23.0f, scale = 0.0f, width = 0.0f;
+    for (;; capHeight -= 1.0f) {  // shrink until the name fits
+        scale = capHeight / static_cast<float>(capUnits > 0 ? capUnits : 1);
+        width = 0.0f;
+        for (size_t i = 0; i < cps.size(); ++i) {
+            int advance = 0, bearing = 0;
+            stbtt_GetCodepointHMetrics(&info, static_cast<int>(cps[i]), &advance, &bearing);
+            width += advance * scale * size[i];
+            if (i + 1 < cps.size()) width += stbtt_GetCodepointKernAdvance(&info, cps[i], cps[i + 1]) * scale * size[i];
+        }
+        if (width + kSlant * capHeight <= kWidth - 2 * kMargin || capHeight <= 12.0f) break;
+    }
+    const float baseline = kTop + capHeight;
+    float x = (kWidth - width) / 2.0f;
+    for (size_t i = 0; i < cps.size(); ++i) {
+        int w = 0, h = 0, xoff = 0, yoff = 0;
+        const float shift = x - std::floor(x);
+        unsigned char* glyph = stbtt_GetCodepointBitmapSubpixel(&info, scale * size[i], scale * size[i], shift, 0.0f,
+                                                                static_cast<int>(cps[i]), &w, &h, &xoff, &yoff);
+        for (int gy = 0; gy < h; ++gy) {
+            const int y = static_cast<int>(baseline) + yoff + gy;
+            if (y < 0 || y >= kHeight) continue;
+            const float slant = kSlant * (baseline - y);
+            for (int gx = 0; gx < w; ++gx) {
+                const int px = static_cast<int>(std::floor(x)) + xoff + gx + static_cast<int>(std::lround(slant));
+                if (px < 0 || px >= kWidth) continue;
+                float& c = cover[y * kWidth + px];
+                c = std::max(c, glyph[gy * w + gx] / 255.0f);
+            }
+        }
+        stbtt_FreeBitmap(glyph, nullptr);
+        int advance = 0, bearing = 0;
+        stbtt_GetCodepointHMetrics(&info, static_cast<int>(cps[i]), &advance, &bearing);
+        x += advance * scale * size[i];
+        if (i + 1 < cps.size()) x += stbtt_GetCodepointKernAdvance(&info, cps[i], cps[i + 1]) * scale * size[i];
+    }
+    return cover;
+}
+
+// RGB5A3 entry for an 8-bit colour with a 0..7 alpha level.
+uint16_t Rgb5a3(int r, int g, int b, int alpha7) {
+    if (alpha7 >= 7) return static_cast<uint16_t>(0x8000 | ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3));
+    return static_cast<uint16_t>((alpha7 << 12) | ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4));
+}
