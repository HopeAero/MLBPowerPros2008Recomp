+
+bool WriteStadiumNameBanner(const std::filesystem::path& out, const std::string& name) {
+    const std::vector<uint8_t> font = ReadFont();
+    if (font.empty()) return false;
+    const std::vector<float> fill = RenderText(font, name);
+    // Like the game's names: a dark outer outline, a white rim, then the letters in green.
+    auto grow = [&](float radius) {
+        std::vector<float> out(fill.size(), 0.0f);
+        const int r = static_cast<int>(std::ceil(radius));
+        for (int y = 0; y < kHeight; ++y) {
+            for (int x = 0; x < kWidth; ++x) {
+                float best = 0.0f;
+                for (int dy = -r; dy <= r; ++dy) {
+                    for (int dx = -r; dx <= r; ++dx) {
+                        const int sx = x + dx, sy = y + dy;
+                        if (sx < 0 || sy < 0 || sx >= kWidth || sy >= kHeight || dx * dx + dy * dy > radius * radius)
+                            continue;
+                        best = std::max(best, fill[sy * kWidth + sx]);
+                    }
+                }
+                out[y * kWidth + x] = best;
+            }
+        }
+        return out;
+    };
+    const std::vector<float> rim = grow(1.5f), outline = grow(3.6f);
+    // Palette: 32 colours (0 dark outline, 1 white rim, 2..31 green from the bottom to the top of the
+    // letters) x 8 alpha levels; each pixel takes the closest colour.
+    float colours[32][3] = {{14, 50, 24}, {255, 255, 255}};
+    for (int s = 2; s < 32; ++s) {
+        const float t = (s - 2) / 29.0f;
+        const float bottom[3] = {20, 92, 22}, top[3] = {128, 214, 88};
+        for (int c = 0; c < 3; ++c) colours[s][c] = bottom[c] + (top[c] - bottom[c]) * t;
+    }
+    std::vector<uint16_t> palette(256);
+    for (int s = 0; s < 32; ++s) {
+        for (int a = 0; a < 8; ++a) {
+            palette[s * 8 + a] = Rgb5a3(static_cast<int>(colours[s][0]), static_cast<int>(colours[s][1]),
+                                        static_cast<int>(colours[s][2]), a);
+        }
+    }
+    std::vector<uint8_t> index(kWidth * kHeight, 0);
+    for (int y = 0; y < kHeight; ++y) {
+        const float t = std::clamp(1.0f - (y - 6.0f) / 30.0f, 0.0f, 1.0f);  // letters span about y 6..36
+        const float* green = colours[2 + static_cast<int>(std::lround(t * 29.0f))];
+        for (int x = 0; x < kWidth; ++x) {
+            const size_t i = static_cast<size_t>(y) * kWidth + x;
+            const float o = outline[i], r = rim[i], f = fill[i];
+            float rgb[3];
+            for (int c = 0; c < 3; ++c) {
+                const float under = colours[1][c] * r + colours[0][c] * (1.0f - r);
+                rgb[c] = green[c] * f + under * (1.0f - f);
+            }
+            int best = 0;
+            float bestDistance = 1e9f;
+            for (int s = 0; s < 32; ++s) {
+                float distance = 0.0f;
+                for (int c = 0; c < 3; ++c) distance += (rgb[c] - colours[s][c]) * (rgb[c] - colours[s][c]);
+                if (distance < bestDistance) bestDistance = distance, best = s;
+            }
+            const int alpha = std::clamp(static_cast<int>(std::lround(std::max(o, f) * 7.0f)), 0, 7);
+            index[i] = static_cast<uint8_t>(best * 8 + alpha);
+        }
+    }
+
+    std::vector<uint8_t> d(0x8280, 0);
+    std::memcpy(d.data(), "PACKWII ", 8);
+    Put32(d, 0x14, 0x20);
+    Put16(d, 0x20, kHeight);
+    Put16(d, 0x22, kWidth);
+    Put32(d, 0x24, 9);              // GX C8
+    Put32(d, 0x28, kP | 0x60);
+    Put32(d, 0x34, 1);
+    Put32(d, 0x38, 1);
+    for (int by = 0; by < kHeight / 4; ++by) {      // C8 tiles of 8x4
+        for (int bx = 0; bx < kWidth / 8; ++bx) {
+            for (int y = 0; y < 4; ++y) {
+                for (int x = 0; x < 8; ++x) {
+                    d[0x60 + ((by * (kWidth / 8) + bx) * 32) + y * 8 + x] = index[(by * 4 + y) * kWidth + bx * 8 + x];
+                }
+            }
+        }
+    }
+    for (int i = 0; i < 256; ++i) Put16(d, 0x8060 + i * 2, palette[i]);
+    Put16(d, 0x8260, 256);
+    d[0x8264] = 0x81;
+    Put16(d, 0x8266, 0x6000);
+    Put32(d, 0x8268, kP | 0x8060);
+    std::error_code ec;
+    std::filesystem::create_directories(out.parent_path(), ec);
+    std::ofstream file(out, std::ios::binary | std::ios::trunc);
+    file.write(reinterpret_cast<const char*>(d.data()), static_cast<std::streamsize>(d.size()));
+    return static_cast<bool>(file);
+}
+
+}  // namespace mods
