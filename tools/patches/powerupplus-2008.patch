diff --git a/PowerUp/PowerUp.ElectronUI/Api/Rosters/ExportRosterToModsCommand.cs b/PowerUp/PowerUp.ElectronUI/Api/Rosters/ExportRosterToModsCommand.cs
new file mode 100644
index 0000000..0af4693
--- /dev/null
+++ b/PowerUp/PowerUp.ElectronUI/Api/Rosters/ExportRosterToModsCommand.cs
@@ -0,0 +1,26 @@
+﻿using PowerUp.Databases;
+using PowerUp.Entities.Rosters;
+using PowerUp.GameSave.Api;
+using PowerUp.GameSave.PowerPros2008;
+
+namespace PowerUp.ElectronUI.Api.Rosters
+{
+  /// <summary>
+  /// Writes the roster as an MLB Power Pros 2008 mod straight into the game's mods folder, when
+  /// PowerUp+ was started by the 2008 launcher (PowerPros2008ModsDirectory); Folder is null otherwise.
+  /// </summary>
+  public class ExportRosterToModsCommand(IRosterExportApi rosterExportApi) : ICommand<ExportRosterRequest, ExportRosterToModsResponse>
+  {
+    public Task<ExportRosterToModsResponse> Execute(ExportRosterRequest request)
+    {
+      var modsDirectory = PowerPros2008Roster.ModsDirectory;
+      if (modsDirectory is null)
+        return Task.FromResult(new ExportRosterToModsResponse(null));
+
+      var roster = DatabaseConfig.Database.Load<Roster>(request.RosterId)!;
+      return Task.FromResult(new ExportRosterToModsResponse(rosterExportApi.WritePowerPros2008Mod(roster, modsDirectory)));
+    }
+  }
+
+  public record ExportRosterToModsResponse(string? Folder);
+}
