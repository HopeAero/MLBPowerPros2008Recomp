@@ -0,0 +1,54 @@
+using NUnit.Framework;
+using PowerUp.GameSave.PowerPros2008;
+using PowerUp.Mappers.Players;
+using Shouldly;
+
+namespace PowerUp.Tests.GameSave.PowerPros2008
+{
+  public class PowerPros2008SkinTests
+  {
+    // 2007 keeps 5 complexions (+5 for brown eyes); 2008 inserted one at 2 (+6 for brown eyes). In
+    // PowerUp+'s 2007 layout that 2008 complexion is 10 (blue eyes) / 11 (brown eyes).
+    [Test]
+    [TestCase(0, 0)]
+    [TestCase(1, 1)]
+    [TestCase(2, 3)]
+    [TestCase(4, 5)]
+    [TestCase(5, 6)]
+    [TestCase(6, 7)]
+    [TestCase(7, 9)]
+    [TestCase(9, 11)]
+    [TestCase(10, 2)]
+    [TestCase(11, 8)]
+    public void Skin2008_ShouldMapEvery2007LayoutValue(int value, int expected)
+    {
+      PowerPros2008Roster.Skin2008(value).ShouldBe(expected);
+    }
+
+    [Test]
+    [TestCase(0, 0)]
+    [TestCase(1, 1)]
+    [TestCase(2, 10)]
+    [TestCase(3, 2)]
+    [TestCase(5, 4)]
+    [TestCase(6, 5)]
+    [TestCase(7, 6)]
+    [TestCase(8, 11)]
+    [TestCase(9, 7)]
+    [TestCase(11, 9)]
+    public void Skin2007_ShouldKeepThe2008OnlyComplexion(int value, int expected)
+    {
+      PowerPros2008Roster.Skin2007(value).ShouldBe(expected);
+    }
+
+    [Test]
+    [TestCase(0, 0)]
+    [TestCase(9, 9)]
+    [TestCase(10, 1)]
+    [TestCase(11, 6)]
+    public void SkinFor2007Game_ShouldGiveThe2008OnlyComplexionTheClosestOne(int value, int expected)
+    {
+      AppearanceMapper.SkinFor2007Game((ushort)value).ShouldBe((ushort)expected);
+    }
