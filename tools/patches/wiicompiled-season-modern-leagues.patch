+// A schedule for leagues of odd size (15 and 15), which the game's generator (0x80B98320, made for even
+// leagues) leaves uneven. 54 rounds of 3-game series, every team in every round: 45 league rounds
+// (three round robins of the league, 15 rounds each; the team left over in each league plays the
+// other league's) and 9 interleague rounds (AL team i at NL team i + r). An off day after every 3
+// rounds, none from asgDay - 1 to asgDay + 2. 162 games a team; each series at the home of the team
+// with fewer home series so far, so home and away stay even. Not the
+// real one (division rivals are not played more): packs bring schedule/<year>.csv for that.
+// league[t] is 0 or 1, both of 15 teams; days from March 1; empty when the leagues are not 15 and 15.
+inline std::vector<Game> GenerateOddLeagues(const std::array<int, kTeams>& league, int year, int firstDay,
+                                            int asgDay) {
+    std::vector<int> members[2];
+    for (int t = 0; t < kTeams; ++t) members[league[t] & 1].push_back(t);
+    if (members[0].size() != 15 || members[1].size() != 15) return {};
+    struct Series {
+        int home, away;
+    };
+    using Round = std::vector<Series>;
+    // Round r of a 15-team round robin by the circle method (team 15 a bye): pairs and the one left over.
+    auto circle = [](int r, std::vector<std::pair<int, int>>& pairs) {
+        int bye = -1;
+        std::array<int, 16> slot{};
+        slot[0] = 15;
+        for (int i = 1; i < 16; ++i) slot[i] = (r + i - 1) % 15;
+        for (int i = 0; i < 8; ++i) {
+            const int a = slot[i], b = slot[15 - i];
+            if (a == 15 || b == 15) bye = a == 15 ? b : a;
+            else pairs.push_back({a, b});
+        }
+        return bye;
+    };
+    std::vector<Round> leagueRounds, interRounds;
+    for (int cycle = 0; cycle < 3; ++cycle) {
+        for (int r = 0; r < 15; ++r) {
+            Round round;
+            int byes[2];
+            for (int l = 0; l < 2; ++l) {
+                std::vector<std::pair<int, int>> pairs;
+                byes[l] = circle((r + year + l) % 15, pairs);
+                for (auto [a, b] : pairs) {
+                    const bool flip = ((a + b + cycle + r) & 1) != 0;
+                    round.push_back({members[l][flip ? b : a], members[l][flip ? a : b]});
+                }
+            }
+            const bool alHome = ((r + cycle) & 1) == 0;
+            round.push_back({members[alHome ? 0 : 1][byes[alHome ? 0 : 1]], members[alHome ? 1 : 0][byes[alHome ? 1 : 0]]});
+            leagueRounds.push_back(round);
+        }
+    }
+    for (int r = 0; r < 9; ++r) {
+        Round round;
+        for (int i = 0; i < 15; ++i) {
+            const int al = members[0][i], nl = members[1][(i + r + year) % 15];
+            round.push_back(((i + r) & 1) == 0 ? Series{al, nl} : Series{nl, al});
+        }
+        interRounds.push_back(round);
+    }
+    std::vector<Game> games;
+    std::array<int, kTeams> homeSeries{};
+    int day = firstDay, played = 0;
+    for (int k = 0; k < 54; ++k) {
+        Round round = k % 6 == 5 ? interRounds[k / 6] : leagueRounds[k - k / 6];  // inter every 6th
+        // Home goes to the team with fewer home series so far (the pairing's own order on a tie).
+        for (auto& s : round) {
+            if (homeSeries[s.away] < homeSeries[s.home]) std::swap(s.home, s.away);
+            ++homeSeries[s.home];
+        }
+        for (int g = 0; g < 3; ++g) {
+            while (day >= asgDay - 1 && day <= asgDay + 2) ++day;
+            for (const auto& s : round) games.push_back(Game{day, s.home, s.away, kDefaultTime});
+            ++day;
+        }
+        if (++played % 3 == 0) ++day;  // an off day for everyone
+    }
+    return games;
+}
+
 }  // namespace season_schedule
