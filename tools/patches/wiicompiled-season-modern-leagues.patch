+// A schedule for leagues of odd size (15 and 15), which the game's generator (0x80B98320, made for even
+// leagues) leaves uneven. Today's format (since 2023), 162 games a team:
+//   division rivals 13 each (3+3+3+4 series), 52;
+//   the other 10 league teams 6 or 7 (3+3 or 3+4; 7 against 2 teams of each other division, by year), 64;
+//   interleague 3 against each of the 14 other teams and 4 (2+2) against the natural rival, 46.
+// Series are put in rounds where every team plays one series (a round lasts as long as its longest
+// series; shorter ones leave an off day). An off day for everyone after every 4 rounds and none from
+// asgDay - 1 to asgDay + 2. division[t] is league * 3 + division (0..5); days from March 1; empty
+// when the leagues are not 15 and 15 or no round layout was found.
+inline std::vector<Game> GenerateOddLeagues(const std::array<int, kTeams>& division, int year, int firstDay,
+                                            int asgDay) {
+    std::vector<int> byDivision[6], byLeague[2];
+    for (int t = 0; t < kTeams; ++t) {
+        if (division[t] < 0 || division[t] > 5) return {};
+        byDivision[division[t]].push_back(t);
+        byLeague[division[t] / 3].push_back(t);
+    }
+    if (byLeague[0].size() != 15 || byLeague[1].size() != 15) return {};
+    for (const auto& d : byDivision)
+        if (d.size() != 5) return {};
+
+    // Natural rivals: today's pairs when both teams are in different leagues, else the same slot of the
+    // same division in the other league.
+    static constexpr const char* kRivals[15][2] = {
+        {"NYY", "NYM"}, {"BOS", "ATL"}, {"BAL", "WSH"}, {"TB", "FLA"}, {"TOR", "PHI"},
+        {"CWS", "CHC"}, {"CLE", "CIN"}, {"DET", "PIT"}, {"KC", "STL"}, {"MIN", "MIL"},
+        {"HOU", "COL"}, {"LAA", "LAD"}, {"OAK", "SF"},  {"SEA", "SD"},  {"TEX", "ARI"}};
+    std::array<int, kTeams> rival;
+    rival.fill(-1);
+    bool realRivals = true;
+    for (const auto& pair : kRivals) {
+        const int a = TeamNumber(pair[0]), b = TeamNumber(pair[1]);
+        if (division[a] / 3 == division[b] / 3) realRivals = false;
+        rival[a] = b, rival[b] = a;
+    }
+    if (!realRivals) {
+        for (int d = 0; d < 3; ++d)
+            for (int i = 0; i < 5; ++i) rival[byDivision[d][i]] = byDivision[d + 3][i], rival[byDivision[d + 3][i]] = byDivision[d][i];
+    }
+
+    // Every pair's series (lengths).
+    struct Series {
+        int a, b, length;
+    };
+    std::vector<Series> all;
+    uint32_t seed = static_cast<uint32_t>(year) * 2654435761u + 12345u;
+    auto next = [&seed] { seed = seed * 1103515245u + 12345u; return seed >> 8; };
+    // Home alternates within a pair; afterwards whole pairs are flipped while that brings every team's
+    // home games closer to 81.
+    std::vector<std::pair<size_t, size_t>> pairs;  // [first, last) series of each pair in `all`
+    auto add = [&](int a, int b, std::initializer_list<int> lengths) {
+        bool aHome = ((a + b + year) & 1) != 0;
+        const size_t first = all.size();
+        for (int length : lengths) {
+            all.push_back(aHome ? Series{a, b, length} : Series{b, a, length});
+            aHome = !aHome;
+        }
+        pairs.push_back({first, all.size()});
+    };
+    for (int l = 0; l < 2; ++l) {
+        for (int d = 0; d < 3; ++d) {
+            const auto& own = byDivision[l * 3 + d];
+            for (int i = 0; i < 5; ++i)
+                for (int j = i + 1; j < 5; ++j) add(own[i], own[j], {3, 3, 3, 4});
+            for (int e = d + 1; e < 3; ++e) {
+                const auto& other = byDivision[l * 3 + e];
+                const int k = (year + d + e) % 5;  // 7 games: i against other[i + k] and other[i + k + 1]
+                for (int i = 0; i < 5; ++i)
+                    for (int j = 0; j < 5; ++j) {
+                        const int off = (j - i - k + 10) % 5;
+                        if (off == 0 || off == 1) add(own[i], other[j], {3, 4});
+                        else add(own[i], other[j], {3, 3});
+                    }
+            }
+        }
+    }
+    for (int a : byLeague[0])
+        for (int b : byLeague[1]) {
+            if (rival[a] == b) add(a, b, {2, 2});
+            else add(a, b, {3});
+        }
+
+    std::array<int, kTeams> homeGames{};
+    for (const auto& x : all) homeGames[x.a] += x.length;
+    for (bool changed = true; changed;) {
+        changed = false;
+        for (const auto& [first, last] : pairs) {
+            int delta[kTeams] = {};
+            for (size_t i = first; i < last; ++i) delta[all[i].a] -= all[i].length, delta[all[i].b] += all[i].length;
+            const int a = all[first].a, b = all[first].b;
+            const auto cost = [](int h) { return (h - 81) * (h - 81); };
+            if (cost(homeGames[a] + delta[a]) + cost(homeGames[b] + delta[b]) < cost(homeGames[a]) + cost(homeGames[b])) {
+                for (size_t i = first; i < last; ++i) std::swap(all[i].a, all[i].b);
+                homeGames[a] += delta[a], homeGames[b] += delta[b];
+                changed = true;
+            }
+        }
+    }
+
+    // Rounds: every team plays one series of the round's length (a shorter one, leaving an off day, only
+    // where the leagues' odd size needs it), found by depth-first search with the most constrained
+    // team first. 4- and 2-game rounds are spread through the season. If a layout is not found, or
+    // the season would end after October 1, another order is tried.
+    for (int attempt = 0; attempt < 40; ++attempt) {
+        std::vector<Series> left = all;
+        for (size_t i = left.size(); i > 1; --i) std::swap(left[i - 1], left[next() % i]);
+        std::vector<std::vector<Series>> rounds;
+        bool failed = false;
+        while (!left.empty() && !failed) {
+            const int k = static_cast<int>(rounds.size());
+            int count[5] = {};
+            for (const auto& x : left) ++count[x.length];
+            int length = count[3] ? 3 : count[4] ? 4 : 2;
+            if (count[4] && k % 6 == 0) length = 4;
+            if (count[2] && (k == 18 || k == 36 || (!count[3] && !count[4]))) length = 2;
+            std::array<std::vector<int>, kTeams> options;  // indices into left, longest first
+            for (int len = length; len >= 2; --len)
+                for (int x = 0; x < static_cast<int>(left.size()); ++x)
+                    if (left[x].length == len) options[left[x].a].push_back(x), options[left[x].b].push_back(x);
+            std::array<int, kTeams> chosen;
+            std::vector<int> picked;
+            bool found = false;
+            // Fewest teams sitting out first, then fewest shorter series (sitting out only happens near
+            // the end, when what is left cannot pair everyone).
+            for (int step = 0; step < 16 * 16 && !found; ++step) {
+                const int maxIdle = step / 16 * 2, maxShort = step % 16;
+                chosen.fill(-1);
+                picked.clear();
+                int budget = 4000, shortUsed = 0, idleUsed = 0;
+                // Teams with nothing of this length or shorter left sit out; the rest must all play.
+                std::function<bool()> search = [&]() -> bool {
+                    if (--budget < 0) return false;
+                    int best = -1;
+                    size_t fewest = SIZE_MAX;
+                    for (int t = 0; t < kTeams; ++t) {
+                        if (chosen[t] != -1 || options[t].empty()) continue;
+                        size_t n = 0;
+                        for (int x : options[t]) n += chosen[left[x].a == t ? left[x].b : left[x].a] == -1;
+                        if (n < fewest) fewest = n, best = t;
+                    }
+                    if (best == -1) return true;
+                    for (int x : options[best]) {
+                        const int other = left[x].a == best ? left[x].b : left[x].a;
+                        const bool isShort = left[x].length < length;
+                        if (chosen[other] != -1 || (isShort && shortUsed >= maxShort)) continue;
+                        chosen[best] = chosen[other] = x;
+                        picked.push_back(x);
+                        shortUsed += isShort;
+                        if (search()) return true;
+                        shortUsed -= isShort;
+                        picked.pop_back();
+                        chosen[best] = chosen[other] = -1;
+                    }
+                    if (idleUsed >= maxIdle) return false;
+                    chosen[best] = -2;  // sits out this round
+                    ++idleUsed;
+                    if (search()) return true;
+                    --idleUsed;
+                    chosen[best] = -1;
+                    return false;
+                };
+                found = search();
+            }
+            if (!found) {
+                failed = true;
+                break;
+            }
+            std::vector<Series> round;
+            std::sort(picked.begin(), picked.end(), std::greater<int>());
+            for (int s : picked) {
+                round.push_back(left[s]);
+                left.erase(left.begin() + s);
+            }
+            rounds.push_back(round);
+        }
+        if (failed) { std::fprintf(stderr, "attempt %d: no round layout (%zu rounds, %zu series left)\n", attempt, rounds.size(), left.size()); continue; }
+
+        std::vector<Game> games;
+        int day = firstDay;
+        for (size_t r = 0; r < rounds.size(); ++r) {
+            int longest = 0;
+            for (const auto& s : rounds[r]) longest = std::max(longest, s.length);
+            for (int g = 0; g < longest; ++g) {
+                while (day >= asgDay - 1 && day <= asgDay + 2) ++day;
+                for (const auto& s : rounds[r])
+                    if (g < s.length) games.push_back(Game{day, s.a, s.b, kDefaultTime});
+                ++day;
+            }
+            if (r % 4 == 3) ++day;  // an off day for everyone
+        }
+        if (day - 1 + kFirstDay > 274) { std::fprintf(stderr, "attempt %d: %zu rounds, ends day %d\n", attempt, rounds.size(), day - 1 + kFirstDay); continue; }
+        return games;
+    }
+    return {};
+}
+
 }  // namespace season_schedule
