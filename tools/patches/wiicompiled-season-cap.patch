diff --git a/runtime/include/season_cap.h b/runtime/include/season_cap.h
new file mode 100644
index 0000000..7502e0d
--- /dev/null
+++ b/runtime/include/season_cap.h
@@ -0,0 +1,142 @@
+#pragma once
+// Season mode up to 20 seasons (launcher option GAME > SEASONS, [season] max_seasons = 10 | 20).
+//
+// The original stops after 10 seasons (2008-2017). Almost every per-year table already has room for
+// 20; the cap is the virtual 0x80C06534 (returns 10) and five fixed compares, which the translator
+// routes to WiicompiledImmediate (config/wiicompiled/rl8e54.yml, translation.immediate_overrides).
+// The finances keep 10 years only: years 10..19 live here, and travel in the free tail of the
+// season save file (the save data is 0x119910 bytes, the file is padded with zeros to 0x120000).
+// Docs: docs/ingenieria-inversa.md "Año de la temporada"; plan docs/superpowers/plans/2026-10-19-season-20-build.md
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace season_cap {
+
+constexpr int kOriginalSeasons = 10;
+constexpr int kMaxSeasons = 20;
+constexpr uint32_t kSaveDataSize = 0x119910;  // what the game writes and reads back
+constexpr uint32_t kSaveFileSize = 0x120000;  // pm3usse<slot>.dat
+constexpr int kFinanceItems = 11;             // 10 items and the balance, per year
+
+// Seasons for this run: 20 with the option, and also when the loaded save is already past season 10
+// (the original would write past its 10-year finance table). Index 10 with the finished flag is the
+// original game's own end state, which keeps the original behaviour under 10.
+inline int CountFor(int configured, int loadedIndex, bool finishedFlag) {
+    if (configured == kMaxSeasons || loadedIndex > kOriginalSeasons) return kMaxSeasons;
+    if (loadedIndex == kOriginalSeasons && !finishedFlag) return kMaxSeasons;
+    return kOriginalSeasons;
+}
+
+// The finished flag (bit 0x20 of [[0x8104B5A8] + 0x104], read by 0x80C0D438): set when the mode's
+// ending plays, and a finished save replays the ending on load. An ending reached before this run's
+// last season (the original's, after season 10, with 20 seasons now) no longer counts.
+inline bool Finished(bool flag, int index, int count) { return flag && index >= count; }
+
+// The cap compares, by instruction address: 9 means "last season", 10 "number of seasons".
+inline bool IsCapCompare(uint32_t address) {
+    switch (address) {
+    case 0x80BB4A6Cu:  // index == 9: message 141
+    case 0x80BF2530u:  // index < 9: calls 0x80BF619C
+    case 0x80BF51BCu:  // off-season events, index < 9
+    case 0x80BF52D0u:  // off-season events, index < 9
+    case 0x80C0CC0Cu:  // index < 10
+        return true;
+    default:
+        return false;
+    }
+}
+
+inline int32_t ImmediateFor(uint32_t address, int32_t original, int count) {
+    return IsCapCompare(address) ? original - kOriginalSeasons + count : original;
+}
+
+// Finances of years 10..19 (slot = year - 10): the yearly summary (Q + 44 + year * 44 in the game)
+// and the yearly value (Q + 4 + year * 4).
+struct FinanceStore {
+    int32_t annual[kMaxSeasons - kOriginalSeasons][kFinanceItems] = {};
+    int32_t yearly[kMaxSeasons - kOriginalSeasons] = {};
+};
+
+// Drops every stored year after `index` (a season index, 0..19): what the game does not have yet.
+inline void ClearAfter(FinanceStore& store, int index) {
+    for (int year = kOriginalSeasons; year < kMaxSeasons; ++year) {
+        if (year <= index) continue;
+        std::memset(store.annual[year - kOriginalSeasons], 0, sizeof(store.annual[0]));
+        store.yearly[year - kOriginalSeasons] = 0;
+    }
+}
+
+// Tail layout: "PPSEASON" magic, u32 version 1, then annual and yearly as big-endian u32.
+constexpr char kTailMagic[8] = {'P', 'P', 'S', 'E', 'A', 'S', 'O', 'N'};
+constexpr size_t kTailBytes = 12 + sizeof(FinanceStore);
+
+inline void PutBe32(uint8_t* p, uint32_t v) {
+    p[0] = static_cast<uint8_t>(v >> 24); p[1] = static_cast<uint8_t>(v >> 16);
+    p[2] = static_cast<uint8_t>(v >> 8);  p[3] = static_cast<uint8_t>(v);
+}
+inline uint32_t GetBe32(const uint8_t* p) {
+    return (uint32_t{p[0]} << 24) | (uint32_t{p[1]} << 16) | (uint32_t{p[2]} << 8) | p[3];
+}
+
+inline void WriteTail(const FinanceStore& store, uint8_t* tail, size_t size) {
+    if (size < kTailBytes) return;
+    std::memcpy(tail, kTailMagic, 8);
+    PutBe32(tail + 8, 1);
+    const int32_t* values = &store.annual[0][0];
+    for (size_t i = 0; i < sizeof(FinanceStore) / 4; ++i) PutBe32(tail + 12 + 4 * i, static_cast<uint32_t>(values[i]));
+}
+
+// False (and an empty store) when the tail is not ours, e.g. the game's own zero padding.
+inline bool ReadTail(const uint8_t* tail, size_t size, FinanceStore& store) {
+    store = {};
+    if (size < kTailBytes || std::memcmp(tail, kTailMagic, 8) != 0 || GetBe32(tail + 8) != 1) return false;
+    int32_t* values = &store.annual[0][0];
+    for (size_t i = 0; i < sizeof(FinanceStore) / 4; ++i) values[i] = static_cast<int32_t>(GetBe32(tail + 12 + 4 * i));
+    return true;
+}
+
+// The game writes and reads the save in chunks. OverlayTail puts our tail into whatever part of
+// [kSaveDataSize, kSaveDataSize + kTailBytes) a write chunk covers.
+inline void OverlayTail(const FinanceStore& store, uint32_t fileOffset, uint8_t* data, size_t length) {
+    const uint32_t begin = kSaveDataSize, end = kSaveDataSize + static_cast<uint32_t>(kTailBytes);
+    const uint32_t from = fileOffset > begin ? fileOffset : begin;
+    const uint32_t to = fileOffset + length < end ? fileOffset + static_cast<uint32_t>(length) : end;
+    if (from >= to) return;
+    uint8_t tail[kTailBytes];
+    WriteTail(store, tail, sizeof(tail));
+    std::memcpy(data + (from - fileOffset), tail + (from - begin), to - from);
+}
+
+// Collects the tail across read chunks; Feed returns true (with store filled from it) on the
+// chunk that completes the tail.
+struct TailReader {
+    uint8_t tail[kTailBytes] = {};
+    bool Feed(uint32_t fileOffset, const uint8_t* data, size_t length, FinanceStore& store) {
+        const uint32_t begin = kSaveDataSize, end = kSaveDataSize + static_cast<uint32_t>(kTailBytes);
+        const uint32_t from = fileOffset > begin ? fileOffset : begin;
+        const uint32_t to = fileOffset + length < end ? fileOffset + static_cast<uint32_t>(length) : end;
+        if (from >= to) return false;
+        std::memcpy(tail + (from - begin), data + (from - fileOffset), to - from);
+        if (to != end) return false;
+        return ReadTail(tail, sizeof(tail), store);
+    }
+};
+
+// pm3usse0.dat .. pm3usse2.dat, the three Season mode slots.
+inline bool IsSeasonSaveName(const char* fileName) {
+    return fileName && std::strncmp(fileName, "pm3usse", 7) == 0 && fileName[7] >= '0' && fileName[7] <= '2' &&
+           std::strcmp(fileName + 8, ".dat") == 0;
+}
+
+// Runtime side (hle/mlb/season_cap.cpp).
+int Count();                          // this run's number of seasons
+FinanceStore& Store();                // years 10..19 of the loaded season save
+void OnHostFrame();                   // settings_overlay.cpp, once per presented frame
+// nand_isfs.cpp hooks for the season saves (IsSeasonSaveName): a read of `length` bytes at
+// fileOffset landed in data; a write of length bytes at fileOffset is about to go out from data
+// (a copy the hook may change).
+void OnSeasonSaveRead(uint32_t fileOffset, const uint8_t* data, size_t length);
+void OnSeasonSaveWrite(uint32_t fileOffset, uint8_t* data, size_t length);
+
+}  // namespace season_cap
diff --git a/runtime/src/hle/mlb/season_cap.cpp b/runtime/src/hle/mlb/season_cap.cpp
new file mode 100644
index 0000000..5d88e96
--- /dev/null
+++ b/runtime/src/hle/mlb/season_cap.cpp
@@ -0,0 +1,181 @@
+// Season mode up to 20 seasons: the cap and the finances of years 10..19 (season_cap.h).
+#include "season_cap.h"
+
+#include <atomic>
+#include <cstdio>
+
+#include "abi_bridge.h"
+#include "memory.h"
+#include "runtime_config.h"
+
+namespace season_cap {
+
+namespace {
+
+FinanceStore g_store;
+
+// [[0x8104B5A8] + 8]: the season index, or -1 outside Season mode.
+int CurrentIndex() {
+    const uint32_t state = Memory::Read32(0x8104B5A8u);
+    if (!state || !Memory::Contains(state, 16)) return -1;
+    return static_cast<int8_t>(Memory::Read8(state + 8));
+}
+
+// The raw finished flag: bit 0x20 of [state + 0x104].
+bool FinishedFlag() {
+    const uint32_t state = Memory::Read32(0x8104B5A8u);
+    if (!state || !Memory::Contains(state, 0x108)) return false;
+    return (Memory::Read8(state + 0x104) & 0x20) != 0;
+}
+
+uint32_t Call(CpuContext* ctx, uint32_t returnAddress, void (*invoke)(CpuContext*)) {
+    ctx->lr = returnAddress;
+    invoke(ctx);
+    return ctx->gpr[3];
+}
+
+// The game's own helpers: finance block Q, current balance, month of today (1..12).
+uint32_t FinanceBase(CpuContext* ctx) { return Call(ctx, 0x80C0D460u, InvokeDirectCpu<0x80C0D460u>); }
+uint32_t Balance(CpuContext* ctx) { return Call(ctx, 0x80C0D5ACu, InvokeDirectCpu<0x80C0D5ACu>); }
+int Month(CpuContext* ctx) {
+    ctx->gpr[3] = Memory::Read32(0x8104BA10u);
+    return static_cast<int>(Call(ctx, 0x80B4AA38u, InvokeDirectCpu<0x80B4AA38u>));
+}
+
+// Yearly summary of year (0..19), item 0..10: game memory below 10, the store above.
+int32_t ReadAnnual(uint32_t q, int year, int item) {
+    if (year >= kOriginalSeasons && year < kMaxSeasons) return g_store.annual[year - kOriginalSeasons][item];
+    return static_cast<int32_t>(Memory::Read32(q + 44 + static_cast<uint32_t>(year) * 44 + static_cast<uint32_t>(item) * 4));
+}
+void WriteAnnual(uint32_t q, int year, int item, int32_t value) {
+    if (year >= kOriginalSeasons && year < kMaxSeasons) {
+        g_store.annual[year - kOriginalSeasons][item] = value;
+        return;
+    }
+    Memory::Write32(q + 44 + static_cast<uint32_t>(year) * 44 + static_cast<uint32_t>(item) * 4, static_cast<uint32_t>(value));
+}
+uint32_t MonthlyAddress(uint32_t q, int month, int item) {
+    return q + 484 + static_cast<uint32_t>(month - 1) * 44 + static_cast<uint32_t>(item) * 4;
+}
+
+}  // namespace
+
+int Count() {
+    const int count = CountFor(static_cast<int>(RuntimeConfigFile::MaxSeasons(10)), CurrentIndex(), FinishedFlag());
+    static std::atomic<int> logged{0};
+    if (logged.exchange(count) != count) std::fprintf(stderr, "[season] %d seasons\n", count);
+    return count;
+}
+
+FinanceStore& Store() { return g_store; }
+
+void OnHostFrame() {
+    // A save the original game finished after season 10 replays its ending on load; with more seasons
+    // the flag is cleared as soon as the save is in memory, before the menu reads it. The game's own
+    // checksum covers it on the next save. (The load-time check does not go through 0x80C0D438.)
+    const uint32_t state = Memory::Read32(0x8104B5A8u);
+    if (!state || !Memory::Contains(state, 0x108)) return;
+    if (!FinishedFlag() || Finished(true, CurrentIndex(), Count())) return;
+    Memory::Write8(state + 0x104, static_cast<uint8_t>(Memory::Read8(state + 0x104) & ~0x20));
+    std::fprintf(stderr, "[season] season %d: the ending flag of a shorter game cleared\n", CurrentIndex() + 1);
+}
+
+void OnSeasonSaveRead(uint32_t fileOffset, const uint8_t* data, size_t length) {
+    // The slot list reads only the header; a load reads the whole file, in chunks.
+    static TailReader reader;
+    FinanceStore loaded;
+    const uint32_t tailEnd = kSaveDataSize + static_cast<uint32_t>(kTailBytes);
+    if (fileOffset >= tailEnd || fileOffset + length <= kSaveDataSize) return;
+    const bool ours = reader.Feed(fileOffset, data, length, loaded);
+    if (fileOffset + length < tailEnd) return;  // the tail is not complete yet
+    g_store = loaded;                           // empty for a save without our tail
+    if (ours) std::fprintf(stderr, "[season] finances of seasons 11-20 read from the save\n");
+}
+
+void OnSeasonSaveWrite(uint32_t fileOffset, uint8_t* data, size_t length) {
+    if (CurrentIndex() < kOriginalSeasons) return;  // nothing stored: keep the original file byte for byte
+    OverlayTail(g_store, fileOffset, data, length);
+    if (fileOffset + length >= kSaveDataSize + kTailBytes && fileOffset < kSaveDataSize + kTailBytes)
+        std::fprintf(stderr, "[season] finances of seasons 11-20 written to the save\n");
+}
+
+}  // namespace season_cap
+
+using namespace season_cap;
+
+extern "C" int32_t WiicompiledImmediate(uint32_t address, int32_t original) {
+    return ImmediateFor(address, original, Count());
+}
+
+// 0x80C06534: number of seasons (returns 10 in the original).
+extern "C" void MLB_SeasonCount_80C06534(CpuContext* ctx) { ctx->gpr[3] = static_cast<uint32_t>(Count()); }
+PPC_NATIVE_OVERRIDE_VOID(80C06534, MLB_SeasonCount_80C06534, (CpuContext* ctx), (ctx));
+
+// 0x80C0D438: has Season mode ended (bit 0x20 of [state + 0x104])? Not when the ending came before
+// this run's last season, so a save the original finished after season 10 goes on to 2018.
+extern "C" void MLB_SeasonFinished_80C0D438(CpuContext* ctx) {
+    ctx->gpr[3] = Finished(FinishedFlag(), CurrentIndex(), Count()) ? 1u : 0u;
+}
+PPC_NATIVE_OVERRIDE_VOID(80C0D438, MLB_SeasonFinished_80C0D438, (CpuContext* ctx), (ctx));
+
+// 0x80C0D614 (year, item): yearly summary.
+extern "C" void MLB_FinanceAnnual_80C0D614(CpuContext* ctx) {
+    const int year = static_cast<int32_t>(ctx->gpr[3]);
+    const int item = static_cast<int32_t>(ctx->gpr[4]);
+    const uint32_t q = FinanceBase(ctx);
+    ctx->gpr[3] = static_cast<uint32_t>(ReadAnnual(q, year, item));
+}
+PPC_NATIVE_OVERRIDE_VOID(80C0D614, MLB_FinanceAnnual_80C0D614, (CpuContext* ctx), (ctx));
+
+// 0x80C0D658: the balance closes this month's and this year's row.
+extern "C" void MLB_FinanceClose_80C0D658(CpuContext* ctx) {
+    const uint32_t monthBalance = Balance(ctx);
+    const int month = Month(ctx);
+    const uint32_t q = FinanceBase(ctx);
+    Memory::Write32(MonthlyAddress(q, month, 10), monthBalance);
+    const uint32_t yearBalance = Balance(ctx);
+    const int index = CurrentIndex();
+    ClearAfter(g_store, index);  // a new game or an older save: no stored years past today
+    WriteAnnual(FinanceBase(ctx), index, 10, static_cast<int32_t>(yearBalance));
+}
+PPC_NATIVE_OVERRIDE_VOID(80C0D658, MLB_FinanceClose_80C0D658, (CpuContext* ctx), (ctx));
+
+// 0x80C0D6D0 / 0x80C0D758 (item, amount): add to this month and this year, move the balance
+// (0x80C0E820 with -amount and +amount respectively), close.
+static void AddFinance(CpuContext* ctx, bool income) {
+    const int item = static_cast<int32_t>(ctx->gpr[3]);
+    const int32_t amount = static_cast<int32_t>(ctx->gpr[4]);
+    const int month = Month(ctx);
+    uint32_t q = FinanceBase(ctx);
+    const uint32_t monthly = MonthlyAddress(q, month, item);
+    Memory::Write32(monthly, Memory::Read32(monthly) + static_cast<uint32_t>(amount));
+    const int index = CurrentIndex();
+    q = FinanceBase(ctx);
+    WriteAnnual(q, index, item, ReadAnnual(q, index, item) + amount);
+    ctx->gpr[3] = FinanceBase(ctx);
+    ctx->gpr[4] = static_cast<uint32_t>(income ? amount : -amount);
+    Call(ctx, 0x80C0E820u, InvokeDirectCpu<0x80C0E820u>);
+    Call(ctx, 0x80C0D658u, InvokeDirectCpu<0x80C0D658u>);
+}
+extern "C" void MLB_FinanceExpense_80C0D6D0(CpuContext* ctx) { AddFinance(ctx, false); }
+PPC_NATIVE_OVERRIDE_VOID(80C0D6D0, MLB_FinanceExpense_80C0D6D0, (CpuContext* ctx), (ctx));
+extern "C" void MLB_FinanceIncome_80C0D758(CpuContext* ctx) { AddFinance(ctx, true); }
+PPC_NATIVE_OVERRIDE_VOID(80C0D758, MLB_FinanceIncome_80C0D758, (CpuContext* ctx), (ctx));
+
+// 0x80C0D818 (year, value) / 0x80C0D85C (year): the yearly value.
+extern "C" void MLB_FinanceYearlySet_80C0D818(CpuContext* ctx) {
+    const int year = static_cast<int32_t>(ctx->gpr[3]);
+    const uint32_t value = ctx->gpr[4];
+    const uint32_t q = FinanceBase(ctx);
+    if (year >= kOriginalSeasons && year < kMaxSeasons) g_store.yearly[year - kOriginalSeasons] = static_cast<int32_t>(value);
+    else Memory::Write32(q + 4 + static_cast<uint32_t>(year) * 4, value);
+}
+PPC_NATIVE_OVERRIDE_VOID(80C0D818, MLB_FinanceYearlySet_80C0D818, (CpuContext* ctx), (ctx));
+extern "C" void MLB_FinanceYearlyGet_80C0D85C(CpuContext* ctx) {
+    const int year = static_cast<int32_t>(ctx->gpr[3]);
+    const uint32_t q = FinanceBase(ctx);
+    ctx->gpr[3] = year >= kOriginalSeasons && year < kMaxSeasons
+                      ? static_cast<uint32_t>(g_store.yearly[year - kOriginalSeasons])
+                      : Memory::Read32(q + 4 + static_cast<uint32_t>(year) * 4);
+}
+PPC_NATIVE_OVERRIDE_VOID(80C0D85C, MLB_FinanceYearlyGet_80C0D85C, (CpuContext* ctx), (ctx));
