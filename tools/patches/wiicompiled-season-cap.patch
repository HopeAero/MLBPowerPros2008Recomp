diff --git a/runtime/tests/season_cap_tests.cpp b/runtime/tests/season_cap_tests.cpp
new file mode 100644
index 0000000..e594af5
--- /dev/null
+++ b/runtime/tests/season_cap_tests.cpp
@@ -0,0 +1,99 @@
+#include "season_cap.h"
+#include <algorithm>
+#include <cstdio>
+#include <vector>
+
+static int failures = 0;
+static void Check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+int main() {
+    using namespace season_cap;
+    // The count is fixed per game (option, or what the loaded save says), never from the live index.
+    Check(CountFor(10, false) == 10, "option 10, an original save: 10");
+    Check(CountFor(20, false) == 20, "option 20: 20");
+    Check(CountFor(10, true) == 20, "option 10 but the loaded save went past season 10 with 20: 20");
+    Check(CountFor(15, false) == 10, "anything but 20 is the original 10");
+    Check(SaveIsExtended(11, false), "a save at season 12 can only come from 20");
+    Check(SaveIsExtended(10, true), "our tail marks a save played with 20");
+    Check(!SaveIsExtended(10, false), "index 10 without our tail: the original's own end state");
+    Check(!SaveIsExtended(3, false), "an early save");
+
+    // The ending flag: the natural end is on 11/01 of the last season (index count - 1).
+    Check(Finished(true, 9, 10), "original: finished in season 10");
+    Check(Finished(true, 10, 10), "original: finished after the rollover");
+    Check(!Finished(true, 9, 20), "season 10 ending, now 20 seasons: not finished");
+    Check(Finished(true, 19, 20), "season 20 ending");
+    Check(!Finished(false, 19, 20), "no flag");
+    Check(ClearStaleFinished(true, 9, 20) && ClearStaleFinished(true, 10, 20), "20 seasons: an earlier ending is cleared");
+    Check(!ClearStaleFinished(true, 9, 10) && !ClearStaleFinished(true, 10, 10), "10 seasons: never cleared");
+    Check(!ClearStaleFinished(true, 19, 20), "the season-20 ending stays");
+
+    Check(ImmediateFor(0x80BB4A6Cu, 9, 20) == 19, "last-season compare follows the cap");
+    Check(ImmediateFor(0x80C0CC0Cu, 10, 20) == 20, "season-count compare follows the cap");
+    Check(ImmediateFor(0x80BB4A6Cu, 9, 10) == 9, "cap 10 keeps the original");
+    Check(ImmediateFor(0x80001000u, 9, 20) == 9, "an address not in the list keeps its immediate");
+
+    // Where a finance year lives.
+    Check(FinanceSlot(9, 20) == FinanceWhere::Game, "year 9: the game's table");
+    Check(FinanceSlot(10, 20) == FinanceWhere::Store, "year 10 with 20 seasons: the store");
+    Check(FinanceSlot(19, 20) == FinanceWhere::Store, "year 19 with 20 seasons: the store");
+    Check(FinanceSlot(20, 20) == FinanceWhere::Nowhere, "year 20: past every table, dropped");
+    Check(FinanceSlot(10, 10) == FinanceWhere::Game, "10 seasons: always the original address, even past the table");
+    Check(FinanceSlot(-1, 20) == FinanceWhere::Nowhere, "no season");
+    Check(ItemInRange(0) && ItemInRange(10) && !ItemInRange(11) && !ItemInRange(-1), "finance items 0..10");
+
+    FinanceStore store;
+    Check(store.annual[0][0] == 0 && store.yearly[9] == 0, "a new store is empty");
+    store.annual[0][10] = 12345;
+    store.annual[9][3] = -7;
+    store.yearly[4] = 99;
+    std::vector<uint8_t> file(kSaveFileSize, 0);
+    WriteTail(store, file.data() + kSaveDataSize, kSaveFileSize - kSaveDataSize);
+    FinanceStore back;
+    Check(ReadTail(file.data() + kSaveDataSize, kSaveFileSize - kSaveDataSize, back), "tail written by us reads back");
+    Check(back.annual[0][10] == 12345 && back.annual[9][3] == -7 && back.yearly[4] == 99, "values survive");
+    std::vector<uint8_t> zeros(kSaveFileSize - kSaveDataSize, 0);
+    Check(!ReadTail(zeros.data(), zeros.size(), back) && back.annual[0][10] == 0, "the game's zero tail: empty store");
+
+    FinanceStore keep = store;
+    ClearAfter(keep, 13);
+    Check(keep.annual[0][10] == 12345 && keep.yearly[4] == 0 && keep.annual[9][3] == 0,
+          "clearing after year 13 keeps 10..13 and drops 14..19");
+    ClearAfter(keep, 0);
+    Check(keep.annual[0][10] == 0, "a season at year 0 (new game) drops every stored year");
+
+    for (uint32_t chunk : {0x4000u, 0x1000u, 0x120000u, 0x777u}) {
+        std::vector<uint8_t> out(kSaveFileSize, 0);
+        for (uint32_t at = 0; at < kSaveFileSize; at += chunk) {
+            const uint32_t n = std::min(chunk, kSaveFileSize - at);
+            OverlayTail(store, at, out.data() + at, n);
+        }
+        TailReader reader;
+        FinanceStore got;
+        bool done = false;
+        for (uint32_t at = 0; at < kSaveFileSize; at += chunk) {
+            const uint32_t n = std::min(chunk, kSaveFileSize - at);
+            done |= reader.Feed(at, out.data() + at, n, got);
+        }
+        Check(done && got.annual[0][10] == 12345 && got.yearly[4] == 99, "chunked write and read keep the tail");
+        Check(std::all_of(out.begin(), out.begin() + kSaveDataSize, [](uint8_t b) { return b == 0; }),
+              "the overlay never touches the game's data");
+    }
+
+    // The loaded file says which season and whether it ended (offsets in the file).
+    std::vector<uint8_t> save(kSaveFileSize, 0);
+    save[kFileIndexOffset] = 11;
+    save[kFileFlagsOffset] = 0x23;
+    Check(FileIndex(save.data()) == 11 && FileFinishedFlag(save.data()), "index and ending flag from the file");
+
+    Check(IsSeasonSaveName("pm3usse0.dat") && IsSeasonSaveName("pm3usse2.dat"), "season slots");
+    Check(!IsSeasonSaveName("pm3usma.dat") && !IsSeasonSaveName("pm3usse3.dat") && !IsSeasonSaveName("pm3usse0.dat.tmp"),
+          "main data, a fourth slot and a scratch file are not season saves");
+    if (failures == 0) std::puts("season_cap_tests: OK");
+    return failures != 0;
+}
