+int SeasonCount() {
+    const int count = CountFor(ConfiguredCount(RuntimeConfigFile::MaxSeasons(10)), g_needed.load());
+    static std::atomic<int> logged{0};
+    if (logged.exchange(count) != count) std::fprintf(stderr, "[season] %d seasons\n", count);
+    return count;
+}
+
+int Count() { return SeasonModeActive() ? SeasonCount() : kOriginalSeasons; }
+
+uint32_t YearOffset() { return SeasonModeActive() ? g_tail.yearOffset : 0; }
