+static void TakeLoad();
+
+void OnHostFrame() {
+    // Only reads, except right after a season save was loaded (TakeLoad sets a pending index).
+    ++g_frame;
+    TakeLoad();
+    const int index = CurrentIndex();
+    if (!g_loadedInMemory.load() && index == g_loadedIndex.load()) g_loadedInMemory.store(true);
+    if (g_needed.load() > kOriginalSeasons && g_loadedInMemory.load() && index >= 0 && index < kOriginalSeasons) {
+        g_needed.store(kOriginalSeasons);  // a new game is running now
+        g_tail = {};
+    }
+    const int pending = g_pendingIndex.load();
+    if (pending < 0) return;
+    if (++g_pendingFrames > 600) {  // ten seconds without the save showing up in memory: give up
+        g_pendingIndex.store(-1);
+        return;
+    }
+    if (index != pending || !SeasonModeActive()) return;
+    g_pendingIndex.store(-1);
+    // The number of seasons the game keeps when the mode starts (0x80C0C50C, 0x80BA0878): the loaded save
+    // may need more than the last game had, and the contract lengths read it before the next day.
+    if (Count() > kOriginalSeasons && Memory::Read32(0x8104BA2Cu) != static_cast<uint32_t>(Count())) {
+        Memory::Write32(0x8104BA2Cu, static_cast<uint32_t>(Count()));
+        std::fprintf(stderr, "[season] season count set to %d for the loaded save\n", Count());
+    }
+    if (!ClearStaleFinished(FinishedFlag(), index, Count())) return;
+    // A save the original game finished after season 10 replays its ending on load; with more seasons
+    // the flag goes as soon as the save is in memory, before the menu reads it. The game's checksum
+    // covers it on the next save. (The load-time check does not go through 0x80C0D438.)
+    const uint32_t state = State();
+    Memory::Write8(state + 0x104, static_cast<uint8_t>(Memory::Read8(state + 0x104) & ~0x20));
+    std::fprintf(stderr, "[season] season %d: the ending flag of a shorter game cleared\n", index + 1);
+}
+
+void OnSeasonSaveRead(uint32_t fileOffset, const uint8_t* data, size_t length, const uint8_t* tail) {
+    // The slot list reads only the first chunk. A load reads 16 KB chunks up to the one past the
+    // game's data; saving reads the slot's old file whole, writes, and reads it back whole.
+    static int fileIndex = -1;
+    if (fileOffset == 0) fileIndex = -1;
+    if (fileOffset <= kFileIndexOffset && kFileIndexOffset < fileOffset + length)
+        fileIndex = static_cast<int8_t>(data[kFileIndexOffset - fileOffset]);
+    std::lock_guard<std::mutex> lock(g_candidateLock);
+    if (fileOffset >= kSaveDataSize) {
+        g_candidate.set = false;  // past the data: a save's read, not a load
+        return;
+    }
+    if (!tail || fileIndex < 0) return;  // a load reads from the start
+    g_candidate.ours = ReadTail(tail, kTailSize, g_candidate.tail);
+    g_candidate.index = fileIndex;
+    g_candidate.frame = g_frame.load();
+    g_candidate.set = true;
+}
+
+// A load the read hook saw, once a frame has passed without the reads going on past the data.
+static void TakeLoad() {
+    std::lock_guard<std::mutex> lock(g_candidateLock);
+    if (!g_candidate.set || g_frame.load() <= g_candidate.frame + 1) return;
+    g_candidate.set = false;
+    g_loadedInMemory.store(false);
+    g_loadedIndex.store(g_candidate.index);
+    g_needed.store(NeededCount(g_candidate.index, g_candidate.ours, g_candidate.tail.yearOffset));
+    g_tail = std::move(g_candidate.tail);  // empty for a save without our tail
+    std::fprintf(stderr, "[season] season %d loaded; %s, year offset %u, %zu archived seasons\n", g_candidate.index + 1,
+                 g_candidate.ours ? "our tail" : "no tail", g_tail.yearOffset, g_tail.archive.size());
+    g_pendingFrames = 0;
+    g_pendingIndex.store(g_candidate.index);
+}
+
+void OnSeasonSaveWrite(uint32_t fileOffset, uint8_t* data, size_t length) {
+    // Only a game past season 10 has stored years; anything else stays byte for byte.
+    if (Count() <= kOriginalSeasons || (CurrentIndex() < kOriginalSeasons && g_tail.yearOffset == 0)) return;
+    OverlayTail(g_tail, fileOffset, data, length);
+    if (fileOffset + length >= kSaveFileSize && fileOffset < kSaveFileSize)
+        std::fprintf(stderr, "[season] tail written: year offset %u\n", g_tail.yearOffset);
+}
