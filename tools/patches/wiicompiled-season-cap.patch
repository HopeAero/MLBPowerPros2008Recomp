diff --git a/runtime/include/season_cap.h b/runtime/include/season_cap.h
new file mode 100644
index 0000000..1378e48
--- /dev/null
+++ b/runtime/include/season_cap.h
@@ -0,0 +1,228 @@
+#pragma once
+// Season mode past 10 seasons (launcher option GAME > SEASONS, [season] max_seasons = 10 | 20 | 0).
+//
+// The original stops after 10 seasons (2008-2017). Almost every per-year table already has room for
+// 20; the cap is the virtual 0x80C06534 (returns 10) and five fixed compares, which the translator
+// routes to WiicompiledImmediate (config/wiicompiled/rl8e54.yml, translation.immediate_overrides).
+// Two tables keep 10 years only, the finances and the team records: years 10..19 live here, and
+// travel in the free tail of the season save file (the save data is 0x119910 bytes, the file is
+// padded with zeros to 0x120000).
+// With no limit (0) the game keeps a window of 20 years: when season 20 ends, every per-year table
+// moves down one year, the oldest goes to the archive in the tail, and a year offset (also in the
+// tail) turns the window's years into the real ones (0x80B4A888, 0x80B74C00 and the year sites).
+// Docs: docs/ingenieria-inversa.md "Año de la temporada".
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace season_cap {
+
+constexpr int kOriginalSeasons = 10;
+constexpr int kMaxSeasons = 20;          // the option "20", and the years the game's tables hold
+constexpr int kUnlimitedSeasons = 100;   // the count with no limit: never reached, the index stays below 20
+constexpr int kStoredYears = kMaxSeasons - kOriginalSeasons;  // years 10..19, kept by us
+constexpr uint32_t kSaveDataSize = 0x119910;  // what the game writes and reads back
+constexpr uint32_t kSaveFileSize = 0x120000;  // pm3usse<slot>.dat
+constexpr size_t kTailSize = kSaveFileSize - kSaveDataSize;
+constexpr int kFinanceItems = 11;   // 10 items and the balance, per year
+constexpr int kRecordsPerYear = 8;  // [0x8104B59C] + 60 + year * 128 + k * 16
+constexpr size_t kAnnualBytes = 44, kYearlyBytes = 4, kRecordBytes = 16 * kRecordsPerYear;
+
+// [season] max_seasons: 10, 20, or 0 for no limit.
+inline int ConfiguredCount(uint32_t setting) {
+    return setting == 0 ? kUnlimitedSeasons : setting == 20 ? kMaxSeasons : kOriginalSeasons;
+}
+// What a loaded save needs: no limit once it is past 2027 (a year offset), 20 once it went past
+// season 10 (our tail, or an index only 20 reaches). Index 10 alone is the original's own end state.
+inline int NeededCount(int loadedIndex, bool hasTail, uint32_t yearOffset) {
+    if (yearOffset > 0) return kUnlimitedSeasons;
+    return hasTail || loadedIndex > kOriginalSeasons ? kMaxSeasons : kOriginalSeasons;
+}
+// Seasons for this game, fixed when it starts or loads (never from the live index, which passes 10
+// on its way into the original ending).
+inline int CountFor(int configured, int needed) { return configured > needed ? configured : needed; }
+
+// The finished flag (bit 0x20 of [[0x8104B5A8] + 0x104]): set when the mode's ending plays, and a
+// finished save replays the ending on load. The natural end comes on 11/01 of the last season
+// (index count - 1), the forced one after the rollover (index count).
+inline bool Finished(bool flag, int index, int count) { return flag && index >= count - 1; }
+// With more seasons, an ending from an earlier cap no longer counts.
+inline bool ClearStaleFinished(bool flag, int index, int count) {
+    return count > kOriginalSeasons && flag && !Finished(flag, index, count);
+}
+
+// Where a year (season index) of the finances or the records lives: the game's 10 rows, ours for
+// years 10..19, or nowhere (no season, or past the window). With 10 seasons everything goes to the
+// original address, as the original game does, even past its table.
+enum class YearWhere { Game, Store, Nowhere };
+inline YearWhere YearSlot(int year, int count) {
+    if (count <= kOriginalSeasons) return YearWhere::Game;
+    if (year < 0 || year >= kMaxSeasons) return YearWhere::Nowhere;
+    return year < kOriginalSeasons ? YearWhere::Game : YearWhere::Store;
+}
+inline bool ItemInRange(int item) { return item >= 0 && item < kFinanceItems; }
+inline bool RecordInRange(int k) { return k >= 0 && k < kRecordsPerYear; }
+
+// Offsets in pm3usse<slot>.dat: the season index and the flags byte holding the finished bit.
+constexpr uint32_t kFileIndexOffset = 0x47E8C;  // [state + 8]
+constexpr uint32_t kFileFlagsOffset = 0x47F88;  // [state + 0x104]
+inline int FileIndex(const uint8_t* file) { return static_cast<int8_t>(file[kFileIndexOffset]); }
+inline bool FileFinishedFlag(const uint8_t* file) { return (file[kFileFlagsOffset] & 0x20) != 0; }
+
+// The cap compares, by instruction address: 9 means "last season", 10 "number of seasons".
+inline bool IsCapCompare(uint32_t address) {
+    switch (address) {
+    case 0x80BB4A6Cu:  // index == 9: message 141
+    case 0x80BF2530u:  // index < 9: calls 0x80BF619C
+    case 0x80BF51BCu:  // off-season events, index < 9
+    case 0x80BF52D0u:  // off-season events, index < 9
+    case 0x80C0CC0Cu:  // index < 10
+        return true;
+    default:
+        return false;
+    }
+}
+
+// The year sites (tools/season_cap_sites.py --years): 2007/2008 + index, and the calendar's clamp of
+// the 2-digit year (index + 8) to 28 before its day-of-week formula. Both move with the year offset.
+inline bool IsYearSite(uint32_t address) {
+    switch (address) {
+    case 0x80B4A7A0u: case 0x80B4A7ACu: case 0x80B4A7B0u: case 0x80B4A7B4u:  // 0x80B4A730
+    case 0x8087B808u: case 0x8087E3B8u: case 0x80ADC658u:
+    case 0x80B4AF20u: case 0x80B4AF24u: case 0x80B4B148u: case 0x80B4B14Cu: case 0x80B4B30Cu:
+    case 0x80B4B310u: case 0x80B4B644u: case 0x80B4B648u: case 0x80B4B7E8u: case 0x80B4B7ECu:
+    case 0x80B4BF60u: case 0x80B4BF64u: case 0x80B4C0F8u: case 0x80B4C0FCu: case 0x80B4C8C0u:
+    case 0x80B4C8C4u: case 0x80B4CA44u: case 0x80B4CA48u: case 0x80B4CBC8u: case 0x80B4CBCCu:
+        return true;
+    default:
+        return false;
+    }
+}
+
+inline int32_t ImmediateFor(uint32_t address, int32_t original, int count, uint32_t yearOffset) {
+    if (IsCapCompare(address)) return original - kOriginalSeasons + count;
+    if (IsYearSite(address)) return original + static_cast<int32_t>(yearOffset);
+    return original;
+}
+
+// Years 10..19 (row = year - 10), as the game's big-endian bytes: the yearly finance summary
+// (Q + 44 + year * 44 in the game), the yearly value (Q + 4 + year * 4) and the team records.
+struct YearStore {
+    uint8_t annual[kStoredYears][kAnnualBytes] = {};
+    uint8_t yearly[kStoredYears][kYearlyBytes] = {};
+    uint8_t records[kStoredYears][kRecordBytes] = {};
+};
+
+// Drops every stored year after `index` (a season index, 0..19): what the game does not have yet.
+inline void ClearAfter(YearStore& store, int index) {
+    for (int year = kOriginalSeasons; year < kMaxSeasons; ++year) {
+        if (year <= index) continue;
+        const int row = year - kOriginalSeasons;
+        std::memset(store.annual[row], 0, kAnnualBytes);
+        std::memset(store.yearly[row], 0, kYearlyBytes);
+        std::memset(store.records[row], 0, kRecordBytes);
+    }
+}
+
+// A season that left the window: its real year (u16, big-endian), then its rows of the qualifiers,
+// series, standings, team-per-year, yearly finance summary, yearly value and records.
+constexpr size_t kArchiveYearBytes = 2 + 32 + 160 + 336 + 2 + kAnnualBytes + kYearlyBytes + kRecordBytes;
+using ArchivedYear = std::array<uint8_t, kArchiveYearBytes>;
+
+struct SeasonTail {
+    uint32_t yearOffset = 0;  // seasons that left the window: the real year is 2008 + offset + index
+    YearStore store;
+    std::vector<ArchivedYear> archive;  // oldest first
+};
+
+// Tail layout: "PPSEASON", u32 version 2, u32 year offset, the store, u32 archive count, the archive
+// (all big-endian); the rest of the tail stays zero.
+constexpr char kTailMagic[8] = {'P', 'P', 'S', 'E', 'A', 'S', 'O', 'N'};
+constexpr uint32_t kTailVersion = 2;
+constexpr size_t kTailHeader = 8 + 4 + 4 + sizeof(YearStore) + 4;
+constexpr size_t kArchiveCapacity = (kTailSize - kTailHeader) / kArchiveYearBytes;
+
+// Keeps the newest kArchiveCapacity seasons.
+inline void AddArchived(SeasonTail& tail, const ArchivedYear& year) {
+    if (tail.archive.size() >= kArchiveCapacity) tail.archive.erase(tail.archive.begin());
+    tail.archive.push_back(year);
+}
+
+inline void PutBe32(uint8_t* p, uint32_t v) {
+    p[0] = static_cast<uint8_t>(v >> 24); p[1] = static_cast<uint8_t>(v >> 16);
+    p[2] = static_cast<uint8_t>(v >> 8);  p[3] = static_cast<uint8_t>(v);
+}
+inline uint32_t GetBe32(const uint8_t* p) {
+    return (uint32_t{p[0]} << 24) | (uint32_t{p[1]} << 16) | (uint32_t{p[2]} << 8) | p[3];
+}
+
+// tail: kTailSize bytes.
+inline void WriteTail(const SeasonTail& tail, uint8_t* out) {
+    std::memset(out, 0, kTailSize);
+    std::memcpy(out, kTailMagic, 8);
+    PutBe32(out + 8, kTailVersion);
+    PutBe32(out + 12, tail.yearOffset);
+    std::memcpy(out + 16, &tail.store, sizeof(YearStore));
+    const size_t count = tail.archive.size() < kArchiveCapacity ? tail.archive.size() : kArchiveCapacity;
+    PutBe32(out + 16 + sizeof(YearStore), static_cast<uint32_t>(count));
+    for (size_t i = 0; i < count; ++i)
+        std::memcpy(out + kTailHeader + i * kArchiveYearBytes, tail.archive[tail.archive.size() - count + i].data(),
+                    kArchiveYearBytes);
+}
+
+// False (and nothing stored) when the tail is not ours, e.g. the game's own zero padding.
+inline bool ReadTail(const uint8_t* in, size_t size, SeasonTail& tail) {
+    tail = {};
+    if (size < kTailSize || std::memcmp(in, kTailMagic, 8) != 0 || GetBe32(in + 8) != kTailVersion) return false;
+    tail.yearOffset = GetBe32(in + 12);
+    std::memcpy(&tail.store, in + 16, sizeof(YearStore));
+    const uint32_t count = GetBe32(in + 16 + sizeof(YearStore));
+    for (uint32_t i = 0; i < count && i < kArchiveCapacity; ++i) {
+        ArchivedYear year;
+        std::memcpy(year.data(), in + kTailHeader + i * kArchiveYearBytes, kArchiveYearBytes);
+        tail.archive.push_back(year);
+    }
+    return true;
+}
+
+// The game writes and reads the save in chunks. OverlayTail puts our tail into whatever part of
+// [kSaveDataSize, kSaveFileSize) a write chunk covers.
+inline void OverlayTail(const SeasonTail& tail, uint32_t fileOffset, uint8_t* data, size_t length) {
+    const uint32_t from = fileOffset > kSaveDataSize ? fileOffset : kSaveDataSize;
+    const uint32_t to = fileOffset + length < kSaveFileSize ? fileOffset + static_cast<uint32_t>(length) : kSaveFileSize;
+    if (from >= to) return;
+    static uint8_t bytes[kTailSize];
+    WriteTail(tail, bytes);
+    std::memcpy(data + (from - fileOffset), bytes + (from - kSaveDataSize), to - from);
+}
+
+// Moves a table of `count` rows down one row: row 0 leaves (returned), the last row gets `fill`,
+// or the row that left when fill is null.
+inline std::vector<uint8_t> ShiftRows(uint8_t* rows, size_t rowBytes, size_t count, const uint8_t* fill) {
+    std::vector<uint8_t> dropped(rows, rows + rowBytes);
+    std::memmove(rows, rows + rowBytes, rowBytes * (count - 1));
+    std::memcpy(rows + rowBytes * (count - 1), fill ? fill : dropped.data(), rowBytes);
+    return dropped;
+}
+
+// pm3usse0.dat .. pm3usse2.dat, the three Season mode slots.
+inline bool IsSeasonSaveName(const char* fileName) {
+    return fileName && std::strncmp(fileName, "pm3usse", 7) == 0 && fileName[7] >= '0' && fileName[7] <= '2' &&
+           std::strcmp(fileName + 8, ".dat") == 0;
+}
+
+// Runtime side (hle/mlb/season_cap.cpp).
+int SeasonCount();         // this game's number of seasons
+int Count();               // the same, 10 outside Season mode (for code MLB Life shares)
+uint32_t YearOffset();     // seasons that left the window (0 outside Season mode)
+void OnHostFrame();        // settings_overlay.cpp, once per presented frame
+// nand_isfs.cpp hooks for the season saves (IsSeasonSaveName): a read of `length` bytes at
+// fileOffset landed in data, and `tail` (kTailSize bytes, from the file) comes with the chunk that
+// reaches the end of the game's data; a write of length bytes at fileOffset is about to go out from
+// data (a copy the hook may change).
+void OnSeasonSaveRead(uint32_t fileOffset, const uint8_t* data, size_t length, const uint8_t* tail);
+void OnSeasonSaveWrite(uint32_t fileOffset, uint8_t* data, size_t length);
+
+}  // namespace season_cap
diff --git a/runtime/src/hle/mlb/season_cap.cpp b/runtime/src/hle/mlb/season_cap.cpp
new file mode 100644
index 0000000..a2b3a65
--- /dev/null
+++ b/runtime/src/hle/mlb/season_cap.cpp
@@ -0,0 +1,514 @@
+// Season mode past 10 seasons: the cap, years 10..19 of the 10-year tables, and the moving window
+// with no limit (season_cap.h).
+#include "season_cap.h"
+
+#include <atomic>
+#include <cstdio>
+#include <mutex>
+#include <utility>
+
+#include "abi_bridge.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+
+namespace season_cap {
+
+namespace {
+
+SeasonTail g_tail;
+// What the loaded save needs (NeededCount); a new game sets it back to 10.
+std::atomic<int> g_needed{kOriginalSeasons};
+// The index of the last loaded save, and whether it has reached memory yet (so the previous game's
+// index, still in memory while the load runs, is not taken for a new game).
+std::atomic<int> g_loadedIndex{-1};
+std::atomic<bool> g_loadedInMemory{false};
+// After a season save is read: the loaded index whose state has to be fixed once the save is in
+// memory (-1: nothing to do), and how many frames to wait for it.
+std::atomic<int> g_pendingIndex{-1};
+int g_pendingFrames = 0;
+// A load seen by the read hook, taken on a later frame unless the reads went past the game's data
+// (saving reads the slot's old file whole, then reads back what it wrote: those are not loads).
+struct LoadCandidate {
+    bool set = false;
+    int index = -1;
+    bool ours = false;
+    SeasonTail tail;
+    int frame = 0;
+};
+std::mutex g_candidateLock;
+LoadCandidate g_candidate;
+std::atomic<int> g_frame{0};
+
+// Season mode and MLB Life both point [0x8104B5A8] and [0x8104B59C] at their own blocks; the first
+// player id ([0x8104B608], u16) tells them apart: 7001 in Season mode (0x80C48344), 9001 in MLB Life.
+bool SeasonModeActive() { return Memory::Read16(0x8104B608u) == 7001; }
+
+// [0x8104B5A8], or 0 when there is no state.
+uint32_t State() {
+    const uint32_t state = Memory::Read32(0x8104B5A8u);
+    return state && Memory::Contains(state, 0x108) ? state : 0;
+}
+// [state + 8]: the season index, or -1 when there is no state.
+int CurrentIndex() {
+    const uint32_t state = State();
+    return state ? static_cast<int8_t>(Memory::Read8(state + 8)) : -1;
+}
+
+// The raw finished flag: bit 0x20 of [state + 0x104].
+bool FinishedFlag() {
+    const uint32_t state = State();
+    return state && (Memory::Read8(state + 0x104) & 0x20) != 0;
+}
+
+// Calls a game function from a native; the caller's lr is kept, as the original's prologue does.
+uint32_t Call(CpuContext* ctx, uint32_t target, void (*invoke)(CpuContext*)) {
+    const uint32_t lr = ctx->lr;
+    ctx->lr = target;
+    invoke(ctx);
+    ctx->lr = lr;
+    return ctx->gpr[3];
+}
+
+// The game's own helpers: finance block Q, current balance, month of today (1..12).
+uint32_t FinanceBase(CpuContext* ctx) { return Call(ctx, 0x80C0D460u, InvokeDirectCpu<0x80C0D460u>); }
+uint32_t Balance(CpuContext* ctx) { return Call(ctx, 0x80C0D5ACu, InvokeDirectCpu<0x80C0D5ACu>); }
+int Month(CpuContext* ctx) {
+    ctx->gpr[3] = Memory::Read32(0x8104BA10u);
+    return static_cast<int>(Call(ctx, 0x80B4AA38u, InvokeDirectCpu<0x80B4AA38u>));
+}
+
+uint32_t AnnualAddress(uint32_t q, int year, int item) {
+    return q + 44 + static_cast<uint32_t>(year) * 44 + static_cast<uint32_t>(item) * 4;
+}
+uint32_t MonthlyAddress(uint32_t q, int month, int item) {
+    return q + 484 + static_cast<uint32_t>(month - 1) * 44 + static_cast<uint32_t>(item) * 4;
+}
+// [0x8104B59C] + 60 + year * 128 + k * 16, as 0x80C41BA8 computes it.
+uint32_t RecordAddress(int year, int k) {
+    return Memory::Read32(0x8104B59Cu) + 60 + static_cast<uint32_t>(year) * 128 + static_cast<uint32_t>(k) * 16;
+}
+
+// Yearly summary of a year, item 0..10, wherever YearSlot puts it.
+uint32_t ReadAnnual(uint32_t q, int year, int item, int count) {
+    switch (YearSlot(year, count)) {
+    case YearWhere::Game: return Memory::Read32(AnnualAddress(q, year, item));
+    case YearWhere::Store:
+        return ItemInRange(item) ? GetBe32(&g_tail.store.annual[year - kOriginalSeasons][item * 4]) : 0;
+    default: return 0;
+    }
+}
+void WriteAnnual(uint32_t q, int year, int item, uint32_t value, int count) {
+    switch (YearSlot(year, count)) {
+    case YearWhere::Game: Memory::Write32(AnnualAddress(q, year, item), value); break;
+    case YearWhere::Store:
+        if (ItemInRange(item)) PutBe32(&g_tail.store.annual[year - kOriginalSeasons][item * 4], value);
+        break;
+    default: break;  // no season or past every table: dropped
+    }
+}
+
+// Word `offset` (0, 4, 8, 12) of record k of a year, wherever YearSlot puts it.
+uint32_t RecordWord(int year, int k, int offset) {
+    switch (YearSlot(year, Count())) {
+    case YearWhere::Game: return Memory::Read32(RecordAddress(year, k) + static_cast<uint32_t>(offset));
+    case YearWhere::Store:
+        return RecordInRange(k) ? GetBe32(&g_tail.store.records[year - kOriginalSeasons][k * 16 + offset]) : 0;
+    default: return 0;
+    }
+}
+
+// The window moves one year (no limit, after season 20): every per-year table loses its year 0 to
+// the archive and gets an empty year 19. Years 10..19 of the finances and records are in our store.
+void ShiftWindow() {
+    const uint32_t p = Memory::Read32(0x8104B5ACu), x = Memory::Read32(0x8104B5A0u);
+    const uint32_t b = Memory::Read32(0x8104B59Cu), q = b + 1344;
+    const uint32_t year = 2008 + g_tail.yearOffset;
+    ArchivedYear archived{};
+    archived[0] = static_cast<uint8_t>(year >> 8);
+    archived[1] = static_cast<uint8_t>(year);
+    uint8_t* out = archived.data() + 2;
+    // A table that is all in guest memory: rows of rowBytes at base; fill null rotates.
+    auto guest = [&](uint32_t base, size_t rowBytes, const uint8_t* fill) {
+        if (uint8_t* host = Memory::GetPointer(base, rowBytes * kMaxSeasons)) {
+            const std::vector<uint8_t> left = ShiftRows(host, rowBytes, kMaxSeasons, fill);
+            std::memcpy(out, left.data(), rowBytes);
+        }
+        out += rowBytes;
+    };
+    // A table with years 0..9 in guest memory and 10..19 in the store.
+    auto split = [&](uint32_t base, size_t rowBytes, uint8_t* store) {
+        if (uint8_t* host = Memory::GetPointer(base, rowBytes * kOriginalSeasons)) {
+            std::vector<uint8_t> rows(rowBytes * kMaxSeasons);
+            std::memcpy(rows.data(), host, rowBytes * kOriginalSeasons);
+            std::memcpy(rows.data() + rowBytes * kOriginalSeasons, store, rowBytes * kStoredYears);
+            const std::vector<uint8_t> zero(rowBytes, 0);
+            const std::vector<uint8_t> left = ShiftRows(rows.data(), rowBytes, kMaxSeasons, zero.data());
+            std::memcpy(host, rows.data(), rowBytes * kOriginalSeasons);
+            std::memcpy(store, rows.data() + rowBytes * kOriginalSeasons, rowBytes * kStoredYears);
+            std::memcpy(out, left.data(), rowBytes);
+        }
+        out += rowBytes;
+    };
+    // Postseason qualifiers (44: no team) and series (no teams, no wins, 0x28 as a new game has).
+    uint8_t qualifiers[32], series[160];
+    for (int i = 0; i < 8; ++i) PutBe32(qualifiers + i * 4, 44);
+    for (int s = 0; s < 8; ++s) {
+        const uint32_t entry[5] = {8, 8, 44, 44, 0x28};
+        for (int w = 0; w < 5; ++w) PutBe32(series + s * 20 + w * 4, entry[w]);
+    }
+    guest(p, 32, qualifiers);
+    guest(p + 648, 160, series);
+    // Standings: 21 rows; row 20 is never played and becomes the new year 19 (it stays as it was).
+    uint8_t blank[336] = {};
+    if (const uint8_t* row20 = Memory::GetPointer(x + 0x11CD0 + 20 * 336, 336)) std::memcpy(blank, row20, 336);
+    guest(x + 0x11CD0, 336, blank);
+    guest(x + 0x159A0, 2, nullptr);  // the team drawn for each year: rotated
+    split(q + 44, kAnnualBytes, &g_tail.store.annual[0][0]);
+    split(q + 4, kYearlyBytes, &g_tail.store.yearly[0][0]);
+    split(b + 60, kRecordBytes, &g_tail.store.records[0][0]);
+    AddArchived(g_tail, archived);
+    ++g_tail.yearOffset;
+    std::fprintf(stderr, "[season] %u archived; the window is now %u-%u\n", year, 2008 + g_tail.yearOffset,
+                 2008 + g_tail.yearOffset + kMaxSeasons - 1);
+}
