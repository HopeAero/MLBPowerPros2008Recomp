diff --git a/runtime/tests/season_cap_tests.cpp b/runtime/tests/season_cap_tests.cpp
new file mode 100644
index 0000000..0470e49
--- /dev/null
+++ b/runtime/tests/season_cap_tests.cpp
@@ -0,0 +1,135 @@
+#include "season_cap.h"
+#include <algorithm>
+#include <cstdio>
+#include <vector>
+
+static int failures = 0;
+static void Check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+int main() {
+    using namespace season_cap;
+    // The launcher setting: 10, 20 or 0 (no limit).
+    Check(ConfiguredCount(10) == 10 && ConfiguredCount(20) == 20, "10 and 20");
+    Check(ConfiguredCount(0) == kUnlimitedSeasons, "0 is no limit");
+    Check(ConfiguredCount(15) == 10, "anything else is the original 10");
+    // What the loaded save needs: its year offset, our tail or an index only 20 seasons reach.
+    Check(NeededCount(19, true, 3) == kUnlimitedSeasons, "a save past 2027 needs no limit");
+    Check(NeededCount(11, false, 0) == 20, "a save at season 12 can only come from 20");
+    Check(NeededCount(10, true, 0) == 20, "our tail marks a save played past season 10");
+    Check(NeededCount(10, false, 0) == 10, "index 10 without our tail: the original's own end state");
+    Check(NeededCount(3, false, 0) == 10, "an early save");
+    // The count is fixed per game: the option, or more if the loaded save needs it.
+    Check(CountFor(10, 10) == 10 && CountFor(20, 10) == 20, "the option");
+    Check(CountFor(10, 20) == 20, "option 10 but the save went past season 10");
+    Check(CountFor(20, kUnlimitedSeasons) == kUnlimitedSeasons, "option 20 but the save is past 2027");
+    Check(CountFor(kUnlimitedSeasons, 10) == kUnlimitedSeasons, "no limit");
+
+    // The ending flag: the natural end is on 11/01 of the last season (index count - 1).
+    Check(Finished(true, 9, 10) && Finished(true, 10, 10), "original: finished in and after season 10");
+    Check(!Finished(true, 9, 20) && Finished(true, 19, 20), "20 seasons: only the season-20 ending");
+    Check(!Finished(false, 19, 20), "no flag");
+    Check(!Finished(true, 19, kUnlimitedSeasons), "no limit: never finished");
+    Check(ClearStaleFinished(true, 9, 20) && ClearStaleFinished(true, 10, 20), "20 seasons: an earlier ending is cleared");
+    Check(!ClearStaleFinished(true, 9, 10) && !ClearStaleFinished(true, 10, 10), "10 seasons: never cleared");
+    Check(!ClearStaleFinished(true, 19, 20), "the season-20 ending stays with 20");
+    Check(ClearStaleFinished(true, 19, kUnlimitedSeasons), "no limit: a game finished after 20 seasons goes on");
+
+    // Immediates: the cap compares follow the count, the year sites the year offset.
+    Check(ImmediateFor(0x80BB4A6Cu, 9, 20, 0) == 19, "last-season compare follows the cap");
+    Check(ImmediateFor(0x80C0CC0Cu, 10, 20, 0) == 20, "season-count compare follows the cap");
+    Check(ImmediateFor(0x80BB4A6Cu, 9, 10, 0) == 9, "cap 10 keeps the original");
+    Check(ImmediateFor(0x80BB4A6Cu, 9, kUnlimitedSeasons, 0) == kUnlimitedSeasons - 1, "no limit: no last season");
+    Check(ImmediateFor(0x80B4A7ACu, 2008, kUnlimitedSeasons, 5) == 2013, "2008 + index moves with the year offset");
+    Check(ImmediateFor(0x80B4A7A0u, 2007, kUnlimitedSeasons, 5) == 2012, "2007 + index too");
+    Check(ImmediateFor(0x80B4AF20u, 28, kUnlimitedSeasons, 5) == 33, "the calendar clamp moves with the year");
+    Check(ImmediateFor(0x80B4AF24u, 28, kUnlimitedSeasons, 0) == 28, "no offset: the original clamp");
+    Check(ImmediateFor(0x80001000u, 9, 20, 5) == 9, "an address not in the lists keeps its immediate");
+
+    // Where a year's finances and records live: the game's 10 rows, our 10, or nowhere.
+    Check(YearSlot(9, 20) == YearWhere::Game, "year 9: the game's table");
+    Check(YearSlot(10, 20) == YearWhere::Store && YearSlot(19, kUnlimitedSeasons) == YearWhere::Store, "years 10..19: ours");
+    Check(YearSlot(20, kUnlimitedSeasons) == YearWhere::Nowhere, "year 20: past the window, dropped");
+    Check(YearSlot(10, 10) == YearWhere::Game, "10 seasons: always the original address, even past the table");
+    Check(YearSlot(-1, 20) == YearWhere::Nowhere, "no season");
+    Check(ItemInRange(0) && ItemInRange(10) && !ItemInRange(11) && !ItemInRange(-1), "finance items 0..10");
+    Check(RecordInRange(0) && RecordInRange(7) && !RecordInRange(8) && !RecordInRange(-1), "records 0..7 per year");
+
+    SeasonTail tail;
+    tail.yearOffset = 7;
+    tail.store.annual[0][43] = 0x39;
+    tail.store.records[9][127] = 0xAB;
+    tail.store.yearly[4][0] = 0x80;
+    ArchivedYear first{}, second{};
+    first[0] = 0x07; first[1] = 0xD8;  // 2008
+    second[0] = 0x07; second[1] = 0xD9;
+    AddArchived(tail, first);
+    AddArchived(tail, second);
+    std::vector<uint8_t> file(kSaveFileSize, 0);
+    WriteTail(tail, file.data() + kSaveDataSize);
+    SeasonTail back;
+    Check(ReadTail(file.data() + kSaveDataSize, kTailSize, back), "tail written by us reads back");
+    Check(back.yearOffset == 7 && back.store.annual[0][43] == 0x39 && back.store.records[9][127] == 0xAB &&
+              back.store.yearly[4][0] == 0x80, "offset and stored years survive");
+    Check(back.archive.size() == 2 && back.archive[0][1] == 0xD8 && back.archive[1][1] == 0xD9, "archive, oldest first");
+    std::vector<uint8_t> zeros(kTailSize, 0);
+    Check(!ReadTail(zeros.data(), zeros.size(), back) && back.yearOffset == 0 && back.archive.empty(),
+          "the game's zero tail: nothing stored");
+
+    SeasonTail full;
+    for (size_t i = 0; i < kArchiveCapacity + 1; ++i) {
+        ArchivedYear year{};
+        year[1] = static_cast<uint8_t>(i);
+        AddArchived(full, year);
+    }
+    Check(kArchiveCapacity >= 30, "room for at least 30 archived seasons");
+    Check(full.archive.size() == kArchiveCapacity && full.archive[0][1] == 1, "a full archive drops its oldest year");
+    std::vector<uint8_t> fullTail(kTailSize, 0);
+    WriteTail(full, fullTail.data());
+    Check(ReadTail(fullTail.data(), kTailSize, back) && back.archive.size() == kArchiveCapacity, "a full archive fits");
+
+    YearStore keep = tail.store;
+    ClearAfter(keep, 13);
+    Check(keep.annual[0][43] == 0x39 && keep.yearly[4][0] == 0 && keep.records[9][127] == 0,
+          "clearing after year 13 keeps 10..13 and drops 14..19");
+    ClearAfter(keep, 0);
+    Check(keep.annual[0][43] == 0, "a season at year 0 (new game) drops every stored year");
+
+    for (uint32_t chunk : {0x4000u, 0x1000u, 0x120000u, 0x777u}) {
+        std::vector<uint8_t> out(kSaveFileSize, 0);
+        for (uint32_t at = 0; at < kSaveFileSize; at += chunk) {
+            const uint32_t n = std::min(chunk, kSaveFileSize - at);
+            OverlayTail(tail, at, out.data() + at, n);
+        }
+        SeasonTail got;
+        Check(ReadTail(out.data() + kSaveDataSize, kTailSize, got) && got.yearOffset == 7 && got.archive.size() == 2 &&
+                  got.store.records[9][127] == 0xAB,
+              "a chunked write keeps the tail");
+        Check(std::all_of(out.begin(), out.begin() + kSaveDataSize, [](uint8_t b) { return b == 0; }),
+              "the overlay never touches the game's data");
+    }
+
+    // The window moves one year: row 0 leaves, the rest move down, the last row gets the fill (or row 0 again).
+    std::vector<uint8_t> rows = {1, 1, 2, 2, 3, 3};
+    const uint8_t fill[2] = {9, 9};
+    std::vector<uint8_t> dropped = ShiftRows(rows.data(), 2, 3, fill);
+    Check(dropped == std::vector<uint8_t>{1, 1} && rows == std::vector<uint8_t>({2, 2, 3, 3, 9, 9}), "shift with a fill");
+    dropped = ShiftRows(rows.data(), 2, 3, nullptr);
+    Check(dropped == std::vector<uint8_t>{2, 2} && rows == std::vector<uint8_t>({3, 3, 9, 9, 2, 2}), "shift as a rotation");
+
+    // The loaded file says which season and whether it ended (offsets in the file).
+    std::vector<uint8_t> save(kSaveFileSize, 0);
+    save[kFileIndexOffset] = 11;
+    save[kFileFlagsOffset] = 0x23;
+    Check(FileIndex(save.data()) == 11 && FileFinishedFlag(save.data()), "index and ending flag from the file");
+
+    Check(IsSeasonSaveName("pm3usse0.dat") && IsSeasonSaveName("pm3usse2.dat"), "season slots");
+    Check(!IsSeasonSaveName("pm3usma.dat") && !IsSeasonSaveName("pm3usse3.dat") && !IsSeasonSaveName("pm3usse0.dat.tmp"),
+          "main data, a fourth slot and a scratch file are not season saves");
+    if (failures == 0) std::puts("season_cap_tests: OK");
+    return failures != 0;
+}
