+extern "C" void MLB_FinanceYearlyGet_80C0D85C(CpuContext* ctx) {
+    const int year = static_cast<int32_t>(ctx->gpr[3]);
+    const uint32_t q = FinanceBase(ctx);
+    switch (FinanceSlot(year, Count())) {
+    case FinanceWhere::Game: ctx->gpr[3] = Memory::Read32(q + 4 + static_cast<uint32_t>(year) * 4); break;
+    case FinanceWhere::Store: ctx->gpr[3] = static_cast<uint32_t>(g_store.yearly[year - kOriginalSeasons]); break;
+    default: ctx->gpr[3] = 0; break;
