diff --git a/runtime/include/season_pack.h b/runtime/include/season_pack.h
new file mode 100644
index 0000000..0d18e04
--- /dev/null
+++ b/runtime/include/season_pack.h
@@ -0,0 +1,219 @@
+#pragma once
+
+// What a new Season mode game or MLB Life career will use, from the enabled mods and the MEJORAS
+// options, by the runtime's own rules (season_schedule.cpp, season_cap.cpp): the first enabled mod by
+// name with start_year gives the year (and its roster_year the ages), each year's schedule comes from
+// the first enabled mod by name with schedule/<year>.csv, the DH is on with the option or any mod's
+// first mod with dh = "both" or "original" decides the DH, the first with [divisions] or
+// leagues = "original" the divisions; else the MEJORAS options. The launcher
+// shows it (TEMPORADA) and edits a mod's mod.toml with the helpers below.
+
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+namespace season_pack {
+
+struct Plan {
+    int startYear = 2008;
+    std::string startFrom;  // the mod that gives it ("": the game's 2008)
+    int rosterYear = 2008;  // the season the ages are for
+    std::map<int, std::string> schedules;  // year -> the mod whose schedule/<year>.csv is used
+    bool dh = false;
+    std::string dhFrom;  // the mod with dh = "both" / "original" that decides, or "" for the MEJORAS option
+    bool modernLeagues = false;  // divisions other than 2008's
+    std::string leaguesFrom;     // the mod with [divisions] / leagues = "original" that decides, or "" for the option
+    bool leaguesHouOnly = true;  // the mod's [divisions] is only Houston to the AL West (15/15)
+    // Settings a mod loses to another (by name): "start_year 2026 of X" when Y gives 2025, etc.
+    struct Conflict {
+        std::string what;    // "start_year", "schedule", "divisions"
+        std::string loser;   // mod not used
+        std::string winner;  // mod used
+        int year = 0;        // start_year / schedule year
+    };
+    std::vector<Conflict> conflicts;
+};
+
+// The years of the schedule/<year>.csv files in a mod.
+inline std::vector<int> ScheduleYears(const std::filesystem::path& root) {
+    std::vector<int> years;
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator(root / "schedule", ec)) {
+        const auto name = entry.path().filename().string();
+        if (name.size() == 8 && name.substr(4) == ".csv") {
+            const int year = std::atoi(name.substr(0, 4).c_str());
+            if (year >= 2000 && year <= 2099) years.push_back(year);
+        }
+    }
+    return years;
+}
+
+// Whether a mod's [divisions] is just Houston to the AL West (what the 15/15 option does). Mod is
+// mods::Mod (a template so the tests need no runtime).
+template <typename Mod>
+bool HouOnly(const Mod& mod) {
+    for (int d = 0; d < 6; ++d) {
+        const bool hou = d == 2 && mod.divisions[d].size() == 1 && (mod.divisions[d][0] == "HOU" || mod.divisions[d][0] == "hou");
+        if (!mod.divisions[d].empty() && !hou) return false;
+    }
+    return !mod.divisions[2].empty();
+}
+
+// `mods` in mods::Discover() order (by name); `scheduleYears` gives each mod's schedule files.
+template <typename Mod, typename Years>
+Plan Make(const std::vector<Mod>& mods, bool dhOption, bool leaguesOption, Years scheduleYears) {
+    Plan plan;
+    plan.dh = dhOption;
+    plan.modernLeagues = leaguesOption;
+    const Mod* start = nullptr;
+    const Mod* divisions = nullptr;
+    const Mod* dh = nullptr;
+    for (const Mod& mod : mods) {
+        if (!mod.enabled) continue;
+        if (mod.startYear) {
+            if (!start) start = &mod;
+            else if (mod.startYear != start->startYear)
+                plan.conflicts.push_back({"start_year", mod.name, start->name, mod.startYear});
+        }
+        for (int year : scheduleYears(mod)) {
+            const auto [at, added] = plan.schedules.emplace(year, mod.name);
+            if (!added) plan.conflicts.push_back({"schedule", mod.name, at->second, year});
+        }
+        if (mod.universalDh || mod.originalDh) {
+            if (!dh) dh = &mod;
+            else if (mod.universalDh != dh->universalDh) plan.conflicts.push_back({"dh", mod.name, dh->name, 0});
+        }
+        if (mod.hasDivisions || mod.originalLeagues) {
+            if (!divisions) divisions = &mod;
+            else plan.conflicts.push_back({"divisions", mod.name, divisions->name, 0});
+        }
+    }
+    if (start) {
+        plan.startYear = start->startYear;
+        plan.startFrom = start->name;
+        plan.rosterYear = start->rosterYear ? start->rosterYear : start->startYear;
+    }
+    if (dh) plan.dh = dh->universalDh, plan.dhFrom = dh->name;
+    if (divisions) {
+        plan.modernLeagues = divisions->hasDivisions;  // else leagues = "original"
+        plan.leaguesFrom = divisions->name;
+        plan.leaguesHouOnly = !divisions->hasDivisions || HouOnly(*divisions);
+    }
+    return plan;
+}
+
+// The same schedule file in two mods (downloaded twice) is not a conflict. `rootOf(name)` gives the
+// folder of the mod with that name.
+template <typename RootOf>
+void DropSameSchedules(Plan& plan, RootOf rootOf) {
+    auto read = [](const std::filesystem::path& path) {
+        std::ifstream in(path, std::ios::binary);
+        return in ? std::string(std::istreambuf_iterator<char>(in), {}) : std::string();
+    };
+    std::erase_if(plan.conflicts, [&](const Plan::Conflict& c) {
+        if (c.what != "schedule") return false;
+        const std::string file = std::to_string(c.year) + ".csv";
+        return read(rootOf(c.loser) / "schedule" / file) == read(rootOf(c.winner) / "schedule" / file);
+    });
+}
+
+// The years from `first` a season-mode game reaches without a schedule file (it then has a generated
+// one), up to `last`.
+inline std::vector<int> GeneratedYears(const Plan& plan, int first, int last) {
+    std::vector<int> years;
+    for (int y = first; y <= last; ++y)
+        if (!plan.schedules.count(y)) years.push_back(y);
+    return years;
+}
+
+// ---- mod.toml edits: the rest of the file is kept as it is ----
+
+namespace detail {
+// [begin, end) of each line before the first [table] (top-level keys), and where that table starts.
+inline size_t TopLevelEnd(const std::string& text) {
+    size_t at = 0;
+    while (at < text.size()) {
+        size_t start = at;
+        while (start < text.size() && (text[start] == ' ' || text[start] == '\t')) ++start;
+        if (start < text.size() && text[start] == '[') return at;
+        const size_t next = text.find('\n', at);
+        if (next == std::string::npos) return text.size();
+        at = next + 1;
+    }
+    return text.size();
+}
+inline bool IsKeyLine(std::string_view line, std::string_view key) {
+    size_t i = 0;
+    while (i < line.size() && (line[i] == ' ' || line[i] == '\t')) ++i;
+    if (line.substr(i, key.size()) != key) return false;
+    i += key.size();
+    while (i < line.size() && (line[i] == ' ' || line[i] == '\t')) ++i;
+    return i < line.size() && line[i] == '=';
+}
+}  // namespace detail
+
+// Sets a top-level `key = value` (value as TOML: 2025, "both"), or removes it with an empty value.
+inline std::string SetKey(std::string text, std::string_view key, std::string_view value) {
+    const size_t end = detail::TopLevelEnd(text);
+    size_t at = 0;
+    while (at < end) {
+        size_t next = text.find('\n', at);
+        if (next == std::string::npos || next > end) next = end;
+        std::string_view line(text.data() + at, next - at);
+        if (detail::IsKeyLine(line, key)) {
+            const size_t lineEnd = next < text.size() && text[next] == '\n' ? next + 1 : next;
+            if (value.empty()) text.erase(at, lineEnd - at);
+            else text.replace(at, next - at, std::string(key) + " = " + std::string(value));
+            return text;
+        }
+        at = next + 1;
+    }
+    if (value.empty()) return text;
+    std::string line = std::string(key) + " = " + std::string(value) + "\n";
+    if (end < text.size()) {
+        // After the last top-level line, so the blank lines before the table stay before it.
+        size_t at = end;
+        while (at >= 2 && text[at - 1] == '\n' && text[at - 2] == '\n') --at;
+        return text.insert(at, line);
+    }
+    if (!text.empty() && text.back() != '\n') text += '\n';
+    return text + line;
+}
+
+// With `modern`, a [divisions] table that puts Houston in the AL West (15/15); without it, no
+// [divisions] table. Only for files whose [divisions] is absent or just that (HouOnly).
+inline std::string SetModernDivisions(std::string text, bool modern) {
+    // Remove a [divisions] table: from its header to the next table or the end.
+    size_t at = 0;
+    while (at < text.size()) {
+        size_t start = at;
+        while (start < text.size() && (text[start] == ' ' || text[start] == '\t')) ++start;
+        if (text.compare(start, 11, "[divisions]") == 0) {
+            size_t stop = text.find('\n', start);
+            while (stop != std::string::npos) {
+                size_t s = stop + 1;
+                while (s < text.size() && (text[s] == ' ' || text[s] == '\t')) ++s;
+                if (s < text.size() && text[s] == '[') break;
+                stop = text.find('\n', stop + 1);
+            }
+            text.erase(at, stop == std::string::npos ? std::string::npos : stop + 1 - at);
+            // A blank line left before it goes too.
+            while (text.size() >= 2 && text.compare(text.size() - 2, 2, "\n\n") == 0) text.pop_back();
+            break;
+        }
+        const size_t next = text.find('\n', at);
+        if (next == std::string::npos) break;
+        at = next + 1;
+    }
+    if (!modern) return text;
+    if (!text.empty() && text.back() != '\n') text += '\n';
+    return text + "\n[divisions]\nal_west = [\"HOU\"]\n";
+}
+
+}  // namespace season_pack
diff --git a/runtime/include/season_schedule.h b/runtime/include/season_schedule.h
index 621dea3..f6e7121 100644
--- a/runtime/include/season_schedule.h
+++ b/runtime/include/season_schedule.h
@@ -465,4 +465,24 @@ inline void MonthDay(int index, int& month, int& day) {
     day = d + 1;
 }
 
+// The All-Star Game's day. The game puts it on the third Tuesday of July (`gameDay`); the real game has
+// been on the second or third Tuesday, the day after the Home Run Derby, with no games from Monday to
+// Wednesday. With a real schedule (`realSchedule`) it goes to the second day of the run of days without
+// games nearest the game's day (three weeks each way), so it lands on that year's break even when the
+// season was moved a few days (Fit). Otherwise the game's day stays unless it has games.
+// `teamGames[d]` = team games on slot day d.
+inline int AllStarBreakDay(const std::array<int, kDays>& teamGames, int gameDay, bool realSchedule) {
+    auto free = [&](int d) { return d >= kRegularFirst && d <= kRegularLast && teamGames[d] == 0; };
+    if (gameDay < 0 || gameDay >= kDays || (!realSchedule && free(gameDay))) return gameDay;
+    for (int k = 0; k <= 21; ++k) {
+        for (int d : {gameDay - k, gameDay + k}) {
+            if (!free(d)) continue;
+            int first = d;
+            while (free(first - 1)) --first;
+            return free(first + 1) ? first + 1 : first;
+        }
+    }
+    return gameDay;
+}
+
 }  // namespace season_schedule
diff --git a/runtime/include/season_text.h b/runtime/include/season_text.h
new file mode 100644
index 0000000..6485bf0
--- /dev/null
+++ b/runtime/include/season_text.h
@@ -0,0 +1,106 @@
+#pragma once
+
+// The words for a season_pack::Plan: what a new Season mode game or MLB Life career will use, in the
+// player's language. Shared by the launcher (MEJORAS' foot) and the Season Studio (its summary).
+
+#include <string>
+#include <vector>
+
+#include "power_pros_ui.h"
+#include "season_pack.h"
+
+namespace season_text {
+using power_pros_ui::Tr;
+
+// "2025, 2026-2028" from sorted years.
+inline std::string YearRanges(const std::vector<int>& years) {
+    std::string out;
+    for (size_t i = 0; i < years.size();) {
+        size_t j = i;
+        while (j + 1 < years.size() && years[j + 1] == years[j] + 1) ++j;
+        out += (out.empty() ? "" : ", ") + std::to_string(years[i]) + (j > i ? "-" + std::to_string(years[j]) : "");
+        i = j + 1;
+    }
+    return out;
+}
+
+// The Season Studio's summary and the MEJORAS footer: what a new season will use, and the settings of
+// one mod that another overrides.
+struct SeasonText {
+    std::string choice;  // "Empieza en 2025, calendario real"
+    std::string help;    // the whole picture
+    std::string footer;  // a line for MEJORAS
+};
+inline SeasonText DescribeSeason(const season_pack::Plan& plan, int maxSeasons) {
+    SeasonText out;
+    auto from = [](const std::string& mod) { return std::string(Tr(" (mod «", " (mod «")) + mod + "»)"; };
+    const int last = plan.startYear + (maxSeasons ? maxSeasons : 20) - 1;
+    std::vector<int> real;
+    for (const auto& [year, mod] : plan.schedules)
+        if (year >= plan.startYear && year <= last) real.push_back(year);
+    std::string& h = out.help;
+    h = Tr("Así empezará una partida nueva del modo Temporada o de MLB Life, con los mods activos y las "
+           "opciones de MEJORAS del launcher:\n\n",
+           "This is how a new Season mode or MLB Life game will start, with the enabled mods and the launcher's "
+           "ENHANCEMENTS options:\n\n");
+    h += std::string(Tr("- Año: ", "- Year: ")) + std::to_string(plan.startYear) +
+         (plan.startFrom.empty() ? std::string(Tr(" (el del juego)", " (the game's)")) : from(plan.startFrom)) + "\n";
+    if (plan.rosterYear != plan.startYear)
+        h += std::string(Tr("- Roster de ", "- Roster from ")) + std::to_string(plan.rosterYear) +
+             Tr(" (las edades se calculan con ese año)\n", " (ages are worked out from that year)\n");
+    h += Tr("- Calendario:\n", "- Schedule:\n");
+    if (!plan.schedules.count(plan.startYear))
+        h += plan.startYear == 2008 && !plan.modernLeagues
+                 ? std::string(Tr("    2008: el oficial del juego\n", "    2008: the game's official one\n"))
+                 : "    " + std::to_string(plan.startYear) + Tr(": generado por el juego\n", ": generated by the game\n");
+    if (!real.empty()) {
+        std::string sources;
+        for (int y : real)
+            if (sources.find(plan.schedules.at(y)) == std::string::npos)
+                sources += (sources.empty() ? "" : ", ") + plan.schedules.at(y);
+        h += "    " + YearRanges(real) + Tr(": real", ": real") + from(sources) + "\n";
+    }
+    const auto generated = season_pack::GeneratedYears(plan, plan.startYear + 1, last);
+    if (!generated.empty())
+        h += "    " + YearRanges(generated) + (maxSeasons ? "" : Tr(" y siguientes", " and later")) +
+             Tr(": generado por el juego\n", ": generated by the game\n");
+    h += std::string("- DH: ") +
+         (plan.dh ? Tr("en ambas ligas", "in both leagues") : Tr("solo en estadios de la Liga Americana (original)", "only in American League parks (original)")) +
+         (!plan.dhFrom.empty() ? from(plan.dhFrom) : plan.dh ? std::string(Tr(" (MEJORAS)", " (ENHANCEMENTS)")) : std::string()) + "\n";
+    h += std::string(Tr("- Ligas: ", "- Leagues: ")) +
+         (!plan.modernLeagues ? std::string(Tr("14 y 16, las de 2008 (original)", "14 and 16, 2008's (original)")) + (plan.leaguesFrom.empty() ? std::string() : from(plan.leaguesFrom))
+          : !plan.leaguesHouOnly ? std::string(Tr("divisiones propias", "its own divisions")) + from(plan.leaguesFrom)
+                                 : std::string(Tr("15 y 15, Houston en la AL West", "15 and 15, Houston in the AL West")) +
+                                       (plan.leaguesFrom.empty() ? std::string(Tr(" (MEJORAS)", " (ENHANCEMENTS)")) : from(plan.leaguesFrom))) +
+         "\n";
+    if (!plan.conflicts.empty()) {
+        h += Tr("\nAvisos: dos mods activos piden cosas distintas. Se usa el primero por nombre.\n",
+                "\nWarnings: two enabled mods ask for different things. The first by name is used.\n");
+        for (const auto& c : plan.conflicts) {
+            h += "- «" + c.loser + "»";
+            if (c.what == "start_year") h += std::string(Tr(" empezaría en ", " would start in ")) + std::to_string(c.year);
+            else if (c.what == "schedule") h += std::string(Tr(" trae otro calendario de ", " has another schedule for ")) + std::to_string(c.year);
+            else if (c.what == "dh") h += Tr(" pide otro DH", " asks for another DH");
+            else h += Tr(" trae otras ligas", " has other leagues");
+            h += std::string(Tr(": se usa lo de «", ": «")) + c.winner + Tr("».\n", "»'s is used.\n");
+        }
+        h += Tr("Desactiva uno en MODS si no es lo que quieres.\n", "Switch one off in MODS if that is not what you want.\n");
+    }
+    h += Tr("\nLas partidas ya empezadas siguen como estaban.", "\nGames already started stay as they were.");
+
+    out.choice = std::string(Tr("Empieza en ", "Starts in ")) + std::to_string(plan.startYear);
+    if (plan.schedules.count(plan.startYear)) out.choice += Tr(", calendario real", ", real schedule");
+    if (!plan.conflicts.empty()) out.choice += Tr(" · ¡aviso!", " · warning!");
+    out.footer = std::string(Tr("Próxima partida nueva: ", "Next new game: ")) + std::to_string(plan.startYear) +
+                 (plan.schedules.count(plan.startYear) ? Tr(", calendario real", ", real schedule") : "") +
+                 (plan.dh ? Tr(", DH en ambas ligas", ", DH in both leagues") : "") +
+                 (plan.modernLeagues ? Tr(", ligas 15 y 15", ", 15 and 15 leagues") : "") +
+                 (plan.dhFrom.empty() && plan.leaguesFrom.empty() && plan.startFrom.empty()
+                      ? std::string()
+                      : std::string(Tr(". Lo que viene de un mod manda sobre estas opciones", ". What comes from a mod overrides these options"))) +
+                 (plan.conflicts.empty() ? "" : Tr(". Hay avisos", ". There are warnings")) +
+                 Tr(". Detalles y ajustes en HERRAMIENTAS > EDITOR DE TEMPORADA.", ". Details and settings in TOOLS > SEASON EDITOR.");
+    return out;
+}
+
+}  // namespace season_text
