diff --git a/runtime/tests/season_pack_tests.cpp b/runtime/tests/season_pack_tests.cpp
new file mode 100644
index 0000000..c3ba2fb
--- /dev/null
+++ b/runtime/tests/season_pack_tests.cpp
@@ -0,0 +1,98 @@
+#include "season_pack.h"
+
+#include <cstdio>
+
+static int failures = 0;
+static void Check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+struct Mod {
+    std::string name;
+    bool enabled = true;
+    int startYear = 0, rosterYear = 0;
+    bool universalDh = false, originalDh = false;
+    std::vector<std::string> divisions[6];
+    bool hasDivisions = false, originalLeagues = false;
+    std::vector<int> years;
+};
+
+int main() {
+    using namespace season_pack;
+    auto years = [](const Mod& m) { return m.years; };
+
+    // Nothing: 2008, the options.
+    {
+        const Plan plan = Make(std::vector<Mod>{}, true, false, years);
+        Check(plan.startYear == 2008 && plan.startFrom.empty() && plan.rosterYear == 2008, "no mods: 2008");
+        Check(plan.dh && plan.dhFrom.empty() && !plan.modernLeagues, "no mods: the options");
+    }
+    // Two packs: the first by name wins, the other is a conflict; schedules from both, the first per year.
+    {
+        Mod a{"A pack"};
+        a.startYear = 2025, a.years = {2025, 2026};
+        Mod b{"B pack"};
+        b.startYear = 2026, b.rosterYear = 2023, b.years = {2026, 2027}, b.universalDh = true;
+        b.divisions[2] = {"HOU"}, b.hasDivisions = true;
+        Mod off{"C off"};
+        off.enabled = false, off.startYear = 2030;
+        const Plan plan = Make(std::vector<Mod>{a, b, off}, false, false, years);
+        Check(plan.startYear == 2025 && plan.startFrom == "A pack" && plan.rosterYear == 2025, "first pack's year");
+        Check(plan.schedules.size() == 3 && plan.schedules.at(2026) == "A pack" && plan.schedules.at(2027) == "B pack",
+              "schedules per year");
+        Check(plan.conflicts.size() == 2 && plan.conflicts[0].what == "start_year" && plan.conflicts[0].loser == "B pack" &&
+                  plan.conflicts[1].what == "schedule" && plan.conflicts[1].year == 2026,
+              "conflicts: start year and the 2026 schedule");
+        Check(plan.dh && plan.dhFrom == "B pack" && plan.modernLeagues && plan.leaguesFrom == "B pack" && plan.leaguesHouOnly,
+              "DH and divisions from a pack");
+        Check(GeneratedYears(plan, 2025, 2029) == std::vector<int>{2028, 2029}, "generated years");
+    }
+    // "original" in a mod wins over the options; the first mod by name decides.
+    {
+        Mod a{"A"}, b{"B"};
+        a.originalDh = true, a.originalLeagues = true;
+        b.universalDh = true, b.divisions[2] = {"HOU"}, b.hasDivisions = true;
+        const Plan plan = Make(std::vector<Mod>{a, b}, true, true, years);
+        Check(!plan.dh && plan.dhFrom == "A" && !plan.modernLeagues && plan.leaguesFrom == "A", "original from a mod");
+        Check(plan.conflicts.size() == 2 && plan.conflicts[0].what == "dh" && plan.conflicts[1].what == "divisions",
+              "original against both: conflicts");
+    }
+    {
+        Mod a{"A"}, b{"B"};
+        a.startYear = b.startYear = 2025;
+        Check(Make(std::vector<Mod>{a, b}, false, false, years).conflicts.empty(), "the same start year is no conflict");
+    }
+    {
+        Mod c{"Custom"};
+        c.divisions[0] = {"TB"}, c.divisions[2] = {"HOU"}, c.hasDivisions = true;
+        Check(!HouOnly(c), "other divisions are not only Houston");
+    }
+
+    // mod.toml edits.
+    Check(SetKey("name = \"X\"\n", "start_year", "2025") == "name = \"X\"\nstart_year = 2025\n", "add a key");
+    Check(SetKey("name = \"X\"", "start_year", "2025") == "name = \"X\"\nstart_year = 2025\n", "add with no newline");
+    Check(SetKey("name = \"X\"\nstart_year = 2024\ndh = \"both\"\n", "start_year", "2025") ==
+              "name = \"X\"\nstart_year = 2025\ndh = \"both\"\n",
+          "replace a key");
+    Check(SetKey("name = \"X\"\nstart_year = 2024\ndh = \"both\"\n", "start_year", "") == "name = \"X\"\ndh = \"both\"\n",
+          "remove a key");
+    Check(SetKey("name = \"X\"\n\n[divisions]\nstart_year = 1\n", "start_year", "2025") ==
+              "name = \"X\"\nstart_year = 2025\n\n[divisions]\nstart_year = 1\n",
+          "a key goes before the first table, a table's key is left");
+    Check(SetKey("start_years = 3\n", "start_year", "") == "start_years = 3\n", "another key with the same start");
+    Check(SetModernDivisions("name = \"X\"\n", true) == "name = \"X\"\n\n[divisions]\nal_west = [\"HOU\"]\n", "add divisions");
+    Check(SetModernDivisions("name = \"X\"\n\n[divisions]\nal_west = [\"HOU\"]\n", false) == "name = \"X\"\n", "remove divisions");
+    Check(SetModernDivisions("name = \"X\"\n\n[divisions]\nal_west = [\"HOU\"]\n\n[[stadium]]\ncode = \"a\"\n", false) ==
+              "name = \"X\"\n\n[[stadium]]\ncode = \"a\"\n",
+          "remove divisions before another table");
+    Check(SetModernDivisions(SetModernDivisions("name = \"X\"\n", true), true) ==
+              "name = \"X\"\n\n[divisions]\nal_west = [\"HOU\"]\n",
+          "adding twice keeps one table");
+
+    if (failures) return 1;
+    std::printf("season_pack_tests: ok\n");
+    return 0;
+}
