+    f6 = vfmaq_f32(f8, f6, k26);
+    f4 = QMsub(f4, k27, f8);
+    f6 = vsubq_f32(f6, f7);
+    f9 = vaddq_f32(f1, f6);
+    f5 = QMsub(f5, k29, f6);
+    const Q f31 = vsubq_f32(f1, f6);
+    r.out[1] = f9;
+    r.out[6] = f31;
