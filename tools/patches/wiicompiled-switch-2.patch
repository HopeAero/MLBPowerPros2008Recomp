+        P19RecordLod(*p19Lazy, r.mif, r.maf, r.mil, r.mal, r.lb, r.bc, r.el, r.ma);
+    } else {
+        GXInitTexObjLOD(obj, (GXTexFilter)r.mif, (GXTexFilter)r.maf, r.mil, r.mal, r.lb, (GXBool)r.bc, (GXBool)r.el,
+                        (GXAnisotropy)r.ma);
+    }
+}
+
+// GX__InitTexObjWrapMode / Tlut / Filter / LODBias / UserData without their guest stores.
+void GxfTexSetMaps(const GxfTexSetRec& r) {
+    std::lock_guard<GxObjMutex> guard(g_texObjMutex);
+    switch (r.kind) {
+    case kGxfTexWrap: {
+        GXTexObj* obj = GetHostTexObj(r.oa);
+        TexObjMeta& meta = GetTexObjMeta(r.oa);
+        meta.wrapS = r.a;
+        meta.wrapT = r.b;
+        GXInitTexObjWrapMode(obj, (GXTexWrapMode)r.a, (GXTexWrapMode)r.b);
+        break;
+    }
+    case kGxfTexTlut: {
+        GXTexObj* obj = GetHostTexObj(r.oa);
+        TexObjMeta& meta = GetTexObjMeta(r.oa);
+        meta.tlut = r.a;
+        GXInitTexObjTlut(obj, r.a);
+        break;
+    }
+    case kGxfTexFilter: {
+        TexObjMeta& meta = GetTexObjMeta(r.oa);
+        meta.minFilter = r.a;
+        meta.magFilter = r.b;
+        if (GXTexObj* obj = TryGetHostTexObj(r.oa)) {
+            ApplyHostTexObjLod(obj, meta, (GXTexFilter)r.a, (GXTexFilter)r.b, meta.lodBias, (GXAnisotropy)meta.maxAniso);
+        }
+        break;
+    }
+    case kGxfTexLodBias: {
+        TexObjMeta& meta = GetTexObjMeta(r.oa);
+        float clampedBias = 0.0f;
+        std::memcpy(&clampedBias, &r.a, sizeof(clampedBias));
+        meta.lodBias = clampedBias;
+        if (GXTexObj* obj = TryGetHostTexObj(r.oa)) {
+            ApplyHostTexObjLod(obj, meta, (GXTexFilter)meta.minFilter, (GXTexFilter)meta.magFilter, clampedBias,
+                               (GXAnisotropy)meta.maxAniso);
+        }
+        break;
+    }
+    default: {
+        TexObjMeta& meta = GetTexObjMeta(r.oa);
+        meta.userData = r.a;
+        if (GXTexObj* obj = TryGetHostTexObj(r.oa)) {
+            GXInitTexObjUserData(obj, GuestToHostPtr(r.a));
+        }
+        break;
+    }
+    }
+}
+
+void GxfTexInitExec(const uint8_t* payload) {
+    const auto r = GxfTexLoadPayload<GxfTexInitRec>(payload);
+    GxfTexSnapScope snap(r.oa, r.shadow);
+    GxfTexInitMaps(r);
+}
+void GxfTexLodExec(const uint8_t* payload) {
+    const auto r = GxfTexLoadPayload<GxfTexLodRec>(payload);
+    GxfTexSnapScope snap(r.oa, r.shadow);
+    GxfTexLodMaps(r);
+}
+void GxfTexSetExec(const uint8_t* payload) {
+    const auto r = GxfTexLoadPayload<GxfTexSetRec>(payload);
+    GxfTexSnapScope snap(r.oa, r.shadow);
+    GxfTexSetMaps(r);
+}
+void GxfTexLoadExec(const uint8_t* payload) {
+    const auto r = GxfTexLoadPayload<GxfTexLoadRec>(payload);
+    GxfTexSnapScope snap(r.oa, r.shadow);
+    if (GxLoadTexObjBody(r.oa, r.tid) != (r.accept != 0)) [[unlikely]] {
+        Gxf4Count(kGxf4TexMispredicts);
+    }
+}
+
+// Runs `maps` here: on the front end (exec), or at a sync point when the call should have been
+// recorded but its GXTexObj could not be read; then the model is read back from the slot.
+template <typename Fn>
+void GxfTexRunHere(uint32_t oa, bool atSyncPoint, Fn&& maps) {
+    if (atSyncPoint) {
+        Gxf4Count(kGxf4TexSyncs);
+    }
+    GxfRuntimeDirect direct("GXF4 texture object");
+    maps();
+    GxfTexModelReseed(oa);
+}
+
+void GxfTexLoadDoneStores() {
+    try { uint32_t gd = Memory::Read32(kGXDataPtrAddr); if (gd) { Memory::Write32(gd + 0x5FCu, Memory::Read32(gd + 0x5FCu) | 1u); Memory::Write16(gd + 2, 0); } } catch (...) {}
+}
