diff --git a/runtime/src/hle/gx/gx_stream_common.h b/runtime/src/hle/gx/gx_stream_common.h
index 006ab47..cbf18cc 100644
--- a/runtime/src/hle/gx/gx_stream_common.h
+++ b/runtime/src/hle/gx/gx_stream_common.h
@@ -361,7 +361,78 @@ struct AuroraVtxPublishOptions {
     int fmtLoopLast;
 };
 
+#if defined(__SWITCH__)
+} // namespace GxStream
+// G6 (switch phase 44; aurora GXGeometry.cpp): GXSetVtxDesc / GXSetVtxAttrFmt over a list, the same
+// calls in the same order. WIICOMPILED_GX_G6=0 keeps the one-call-per-attribute loops below.
+extern "C" void GXSetVtxDescRun(const GXVtxDescList* list, u32 count);
+extern "C" void GXSetVtxAttrFmtRun(GXVtxFmt vtxfmt, const GXVtxAttrFmtList* list, u32 count);
+extern "C" int aurora_gx_g6_enabled(void);
+// P28 (switch phase 82; aurora gx_vtx_plan.inc): the same two publications decided from plans kept by
+// layout content. WIICOMPILED_GX_VTXPLAN=0 keeps the list-building code below.
+extern "C" int aurora_gx_vtxplan_enabled(void);
+extern "C" void GXSetVtxDescPlanRun(const uint32_t* hleDesc, int includeNbt);
+extern "C" void GXSetVtxAttrFmtPlanRun(GXVtxFmt vtxfmt, const void* row26, int first, int last, int includeNbt);
+static_assert(sizeof(GXAttrType) == sizeof(uint32_t) && sizeof(GXCompCnt) == sizeof(uint32_t) &&
+              sizeof(GXCompType) == sizeof(uint32_t) && sizeof(VtxAttrFmt) == 12 &&
+              offsetof(VtxAttrFmt, cnt) == 0 && offsetof(VtxAttrFmt, type) == 4 && offsetof(VtxAttrFmt, frac) == 8,
+              "aurora's gx_vtx_plan.inc RawFmt");
+namespace GxStream {
+// Both switches, read once into a global (bit 0: G6 lists, bit 1: plans); -1 until the first draw.
+inline int g_publishFlags = -1;
+inline int PublishFlagsInit() noexcept {
+    g_publishFlags = (aurora_gx_g6_enabled() != 0 ? 1 : 0) | (aurora_gx_vtxplan_enabled() != 0 ? 2 : 0);
+    return g_publishFlags;
+}
+inline bool PublishVtxStateBatched() noexcept {
+    return ((g_publishFlags >= 0 ? g_publishFlags : PublishFlagsInit()) & 1) != 0;
+}
+inline bool PublishVtxStatePlanned() noexcept {
+    return ((g_publishFlags >= 0 ? g_publishFlags : PublishFlagsInit()) & 2) != 0;
+}
+#endif
+
 inline void PublishAuroraVtxState(GXVtxFmt fmt, const AuroraVtxPublishOptions& options) {
+#if defined(__SWITCH__)
