--- /dev/null
+++ b/runtime/src/hle/gx/gx_batch_dl.inc
@@ -0,0 +1,34 @@
+// GX batch2: a validated, simple cached draw already owns immutable scan tables.
+// Use them in place instead of initializing and copying five per-call arrays.
+static bool SubmitCachedSimpleDrawList(const DlScanCacheRecord& cached,const uint8_t* list,uint32_t nbytes) {
+    const auto& entry=cached.result;
+    if (!entry.scanOk || entry.needsFlatten || entry.dlHasNestedDl || entry.dlHasArrayStateWrites ||
+        entry.dlHasCpWrites || !cached.cpWrites.empty()) return false;
+    const uint8_t* refStream=nullptr;uint32_t refBytes=0;
+    if (GxG6() && cached.hostStream) {
+        refStream=cached.hostStream.get();refBytes=cached.hostStreamBytes;
+        if (GxG6Check() && (refBytes!=nbytes || std::memcmp(refStream,list,nbytes)!=0)) {
+            ++aurora_gx_g6_counters[kG6CheckMismatches];refStream=nullptr;
+        }
+    }
+    ApplyAuroraVtxDesc();
+    ApplyAuroraVtxAttrFmtForDisplayList(entry.dlVtxFmt,entry.dlVtxFmtMixed);
+    const uint32_t mask=GxP17()?entry.sawIdxMask:0x03FFFFFFu;
+    const bool arraysOk=ApplyAuroraArraysForDisplayList(entry.maxIdx,entry.sawIdx,
+        entry.dlVtxFmt,entry.dlVtxFmtMixed,mask);
+    // Always run the XF preparation too, even after an array failure: same effects/order.
+    const bool xfOk=ApplyAuroraIndexedXFArraysForDisplayList(entry.maxXfIdx,entry.maxXfBytes,entry.sawXfIdx);
+    EnsureAuroraFrameActive();GXMarkFrameWork();
+    if (arraysOk && xfOk) {
+        if (refStream && refBytes==nbytes) GXCallDisplayListRef(refStream,refBytes);
+        else GXCallDisplayList(list,nbytes);
+        SyncAppliedVtxStateFromHleReal();
+        GxBatch::CountHit(GxBatch::CachedDl);
+    } else {
+        // This record has no CP writes, so the old path had no pre-scan snapshot to restore.
+        // Do not return to the caller's general path and publish array state a second time.
+        InvalidateAppliedAuroraState();ParseDisplayList(list,nbytes);InvalidateAppliedAuroraState();
+        GxBatch::CountHit(GxBatch::CacheFallback);
+    }
+    return true;
+}
diff --git a/runtime/src/hle/gx/gx_batch_fifo.inc b/runtime/src/hle/gx/gx_batch_fifo.inc
new file mode 100644
index 0000000..7dda758
--- /dev/null
+++ b/runtime/src/hle/gx/gx_batch_fifo.inc
@@ -0,0 +1,113 @@
+// GX batch2: consume direct F32 attributes without serializing each component through
+// the command ring. Keep scratch bytes/buffers, call boundaries and vertex completion identical.
+// GXF4: included by gx_fifo_parse.inc, over its GXP_* parser-state macros (gx_fifo.cpp).
+static inline int DirectF32FifoRemaining() {
+    const auto& g=GXP_STATE;
+    if (!g.inBegin || !g.auroraBeginCalled || g.fifoByteCount!=0 || g.fifoReadOffset!=0 ||
+        g.currentVtxFmt>=GX_MAX_VTXFMT) return 0;
+    const GXAttr a=g.currentAttr;
+    if (GxVtxF32::kEnabled) {
+        // P28: the checks below, answered per (generation, format) by GxVtxF32::F32Components.
+        if (static_cast<unsigned>(a)>=26u) return 0;
+        const uint32_t e=GXP_F32(g,a);
+        if (static_cast<unsigned>(g.currentComp)>=e) return 0;
+        return static_cast<int>(e)-g.currentComp;
+    }
+    if (a!=GX_VA_POS && a!=GX_VA_NRM && !(a>=GX_VA_TEX0 && a<=GX_VA_TEX7)) return 0;
+    const auto& f=g.vtxAttrFmt[g.currentVtxFmt][a];
+    if (g.vtxDesc[a]!=GX_DIRECT || f.type!=GX_F32) return 0;
+    const int expected=static_cast<int>(AttrCompCount(a,f,1u));
+    if (expected>9 || g.currentComp<0 || g.currentComp>=expected) return 0;
+    return expected-g.currentComp;
+}
+
+static inline void FinishDirectFifoAttribute(GXAttr attr) {
+    auto& g=GXP_STATE;
+    g.currentAttr=GXP_NEXT(g, attr); g.currentComp=0;
+    if (g.currentAttr==GX_VA_NULL) {
+        GXP_RESET(g);
+        if (g.vertsRemaining>0 && --g.vertsRemaining==0) {
+            g.inBegin=false; g.auroraBeginCalled=false; GXEnd();
+        }
+    }
+}
+
+// Color writes have no component conversion; keep the parser's bytes and completion order.
+static inline bool TryDirectColorFifoWrite(u32 value, uint32_t sizeBytes) {
+    auto& g = GXP_STATE;
+    const GXAttr attr = g.currentAttr;
+    if (!g.auroraBeginCalled || g.currentVtxFmt >= GX_MAX_VTXFMT ||
+        (attr != GX_VA_CLR0 && attr != GX_VA_CLR1) || g.vtxDesc[attr] != GX_DIRECT) return false;
+    const auto& fmt = g.vtxAttrFmt[g.currentVtxFmt][attr];
+    const uint32_t colorSize = ColorByteSize(fmt.type, fmt.cnt);
+    const uint32_t count = sizeBytes == 0 ? 4u : sizeBytes;
+    if ((count != 1u && count != 2u && count != 4u) || g.fifoByteCount >= colorSize ||
+        count > colorSize - g.fifoByteCount || g.fifoReadOffset > g.fifoBytes.size() ||
+        g.fifoByteCount + count > g.fifoBytes.size() - g.fifoReadOffset) return false;
+    uint8_t* data = g.fifoBytes.data() + g.fifoReadOffset;
+    uint8_t* out = data + g.fifoByteCount;
+    if (count == 4u) BigEndian::Write32(out, value);
+    else if (count == 2u) BigEndian::Write16(out, static_cast<uint16_t>(value));
+    else *out = static_cast<uint8_t>(value);
+    g.fifoByteCount += count;
+    if (g.fifoByteCount == colorSize) {
+        GXColor color{};
+        DecodeColorBytes(data, fmt.type, fmt.cnt, color);
+        g.fifoReadOffset = 0;
+        g.fifoByteCount = 0;
+        if (fmt.cnt == GX_CLR_RGB) GXColor3u8(color.r, color.g, color.b);
+        else GXColor4u8(color.r, color.g, color.b, color.a);
+        GXP_SCOPE::FinishDirectFifoAttribute(attr);
+    }
+    return true;
+}
+
+static inline bool TryDirectF32FifoWord(u32 value) {
+    const int remaining=DirectF32FifoRemaining();
+    if (!remaining) return false;
+    auto& g=GXP_STATE;const GXAttr attr=g.currentAttr;
+    const auto& f=g.vtxAttrFmt[g.currentVtxFmt][attr];
+    BigEndian::Write32(g.fifoBytes.data(),value);
+    g.rawCompBuffer[g.currentComp]=value;
+    std::memcpy(&g.compBuffer[g.currentComp],&value,sizeof(value));
+    ++g.currentComp;
+    if (remaining==1) {
+        SubmitAttribute(attr,g.compBuffer,f,g.rawCompBuffer);
+        GXP_SCOPE::FinishDirectFifoAttribute(attr);
+    }
+    GxBatch::CountHit(GxBatch::ScalarWords);
+    return true;
+}
+
+static uint32_t TryDirectF32FifoBurst(const uint8_t* data,uint32_t bytes) {
+    if (!GxBatch::FifoEnabled() || GXP_DL_ACTIVE()) return 0;
+    // A caller can hand us an arbitrary host pointer. Preserve the scalar path if the
+    // source aliases parser state, since stores to component/ring buffers could change it.
+    const uintptr_t start=reinterpret_cast<uintptr_t>(data);
+    const uintptr_t state=reinterpret_cast<uintptr_t>(&GXP_STATE);
+    if (start+bytes<start || (start<state+sizeof(GXP_STATE) && start+bytes>state)) return 0;
+    uint32_t offset=0;
+    while (bytes-offset>=4u && !GXP_DL_ACTIVE()) {
+        const int remaining=DirectF32FifoRemaining();
+        if (!remaining) break;
+        auto& g=GXP_STATE;const GXAttr attr=g.currentAttr;
+        const auto& f=g.vtxAttrFmt[g.currentVtxFmt][attr];
+        const uint32_t take=std::min<uint32_t>(remaining,(bytes-offset)/4u);
+        u32 value=0;
+        for (uint32_t i=0;i<take;++i) {
+            value=ReadBE32(data+offset);offset+=4u;
+            g.rawCompBuffer[g.currentComp]=value;
+            std::memcpy(&g.compBuffer[g.currentComp],&value,sizeof(value));
+            ++g.currentComp;
+        }
+        // No callback runs between components. At SubmitAttribute the ring contains the
+        // same final word as the old per-word path, and its live byte count is still zero.
+        BigEndian::Write32(g.fifoBytes.data(),value);
+        if (take==static_cast<uint32_t>(remaining)) {
+            SubmitAttribute(attr,g.compBuffer,f,g.rawCompBuffer);
+            GXP_SCOPE::FinishDirectFifoAttribute(attr);
+        }
+    }
+    if (offset) GxBatch::CountHit(GxBatch::BurstWords,offset/4u);
+    return offset;
+}
