+    host.lazyLod = false;
+    GxP19Count(kP19LazyBuilt);
+}
+
+static inline GXTexObj* P19HostPtr(HleTexObj& host) {
+    if (host.lazy) [[unlikely]] {
+        P19Materialize(host);
+    }
+    return host.PublicPtr();
+}
