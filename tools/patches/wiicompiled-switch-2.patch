+    if (GuestFlat::RequiresCheckedAccess() || !mlb_reverb::Run(*ctx)) [[unlikely]]
+        mlb_reverb::Translated(*ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x800BC3AC, MLB_ReverbHi_800BC3AC, "AXFXReverbHiProcess");
+#endif
