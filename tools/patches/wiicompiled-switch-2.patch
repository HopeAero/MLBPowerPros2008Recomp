index 0000000..7e2b27f
--- /dev/null
+++ b/runtime/src/hle/gx/gx_batch_array.inc
@@ -0,0 +1,20 @@
+// GX preparation: full writable pages already prove a plain guest RAM mapping.
+// Resolve the requested span once instead of Contains plus GetPointer. Do not retain
+// a pointer across calls: remapping and executable-page guards stay authoritative.
+static const uint8_t* ResolveDisplayListArray(uint32_t base,uint32_t span) {
+#if defined(__SWITCH__)
+    if (GxBatch::PrepEnabled() && base && span) {
+        const uint32_t end=base+span-1u;
+        if (end>=base && (end>>MemoryInline::kPageShift)==(base>>MemoryInline::kPageShift)) {
+            const uintptr_t bias=MemoryInline::g_fullWritablePageBias[base>>MemoryInline::kPageShift];
+            if (bias) {
+                GxBatch::CountHit(GxBatch::ArrayDirect);
+                return reinterpret_cast<const uint8_t*>((bias-1u)+base);
+            }
+        }
+    }
+    GxBatch::CountHit(GxBatch::ArrayFallback);
+#endif
+    if (!Memory::Contains(base,span)) return nullptr;
+    return static_cast<const uint8_t*>(GuestToHostPtr(base,span));
+}
diff --git a/runtime/src/hle/gx/gx_batch_dl.inc b/runtime/src/hle/gx/gx_batch_dl.inc
