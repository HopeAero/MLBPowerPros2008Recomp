+
+template <auto Function> struct BeforeScalar {
+    template <typename... Args> static void Apply(Args...) noexcept {}
+};
+template <> struct BeforeScalar<&::GXSetVtxDesc> {
+    static void Apply(GXAttr attr, GXAttrType type) noexcept { SetVtxDescShadow(attr, type); }
+};
+template <> struct BeforeScalar<&::GXClearVtxDesc> {
+    static void Apply() noexcept { ClearVtxDescShadow(); }
+};
+
+template <typename Value> uint64_t PackValue(const Value& value) noexcept {
+    static_assert(std::is_trivially_copyable_v<Value> && sizeof(Value) <= sizeof(uint64_t));
+    uint64_t word = 0;
+    std::memcpy(&word, &value, sizeof(Value));
+    return word;
+}
+template <typename Value> Value UnpackValue(uint64_t word) noexcept {
+    Value value{};
+    std::memcpy(&value, &word, sizeof(Value));
+    return value;
+}
+
+template <auto Function, typename... Args> struct ScalarCommand {
+    uint64_t words[sizeof...(Args) + 1]{};
+    template <size_t... Index> void Run(std::index_sequence<Index...>) const {
+        Function(UnpackValue<Args>(words[Index])...);
+    }
+    static void Execute(const void* bytes) {
+        ScalarCommand command;
+        std::memcpy(&command, bytes, sizeof(command));
+        command.Run(std::index_sequence_for<Args...>{});
+    }
+};
+
+template <auto Policy> struct Dispatch {
+    template <auto Function = Policy, typename... Args> static decltype(auto) Invoke(Args... args) {
+        using Result = std::invoke_result_t<decltype(Function), Args...>;
+        if (!Intercept() || Synchronous()) return Function(args...);
+        if constexpr (LocalObjectOperation<Policy>) {
+            return Function(args...);
+        } else if constexpr (AsyncOperation<Policy> && std::is_void_v<Result> &&
+                             ((!std::is_pointer_v<Args> && std::is_trivially_copyable_v<Args> &&
+                               sizeof(Args) <= sizeof(uint64_t)) && ...)) {
+            using Command = ScalarCommand<Function, Args...>;
+            Command command{{PackValue(args)...}};
+            queue.Submit(&Command::Execute, command);
+            // A full-queue wait may run a nested guest callback before this record is published.
+            BeforeScalar<Policy>::Apply(args...);
+        } else {
+            // Borrowed pointers and result-bearing calls retain their original observation point.
+            SynchronousScope scope(__PRETTY_FUNCTION__);
+            return Function(args...);
+        }
+    }
+};
+
+template <> struct Dispatch<&::GXGetVtxDesc> {
+    template <auto Function = &::GXGetVtxDesc> static void Invoke(GXAttr attr, GXAttrType* type) {
+        if (!Intercept() || Synchronous()) return Function(attr, type);
+        GetVtxDesc(attr, type);
+    }
+};
+template <> struct Dispatch<&::GXGetVtxDescv> {
+    template <auto Function = &::GXGetVtxDescv> static void Invoke(GXVtxDescList* list) {
+        if (!Intercept() || Synchronous()) return Function(list);
+        GetVtxDescv(list);
+    }
+};
+
+template <auto Function, typename... Args> decltype(auto) Call(Args... args) {
+    return Dispatch<Function>::Invoke(args...);
+}
+template <auto Policy, auto Function, typename... Args> decltype(auto) CallReal(Args... args) {
+    return Dispatch<Policy>::template Invoke<Function>(args...);
+}
