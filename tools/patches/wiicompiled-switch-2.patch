+// Called with a new stream, before SDL's device thread can pull from it: the get callback below runs
+// on that thread for every device buffer (it only counts; it never adds data).
+void AudioBackend::WatchDeviceLocked(SDL_AudioStream* stream) {
+    m_dropUntilTarget = false;
+    m_deviceThreadSetUp.store(false, std::memory_order_relaxed);
+    m_devBytesPerSec.store(static_cast<uint32_t>(m_spec.freq) * static_cast<uint32_t>(m_spec.channels) * 2u,
+                           std::memory_order_relaxed);
+    m_devEpoch.fetch_add(1, std::memory_order_release);
+    if (!SDL_SetAudioStreamGetCallback(stream, &AudioBackend::DevicePullThunk, this)) {
+        RT_LOG(RT_TAG_AUDIO) << "SDL_SetAudioStreamGetCallback failed: " << SDL_GetError() << std::endl;
+    }
+    SDL_AudioSpec device{};
+    int frames = 0;
+    if (SDL_GetAudioDeviceFormat(SDL_GetAudioStreamDevice(stream), &device, &frames) && device.freq > 0) {
+        RT_LOGF(RT_TAG_AUDIO, "output device: %d Hz, %d channels, %d frames per buffer (%.1f ms; audren double-buffers)\n",
+                device.freq, device.channels, frames, frames * 1000.0 / device.freq);
+    }
+}
+
+void SDLCALL AudioBackend::DevicePullThunk(void* userdata, SDL_AudioStream*, int additional, int total) {
+    static_cast<AudioBackend*>(userdata)->OnDevicePull(additional, total);
+}
+
+// SDL's device thread starts at libnx's 0x3B (the lowest of the audio chain, below the mixer, the
+// feeder and the frame worker) with a deadline of one device buffer. On its first pull it moves to
+// core 2 at 0x2C, where it takes ~0.2 ms per 23 ms (WIICOMPILED_AUDIO_DEVICE_BOOST=0 leaves it).
+// `additional` is what the stream lacks for this buffer (input bytes; the resampler's rounding can
+// ask for one frame more than it needs, hence the 8-byte slack).
+void AudioBackend::OnDevicePull(int additional, int total) {
+    if (!m_deviceThreadSetUp.exchange(true, std::memory_order_relaxed)) {
+        const char* boost = std::getenv("WIICOMPILED_AUDIO_DEVICE_BOOST");
+        if (!(boost && *boost == '0')) {
+            SwitchPinCurrentThread(2, 0x2C);
+        }
+    }
+    m_devPulls.fetch_add(1, std::memory_order_relaxed);
+    if (additional > 8) {
+        m_devUnderruns.fetch_add(1, std::memory_order_relaxed);
+        m_devShortBytes.fetch_add(static_cast<uint64_t>(additional), std::memory_order_relaxed);
+    }
+    AudioBackendAtomicMin(m_devMinAtPull, std::max(total - additional, 0));
+    const uint64_t now = AudioBackendNowNs();
+    const uint32_t epoch = m_devEpoch.load(std::memory_order_acquire);
+    const uint32_t bytesPerSec = m_devBytesPerSec.load(std::memory_order_relaxed);
+    if (m_devLastPullNs != 0 && epoch == m_devLastEpoch && bytesPerSec != 0 && total > 0) {
+        const uint64_t gap = now - m_devLastPullNs;
+        const uint64_t pullNs = static_cast<uint64_t>(total) * 1000000000ull / bytesPerSec;
+        m_devPullNs.store(pullNs, std::memory_order_relaxed);
+        AudioBackendAtomicMax(m_devMaxGapNs, gap);
+        if (gap * 2 > pullNs * 3) {
+            m_devLatePulls.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+    m_devLastPullNs = now;
+    m_devLastEpoch = epoch;
+}
