+
+static void GxfTexModelReseed(uint32_t oa) {
+    GxfTexModel& e = GxfTexModelGet(oa);
+    if (TexObjSlot* slot = FindTexObjSlotForLoad(oa)) {
+        e.exists = true;
+        e.v = GxfTexValOf(*slot);
+    } else {
+        e.exists = false;
+        e.v = GxfTexVal{};
+    }
+    e.knownBase = true;
+    e.knownLod = true;
+}
+
+static void GxfTexInitTexObj(uint32_t oa, uint32_t da, uint32_t w, uint32_t h, uint32_t f, uint32_t ws, uint32_t wt,
+                             uint32_t m, bool ci, uint32_t tl) {
+    const uint32_t canonicalDataAddr = CanonicalizeGxMainRamAddress(da);
+    GxfTexInitRec r{oa, da, canonicalDataAddr, w, h, f, ws, wt, m, tl, ci ? 1u : 0u, 0u, {0, 0, 0, 0}};
+    const bool intercept = aurora_gxf_intercept() != 0;
+    if (intercept && GxfTexReadShadow(oa, r.shadow)) [[likely]] {
+        aurora_gxf_post(&GxfTexInitExec, &r, sizeof(r), nullptr, 0, 0);
+        Gxf4Count(kGxf4TexRecords);
+        GxfTexModel& e = GxfTexModelSlot(oa);
+        e.v.dataAddr = canonicalDataAddr;
+        e.v.width = (u16)w;
+        e.v.height = (u16)h;
+        e.v.format = f;
+        e.v.mipmap = (m != 0);
+        e.knownBase = true;
+    } else {
+        GxfTexRunHere(oa, intercept, [&] { GxfTexInitMaps(r); });
+    }
+    // Also write to guest memory so reads work
+    WriteGuestTexObj(oa, canonicalDataAddr, (u16)w, (u16)h, f, ws, wt, m != 0, ci, tl);
+    if (ci) {
+        // GXInitTexObjCI clears bit1 in the flags byte; keep guest memory consistent.
+        try {
+            uint8_t flags = Memory::Read8(oa + 0x1F);
+            Memory::Write8(oa + 0x1F, static_cast<uint8_t>(flags & 0xFD));
+        } catch (...) {
+        }
+    }
+}
+
+static void GxfTexInitTexObjLOD(uint32_t oa, uint32_t mif, uint32_t maf, float mil, float mal, float lb, uint32_t bc,
+                                uint32_t el, uint32_t ma) {
+    float fmal = std::isfinite(mal) && mal >= 0.f ? mal : 0.f, fmil = std::isfinite(mil) && mil >= 0.f ? std::min(mil, fmal) : 0.f;
+    GxfTexLodRec r{oa, mif, maf, fmil, fmal, lb, bc, el, ma, 0u, {0, 0, 0, 0}};
+    const bool intercept = aurora_gxf_intercept() != 0;
+    if (intercept && GxfTexReadShadow(oa, r.shadow)) [[likely]] {
+        aurora_gxf_post(&GxfTexLodExec, &r, sizeof(r), nullptr, 0, 0);
+        Gxf4Count(kGxf4TexRecords);
+        GxfTexModel& e = GxfTexModelSlot(oa);
+        e.v.minLod = fmil;
+        e.v.maxLod = fmal;
+        e.knownLod = true;
+    } else {
+        GxfTexRunHere(oa, intercept, [&] { GxfTexLodMaps(r); });
+    }
+    // Also write LOD info to guest memory
+    WriteGuestTexObjLOD(oa, mif, maf, fmil, fmal, lb, bc != 0, el != 0, ma);
+}
+
+static void GxfTexSet(uint32_t kind, uint32_t oa, uint32_t a, uint32_t b) {
+    GxfTexSetRec r{kind, oa, a, b, {0, 0, 0, 0}};
+    float clampedBias = 0.0f;
+    if (kind == kGxfTexLodBias) {
+        // Clamp bias to [-4.0, 3.99...] range as per SDK
+        constexpr float kMinBias = -4.0f;
+        constexpr float kMaxBias = 3.99f; // Actually ~3.990000009536743
+        std::memcpy(&clampedBias, &a, sizeof(clampedBias));
+        if (clampedBias < kMinBias) clampedBias = kMinBias;
+        if (clampedBias >= 4.0f) clampedBias = kMaxBias;
+        std::memcpy(&r.a, &clampedBias, sizeof(r.a));
+    }
+    const bool intercept = aurora_gxf_intercept() != 0;
+    if (intercept && GxfTexReadShadow(oa, r.shadow)) [[likely]] {
+        aurora_gxf_post(&GxfTexSetExec, &r, sizeof(r), nullptr, 0, 0);
+        Gxf4Count(kGxf4TexRecords);
+        GxfTexModelSlot(oa);
+    } else {
+        GxfTexRunHere(oa, intercept, [&] { GxfTexSetMaps(r); });
+    }
+    switch (kind) {
+    case kGxfTexWrap:
+        try {
+            uint32_t word0 = Memory::Read32(oa + 0x00);
+            word0 = (word0 & ~0xFu) | (a & 0x3u) | ((b & 0x3u) << 2);
+            Memory::Write32(oa + 0x00, word0);
+        } catch (...) {
+        }
+        break;
+    case kGxfTexTlut:
+        // Keep guest GXTexObj coherent for later GXLoadTexObj from memory.
+        try {
+            Memory::Write32(oa + 0x18, a);
+        } catch (...) {
+        }
+        break;
+    case kGxfTexFilter:
+        try {
+            uint32_t word0 = Memory::Read32(oa + 0x00);
+            uint32_t magBit = (b == 1) ? 0x10 : 0;
+            word0 = (word0 & 0xFFFFFFEF) | magBit;
+            uint32_t minBits = (kGxToHwMinFilter[a & 7] & 7) << 5;
+            word0 = (word0 & 0xFFFFFF0F) | magBit | minBits;
+            Memory::Write32(oa + 0x00, word0);
+        } catch (...) {}
+        break;
+    case kGxfTexLodBias:
+        try {
+            uint32_t word0 = Memory::Read32(oa + 0x00);
+            int8_t biasScaled = static_cast<int8_t>(clampedBias * 32.0f);
+            word0 = (word0 & 0xFFFE01FF) | ((static_cast<uint32_t>(static_cast<uint8_t>(biasScaled)) & 0xFF) << 9);
+            Memory::Write32(oa + 0x00, word0);
+        } catch (...) {}
+        break;
+    default:
+        // The RVL SDK stores this opaque guest pointer verbatim at GXTexObj + 0x10.
+        WriteGuest32(oa + 0x10, a, "GXInitTexObjUserData");
+        break;
+    }
+}
+
+static void GxfTexLoadTexObj(uint32_t oa, uint32_t tid) {
+    if (tid >= g_boundTexMaps.size()) {
+        static uint32_t s_invalidTidLogCount = 0;
+        if (s_invalidTidLogCount < 128) {
+            RT_LOGF(RT_TAG_GX, "GXLoadTexObj: invalid tex map id %u (oa=0x%08X)\n", tid, oa);
+            ++s_invalidTidLogCount;
+        }
+        return;
+    }
+    const bool intercept = aurora_gxf_intercept() != 0;
+    GxfTexLoadRec r{oa, tid, 0u, 0u, {0, 0, 0, 0}};
+    GxfTexDecision decision = GxfTexDecision::Unknown;
+    if (intercept && GxfTexReadShadow(oa, r.shadow)) [[likely]] {
+        decision = GxfTexDecideLoad(oa, r.shadow);
+        if (decision == GxfTexDecision::Unknown) {
+            Gxf4Count(kGxf4TexUnknown);
+        }
+    }
+    if (decision == GxfTexDecision::Unknown) [[unlikely]] {
+        bool reached = false;
+        GxfTexRunHere(oa, intercept, [&] { reached = GxLoadTexObjBody(oa, tid); });
+        if (reached) {
+            GxfTexLoadDoneStores();
+        }
+        return;
+    }
+    r.accept = decision == GxfTexDecision::Accept ? 1u : 0u;
+    aurora_gxf_post(&GxfTexLoadExec, &r, sizeof(r), nullptr, 0, 0);
+    Gxf4Count(kGxf4TexRecords);
+    if (r.accept != 0) {
+        Gxf4Count(kGxf4TexStores);
+        GxfTexLoadDoneStores();
+    } else {
+        Gxf4Count(kGxf4TexRejects);
+    }
+}
