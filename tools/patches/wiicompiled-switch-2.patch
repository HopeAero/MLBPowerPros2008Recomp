+// Matrix XF payloads arrive as scalar FIFO floats. While the packet is incomplete,
+// the old parser only appended four bytes and reread the same header before returning.
+// Leave the final word to that parser so dispatch, callbacks and consumption stay identical.
+static inline bool TryIncompleteXfFifoWord(u32 value) {
+    auto& g=GXP_STATE;
+    if (g.inBegin || g.fifoByteCount<5u || g.fifoReadOffset>g.fifoBytes.size() ||
+        g.fifoByteCount>g.fifoBytes.size()-g.fifoReadOffset ||
+        g.fifoBytes.size()-g.fifoReadOffset-g.fifoByteCount<4u) return false;
+    uint8_t* data=g.fifoBytes.data()+g.fifoReadOffset;
+    if ((data[0]&GX_OPCODE_MASK_CMD)!=GX_LOAD_XF_REG_CMD) return false;
+    const uint32_t packetBytes=5u+(static_cast<uint32_t>(ReadBE16(data+1))+1u)*4u;
+    if (g.fifoByteCount+4u>=packetBytes) return false;
+    BigEndian::Write32(data+g.fifoByteCount,value);
+    g.fifoByteCount+=4u;
+    GxBatch::CountHit(GxBatch::XfWords);
+    return true;
+}
