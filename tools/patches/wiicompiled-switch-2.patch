+    f4 = vaddq_f32(f4, f5);
+    r.out[2] = f8;
+    f9 = vsubq_f32(f3, f4);
+    f0 = vaddq_f32(f3, f4);
+    r.out[3] = f9;
+    f1 = vsubq_f32(f2, f5);
+    r.out[4] = f0;
+    r.out[5] = f1;
