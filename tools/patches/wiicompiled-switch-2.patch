diff --git a/runtime/src/hle/gx/gx_offload_display_list.h b/runtime/src/hle/gx/gx_offload_display_list.h
new file mode 100644
index 0000000..4511b54
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_display_list.h
@@ -0,0 +1,47 @@
+#pragma once
+
+template <auto Function> struct DisplayListCommand {
+    u32 nbytes;
+    uint8_t bytes[GxOffloadQueue::kMaxPayloadBytes - sizeof(u32)];
+    static void Execute(const void* payload) {
+        const auto& command = *static_cast<const DisplayListCommand*>(payload);
+        Function(command.bytes, command.nbytes);
+    }
+};
+
+template <> struct Dispatch<&::GXCallDisplayList> {
+    template <auto Function = &::GXCallDisplayList>
+    static void Invoke(const void* list, u32 nbytes) {
+        if (!Intercept() || Synchronous()) return Function(list, nbytes);
+        if (list == nullptr || nbytes == 0 ||
+            nbytes > GxOffloadQueue::kMaxPayloadBytes - sizeof(u32)) {
+            SynchronousScope scope(__PRETTY_FUNCTION__);
+            return Function(list, nbytes);
+        }
+        using Command = DisplayListCommand<Function>;
+        static_assert(sizeof(Command) == GxOffloadQueue::kMaxPayloadBytes);
+        Command command;
+        command.nbytes = nbytes;
+        std::memcpy(command.bytes, list, nbytes);
+        queue.Submit(&Command::Execute, &command, sizeof(u32) + nbytes);
+    }
+};
+
+template <auto Function> struct DisplayListRefCommand {
+    const void* list;
+    u32 nbytes;
+    static void Execute(const void* bytes) {
+        const auto& command = *static_cast<const DisplayListRefCommand*>(bytes);
+        Function(command.list, command.nbytes);
+    }
+};
+
+template <> struct Dispatch<&::GXCallDisplayListRef> {
+    template <auto Function = &::GXCallDisplayListRef>
+    static void Invoke(const void* list, u32 nbytes) {
+        if (!Intercept() || Synchronous()) return Function(list, nbytes);
+        // G6 keeps reference streams alive until the completed end-of-frame drain.
+        using Command = DisplayListRefCommand<Function>;
+        queue.Submit(&Command::Execute, Command{list, nbytes});
+    }
+};
diff --git a/runtime/src/hle/gx/gx_offload_fence_profile.h b/runtime/src/hle/gx/gx_offload_fence_profile.h
new file mode 100644
index 0000000..f1a84bb
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_fence_profile.h
@@ -0,0 +1,281 @@
+#pragma once
+
+// Opt-in accounting of producer-side GX offload fences (WIICOMPILED_GX_HLE_FENCE_PROFILE=1).
+//
+// A "fence" is a SynchronousScope entered at depth 0 (or an explicit Fence()): the producer
+// publishes the queue watermark and waits until the worker has completed everything. This file
+// counts them per entry point (the Dispatch policy that forced the scope, or the Aurora
+// HleProducerScope site) and the time the producer spent inside Queue::FlushAll, using the
+// system tick (no clock_gettime). Everything is producer-thread-only, allocation-free and a
+// single predictable branch when the switch is off.
+//
+// Report: one summary line plus one line per entry point, every ~5 s, on stderr:
+//   [GX-HLE-FENCE-PROFILE] window ...
+//   [GX-HLE-FENCE-PROFILE]   site=<name> ...
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#if defined(__SWITCH__)
+#include <switch.h>
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+#include <chrono>
+#endif
+
+namespace hle::gx::offload::fence_profile {
+
+inline uint64_t Now() noexcept {
+#if defined(__SWITCH__)
+    return armGetSystemTick();
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+#else
+    return 0;
+#endif
+}
+
+inline uint64_t TicksToNs(uint64_t ticks) noexcept {
+#if defined(__SWITCH__)
+    return armTicksToNs(ticks);
+#else
+    return ticks; // test builds count nanoseconds directly
+#endif
+}
+
+inline bool Enabled() noexcept {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("WIICOMPILED_GX_HLE_FENCE_PROFILE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
+
+struct Site {
+    const char* name = nullptr;
+    bool frame = false;        // Aurora end_frame: one entry per presented frame
+    uint64_t entries = 0;      // every scope entry attributed to this site
+    uint64_t fences = 0;       // entries that really drained (depth 0)
+    uint64_t blocking = 0;    // fences that found work outstanding
+    uint64_t pending = 0;      // sum of outstanding slots at blocking fences
+    uint64_t ticks = 0;        // time in FlushAll
+    uint64_t maxTicks = 0;
+};
+
+constexpr size_t kMaxSites = 192;
+
+struct State {
+    Site sites[kMaxSites];
+    size_t used = 0;
+    uint64_t otherEntries = 0, otherFences = 0, otherBlocking = 0, otherTicks = 0;
+    uint64_t windowStart = 0;
+    uint64_t serviceCalls = 0, serviceTicks = 0;
+    // Queue-side waits (producer thread): Flush left the spin window and slept; Submit found the
+    // ring full and slept. Times in nanoseconds.
+    uint64_t flushSleeps = 0, flushSleepNs = 0, submitFullWaits = 0, submitFullNs = 0;
+};
+
+inline State& GetState() noexcept {
+    static State state;
+    return state;
+}
+
+// Resolve a site by its (static) name pointer; identical pointers share an entry.
+inline Site* Find(State& state, const char* name) noexcept {
+    for (size_t i = 0; i < state.used; ++i)
+        if (state.sites[i].name == name) return &state.sites[i];
+    if (state.used == kMaxSites) return nullptr;
+    Site& site = state.sites[state.used++];
+    site.name = name;
+    site.frame = name != nullptr && std::strcmp(name, "aurora::end_frame") == 0;
+    return &site;
+}
+
+// GCC/Clang __PRETTY_FUNCTION__ of Dispatch<Policy>::Invoke names the GX entry point either as
+// "auto Policy = GXFoo]" (primary template) or "Dispatch<GXFoo>::Invoke" (specializations).
+// Anything else (the Aurora HleProducerScope names) is printed as is.
+inline void DisplayName(const char* raw, char* out, size_t size) noexcept {
+    if (size == 0) return;
+    out[0] = '\0';
+    if (raw == nullptr) {
+        std::snprintf(out, size, "(unnamed)");
+        return;
+    }
+    const char* begin = nullptr;
+    const char* end = nullptr;
+    if (const char* policy = std::strstr(raw, "Policy = ")) {
+        begin = policy + 9;
+        end = begin;
+        while (*end != '\0' && *end != ']' && *end != ';') ++end;
+    } else if (const char* dispatch = std::strstr(raw, "Dispatch<")) {
+        begin = dispatch + 9;
+        end = begin;
+        int depth = 1;
+        while (*end != '\0') {
+            if (*end == '<') ++depth;
+            else if (*end == '>' && --depth == 0) break;
+            ++end;
+        }
+    }
+    if (begin == nullptr) {
+        std::snprintf(out, size, "%s", raw);
+        return;
+    }
+    // Specializations may print "(void (*)(...))GXFoo": keep the trailing identifier chain.
+    const char* last = end;
+    while (last > begin && (last[-1] == '_' || (last[-1] >= '0' && last[-1] <= '9') ||
+                            (last[-1] >= 'A' && last[-1] <= 'Z') || (last[-1] >= 'a' && last[-1] <= 'z') ||
+                            last[-1] == ':'))
+        --last;
+    if (last == end) last = begin; // no identifier at the end: print the whole argument
+    std::snprintf(out, size, "%.*s", static_cast<int>(end - last), last);
+}
+
+inline void Report(State& state, uint64_t now) noexcept {
+    const uint64_t windowNs = TicksToNs(now - state.windowStart);
+    uint64_t frames = 0, entries = state.otherEntries, fences = state.otherFences,
+             blocking = state.otherBlocking, ticks = state.otherTicks;
+    for (size_t i = 0; i < state.used; ++i) {
+        const Site& s = state.sites[i];
+        if (s.frame) frames += s.entries;
+        entries += s.entries;
+        fences += s.fences;
+        blocking += s.blocking;
+        ticks += s.ticks;
+    }
+    const double perFrame = frames != 0 ? 1.0 / static_cast<double>(frames) : 0.0;
+    const double waitMs = static_cast<double>(TicksToNs(ticks)) / 1e6;
+    std::fprintf(stderr,
+                 "[GX-HLE-FENCE-PROFILE] window=%.2fs frames=%llu scopes=%llu fences=%llu blocking=%llu "
+                 "flush_wait_ms=%.2f | per_frame fences=%.2f blocking=%.2f flush_wait_ms=%.3f | "
+                 "service_calls=%llu service_ms=%.2f | flush_sleeps=%llu flush_sleep_ms=%.2f "
+                 "submit_full_waits=%llu submit_full_ms=%.2f\n",
+                 static_cast<double>(windowNs) / 1e9, static_cast<unsigned long long>(frames),
+                 static_cast<unsigned long long>(entries), static_cast<unsigned long long>(fences),
+                 static_cast<unsigned long long>(blocking), waitMs, static_cast<double>(fences) * perFrame,
+                 static_cast<double>(blocking) * perFrame, waitMs * perFrame,
+                 static_cast<unsigned long long>(state.serviceCalls),
+                 static_cast<double>(TicksToNs(state.serviceTicks)) / 1e6,
+                 static_cast<unsigned long long>(state.flushSleeps),
+                 static_cast<double>(state.flushSleepNs) / 1e6,
+                 static_cast<unsigned long long>(state.submitFullWaits),
+                 static_cast<double>(state.submitFullNs) / 1e6);
+
+    // Entry points ordered by time spent waiting, then by fence count; unused ones are skipped.
+    size_t order[kMaxSites];
+    size_t count = 0;
+    for (size_t i = 0; i < state.used; ++i)
+        if (state.sites[i].entries != 0) order[count++] = i;
+    for (size_t i = 1; i < count; ++i) {
+        const size_t key = order[i];
+        size_t j = i;
+        while (j > 0) {
+            const Site& a = state.sites[order[j - 1]];
+            const Site& b = state.sites[key];
+            if (a.ticks > b.ticks || (a.ticks == b.ticks && a.fences >= b.fences)) break;
+            order[j] = order[j - 1];
+            --j;
+        }
+        order[j] = key;
+    }
+    const size_t shown = count < 24 ? count : 24;
+    for (size_t k = 0; k < shown; ++k) {
+        const Site& s = state.sites[order[k]];
+        char name[96];
+        DisplayName(s.name, name, sizeof(name));
+        const double avgPending =
+            s.blocking != 0 ? static_cast<double>(s.pending) / static_cast<double>(s.blocking) : 0.0;
+        const double siteMs = static_cast<double>(TicksToNs(s.ticks)) / 1e6;
+        const double avgUs = s.fences != 0 ? siteMs * 1000.0 / static_cast<double>(s.fences) : 0.0;
+        std::fprintf(stderr,
+                     "[GX-HLE-FENCE-PROFILE]   site=%s scopes=%llu fences=%llu blocking=%llu "
+                     "avg_pending=%.1f wait_ms=%.2f avg_us=%.2f max_us=%.1f | per_frame fences=%.2f wait_ms=%.3f\n",
+                     name, static_cast<unsigned long long>(s.entries),
+                     static_cast<unsigned long long>(s.fences), static_cast<unsigned long long>(s.blocking),
+                     avgPending, siteMs, avgUs, static_cast<double>(TicksToNs(s.maxTicks)) / 1e3,
+                     static_cast<double>(s.fences) * perFrame, siteMs * perFrame);
+    }
+    if (count > shown || state.otherEntries != 0)
+        std::fprintf(stderr, "[GX-HLE-FENCE-PROFILE]   (%zu more sites, %llu overflow scopes)\n",
+                     count - shown, static_cast<unsigned long long>(state.otherEntries));
+    std::fflush(stderr);
+}
+
+// Clears the window counters but keeps the site table (names stay registered).
+inline void ResetWindow(State& state, uint64_t now) noexcept {
+    for (size_t i = 0; i < state.used; ++i) {
+        Site& s = state.sites[i];
+        s.entries = s.fences = s.blocking = s.pending = s.ticks = s.maxTicks = 0;
+    }
+    state.otherEntries = state.otherFences = state.otherBlocking = state.otherTicks = 0;
+    state.serviceCalls = state.serviceTicks = 0;
+    state.flushSleeps = state.flushSleepNs = state.submitFullWaits = state.submitFullNs = 0;
+    state.windowStart = now;
+}
+
+constexpr uint64_t kReportIntervalNs = 5'000'000'000ull;
+
+// Window length; a variable only so the host test can shorten it.
+inline uint64_t& ReportIntervalNs() noexcept {
+    static uint64_t interval = kReportIntervalNs;
+    return interval;
+}
+
+inline void MaybeReport(State& state, uint64_t now) noexcept {
+    if (state.windowStart == 0) {
+        state.windowStart = now;
+        return;
+    }
+    if (TicksToNs(now - state.windowStart) < ReportIntervalNs()) return;
+    Report(state, now);
+    ResetWindow(state, now);
+}
+
+// A scope entered while another one is already open: no drain, counted for context only.
+inline void NoteNested(const char* site) noexcept {
+    State& state = GetState();
+    if (Site* s = Find(state, site)) ++s->entries;
+    else ++state.otherEntries;
+}
+
+// A real drain at depth 0. `pending` is the number of slots staged but not yet completed when the
+// fence started; `ticks` the time spent in Queue::FlushAll.
+inline void NoteFence(const char* site, uint64_t pending, uint64_t ticks, uint64_t now) noexcept {
+    State& state = GetState();
+    if (Site* s = Find(state, site)) {
+        ++s->entries;
+        ++s->fences;
+        s->ticks += ticks;
+        if (ticks > s->maxTicks) s->maxTicks = ticks;
+        if (pending != 0) {
+            ++s->blocking;
+            s->pending += pending;
+        }
+    } else {
+        ++state.otherEntries;
+        ++state.otherFences;
+        state.otherTicks += ticks;
+        if (pending != 0) ++state.otherBlocking;
+    }
+    MaybeReport(state, now);
+}
+
+inline void AddQueueWait(uint64_t flushSleeps, uint64_t flushSleepNs, uint64_t submitFullWaits,
+                         uint64_t submitFullNs) noexcept {
+    State& state = GetState();
+    state.flushSleeps += flushSleeps;
+    state.flushSleepNs += flushSleepNs;
+    state.submitFullWaits += submitFullWaits;
+    state.submitFullNs += submitFullNs;
+}
+
+inline void NoteService(uint64_t ticks) noexcept {
+    State& state = GetState();
+    ++state.serviceCalls;
+    state.serviceTicks += ticks;
+}
+
+} // namespace hle::gx::offload::fence_profile
