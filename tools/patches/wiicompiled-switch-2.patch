+// that function's whole prologue/epilogue (callee-saved registers, the lambdas' frame) for every
+// word of every sprite and matrix the game writes by hand. A word it does not take is handled by
+// HleFifoWriteGeneral exactly as before (the checks here are the ones in front of that case there).
+void HleFifoWrite(u32 val, uint32_t sizeBytes) {
+    if (GXP_STREAM_WORD(val, sizeBytes)) [[unlikely]] {
+        return;
+    }
+    if (GxVtxF32::kEnabled && (sizeBytes == 4 || sizeBytes == 0) && GXP_STATE.inBegin && !GXP_DL_ACTIVE() &&
