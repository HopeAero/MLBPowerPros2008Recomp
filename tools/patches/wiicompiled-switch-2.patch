+void OsHleInternal::PublishSleepDueTick(std::chrono::steady_clock::rep deadline)
+{
+    if (gComputePreemptState != kComputePreemptOn) {
+        return;
+    }
+    int64_t tick = INT64_MAX;
+    if (deadline != std::numeric_limits<std::chrono::steady_clock::rep>::max()) {
+        const int64_t remainingNs = static_cast<int64_t>(
+            std::chrono::nanoseconds(std::chrono::steady_clock::duration(
+                                         deadline - std::chrono::steady_clock::now().time_since_epoch().count()))
+                .count());
+        tick = SwitchSystemTick() + remainingNs * 12 / 625;  // ns -> 19.2 MHz ticks
+    }
+    __atomic_store_n(&gComputePreemptDueTick, tick, __ATOMIC_RELAXED);
+}
