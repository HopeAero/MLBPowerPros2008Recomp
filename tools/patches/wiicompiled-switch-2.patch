+        return;
+    }
+    // Incomplete matrix payloads only append a word; avoid the general parser's stack frame.
+    if ((sizeBytes == 4 || sizeBytes == 0) && !GXP_STATE.inBegin && !GXP_DL_ACTIVE() &&
+        GxBatch::FifoEnabled() && TryIncompleteXfFifoWord(val)) {
+        return;
+    }
+    HleFifoWriteGeneral(val, sizeBytes);
+}
