diff --git a/runtime/src/platform/switch/switch_crash.cpp b/runtime/src/platform/switch/switch_crash.cpp
new file mode 100644
index 0000000..a133027
--- /dev/null
+++ b/runtime/src/platform/switch/switch_crash.cpp
@@ -0,0 +1,46 @@
+// A CPU exception on Horizon (data abort, undefined instruction...): libnx calls this handler instead
+// of letting the system close the program with a bare "an error has occurred". It prints the fault
+// to stdout (nxlink's console on the PC, else the log file) and exits. PC and LR are printed against
+// the address of this function, so `nm WiiCompiled.elf` turns them into names.
+#if defined(__SWITCH__)
+#include <cstdio>
+#include <switch.h>
+
+#include "guest_flat_memory.h"
+
+extern "C" {
+alignas(16) u8 __nx_exception_stack[0x4000];
+u64 __nx_exception_stack_size = sizeof(__nx_exception_stack);
+u32 __nx_exception_ignoredebug = 1;
+
+void __libnx_exception_handler(ThreadExceptionDump* ctx) {
+    const auto anchor = reinterpret_cast<u64>(&__libnx_exception_handler);
+    std::printf("\n[crash] CPU exception 0x%x esr=0x%x far=0x%lx\n", ctx->error_desc, ctx->esr, ctx->far.x);
+    // In the flat view, far - base is the guest address the translated code touched.
+    if (const auto flat = reinterpret_cast<u64>(GuestFlat::g_flatBase); flat != 0) {
+        std::printf("[crash] far - flat base = 0x%lx%s (flat base 0x%lx)\n", ctx->far.x - flat,
+                    ctx->far.x - flat < GuestFlat::kGuestSpaceSize ? " (guest address)" : "", flat);
+    }
+    std::printf("[crash] pc=0x%lx lr=0x%lx sp=0x%lx fp=0x%lx (__libnx_exception_handler at 0x%lx)\n",
+                ctx->pc.x, ctx->lr.x, ctx->sp.x, ctx->fp.x, anchor);
+    for (int i = 0; i < 29; ++i) {
+        std::printf("[crash] x%-2d=0x%016lx%s", i, ctx->cpu_gprs[i].x, i % 4 == 3 ? "\n" : "  ");
+    }
+    // Return addresses on the stack: words that point into the program's code (within 256 MB of here).
+    // ponytail: a scan, not an unwinder; enough to name the callers.
+    std::printf("\n[crash] stack:");
+    const auto* stack = reinterpret_cast<const u64*>(ctx->sp.x);
+    for (int i = 0, shown = 0; i < 256 && shown < 24; ++i) {
+        const u64 word = stack[i];
+        if (word + 0x10000000 > anchor && word < anchor + 0x10000000) {
+            std::printf(" 0x%lx", word);
+            ++shown;
+        }
+    }
+    std::printf("\n");
+    std::fflush(stdout);
+    svcSleepThread(500'000'000);  // let nxlink's socket send it
+    svcExitProcess();
+}
+}
+#endif
diff --git a/runtime/src/platform/switch/switch_io.cpp b/runtime/src/platform/switch/switch_io.cpp
new file mode 100644
index 0000000..f9801bc
--- /dev/null
+++ b/runtime/src/platform/switch/switch_io.cpp
@@ -0,0 +1,389 @@
+// Two main-thread costs on Horizon, linked in with -Wl,--wrap (PublicProducts.cmake):
+//
+// 1. WIICOMPILED_SWITCH_IO_LOG=1: every SD card operation goes through libnx's fs calls (fsdev's
+//    open/read/write/stat/close, romfs, SQLite, the shader caches). Each is an IPC to the fs
+//    service, a millisecond or more on the SD card. The wrappers count them per thread, time the
+//    main thread's (core 0, the game's fibers) and name their files; every 30 s a thread of its
+//    own prints the totals and the costliest paths to stderr. Off: one load and a getenv a second.
+// 2. SDL's Switch keyboard poll (SDL_switchkeyboard.c) calls SDL_SendKeyboardKey for each of the
+//    231 scancodes on every SDL_PumpEvents, with or without a keyboard. With no key down on the
+//    keyboard and none down in SDL's state, every one of those calls returns without doing anything
+//    (a key-up for a key that is up), so the poll is skipped then. A key down, or one SDL still
+//    holds down, runs it as before: the same events (repeats included) in the same order.
+#if defined(__SWITCH__)
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <SDL3/SDL_keyboard.h>
+#include <switch.h>
+
+namespace {
+enum Op { kOpen, kRead, kWrite, kFlush, kClose, kSize, kStat, kCreate, kDelete, kRename, kDir, kCommit, kOps };
+const char* const kOpNames[kOps] = {"open",   "read",   "write",  "flush", "close", "size",
+                                    "stat",   "create", "delete", "rename", "dir",  "commit"};
+
+struct Totals {
+    u64 count[kOps] = {};
+    u64 ns[kOps] = {};
+    u64 bytes = 0;
+    u64 Count() const { u64 n = 0; for (u64 c : count) n += c; return n; }
+    u64 Ns() const { u64 n = 0; for (u64 t : ns) n += t; return n; }
+};
+struct PathStats {
+    Totals totals;
+    u64 maxNs = 0;
+};
+
+// Never destroyed: threads may still reach the fs calls while the process exits.
+struct Log {
+    std::mutex mutex;
+    std::unordered_map<u64, std::string> names;  // open FsFile / FsDir (session, object id) -> path
+    std::unordered_map<std::string, PathStats> mainPaths;
+    Totals main, other;
+    u64 mainMaxNs = 0;
+    std::string mainMaxWhat;
+    u64 windowStart = 0;
+};
+Log& L() {
+    static Log* log = new Log;
+    return *log;
+}
+
+// 0: before this file's static initialisation (libnx mounts the SD card and romfs earlier), 1: off
+// so far (the variable comes from nxlink's arguments, which main() turns into the environment), 2: on.
+std::atomic<int> g_state{0};
+struct MarkInitialized {
+    MarkInitialized() { g_state.store(1, std::memory_order_release); }
+} g_markInitialized;
+
+// S8 (switch phase 54): file reads and opens counted and timed, main thread and other threads, while
+// WIICOMPILED_SWITCH_SPIKES is set (the profiler's start); the spike dumps take each frame's share.
+std::atomic<bool> g_spikeIo{false};
+std::atomic<u64> g_spikeIoTotals[4];  // main count, main ticks, others count, others ticks
+void SpikeIoNote(u64 ticks) {
+    const int i = threadGetCurHandle() == envGetMainThreadHandle() ? 0 : 2;
+    g_spikeIoTotals[i].fetch_add(1, std::memory_order_relaxed);
+    g_spikeIoTotals[i + 1].fetch_add(ticks, std::memory_order_relaxed);
+}
+
+void Report() {
+    Totals main, other;
+    std::vector<std::pair<std::string, PathStats>> paths;
+    u64 maxNs = 0;
+    std::string maxWhat;
+    u64 start = 0;
+    const u64 now = armGetSystemTick();
+    {
+        const std::lock_guard<std::mutex> lock(L().mutex);
+        main = std::exchange(L().main, {});
+        other = std::exchange(L().other, {});
+        paths.assign(L().mainPaths.begin(), L().mainPaths.end());
+        L().mainPaths.clear();
+        maxNs = std::exchange(L().mainMaxNs, 0);
+        maxWhat = std::move(L().mainMaxWhat);
+        L().mainMaxWhat.clear();
+        start = std::exchange(L().windowStart, now);
+    }
+    char ops[512];
+    int o = 0;
+    for (int i = 0; i < kOps; ++i) {
+        if (main.count[i] && o < int(sizeof ops)) {
+            o += std::snprintf(ops + o, sizeof ops - size_t(o), "%s%s %llu %.1f ms", o ? ", " : "", kOpNames[i],
+                               (unsigned long long)main.count[i], double(main.ns[i]) / 1e6);
+        }
+    }
+    std::fprintf(stderr,
+                 "[io] %.1f s: main thread %llu file ops, %.1f ms (%s), %.1f KiB; longest %.2f ms%s%s; other "
+                 "threads %llu ops, %.1f ms\n",
+                 double(armTicksToNs(now - start)) / 1e9, (unsigned long long)main.Count(), double(main.Ns()) / 1e6,
+                 o ? ops : "none", double(main.bytes) / 1024.0, double(maxNs) / 1e6, maxWhat.empty() ? "" : " ",
+                 maxWhat.c_str(), (unsigned long long)other.Count(), double(other.Ns()) / 1e6);
+    std::sort(paths.begin(), paths.end(),
+              [](const auto& a, const auto& b) { return a.second.totals.Ns() > b.second.totals.Ns(); });
+    for (size_t p = 0; p < paths.size() && p < 8; ++p) {
+        const Totals& t = paths[p].second.totals;
+        o = 0;
+        for (int i = 0; i < kOps; ++i) {
+            if (t.count[i] && o < int(sizeof ops)) {
+                o += std::snprintf(ops + o, sizeof ops - size_t(o), "%s%s %llu", o ? ", " : "", kOpNames[i],
+                                   (unsigned long long)t.count[i]);
+            }
+        }
+        std::fprintf(stderr, "[io]   main %8.2f ms (max %.2f) %5llu ops (%s) %8.1f KiB  %s\n", double(t.Ns()) / 1e6,
+                     double(paths[p].second.maxNs) / 1e6, (unsigned long long)t.Count(), ops, double(t.bytes) / 1024.0,
+                     paths[p].first.c_str());
+    }
+}
+
+void StartReporter() {
+    {
+        const std::lock_guard<std::mutex> lock(L().mutex);
+        L().windowStart = armGetSystemTick();
+    }
+    std::fprintf(stderr, "[io] WIICOMPILED_SWITCH_IO_LOG=1: SD card operations every 30 s (main thread by file)\n");
+    // a libnx thread: std::thread::detach throws on Horizon (pthread_detach is unsupported) and,
+    // without exceptions, terminated the NRO at the benchmark's start
+    static Thread reporter;
+    const auto loop = [](void*) {
+        for (;;) {
+            svcSleepThread(30'000'000'000LL);
+            Report();  // prints without the lock: its own writes (stderr on the SD card) come back here
+        }
+    };
+    if (R_FAILED(threadCreate(&reporter, loop, nullptr, nullptr, 0x10000, 0x3B, 2)) ||
+        R_FAILED(threadStart(&reporter))) {
+        std::fprintf(stderr, "[io] could not start the reporter thread\n");
+    }
+}
+
+// Turned on by SwitchIoLogStart (the match benchmark's start), never from inside an fs call: starting
+// the reporter (getenv, a thread, stderr) there crashed the NRO at boot.
+bool Enabled() { return g_state.load(std::memory_order_acquire) == 2; }
+} // namespace
+
+extern "C" void SwitchIoLogStart() {
+    const char* value = std::getenv("WIICOMPILED_SWITCH_IO_LOG");
+    if (value == nullptr || std::strcmp(value, "1") != 0) return;
+    int expected = 1;
+    if (g_state.compare_exchange_strong(expected, 2)) StartReporter();
+}
+
+extern "C" void SwitchSpikeIoEnable() { g_spikeIo.store(true, std::memory_order_relaxed); }
+extern "C" void SwitchSpikeIoTotals(u64 out[4]) {
+    for (int i = 0; i < 4; ++i) out[i] = g_spikeIoTotals[i].load(std::memory_order_relaxed);
+}
+
+namespace {
+
+u64 Key(const Service& s) { return (u64(s.session) << 32) | s.object_id; }
+
+void Record(Op op, const char* path, u64 key, u64 ticks, u64 bytes) {
+    const u64 ns = armTicksToNs(ticks);
+    const bool main = threadGetCurHandle() == envGetMainThreadHandle();
+    const std::lock_guard<std::mutex> lock(L().mutex);
+    Totals& totals = main ? L().main : L().other;
+    ++totals.count[op];
+    totals.ns[op] += ns;
+    totals.bytes += bytes;
+    if (!main) return;
+    std::string name;
+    if (path != nullptr) {
+        name = path;
+    } else if (const auto it = L().names.find(key); it != L().names.end()) {
+        name = it->second;
+    } else {
+        name = "(opened before the log started)";
+    }
+    PathStats& stats = L().mainPaths[name];
+    ++stats.totals.count[op];
+    stats.totals.ns[op] += ns;
+    stats.totals.bytes += bytes;
+    stats.maxNs = std::max(stats.maxNs, ns);
+    if (ns > L().mainMaxNs) {
+        L().mainMaxNs = ns;
+        L().mainMaxWhat = std::string(kOpNames[op]) + " " + name;
+    }
+}
+
+void Name(u64 key, const char* path) {
+    const std::lock_guard<std::mutex> lock(L().mutex);
+    L().names[key] = path;
+}
+
+void Forget(u64 key) {
+    const std::lock_guard<std::mutex> lock(L().mutex);
+    L().names.erase(key);
+}
+} // namespace
