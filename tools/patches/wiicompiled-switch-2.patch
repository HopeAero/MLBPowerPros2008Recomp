+// MLB Power Pros 2008 (RL8E54): native leaves for two MSL routines the match spends ~8% of the
+// Switch main thread in (profile 1).
+//
+// __ieee754_sqrt (0x80126AE8, reached through sqrt at 0x80128FD0) is fdlibm's bit-by-bit loop:
+// 54 iterations of integer work plus its frame stores. Its rounding test compares the constant
+// 1.0 (r2-28672) with itself, so it always rounds to nearest, whatever FPSCR[RN] says, and fdlibm
+// rounded to nearest is the correctly rounded root for every positive input, subnormals
+// included: fsqrt in round-to-nearest gives the same bits.
+//
+// __fill_mem (0x80006508, under memset at 0x800065BC) stores byte by byte up to a word boundary,
+// then words, then bytes. All of its stores to plain RAM land as one memset; a range touching
+// anything else keeps the original store sequence.
+//
+// Both leave the result, every guest store and the FP registers as the originals do; the scratch
+// integer registers (r0, r3-r12), cr0/cr1 and XER[CA] keep their entry values (volatile in the
+// EABI: nothing reads them after the call). The registered bodies touch the CpuContext only
+// through constant indexes and pass it nowhere, which gives the translator a precise contract.
+#if defined(__SWITCH__)
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+#include "abi_bridge.h"
+#include "compute_preempt.h"
+#include "memory.h"
+
+namespace mlb_msl {
+
+constexpr uint64_t kFraction = 0x000FFFFFFFFFFFFFull, kImplicit = 1ull << 52;
+
+uint64_t Bits(double value) {
+    uint64_t bits;
+    std::memcpy(&bits, &value, sizeof bits);
+    return bits;
+}
+
+double FromBits(uint64_t bits) {
+    double value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+// One instruction each: the runtime builds with -ffast-math, which may contract, reassociate or
+// approximate host FP; the translated code they stand for builds with -fno-fast-math.
+double Mul(double a, double b) {
+    double result;
+    __asm__("fmul %d0, %d1, %d2" : "=w"(result) : "w"(a), "w"(b));
+    return result;
+}
+
+double Add(double a, double b) {
+    double result;
+    __asm__("fadd %d0, %d1, %d2" : "=w"(result) : "w"(a), "w"(b));
+    return result;
+}
+
+double Widen(float value) {
+    double result;
+    __asm__("fcvt %d0, %s1" : "=w"(result) : "w"(value));
+    return result;
+}
+
+double ToDouble(uint64_t value) {  // exact below 2^53
+    double result;
+    __asm__("ucvtf %d0, %x1" : "=w"(result) : "r"(value));
+    return result;
+}
+
+// fsqrt rounded to nearest. The runtime never changes FPCR.RMode (only FZ), so the second branch
+// is a guarantee, not a path.
+double SqrtNearest(double value) {
+    uint64_t fpcr;
+    __asm__ __volatile__("mrs %0, fpcr" : "=r"(fpcr));
+    double result;
+    if ((fpcr & (3ull << 22)) == 0) [[likely]] {
+        __asm__("fsqrt %d0, %d1" : "=w"(result) : "w"(value));
+        return result;
+    }
+    __asm__ __volatile__("msr fpcr, %1\n\tfsqrt %d0, %d2\n\tmsr fpcr, %3"
+                         : "=&w"(result) : "r"(fpcr & ~(3ull << 22)), "w"(value), "r"(fpcr) : "memory");
+    return result;
+}
+
+// The correctly rounded root of a positive, finite, nonzero double, and whether it is exact.
+// fdlibm's remainder is zero exactly then: an odd root of 54 significant bits squares to more
+// than the 53 a double holds.
+uint64_t PositiveSqrt(uint64_t x, bool& exact) {
+    uint64_t root, mantissa;
+    int exponent;  // x = mantissa * 2^exponent
+    if ((x >> 52) == 0) {
+        // Subnormal x = m * 2^-1074: sqrt(m) * 2^-537, m converted exactly and the scale applied to
+        // the exponent field (the root stays normal), so FPCR.FZ never meets a subnormal.
+        root = Bits(SqrtNearest(ToDouble(x))) - (537ull << 52);
+        mantissa = x;
+        exponent = -1074;
+    } else {
+        root = Bits(SqrtNearest(FromBits(x)));
+        mantissa = (x & kFraction) | kImplicit;
+        exponent = static_cast<int>(x >> 52) - 1075;
+    }
+    // root^2 == x  <=>  rootMantissa^2 == mantissa << shift
+    const uint64_t rootMantissa = (root & kFraction) | kImplicit;
+    const int shift = exponent - 2 * (static_cast<int>(root >> 52) - 1075);
+    const unsigned __int128 square = static_cast<unsigned __int128>(rootMantissa) * rootMantissa;
+    exact = shift >= 0 && shift < 128 && (square >> shift) == mantissa &&
+            (square & ((static_cast<unsigned __int128>(1) << shift) - 1u)) == 0;
+    return root;
+}
+
+// Host bytes for guest [address, address + length), inside one 1 MiB page, when every
+// __fill_mem store there takes the plain-RAM path; nullptr otherwise.
+uint8_t* PlainRam(uint32_t address, uint32_t length) {
+    if (uint8_t* host = MemoryInline::ResolveRangeHost(address, 0, length, false, true)) return host;
+    if (!GuestFlat::RequiresCheckedAccess()) return nullptr;
+    // Checked access (Horizon): Memory::Write8/Write32 store through the page's writable bias when
+    // it has one (TryWriteGuestScalar; the word stores are aligned, so none crosses the page).
+    const uintptr_t bias = MemoryInline::g_fullWritablePageBias[address >> MemoryInline::kPageShift];
+    return bias != 0 ? reinterpret_cast<uint8_t*>((bias - 1u) + address) : nullptr;
+}
+
+// All or nothing: one special page keeps the whole original store sequence.
+bool FillPlainRam(uint32_t dst, uint8_t value, uint32_t count) {
+    if (count - 1u > UINT32_MAX - dst) return false;  // wraps around the address space
+    const uint32_t last = dst + (count - 1u);
+    for (uint32_t at = dst;;) {
+        const uint32_t end = std::min(last, at | MemoryInline::kPageMask);
+        if (PlainRam(at, end - at + 1u) == nullptr) return false;
+        if (end == last) break;
+        at = end + 1u;
+    }
+    for (uint32_t at = dst;;) {
+        const uint32_t end = std::min(last, at | MemoryInline::kPageMask);
+        std::memset(PlainRam(at, end - at + 1u), value, end - at + 1u);
+        if (end == last) break;
+        at = end + 1u;
+    }
+    return true;
+}
+
+// __fill_mem's own stores, in its order and widths.
+void FillStores(uint32_t dst, uint8_t value, uint32_t count) {
+    uint32_t last = dst - 1u;  // r6: the last byte stored
+    if (count >= 32) {
+        uint32_t align = (0u - dst) & 3u;
+        count -= align;
+        for (; align != 0; --align) MemoryInline::FlatWrite8(++last, value);
+        const uint32_t word = value * 0x01010101u;
+        uint32_t base = last - 3u;  // r3: words go to base + 4
+        for (uint32_t blocks = count >> 5; blocks != 0; --blocks) {
+            for (uint32_t offset = 4; offset <= 32; offset += 4) MemoryInline::FlatWrite32(base + offset, word);
+            base += 32;
+        }
+        for (uint32_t words = (count >> 2) & 7u; words != 0; --words) {
+            MemoryInline::FlatWrite32(base + 4, word);
+            base += 4;
+        }
+        last = base + 3u;
+        count &= 3u;
+    }
+    for (; count != 0; --count) MemoryInline::FlatWrite8(++last, value);
+}
+
+}  // namespace mlb_msl
+
+// double __ieee754_sqrt(double x): f1 in, f1 out; errno (r13-26456) = EDOM for NaN, infinities
+// and negatives.
+extern "C" void MLB_Sqrt_80126AE8(CpuContext* ctx) {
+    HleTraceCall("MLB_Sqrt_80126AE8");
+    MkwComputePreemptPoll();  // T8 (switch phase 51): a compute preemption point (compute_preempt.h)
+    const uint32_t frame = ctx->gpr[1] - 32u;
+    const double x = ctx->fpr[1].d;
+    const uint64_t bits = mlb_msl::Bits(x);
+    const uint32_t high = static_cast<uint32_t>(bits >> 32);
+    // The original's frame (back chain, x), below the stack pointer: the stack keeps its bytes.
+    MemoryInline::FlatWriteRam32(frame, ctx->gpr[1]);
+    MemoryInline::FlatWriteRamFloat64(frame + 8u, x);
+    if ((high & 0x7FF00000u) == 0x7FF00000u) {  // NaN or infinity: x*x + x
+        const double square = mlb_msl::Mul(x, x);
+        MemoryInline::FlatWrite32(ctx->gpr[13] - 26456u, 33u);
+        ctx->fpr[0].d = square;
+        ctx->fpr[1].d = mlb_msl::Add(x, square);
+        return;
+    }
+    if (static_cast<int32_t>(high) <= 0) {
+        if ((bits << 1) == 0) return;  // +-0
+        if (static_cast<int32_t>(high) < 0) {  // negative: the float NaN at 0x8031AA10 (lfs)
+            MemoryInline::FlatWrite32(ctx->gpr[13] - 26456u, 33u);
+            ctx->fpr[1].d = mlb_msl::Widen(MemoryInline::FlatReadFloat32(0x8031AA10u));
+            return;
+        }
+    }
+    bool exact = false;
+    const uint64_t root = mlb_msl::PositiveSqrt(bits, exact);
+    if (!exact) ctx->fpr[0].d = MemoryInline::FlatReadFloat64(ctx->gpr[2] - 28672u);  // its rounding test's 1.0
+    MemoryInline::FlatWriteRam32(frame + 20u, static_cast<uint32_t>(root));
+    MemoryInline::FlatWriteRam32(frame + 16u, static_cast<uint32_t>(root >> 32));
+    ctx->fpr[1].d = mlb_msl::FromBits(root);
+}
+REGISTER_NATIVE_FUNCTION(0x80126AE8, MLB_Sqrt_80126AE8);
+
+// void __fill_mem(void* dst, int value, unsigned long count)
+extern "C" void MLB_FillMem_80006508(CpuContext* ctx) {
+    HleTraceCall("MLB_FillMem_80006508");
+    MkwComputePreemptPoll();  // T8 (switch phase 51): a compute preemption point (compute_preempt.h)
+    const uint32_t dst = ctx->gpr[3];
+    const uint8_t value = static_cast<uint8_t>(ctx->gpr[4]);
+    const uint32_t count = ctx->gpr[5];
+    if (count == 0) return;
+    if (!mlb_msl::FillPlainRam(dst, value, count)) mlb_msl::FillStores(dst, value, count);
+}
+REGISTER_NATIVE_FUNCTION(0x80006508, MLB_FillMem_80006508);
+#endif
