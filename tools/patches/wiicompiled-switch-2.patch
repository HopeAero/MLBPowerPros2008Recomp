+    Q f3 = vsubq_f32(f6, f7);
+    Q f5 = LdQ(ws + 3 * 32);
+    f6 = LdQ(ws + 5 * 32);
+    f7 = LdQ(ws + 7 * 32);
+    Q f1 = vaddq_f32(f8, f9);
+    Q f2 = vsubq_f32(f8, f9);
+    f8 = vaddq_f32(f6, f5);
+    f9 = vaddq_f32(f4, f7);
+    f6 = vsubq_f32(f6, f5);
+    f4 = vsubq_f32(f4, f7);
+    f7 = vaddq_f32(f9, f8);
+    f5 = vsubq_f32(f9, f8);
+    f8 = vaddq_f32(f6, f4);
+    f9 = vaddq_f32(f0, f7);
