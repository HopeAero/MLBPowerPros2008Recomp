diff --git a/runtime/src/hle/gx/gx_vtx_f32.h b/runtime/src/hle/gx/gx_vtx_f32.h
new file mode 100644
index 0000000..912eb19
--- /dev/null
+++ b/runtime/src/hle/gx/gx_vtx_f32.h
@@ -0,0 +1,103 @@
+#pragma once
+// P28 (switch phase 82, local/tmp/cpu/P28-vtx.py): per-layout caches for the immediate vertex stream.
+//
+// HleFifoWrite / TryDirectF32FifoWord / FinishDirectF32FifoAttribute ask, for every 32-bit word the
+// game writes between GXBegin and GXEnd, which attribute comes next (HleGxState::NextEnabledAttr:
+// a scan of the 26 descriptors, twice at the end of each vertex) and whether it is a direct float
+// position/normal/texture coordinate and how many components it has (a switch over the attribute,
+// the descriptor and the format row). Both are functions of vtxDesc / vtxAttrFmt[fmt] alone, which
+// only change through code that bumps HleGxState::vtxStateGeneration (GX__SetVtxDesc & co.,
+// ApplyCpRegWrite, display-list state restore: the contract gx_dl.cpp's applied-state mirror and
+// P17 already rely on), so they are kept per (generation, format).
+// WIICOMPILED_GX_VTXF32=0 keeps the scans (aurora's float writers have their own switch of the same name).
+#if defined(__SWITCH__)
+#include <cstdint>
+#include <cstdlib>
+#include "gx_stream_common.h"
+
+namespace GxVtxF32 {
+inline bool ReadSwitch() {
+    const char* v = std::getenv("WIICOMPILED_GX_VTXF32");
+    return !(v != nullptr && v[0] == '0');
+}
+inline const bool kEnabled = ReadSwitch(); // read once at startup
+// WIICOMPILED_GX_VCDKEY=0: gx_dl.cpp's "published nothing" memo of ApplyAuroraVtxDesc keyed by generation only.
+inline bool ReadVcdKeySwitch() {
+    const char* v = std::getenv("WIICOMPILED_GX_VCDKEY");
+    return !(v != nullptr && v[0] == '0');
+}
+inline const bool kVcdNoopByContent = ReadVcdKeySwitch();
+
+struct Cache {
+    // Bit i: vtxDesc[i] != GX_NONE.
+    bool maskValid = false;
+    uint32_t maskGeneration = 0;
+    uint32_t mask = 0;
+    // Components of the direct float POS / NRM / TEXn attribute of the current format (0: not one).
+    bool f32Valid = false;
+    uint32_t f32Generation = 0;
+    GXVtxFmt f32Fmt = GX_VTXFMT0;
+    uint8_t f32Expected[26] = {};
+};
+inline Cache g_cache;
+
+// GXF4 (gx_fifo.cpp, WIICOMPILED_GXF_STREAM=1): the *In forms take the cache, so the raw-FIFO parser
+// instance on the GXF front-end thread keeps a cache of its own.
+inline uint32_t EnabledMaskIn(const HleGxState& g, Cache& c) {
+    if (!c.maskValid || c.maskGeneration != g.vtxStateGeneration) {
+        uint32_t mask = 0;
+        for (int i = 0; i < 26; ++i) {
+            if (g.vtxDesc[i] != GX_NONE) {
+                mask |= 1u << i;
+            }
+        }
+        c.mask = mask;
+        c.maskGeneration = g.vtxStateGeneration;
+        c.maskValid = true;
+    }
+    return c.mask;
+}
+inline uint32_t EnabledMask(const HleGxState& g) { return EnabledMaskIn(g, g_cache); }
+
+// HleGxState::NextEnabledAttr from the mask.
+inline GXAttr NextEnabledIn(const HleGxState& g, int startAttr, Cache& c) {
+    const int first = startAttr + 1;
+    if (first >= 26) {
+        return GX_VA_NULL;
+    }
+    const uint32_t m = EnabledMaskIn(g, c) & (first <= 0 ? ~0u : (~0u << first));
+    return m != 0 ? static_cast<GXAttr>(__builtin_ctz(m)) : GX_VA_NULL;
+}
+inline GXAttr NextEnabled(const HleGxState& g, int startAttr) { return NextEnabledIn(g, startAttr, g_cache); }
+
+inline void RebuildF32(const HleGxState& g, Cache& c) {
+    const auto* row = g.vtxAttrFmt[g.currentVtxFmt];
+    for (int a = 0; a < 26; ++a) {
+        uint32_t expected = 0;
+        if (a == GX_VA_POS || a == GX_VA_NRM || (a >= GX_VA_TEX0 && a <= GX_VA_TEX7)) {
+            const VtxAttrFmt& f = row[a];
+            if (g.vtxDesc[a] == GX_DIRECT && f.type == GX_F32) {
+                expected = GxStream::AttrCompCount(static_cast<GXAttr>(a), f, 1u);
+                if (expected > 9) {
+                    expected = 0;
+                }
+            }
+        }
+        c.f32Expected[a] = static_cast<uint8_t>(expected);
+    }
+    c.f32Generation = g.vtxStateGeneration;
+    c.f32Fmt = g.currentVtxFmt;
+    c.f32Valid = true;
+}
+
+// Components of the direct float attribute `a` in the current vertex format, 0 when it is not one.
+// Requires currentVtxFmt < GX_MAX_VTXFMT (the caller checks) and a < 26.
+inline uint32_t F32ComponentsIn(const HleGxState& g, GXAttr a, Cache& c) {
+    if (!c.f32Valid || c.f32Generation != g.vtxStateGeneration || c.f32Fmt != g.currentVtxFmt) {
+        RebuildF32(g, c);
+    }
+    return c.f32Expected[a];
+}
+inline uint32_t F32Components(const HleGxState& g, GXAttr a) { return F32ComponentsIn(g, a, g_cache); }
+} // namespace GxVtxF32
+#endif
