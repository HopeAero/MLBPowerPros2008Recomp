+struct SynchronousScope {
+    // An inactive queue has nothing to flush and nobody reads the VCD shadow (P22).
+    explicit SynchronousScope(const char* site = nullptr) : entered_(queue.Active()) {
+        if (entered_) EnterSynchronous(site);
+    }
+    ~SynchronousScope() {
+        if (entered_) LeaveSynchronous();
+    }
+    SynchronousScope(const SynchronousScope&) = delete;
+    SynchronousScope& operator=(const SynchronousScope&) = delete;
