diff --git a/runtime/src/hle/gx/gx_offload_nrm_snapshot.h b/runtime/src/hle/gx/gx_offload_nrm_snapshot.h
new file mode 100644
index 0000000..8d71552
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_nrm_snapshot.h
@@ -0,0 +1,38 @@
+#pragma once
+
+// Included by gx_offload.h inside hle::gx::offload, after CallReal is declared.
+namespace nrm_snapshot_detail {
+
+struct NrmMtxImmBE {
+    u32 id;
+    u32 rowStride;
+    unsigned char words[12 * sizeof(u32)];
+};
+
+static_assert(sizeof(NrmMtxImmBE) <= GxOffloadQueue::kMaxPayloadBytes);
+
+template <auto Function> void RunNrmMtxImmBE(const void* bytes) {
+    NrmMtxImmBE command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.words, command.id, command.rowStride);
+}
+
+} // namespace nrm_snapshot_detail
+
+template <> struct Dispatch<&::GXLoadNrmMtxImmBE> {
+    template <auto Function = &::GXLoadNrmMtxImmBE>
+    static void Invoke(const void* matrix, u32 id, u32 rowStride) {
+        if (!Intercept() || Synchronous()) return Function(matrix, id, rowStride);
+        if (!matrix || (rowStride != 3 && rowStride != 4)) {
+            SynchronousScope scope(__PRETTY_FUNCTION__);
+            return Function(matrix, id, rowStride);
+        }
+
+        nrm_snapshot_detail::NrmMtxImmBE command{};
+        command.id = id;
+        command.rowStride = rowStride;
+        const size_t byte_count = static_cast<size_t>(3 * rowStride) * sizeof(u32);
+        std::memcpy(command.words, matrix, byte_count);
+        queue.Submit(&nrm_snapshot_detail::RunNrmMtxImmBE<Function>, command);
+    }
+};
diff --git a/runtime/src/hle/gx/gx_offload_queue.cpp b/runtime/src/hle/gx/gx_offload_queue.cpp
new file mode 100644
index 0000000..e9219da
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_queue.cpp
@@ -0,0 +1,473 @@
+#include "gx_offload_queue.h"
+
+#include <cstdlib>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+
+namespace hle::gx::GxOffloadQueue {
+namespace {
+
+thread_local const Queue* g_worker_queue = nullptr;
+thread_local const Queue* g_executing_queue = nullptr;
+thread_local unsigned g_wait_service_depth = 0;
+
+constexpr Sequence kHalfSequenceRange = Sequence{1} << 63;
+constexpr uint64_t kSpinWindowNs = 30000;
+constexpr uint64_t kWorkerSpinWindowNs = 30000;
+constexpr uint64_t kBatchProfileIntervalNs = 5'000'000'000;
+static_assert(kCapacity != 0 && (kCapacity & (kCapacity - 1)) == 0,
+              "GX offload queue capacity must be a power of two");
+static_assert(kCapacity < kHalfSequenceRange, "queue capacity must fit the sequence comparison");
+
+uint64_t MonotonicNanoseconds() noexcept {
+#if defined(__SWITCH__)
+    return armTicksToNs(armGetSystemTick());
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+#else
+    return 0;
+#endif
+}
+
+void CpuRelax() noexcept {
+#if defined(__aarch64__)
+    __asm__ __volatile__("yield" ::: "memory");
+#elif defined(__x86_64__) || defined(_M_X64)
+    __asm__ __volatile__("pause" ::: "memory");
+#else
+    std::atomic_signal_fence(std::memory_order_seq_cst);
+#endif
+}
+
+} // namespace
+
+Queue::~Queue() noexcept {
+    try {
+        Stop();
+    } catch (...) {
+    }
+}
+
+bool Queue::Start(WaitService wait_service, void* wait_context) {
+    const char* enabled = std::getenv("WIICOMPILED_GX_HLE_WORKER");
+    const char* batch = std::getenv("WIICOMPILED_GX_HLE_BATCH");
+    const bool enable_batch = batch != nullptr && batch[0] == '1' && batch[1] == '\0';
+    return StartImpl(enabled != nullptr && enabled[0] == '1' && enabled[1] == '\0', false,
+                     enable_batch, wait_service, wait_context);
+}
+
+#if defined(GX_OFFLOAD_QUEUE_TEST)
+bool Queue::StartForTest(bool enable_worker, bool force_create_failure,
+                         WaitService wait_service, void* wait_context, bool enable_batch) {
+    return StartImpl(enable_worker, force_create_failure, enable_batch,
+                     wait_service, wait_context);
+}
+#endif
+
+bool Queue::StartImpl(bool enable_worker, bool force_create_failure, bool enable_batch,
+                      WaitService wait_service, void* wait_context) {
+    if (start_called_) throw std::logic_error("GX offload queue Start called more than once");
+    start_called_ = true;
+    batch_publication_enabled_ = false;
+    const char* profile = std::getenv("WIICOMPILED_GX_HLE_BATCH_PROFILE");
+    batch_profile_enabled_ = profile != nullptr && profile[0] == '1' && profile[1] == '\0';
+    const char* fence_profile = std::getenv("WIICOMPILED_GX_HLE_FENCE_PROFILE");
+    wait_profile_enabled_ = fence_profile != nullptr && fence_profile[0] == '1' && fence_profile[1] == '\0';
+    wait_stats_ = WaitStats{};
+    profile_publish_count_ = 0;
+    profile_slot_count_ = 0;
+    profile_last_log_ns_ = 0;
+    wait_service_ = wait_service;
+    wait_context_ = wait_context;
+    RethrowFailureIfReached(Watermark());
+    if (!enable_worker || force_create_failure) {
+        LogBatchProfileConfig(false);
+        return false;
+    }
+
+#if defined(__SWITCH__)
+    if (R_FAILED(threadCreate(&worker_thread_, &Queue::SwitchWorkerEntry, this,
+                              nullptr, 0x10000, 0x2C, 2))) {
+        LogBatchProfileConfig(false);
+        return false;
+    }
+    if (R_FAILED(threadStart(&worker_thread_))) {
+        threadClose(&worker_thread_);
+        LogBatchProfileConfig(false);
+        return false;
+    }
+    worker_started_ = true;
+    active_.store(true, std::memory_order_release);
+    batch_publication_enabled_ = enable_batch;
+    LogBatchProfileConfig(batch_publication_enabled_);
+    return true;
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+    try {
+        worker_thread_ = std::thread(&Queue::HostWorkerEntry, this);
+    } catch (...) {
+        LogBatchProfileConfig(false);
+        return false;
+    }
+    worker_started_ = true;
+    active_.store(true, std::memory_order_release);
+    batch_publication_enabled_ = enable_batch;
+    LogBatchProfileConfig(batch_publication_enabled_);
+    return true;
+#else
+    LogBatchProfileConfig(false);
+    return false;
+#endif
+}
+
+Sequence Queue::Submit(Execute execute, const void* payload, size_t payload_size) {
+    if (stopped_) throw std::logic_error("GX offload queue Submit after Stop");
+    if (OnWorkerThread() || g_executing_queue == this)
+        throw std::logic_error("GX offload jobs must not submit recursively");
+    if (execute == nullptr || payload_size > kMaxPayloadBytes ||
+        (payload == nullptr && payload_size != 0))
+        throw std::invalid_argument("invalid GX offload work item");
+    if (failed_.load(std::memory_order_acquire)) RethrowFailureIfReached(Watermark() + 1);
+
+    if (!worker_started_) {
+        alignas(std::max_align_t) std::array<std::byte, kMaxPayloadBytes> copied_payload{};
+        if (payload_size != 0) std::memcpy(copied_payload.data(), payload, payload_size);
+        const Sequence sequence = staged_position_.load(std::memory_order_relaxed) + 1;
+        staged_position_.store(sequence, std::memory_order_release);
+        published_position_.store(sequence, std::memory_order_release);
+        const Queue* previous = g_executing_queue;
+        g_executing_queue = this;
+        try {
+            execute(copied_payload.data());
+        } catch (...) {
+            g_executing_queue = previous;
+            CaptureFailure(std::current_exception(), sequence);
+            throw;
+        }
+        g_executing_queue = previous;
+        completed_sequence_.store(sequence, std::memory_order_release);
+        return sequence;
+    }
+
+    Sequence write = 0;
+    Sequence read = 0;
+    uint64_t spin_started = MonotonicNanoseconds();
+    for (;;) {
+        if (stopped_) throw std::logic_error("GX offload queue stopped during Submit");
+        if (failed_.load(std::memory_order_acquire)) RethrowFailureIfReached(Watermark() + 1);
+        write = staged_position_.load(std::memory_order_relaxed);
+        read = read_position_.load(std::memory_order_acquire);
+        if (write - read < kCapacity) break;
+        if (MonotonicNanoseconds() - spin_started < kSpinWindowNs) continue;
+        // The worker may only consume published slots. Make the current
+        // staged prefix visible before waiting, because WaitService may
+        // re-enter Submit and the worker must be able to release ring space.
+        PublishThrough(write);
+        if (wait_profile_enabled_) {
+            const uint64_t wait_started = MonotonicNanoseconds();
+            WaitForProducerProgress(read + 1);
+            ++wait_stats_.submit_full_waits;
+            wait_stats_.submit_full_ns += MonotonicNanoseconds() - wait_started;
+        } else {
+            WaitForProducerProgress(read + 1);
+        }
+        spin_started = MonotonicNanoseconds();
+    }
+
+    Slot& slot = slots_[static_cast<size_t>(write & (kCapacity - 1))];
+    slot.execute = execute;
+    slot.payload_size = static_cast<uint16_t>(payload_size);
+    if (payload_size != 0) std::memcpy(slot.payload.data(), payload, payload_size);
+#if defined(GX_OFFLOAD_QUEUE_TEST)
+    if (test_hook_) test_hook_(test_context_, TestPoint::BeforeSubmitPublish);
+#endif
+    const Sequence sequence = write + 1;
+    staged_position_.store(sequence, std::memory_order_release);
+    const Sequence published = published_position_.load(std::memory_order_relaxed);
+    if (!batch_publication_enabled_ || sequence - published >= kPublishBatchSize) {
+        PublishThrough(sequence);
+    }
+    return sequence;
+}
+
+bool Queue::TrySubmit(Execute execute, const void* payload, size_t payload_size) {
+    ValidateSubmit(execute, payload, payload_size);
+
+    // Preserve the queue's synchronous fallback when worker creation was disabled or failed.
+    if (!worker_started_) {
+        Submit(execute, payload, payload_size);
+        return true;
+    }
+
+    // Queue is SPSC: this producer is the only writer, and the worker only advances read.
+    // Between this check and Submit, occupancy can only decrease, so Submit cannot reach its
+    // wait/callback path. A full ring is an ordinary fallback signal with no slot mutation.
+    const Sequence write = staged_position_.load(std::memory_order_relaxed);
+    const Sequence read = read_position_.load(std::memory_order_acquire);
+    if (write - read >= kCapacity) {
+        // Observe a concurrent worker error before reporting a capacity miss.
+        if (failed_.load(std::memory_order_acquire)) RethrowFailureIfReached(Watermark() + 1);
+        return false;
+    }
+
+    Submit(execute, payload, payload_size);
+    return true;
+}
+
+void Queue::ValidateSubmit(Execute execute, const void* payload, size_t payload_size) const {
+    if (stopped_) throw std::logic_error("GX offload queue Submit after Stop");
+    if (OnWorkerThread() || g_executing_queue == this)
+        throw std::logic_error("GX offload jobs must not submit recursively");
+    if (execute == nullptr || payload_size > kMaxPayloadBytes ||
+        (payload == nullptr && payload_size != 0))
+        throw std::invalid_argument("invalid GX offload work item");
+    if (failed_.load(std::memory_order_acquire)) RethrowFailureIfReached(Watermark() + 1);
+}
+
+Sequence Queue::Watermark() const noexcept {
+    return staged_position_.load(std::memory_order_acquire);
+}
+
+#if defined(GX_OFFLOAD_QUEUE_TEST)
+bool Queue::Idle() const noexcept {
+    const Sequence staged = staged_position_.load(std::memory_order_acquire);
+    const Sequence completed = completed_sequence_.load(std::memory_order_acquire);
+    return Reached(completed, staged);
+}
+#endif
+
+void Queue::PublishThrough(Sequence watermark) noexcept {
+    const Sequence published = published_position_.load(std::memory_order_relaxed);
+    if (Reached(published, watermark)) return;
+    if (batch_profile_enabled_) {
+        ++profile_publish_count_;
+        profile_slot_count_ += watermark - published;
+        const uint64_t now = MonotonicNanoseconds();
+        if (now - profile_last_log_ns_ >= kBatchProfileIntervalNs) {
+            std::fprintf(stderr,
+                         "[GX-HLE-BATCH-PROFILE] publications=%llu slots=%llu batch=%s threshold=%zu\n",
+                         static_cast<unsigned long long>(profile_publish_count_),
+                         static_cast<unsigned long long>(profile_slot_count_),
+                         batch_publication_enabled_ ? "on" : "off", kPublishBatchSize);
+            profile_last_log_ns_ = now;
+        }
+    }
+    // Pairs with the worker's asleep flag and published-position predicate.
+    published_position_.store(watermark, std::memory_order_seq_cst);
+    SignalWorker();
+}
+
+void Queue::LogBatchProfileConfig(bool batch_enabled) {
+    if (!batch_profile_enabled_) return;
+    std::fprintf(stderr,
+                 "[GX-HLE-BATCH-PROFILE] profile=on batch=%s threshold=%zu\n",
+                 batch_enabled ? "on" : "off", kPublishBatchSize);
+    profile_last_log_ns_ = MonotonicNanoseconds();
+}
+
+void Queue::Flush(Sequence watermark) {
+    if (OnWorkerThread() || g_executing_queue == this)
+        throw std::logic_error("GX offload worker cannot flush its own queue");
+    if (Ahead(watermark, Watermark())) throw std::invalid_argument("GX offload watermark was never submitted");
+    PublishThrough(watermark);
+    uint64_t spin_started = MonotonicNanoseconds();
+    while (!Reached(completed_sequence_.load(std::memory_order_acquire), watermark)) {
+        RethrowFailureIfReached(watermark);
+        if (!worker_started_) throw std::logic_error("inline GX offload work has not completed");
+        if (MonotonicNanoseconds() - spin_started < kSpinWindowNs) continue;
+        if (wait_profile_enabled_) {
+            const uint64_t wait_started = MonotonicNanoseconds();
+            WaitForProducerProgress(watermark);
+            ++wait_stats_.flush_sleeps;
+            wait_stats_.flush_sleep_ns += MonotonicNanoseconds() - wait_started;
+        } else {
+            WaitForProducerProgress(watermark);
+        }
+        spin_started = MonotonicNanoseconds();
+    }
+    RethrowFailureIfReached(watermark);
+}
+
+void Queue::FlushAll() {
+    for (;;) {
+        const Sequence target = Watermark();
+        Flush(target);
+        if (target == Watermark()) return;
+    }
+}
+
+void Queue::Stop() {
+    if (stopped_) return;
+    if (OnWorkerThread()) throw std::logic_error("GX offload worker cannot stop itself");
+
+    std::exception_ptr error;
+    try {
+        FlushAll();
+    } catch (...) {
+        error = std::current_exception();
+    }
+
+    if (worker_started_) {
+        // A wait-service exception can abort FlushAll without indicating a
+        // worker failure. Publish any remaining producer tail before asking
+        // the worker to exit, then preserve the original exception.
+        if (!failed_.load(std::memory_order_acquire)) PublishThrough(Watermark());
+        stop_requested_.store(true, std::memory_order_seq_cst);
+        SignalWorker();
+#if defined(__SWITCH__)
+        const Result wait_result = threadWaitForExit(&worker_thread_);
+        const Result close_result = threadClose(&worker_thread_);
+        if (!error && R_FAILED(wait_result))
+            error = std::make_exception_ptr(std::runtime_error("libnx failed to join GX offload worker"));
+        if (!error && R_FAILED(close_result))
+            error = std::make_exception_ptr(std::runtime_error("libnx failed to close GX offload worker"));
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+        if (worker_thread_.joinable()) worker_thread_.join();
+#endif
+        worker_started_ = false;
+    }
+
+    active_.store(false, std::memory_order_release);
+    stopped_ = true;
+    if (error) std::rethrow_exception(error);
+}
+
+bool Queue::OnWorkerThread() const noexcept { return g_worker_queue == this; }
+
+void Queue::WaitForProducerProgress(Sequence target) {
+    for (;;) {
+        if (Reached(completed_sequence_.load(std::memory_order_acquire), target)) break;
+        RethrowFailureIfReached(target);
+
+        bool reached = false;
+        {
+            std::unique_lock<std::mutex> lock(wait_mutex_);
+            producer_wait_target_.store(target, std::memory_order_seq_cst);
+            producer_waiting_.store(true, std::memory_order_seq_cst);
+            reached = producer_cv_.wait_for(lock, std::chrono::milliseconds(1), [this, target] {
+                return Reached(completed_sequence_.load(std::memory_order_seq_cst), target) ||
+                       failed_.load(std::memory_order_acquire);
+            });
+            producer_waiting_.store(false, std::memory_order_relaxed);
+        }
+
+        if (Reached(completed_sequence_.load(std::memory_order_acquire), target)) break;
+        RethrowFailureIfReached(target);
+        if (!reached && wait_service_ != nullptr && g_wait_service_depth == 0) {
+            ++g_wait_service_depth;
+            try {
+                wait_service_(wait_context_);
+            } catch (...) {
+                --g_wait_service_depth;
+                throw;
+            }
+            --g_wait_service_depth;
+        }
+    }
+    RethrowFailureIfReached(target);
+}
+
+void Queue::SignalWorker() noexcept {
+    if (!worker_asleep_.load(std::memory_order_seq_cst)) return;
+    std::lock_guard<std::mutex> lock(wait_mutex_);
+    if (worker_asleep_.load(std::memory_order_relaxed)) worker_cv_.notify_one();
+}
+
+void Queue::SignalProducer(Sequence completed) noexcept {
+    if (!producer_waiting_.load(std::memory_order_seq_cst) ||
+        (!failed_.load(std::memory_order_acquire) &&
+         !Reached(completed, producer_wait_target_.load(std::memory_order_seq_cst))))
+        return;
+    std::lock_guard<std::mutex> lock(wait_mutex_);
+    producer_cv_.notify_all();
+}
+
+void Queue::WaitForWorker() noexcept {
+    const uint64_t spin_started = MonotonicNanoseconds();
+    while (MonotonicNanoseconds() - spin_started < kWorkerSpinWindowNs) {
+        if (stop_requested_.load(std::memory_order_acquire) ||
+            read_position_.load(std::memory_order_acquire) !=
+                published_position_.load(std::memory_order_acquire))
+            return;
+        CpuRelax();
+    }
+    std::unique_lock<std::mutex> lock(wait_mutex_);
+    worker_asleep_.store(true, std::memory_order_seq_cst);
+    worker_cv_.wait(lock, [this] {
+        const bool ready = stop_requested_.load(std::memory_order_acquire) ||
+                           read_position_.load(std::memory_order_seq_cst) !=
+                               published_position_.load(std::memory_order_seq_cst);
+#if defined(GX_OFFLOAD_QUEUE_TEST)
+        if (!ready && test_hook_)
+            test_hook_(test_context_, TestPoint::AfterWorkerPredicateFalse);
+#endif
+        return ready;
+    });
+    worker_asleep_.store(false, std::memory_order_relaxed);
+}
+
+void Queue::CaptureFailure(std::exception_ptr error, Sequence sequence) noexcept {
+    worker_error_ = error;
+    error_sequence_ = sequence;
+    failed_.store(true, std::memory_order_release);
+    completed_sequence_.store(sequence, std::memory_order_seq_cst);
+}
+
+void Queue::RethrowFailureIfReached(Sequence watermark) const {
+    if (failed_.load(std::memory_order_acquire) && Reached(watermark, error_sequence_))
+        std::rethrow_exception(worker_error_);
+}
+
+void Queue::RunWorker() noexcept {
+    const Queue* previous_worker = g_worker_queue;
+    g_worker_queue = this;
+    for (;;) {
+        const Sequence read = read_position_.load(std::memory_order_relaxed);
+        const Sequence write = published_position_.load(std::memory_order_acquire);
+        if (read == write) {
+            if (stop_requested_.load(std::memory_order_acquire)) break;
+            WaitForWorker();
+            continue;
+        }
+
+        Slot& slot = slots_[static_cast<size_t>(read & (kCapacity - 1))];
+        const Queue* previous_execute = g_executing_queue;
+        g_executing_queue = this;
+        try {
+            slot.execute(slot.payload.data());
+        } catch (...) {
+            g_executing_queue = previous_execute;
+            CaptureFailure(std::current_exception(), read + 1);
+            read_position_.store(read + 1, std::memory_order_release);
+            SignalProducer(read + 1);
+            break;
+        }
+        g_executing_queue = previous_execute;
+        read_position_.store(read + 1, std::memory_order_release);
+        completed_sequence_.store(read + 1, std::memory_order_seq_cst);
+        SignalProducer(read + 1);
+    }
+    g_worker_queue = previous_worker;
+}
+
+bool Queue::Reached(Sequence current, Sequence target) noexcept {
+    return static_cast<Sequence>(current - target) < kHalfSequenceRange;
+}
+
+bool Queue::Ahead(Sequence sequence, Sequence watermark) noexcept {
+    return sequence != watermark && !Reached(watermark, sequence);
+}
+
+#if defined(__SWITCH__)
+void Queue::SwitchWorkerEntry(void* argument) {
+    static_cast<Queue*>(argument)->RunWorker();
+}
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+void Queue::HostWorkerEntry(Queue* queue) { queue->RunWorker(); }
+
+void Queue::WakeWorkerForTest() noexcept { SignalWorker(); }
+#endif
+
+} // namespace hle::gx::GxOffloadQueue
diff --git a/runtime/src/hle/gx/gx_offload_queue.h b/runtime/src/hle/gx/gx_offload_queue.h
new file mode 100644
index 0000000..38bfa2f
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_queue.h
@@ -0,0 +1,189 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <condition_variable>
+#include <exception>
+#include <mutex>
+#include <type_traits>
+
+#if defined(__SWITCH__)
+#include <switch.h>
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+#include <thread>
+#endif
+
+namespace hle::gx::GxOffloadQueue {
+
+#if defined(GX_OFFLOAD_QUEUE_TEST)
+#if defined(GX_OFFLOAD_QUEUE_TEST_CAPACITY)
+constexpr size_t kCapacity = GX_OFFLOAD_QUEUE_TEST_CAPACITY;
+#else
+constexpr size_t kCapacity = 64;
+#endif
+#else
+constexpr size_t kCapacity = 16384;
+#endif
+constexpr size_t kMaxPayloadBytes = 320;
+// WIICOMPILED_GX_HLE_BATCH=1 publishes every 16 slots by default.
+constexpr size_t kPublishBatchSize = 16;
+using Sequence = uint64_t;
+using Execute = void (*)(const void*);
+// Called by the producer before a bounded wait to pump timers; it holds no queue lock.
+using WaitService = void (*)(void*);
+
+class Queue {
+public:
+    Queue() noexcept = default;
+    ~Queue() noexcept;
+
+    Queue(const Queue&) = delete;
+    Queue& operator=(const Queue&) = delete;
+    Queue(Queue&&) = delete;
+    Queue& operator=(Queue&&) = delete;
+
+    // The worker is opt-in through WIICOMPILED_GX_HLE_WORKER=1; otherwise jobs run inline.
+    bool Start(WaitService wait_service = nullptr, void* wait_context = nullptr);
+    // Execute runs on the worker; referenced host data must outlive the next drain.
+    // Guest callbacks, guest memory and queue re-entry remain producer-only.
+    Sequence Submit(Execute execute, const void* payload, size_t payload_size);
+
+    // Attempts to submit without waiting or invoking WaitService. Returns false only when
+    // the worker-backed ring is full; validation and worker failures still throw. With no
+    // worker, the job uses Submit's inline fallback and returns true.
+    bool TrySubmit(Execute execute, const void* payload, size_t payload_size);
+
+    template <typename Payload>
+    Sequence Submit(Execute execute, const Payload& payload) {
+        static_assert(std::is_trivially_copyable<Payload>::value,
+                      "GX offload payloads must be trivially copyable");
+        static_assert(sizeof(Payload) <= kMaxPayloadBytes,
+                      "GX offload payload exceeds the owned payload storage");
+        static_assert(alignof(Payload) <= alignof(std::max_align_t),
+                      "GX offload payload alignment exceeds the owned payload storage");
+        return Submit(execute, &payload, sizeof(Payload));
+    }
+
+    template <typename Payload>
+    bool TrySubmit(Execute execute, const Payload& payload) {
+        static_assert(std::is_trivially_copyable<Payload>::value,
+                      "GX offload payloads must be trivially copyable");
+        static_assert(sizeof(Payload) <= kMaxPayloadBytes,
+                      "GX offload payload exceeds the owned payload storage");
+        static_assert(alignof(Payload) <= alignof(std::max_align_t),
+                      "GX offload payload alignment exceeds the owned payload storage");
+        return TrySubmit(execute, &payload, sizeof(Payload));
+    }
+
+    // Highest submitted sequence, including slots not yet visible to the worker.
+    Sequence Watermark() const noexcept;
+    // Highest sequence the worker has completed.
+    Sequence Completed() const noexcept { return completed_sequence_.load(std::memory_order_acquire); }
+
+    // WIICOMPILED_GX_HLE_FENCE_PROFILE=1: producer-side time spent sleeping (past the spin window)
+    // in Flush and in Submit's ring-full wait. Producer-thread only; TakeWaitStats clears them.
+    struct WaitStats {
+        uint64_t flush_sleeps = 0, flush_sleep_ns = 0;
+        uint64_t submit_full_waits = 0, submit_full_ns = 0;
+    };
+    WaitStats TakeWaitStats() noexcept {
+        const WaitStats stats = wait_stats_;
+        wait_stats_ = WaitStats{};
+        return stats;
+    }
+    void Flush(Sequence watermark);
+    void FlushAll();
+    void Stop();
+
+    bool Active() const noexcept { return active_.load(std::memory_order_acquire); }
+    bool OnWorkerThread() const noexcept;
+
+#if defined(GX_OFFLOAD_QUEUE_TEST)
+    bool Idle() const noexcept;
+    enum class TestPoint : uint8_t { BeforeSubmitPublish, AfterWorkerPredicateFalse };
+    using TestHook = void (*)(void*, TestPoint);
+
+    bool StartForTest(bool enable_worker, bool force_create_failure,
+                      WaitService wait_service = nullptr, void* wait_context = nullptr,
+                      bool enable_batch = false);
+    Sequence PublishedWatermarkForTest() const noexcept {
+        return published_position_.load(std::memory_order_acquire);
+    }
+    void SetTestHook(TestHook hook, void* context) noexcept {
+        test_hook_ = hook;
+        test_context_ = context;
+    }
+    void WakeWorkerForTest() noexcept;
+    // Makes every staged slot visible to the worker (batch mode otherwise holds up to 15 back).
+    void PublishAllForTest() noexcept { PublishThrough(Watermark()); }
+#endif
+
+private:
+    struct Slot {
+        Execute execute{};
+        uint16_t payload_size{};
+        alignas(std::max_align_t) std::array<std::byte, kMaxPayloadBytes> payload{};
+    };
+
+    bool StartImpl(bool enable_worker, bool force_create_failure, bool enable_batch,
+                   WaitService wait_service, void* wait_context);
+    void ValidateSubmit(Execute execute, const void* payload, size_t payload_size) const;
+    void PublishThrough(Sequence watermark) noexcept;
+    void RunWorker() noexcept;
+    void WaitForProducerProgress(Sequence target);
+    void LogBatchProfileConfig(bool batch_enabled);
+    void SignalWorker() noexcept;
+    void SignalProducer(Sequence completed) noexcept;
+    void WaitForWorker() noexcept;
+    void CaptureFailure(std::exception_ptr error, Sequence sequence) noexcept;
+    void RethrowFailureIfReached(Sequence watermark) const;
+    static bool Reached(Sequence current, Sequence target) noexcept;
+    static bool Ahead(Sequence sequence, Sequence watermark) noexcept;
+
+#if defined(__SWITCH__)
+    static void SwitchWorkerEntry(void* argument);
+    Thread worker_thread_{};
+#elif defined(GX_OFFLOAD_QUEUE_TEST)
+    static void HostWorkerEntry(Queue* queue);
+    std::thread worker_thread_;
+#endif
+
+    std::array<Slot, kCapacity> slots_{};
+    alignas(64) std::mutex wait_mutex_;
+    std::condition_variable worker_cv_;
+    std::condition_variable producer_cv_;
+    // staged_position_ is the producer/API watermark. published_position_ is
+    // the only frontier visible to the worker and its sleep predicate.
+    alignas(64) std::atomic<Sequence> staged_position_{0};
+    alignas(64) std::atomic<Sequence> published_position_{0};
+    alignas(64) std::atomic<Sequence> read_position_{0};
+    alignas(64) std::atomic<Sequence> completed_sequence_{0};
+    std::atomic<bool> stop_requested_{false};
+    std::atomic<bool> failed_{false};
+    std::atomic<bool> active_{false};
+    std::atomic<bool> worker_asleep_{false};
+    std::atomic<bool> producer_waiting_{false};
+    std::atomic<Sequence> producer_wait_target_{0};
+    std::exception_ptr worker_error_{};
+    Sequence error_sequence_{};
+    WaitService wait_service_{};
+    void* wait_context_{};
+#if defined(GX_OFFLOAD_QUEUE_TEST)
+    TestHook test_hook_{};
+    void* test_context_{};
+#endif
+    bool start_called_{};
+    bool worker_started_{};
+    bool batch_publication_enabled_{};
+    bool batch_profile_enabled_{};
+    bool wait_profile_enabled_{};
+    WaitStats wait_stats_{};
+    uint64_t profile_publish_count_{};
+    uint64_t profile_slot_count_{};
+    uint64_t profile_last_log_ns_{};
+    bool stopped_{};
+};
+
+} // namespace hle::gx::GxOffloadQueue
diff --git a/runtime/src/hle/gx/gx_offload_run_snapshots.h b/runtime/src/hle/gx/gx_offload_run_snapshots.h
new file mode 100644
index 0000000..98eaa90
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_run_snapshots.h
@@ -0,0 +1,87 @@
+#pragma once
+
+// Included by gx_offload.h inside hle::gx::offload after global GX Run declarations.
+namespace run_snapshot_detail {
+
+constexpr u32 kVtxDescRunCapacity =
+    (GxOffloadQueue::kMaxPayloadBytes - sizeof(u32)) / sizeof(GXVtxDescList);
+constexpr u32 kVtxAttrFmtRunCapacity =
+    (GxOffloadQueue::kMaxPayloadBytes - 2 * sizeof(u32)) / sizeof(GXVtxAttrFmtList);
+
+struct VtxDescRun {
+    u32 count;
+    GXVtxDescList entries[kVtxDescRunCapacity];
+};
+
+struct VtxAttrFmtRun {
+    GXVtxFmt vtxfmt;
+    u32 count;
+    GXVtxAttrFmtList entries[kVtxAttrFmtRunCapacity];
+};
+
+static_assert(std::is_trivially_copyable_v<GXVtxDescList>);
+static_assert(std::is_trivially_copyable_v<GXVtxAttrFmtList>);
+static_assert(sizeof(VtxDescRun) <= GxOffloadQueue::kMaxPayloadBytes);
+static_assert(sizeof(VtxAttrFmtRun) <= GxOffloadQueue::kMaxPayloadBytes);
+
+template <auto Function> void RunVtxDesc(const void* bytes) {
+    VtxDescRun command{};
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.entries, command.count);
+}
+
+template <auto Function> void RunVtxAttrFmt(const void* bytes) {
+    VtxAttrFmtRun command{};
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.vtxfmt, command.entries, command.count);
+}
+
+} // namespace run_snapshot_detail
+
+template <> struct Dispatch<&::GXSetVtxDescRun> {
+    template <auto Function = &::GXSetVtxDescRun>
+    static void Invoke(const GXVtxDescList* list, u32 count) {
+        if (!Intercept() || Synchronous()) return Function(list, count);
+
+        bool valid = list != nullptr && count <= run_snapshot_detail::kVtxDescRunCapacity;
+        for (u32 i = 0; valid && i < count; ++i) {
+            const u32 attr = static_cast<u32>(list[i].attr);
+            valid = attr >= static_cast<u32>(GX_VA_PNMTXIDX) && attr < static_cast<u32>(GX_VA_MAX_ATTR);
+        }
+        if (!valid) {
+            SynchronousScope scope(__PRETTY_FUNCTION__);
+            return Function(list, count);
+        }
+
+        run_snapshot_detail::VtxDescRun command{};
+        command.count = count;
+        if (count != 0) std::memcpy(command.entries, list, count * sizeof(*list));
+        queue.Submit(&run_snapshot_detail::RunVtxDesc<Function>, command);
+        for (u32 i = 0; i < count; ++i) SetVtxDescShadow(command.entries[i].attr, command.entries[i].type);
+    }
+};
+
+template <> struct Dispatch<&::GXSetVtxAttrFmtRun> {
+    template <auto Function = &::GXSetVtxAttrFmtRun>
+    static void Invoke(GXVtxFmt vtxfmt, const GXVtxAttrFmtList* list, u32 count) {
+        if (!Intercept() || Synchronous()) return Function(vtxfmt, list, count);
+
+        const u32 fmt = static_cast<u32>(vtxfmt);
+        bool valid = list != nullptr && count <= run_snapshot_detail::kVtxAttrFmtRunCapacity &&
+                     fmt >= static_cast<u32>(GX_VTXFMT0) && fmt < static_cast<u32>(GX_MAX_VTXFMT);
+        for (u32 i = 0; valid && i < count; ++i) {
+            const u32 attr = static_cast<u32>(list[i].attr);
+            valid = attr >= static_cast<u32>(GX_VA_POS) && attr < static_cast<u32>(GX_VA_MAX_ATTR);
+        }
+        if (!valid) {
+            SynchronousScope scope(__PRETTY_FUNCTION__);
+            return Function(vtxfmt, list, count);
+        }
+
+        run_snapshot_detail::VtxAttrFmtRun command{};
+        command.vtxfmt = vtxfmt;
+        command.count = count;
+        if (count != 0) std::memcpy(command.entries, list, count * sizeof(*list));
+        queue.Submit(&run_snapshot_detail::RunVtxAttrFmt<Function>, command);
+    }
+};
diff --git a/runtime/src/hle/gx/gx_offload_snapshots.h b/runtime/src/hle/gx/gx_offload_snapshots.h
new file mode 100644
index 0000000..d7ffb8e
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_snapshots.h
@@ -0,0 +1,81 @@
+#pragma once
+
+// Included by gx_offload.h inside hle::gx::offload, after CallReal is declared.
+// Queue only the host-side FIFO emitters below; their guest-visible reads are copied first.
+
+namespace snapshot_detail {
+
+struct PosMtxImmBE {
+    u32 id;
+    unsigned char words[48];
+};
+
+struct LightObjImmBE {
+    GXLightID id;
+    alignas(u32) unsigned char words[52];
+};
+
+struct TexMtxImm {
+    u32 id;
+    GXTexMtxType type;
+    f32 matrix[3][4];
+};
+
+static_assert(sizeof(PosMtxImmBE) <= GxOffloadQueue::kMaxPayloadBytes);
+static_assert(sizeof(LightObjImmBE) <= GxOffloadQueue::kMaxPayloadBytes);
+static_assert(sizeof(TexMtxImm) <= GxOffloadQueue::kMaxPayloadBytes);
+
+template <auto Function> void RunPosMtxImmBE(const void* bytes) {
+    PosMtxImmBE command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.words, command.id);
+}
+
+template <auto Function> void RunLightObjImmBE(const void* bytes) {
+    LightObjImmBE command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.words, command.id);
+}
+
+template <auto Function> void RunTexMtxImm(const void* bytes) {
+    TexMtxImm command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.matrix, command.id, command.type);
+}
+
+} // namespace snapshot_detail
+
+template <> struct Dispatch<&::GXLoadPosMtxImmBE> {
+    template <auto Function = &::GXLoadPosMtxImmBE>
+    static void Invoke(const void* matrix, u32 id) {
+        if (!Intercept() || Synchronous()) return Function(matrix, id);
+        snapshot_detail::PosMtxImmBE command{};
+        command.id = id;
+        std::memcpy(command.words, matrix, sizeof(command.words));
+        queue.Submit(&snapshot_detail::RunPosMtxImmBE<Function>, command);
+    }
+};
+
+template <> struct Dispatch<&::GXLoadLightObjImmBE> {
+    template <auto Function = &::GXLoadLightObjImmBE>
+    static void Invoke(const void* light, GXLightID id) {
+        if (!Intercept() || Synchronous()) return Function(light, id);
+        snapshot_detail::LightObjImmBE command{};
+        command.id = id;
+        std::memcpy(command.words, light, sizeof(command.words));
+        queue.Submit(&snapshot_detail::RunLightObjImmBE<Function>, command);
+    }
+};
+
+template <> struct Dispatch<&::GXLoadTexMtxImm> {
+    template <auto Function = &::GXLoadTexMtxImm, typename Matrix>
+    static void Invoke(Matrix matrix, u32 id, GXTexMtxType type) {
+        if (!Intercept() || Synchronous()) return Function(matrix, id, type);
+        snapshot_detail::TexMtxImm command{};
+        command.id = id;
+        command.type = type;
+        const size_t bytes = (type == GX_MTX2x4 ? 8 : 12) * sizeof(u32);
+        std::memcpy(command.matrix, matrix, bytes);
+        queue.Submit(&snapshot_detail::RunTexMtxImm<Function>, command);
+    }
+};
diff --git a/runtime/src/hle/gx/gx_offload_texture.h b/runtime/src/hle/gx/gx_offload_texture.h
new file mode 100644
index 0000000..cdb1ed0
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_texture.h
@@ -0,0 +1,189 @@
+#pragma once
+
+#include <cstdlib>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <type_traits>
+
+extern "C" void GXPrepareTexObjLoad(GXTexObj* obj, GXTexMapID id);
+extern "C" void __GXSetSUTexRegs(void);
+extern "C" void __real_GXLoadTexObj(GXTexObj* obj, GXTexMapID id);
+#if defined(__SWITCH__)
+extern "C" bool GXCanOffloadTexObjLoad() noexcept;
+extern "C" bool GX_HLE_MidCommand();
+#endif
+
+namespace hle::gx::offload {
+
+namespace texture_detail {
+#if defined(__SWITCH__)
+inline bool TextureLoadStateAllowsOffload() noexcept {
+    // These are producer-only reads: the Aurora check rejects display-list recording;
+    // the HLE check rejects recording, GXBegin, and a partially buffered FIFO command.
+    return GXCanOffloadTexObjLoad() && !GX_HLE_MidCommand();
+}
+#else
+inline bool TextureLoadStateAllowsOffload() noexcept { return true; }
+#endif
+
+inline bool TextureLoadEnabled() noexcept {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("WIICOMPILED_GX_HLE_TEXTURES");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
+
+inline bool TextureLoadProfileEnabled() noexcept {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("WIICOMPILED_GX_HLE_TEXTURE_PROFILE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return enabled;
+}
+
+struct TextureLoadProfileCounters {
+    bool configReported = false;
+    uint64_t calls = 0;
+    uint64_t accepted = 0;
+    uint64_t fallbackFull = 0;
+};
+
+inline TextureLoadProfileCounters& TextureLoadProfile() noexcept {
+    // GX offload has one guest-side producer; counters are producer-owned.
+    static TextureLoadProfileCounters counters;
+    return counters;
+}
+
+inline void ReportTextureLoadProfile(bool texturesEnabled,
+                                     const TextureLoadProfileCounters& counters) noexcept {
+    const double ratio = counters.calls == 0
+                             ? 0.0
+                             : static_cast<double>(counters.accepted) * 100.0 /
+                                   static_cast<double>(counters.calls);
+    std::fprintf(stderr,
+                 "[GX-HLE-TEX-PROFILE] textures_enabled=%u calls=%llu accepted=%llu fallback_full=%llu accepted_ratio=%.2f%%\n",
+                 texturesEnabled ? 1u : 0u,
+                 static_cast<unsigned long long>(counters.calls),
+                 static_cast<unsigned long long>(counters.accepted),
+                 static_cast<unsigned long long>(counters.fallbackFull), ratio);
+    std::fflush(stderr);
+}
+
+inline void NoteTextureLoadAttempt(bool profileEnabled, bool texturesEnabled,
+                                   bool eligible) noexcept {
+    if (!profileEnabled) return;
+    TextureLoadProfileCounters& counters = TextureLoadProfile();
+    if (!counters.configReported) {
+        counters.configReported = true;
+        ReportTextureLoadProfile(texturesEnabled, counters);
+    }
+    if (eligible) ++counters.calls;
+}
+
+inline void NoteTextureLoadResult(bool profileEnabled, bool accepted, bool fallbackFull) noexcept {
+    if (!profileEnabled) return;
+    TextureLoadProfileCounters& counters = TextureLoadProfile();
+    if (accepted) ++counters.accepted;
+    if (fallbackFull) ++counters.fallbackFull;
+    if (counters.calls != 0 && (counters.calls & 0xFFFFu) == 0) {
+        ReportTextureLoadProfile(TextureLoadEnabled(), counters);
+    }
+}
+
+template <auto Function>
+struct TexObjLoadCommand {
+    GXTexObj object{};
+    GXTexMapID id{};
+
+    static_assert(std::is_trivially_copyable_v<GXTexObj>);
+    static_assert(std::is_trivially_copyable_v<GXTexMapID>);
+
+    static void Execute(const void* bytes) {
+        TexObjLoadCommand command{};
+        std::memcpy(&command, bytes, sizeof(command));
+        Function(&command.object, command.id);
+    }
+};
+} // namespace texture_detail
+
+template <> struct Dispatch<&::GXLoadTexObj> {
+    template <auto Function = &::GXLoadTexObj>
+    static void Invoke(GXTexObj* object, GXTexMapID id) {
+        if (!Intercept() || Synchronous()) {
+            Function(object, id);
+            return;
+        }
+
+        const bool texturesEnabled = texture_detail::TextureLoadEnabled();
+        const bool profileEnabled = texture_detail::TextureLoadProfileEnabled();
+        const bool eligible = texturesEnabled && object != nullptr && static_cast<u32>(id) < 8u &&
+                              texture_detail::TextureLoadStateAllowsOffload();
+        texture_detail::NoteTextureLoadAttempt(profileEnabled, texturesEnabled, eligible);
+        if (!eligible) {
+            SynchronousScope scope("GXLoadTexObj (sync: ineligible)");
+            Function(object, id);
+            return;
+        }
+
+        using Command = texture_detail::TexObjLoadCommand<Function>;
+        static_assert(sizeof(Command) <= GxOffloadQueue::kMaxPayloadBytes);
+        static_assert(alignof(Command) <= alignof(std::max_align_t));
+
+        Command command{};
+        std::memcpy(&command.object, object, sizeof(command.object));
+        command.id = id;
+        GXPrepareTexObjLoad(&command.object, id);
+
+        // A worker emission failure follows the Q66 queue-failure contract; the caller's
+        // synchronous HLE catch cannot recover a job after it has been published.
+        if (queue.TrySubmit(&Command::Execute, command)) {
+            // The worker owns command.object. Preserve GXLoadTexObj's immediate host-object
+            // mutation immediately after successful publication; this helper cannot call out.
+            GXPrepareTexObjLoad(object, id);
+            texture_detail::NoteTextureLoadResult(profileEnabled, true, false);
+            return;
+        }
+
+        // TrySubmit returned without waiting or invoking WaitService, and the original object
+        // is still untouched. Preserve the established synchronous fallback on a capacity miss.
+        texture_detail::NoteTextureLoadResult(profileEnabled, false, true);
+        SynchronousScope scope("GXLoadTexObj (sync: ring full)");
+        Function(object, id);
+    }
+};
+
+// __GXSetSUTexRegs() takes no arguments and only reads/writes __gx and the FIFO, so with
+// WIICOMPILED_GX_HLE_TEXTURES=1 it is queued behind the GXLoadTexObj jobs whose tImage0/tMode0
+// it consumes instead of draining the queue first. It follows the same eligibility rules as the
+// texture load (no display-list recording, no partially buffered HLE FIFO command) and falls back
+// to the established synchronous path when the ring is full. The HLE wrapper keeps its guest
+// write (__GXData+2) on the producer.
+namespace texture_detail {
+template <auto Function>
+struct SuTexRegsCommand {
+    static void Execute(const void*) { Function(); }
+};
+} // namespace texture_detail
+
+template <> struct Dispatch<&::__GXSetSUTexRegs> {
+    template <auto Function = &::__GXSetSUTexRegs>
+    static void Invoke() {
+        if (!Intercept() || Synchronous()) {
+            Function();
+            return;
+        }
+        if (!texture_detail::TextureLoadEnabled() || !texture_detail::TextureLoadStateAllowsOffload()) {
+            SynchronousScope scope("__GXSetSUTexRegs (sync: ineligible)");
+            Function();
+            return;
+        }
+        if (queue.TrySubmit(&texture_detail::SuTexRegsCommand<Function>::Execute, nullptr, 0)) return;
+        SynchronousScope scope("__GXSetSUTexRegs (sync: ring full)");
+        Function();
+    }
+};
+
+} // namespace hle::gx::offload
