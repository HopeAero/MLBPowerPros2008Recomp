+struct In {
+    uint32_t r1, r2, r3, r4, r13, cr, xer, gqr0;
+};
+struct Out {
+    uint32_t r0, r3, r4, r5, r6, r7, r8, r10, cr, ctr;
+    uint64_t f[14];  // f0-f13
+};
