+            }),
+            new IrBasicBlock("b", new IrInstruction[]
+            {
+                Inc("r6"),
+                new IrJump("merge")
+            }),
+            new IrBasicBlock("merge", new IrInstruction[]
+            {
+                new IrReturn(null)
+            })
+        });
+
+        var code = Emit(function);
