+        Assert.True(call > 0);
+        Assert.DoesNotContain("ctx->gpr[3] = r3;", code[call..], StringComparison.Ordinal);
+        Assert.Contains("ctx->gpr[4] = r4;", code[call..], StringComparison.Ordinal);
