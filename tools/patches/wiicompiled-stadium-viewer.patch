diff --git a/runtime/tests/stadium_viewer_tests.cpp b/runtime/tests/stadium_viewer_tests.cpp
new file mode 100644
index 0000000..e2f9974
--- /dev/null
+++ b/runtime/tests/stadium_viewer_tests.cpp
@@ -0,0 +1,30 @@
+#include "stadium_viewer.h"
+#include <cmath>
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-4f; };
+    using stadium_viewer::ParseConfig;
+
+    require(!ParseConfig(L"", L"", L"").has_value());
+
+    // Spaces, parentheses and accents survive (the env is read as UTF-16).
+    auto c = ParseConfig(L"C:\\Temp\\Vista previa (Jos\u00e9)", L"", L"");
+    require(c.has_value());
+    require(c->modDir == std::filesystem::path(L"C:\\Temp\\Vista previa (Jos\u00e9)"));
+    require(c->code == "pp_preview");
+    require(!c->camera.has_value());
+
+    c = ParseConfig(L"D:\\m", L"mario", L"12.5,30,-400,0.5,-0.25,45");
+    require(c && c->code == "mario" && c->camera.has_value());
+    require(near(c->camera->eye[0], 12.5f) && near(c->camera->eye[1], 30.0f) && near(c->camera->eye[2], -400.0f));
+    require(near(c->camera->yaw, 0.5f) && near(c->camera->pitch, -0.25f) && near(c->camera->fovY, 45.0f));
+
+    // A malformed camera is dropped; the rest of the config stays.
+    c = ParseConfig(L"D:\\m", L"", L"1,2,3");
+    require(c && !c->camera.has_value());
+    c = ParseConfig(L"D:\\m", L"", L"1,2,3,x,0,45");
+    require(c && !c->camera.has_value());
+    c = ParseConfig(L"D:\\m", L"", L"1,2,3,0,0,45,7");
+    require(c && !c->camera.has_value());
+}
