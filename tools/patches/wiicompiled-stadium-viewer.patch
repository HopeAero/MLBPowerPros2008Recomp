diff --git a/runtime/src/stadium_viewer.cpp b/runtime/src/stadium_viewer.cpp
new file mode 100644
index 0000000..6a8d088
--- /dev/null
+++ b/runtime/src/stadium_viewer.cpp
@@ -0,0 +1,67 @@
+#include "stadium_viewer.h"
+
+#include <cstdlib>
+#include <cwchar>
+#include <sstream>
+#include <vector>
+
+namespace stadium_viewer {
+namespace {
+
+std::wstring Env(const wchar_t* name) {
+#if defined(_WIN32)
+    const wchar_t* value = _wgetenv(name);  // UTF-16: paths with accents survive
+    return value ? value : L"";
+#else
+    std::string narrow(name, name + std::wcslen(name));
+    const char* value = std::getenv(narrow.c_str());
+    return value ? std::filesystem::path(value).wstring() : L"";  // UTF-8 on these systems
+#endif
+}
+
+std::optional<CameraPose> ParseCamera(const std::wstring& text) {
+    std::vector<float> values;
+    std::wstringstream in(text);
+    std::wstring field;
+    while (std::getline(in, field, L',')) {
+        wchar_t* end = nullptr;
+        const float v = std::wcstof(field.c_str(), &end);
+        if (field.empty() || end != field.c_str() + field.size()) return std::nullopt;
+        values.push_back(v);
+    }
+    if (values.size() != 6) return std::nullopt;
+    return CameraPose{{values[0], values[1], values[2]}, values[3], values[4], values[5]};
+}
+
+}  // namespace
+
+std::optional<Config> ParseConfig(const std::wstring& modDir, const std::wstring& code, const std::wstring& camera) {
+    if (modDir.empty()) return std::nullopt;
+    Config config;
+    config.modDir = std::filesystem::path(modDir);
+    config.code = code.empty() ? "pp_preview" : std::filesystem::path(code).string();
+    if (!camera.empty()) config.camera = ParseCamera(camera);
+    return config;
+}
+
+const std::optional<Config>& Active() {
+    static const std::optional<Config> active = [] {
+        auto config = ParseConfig(Env(L"WIICOMPILED_STADIUM_VIEWER"), Env(L"WIICOMPILED_STADIUM_VIEWER_CODE"),
+                                  Env(L"WIICOMPILED_STADIUM_VIEWER_CAMERA"));
+        // The Wii Remote strap warning waits 21 s for A: press it twice, before the pad script is read
+        // (first PADRead). Measured: the stadium is then on screen about 8 s after launch.
+        if (config && Env(L"WIICOMPILED_PAD_SCRIPT").empty()) {
+#if defined(_WIN32)
+            _wputenv(L"WIICOMPILED_PAD_SCRIPT=2500-2700:100,3500-3700:100");
+#else
+            setenv("WIICOMPILED_PAD_SCRIPT", "2500-2700:100,3500-3700:100", 1);
+#endif
+        }
+        return config;
+    }();
+    return active;
+}
+
+bool Enabled() { return Active().has_value(); }
+
+}  // namespace stadium_viewer
diff --git a/runtime/src/stadium_viewer_input.cpp b/runtime/src/stadium_viewer_input.cpp
new file mode 100644
index 0000000..94abd76
--- /dev/null
+++ b/runtime/src/stadium_viewer_input.cpp
@@ -0,0 +1,111 @@
+// Stadium viewer controls (host thread, once per presented frame): the free camera and the game's match
+// shots. Keys: W/A/S/D move, Q down, E up, Shift fast, right mouse button + mouse to look, wheel for
+// speed; 1 batter, 2 play, 3 wide (the game's own cameras); F back to the free camera; H hides the help.
+#include <SDL3/SDL.h>
+#include <imgui.h>
+#include <aurora/aurora.h>
+
+#include <optional>
+
+#include "free_camera.h"
+#include "mlb_camera.h"
+#include "power_pros_ui.h"
+#include "runtime_config.h"
+#include "stadium_viewer.h"
+
+namespace stadium_viewer {
+namespace {
+
+std::optional<FreeCamera> g_free;  // set while the free camera drives the view
+bool g_started = false;
+bool g_initialFree = false;  // the Blender view, once the batter shot is in
+bool g_help = true;
+bool g_previous[SDL_SCANCODE_COUNT] = {};
+
+bool Pressed(const bool* keys, SDL_Scancode key) {  // went down this frame
+    const bool down = keys[key];
+    const bool edge = down && !g_previous[key];
+    g_previous[key] = down;
+    return edge;
+}
+
+void StartFree(const CameraPose& from) {
+    g_free.emplace(from);
+    game_camera::SetOverride(g_free->Pose());
+}
+
+}  // namespace
+
+void OnHostFrame() {
+    if (!Enabled() || !StadiumReady()) return;
+    if (!g_started) {
+        g_started = true;
+        // Only the stadium: no 2D HUD.
+        aurora_set_draw_filter(AURORA_DRAW_FILTER_HUD);
+        // The batter shot first: applying a shot ends the camera's opening fly-over, which would
+        // otherwise keep moving the view under the free camera.
+        const bool shown = game_camera::ShowMatchView(game_camera::MatchView::Batter);
+        g_initialFree = Active()->camera.has_value();
+        if (g_initialFree && !shown) {
+            StartFree(*Active()->camera);
+            g_initialFree = false;
+        }
+    }
+    if (g_initialFree && !game_camera::MatchViewPending()) {
+        StartFree(*Active()->camera);  // where the Blender view was
+        g_initialFree = false;
+    }
+    const bool* keys = SDL_GetKeyboardState(nullptr);
+    const ImGuiIO& io = ImGui::GetIO();
+    if (Pressed(keys, SDL_SCANCODE_H)) g_help = !g_help;
+    const SDL_Scancode viewKeys[3] = {SDL_SCANCODE_1, SDL_SCANCODE_2, SDL_SCANCODE_3};
+    for (int i = 0; i < 3; ++i) {
+        if (Pressed(keys, viewKeys[i]) && game_camera::ShowMatchView(static_cast<game_camera::MatchView>(i))) g_free.reset();
+    }
+    FreeCameraInput in;
+    in.forward = keys[SDL_SCANCODE_W];
+    in.back = keys[SDL_SCANCODE_S];
+    in.left = keys[SDL_SCANCODE_A];
+    in.right = keys[SDL_SCANCODE_D];
+    in.down = keys[SDL_SCANCODE_Q];
+    in.up = keys[SDL_SCANCODE_E];
+    in.fast = keys[SDL_SCANCODE_LSHIFT] || keys[SDL_SCANCODE_RSHIFT];
+    in.look = ImGui::IsMouseDown(ImGuiMouseButton_Right);
+    in.mouseDx = io.MouseDelta.x;
+    in.mouseDy = io.MouseDelta.y;
+    in.wheel = io.MouseWheel;
+    in.dt = io.DeltaTime;
+    const bool moving = in.forward || in.back || in.left || in.right || in.up || in.down ||
+                        (in.look && (in.mouseDx != 0 || in.mouseDy != 0));
+    // F, or moving while a match shot is shown, takes the free camera from where the game's camera is.
+    if (!g_free && (Pressed(keys, SDL_SCANCODE_F) || moving)) {
+        if (const auto pose = game_camera::CurrentPose()) StartFree(*pose);
+    } else {
+        Pressed(keys, SDL_SCANCODE_F);  // keep the edge state current
+    }
+    if (g_free) {
+        g_free->Update(in);
+        game_camera::SetOverride(g_free->Pose());
+    }
+}
+
+void DrawHelp() {
+    if (!Enabled() || !StadiumReady() || !g_help) return;
+    using power_pros_ui::Lang;
+    const Lang lang = power_pros_ui::LangFromSetting(RuntimeConfigFile::UiLanguage("auto"));
+    const bool en = lang == Lang::En;
+    ImGui::SetNextWindowPos(ImVec2(12, 12), ImGuiCond_Always);
+    ImGui::SetNextWindowBgAlpha(0.55f);
+    if (ImGui::Begin("##viewer-help", nullptr,
+                     ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoInputs |
+                         ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing)) {
+        ImGui::TextUnformatted(en ? "Stadium preview" : "Vista previa del estadio");
+        ImGui::TextDisabled(en ? "WASD move  Q/E down/up  Shift fast  right mouse look  wheel speed"
+                               : "WASD mover  Q/E bajar/subir  Shift rapido  clic derecho mirar  rueda velocidad");
+        ImGui::TextDisabled(en ? "1 batter  2 play  3 wide  F free camera  H hide"
+                               : "1 bateador  2 jugada  3 lejana  F camara libre  H ocultar");
+    }
+    ImGui::End();
+}
+
+}  // namespace stadium_viewer
diff --git a/runtime/tests/free_camera_tests.cpp b/runtime/tests/free_camera_tests.cpp
new file mode 100644
index 0000000..8517fb1
--- /dev/null
+++ b/runtime/tests/free_camera_tests.cpp
@@ -0,0 +1,86 @@
+#include "free_camera.h"
+#include <cmath>
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-3f; };
+    using namespace stadium_viewer;
+    const CameraPose origin{{0, 0, 0}, 0, 0, 45};
+    // Simulated time in 0.05 s frames (Update clamps a frame to 0.1 s); one-frame inputs use a short step.
+    const auto step = [](FreeCamera& cam, FreeCameraInput in, float seconds) {
+        for (float left = seconds; left > 1e-6f; left -= 0.05f) {
+            in.dt = left < 0.05f ? left : 0.05f;
+            cam.Update(in);
+            in.wheel = 0;  // a wheel notch counts once
+            in.mouseDx = in.mouseDy = 0;
+        }
+    };
+
+    {  // forward 1 s at yaw 0: 100 dm towards second base (-Z), nothing in Y
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.forward = true;
+        step(cam, in, 1.0f);
+        require(near(cam.Pose().eye[0], 0) && near(cam.Pose().eye[1], 0) && near(cam.Pose().eye[2], -100));
+    }
+    {  // right 1 s: towards first base (+X), the way positive yaw turns
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.right = true;
+        step(cam, in, 1.0f);
+        require(near(cam.Pose().eye[0], 100) && near(cam.Pose().eye[2], 0));
+    }
+    {  // up 0.5 s: +50 in world Y; fast + forward 1 s: 400 dm
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.up = true;
+        step(cam, in, 0.5f);
+        require(near(cam.Pose().eye[1], 50));
+        FreeCamera fast(origin);
+        FreeCameraInput f{};
+        f.forward = f.fast = true;
+        step(fast, f, 1.0f);
+        require(near(fast.Pose().eye[2], -400));
+    }
+    {  // mouse looks only while `look`; pitch stops at +89 degrees
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.mouseDy = -100000;
+        step(cam, in, 0.016f);
+        require(near(cam.Pose().pitch, 0));
+        in.look = true;
+        step(cam, in, 0.016f);
+        require(near(cam.Pose().pitch, 89.0f * 3.14159265f / 180.0f));
+    }
+    {  // wheel scales the speed within [10, 2000] dm/s
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.wheel = 100;
+        step(cam, in, 0.016f);
+        require(near(cam.Speed(), 2000));
+        in.wheel = -100;
+        step(cam, in, 0.016f);
+        require(near(cam.Speed(), 10));
+    }
+    {  // a single long frame moves like 0.1 s
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.forward = true;
+        in.dt = 5.0f;
+        cam.Update(in);
+        require(near(cam.Pose().eye[2], -10));
+    }
+    {  // extreme positions and pitch: never NaN or infinity
+        FreeCamera cam({{1e6f, -1e6f, 1e6f}, 0, 0, 45});
+        FreeCameraInput in{};
+        in.look = in.forward = in.left = in.up = true;
+        for (int i = 0; i < 100; ++i) {
+            in.mouseDx = (i % 2 ? 1e5f : -1e5f);
+            in.mouseDy = (i % 3 ? 1e5f : -1e5f);
+            step(cam, in, 0.05f);
+        }
+        const auto& p = cam.Pose();
+        require(std::isfinite(p.eye[0]) && std::isfinite(p.eye[1]) && std::isfinite(p.eye[2]));
+        require(std::isfinite(p.yaw) && std::isfinite(p.pitch) && std::fabs(p.pitch) <= 89.0f * 3.14159265f / 180.0f + 1e-4f);
+    }
+}
diff --git a/runtime/tests/game_camera_tests.cpp b/runtime/tests/game_camera_tests.cpp
new file mode 100644
index 0000000..063f62c
--- /dev/null
+++ b/runtime/tests/game_camera_tests.cpp
@@ -0,0 +1,37 @@
+#include "mlb_camera.h"
+#include <cmath>
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-3f; };
+    using namespace game_camera;
+    float eye[3], target[3];
+
+    // yaw 0, pitch 0: looking towards second base (-Z), target 100 dm ahead.
+    PoseToEyeTarget({{0, 30, 90}, 0, 0, 45}, eye, target);
+    require(near(eye[0], 0) && near(eye[1], 30) && near(eye[2], 90));
+    require(near(target[0], 0) && near(target[1], 30) && near(target[2], -10));
+
+    // Positive yaw turns towards first base (+X).
+    PoseToEyeTarget({{0, 0, 0}, 1.5707963f, 0, 45}, eye, target);
+    require(near(target[0], 100) && near(target[2], 0));
+
+    // Positive pitch looks up.
+    PoseToEyeTarget({{0, 0, 0}, 0, 0.5f, 45}, eye, target);
+    require(target[1] > 40 && target[2] < 0);
+
+    // Round trip, including the game's own batter view (eye behind home, target past the mound).
+    const float gameEye[3] = {2.0869f, 15.5095f, 59.5611f}, gameTarget[3] = {-8.9952f, -1.7186f, -229.0464f};
+    const auto pose = EyeTargetToPose(gameEye, gameTarget, 48.8f);
+    require(near(pose.eye[0], gameEye[0]) && near(pose.eye[2], gameEye[2]) && near(pose.fovY, 48.8f));
+    require(pose.yaw < 0 && pose.pitch < 0);  // slightly towards third base and down
+    PoseToEyeTarget(pose, eye, target);
+    const float dx = gameTarget[0] - gameEye[0], dy = gameTarget[1] - gameEye[1], dz = gameTarget[2] - gameEye[2];
+    const float len = std::sqrt(dx * dx + dy * dy + dz * dz);
+    require(near(target[0] - eye[0], dx / len * 100) && near(target[1] - eye[1], dy / len * 100) &&
+            near(target[2] - eye[2], dz / len * 100));
+
+    // Eye and target at the same point: no NaN.
+    const auto same = EyeTargetToPose(gameEye, gameEye, 45);
+    require(std::isfinite(same.yaw) && std::isfinite(same.pitch));
+}
