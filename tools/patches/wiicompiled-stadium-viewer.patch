diff --git a/runtime/include/stadium_viewer.h b/runtime/include/stadium_viewer.h
new file mode 100644
index 0000000..e5ef1ab
--- /dev/null
+++ b/runtime/include/stadium_viewer.h
@@ -0,0 +1,36 @@
+#pragma once
+// Stadium viewer: the Blender add-on's "View in game" opens the game straight into the stadium being
+// made, from a one-run preview mod, with a free camera. Enabled by environment variables:
+//   WIICOMPILED_STADIUM_VIEWER        the preview mod's folder (the only mod loaded in that run)
+//   WIICOMPILED_STADIUM_VIEWER_CODE   the stadium code it declares (default pp_preview)
+//   WIICOMPILED_STADIUM_VIEWER_CAMERA "x,y,z,yaw,pitch,fov": initial free camera
+// Spec: docs/superpowers/specs/2026-10-18-stadium-preview-design.md
+#include <filesystem>
+#include <optional>
+#include <string>
+
+namespace stadium_viewer {
+
+// Game frame: decimetres, Y up, home plate at the origin, second base towards -Z. yaw in radians,
+// 0 = looking towards second base, positive towards first base; pitch in radians, positive up;
+// fovY in degrees.
+struct CameraPose {
+    float eye[3];
+    float yaw;
+    float pitch;
+    float fovY;
+};
+
+struct Config {
+    std::filesystem::path modDir;
+    std::string code;
+    std::optional<CameraPose> camera;
+};
+
+// Empty modDir: no viewer. Empty code: "pp_preview". A malformed camera is dropped.
+std::optional<Config> ParseConfig(const std::wstring& modDir, const std::wstring& code, const std::wstring& camera);
+const std::optional<Config>& Active();  // read once from the environment
+bool Enabled();
+bool StadiumReady();  // the preview stadium is on screen (match_benchmark.cpp)
+
+}  // namespace stadium_viewer
diff --git a/runtime/src/hle/mlb/game_camera.cpp b/runtime/src/hle/mlb/game_camera.cpp
new file mode 100644
index 0000000..7c390ab
--- /dev/null
+++ b/runtime/src/hle/mlb/game_camera.cpp
@@ -0,0 +1,193 @@
+// MLB Power Pros 2008 (RL8E54) game-specific natives: the match camera, for the stadium viewer's free
+// camera and match views (docs/ingenieria-inversa.md, "Cámara del partido").
+//
+// Camera objects (vtable 0x801568AC) keep eye (+0x40), target (+0x60) and up (+0x70) as (x, y, z, 1) in
+// game units (decimetres, Y up, second base towards -Z), the projection's cot(fovY/2) at +0x94 and the
+// view matrix at +0x154.
+// - 0x80055D24 rebuilds the view every frame: LookAt (0x80055620) into +0x154, then the viewing
+//   direction (target - eye, 0x8006327C) through 0x80060588 into +0x184. Decompiled here; while the
+//   viewer overrides the camera, eye, target and up are written into the main camera first.
+// - 0x80C779D4 is the match camera director: it copies a source camera (one per shot, kept up to date by
+//   its own controller) into the main camera with 0x80055300. Decompiled here; it also records the main
+//   camera and each source camera by the caller that applies it, so the viewer can show those shots.
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "mlb_camera.h"
+
+namespace mlb_camera_native {
+
+constexpr uint32_t kLookAt = 0x80055620, kVecSub = 0x8006327C, kSetDirection = 0x80060588;
+constexpr uint32_t kFindCamera = 0x80061CF8, kCopyCamera = 0x80055300, kSceneNotify = 0x80C6217C;
+constexpr uint32_t kEye = 0x40, kTarget = 0x60, kUp = 0x70, kView = 0x154, kDirection = 0x184, kCot = 0x94;
+// Callers of the director, one per shot (seen in a 2-minute AI match on 18 October 2026).
+constexpr uint32_t kBatterCaller = 0x80CC5BE8, kPlayCaller = 0x808F1CD8, kWideCaller = 0x80AA0BA4;
+// The eye/target the game used for the play and wide shots, for when the director has not used them yet.
+constexpr float kPlayEye[3] = {328.6f, 184.8f, 102.7f}, kPlayTarget[3] = {0.0f, 0.0f, -120.1f};
+constexpr float kWideEye[3] = {-570.5f, 200.0f, -560.5f}, kWideTarget[3] = {-4.8f, 5.0f, -189.1f};
+
+std::mutex g_lock;
+std::atomic<bool> g_override{false};
+stadium_viewer::CameraPose g_pose{};
+std::optional<stadium_viewer::CameraPose> g_current;
+std::atomic<uint32_t> g_mainCamera{0}, g_director{0};
+std::array<std::atomic<uint32_t>, 3> g_sources{};  // by MatchView
+std::atomic<int> g_request{-1};
+
+float ReadF(uint32_t a) {
+    const uint32_t v = Memory::Read32(a);
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+void WriteF(uint32_t a, float f) {
+    uint32_t v;
+    std::memcpy(&v, &f, 4);
+    Memory::Write32(a, v);
+}
+void WriteVec(uint32_t a, const float v[3]) {
+    for (int i = 0; i < 3; ++i) WriteF(a + 4 * i, v[i]);
+    WriteF(a + 12, 1.0f);
+}
+
+void Call(CpuContext* cpu, uint32_t target, uint32_t a, uint32_t b = 0, uint32_t c = 0, uint32_t d = 0) {
+    cpu->gpr[3] = a;
+    cpu->gpr[4] = b;
+    cpu->gpr[5] = c;
+    cpu->gpr[6] = d;
+    InvokeIndirectCpu(target, cpu);
+}
+
+// Runs `body` with a fresh 16-byte-aligned guest stack frame (scratch at sp+16), like the originals.
+template <typename Body>
+void WithFrame(CpuContext* cpu, uint32_t size, Body body) {
+    const uint32_t savedSp = cpu->gpr[1];
+    cpu->gpr[1] = (savedSp - size) & ~0xFu;
+    Memory::Write32(cpu->gpr[1], savedSp);
+    body();
+    cpu->gpr[1] = savedSp;
+}
+
+void UpdateView(CpuContext* cpu, uint32_t cam) {
+    const uint32_t main = g_mainCamera.load(std::memory_order_acquire);
+    if (g_override.load(std::memory_order_acquire) && (main == 0 || cam == main)) {
+        float eye[3], target[3];
+        {
+            std::lock_guard<std::mutex> lock(g_lock);
+            game_camera::PoseToEyeTarget(g_pose, eye, target);
+        }
+        const float up[3] = {0.0f, 1.0f, 0.0f};
+        WriteVec(cam + kEye, eye);
+        WriteVec(cam + kTarget, target);
+        WriteVec(cam + kUp, up);
+    }
+    Call(cpu, kLookAt, cam + kView, cam + kEye, cam + kUp, cam + kTarget);
+    const uint32_t dir = cpu->gpr[1] + 16;
+    Call(cpu, kVecSub, dir, cam + kEye, cam + kTarget);
+    cpu->fpr[1].d = ReadF(dir);
+    cpu->fpr[2].d = ReadF(dir + 4);
+    cpu->fpr[3].d = ReadF(dir + 8);
+    Call(cpu, kSetDirection, cam + kDirection);
+
+    if (main != 0 && cam != main) return;
+    const float eye[3] = {ReadF(cam + kEye), ReadF(cam + kEye + 4), ReadF(cam + kEye + 8)};
+    const float target[3] = {ReadF(cam + kTarget), ReadF(cam + kTarget + 4), ReadF(cam + kTarget + 8)};
+    const float cot = ReadF(cam + kCot);
+    const float fovY = cot > 0.0f ? 2.0f * std::atan(1.0f / cot) * 57.29578f : 45.0f;
+    std::lock_guard<std::mutex> lock(g_lock);
+    g_current = game_camera::EyeTargetToPose(eye, target, fovY);
+}
+
+// The director's body: copy `source` into the main camera and let the scene know.
+void ApplySource(CpuContext* cpu, uint32_t director, uint32_t source) {
+    if (static_cast<int32_t>(Memory::Read32(director + 64)) != 5 || source == 0) return;
+    const uint32_t scene = Memory::Read32(director + 60);
+    if (scene == 0) return;
+    Call(cpu, kFindCamera, Memory::Read32(scene + 732), 0);
+    const uint32_t main = cpu->gpr[3];
+    if (main == 0) return;
+    g_mainCamera.store(main, std::memory_order_release);
+    Call(cpu, kCopyCamera, main, source);
+    Memory::Write8(main + 128, Memory::Read8(main + 128) | 2);
+    Call(cpu, Memory::Read32(Memory::Read32(main) + 24), main);  // virtual, slot 24
+    Call(cpu, kSceneNotify, Memory::Read32(director + 60) + 64);
+    const uint32_t sceneNow = Memory::Read32(director + 60);
+    Call(cpu, Memory::Read32(Memory::Read32(sceneNow) + 116), sceneNow);  // virtual, slot 116
+}
+
+int ViewOfCaller(uint32_t lr) {
+    if (lr == kBatterCaller) return static_cast<int>(game_camera::MatchView::Batter);
+    if (lr == kPlayCaller) return static_cast<int>(game_camera::MatchView::Play);
+    if (lr == kWideCaller) return static_cast<int>(game_camera::MatchView::Wide);
+    return -1;
+}
+
+}  // namespace mlb_camera_native
+
+namespace game_camera {
+
+void SetOverride(const stadium_viewer::CameraPose& pose) {
+    std::lock_guard<std::mutex> lock(mlb_camera_native::g_lock);
+    mlb_camera_native::g_pose = pose;
+    mlb_camera_native::g_override.store(true, std::memory_order_release);
+}
+
+void ClearOverride() { mlb_camera_native::g_override.store(false, std::memory_order_release); }
+
+bool OverrideActive() { return mlb_camera_native::g_override.load(std::memory_order_acquire); }
+
+bool ShowMatchView(MatchView view) {
+    if (mlb_camera_native::g_director.load() == 0) return false;
+    mlb_camera_native::g_request.store(static_cast<int>(view));
+    return true;
+}
+
+void OnGuestFrame(CpuContext* cpu) {
+    using namespace mlb_camera_native;
+    const int view = g_request.exchange(-1);
+    if (view < 0 || cpu == nullptr) return;
+    const uint32_t director = g_director.load(), source = g_sources[static_cast<size_t>(view)].load();
+    if (source != 0) {  // the game's own camera for that shot
+        ClearOverride();
+        WithFrame(cpu, 0x40, [&] { ApplySource(cpu, director, source); });
+        return;
+    }
+    if (view == static_cast<int>(MatchView::Batter)) return;  // always known once the match shows
+    const bool play = view == static_cast<int>(MatchView::Play);
+    const auto current = CurrentPose();
+    SetOverride(EyeTargetToPose(play ? kPlayEye : kWideEye, play ? kPlayTarget : kWideTarget,
+                                current ? current->fovY : 45.0f));
+}
+
+std::optional<stadium_viewer::CameraPose> CurrentPose() {
+    std::lock_guard<std::mutex> lock(mlb_camera_native::g_lock);
+    return mlb_camera_native::g_current;
+}
+
+}  // namespace game_camera
+
+extern "C" void MLB_CameraUpdateView_80055D24(CpuContext* ctx) {
+    const uint32_t cam = ctx->gpr[3];
+    mlb_camera_native::WithFrame(ctx, 0x40, [&] { mlb_camera_native::UpdateView(ctx, cam); });
+}
+PPC_NATIVE_OVERRIDE_VOID(80055D24, MLB_CameraUpdateView_80055D24, (CpuContext* ctx), (ctx));
+
+extern "C" void MLB_CameraDirector_80C779D4(CpuContext* ctx) {
+    using namespace mlb_camera_native;
+    const uint32_t director = ctx->gpr[3], source = ctx->gpr[4];
+    if (const int view = ViewOfCaller(ctx->lr); view >= 0 && source != 0) {
+        g_sources[static_cast<size_t>(view)].store(source);
+        g_director.store(director);
+    }
+    // While the viewer holds a shot, the game's director keeps its hands off the main camera.
+    if (game_camera::OverrideActive()) return;
+    WithFrame(ctx, 0x20, [&] { ApplySource(ctx, director, source); });
+}
+PPC_NATIVE_OVERRIDE_VOID(80C779D4, MLB_CameraDirector_80C779D4, (CpuContext* ctx), (ctx));
