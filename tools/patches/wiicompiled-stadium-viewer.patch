new file mode 100644
index 0000000..756f7fc
--- /dev/null
+++ b/runtime/src/stadium_collision.cpp
@@ -0,0 +1,145 @@
+#include "stadium_collision.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <unordered_set>
+
+namespace stadium_collision {
+namespace {
+
+uint32_t U32(const std::vector<uint8_t>& d, size_t o) {
+    return (uint32_t(d[o]) << 24) | (uint32_t(d[o + 1]) << 16) | (uint32_t(d[o + 2]) << 8) | d[o + 3];
+}
+uint16_t U16(const std::vector<uint8_t>& d, size_t o) { return uint16_t((d[o] << 8) | d[o + 1]); }
+float F32(const std::vector<uint8_t>& d, size_t o) {
+    const uint32_t v = U32(d, o);
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+std::optional<size_t> Pointer(const std::vector<uint8_t>& d, size_t o) {
+    const uint32_t p = U32(d, o);
+    if (p >> 30 != 1) return std::nullopt;
+    return p & 0x3FFFFFFFu;
+}
+
+}  // namespace
+
+std::optional<Mesh> Parse(const std::vector<uint8_t>& d) {
+    constexpr size_t kRootSize = 4 + 11 * 4;
+    if (d.size() < 0x20 + kRootSize) return std::nullopt;
+    // As tools/blender/powerpros_stadium/stadium_tbl.py: the root is the last {count, -> 0x20}.
+    std::optional<size_t> root;
+    for (size_t o = (d.size() - 8) & ~size_t{3}; o >= 0x20; o -= 4) {
+        if (U32(d, o + 4) == 0x40000020u && U32(d, o) > 0 && U32(d, o) < 0x1000) {
+            root = o;
+            break;
+        }
+    }
+    if (!root || *root + kRootSize > d.size()) return std::nullopt;
+    const auto verts = Pointer(d, *root + 4 + 5 * 4), head = Pointer(d, *root + 4 + 6 * 4);
+    if (!verts || !head || *head + 8 > d.size()) return std::nullopt;
+    const size_t ntri = U16(d, *head), nvert = U16(d, *head + 2);
+    if (*head + 8 + ntri * 8 > d.size() || *verts + nvert * 12 > d.size()) return std::nullopt;
+    Mesh mesh;
+    for (size_t i = 0; i < nvert; ++i)
+        mesh.vertices.push_back({F32(d, *verts + i * 12), F32(d, *verts + i * 12 + 4), F32(d, *verts + i * 12 + 8)});
+    for (size_t i = 0; i < ntri; ++i) {
+        const size_t o = *head + 8 + i * 8;
+        const std::array<uint16_t, 4> t{U16(d, o), U16(d, o + 2), U16(d, o + 4), U16(d, o + 6)};
+        if (t[0] < nvert && t[1] < nvert && t[2] < nvert) mesh.triangles.push_back(t);
+    }
+    return mesh;
+}
+
+std::vector<Edge> Edges(const Mesh& mesh) {
+    std::vector<Edge> out;
+    std::unordered_set<uint32_t> seen;
+    for (const auto& t : mesh.triangles) {
+        for (int k = 0; k < 3; ++k) {
+            const uint16_t a = std::min(t[k], t[(k + 1) % 3]), b = std::max(t[k], t[(k + 1) % 3]);
+            if (a != b && seen.insert((uint32_t(a) << 16) | b).second) out.push_back({a, b, t[3]});
+        }
+    }
+    return out;
+}
+
+bool Project(const View& v, const float a[3], const float b[3], float out[4]) {
+    constexpr float kNear = 5.0f;  // decimetres
+    float f[3] = {v.target[0] - v.eye[0], v.target[1] - v.eye[1], v.target[2] - v.eye[2]};
+    const float fl = std::sqrt(f[0] * f[0] + f[1] * f[1] + f[2] * f[2]);
+    if (fl <= 0.0f) return false;
+    for (float& c : f) c /= fl;
+    float s[3] = {-f[2], 0.0f, f[0]};  // f x up(0, 1, 0)
+    const float sl = std::sqrt(s[0] * s[0] + s[2] * s[2]);
+    if (sl < 1e-6f) return false;     // looking straight up or down
+    s[0] /= sl;
+    s[2] /= sl;
+    const float u[3] = {s[1] * f[2] - s[2] * f[1], s[2] * f[0] - s[0] * f[2], s[0] * f[1] - s[1] * f[0]};
+    auto toCamera = [&](const float p[3], float c[3]) {
+        const float d[3] = {p[0] - v.eye[0], p[1] - v.eye[1], p[2] - v.eye[2]};
+        c[0] = d[0] * s[0] + d[1] * s[1] + d[2] * s[2];
+        c[1] = d[0] * u[0] + d[1] * u[1] + d[2] * u[2];
+        c[2] = d[0] * f[0] + d[1] * f[1] + d[2] * f[2];
+    };
+    float ca[3], cb[3];
+    toCamera(a, ca);
+    toCamera(b, cb);
+    if (ca[2] < kNear && cb[2] < kNear) return false;
+    if (ca[2] < kNear || cb[2] < kNear) {  // cut at the near plane
+        float* behind = ca[2] < kNear ? ca : cb;
+        const float* front = ca[2] < kNear ? cb : ca;
+        const float t = (kNear - behind[2]) / (front[2] - behind[2]);
+        for (int k = 0; k < 3; ++k) behind[k] += (front[k] - behind[k]) * t;
+    }
+    const float ty = std::tan(v.fovY * 0.5f * 3.14159265f / 180.0f), tx = ty * v.w / v.h;
+    const float* cs[2] = {ca, cb};
+    for (int i = 0; i < 2; ++i) {
+        out[2 * i] = v.x + (cs[i][0] / (cs[i][2] * tx) + 1.0f) * 0.5f * v.w;
+        out[2 * i + 1] = v.y + (1.0f - cs[i][1] / (cs[i][2] * ty)) * 0.5f * v.h;
+    }
+    const bool left = out[0] < v.x && out[2] < v.x, right = out[0] > v.x + v.w && out[2] > v.x + v.w;
+    const bool top = out[1] < v.y && out[3] < v.y, bottom = out[1] > v.y + v.h && out[3] > v.y + v.h;
+    return !(left || right || top || bottom);
+}
+
+uint32_t SurfaceColor(uint16_t surface) {
+    switch (surface) {
+        case 0: return 0xFF9A1F;   // invisible wall, foul
+        case 1: return 0xFF2A2A;   // invisible wall, home run
+        case 2: return 0xB04CFF;   // outer limit
+        case 5: return 0x3CE03C;   // grass
+        case 6: return 0xC8843C;   // dirt
+        case 7: return 0xE8C070;   // warning track
+        case 8: return 0xFFD9A0;   // mound
+        case 9: return 0xFFF030;   // fences
+        case 11: return 0x40A0FF;  // stands
+        case 13: return 0x40F0F0;  // stand tops and roofs
+        case 14: return 0xFFFFFF;  // foul poles
+        case 15: return 0xFF70C0;  // backstop
+        default: return 0xA0A0A0;
+    }
+}
+
+bool ShownByDefault(uint16_t surface) { return surface > 2; }
+
+const char* SurfaceName(uint16_t surface, bool en) {
+    switch (surface) {
+        case 0: return en ? "Invisible wall (foul)" : "Pared invisible (foul)";
+        case 1: return en ? "Invisible wall (home run)" : "Pared invisible (home run)";
+        case 2: return en ? "Outer limit" : "Limite exterior";
+        case 5: return en ? "Grass" : "Cesped";
+        case 6: return en ? "Dirt" : "Tierra";
+        case 7: return en ? "Warning track" : "Pista de aviso";
+        case 8: return en ? "Mound" : "Monticulo";
+        case 9: return en ? "Fences" : "Vallas";
+        case 11: return en ? "Stands" : "Gradas";
+        case 13: return en ? "Stand tops, roofs" : "Techos y gradas altas";
+        case 14: return en ? "Foul poles" : "Postes de foul";
+        case 15: return en ? "Backstop" : "Backstop";
+        default: return nullptr;
+    }
+}
+
+}  // namespace stadium_collision
diff --git a/runtime/src/stadium_viewer.cpp b/runtime/src/stadium_viewer.cpp
new file mode 100644
index 0000000..6a8d088
--- /dev/null
+++ b/runtime/src/stadium_viewer.cpp
@@ -0,0 +1,67 @@
+#include "stadium_viewer.h"
+
+#include <cstdlib>
+#include <cwchar>
+#include <sstream>
+#include <vector>
+
+namespace stadium_viewer {
+namespace {
+
+std::wstring Env(const wchar_t* name) {
+#if defined(_WIN32)
+    const wchar_t* value = _wgetenv(name);  // UTF-16: paths with accents survive
+    return value ? value : L"";
+#else
+    std::string narrow(name, name + std::wcslen(name));
+    const char* value = std::getenv(narrow.c_str());
+    return value ? std::filesystem::path(value).wstring() : L"";  // UTF-8 on these systems
+#endif
+}
+
+std::optional<CameraPose> ParseCamera(const std::wstring& text) {
+    std::vector<float> values;
+    std::wstringstream in(text);
+    std::wstring field;
+    while (std::getline(in, field, L',')) {
+        wchar_t* end = nullptr;
+        const float v = std::wcstof(field.c_str(), &end);
+        if (field.empty() || end != field.c_str() + field.size()) return std::nullopt;
+        values.push_back(v);
+    }
+    if (values.size() != 6) return std::nullopt;
+    return CameraPose{{values[0], values[1], values[2]}, values[3], values[4], values[5]};
+}
+
+}  // namespace
+
+std::optional<Config> ParseConfig(const std::wstring& modDir, const std::wstring& code, const std::wstring& camera) {
+    if (modDir.empty()) return std::nullopt;
+    Config config;
+    config.modDir = std::filesystem::path(modDir);
+    config.code = code.empty() ? "pp_preview" : std::filesystem::path(code).string();
+    if (!camera.empty()) config.camera = ParseCamera(camera);
+    return config;
+}
+
+const std::optional<Config>& Active() {
+    static const std::optional<Config> active = [] {
+        auto config = ParseConfig(Env(L"WIICOMPILED_STADIUM_VIEWER"), Env(L"WIICOMPILED_STADIUM_VIEWER_CODE"),
+                                  Env(L"WIICOMPILED_STADIUM_VIEWER_CAMERA"));
+        // The Wii Remote strap warning waits 21 s for A: press it twice, before the pad script is read
+        // (first PADRead). Measured: the stadium is then on screen about 8 s after launch.
+        if (config && Env(L"WIICOMPILED_PAD_SCRIPT").empty()) {
+#if defined(_WIN32)
+            _wputenv(L"WIICOMPILED_PAD_SCRIPT=2500-2700:100,3500-3700:100");
+#else
+            setenv("WIICOMPILED_PAD_SCRIPT", "2500-2700:100,3500-3700:100", 1);
+#endif
+        }
+        return config;
+    }();
+    return active;
+}
+
+bool Enabled() { return Active().has_value(); }
+
+}  // namespace stadium_viewer
diff --git a/runtime/src/stadium_viewer_input.cpp b/runtime/src/stadium_viewer_input.cpp
new file mode 100644
index 0000000..e0bc15d
--- /dev/null
+++ b/runtime/src/stadium_viewer_input.cpp
@@ -0,0 +1,241 @@
+// Stadium viewer controls (host thread, once per presented frame): the free camera and the game's match
+// shots. Keys: W/A/S/D move, Q down, E up, Shift fast, right mouse button + mouse to look, wheel for
+// speed; 1 batter, 2 play, 3 wide (the game's own cameras); F back to the free camera; C shows the
+// stadium's collision over the picture (stadium_collision.h); H hides the help.
+#include <SDL3/SDL.h>
+#include <imgui.h>
+#include <aurora/aurora.h>
+
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <optional>
+
+#include "aurora_events.h"
+#include "free_camera.h"
+#include "mlb_camera.h"
+#include "power_pros_ui.h"
+#include "runtime_config.h"
+#include "stadium_collision.h"
+#include "stadium_viewer.h"
+
+namespace stadium_viewer {
+namespace {
+
+std::optional<FreeCamera> g_free;  // set while the free camera drives the view
+bool g_started = false;
+bool g_initialFree = false;  // the Blender view, once the batter shot is in
+bool g_help = true;
+bool g_previous[SDL_SCANCODE_COUNT] = {};
+bool g_collision = false;
+// Free camera poses of the last host frames, newest first: the picture on screen was drawn with an older
+// one than the pose just set, and the collision lines must use that same one or they slide while moving.
+std::array<CameraPose, 4> g_poses{};
+size_t g_poseCount = 0;
+// The picture on screen is one host frame behind: measured turning the camera at 3 rad/s, the lines sit
+// on the stadium with the pose of the previous frame (ahead with the current one, behind with older ones).
+constexpr size_t kOverlayDelay = 1;
+float g_spin = 0.0f;  // rad/s; WIICOMPILED_STADIUM_VIEWER_SPIN turns the free camera (tests)
+struct Collision {
+    stadium_collision::Mesh mesh;
+    std::vector<stadium_collision::Edge> edges;
+    std::map<uint16_t, size_t> counts;  // triangles per surface, for the legend
+    std::map<uint16_t, bool> shown;     // the legend's ticks
+};
+std::optional<std::optional<Collision>> g_loaded;  // outer: tried; inner: found
+
+// The preview mod's table pack, read once.
+std::optional<Collision>& LoadedCollision() {
+    if (!g_loaded) {
+        const auto& config = *Active();
+        std::ifstream in(config.modDir / "project" / ("stadium_" + config.code + "tbl.pack"), std::ios::binary);
+        const std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+        std::optional<Collision> c;
+        if (auto mesh = stadium_collision::Parse(bytes)) {
+            c.emplace();
+            c->mesh = std::move(*mesh);
+            c->edges = stadium_collision::Edges(c->mesh);
+            for (const auto& t : c->mesh.triangles) ++c->counts[t[3]];
+            for (const auto& [surface, count] : c->counts) c->shown[surface] = stadium_collision::ShownByDefault(surface);
+        }
+        g_loaded = std::move(c);
+    }
+    return *g_loaded;
+}
+
+bool Pressed(const bool* keys, SDL_Scancode key) {  // went down this frame
+    const bool down = keys[key];
+    const bool edge = down && !g_previous[key];
+    g_previous[key] = down;
+    return edge;
+}
+
+void StartFree(const CameraPose& from) {
+    g_free.emplace(from);
+    game_camera::SetOverride(g_free->Pose());
+}
+
+}  // namespace
+
+void OnHostFrame() {
+    if (!Enabled() || !StadiumReady()) return;
+    if (!g_started) {
+        g_started = true;
+        const char* collision = std::getenv("WIICOMPILED_STADIUM_VIEWER_COLLISION");  // 1: start with it shown
+        g_collision = collision && collision[0] == '1';
+        if (const char* spin = std::getenv("WIICOMPILED_STADIUM_VIEWER_SPIN")) g_spin = std::strtof(spin, nullptr);
+        // Only the stadium: no 2D HUD.
+        aurora_set_draw_filter(AURORA_DRAW_FILTER_HUD);
+        // The batter shot first: applying a shot ends the camera's opening fly-over, which would
+        // otherwise keep moving the view under the free camera.
+        const bool shown = game_camera::ShowMatchView(game_camera::MatchView::Batter);
+        g_initialFree = Active()->camera.has_value();
+        if (g_initialFree && !shown) {
+            StartFree(*Active()->camera);
+            g_initialFree = false;
+        }
+    }
+    if (g_initialFree && !game_camera::MatchViewPending()) {
+        StartFree(*Active()->camera);  // where the Blender view was
+        g_initialFree = false;
+    }
+    const bool* keys = SDL_GetKeyboardState(nullptr);
+    const ImGuiIO& io = ImGui::GetIO();
+    if (Pressed(keys, SDL_SCANCODE_H)) g_help = !g_help;
+    if (Pressed(keys, SDL_SCANCODE_C)) g_collision = !g_collision;
+    const SDL_Scancode viewKeys[3] = {SDL_SCANCODE_1, SDL_SCANCODE_2, SDL_SCANCODE_3};
+    for (int i = 0; i < 3; ++i) {
+        if (Pressed(keys, viewKeys[i]) && game_camera::ShowMatchView(static_cast<game_camera::MatchView>(i))) g_free.reset();
+    }
+    FreeCameraInput in;
+    in.forward = keys[SDL_SCANCODE_W];
+    in.back = keys[SDL_SCANCODE_S];
+    in.left = keys[SDL_SCANCODE_A];
+    in.right = keys[SDL_SCANCODE_D];
+    in.down = keys[SDL_SCANCODE_Q];
+    in.up = keys[SDL_SCANCODE_E];
+    in.fast = keys[SDL_SCANCODE_LSHIFT] || keys[SDL_SCANCODE_RSHIFT];
+    in.look = ImGui::IsMouseDown(ImGuiMouseButton_Right);
+    in.mouseDx = io.MouseDelta.x;
+    in.mouseDy = io.MouseDelta.y;
+    in.wheel = io.MouseWheel;
+    in.dt = io.DeltaTime;
+    const bool moving = in.forward || in.back || in.left || in.right || in.up || in.down ||
+                        (in.look && (in.mouseDx != 0 || in.mouseDy != 0));
+    // F, or moving while a match shot is shown, takes the free camera from where the game's camera is.
+    if (!g_free && (Pressed(keys, SDL_SCANCODE_F) || moving)) {
+        if (const auto pose = game_camera::CurrentPose()) StartFree(*pose);
+    } else {
+        Pressed(keys, SDL_SCANCODE_F);  // keep the edge state current
+    }
+    if (g_free && g_spin != 0.0f) {
+        in.look = true;
+        in.mouseDx = g_spin * in.dt / FreeCamera::kMouseRadiansPerPixel;
+        in.mouseDy = 0.0f;
+    }
+    if (g_free) {
+        g_free->Update(in);
+        game_camera::SetOverride(g_free->Pose());
+        std::copy_backward(g_poses.begin(), g_poses.end() - 1, g_poses.end());
+        g_poses[0] = g_free->Pose();
+        g_poseCount = std::min(g_poseCount + 1, g_poses.size());
+    } else {
+        g_poseCount = 0;
+    }
+}
+
+// The collision as lines over the picture, coloured by surface, seen through everything, and its legend
+// (a tick per surface, clicked with the left mouse button).
+void DrawCollision(bool en) {
+    auto& collision = LoadedCollision();
+    // The free camera: the pose the picture on screen was drawn with, but the game's field of view (the
+    // viewer moves and turns the game's camera, the game keeps its own lens). A match shot: the game's camera.
+    auto pose = game_camera::CurrentPose();
+    if (pose && g_poseCount > 0) {
+        const float fovY = pose->fovY;
+        pose = g_poses[std::min(kOverlayDelay, g_poseCount - 1)];
+        pose->fovY = fovY;
+    }
+    const ImGuiViewport* vp = ImGui::GetMainViewport();
+    if (!collision) {
+        ImGui::GetForegroundDrawList()->AddText(ImVec2(vp->Pos.x + 12, vp->Pos.y + vp->Size.y - 30), IM_COL32(255, 80, 80, 255),
+                                                en ? "No collision in this stadium's table" : "La tabla de este estadio no tiene colision");
+        return;
+    }
+    if (!pose) return;
+    stadium_collision::View view{};
+    game_camera::PoseToEyeTarget(*pose, view.eye, view.target);
+    view.fovY = pose->fovY;  // set below, once the picture's aspect is known
+    // The picture: 16:9 with bars when forced (the default), else the whole window.
+    view.x = vp->Pos.x, view.y = vp->Pos.y, view.w = vp->Size.x, view.h = vp->Size.y;
+    if (MkwForceAspect169Requested()) {
+        const float w = std::min(view.w, view.h * 16.0f / 9.0f), h = w * 9.0f / 16.0f;
+        view.x += (view.w - w) * 0.5f, view.y += (view.h - h) * 0.5f, view.w = w, view.h = h;
+    }
+    // The game's +0x94 is cot of half the horizontal angle (measured: lines 16:9 times too close to the
+    // centre when read as vertical), so the vertical angle depends on the picture's aspect.
+    view.fovY = 2.0f * std::atan(std::tan(pose->fovY * 0.5f * 3.14159265f / 180.0f) * view.h / view.w) * 180.0f / 3.14159265f;
+    ImDrawList* dl = ImGui::GetBackgroundDrawList();
+    const auto& v = collision->mesh.vertices;
+    float seg[4];
+    for (const auto& e : collision->edges) {
+        if (!collision->shown[e.surface] || !stadium_collision::Project(view, v[e.a].data(), v[e.b].data(), seg)) continue;
+        const uint32_t rgb = stadium_collision::SurfaceColor(e.surface);
+        dl->AddLine(ImVec2(seg[0], seg[1]), ImVec2(seg[2], seg[3]),
+                    IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, 200));
+    }
+    ImGui::SetNextWindowPos(ImVec2(vp->Pos.x + 12, vp->Pos.y + vp->Size.y - 12), ImGuiCond_Always, ImVec2(0, 1));
+    ImGui::SetNextWindowBgAlpha(0.65f);
+    if (ImGui::Begin("##viewer-collision", nullptr,
+                     ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                         ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing)) {
+        ImGui::Text(en ? "Collision: %zu triangles" : "Colision: %zu triangulos", collision->mesh.triangles.size());
+        const bool all = ImGui::SmallButton(en ? "All" : "Todo");
+        ImGui::SameLine();
+        const bool none = ImGui::SmallButton(en ? "None" : "Nada");
+        for (auto& [surface, on] : collision->shown) {
+            if (all || none) on = all;
+            const uint32_t rgb = stadium_collision::SurfaceColor(surface);
+            const ImVec2 p = ImGui::GetCursorScreenPos();
+            const float size = ImGui::GetFrameHeight();
+            ImGui::GetWindowDrawList()->AddRectFilled(ImVec2(p.x + 3, p.y + 3), ImVec2(p.x + size - 3, p.y + size - 3),
+                                                      IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, 255));
+            ImGui::Dummy(ImVec2(size, size));
+            ImGui::SameLine();
+            const char* name = stadium_collision::SurfaceName(surface, en);
+            char label[96];
+            if (name) std::snprintf(label, sizeof label, "%s (%u): %zu##s%u", name, unsigned(surface), collision->counts[surface], unsigned(surface));
+            else std::snprintf(label, sizeof label, en ? "Surface %u: %zu##s%u" : "Superficie %u: %zu##s%u", unsigned(surface),
+                               collision->counts[surface], unsigned(surface));
+            ImGui::Checkbox(label, &on);
+        }
+    }
+    ImGui::End();
+}
+
+void DrawHelp() {
+    if (!Enabled() || !StadiumReady()) return;
+    using power_pros_ui::Lang;
+    const Lang lang = power_pros_ui::LangFromSetting(RuntimeConfigFile::UiLanguage("auto"));
+    const bool en = lang == Lang::En;
+    if (g_collision) DrawCollision(en);
+    if (!g_help) return;
+    ImGui::SetNextWindowPos(ImVec2(12, 12), ImGuiCond_Always);
+    ImGui::SetNextWindowBgAlpha(0.55f);
+    if (ImGui::Begin("##viewer-help", nullptr,
+                     ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoInputs |
+                         ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing)) {
+        ImGui::TextUnformatted(en ? "Stadium preview" : "Vista previa del estadio");
+        ImGui::TextDisabled(en ? "WASD move  Q/E down/up  Shift fast  right mouse look  wheel speed"
+                               : "WASD mover  Q/E bajar/subir  Shift rapido  clic derecho mirar  rueda velocidad");
+        ImGui::TextDisabled(en ? "1 batter  2 play  3 wide  F free camera  C collision  H hide"
+                               : "1 bateador  2 jugada  3 lejana  F camara libre  C colision  H ocultar");
+    }
+    ImGui::End();
+}
+
+}  // namespace stadium_viewer
diff --git a/runtime/tests/free_camera_tests.cpp b/runtime/tests/free_camera_tests.cpp
new file mode 100644
index 0000000..8517fb1
--- /dev/null
+++ b/runtime/tests/free_camera_tests.cpp
@@ -0,0 +1,86 @@
+#include "free_camera.h"
+#include <cmath>
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-3f; };
+    using namespace stadium_viewer;
+    const CameraPose origin{{0, 0, 0}, 0, 0, 45};
+    // Simulated time in 0.05 s frames (Update clamps a frame to 0.1 s); one-frame inputs use a short step.
+    const auto step = [](FreeCamera& cam, FreeCameraInput in, float seconds) {
+        for (float left = seconds; left > 1e-6f; left -= 0.05f) {
+            in.dt = left < 0.05f ? left : 0.05f;
+            cam.Update(in);
+            in.wheel = 0;  // a wheel notch counts once
+            in.mouseDx = in.mouseDy = 0;
+        }
+    };
+
+    {  // forward 1 s at yaw 0: 100 dm towards second base (-Z), nothing in Y
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.forward = true;
+        step(cam, in, 1.0f);
+        require(near(cam.Pose().eye[0], 0) && near(cam.Pose().eye[1], 0) && near(cam.Pose().eye[2], -100));
+    }
+    {  // right 1 s: towards first base (+X), the way positive yaw turns
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.right = true;
+        step(cam, in, 1.0f);
+        require(near(cam.Pose().eye[0], 100) && near(cam.Pose().eye[2], 0));
+    }
+    {  // up 0.5 s: +50 in world Y; fast + forward 1 s: 400 dm
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.up = true;
+        step(cam, in, 0.5f);
+        require(near(cam.Pose().eye[1], 50));
+        FreeCamera fast(origin);
+        FreeCameraInput f{};
+        f.forward = f.fast = true;
+        step(fast, f, 1.0f);
+        require(near(fast.Pose().eye[2], -400));
+    }
+    {  // mouse looks only while `look`; pitch stops at +89 degrees
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.mouseDy = -100000;
+        step(cam, in, 0.016f);
+        require(near(cam.Pose().pitch, 0));
+        in.look = true;
+        step(cam, in, 0.016f);
+        require(near(cam.Pose().pitch, 89.0f * 3.14159265f / 180.0f));
+    }
+    {  // wheel scales the speed within [10, 2000] dm/s
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.wheel = 100;
+        step(cam, in, 0.016f);
+        require(near(cam.Speed(), 2000));
+        in.wheel = -100;
+        step(cam, in, 0.016f);
+        require(near(cam.Speed(), 10));
+    }
+    {  // a single long frame moves like 0.1 s
+        FreeCamera cam(origin);
+        FreeCameraInput in{};
+        in.forward = true;
+        in.dt = 5.0f;
+        cam.Update(in);
+        require(near(cam.Pose().eye[2], -10));
+    }
+    {  // extreme positions and pitch: never NaN or infinity
+        FreeCamera cam({{1e6f, -1e6f, 1e6f}, 0, 0, 45});
+        FreeCameraInput in{};
+        in.look = in.forward = in.left = in.up = true;
+        for (int i = 0; i < 100; ++i) {
+            in.mouseDx = (i % 2 ? 1e5f : -1e5f);
+            in.mouseDy = (i % 3 ? 1e5f : -1e5f);
+            step(cam, in, 0.05f);
+        }
+        const auto& p = cam.Pose();
+        require(std::isfinite(p.eye[0]) && std::isfinite(p.eye[1]) && std::isfinite(p.eye[2]));
+        require(std::isfinite(p.yaw) && std::isfinite(p.pitch) && std::fabs(p.pitch) <= 89.0f * 3.14159265f / 180.0f + 1e-4f);
+    }
+}
diff --git a/runtime/tests/game_camera_tests.cpp b/runtime/tests/game_camera_tests.cpp
new file mode 100644
index 0000000..063f62c
--- /dev/null
+++ b/runtime/tests/game_camera_tests.cpp
@@ -0,0 +1,37 @@
+#include "mlb_camera.h"
+#include <cmath>
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-3f; };
+    using namespace game_camera;
+    float eye[3], target[3];
+
+    // yaw 0, pitch 0: looking towards second base (-Z), target 100 dm ahead.
+    PoseToEyeTarget({{0, 30, 90}, 0, 0, 45}, eye, target);
+    require(near(eye[0], 0) && near(eye[1], 30) && near(eye[2], 90));
+    require(near(target[0], 0) && near(target[1], 30) && near(target[2], -10));
+
+    // Positive yaw turns towards first base (+X).
+    PoseToEyeTarget({{0, 0, 0}, 1.5707963f, 0, 45}, eye, target);
+    require(near(target[0], 100) && near(target[2], 0));
+
+    // Positive pitch looks up.
+    PoseToEyeTarget({{0, 0, 0}, 0, 0.5f, 45}, eye, target);
+    require(target[1] > 40 && target[2] < 0);
+
+    // Round trip, including the game's own batter view (eye behind home, target past the mound).
+    const float gameEye[3] = {2.0869f, 15.5095f, 59.5611f}, gameTarget[3] = {-8.9952f, -1.7186f, -229.0464f};
+    const auto pose = EyeTargetToPose(gameEye, gameTarget, 48.8f);
+    require(near(pose.eye[0], gameEye[0]) && near(pose.eye[2], gameEye[2]) && near(pose.fovY, 48.8f));
+    require(pose.yaw < 0 && pose.pitch < 0);  // slightly towards third base and down
+    PoseToEyeTarget(pose, eye, target);
+    const float dx = gameTarget[0] - gameEye[0], dy = gameTarget[1] - gameEye[1], dz = gameTarget[2] - gameEye[2];
+    const float len = std::sqrt(dx * dx + dy * dy + dz * dz);
+    require(near(target[0] - eye[0], dx / len * 100) && near(target[1] - eye[1], dy / len * 100) &&
+            near(target[2] - eye[2], dz / len * 100));
+
+    // Eye and target at the same point: no NaN.
+    const auto same = EyeTargetToPose(gameEye, gameEye, 45);
+    require(std::isfinite(same.yaw) && std::isfinite(same.pitch));
+}
