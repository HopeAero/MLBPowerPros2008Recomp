diff --git a/runtime/include/free_camera.h b/runtime/include/free_camera.h
new file mode 100644
index 0000000..8e345f3
--- /dev/null
+++ b/runtime/include/free_camera.h
@@ -0,0 +1,52 @@
+#pragma once
+// Free camera of the stadium viewer: Blender/Unreal-style fly controls over a CameraPose (game frame,
+// decimetres). Header-only and free of runtime dependencies so tests/free_camera_tests.cpp can check it.
+#include <algorithm>
+#include <cmath>
+
+#include "stadium_viewer.h"
+
+namespace stadium_viewer {
+
+struct FreeCameraInput {
+    bool forward = false, back = false, left = false, right = false, up = false, down = false, fast = false, look = false;
+    float mouseDx = 0, mouseDy = 0, wheel = 0, dt = 0;
+};
+
+class FreeCamera {
+public:
+    static constexpr float kStartSpeed = 100.0f;  // dm/s (10 m/s)
+    static constexpr float kMinSpeed = 10.0f, kMaxSpeed = 2000.0f, kFastFactor = 4.0f, kWheelFactor = 1.25f;
+    static constexpr float kMouseRadiansPerPixel = 0.0035f, kMaxDt = 0.1f;
+    static constexpr float kMaxPitch = 89.0f * 3.14159265f / 180.0f;
+
+    explicit FreeCamera(const CameraPose& start) : pose_(start) { pose_.pitch = std::clamp(pose_.pitch, -kMaxPitch, kMaxPitch); }
+
+    void Update(const FreeCameraInput& in) {
+        if (in.wheel != 0 && std::isfinite(in.wheel))
+            speed_ = std::clamp(speed_ * std::pow(kWheelFactor, std::clamp(in.wheel, -100.0f, 100.0f)), kMinSpeed, kMaxSpeed);
+        if (in.look && std::isfinite(in.mouseDx) && std::isfinite(in.mouseDy)) {
+            pose_.yaw = std::remainder(pose_.yaw + in.mouseDx * kMouseRadiansPerPixel, 2.0f * 3.14159265f);
+            pose_.pitch = std::clamp(pose_.pitch - in.mouseDy * kMouseRadiansPerPixel, -kMaxPitch, kMaxPitch);
+        }
+        const float dt = std::clamp(in.dt, 0.0f, kMaxDt);
+        const float step = speed_ * (in.fast ? kFastFactor : 1.0f) * dt;
+        const float c = std::cos(pose_.pitch);
+        const float forward[3] = {std::sin(pose_.yaw) * c, std::sin(pose_.pitch), -std::cos(pose_.yaw) * c};
+        const float right[3] = {std::cos(pose_.yaw), 0.0f, std::sin(pose_.yaw)};
+        const float f = static_cast<float>(in.forward) - static_cast<float>(in.back);
+        const float r = static_cast<float>(in.right) - static_cast<float>(in.left);
+        const float u = static_cast<float>(in.up) - static_cast<float>(in.down);
+        for (int i = 0; i < 3; ++i) pose_.eye[i] += (forward[i] * f + right[i] * r) * step;
+        pose_.eye[1] += u * step;
+    }
+
+    const CameraPose& Pose() const { return pose_; }
+    float Speed() const { return speed_; }
+
+private:
+    CameraPose pose_;
+    float speed_ = kStartSpeed;
+};
+
+}  // namespace stadium_viewer
