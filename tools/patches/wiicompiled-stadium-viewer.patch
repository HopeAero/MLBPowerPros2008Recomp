diff --git a/runtime/src/stadium_viewer.cpp b/runtime/src/stadium_viewer.cpp
new file mode 100644
index 0000000..6a8d088
--- /dev/null
+++ b/runtime/src/stadium_viewer.cpp
@@ -0,0 +1,67 @@
+#include "stadium_viewer.h"
+
+#include <cstdlib>
+#include <cwchar>
+#include <sstream>
+#include <vector>
+
+namespace stadium_viewer {
+namespace {
+
+std::wstring Env(const wchar_t* name) {
+#if defined(_WIN32)
+    const wchar_t* value = _wgetenv(name);  // UTF-16: paths with accents survive
+    return value ? value : L"";
+#else
+    std::string narrow(name, name + std::wcslen(name));
+    const char* value = std::getenv(narrow.c_str());
+    return value ? std::filesystem::path(value).wstring() : L"";  // UTF-8 on these systems
+#endif
+}
+
+std::optional<CameraPose> ParseCamera(const std::wstring& text) {
+    std::vector<float> values;
+    std::wstringstream in(text);
+    std::wstring field;
+    while (std::getline(in, field, L',')) {
+        wchar_t* end = nullptr;
+        const float v = std::wcstof(field.c_str(), &end);
+        if (field.empty() || end != field.c_str() + field.size()) return std::nullopt;
+        values.push_back(v);
+    }
+    if (values.size() != 6) return std::nullopt;
+    return CameraPose{{values[0], values[1], values[2]}, values[3], values[4], values[5]};
+}
+
+}  // namespace
+
+std::optional<Config> ParseConfig(const std::wstring& modDir, const std::wstring& code, const std::wstring& camera) {
+    if (modDir.empty()) return std::nullopt;
+    Config config;
+    config.modDir = std::filesystem::path(modDir);
+    config.code = code.empty() ? "pp_preview" : std::filesystem::path(code).string();
+    if (!camera.empty()) config.camera = ParseCamera(camera);
+    return config;
+}
+
+const std::optional<Config>& Active() {
+    static const std::optional<Config> active = [] {
+        auto config = ParseConfig(Env(L"WIICOMPILED_STADIUM_VIEWER"), Env(L"WIICOMPILED_STADIUM_VIEWER_CODE"),
+                                  Env(L"WIICOMPILED_STADIUM_VIEWER_CAMERA"));
+        // The Wii Remote strap warning waits 21 s for A: press it twice, before the pad script is read
+        // (first PADRead). Measured: the stadium is then on screen about 8 s after launch.
+        if (config && Env(L"WIICOMPILED_PAD_SCRIPT").empty()) {
+#if defined(_WIN32)
+            _wputenv(L"WIICOMPILED_PAD_SCRIPT=2500-2700:100,3500-3700:100");
+#else
+            setenv("WIICOMPILED_PAD_SCRIPT", "2500-2700:100,3500-3700:100", 1);
+#endif
+        }
+        return config;
+    }();
+    return active;
+}
+
+bool Enabled() { return Active().has_value(); }
+
+}  // namespace stadium_viewer
diff --git a/runtime/tests/game_camera_tests.cpp b/runtime/tests/game_camera_tests.cpp
new file mode 100644
index 0000000..063f62c
--- /dev/null
+++ b/runtime/tests/game_camera_tests.cpp
@@ -0,0 +1,37 @@
+#include "mlb_camera.h"
+#include <cmath>
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-3f; };
+    using namespace game_camera;
+    float eye[3], target[3];
+
+    // yaw 0, pitch 0: looking towards second base (-Z), target 100 dm ahead.
+    PoseToEyeTarget({{0, 30, 90}, 0, 0, 45}, eye, target);
+    require(near(eye[0], 0) && near(eye[1], 30) && near(eye[2], 90));
+    require(near(target[0], 0) && near(target[1], 30) && near(target[2], -10));
+
+    // Positive yaw turns towards first base (+X).
+    PoseToEyeTarget({{0, 0, 0}, 1.5707963f, 0, 45}, eye, target);
+    require(near(target[0], 100) && near(target[2], 0));
+
+    // Positive pitch looks up.
+    PoseToEyeTarget({{0, 0, 0}, 0, 0.5f, 45}, eye, target);
+    require(target[1] > 40 && target[2] < 0);
+
+    // Round trip, including the game's own batter view (eye behind home, target past the mound).
+    const float gameEye[3] = {2.0869f, 15.5095f, 59.5611f}, gameTarget[3] = {-8.9952f, -1.7186f, -229.0464f};
+    const auto pose = EyeTargetToPose(gameEye, gameTarget, 48.8f);
+    require(near(pose.eye[0], gameEye[0]) && near(pose.eye[2], gameEye[2]) && near(pose.fovY, 48.8f));
+    require(pose.yaw < 0 && pose.pitch < 0);  // slightly towards third base and down
+    PoseToEyeTarget(pose, eye, target);
+    const float dx = gameTarget[0] - gameEye[0], dy = gameTarget[1] - gameEye[1], dz = gameTarget[2] - gameEye[2];
+    const float len = std::sqrt(dx * dx + dy * dy + dz * dz);
+    require(near(target[0] - eye[0], dx / len * 100) && near(target[1] - eye[1], dy / len * 100) &&
+            near(target[2] - eye[2], dz / len * 100));
+
+    // Eye and target at the same point: no NaN.
+    const auto same = EyeTargetToPose(gameEye, gameEye, 45);
+    require(std::isfinite(same.yaw) && std::isfinite(same.pitch));
+}
