@@ -0,0 +1,36 @@
+// MLB Power Pros 2008 (RL8E54) game-specific native: the match's per-frame update (0x808816C8), for the
+// stadium viewer's still match.
+//
+// The original calls 0x8088175C(match) and then 0x808661BC(match), which runs the match's state tree
+// (0x80866EA4: pitch, batting, fielding and the camera director all hang from it). Decompiled here; in the
+// stadium viewer, once the stadium is on screen, the state tree is skipped: players, ball and play stop,
+// while the stadium (crowd, flags) keeps animating, since it updates outside that tree.
+#include <cstdint>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "stadium_viewer.h"
+
+namespace viewer_scene {
+
+constexpr uint32_t kMatchStep = 0x8088175C, kStateTree = 0x808661BC;
+
+void Call(CpuContext* cpu, uint32_t target, uint32_t a) {
+    cpu->gpr[3] = a;
+    InvokeIndirectCpu(target, cpu);
+}
+
+}  // namespace viewer_scene
+
+extern "C" void MLB_MatchFrame_808816C8(CpuContext* ctx) {
+    using namespace viewer_scene;
+    const uint32_t match = ctx->gpr[3];
+    const uint32_t savedSp = ctx->gpr[1];
+    ctx->gpr[1] = savedSp - 0x10;
+    Memory::Write32(ctx->gpr[1], savedSp);
+    Call(ctx, kMatchStep, match);
+    if (!(stadium_viewer::Enabled() && stadium_viewer::StadiumReady())) Call(ctx, kStateTree, match);
+    ctx->gpr[1] = savedSp;
+}
+PPC_NATIVE_OVERRIDE_VOID(808816C8, MLB_MatchFrame_808816C8, (CpuContext* ctx), (ctx));
