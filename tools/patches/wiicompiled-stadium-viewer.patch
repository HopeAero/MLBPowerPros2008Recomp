diff --git a/runtime/src/stadium_viewer.cpp b/runtime/src/stadium_viewer.cpp
new file mode 100644
index 0000000..816abca
--- /dev/null
+++ b/runtime/src/stadium_viewer.cpp
@@ -0,0 +1,55 @@
+#include "stadium_viewer.h"
+
+#include <cstdlib>
+#include <cwchar>
+#include <sstream>
+#include <vector>
+
+namespace stadium_viewer {
+namespace {
+
+std::wstring Env(const wchar_t* name) {
+#if defined(_WIN32)
+    const wchar_t* value = _wgetenv(name);  // UTF-16: paths with accents survive
+    return value ? value : L"";
+#else
+    std::string narrow(name, name + std::wcslen(name));
+    const char* value = std::getenv(narrow.c_str());
+    return value ? std::filesystem::path(value).wstring() : L"";  // UTF-8 on these systems
+#endif
+}
+
+std::optional<CameraPose> ParseCamera(const std::wstring& text) {
+    std::vector<float> values;
+    std::wstringstream in(text);
+    std::wstring field;
+    while (std::getline(in, field, L',')) {
+        wchar_t* end = nullptr;
+        const float v = std::wcstof(field.c_str(), &end);
+        if (field.empty() || end != field.c_str() + field.size()) return std::nullopt;
+        values.push_back(v);
+    }
+    if (values.size() != 6) return std::nullopt;
+    return CameraPose{{values[0], values[1], values[2]}, values[3], values[4], values[5]};
+}
+
+}  // namespace
+
+std::optional<Config> ParseConfig(const std::wstring& modDir, const std::wstring& code, const std::wstring& camera) {
+    if (modDir.empty()) return std::nullopt;
+    Config config;
+    config.modDir = std::filesystem::path(modDir);
+    config.code = code.empty() ? "pp_preview" : std::filesystem::path(code).string();
+    if (!camera.empty()) config.camera = ParseCamera(camera);
+    return config;
+}
+
+const std::optional<Config>& Active() {
+    static const std::optional<Config> active = ParseConfig(
+        Env(L"WIICOMPILED_STADIUM_VIEWER"), Env(L"WIICOMPILED_STADIUM_VIEWER_CODE"), Env(L"WIICOMPILED_STADIUM_VIEWER_CAMERA"));
+    return active;
+}
+
+bool Enabled() { return Active().has_value(); }
+
+}  // namespace stadium_viewer
diff --git a/runtime/tests/stadium_viewer_tests.cpp b/runtime/tests/stadium_viewer_tests.cpp
new file mode 100644
index 0000000..e2f9974
--- /dev/null
+++ b/runtime/tests/stadium_viewer_tests.cpp
@@ -0,0 +1,30 @@
+#include "stadium_viewer.h"
+#include <cmath>
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-4f; };
+    using stadium_viewer::ParseConfig;
+
+    require(!ParseConfig(L"", L"", L"").has_value());
+
+    // Spaces, parentheses and accents survive (the env is read as UTF-16).
+    auto c = ParseConfig(L"C:\\Temp\\Vista previa (Jos\u00e9)", L"", L"");
+    require(c.has_value());
+    require(c->modDir == std::filesystem::path(L"C:\\Temp\\Vista previa (Jos\u00e9)"));
+    require(c->code == "pp_preview");
+    require(!c->camera.has_value());
+
+    c = ParseConfig(L"D:\\m", L"mario", L"12.5,30,-400,0.5,-0.25,45");
+    require(c && c->code == "mario" && c->camera.has_value());
+    require(near(c->camera->eye[0], 12.5f) && near(c->camera->eye[1], 30.0f) && near(c->camera->eye[2], -400.0f));
+    require(near(c->camera->yaw, 0.5f) && near(c->camera->pitch, -0.25f) && near(c->camera->fovY, 45.0f));
+
+    // A malformed camera is dropped; the rest of the config stays.
+    c = ParseConfig(L"D:\\m", L"", L"1,2,3");
+    require(c && !c->camera.has_value());
+    c = ParseConfig(L"D:\\m", L"", L"1,2,3,x,0,45");
+    require(c && !c->camera.has_value());
+    c = ParseConfig(L"D:\\m", L"", L"1,2,3,0,0,45,7");
+    require(c && !c->camera.has_value());
+}
