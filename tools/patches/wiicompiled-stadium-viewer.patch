diff --git a/runtime/include/mlb_camera.h b/runtime/include/mlb_camera.h
new file mode 100644
index 0000000..f2f4483
--- /dev/null
+++ b/runtime/include/mlb_camera.h
@@ -0,0 +1,47 @@
+#pragma once
+// The game's camera (MLB Power Pros 2008), for the stadium viewer's free camera.
+// Reverse engineering: docs/ingenieria-inversa.md, "Cámara del partido".
+#include <cmath>
+#include <optional>
+
+#include "stadium_viewer.h"
+
+struct CpuContext;
+
+namespace game_camera {
+
+// The game's real match shots: behind the batter, the play camera (high and to the side after contact)
+// and a wide one. There is no separate pitcher camera: the AI match pitches from the batter's.
+enum class MatchView { Batter, Play, Wide };
+
+// From the next frame on the game draws with this camera (position and orientation; the game keeps its
+// own projection). ClearOverride gives the camera back to the game.
+void SetOverride(const stadium_viewer::CameraPose& pose);
+void ClearOverride();
+bool OverrideActive();
+// Asks for the game's own camera of that view (applied on the next guest frame); false while the match
+// camera is not known yet.
+bool ShowMatchView(MatchView view);
+// Guest-thread hook (once per frame, viewer only): applies a pending ShowMatchView.
+void OnGuestFrame(CpuContext* cpu);
+// The camera the game drew the last frame with.
+std::optional<stadium_viewer::CameraPose> CurrentPose();
+
+// Pure conversions (tested): CameraPose <-> eye/target in the game frame (target 100 dm ahead).
+// yaw 0 looks towards second base (-Z), positive yaw towards first base (+X); pitch positive up.
+inline void PoseToEyeTarget(const stadium_viewer::CameraPose& pose, float eye[3], float target[3]) {
+    const float c = std::cos(pose.pitch);
+    const float dir[3] = {std::sin(pose.yaw) * c, std::sin(pose.pitch), -std::cos(pose.yaw) * c};
+    for (int i = 0; i < 3; ++i) {
+        eye[i] = pose.eye[i];
+        target[i] = pose.eye[i] + dir[i] * 100.0f;
+    }
+}
+
+inline stadium_viewer::CameraPose EyeTargetToPose(const float eye[3], const float target[3], float fovY) {
+    const float d[3] = {target[0] - eye[0], target[1] - eye[1], target[2] - eye[2]};
+    const float flat = std::sqrt(d[0] * d[0] + d[2] * d[2]);
+    return {{eye[0], eye[1], eye[2]}, std::atan2(d[0], -d[2]), std::atan2(d[1], flat), fovY};
+}
+
+}  // namespace game_camera
