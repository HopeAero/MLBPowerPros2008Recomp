+#include "season_schedule_mlb.h"
+#include "season_schedule.h"
+#include <cstdio>
+
+static int failures = 0;
+static void Check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+int main() {
+    using namespace season_schedule_mlb;
+    const auto years = OfferedYears();
+    Check(years.front() == 2026 && years.back() == 2002 && years.size() == 24, "2026 to 2002");
+    Check(std::find(years.begin(), years.end(), 2020) == years.end(), "not 2020");
+    Check(Weekday(2026, 3, 25) == 3 && Weekday(2008, 3, 25) == 2, "weekdays");
+    Check(EasternOffset(2026, 7, 2, 2) == -4 && EasternOffset(2026, 3, 1, 18) == -5 && EasternOffset(2026, 3, 8, 7) == -4,
+          "Eastern daylight time");
+
+    // A regular game (late West Coast: already the next day in UTC), its postponed make-up, an
+    // exhibition, a game with no time yet and an escaped string.
+    const char* json = R"({"copyright":"x \"y\" \u00e9","dates":[
+      {"date":"2026-04-01","games":[
+        {"gameType":"R","gameDate":"2026-04-02T02:10:00Z","status":{"startTimeTBD":false},
+         "teams":{"home":{"team":{"id":119}},"away":{"team":{"id":109}}}},
+        {"gameType":"R","gameDate":"2026-04-01T17:05:00Z","rescheduledFrom":"2026-03-30","status":{},
+         "teams":{"home":{"team":{"id":147}},"away":{"team":{"id":111}}}},
+        {"gameType":"S","gameDate":"2026-04-01T17:05:00Z","status":{},
+         "teams":{"home":{"team":{"id":147}},"away":{"team":{"id":111}}}},
+        {"gameType":"R","gameDate":"2026-04-01T07:33:00Z","status":{"startTimeTBD":true},
+         "teams":{"home":{"team":{"id":121}},"away":{"team":{"id":143}}}}]}]})";
+    const Converted c = ToCsv(json, 2026);
+    Check(c.error.empty() && c.games == 2, "two regular games kept");
+    Check(c.csv.find("2026-04-01,LAD,ARI,22:10") != std::string::npos, "home, away, Eastern time");
+    Check(c.csv.find("2026-04-01,NYM,PHI,\n") != std::string::npos, "no time when it is not set");
+    Check(!ToCsv("<html>", 2026).error.empty() && !ToCsv("{\"dates\":[]}", 2026).error.empty(), "errors");
+
+    // The CSV reads back, and Fit moves a season that ends after October 1.
+    const auto parsed = season_schedule::Parse(c.csv);
+    Check(parsed.games.size() == 2 && parsed.errors.empty(), "the CSV is the runtime's format");
+    std::vector<season_schedule::Game> late = {{season_schedule::DayIndex(10, 5), 0, 1, 1140},
+                                               {season_schedule::DayIndex(4, 7), 2, 3, 1140}};
+    const auto fitted = season_schedule::Fit(late);
+    Check(fitted.shift == -4 && fitted.games.back().day == season_schedule::DayIndex(10, 1), "moved 4 days earlier");
+    std::vector<season_schedule::Game> early = {{season_schedule::DayIndex(3, 18), 0, 1, 1140}};
+    Check(season_schedule::Fit(early).shift == 1, "a March 18 opener moves a day later");
+    // 17 games on a day: one goes to the day after, where neither team plays.
+    std::vector<season_schedule::Game> full;
+    for (int i = 0; i < 17; ++i) full.push_back({season_schedule::DayIndex(5, 1), i % 30, (i + 15) % 30, 1140});
+    const auto spread = season_schedule::Fit(full);
+    Check(spread.games.size() == 17 && spread.moved == 1 && spread.dropped == 0, "a 17th game moves to a nearby day");
+    int month = 0, day = 0;
+    season_schedule::MonthDay(season_schedule::DayIndex(9, 30), month, day);
+    Check(month == 9 && day == 30, "month and day back from a slot day");
+
+    if (failures) return 1;
+    std::printf("season_schedule_mlb_tests: ok\n");
+    return 0;
+}
