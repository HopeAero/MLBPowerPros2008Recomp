--- a/runtime/include/season_schedule.h
+++ b/runtime/include/season_schedule.h
@@ -391,4 +391,72 @@ inline std::vector<Game> GenerateOddLeagues(const std::array<int, kTeams>& divis
     return {};
 }
 
+
+// Fits a real year's schedule to the game: its regular season runs from March 19 to October 1 (slot
+// days 18..214) and a day holds 16 games, the game's own entries (the All-Star Game) included. A
+// schedule that starts earlier or ends later moves by the days needed (same order, other dates);
+// a game on a full day moves to the nearest day where there is room and neither team plays.
+constexpr int kRegularFirst = 18, kRegularLast = 214;
+struct FitResult {
+    std::vector<Game> games;
+    int shift = 0;  // days the whole schedule moved (negative: earlier)
+    int moved = 0;  // games moved off a full day
+    int dropped = 0;
+};
+inline FitResult Fit(std::vector<Game> games, const std::array<int, kDays>& taken = {}) {
+    FitResult out;
+    if (games.empty()) return out;
+    int first = kDays, last = -1;
+    for (const auto& g : games) first = std::min(first, g.day), last = std::max(last, g.day);
+    if (first < kRegularFirst) out.shift = kRegularFirst - first;
+    if (last + out.shift > kRegularLast) out.shift = kRegularLast - last;
+    std::array<int, kDays> count = taken;
+    std::array<std::array<bool, kDays>, kTeams> plays{};
+    std::vector<size_t> overflow;
+    for (size_t i = 0; i < games.size(); ++i) {
+        Game& g = games[i];
+        g.day = std::clamp(g.day + out.shift, 0, kDays - 1);
+        if (count[g.day] >= kSlots) {
+            overflow.push_back(i);
+            continue;
+        }
+        ++count[g.day];
+        plays[g.home][g.day] = plays[g.away][g.day] = true;
+    }
+    std::vector<bool> keep(games.size(), true);
+    for (size_t i : overflow) {
+        Game& g = games[i];
+        int to = -1;
+        for (int d = 1; d <= kRegularLast - kRegularFirst && to < 0; ++d)
+            for (int day : {g.day - d, g.day + d})
+                if (to < 0 && day >= kRegularFirst && day <= kRegularLast && count[day] < kSlots &&
+                    !plays[g.home][day] && !plays[g.away][day])
+                    to = day;
+        if (to < 0) {
+            keep[i] = false;
+            ++out.dropped;
+            continue;
+        }
+        g.day = to;
+        ++count[to];
+        plays[g.home][to] = plays[g.away][to] = true;
+        ++out.moved;
+    }
+    for (size_t i = 0; i < games.size(); ++i)
+        if (keep[i]) out.games.push_back(games[i]);
+    std::stable_sort(out.games.begin(), out.games.end(), [](const Game& a, const Game& b) {
+        return a.day != b.day ? a.day < b.day : a.minutes < b.minutes;
+    });
+    return out;
+}
+
+// Month and day of a slot day (the game's 366-day year).
+inline void MonthDay(int index, int& month, int& day) {
+    static constexpr int kMonthDays[12] = {31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+    int d = index + kFirstDay;
+    month = 1;
+    while (month <= 12 && d >= kMonthDays[month - 1]) d -= kMonthDays[month - 1], ++month;
+    day = d + 1;
+}
+
 }  // namespace season_schedule
diff --git a/runtime/include/season_schedule_mlb.h b/runtime/include/season_schedule_mlb.h
new file mode 100644
index 0000000..bb2abe0
--- /dev/null
+++ b/runtime/include/season_schedule_mlb.h
@@ -0,0 +1,234 @@
+#pragma once
+
+// A year's regular season from MLB's public schedule (statsapi.mlb.com/api/v1/schedule) as the CSV of
+// season_schedule.h: the launcher's TOOLS > SCHEDULE. Same rules as tools/season_schedule.py: regular
+// season games only, postponed games on the day they were scheduled (their make-ups and suspended
+// games' resumptions left out), start times in US Eastern time.
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <string_view>
+#include <tuple>
+#include <vector>
+
+namespace season_schedule_mlb {
+
+// The years the launcher offers: 30 teams and 162 games (2002-2026), not 2020 (60 games, from July).
+// 1998-2001 are left out: the API's data for them does not add up to 162 a team.
+inline std::vector<int> OfferedYears() {
+    std::vector<int> years;
+    for (int y = 2026; y >= 2002; --y)
+        if (y != 2020) years.push_back(y);
+    return years;
+}
+
+inline std::string Url(int year) {
+    return "https://statsapi.mlb.com/api/v1/schedule?sportId=1&gameType=R&startDate=" + std::to_string(year) +
+           "-03-01&endDate=" + std::to_string(year) + "-10-31";
+}
+
+// A small JSON reader: enough for the schedule response.
+struct Json {
+    enum Kind { Null, Bool, Number, String, Array, Object } kind = Null;
+    bool boolean = false;
+    double number = 0;
+    std::string text;
+    std::vector<Json> items;
+    std::vector<std::pair<std::string, Json>> fields;
+    const Json& operator[](std::string_view key) const {
+        static const Json none;
+        for (const auto& [k, v] : fields)
+            if (k == key) return v;
+        return none;
+    }
+};
+
+class JsonReader {
+public:
+    explicit JsonReader(std::string_view s) : s_(s) {}
+    bool Parse(Json& out) {
+        if (!Value(out)) return false;
+        Space();
+        return at_ == s_.size();
+    }
+
+private:
+    void Space() {
+        while (at_ < s_.size() && (s_[at_] == ' ' || s_[at_] == '\n' || s_[at_] == '\r' || s_[at_] == '\t')) ++at_;
+    }
+    bool Literal(std::string_view word) {
+        if (s_.substr(at_, word.size()) != word) return false;
+        at_ += word.size();
+        return true;
+    }
+    bool Str(std::string& out) {
+        if (at_ >= s_.size() || s_[at_] != '"') return false;
+        ++at_;
+        while (at_ < s_.size() && s_[at_] != '"') {
+            char c = s_[at_++];
+            if (c == '\\' && at_ < s_.size()) {
+                const char e = s_[at_++];
+                if (e == 'u') {
+                    if (at_ + 4 > s_.size()) return false;
+                    const unsigned code = static_cast<unsigned>(std::stoul(std::string(s_.substr(at_, 4)), nullptr, 16));
+                    at_ += 4;
+                    // UTF-8 for the basic plane (names with accents); surrogates are not needed here.
+                    if (code < 0x80) out += static_cast<char>(code);
+                    else if (code < 0x800) out += static_cast<char>(0xC0 | (code >> 6)), out += static_cast<char>(0x80 | (code & 0x3F));
+                    else out += static_cast<char>(0xE0 | (code >> 12)), out += static_cast<char>(0x80 | ((code >> 6) & 0x3F)),
+                         out += static_cast<char>(0x80 | (code & 0x3F));
+                    continue;
+                }
+                c = e == 'n' ? '\n' : e == 't' ? '\t' : e == 'r' ? '\r' : e == 'b' ? '\b' : e == 'f' ? '\f' : e;
+            }
+            out += c;
+        }
+        if (at_ >= s_.size()) return false;
+        ++at_;
+        return true;
+    }
+    bool Value(Json& out) {
+        Space();
+        if (at_ >= s_.size()) return false;
+        const char c = s_[at_];
+        if (c == '{') {
+            out.kind = Json::Object;
+            ++at_;
+            Space();
+            if (at_ < s_.size() && s_[at_] == '}') return ++at_, true;
+            while (true) {
+                Space();
+                std::string key;
+                if (!Str(key)) return false;
+                Space();
+                if (at_ >= s_.size() || s_[at_++] != ':') return false;
+                Json value;
+                if (!Value(value)) return false;
+                out.fields.emplace_back(std::move(key), std::move(value));
+                Space();
+                if (at_ < s_.size() && s_[at_] == ',') { ++at_; continue; }
+                if (at_ < s_.size() && s_[at_] == '}') return ++at_, true;
+                return false;
+            }
+        }
+        if (c == '[') {
+            out.kind = Json::Array;
+            ++at_;
+            Space();
+            if (at_ < s_.size() && s_[at_] == ']') return ++at_, true;
+            while (true) {
+                Json value;
+                if (!Value(value)) return false;
+                out.items.push_back(std::move(value));
+                Space();
+                if (at_ < s_.size() && s_[at_] == ',') { ++at_; continue; }
+                if (at_ < s_.size() && s_[at_] == ']') return ++at_, true;
+                return false;
+            }
+        }
+        if (c == '"') return out.kind = Json::String, Str(out.text);
+        if (Literal("true")) return out.kind = Json::Bool, out.boolean = true, true;
+        if (Literal("false")) return out.kind = Json::Bool, true;
+        if (Literal("null")) return true;
+        const size_t start = at_;
+        while (at_ < s_.size() && (std::isdigit(static_cast<unsigned char>(s_[at_])) || s_[at_] == '-' || s_[at_] == '+' ||
+                                   s_[at_] == '.' || s_[at_] == 'e' || s_[at_] == 'E'))
+            ++at_;
+        if (at_ == start) return false;
+        out.kind = Json::Number;
+        out.number = std::stod(std::string(s_.substr(start, at_ - start)));
+        return true;
+    }
+    std::string_view s_;
+    size_t at_ = 0;
+};
+
+// MLB team ids -> the codes season_schedule.h knows.
+inline const char* TeamCode(int id) {
+    static const std::map<int, const char*> kTeams = {
+        {108, "LAA"}, {109, "ARI"}, {110, "BAL"}, {111, "BOS"}, {112, "CHC"}, {113, "CIN"}, {114, "CLE"}, {115, "COL"},
+        {116, "DET"}, {117, "HOU"}, {118, "KC"},  {119, "LAD"}, {120, "WSH"}, {121, "NYM"}, {133, "OAK"}, {134, "PIT"},
+        {135, "SD"},  {136, "SEA"}, {137, "SF"},  {138, "STL"}, {139, "TB"},  {140, "TEX"}, {141, "TOR"}, {142, "MIN"},
+        {143, "PHI"}, {144, "ATL"}, {145, "CWS"}, {146, "MIA"}, {147, "NYY"}, {158, "MIL"}};
+    const auto it = kTeams.find(id);
+    return it == kTeams.end() ? nullptr : it->second;
+}
+
+// Days from 1970-01-01 for a civil date, and its weekday (0 = Sunday).
+inline int DaysFromCivil(int y, int m, int d) {
+    y -= m <= 2;
+    const int era = (y >= 0 ? y : y - 399) / 400;
+    const int yoe = y - era * 400;
+    const int doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+    return era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468;
+}
+inline int Weekday(int y, int m, int d) { return ((DaysFromCivil(y, m, d) % 7) + 11) % 7; }
+
+// Hours to add to UTC for US Eastern time: daylight time from the 2nd Sunday of March to the 1st of
+// November, 2:00 local (7:00 and 6:00 UTC).
+inline int EasternOffset(int y, int m, int d, int hour) {
+    const int marchSunday = 1 + (7 - Weekday(y, 3, 1)) % 7 + 7;
+    const int novemberSunday = 1 + (7 - Weekday(y, 11, 1)) % 7;
+    const auto at = [](int mm, int dd, int hh) { return std::make_tuple(mm, dd, hh); };
+    const auto now = at(m, d, hour);
+    return now >= at(3, marchSunday, 7) && now < at(11, novemberSunday, 6) ? -4 : -5;
+}
+
+struct Converted {
+    std::string csv;  // "date,home,away,time" lines with a header
+    int games = 0;
+    int minPerTeam = 0, maxPerTeam = 0;
+    std::string error;
+};
+
+inline Converted ToCsv(std::string_view json, int year) {
+    Converted out;
+    Json root;
+    if (!JsonReader(json).Parse(root) || root.kind != Json::Object) {
+        out.error = "the answer is not the schedule (JSON)";
+        return out;
+    }
+    std::set<std::tuple<std::string, std::string, std::string, std::string>> rows;
+    std::map<std::string, int> perTeam;
+    for (const Json& day : root["dates"].items) {
+        const std::string& date = day["date"].text;
+        for (const Json& game : day["games"].items) {
+            if (game["gameType"].text != "R" || game["rescheduledFrom"].kind != Json::Null ||
+                game["resumedFrom"].kind != Json::Null)
+                continue;  // not regular season, a postponed game's make-up or a suspended game's resumption
+            const char* home = TeamCode(static_cast<int>(game["teams"]["home"]["team"]["id"].number));
+            const char* away = TeamCode(static_cast<int>(game["teams"]["away"]["team"]["id"].number));
+            if (!home || !away) continue;
+            std::string time;
+            const std::string& utc = game["gameDate"].text;  // 2026-04-02T02:10:00Z
+            int y = 0, mo = 0, d = 0, h = 0, mi = 0;
+            if (!game["status"]["startTimeTBD"].boolean &&
+                std::sscanf(utc.c_str(), "%d-%d-%dT%d:%d", &y, &mo, &d, &h, &mi) == 5) {
+                int hour = h + EasternOffset(y, mo, d, h);
+                if (hour < 0) hour += 24;
+                char buffer[8];
+                std::snprintf(buffer, sizeof buffer, "%02d:%02d", hour, mi);
+                time = buffer;
+            }
+            if (rows.insert({date, home, away, time}).second) ++perTeam[home], ++perTeam[away];
+        }
+    }
+    if (rows.empty()) {
+        out.error = "no regular season games for " + std::to_string(year);
+        return out;
+    }
+    out.csv = "# MLB " + std::to_string(year) + " regular season, from statsapi.mlb.com\ndate,home,away,time\n";
+    for (const auto& [date, home, away, time] : rows) out.csv += date + "," + home + "," + away + "," + time + "\n";
+    out.games = static_cast<int>(rows.size());
+    out.minPerTeam = 1 << 30;
+    for (const auto& [team, n] : perTeam) out.minPerTeam = std::min(out.minPerTeam, n), out.maxPerTeam = std::max(out.maxPerTeam, n);
+    return out;
+}
+
+}  // namespace season_schedule_mlb
