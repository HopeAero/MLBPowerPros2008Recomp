+constexpr Phrase kScheduleHelp{
+    "Descarga el calendario real de una temporada de las Grandes Ligas (de la web pública de MLB, "
+    "statsapi.mlb.com) y lo guarda en un mod como schedule/<año>.csv. El juego lo usa en la temporada "
+    "que lleva ese año, en el modo Temporada y en MLB Life.\n\n"
+    "Con «Nuevo: Calendarios MLB» se crea ese mod con el año elegido como primera temporada (start_year) "
+    "y se activa: una temporada nueva empieza en ese año con su calendario. Con un mod tuyo (un paquete de "
+    "temporada), el archivo se añade a los suyos.\n\n"
+    "Años: de 2002 a 2026, sin 2020 (60 partidos). Si una temporada empezó antes del 19 de marzo o acabó "
+    "después del 1 de octubre, el juego la juega unos días antes o después; los partidos de un día con "
+    "más de 16 pasan a un día cercano.\n\n"
+    "Necesita conexión a internet solo al descargar.",
+    "Downloads a major league season's real schedule (from MLB's public site, statsapi.mlb.com) and saves "
+    "it in a mod as schedule/<year>.csv. The game uses it in the season that carries that year, in Season "
+    "mode and in MLB Life.\n\n"
+    "With «New: MLB Schedules» that mod is created with the chosen year as its first season (start_year) "
+    "and switched on: a new season starts in that year with its schedule. With a mod of yours (a season "
+    "pack), the file is added to its own.\n\n"
+    "Years: 2002 to 2026, not 2020 (60 games). If a season started before March 19 or ended after "
+    "October 1, the game plays it a few days earlier or later; games on a day with more than 16 move to a "
+    "nearby day.\n\n"
+    "It needs an internet connection only to download."};
+
+// Downloads `year`'s schedule with the system's curl (Windows 10 and later, Linux) into
+// <mod>/schedule/<year>.csv; a new mod gets a mod.toml with that first season. Returns what to show.
+// ponytail: blocks the launcher for the download (a few seconds); a thread if it ever needs to be longer.
+std::string DownloadSchedule(int year, const std::filesystem::path& modDir, bool newMod) {
+    namespace fs = std::filesystem;
+    std::error_code ec;
+    fs::create_directories(modDir / "schedule", ec);
+    const fs::path temp = modDir / "schedule" / ".download.json";
+    fs::remove(temp, ec);
+    const std::string url = season_schedule_mlb::Url(year);
+#if defined(_WIN32)
+    std::wstring command = L"curl.exe -sSfL --max-time 60 -o \"" + temp.wstring() + L"\" \"" +
+                           std::wstring(url.begin(), url.end()) + L"\"";
+    STARTUPINFOW startup{sizeof(startup)};
+    PROCESS_INFORMATION process{};
+    if (CreateProcessW(nullptr, command.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW, nullptr, nullptr, &startup,
+                       &process)) {
+        WaitForSingleObject(process.hProcess, 90000);
+        CloseHandle(process.hThread);
+        CloseHandle(process.hProcess);
+    }
+#else
+    const std::string command = "curl -sSfL --max-time 60 -o '" + temp.string() + "' '" + url + "'";
+    (void)std::system(command.c_str());
+#endif
+    std::ifstream input(temp, std::ios::binary);
+    const std::string json((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+    input.close();
+    fs::remove(temp, ec);
+    if (json.empty())
+        return Tr("No se pudo descargar el calendario. Comprueba la conexión a internet.",
+                  "The schedule could not be downloaded. Check the internet connection.");
+    const season_schedule_mlb::Converted converted = season_schedule_mlb::ToCsv(json, year);
+    if (!converted.error.empty()) return std::string(Tr("Calendario no válido: ", "Not a valid schedule: ")) + converted.error;
+    std::ofstream(modDir / "schedule" / (std::to_string(year) + ".csv"), std::ios::binary) << converted.csv;
+    if (newMod && !fs::exists(modDir / "mod.toml", ec)) {
+        std::ofstream(modDir / "mod.toml", std::ios::binary)
+            << "name = \"" << Tr("Calendarios MLB", "MLB Schedules") << "\"\n"
+            << "description = \"" << Tr("Calendarios reales descargados desde el launcher.", "Real schedules downloaded from the launcher.")
+            << "\"\nstart_year = " << year << "\n";
+        mods::SetEnabled(RuntimeConfigFile::PathToUtf8(modDir.filename()), true);
+    }
+    // What the game will do with it (the same fit the runtime makes, without the All-Star Game).
+    const auto fitted = season_schedule::Fit(season_schedule::Parse(converted.csv).games);
+    std::string message = std::to_string(year) + ": " + std::to_string(converted.games) + Tr(" partidos (", " games (") +
+                          std::to_string(converted.minPerTeam) +
+                          (converted.minPerTeam == converted.maxPerTeam ? "" : "-" + std::to_string(converted.maxPerTeam)) +
+                          Tr(" por equipo), guardado en ", " a team), saved in ") +
+                          RuntimeConfigFile::PathToUtf8(modDir.filename()) + "/schedule/" + std::to_string(year) + ".csv.";
+    if (fitted.shift)
