+    const uint32_t allpassLength[2] = {Load32(w + 184u), Load32(w + 188u)};
+    uint32_t e0 = Load32(w + 12u), e1 = Load32(w + 16u), e2 = Load32(w + 20u);
+    uint32_t pp = Load32(w + 56u);
+    uint32_t cj[3] = {Load32(w + 104u), Load32(w + 108u), Load32(w + 112u)};
+    uint32_t ak[2] = {Load32(w + 176u), Load32(w + 180u)};
+    const float earlyCoef[3] = {Float(Load32(w + 32u)), Float(Load32(w + 36u)), Float(Load32(w + 40u))};
+    const float combCoef[3] = {Float(Load32(w + 140u)), Float(Load32(w + 144u)), Float(Load32(w + 148u))};
+    const float allpassCoef = Float(Load32(w + 248u));
+    const float lpf = Float(Load32(w + 264u));
+    const float crosstalk = Float(Load32(w + 300u)), fused = Float(Load32(w + 308u));
+    const float outGain = Float(Load32(w + 320u)), sendGain = Float(Load32(w + 324u));
+    const float kZero = Float(Load32(kc)), kOne = Float(Load32(kc + 4u));
+    const float k06 = Float(Load32(kc + 8u)), k05 = Float(Load32(kc + 12u));
