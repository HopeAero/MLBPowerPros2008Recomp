+        h.early = Load32(w + 4u * i);
+        h.predelay = Load32(w + 44u + 4u * i);
+        for (uint32_t k = 0; k < 3; ++k) h.comb[k] = Load32(w + 68u + 12u * i + 4u * k);
+        for (uint32_t k = 0; k < 2; ++k) h.allpass[k] = Load32(w + 152u + 8u * i + 4u * k);
+        h.last = Load32(w + 200u + 4u * i);
+        h.lastIndex = Load32(w + 212u + 4u * i);
+        h.lastLength = Load32(w + 224u + 4u * i);
+        h.lowpass = Float(Load32(w + 252u + 4u * i));
