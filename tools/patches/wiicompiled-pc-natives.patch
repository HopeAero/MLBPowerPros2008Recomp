+// WIICOMPILED_NATIVE_MIX_FAST=0 turns the line prefetch in the sample loop off (read once at startup).
+const bool g_prefetch = [] {
+    const char* value = std::getenv("WIICOMPILED_NATIVE_MIX_FAST");
+    return !(value != nullptr && value[0] == '0');
+}();
+
+// ---- guest memory, flat view (ranges proven plain before use) ----
+
+[[gnu::always_inline]] inline uint8_t* Host(uint32_t address) { return MKW_FLAT_GUEST_BASE + address; }
+
+[[gnu::always_inline]] inline uint32_t Bits(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof bits);
+    return bits;
+}
+
+[[gnu::always_inline]] inline float Float(uint32_t bits) {
+    float value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+[[gnu::always_inline]] inline uint32_t Load32(uint32_t address) {
+    uint32_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap32(raw);
+}
+
+[[gnu::always_inline]] inline uint64_t Load64(uint32_t address) {
+    uint64_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap64(raw);
+}
+
+[[gnu::always_inline]] inline void Store32(uint32_t address, uint32_t value) {
+    const uint32_t raw = __builtin_bswap32(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
+}
+
+#if defined(__aarch64__)
+// One instruction each, so nothing can be fused, reassociated or widened.
+[[gnu::always_inline]] inline float Mul(float a, float b) { float r; __asm__("fmul %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+[[gnu::always_inline]] inline float Add(float a, float b) { float r; __asm__("fadd %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+[[gnu::always_inline]] inline float Sub(float a, float b) { float r; __asm__("fsub %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+// fmax returns a NaN when either operand is one: the running "any NaN stored" test.
+[[gnu::always_inline]] inline float Max(float a, float b) { float r; __asm__("fmax %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+[[gnu::always_inline]] inline float FromInt(uint32_t v) { float r; __asm__("scvtf %s0, %w1" : "=w"(r) : "r"(v)); return r; }
+[[gnu::always_inline]] inline double Widen(float a) { double r; __asm__("fcvt %d0, %s1" : "=w"(r) : "w"(a)); return r; }
+// fctiwz of a single: saturating, toward zero, NaN -> 0x80000000 (PpcClampIntegerWordInline).
+[[gnu::always_inline]] inline uint32_t Fctiwz(float a) {
+    uint32_t r;
+    __asm__("fcvtzs %w0, %s1" : "=r"(r) : "w"(a));
+    return a != a ? 0x80000000u : r;
+}
+#else
+// x86-64: one mulss/addss/subss each under this file's FP policy (see the header). NI flushes a
+// tiny exact result before rounding, FTZ only after it, so the one result where they can part
+// (+-FLT_MIN from a subnormal exact value) is recomputed the translation's way. Checked over every
+// rounding mode, NI on and off, boundary and random operands (local/analysis/pc-opt/audio-host:
+// 4 869 984 helper comparisons).
+[[gnu::always_inline]] inline float Mul(float a, float b) {
+    const float r = a * b;
+    if ((Bits(r) & 0x7FFFFFFFu) == 0x00800000u && MkwHostNiActiveInline()) [[unlikely]]
+        return PpcForceSingleValueInline(double(a) * double(b));
+    return r;
+}
+[[gnu::always_inline]] inline float Add(float a, float b) {
+    const float r = a + b;
+    if ((Bits(r) & 0x7FFFFFFFu) == 0x00800000u && MkwHostNiActiveInline()) [[unlikely]]
+        return PpcForceSingleValueInline(double(a) + double(b));
+    return r;
+}
+[[gnu::always_inline]] inline float Sub(float a, float b) {
+    const float r = a - b;
+    if ((Bits(r) & 0x7FFFFFFFu) == 0x00800000u && MkwHostNiActiveInline()) [[unlikely]]
+        return PpcForceSingleValueInline(double(a) - double(b));
+    return r;
+}
+// The running "any NaN stored" test: a NaN once either operand is one (maxss alone would drop a
+// NaN first operand).
+[[gnu::always_inline]] inline float Max(float a, float b) { return b != b ? b : a; }
+[[gnu::always_inline]] inline float FromInt(uint32_t v) { return static_cast<float>(static_cast<int32_t>(v)); }
+[[gnu::always_inline]] inline double Widen(float a) { return static_cast<double>(a); }
+// fctiwz of a single: saturating, toward zero, NaN -> 0x80000000 (PpcClampIntegerWordInline).
+// cvttss2si gives 0x80000000 for NaN and both overflows; only the positive one needs fixing.
+[[gnu::always_inline]] inline uint32_t Fctiwz(float a) {
+    if (a >= 2147483648.0f) return 0x7FFFFFFFu;
+    return static_cast<uint32_t>(_mm_cvtt_ss2si(_mm_set_ss(a)));
+}
+#endif
