+// MLB Power Pros 2008 (RL8E54): a native 0x80061220, the per-mesh light colours of the model
+// draw (P29 profile, heavy windows: 0.19 ms/frame self, plus ~0.15 ms in the callees below).
+//
+// void LightColors(?, Material* m) runs per mesh while the byte at r13-28816 (0x8031AFD0, set by
+// 0x80060C60) is set. Ambient: the bytes m+4..m+6 go to floats through the magic-number trick
+// (stw 0x43300000 / stw byte / lfd, fsubs the double at r2-30888), fmuls the scale at r2-30896,
+// the float at r2-30892 is the fourth component; the four are multiplied by the table at
+// 0x802B5910 (leaf 0x800562E4) and passed to 0x800459DC(gfx, v), gfx = [r13-30108]. Lights: the
+// bytes m+8..m+B (the same bytes for both) scaled and multiplied by the tables 0x802B5920 + 16 i
+// go to 0x80045BCC(gfx, i, v) for i = 0, 1. Both callees skip the GX call when the byte
+// gfx+0x2180 is set and 0x80056328 finds the four floats equal to their cache (ambient
+// gfx+0x2070, light i gfx+0x20C0 + 16 i). Otherwise they copy v to the cache, turn it into a
+// GXColor (0x8005643C: fmuls by r2-31112, fadds r2-31116, fctiwz, four stb) and call
+// GXSetChanAmbColor(4, &c) (0x800C655C), or build a GXLightObj on the stack (colour at +0xC,
+// position from gfx+0x20A0 + 16 i at +0x28) and call GXLoadLightObjImm(&obj, id) (0x800C64E0)
+// with id from r2-31488 / r2-31484.
+//
+// The translation spends ~1550 instructions on a call whose caches all hit (qemu count, see the
+// snippet header): five calls with their CpuContext syncs, the stack round trips of the scratch
+// slots, and the scalar-single emulation of 31 fsubs/fmuls (each fmuls rounds its second operand
+// to 25 bits, each result goes through a double and every stfs through Gekko's narrowing). Here
+// the chain is one function: every guest store of the chain is made (frame, register saves,
+// scratch slots, the four callee frames, the 0x8005643C frames, the cache copies, the GXLightObj
+// fields), the values it reads back from its own stack are forwarded, and the colours are
+// computed in host singles. The GX natives are called as the translated callees call them
+// (InvokeDirectCpu with r3/r4 set, the same guest memory in place).
+//
+// Why host singles give the translation's bits, on the fast path's inputs (the magic double is
+// 2^52 exactly; the scale, the alpha and the 12 table floats are zero or normal, the scale below
+// 2^110): byte + 2^52 - 2^52 is the byte exactly, so the colour is fmuls(scale, byte), whose
+// product is exact in a double (24 + 8 bits): one rounding to single, which is the single
+// multiply's (FPCR.FZ: both go through FPRound, flushing a tiny result before rounding, and no
+// input is subnormal; any rounding mode). The colour (finite, |c| < 2^118) and the table entry
+// are singles, so PpcForce25BitInline is the identity, the product is exact in a double, and
+// fmuls is again the single multiply: finite or infinite, never NaN. A single that is not NaN
+// survives stfs + lfs unchanged (subnormal only without FZ, where both are exact), so every
+// forwarded slot holds what the reload would give, and lfs is the same FCVT here as there. The
+// four lanes of a NEON fmul / fcmeq are the scalar instructions (AArch64 AdvSIMD honours FPCR's
+// FZ, DN and rounding mode; nothing reads the host's cumulative FPSR flags). The compare
+// (0x80056328) of two widened singles is the single compare (under FZ both flush a subnormal
+// cache value to zero). The miss path (0x8005643C, the cache copies, the light positions) and
+// the prologue's psq_st / epilogue's psq_l use the translation's helpers.
+//
+// Guards, all checked before the first store, any failure runs the translation (kept by
+// REGISTER_NATIVE_FUNCTION_AS) for the whole call: the inputs above; checked access mode; the
+// stack the chain writes ([sp-160, r1+8), sp the 16-byte aligned frame), the bytes near r13
+// (flag, gfx pointer), the material bytes, the constants [r2-31488, r2-30880), the tables
+// 0x802B5910..0x802B593F and the gfx area [gfx+0x2070, gfx+0x2181) (caches, light positions,
+// cache flag) are plain RAM (no wrap, outside the MMIO window), the stack is disjoint from all of
+// them and the gfx area from the other inputs. So no store of the chain changes an input, the
+// inputs can be read once, and the stack slots hold exactly what this function stored. The GX
+// natives read guest memory (the colour word, the GXLightObj) and write none.
+//
+// The CpuContext at return is the translation's, all of it: r0 (LR), r1, r3-r7 as the last
+// 0x80045BCC call leaves them, r10-r12, f0-f5 as the last compare, 0x8005643C or the light
+// position loads leave them, CR (CR0 = EQ|SO, the loop's last cmpw), XER (subfic's CA), r27-r31,
+// f30, f31 and LR as they came in. WIICOMPILED_MLB_LIGHT_NATIVE=0 runs the translation (A/B).
+// Cross-checked against the translated chain in qemu-aarch64 (local/tmp/cpu/LIGHT).
+//
+// This file builds like the translated code (-O2 -fno-fast-math -ffp-contract=off, outside the
+// unity build: runtime/CMakeLists.txt).
+//
+// Desktop port (tools/patches/wiicompiled-pc-natives.patch, from the Switch patch's phase 95): the
+// four-lane NEON arithmetic is written as four scalar lanes (Vec4), and each single multiply that
+// the translation makes as fmuls is the host multiply with the translation's own rounding at the one
+// place they can part under FPSCR[NI] (an exact tiny product that rounds to +-FLT_MIN: NI flushes it
+// before rounding, x86's FTZ after). Checked against the PC translation: local/pc-opt/tests/light.
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include "abi_bridge.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+
+extern "C" void func_80061220(CpuContext* ctx);  // the translation (kept: _AS registration)
+
+namespace mlb_light {
+
+inline uint8_t* Host(uint32_t address) { return MKW_FLAT_GUEST_BASE + address; }
+
+inline uint8_t Load8(uint32_t address) { return *Host(address); }
+
+inline uint32_t Load32(uint32_t address) {
+    uint32_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap32(raw);
+}
+
+inline uint64_t Load64(uint32_t address) {
+    uint64_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap64(raw);
+}
+
+inline void Store32(uint32_t address, uint32_t value) {
+    const uint32_t raw = __builtin_bswap32(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
+}
+
+inline void Store64(uint32_t address, uint64_t value) {
+    const uint64_t raw = __builtin_bswap64(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
+}
+
+inline uint32_t Bits(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof bits);
+    return bits;
+}
+
+inline float Float(uint32_t bits) {
+    float value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+// lfs: the loaded single widened as FlatReadFloat32's caller does (FCVT; FZ flushes a subnormal).
+inline double Lfs(uint32_t bits) { return static_cast<double>(Float(bits)); }
+
+// stfs: Gekko's narrowing, as FlatWrite(Ram)Float32 stores it.
+inline uint32_t Stfs(double value) { return MemoryInline::ConvertPpcDoubleToSingleBits(value); }
+
+// Four lanes (the NEON registers of the Switch version).
+struct Vec4 { float v[4]; };
+struct Bits4 { uint32_t v[4]; };
+
+// fmuls of two singles whose product is exact in a double: one rounding; the translation's own
+// rounding where NI's pre-round flush and the host's FTZ can disagree (+-FLT_MIN).
+inline float Mul(float a, float b) {
+    const float r = a * b;
+    if ((Bits(r) & 0x7FFFFFFFu) == 0x00800000u && MkwHostNiActiveInline()) [[unlikely]]
+        return PpcForceSingleValueInline(double(a) * double(b));
+    return r;
+}
+
+// Four big-endian words / singles at a guest address, and back.
+inline Bits4 LoadWords(uint32_t address) { return {{Load32(address), Load32(address + 4u), Load32(address + 8u), Load32(address + 12u)}}; }
+inline void StoreWords(uint32_t address, const Vec4& value) {
+    for (uint32_t k = 0; k < 4; ++k) Store32(address + 4u * k, Bits(value.v[k]));
+}
+
+// [address, address + length) neither wraps nor touches 0xCC000000-0xCDFFFFFF.
+inline bool Plain(uint32_t address, uint64_t length) {
+    const uint64_t end = static_cast<uint64_t>(address) + length;
+    return end <= 0x100000000ull && (end <= 0xCC000000ull || address >= 0xCE000000u);
+}
+
+inline bool Disjoint(uint64_t a, uint64_t aLength, uint64_t b, uint64_t bLength) {
+    return a + aLength <= b || b + bLength <= a;
+}
+
+// Zero or normal (not subnormal, infinite or NaN): one word, or all ones in the lanes that are not.
+inline bool Tame(uint32_t bits) {
+    const uint32_t exponent = bits & 0x7F800000u;
+    return exponent != 0x7F800000u && (exponent != 0 || (bits & 0x7FFFFFFFu) == 0);
+}
+
+inline bool Wild(const Bits4& bits) {
+    for (uint32_t k = 0; k < 4; ++k) if (!Tame(bits.v[k])) return true;
+    return false;
+}
+
+// 0x80056328(cache, v) compares the lfs pairs in order and stops at the first difference: equal
+// when all four lanes are (the double compare of two widened singles is the single compare, FZ
+// flushing a subnormal in both); its r6 is "the first two equal".
+struct Equal4 { bool v[4]; bool All() const { return v[0] && v[1] && v[2] && v[3]; } };
+inline Equal4 Equal(uint32_t cacheAt, const Vec4& value) {
+    Equal4 e;
+    for (uint32_t k = 0; k < 4; ++k) e.v[k] = Float(Load32(cacheAt + 4u * k)) == value.v[k];
+    return e;
+}
+
+// 0x8005643C(v): GXColor from four lfs values, with the translation's helpers; the word (r3),
+// its r5 (red's fctiwz word) and the f0-f5 it leaves. Also its frame under sp (stwu r1,-48(r1);
+// four stb at +8..+11).
+struct Colour8 {
+    uint32_t word, r5;
+    double f[6];
+};
+
+[[gnu::noinline]] Colour8 ToColour(uint32_t sp, const double v[4], double scale, double bias) {
+    double f3 = PpcFmulsInline(scale, v[0]);
+    double f2 = PpcFmulsInline(scale, v[1]);
+    double f1 = PpcFmulsInline(scale, v[2]);
+    double f0 = PpcFmulsInline(scale, v[3]);
+    f3 = static_cast<double>(PpcForceSingleValueInline(bias + f3));
+    f2 = static_cast<double>(PpcForceSingleValueInline(bias + f2));
+    f1 = static_cast<double>(PpcForceSingleValueInline(bias + f1));
+    f0 = static_cast<double>(PpcForceSingleValueInline(bias + f0));
+    f3 = PPC_Fctiwz(f3);
+    f2 = PPC_Fctiwz(f2);
+    f1 = PPC_Fctiwz(f1);
+    f0 = PPC_Fctiwz(f0);
+    const uint32_t w0 = PPC_FprLowWordInline(f3), w1 = PPC_FprLowWordInline(f2);
+    const uint32_t w2 = PPC_FprLowWordInline(f1), w3 = PPC_FprLowWordInline(f0);
+    Colour8 c;
+    c.word = ((w0 & 255u) << 24) | ((w1 & 255u) << 16) | ((w2 & 255u) << 8) | (w3 & 255u);
+    c.r5 = w0;
+    c.f[0] = f0; c.f[1] = f1; c.f[2] = f2; c.f[3] = f3; c.f[4] = bias; c.f[5] = scale;
+    Store32(sp - 48u, sp);
+    Store32(sp - 40u, c.word);
+    return c;
+}
+
+// WIICOMPILED_MLB_LIGHT_NATIVE=0 runs the translation (A/B); on otherwise.
+int g_state = 0;  // 0 unresolved, 1 on, 2 off; guest code runs on one host thread
+
+[[gnu::noinline, gnu::cold]] void Resolve() {
+    const char* v = std::getenv("WIICOMPILED_MLB_LIGHT_NATIVE");
+    g_state = v != nullptr && v[0] == '0' ? 2 : 1;
+}
+
+constexpr uint32_t kTables = 0x802B5910u;  // ambient 4 floats, then 2 x 4 for the lights
+constexpr uint64_t kTablesLength = 48u;
+
+}  // namespace mlb_light
+
+extern "C" void MLB_LightColors_80061220(CpuContext* ctx) {
+    using namespace mlb_light;
+    HleTraceCall("MLB_LightColors_80061220");
+    if (g_state != 1) [[unlikely]] {
+        if (g_state == 0) Resolve();
+        if (g_state != 1) {
+            func_80061220(ctx);
+            return;
+        }
+    }
+    const uint32_t r1 = ctx->gpr[1], r2 = ctx->gpr[2], r4 = ctx->gpr[4], r13 = ctx->gpr[13];
+    const uint32_t sp = r1 - 128u - (r1 & 15u);  // clrlwi / subfic / stwux
+    // The stack the chain writes: 0x8005643C's back chain under 0x80045BCC's frame (sp-160) up to
+    // the LR save word at r1+4.
+    const uint32_t low = sp - 160u;
+    const uint64_t stackLength = static_cast<uint64_t>(r1) + 8u - low;
+    const uint32_t flagAt = r13 - 28816u;
+    if (GuestFlat::RequiresCheckedAccess() || r1 < 0x200u || r1 > 0xFFFFFF00u || !Plain(low, stackLength) ||
+        !Plain(flagAt, 1u) || !Disjoint(flagAt, 1u, low, stackLength)) [[unlikely]] {
+        func_80061220(ctx);
+        return;
+    }
+    const uint8_t enabled = Load8(flagAt);
+
+    uint32_t gfx = 0;
+    Vec4 ambient{}, light0{}, light1{}, colour{};
+    Bits4 bytesA{}, bytesL{};
+    if (enabled != 0) {
+        const uint32_t gfxAt = r13 - 30108u, material = r4 + 4u, constants = r2 - 31488u;
+        constexpr uint64_t kMaterialLength = 8u, kConstantsLength = 31488u - 30880u, kAreaLength = 0x2181u - 0x2070u;
+        bool ok = Plain(gfxAt, 4u) && Disjoint(gfxAt, 4u, low, stackLength) && Plain(material, kMaterialLength) &&
+                  Plain(constants, kConstantsLength) && Disjoint(material, kMaterialLength, low, stackLength) &&
+                  Disjoint(constants, kConstantsLength, low, stackLength) &&
+                  Disjoint(kTables, kTablesLength, low, stackLength);
+        if (ok) {
+            gfx = Load32(gfxAt);
+            const uint32_t area = gfx + 0x2070u;
+            ok = Plain(area, kAreaLength) && Disjoint(area, kAreaLength, low, stackLength) &&
+                 Disjoint(area, kAreaLength, flagAt, 1u) && Disjoint(area, kAreaLength, gfxAt, 4u) &&
+                 Disjoint(area, kAreaLength, material, kMaterialLength) &&
+                 Disjoint(area, kAreaLength, constants, kConstantsLength) &&
+                 Disjoint(area, kAreaLength, kTables, kTablesLength);
+        }
+        if (ok) {
+            const uint32_t scaleBits = Load32(r2 - 30896u), alphaBits = Load32(r2 - 30892u);
+            const Bits4 t0 = LoadWords(kTables), t1 = LoadWords(kTables + 16u), t2 = LoadWords(kTables + 32u);
+            ok = Load64(r2 - 30888u) == 0x4330000000000000ull && Tame(scaleBits) &&
+                 (scaleBits & 0x7F800000u) < 0x76800000u && Tame(alphaBits) &&  // |scale| < 2^110
+                 !Wild(t0) && !Wild(t1) && !Wild(t2);
+            // m+4 .. m+B as words; the colours (a byte converts exactly) and the products.
+            for (uint32_t k = 0; k < 4; ++k) {
+                bytesA.v[k] = Load8(material + k);
+                bytesL.v[k] = Load8(material + 4u + k);
+            }
+            const float scale = Float(scaleBits);
+            Vec4 colourA;
+            for (uint32_t k = 0; k < 4; ++k) {
+                colourA.v[k] = k == 3 ? Float(alphaBits) : Mul(static_cast<float>(bytesA.v[k]), scale);
+                colour.v[k] = Mul(static_cast<float>(bytesL.v[k]), scale);
+            }
+            for (uint32_t k = 0; k < 4; ++k) {
+                ambient.v[k] = Mul(colourA.v[k], Float(t0.v[k]));
+                light0.v[k] = Mul(colour.v[k], Float(t1.v[k]));
+                light1.v[k] = Mul(colour.v[k], Float(t2.v[k]));
+            }
+        }
+        if (!ok) [[unlikely]] {
+            func_80061220(ctx);
+            return;
+        }
+    }
+
+    // Prologue: back chain, LR, f31/f30 as stfd + psq_st pairs, _savegpr_27.
+    const uint32_t lr = ctx->lr;
+    Store32(sp, r1);
+    Store32(r1 + 4u, lr);
+    Store64(r1 - 16u, ctx->fpr[31].raw);
+    PPC_PsqStStackInline<0u, 0u>(ctx, r1 - 8u, PPC_PsFromScalarInline(ctx->fpr[31].d));
+    Store64(r1 - 32u, ctx->fpr[30].raw);
+    PPC_PsqStStackInline<0u, 0u>(ctx, r1 - 24u, PPC_PsFromScalarInline(ctx->fpr[30].d));
+    for (uint32_t reg = 27; reg <= 31; ++reg) Store32(r1 - 52u + 4u * (reg - 27u), ctx->gpr[reg]);
+    Store32(sp + 48u, 0x43300000u);
+    Store32(sp + 56u, 0x43300000u);
+
+    uint32_t r3 = 0x43300000u;
+    if (enabled != 0) {
+        const uint8_t cached = Load8(gfx + 0x2180u);
+
+        // Ambient: v = (m+4, m+5, m+6 scaled, alpha) * table 0, at sp+32; 0x800459DC(gfx, sp+32).
+        StoreWords(sp + 32u, ambient);
+        Store32(sp + 52u, bytesA.v[0]);
+        Store32(sp + 60u, bytesA.v[1]);
+        const uint32_t s2 = sp - 32u;  // frame; LR 0x800612E0 at sp+4; r31, r30 saved
+        Store32(s2, sp);
+        Store32(sp + 4u, 0x800612E0u);
+        Store32(s2 + 28u, ctx->gpr[31]);
+        Store32(s2 + 24u, ctx->gpr[30]);
+        if (cached == 0 || !Equal(gfx + 0x2070u, ambient).All()) {
+            const float* v = ambient.v;
+            double copy[4];
+            for (uint32_t k = 0; k < 4; ++k) {
+                const uint32_t bits = Stfs(static_cast<double>(v[k]));
+                Store32(gfx + 0x2070u + 4u * k, bits);
+                copy[k] = Lfs(bits);
+            }
+            const Colour8 c = ToColour(s2, copy, Lfs(Load32(r2 - 31112u)), Lfs(Load32(r2 - 31116u)));
+            Store32(s2 + 12u, c.word);
+            Store32(s2 + 8u, c.word);
+            ctx->gpr[3] = 4u;
+            ctx->gpr[4] = s2 + 8u;
+            InvokeDirectCpu<0x800C655Cu>(ctx);  // GXSetChanAmbColor(GX_COLOR0A0, &c)
+        }
+
+        // Lights 0 and 1: v = (m+8 .. m+B scaled) * table 1 + i, at sp+16; 0x80045BCC(gfx, i, v).
+        const uint32_t id0 = Load32(r2 - 31488u), id1 = Load32(r2 - 31484u);
+        const uint32_t s3 = sp - 112u;  // frame; LR 0x80061378 at sp+4; r31/r30/r29 = 16 i, table, 2
+        Store32(sp + 52u, bytesL.v[0]);
+        Store32(sp + 60u, bytesL.v[1]);
+        uint32_t r4o = 0, r5o = 0, r6o = 0;
+        double f[6] = {};
+        for (uint32_t i = 0; i < 2; ++i) {
+            const Vec4& light = i == 0 ? light0 : light1;
+            StoreWords(sp + 16u, light);
+            Store32(s3, sp);
+            Store32(sp + 4u, 0x80061378u);
+            Store32(s3 + 108u, 16u * i);
+            Store32(s3 + 104u, 0x802B5920u);
+            Store32(s3 + 100u, 2u);
+            Store32(s3 + 16u, id0);
+            Store32(s3 + 20u, id1);
+            const uint32_t cacheAt = gfx + 0x20C0u + 16u * i;
+            Equal4 equal{};
+            if (cached != 0) {
+                equal = Equal(cacheAt, light);
+                if (equal.All()) {
+                    r3 = 1;
+                    r4o = sp + 16u;
+                    r5o = 1;
+                    r6o = 1;
+                    f[0] = light.v[3];
+                    f[1] = Lfs(Load32(cacheAt + 12u));
+                    f[2] = light.v[2];
+                    f[3] = colour.v[2];
+                    f[4] = light.v[1];
+                    f[5] = light.v[0];
+                    continue;
+                }
+            }
+            const float* v = light.v;
+            double reload[4];
+            for (uint32_t k = 0; k < 4; ++k) {
+                reload[k] = static_cast<double>(v[k]);
+                Store32(cacheAt + 4u * k, Stfs(reload[k]));
+            }
+            const Colour8 c = ToColour(s3, reload, Lfs(Load32(r2 - 31112u)), Lfs(Load32(r2 - 31116u)));
+            Store32(s3 + 8u, c.word);
+            Store32(s3 + 36u, c.word);  // GXInitLightColor (leaf 0x800C64D4)
+            const uint32_t position = gfx + 0x20A0u + 16u * i;
+            for (uint32_t k = 0; k < 3; ++k) {
+                f[1 + k] = Lfs(Load32(position + 4u * k));
+                Store32(s3 + 64u + 4u * k, Stfs(f[1 + k]));  // GXInitLightPos (leaf 0x800C64C4)
+            }
+            const uint32_t id = i == 0 ? id0 : id1;
+            r3 = s3 + 24u;
+            r4o = id;
+            r5o = c.r5;
+            r6o = cached != 0 ? ((equal.v[0] && equal.v[1]) ? 1u : 0u) : id1;
+            f[0] = c.f[0]; f[4] = c.f[4]; f[5] = c.f[5];
+            ctx->gpr[3] = r3;
+            ctx->gpr[4] = id;
+            InvokeDirectCpu<0x800C64E0u>(ctx);  // GXLoadLightObjImm(&obj, id)
+        }
+        ctx->gpr[4] = r4o;
+        ctx->gpr[5] = r5o;
+        ctx->gpr[6] = r6o;
+        ctx->gpr[7] = id0;
+        for (uint32_t k = 0; k < 6; ++k) ctx->fpr[k].d = f[k];
+    }
+
+    // Epilogue: the psq_l pair (its value replaced by the lfd), _restgpr_27, LR from the frame.
+    const uint32_t gqr0 = ctx->gqr[0];
+    (void)PPC_PsqLGqrInline<0u, 0u>(ctx, gqr0, r1 - 8u);
+    (void)PPC_PsqLGqrInline<0u, 0u>(ctx, gqr0, r1 - 24u);
+    const uint32_t xer = ctx->xer;
+    ctx->gpr[0] = lr;
+    ctx->gpr[3] = r3;
+    ctx->gpr[10] = r1;
+    ctx->gpr[11] = r1 - 32u;
+    ctx->gpr[12] = r1;
+    ctx->cr = (ctx->cr & 0x0FFFFFFFu) | ((2u | (xer >> 31)) << 28);  // CR0: the last cmpw, equal
+    ctx->xer = xer | 0x20000000u;                                     // subfic's carry
+}
+REGISTER_NATIVE_FUNCTION_AS(0x80061220, MLB_LightColors_80061220, "LightColors");
diff --git a/runtime/src/hle/mlb/msl_natives.cpp b/runtime/src/hle/mlb/msl_natives.cpp
new file mode 100644
index 0000000..f31acbe
--- /dev/null
+++ b/runtime/src/hle/mlb/msl_natives.cpp
@@ -0,0 +1,231 @@
+// MLB Power Pros 2008 (RL8E54): native leaves for two MSL routines, ported from the Switch build
+// (tools/patches/wiicompiled-switch*.patch, phase 21) to the desktop builds. PC profile (match
+// benchmark, Ryzen 5 5500): 0.70% + 0.35% of the main thread's samples, ~3% of its busy time.
+//
+// __ieee754_sqrt (0x80126AE8, reached through sqrt at 0x80128FD0) is fdlibm's bit-by-bit loop:
+// 54 iterations of integer work plus its frame stores. Its rounding test compares the constant
+// 1.0 (r2-28672) with itself, so it always rounds to nearest, whatever FPSCR[RN] says, and fdlibm
+// rounded to nearest is the correctly rounded root for every positive input, subnormals
+// included: a hardware square root in round-to-nearest gives the same bits.
+//
+// __fill_mem (0x80006508, under memset at 0x800065BC) stores byte by byte up to a word boundary,
+// then words, then bytes. All of its stores to plain RAM land as one memset; a range touching
+// anything else keeps the original store sequence.
+//
+// Both leave the result, every guest store and the FP registers as the originals do; the scratch
+// integer registers (r0, r3-r12), cr0/cr1 and XER[CA] keep their entry values (volatile in the
+// EABI: nothing reads them after the call). The registered bodies touch the CpuContext only
+// through constant indexes and pass it nowhere, which gives the translator a precise contract.
+// Equivalence with the PC translation: local/pc-opt/tests/msl (x86-64, both built with the
+// product flags).
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+#if defined(__x86_64__)
+#include <immintrin.h>
+#endif
+
+#include "abi_bridge.h"
+#include "memory.h"
+
+namespace mlb_msl {
+
+constexpr uint64_t kFraction = 0x000FFFFFFFFFFFFFull, kImplicit = 1ull << 52;
+
+uint64_t Bits(double value) {
+    uint64_t bits;
+    std::memcpy(&bits, &value, sizeof bits);
+    return bits;
+}
+
+double FromBits(uint64_t bits) {
+    double value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+// One instruction each: the runtime builds with -ffast-math, which may contract, reassociate or
+// approximate host FP; the translated code they stand for builds with -fno-fast-math.
+#if defined(__x86_64__)
+double Mul(double a, double b) { return _mm_cvtsd_f64(_mm_mul_sd(_mm_set_sd(a), _mm_set_sd(b))); }
+double Add(double a, double b) { return _mm_cvtsd_f64(_mm_add_sd(_mm_set_sd(a), _mm_set_sd(b))); }
+double Widen(float value) { return _mm_cvtsd_f64(_mm_cvtss_sd(_mm_setzero_pd(), _mm_set_ss(value))); }
+double ToDouble(uint64_t value) {  // exact below 2^53 (the only use)
+    return _mm_cvtsd_f64(_mm_cvtsi64_sd(_mm_setzero_pd(), static_cast<long long>(value)));
+}
+// sqrtsd rounded to nearest. The runtime never changes MXCSR.RC (only FTZ/DAZ), so the second
+// branch is a guarantee, not a path.
+double SqrtNearest(double value) {
+    const unsigned csr = _mm_getcsr();
+    if ((csr & 0x6000u) == 0) [[likely]]
+        return _mm_cvtsd_f64(_mm_sqrt_sd(_mm_setzero_pd(), _mm_set_sd(value)));
+    _mm_setcsr(csr & ~0x6000u);
+    const double result = _mm_cvtsd_f64(_mm_sqrt_sd(_mm_setzero_pd(), _mm_set_sd(value)));
+    _mm_setcsr(csr);
+    return result;
+}
+#else
+double Mul(double a, double b) {
+    double result;
+    __asm__("fmul %d0, %d1, %d2" : "=w"(result) : "w"(a), "w"(b));
+    return result;
+}
+double Add(double a, double b) {
+    double result;
+    __asm__("fadd %d0, %d1, %d2" : "=w"(result) : "w"(a), "w"(b));
+    return result;
+}
+double Widen(float value) {
+    double result;
+    __asm__("fcvt %d0, %s1" : "=w"(result) : "w"(value));
+    return result;
+}
+double ToDouble(uint64_t value) {  // exact below 2^53
+    double result;
+    __asm__("ucvtf %d0, %x1" : "=w"(result) : "r"(value));
+    return result;
+}
+double SqrtNearest(double value) {
+    uint64_t fpcr;
+    __asm__ __volatile__("mrs %0, fpcr" : "=r"(fpcr));
+    double result;
+    if ((fpcr & (3ull << 22)) == 0) [[likely]] {
+        __asm__("fsqrt %d0, %d1" : "=w"(result) : "w"(value));
+        return result;
+    }
+    __asm__ __volatile__("msr fpcr, %1\n\tfsqrt %d0, %d2\n\tmsr fpcr, %3"
+                         : "=&w"(result) : "r"(fpcr & ~(3ull << 22)), "w"(value), "r"(fpcr) : "memory");
+    return result;
+}
+#endif
+
+// The correctly rounded root of a positive, finite, nonzero double, and whether it is exact.
+// fdlibm's remainder is zero exactly then: an odd root of 54 significant bits squares to more
+// than the 53 a double holds.
+uint64_t PositiveSqrt(uint64_t x, bool& exact) {
+    uint64_t root, mantissa;
+    int exponent;  // x = mantissa * 2^exponent
+    if ((x >> 52) == 0) {
+        // Subnormal x = m * 2^-1074: sqrt(m) * 2^-537, m converted exactly and the scale applied to
+        // the exponent field (the root stays normal), so flush-to-zero / DAZ never meets a subnormal.
+        root = Bits(SqrtNearest(ToDouble(x))) - (537ull << 52);
+        mantissa = x;
+        exponent = -1074;
+    } else {
+        root = Bits(SqrtNearest(FromBits(x)));
+        mantissa = (x & kFraction) | kImplicit;
+        exponent = static_cast<int>(x >> 52) - 1075;
+    }
+    // root^2 == x  <=>  rootMantissa^2 == mantissa << shift
+    const uint64_t rootMantissa = (root & kFraction) | kImplicit;
+    const int shift = exponent - 2 * (static_cast<int>(root >> 52) - 1075);
+    const unsigned __int128 square = static_cast<unsigned __int128>(rootMantissa) * rootMantissa;
+    exact = shift >= 0 && shift < 128 && (square >> shift) == mantissa &&
+            (square & ((static_cast<unsigned __int128>(1) << shift) - 1u)) == 0;
+    return root;
+}
+
+// Host bytes for guest [address, address + length), inside one 1 MiB page, when every
+// __fill_mem store there takes the plain-RAM path; nullptr otherwise.
+uint8_t* PlainRam(uint32_t address, uint32_t length) {
+    if (uint8_t* host = MemoryInline::ResolveRangeHost(address, 0, length, false, true)) return host;
+    if (!GuestFlat::RequiresCheckedAccess()) return nullptr;
+    // Checked access: Memory::Write8/Write32 store through the page's writable bias when it has
+    // one (TryWriteGuestScalar; the word stores are aligned, so none crosses the page).
+    const uintptr_t bias = MemoryInline::g_fullWritablePageBias[address >> MemoryInline::kPageShift];
+    return bias != 0 ? reinterpret_cast<uint8_t*>((bias - 1u) + address) : nullptr;
+}
+
+// All or nothing: one special page keeps the whole original store sequence.
+bool FillPlainRam(uint32_t dst, uint8_t value, uint32_t count) {
+    if (count - 1u > UINT32_MAX - dst) return false;  // wraps around the address space
+    const uint32_t last = dst + (count - 1u);
+    for (uint32_t at = dst;;) {
+        const uint32_t end = std::min(last, at | MemoryInline::kPageMask);
+        if (PlainRam(at, end - at + 1u) == nullptr) return false;
+        if (end == last) break;
+        at = end + 1u;
+    }
+    for (uint32_t at = dst;;) {
+        const uint32_t end = std::min(last, at | MemoryInline::kPageMask);
+        std::memset(PlainRam(at, end - at + 1u), value, end - at + 1u);
+        if (end == last) break;
+        at = end + 1u;
+    }
+    return true;
+}
+
+// __fill_mem's own stores, in its order and widths.
+void FillStores(uint32_t dst, uint8_t value, uint32_t count) {
+    uint32_t last = dst - 1u;  // r6: the last byte stored
+    if (count >= 32) {
+        uint32_t align = (0u - dst) & 3u;
+        count -= align;
+        for (; align != 0; --align) MemoryInline::FlatWrite8(++last, value);
+        const uint32_t word = value * 0x01010101u;
+        uint32_t base = last - 3u;  // r3: words go to base + 4
+        for (uint32_t blocks = count >> 5; blocks != 0; --blocks) {
+            for (uint32_t offset = 4; offset <= 32; offset += 4) MemoryInline::FlatWrite32(base + offset, word);
+            base += 32;
+        }
+        for (uint32_t words = (count >> 2) & 7u; words != 0; --words) {
+            MemoryInline::FlatWrite32(base + 4, word);
+            base += 4;
+        }
+        last = base + 3u;
+        count &= 3u;
+    }
+    for (; count != 0; --count) MemoryInline::FlatWrite8(++last, value);
+}
+
+}  // namespace mlb_msl
+
+// double __ieee754_sqrt(double x): f1 in, f1 out; errno (r13-26456) = EDOM for NaN, infinities
+// and negatives.
+extern "C" void MLB_Sqrt_80126AE8(CpuContext* ctx) {
+    HleTraceCall("MLB_Sqrt_80126AE8");
+    const uint32_t frame = ctx->gpr[1] - 32u;
+    const double x = ctx->fpr[1].d;
+    // The bits from the register file as an integer: Clang may turn a test of Bits(x) into an FP
+    // compare (bits << 1 == 0 as x == 0.0), which DAZ makes true for every subnormal x.
+    uint64_t bits = ctx->fpr[1].raw;
+    __asm__("" : "+r"(bits));
+    const uint32_t high = static_cast<uint32_t>(bits >> 32);
+    // The original's frame (back chain, x), below the stack pointer: the stack keeps its bytes.
+    MemoryInline::FlatWriteRam32(frame, ctx->gpr[1]);
+    MemoryInline::FlatWriteRamFloat64(frame + 8u, x);
+    if ((high & 0x7FF00000u) == 0x7FF00000u) {  // NaN or infinity: x*x + x
+        const double square = mlb_msl::Mul(x, x);
+        MemoryInline::FlatWrite32(ctx->gpr[13] - 26456u, 33u);
+        ctx->fpr[0].d = square;
+        ctx->fpr[1].d = mlb_msl::Add(x, square);
+        return;
+    }
+    if (static_cast<int32_t>(high) <= 0) {
+        if ((bits << 1) == 0) return;  // +-0
+        if (static_cast<int32_t>(high) < 0) {  // negative: the float NaN at 0x8031AA10 (lfs)
+            MemoryInline::FlatWrite32(ctx->gpr[13] - 26456u, 33u);
+            ctx->fpr[1].d = mlb_msl::Widen(MemoryInline::FlatReadFloat32(0x8031AA10u));
+            return;
+        }
+    }
+    bool exact = false;
+    const uint64_t root = mlb_msl::PositiveSqrt(bits, exact);
+    if (!exact) ctx->fpr[0].d = MemoryInline::FlatReadFloat64(ctx->gpr[2] - 28672u);  // its rounding test's 1.0
+    MemoryInline::FlatWriteRam32(frame + 20u, static_cast<uint32_t>(root));
+    MemoryInline::FlatWriteRam32(frame + 16u, static_cast<uint32_t>(root >> 32));
+    ctx->fpr[1].d = mlb_msl::FromBits(root);
+}
+REGISTER_NATIVE_FUNCTION(0x80126AE8, MLB_Sqrt_80126AE8);
+
+// void __fill_mem(void* dst, int value, unsigned long count)
+extern "C" void MLB_FillMem_80006508(CpuContext* ctx) {
+    HleTraceCall("MLB_FillMem_80006508");
+    const uint32_t dst = ctx->gpr[3];
+    const uint8_t value = static_cast<uint8_t>(ctx->gpr[4]);
+    const uint32_t count = ctx->gpr[5];
+    if (count == 0) return;
+    if (!mlb_msl::FillPlainRam(dst, value, count)) mlb_msl::FillStores(dst, value, count);
+}
+REGISTER_NATIVE_FUNCTION(0x80006508, MLB_FillMem_80006508);
diff --git a/runtime/src/hle/mlb/reverb_natives.cpp b/runtime/src/hle/mlb/reverb_natives.cpp
new file mode 100644
index 0000000..60e650d
--- /dev/null
+++ b/runtime/src/hle/mlb/reverb_natives.cpp
@@ -0,0 +1,499 @@
+// MLB Power Pros 2008 (RL8E54): a native 0x800BC3AC, the AXFX "ReverbHi" processing callback
+// (AXFXReverbHiCallback 0x800BC0E8 is a single branch to it). Run 11 profile: 4.2% of the Switch
+// main thread, the hottest audio function. Ported to the desktop builds from the Switch patch (phase
+// 43, C5): on the PC match benchmark it is ~3% of the main thread's busy time.
+//
+// void Reverb(int32_t** bufs /* r3: L, R, S */, Work* w /* r4 */) runs once per AX aux frame
+// (__AXOutNewFrame 0x800BA0D4, from the audio DMA callback: 96 samples = 3 ms, ~5.6 calls per
+// video frame). If w+0x10C is nonzero it clears bit 1 there and returns. Otherwise, per sample
+// and per channel (L, R, S): x = (float)(in + busIn), a 3-tap early line, an optional predelay
+// line, 3 parallel combs, 2 shared-index all-passes, a one-pole low-pass, a per-channel last
+// all-pass; then a crosstalk mix between the three channels written back in place as integers
+// (fctiwz, times w+0x140) and, with a bus-out descriptor, to the bus (times w+0x144). Every line
+// index steps once per sample and wraps at its length. docs/en/reverse-engineering.md section 4
+// ("MIX mixer and reverb") has the work-area layout.
+//
+// The translation emulates every single-precision op (operand rounded to 25 bits, the double
+// result narrowed through fcvt), turns each stfs into the Gekko narrowing routine plus the MMIO
+// check, keeps every index, pointer and scratch value on the guest stack or in the work area
+// with a reload per channel, and converts each input integer through the 0x43300000 double trick
+// on the stack. Here a sample is the same loads and stores of the sample arrays in the same
+// order, the arithmetic in host single precision, the work-area fields and stack slots in
+// registers, written once at the end.
+//
+// Why host singles give the translation's bits (FPCR.FZ on or off as it is; any rounding mode):
+// every operand is a single (lfs loads, single results, the exact int -> float conversion), so
+// PpcForce25BitInline is the identity, a single product is exact in a double, and a double sum
+// or product of singles narrowed once equals the single op (53 >= 2*24 + 2). FZ flushes subnormal
+// inputs and tiny results alike in both. stfs of a single is its own bits in
+// ConvertPpcDoubleToSingleBits. fctiwz of a single equals FCVTZS (saturating, toward zero) but
+// for NaN (0x80000000), kept. NaNs are where the two could part: an op with two NaN operands
+// returns one of them, and which one depends on the operand order the compiler picked for the
+// translation. Every NaN that arises in a call reaches a stored float (the integer conversions
+// do not depend on payloads), so the fast path checks every float it stores (an fmax chain:
+// fmax propagates NaN), and a call that stores a NaN is undone and run by the translation.
+//
+// Fast path conditions, checked at entry (else the translation runs the whole call): the flat
+// view, w+0x10C zero, the magic double at r2-30248 is 0x4330000080000000, and no access of the
+// call can see the deferred state: the stack frame [r1-112, r1+8), the work area [w, w+0x148)
+// and the constants [r2-30268, r2-30240) must not overlap one another, and every sample array
+// range the call can touch (in/out buffers, bus-in and bus-out buffers, every line from its index
+// over 96 steps, conservatively) must neither overlap them nor wrap nor touch the MMIO window
+// (0xCC000000-0xCDFFFFFF), nor may the buffer descriptors overlap the stack frame. The sample
+// arrays may overlap one another: their loads and stores keep the program order.
+//
+// Rollback: each sample-array store goes through an undo log (the value it replaces, which the
+// lines read just before the store); on a NaN the log is replayed backwards and nothing else has
+// been written yet (stack slots, work-area fields and the context are written after the loop).
+//
+// Kept exactly on the fast path (cross-checked with the translation in qemu-aarch64, see the
+// snippet header local/tmp/cpu/C5-reverb.py): every guest store (frame, saved registers, LR slot,
+// scratch slots, the pointer slots, the conversion double, the lines, the outputs, the work-area
+// indices and low-pass states) and the whole register state the translation leaves (r0-r12,
+// r25-r31, f0-f13, CR, CTR, LR).
+//
+// This file builds like the translated code (-O2 -fno-fast-math -ffp-contract=off, outside the
+// unity build: runtime/CMakeLists.txt). On AArch64 the FP ops are single instructions in asm; on
+// x86-64 they are plain single-precision expressions, which that FP policy keeps as one SSE/AVX
+// op each (no contraction, no reassociation, no widening). x86 NaN operand order differs from
+// AArch64's and from whatever order the translation's compiler picked, which is why every call
+// that stores a NaN is rolled back to the translation on both architectures. Checked against the
+// PC translation: local/pc-opt/tests/reverb (x86-64, product flags).
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#if defined(__x86_64__)
+#include <immintrin.h>
+#endif
+
+#include "abi_bridge.h"
+#include "memory.h"
+#include "ppc_runtime.h"
