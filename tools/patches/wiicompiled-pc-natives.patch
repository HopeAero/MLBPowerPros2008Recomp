+                PfAhead(h.early + (e0 << 2), first); PfAhead(h.early + (e1 << 2), first); PfAhead(h.early + (e2 << 2), first);
+                if (predelayLength != 0u) PfAhead(h.predelay + (pp << 2), first);
+                for (uint32_t k = 0; k < 3; ++k) PfAhead(h.comb[k] + (cj[k] << 2), first);
+                for (uint32_t k = 0; k < 2; ++k) PfAhead(h.allpass[k] + (ak[k] << 2), first);
+                PfAhead(h.last + (h.lastIndex << 2), first);
+                PfAhead(h.in, first);
+                if (busInDesc != 0u) PfAhead(h.busIn, first);
+            }
+            if (busOutDesc != 0u) { PfAhead(o3, first); PfAhead(o5, first); PfAhead(o6, first); }
+        }
