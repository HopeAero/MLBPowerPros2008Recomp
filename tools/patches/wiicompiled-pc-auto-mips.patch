+inline uint32_t load32(const uint8_t* p) noexcept {
+  uint32_t v;
+  std::memcpy(&v, p, 4);
+  return v;
+}
+
+inline void store32(uint8_t* p, uint32_t v) noexcept { std::memcpy(p, &v, 4); }
+
+// m[d] = ceil(2^32 / d). For numerators n <= 4*255*255 + 510 and divisors d in 1..1020 (the only values the
+// downsample can produce), (n * m[d]) >> 32 == n / d exactly (the error n * (m*d - 2^32) < 2^32; checked
+// exhaustively in local/tmp/cpu/P13-mips/test.cpp).
+struct RecipTable {
+  uint64_t m[1021];
+  constexpr RecipTable() : m() {
+    for (uint32_t d = 1; d <= 1020; ++d) {
+      m[d] = ((uint64_t{1} << 32) + d - 1) / d;
+    }
+  }
+};
+inline constexpr RecipTable kRecip{};
+
+// Coverage of a level from the histogram of its alpha values; the same float expression as coverage().
+inline float coverage_hist(const uint32_t* hist, size_t pixels, float scale) noexcept {
+  size_t covered = 0;
+  for (uint32_t a = 0; a < 256; ++a) {
+    covered += static_cast<float>(a) * scale >= static_cast<float>(kCoverageRef) ? hist[a] : 0u;
+  }
+  return pixels != 0 ? static_cast<float>(covered) / static_cast<float>(pixels) : 0.f;
+}
