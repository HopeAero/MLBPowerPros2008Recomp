+// One box-filtered level with edge clamping (source width or height 1, where texels repeat). Writes the
+// unscaled level to dst (w*h texels); with Hist also counts its alpha values.
+template <bool Hist>
+inline void downsample_clamped(
+    const uint8_t* prev, uint32_t pw, uint32_t ph, uint8_t* cur, uint32_t w, uint32_t h, uint32_t* hist) noexcept {
+  for (uint32_t y = 0; y < h; ++y) {
+    for (uint32_t x = 0; x < w; ++x) {
+      const uint32_t xs[2] = {std::min(x * 2, pw - 1), std::min(x * 2 + 1, pw - 1)};
+      const uint32_t ys[2] = {std::min(y * 2, ph - 1), std::min(y * 2 + 1, ph - 1)};
+      uint32_t sum[3] = {};
+      uint32_t weighted[3] = {};
+      uint32_t alpha = 0;
+      for (uint32_t sy : ys) {
+        for (uint32_t sx : xs) {
+          const uint8_t* p = &prev[(static_cast<size_t>(sy) * pw + sx) * 4];
+          for (int c = 0; c < 3; ++c) {
+            sum[c] += p[c];
+            weighted[c] += p[c] * p[3];
+          }
+          alpha += p[3];
+        }
+      }
+      uint8_t* d = &cur[(static_cast<size_t>(y) * w + x) * 4];
+      for (int c = 0; c < 3; ++c) {
+        d[c] = static_cast<uint8_t>(alpha != 0 ? (weighted[c] + alpha / 2) / alpha : (sum[c] + 2) / 4);
+      }
+      d[3] = static_cast<uint8_t>((alpha + 2) / 4);
+      if (Hist) {
+        ++hist[d[3]];
+      }
+    }
+  }
+}
