+// The same for pw >= 2 and ph >= 2: x*2+1 <= pw-1 for every x < pw/2 (likewise y), so nothing is clamped.
+// When the four alphas are equal (every opaque or fully transparent block) the alpha weighting cancels:
+// (a*sum + 2a) / 4a == (sum + 2) / 4. Otherwise the division by the alpha sum is a reciprocal multiply.
+template <bool Hist>
+inline void downsample_fast(
+    const uint8_t* prev, uint32_t pw, uint8_t* cur, uint32_t w, uint32_t h, uint32_t* hist) noexcept {
+  const size_t stride = static_cast<size_t>(pw) * 4;
+  for (uint32_t y = 0; y < h; ++y) {
+    const uint8_t* r0 = prev + static_cast<size_t>(y) * 2 * stride;
+    const uint8_t* r1 = r0 + stride;
+    uint8_t* d = cur + static_cast<size_t>(y) * w * 4;
+    for (uint32_t x = 0; x < w; ++x, r0 += 8, r1 += 8, d += 4) {
+      const uint32_t p0 = load32(r0);
+      const uint32_t p1 = load32(r0 + 4);
+      const uint32_t p2 = load32(r1);
+      const uint32_t p3 = load32(r1 + 4);
+      const uint32_t a0 = p0 >> 24;
+      const uint32_t a1 = p1 >> 24;
+      const uint32_t a2 = p2 >> 24;
+      const uint32_t a3 = p3 >> 24;
+      uint32_t out;
+      if (a0 == a1 && a0 == a2 && a0 == a3) {
+        // Red and blue sums share one word (each lane <= 1020 < 65536), green is summed alone.
+        const uint32_t rb = (p0 & 0x00FF00FFu) + (p1 & 0x00FF00FFu) + (p2 & 0x00FF00FFu) + (p3 & 0x00FF00FFu);
+        const uint32_t g = ((p0 >> 8) & 0xFFu) + ((p1 >> 8) & 0xFFu) + ((p2 >> 8) & 0xFFu) + ((p3 >> 8) & 0xFFu);
+        // (4*a0 + 2) / 4 == a0.
+        out = (((rb + 0x00020002u) >> 2) & 0x00FF00FFu) | (((g + 2) >> 2) << 8) | (a0 << 24);
+      } else {
+        const uint32_t alpha = a0 + a1 + a2 + a3;
+        const uint32_t r = (p0 & 0xFFu) * a0 + (p1 & 0xFFu) * a1 + (p2 & 0xFFu) * a2 + (p3 & 0xFFu) * a3;
+        const uint32_t g = ((p0 >> 8) & 0xFFu) * a0 + ((p1 >> 8) & 0xFFu) * a1 + ((p2 >> 8) & 0xFFu) * a2 +
+                           ((p3 >> 8) & 0xFFu) * a3;
+        const uint32_t b = ((p0 >> 16) & 0xFFu) * a0 + ((p1 >> 16) & 0xFFu) * a1 + ((p2 >> 16) & 0xFFu) * a2 +
+                           ((p3 >> 16) & 0xFFu) * a3;
+        const uint64_t m = kRecip.m[alpha]; // alpha is 1..1020 here (not all four zero)
+        const uint32_t half = alpha / 2;
+        const uint32_t qr = static_cast<uint32_t>((static_cast<uint64_t>(r + half) * m) >> 32);
+        const uint32_t qg = static_cast<uint32_t>((static_cast<uint64_t>(g + half) * m) >> 32);
+        const uint32_t qb = static_cast<uint32_t>((static_cast<uint64_t>(b + half) * m) >> 32);
+        out = (qr & 0xFFu) | ((qg & 0xFFu) << 8) | ((qb & 0xFFu) << 16) | (((alpha + 2) >> 2) << 24);
+      }
+      store32(d, out);
+      if (Hist) {
+        ++hist[out >> 24];
+      }
+    }
+  }
+}
