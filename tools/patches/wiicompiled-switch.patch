diff --git a/runtime/include/compute_preempt.h b/runtime/include/compute_preempt.h
new file mode 100644
index 0000000..e155698
--- /dev/null
+++ b/runtime/include/compute_preempt.h
@@ -0,0 +1,86 @@
+#pragma once
+// T8 (switch phase 51): compute preemption points. On unless WIICOMPILED_COMPUTE_PREEMPT=0.
+//
+// Guest threads are cooperative fibers on one host thread, so a due OSSleepTicks timer (MLB's 5 ms
+// sound ticker above all: the commentary phrase clocks) only fires at a scheduler pass. Translated
+// code can compute 8-20 ms without one (home-run camera, base running, replays). These points take
+// the alarm interrupt at the entry of hot compute leaf natives (PSMTXConcat, __ieee754_sqrt,
+// __fill_mem: hle/mlb/mtx_natives.cpp, msl_natives.cpp), i.e. at a guest `bl` from translated code,
+// and only when hle/os/os_scheduler.cpp MkwComputePreemptSlow finds it is a point where the hardware
+// could take the interrupt: see there. Only this header and the .cpp files that include it see it
+// (never the translated code), so changing it rebuilds a handful of runtime objects.
+#if defined(__SWITCH__)
+#include <cstdint>
+
+extern "C" {
+// Visits left before the next deadline check (hle/os/os_scheduler.cpp).
+extern uint32_t g_mkwComputePreemptCountdown;
+// Nonzero while runtime code runs guest code where the hardware would not take the interrupt (a
+// synchronous DVD/WPAD completion callback, a native's nested leaf call): the points refuse.
+extern uint32_t g_mkwComputePreemptHold;
+void MkwComputePreemptSlow();
+}
+
+// Load, compare, store; every kMkwComputePreemptInterval-th visit compares CNTPCT with the earliest
+// sleep deadline. Takes no CpuContext: the registered natives' contract (the registers they read
+// and write) stays what it was.
+inline void MkwComputePreemptPoll() {
+    const uint32_t n = __atomic_load_n(&g_mkwComputePreemptCountdown, __ATOMIC_RELAXED);
+    if (n > 1) [[likely]] {
+        __atomic_store_n(&g_mkwComputePreemptCountdown, n - 1, __ATOMIC_RELAXED);
+        return;
+    }
+    MkwComputePreemptSlow();
+}
+
+struct MkwComputePreemptHoldScope {
+    MkwComputePreemptHoldScope() noexcept {
+        __atomic_store_n(&g_mkwComputePreemptHold, __atomic_load_n(&g_mkwComputePreemptHold, __ATOMIC_RELAXED) + 1,
+                         __ATOMIC_RELAXED);
+    }
+    ~MkwComputePreemptHoldScope() {
+        __atomic_store_n(&g_mkwComputePreemptHold, __atomic_load_n(&g_mkwComputePreemptHold, __ATOMIC_RELAXED) - 1,
+                         __ATOMIC_RELAXED);
+    }
+    MkwComputePreemptHoldScope(const MkwComputePreemptHoldScope&) = delete;
+    MkwComputePreemptHoldScope& operator=(const MkwComputePreemptHoldScope&) = delete;
+};
+
+// The guard, as a pure function (host-tested: local/tmp/cpu/T8-test). Every condition must hold for
+// the point to switch threads; the first failing one is returned.
+enum class MkwComputePreemptVerdict : uint8_t {
+    Take,
+    NotSchedulerThread,  // a poll on another host thread
+    Held,                // inside a DVD/WPAD completion callback or a native's nested leaf call
+    PrivateContext,      // a callback on its own register file (GuestInterruptCallbackContext, ...)
+    InterruptsOff,       // guest MSR[EE] clear
+    SchedulerDisabled,   // alarm handler, deferred VI/alarm/audio batch (scheduler disable count)
+    InRetrace,           // VI retrace callbacks
+    GxMidCommand,        // inside GXBegin/GXEnd, a display-list recording or a partial FIFO command
+    NotRunningThread,    // idle loop, SelectThread's switch callback, a thread mid-switch
+};
+struct MkwComputePreemptState {
+    bool schedulerThread;
+    uint32_t hold;
+    bool sharedContext;  // TryGetCpuContext() == &GetPersistentCpuContext()
+    bool interruptsEnabled;
+    uint32_t schedulerDisableCount;
+    bool inRetrace;
+    bool gxMidCommand;
+    uint32_t runningThread;  // OSRunningThread (0: idle)
+    uint32_t currentContext; // OSCurrentContext
+    uint16_t runningState;   // its OSThread state (2: RUNNING)
+};
+inline MkwComputePreemptVerdict MkwComputePreemptDecide(const MkwComputePreemptState& s) noexcept {
+    if (!s.schedulerThread) return MkwComputePreemptVerdict::NotSchedulerThread;
+    if (s.hold != 0) return MkwComputePreemptVerdict::Held;
+    if (!s.sharedContext) return MkwComputePreemptVerdict::PrivateContext;
+    if (!s.interruptsEnabled) return MkwComputePreemptVerdict::InterruptsOff;
+    if (s.schedulerDisableCount != 0) return MkwComputePreemptVerdict::SchedulerDisabled;
+    if (s.inRetrace) return MkwComputePreemptVerdict::InRetrace;
+    if (s.gxMidCommand) return MkwComputePreemptVerdict::GxMidCommand;
+    if (s.runningThread == 0 || s.currentContext != s.runningThread || s.runningState != 2)
+        return MkwComputePreemptVerdict::NotRunningThread;
+    return MkwComputePreemptVerdict::Take;
+}
+#endif
