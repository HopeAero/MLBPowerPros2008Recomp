diff --git a/runtime/src/platform/switch/switch_mbedtls.cpp b/runtime/src/platform/switch/switch_mbedtls.cpp
new file mode 100644
index 0000000..d37b613
--- /dev/null
+++ b/runtime/src/platform/switch/switch_mbedtls.cpp
@@ -0,0 +1,21 @@
+// mbed TLS's platform hooks on Horizon (include/mbedtls_switch_config.h): entropy from libnx's CSRNG,
+// milliseconds from the monotonic clock.
+#if defined(__SWITCH__)
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+
+extern "C" void randomGet(void* buf, size_t len);  // libnx
+
+extern "C" int mbedtls_hardware_poll(void*, unsigned char* output, size_t length, size_t* written) {
+    randomGet(output, length);
+    *written = length;
+    return 0;
+}
+
+extern "C" int64_t mbedtls_ms_time(void) {  // mbedtls_ms_time_t
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return int64_t{now.tv_sec} * 1000 + now.tv_nsec / 1000000;
+}
+#endif
diff --git a/runtime/src/platform/switch/switch_stdio.cpp b/runtime/src/platform/switch/switch_stdio.cpp
new file mode 100644
index 0000000..4eab794
--- /dev/null
+++ b/runtime/src/platform/switch/switch_stdio.cpp
@@ -0,0 +1,11 @@
+// Standard output on Horizon (main.cpp's process transcript): over the network to nxlink's console on
+// the PC when nxlink started the game (nxlink -s), else nowhere but the log file.
+#if defined(__SWITCH__)
+#include <arpa/inet.h>  // nxlink.h uses struct in_addr without it
+#include <switch.h>
+
+extern "C" bool SwitchStdioToNxlink() {
+    if (__nxlink_host.s_addr == 0 || R_FAILED(socketInitializeDefault())) return false;
+    return nxlinkStdio() >= 0;
+}
+#endif
