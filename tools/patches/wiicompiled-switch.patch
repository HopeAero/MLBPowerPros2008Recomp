+    m_devPulls.fetch_add(1, std::memory_order_relaxed);
+    if (additional > 8) {
+        m_devUnderruns.fetch_add(1, std::memory_order_relaxed);
+        m_devShortBytes.fetch_add(static_cast<uint64_t>(additional), std::memory_order_relaxed);
+    }
+    AudioBackendAtomicMin(m_devMinAtPull, std::max(total - additional, 0));
