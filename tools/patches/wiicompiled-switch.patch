+        const bool oldAxLayout = m_splitOldLayout;
+        const bool wasWorker = t_onMixWorker;
+        t_onMixWorker = true;  // the worker's fail-safe guest accessors, same results
+        uint32_t claimed = 0;
+        try {
+            const AXBuffers buffers = HelperBuffers();
+            for (;;) {
+                const uint32_t i = m_splitNext.fetch_add(1, std::memory_order_relaxed);
+                if (i >= count) {
+                    break;
+                }
+                if (claimed++ == 0) {
+                    for (auto& bus : m_splitBus) bus.fill(0);
+                    for (auto& bus : m_splitWmBus) bus.fill(0);
