+} // namespace aurora::gx::fifo
+
+// ---- C API (runtime) -------------------------------------------------------------------------------
+
+// Native code is about to write guest memory the GX may read (0), or VIConfigure (1).
+extern "C" void aurora_gx_fifo_quiesce(uint32_t reason) {
+  using namespace aurora::gx::fifo;
+  quiesce(reason == 1 ? QuiesceReason::VIConfigure : QuiesceReason::NativeWrite);
+}
+
+extern "C" int aurora_gx_fifo_async(void) { return aurora::gx::fifo::async_mode() ? 1 : 0; }
+
+// Completed end-of-frame drains: memory a display list pointed at may be reused after it changes.
+extern "C" uint64_t aurora_gx_fifo_frame_epoch(void) { return aurora::gx::fifo::sFrameEpoch; }
+
+extern "C" void aurora_gx_fifo_stats_mark(void) { aurora::gx::fifo::sMark = aurora::gx::fifo::take_snapshot(); }
+
+// Per-frame averages since aurora_gx_fifo_stats_mark, one "key=value" line per group.
+extern "C" int aurora_gx_fifo_stats_report(char* out, int size) {
+  using namespace aurora::gx::fifo;
+  if (out == nullptr || size <= 0) {
+    return 0;
+  }
+  const Snapshot now = take_snapshot();
+  const Snapshot& base = sMark;
+  const auto delta = [&](uint64_t a, uint64_t b) { return static_cast<double>(a - b); };
+  const auto drains = [&](DrainReason r) {
+    const auto i = static_cast<size_t>(r);
+    return delta(now.drains[i], base.drains[i]);
+  };
+  const auto quiesces = [&](QuiesceReason r) {
+    const auto i = static_cast<size_t>(r);
+    return delta(now.quiesces[i], base.quiesces[i]);
+  };
+  const double frames = std::max(1.0, drains(DrainReason::EndFrame));
+  const char* modeName = mode() == Mode::Thread ? "thread" : (mode() == Mode::Deferred ? "deferred" : "sync");
+  const int n = std::snprintf(
+      out, static_cast<size_t>(size),
+      "gx_fifo_mode=%s gx_fifo_frames=%.0f exact_raw=%d check_arrays=%d\n"
+      "gx_fifo_drains_per_frame draw=%.1f display_list=%.1f raw_draw=%.1f draw_done=%.2f copy=%.2f "
+      "end_frame=%.2f efb_flush=%.2f offscreen=%.2f render_area=%.2f viewport_policy=%.2f other=%.2f\n"
+      "gx_fifo_quiesce_per_frame decoder_read=%.2f copy_filter=%.2f native_write=%.2f vi=%.2f room=%.2f\n"
+      "gx_fifo_segments_per_frame=%.1f gx_fifo_bytes_per_frame_kib=%.1f\n"
+      "gx_fifo_decode_ms_per_frame=%.3f gx_fifo_producer_wait_ms_per_frame=%.3f%s\n"
+      "gx_fifo_raw_draw_mismatches=%.0f gx_fifo_staging_splits drain=%.0f display_list=%.0f "
+      "gx_fifo_array_hazards=%.0f gx_fifo_decode_errors=%.0f\n",
+      modeName, frames, sExactRawDraws ? 1 : 0, sCheckArrays ? 1 : 0, drains(DrainReason::Draw) / frames,
+      drains(DrainReason::DisplayList) / frames, drains(DrainReason::RawDraw) / frames,
+      drains(DrainReason::DrawDone) / frames, drains(DrainReason::Copy) / frames,
+      drains(DrainReason::EndFrame) / frames, drains(DrainReason::EfbFlush) / frames,
+      drains(DrainReason::Offscreen) / frames, drains(DrainReason::RenderArea) / frames,
+      drains(DrainReason::ViewportPolicy) / frames, drains(DrainReason::Other) / frames,
+      quiesces(QuiesceReason::DecoderRead) / frames, quiesces(QuiesceReason::CopyFilter) / frames,
+      quiesces(QuiesceReason::NativeWrite) / frames, quiesces(QuiesceReason::VIConfigure) / frames,
+      quiesces(QuiesceReason::Room) / frames, delta(now.segments, base.segments) / frames,
+      delta(now.bytes, base.bytes) / frames / 1024.0, delta(now.decodeNs, base.decodeNs) / frames / 1e6,
+      delta(now.waitNs, base.waitNs) / frames / 1e6, mode() == Mode::Sync ? " (sync: decode time not measured)" : "",
+      delta(now.rawMismatches, base.rawMismatches), delta(now.drainSplits, base.drainSplits),
+      delta(now.listSplits, base.listSplits), delta(now.arrayHazards, base.arrayHazards),
+      delta(now.decodeErrors, base.decodeErrors));
+  return n < 0 ? 0 : std::min(n, size - 1);
+}
