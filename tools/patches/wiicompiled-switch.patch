+// MLB Power Pros 2008 (RL8E54): a native 0x8000D770, the CPU sphere-map pass, the hottest game
+// function of a match on the Switch main thread (run 5 profile: 4.1% self plus ~0.8% in the sqrt
+// native it calls once per vertex).
+//
+// void EnvMapCoords(Model* m) (only caller 0x8000CD0C): for every vertex of every mesh of
+// m->shape (m+0x18) it computes a sphere-map texture coordinate pair. Per vertex: p = M * pos
+// (PSMTXMultVec), n = R * nrm (PSMTXMultVec with the translation column zeroed, or PSMTXMultVecSR
+// on the same skinning matrix), p normalized (PSVECNormalize 0x800635B4: frsqrte and one
+// Newton-Raphson step), r = p - 2 (p.n) n, r.z += 1, s = 0.5 / sqrt(r.r) (sqrt at 0x80128FD0, a
+// zero root replaced by 1e-7), u = su (0.5 - r.x s), v = sv (0.5 - r.y s), two floats stored per
+// vertex in the mesh's current UV buffer (the descriptor flips buffers on every call through
+// 0x80058B98). M is the view-model matrix (PSMTXConcat of the camera matrix with the model's);
+// skinned models (byte gfx+0x2030 set) take one matrix per vertex from the palette at gfx+0x2034
+// indexed by a byte stream. docs/en/reverse-engineering.md section 10 has the layout.
+//
+// The translation spends this on the scalar-single emulation of every operation (each fmuls
+// rounds its second operand to 25 bits, each result goes through a double), on the stack round
+// trips of the inlined leaves (12 psq loads, 8 psq stores, 6 lfs and 3 stfs per vertex) and on
+// the full register sync around the sqrt call. Here a vertex is the same arithmetic in host
+// single precision, on the facts below, the stack scratch and the sqrt native's frame are
+// written once (only the last vertex's values are observable) and the root is computed inline.
+//
+// Why host singles give the translation's bits (round to nearest; FPCR.FZ on or off, as it is):
+// every operand of every single op here is a single (lfs/psq loads and earlier single results),
+// so PpcForce25BitInline(c) is the identity, a*c is exact in a double, and rounding a double sum,
+// quotient or square root of singles to single equals the correctly rounded single result
+// (53 >= 2*24 + 2). FCVT and the single op flush tiny results the same way under FZ (ARMv8
+// FPRound), and FZ flushes subnormal inputs in both. ps_madd is the same fused fmla per lane.
+// psq_st (both widths) turns a subnormal into its signed zero: kept explicitly. The normalize
+// step's frsqrte, its three fmuls and the fnmsubs use the translation's own helpers (frsqrte's
+// estimate is not a single). NaN results are where the two could part (the translation resolves
+// ps lanes x86-style, and which of two NaN operands a plain double op returns depends on the
+// operand order its compiler picked), so a NaN never reaches the fast path's output: see below.
+//
+// Rollback: everything this function writes before and during the vertex loops is undoable
+// (the stack between sp-64 and r1+8 is snapshotted at entry, the UV words and the buffer flip
+// go through an undo log), and no guest code runs before the loops end. When any vertex or mesh
+// falls outside the fast path, every write is undone, the context restored, and the translation
+// (kept by REGISTER_NATIVE_FUNCTION_AS) runs the whole call: bit for bit what it would have
+// done. Outside the fast path: a vertex with a NaN anywhere (it reaches u or v) or with r.r
+// zero, infinite or NaN (the sqrt native's special paths, errno), a mesh whose arrays wrap,
+// touch the MMIO window, overlap the stack area the loop writes or caches ([sp-32, sp+0x100))
+// or whose UV buffer overlaps the small-data constants ([r2-0x8000, r2)), a descriptor, index
+// or palette read in the MMIO window or that stack area, an undo log overflow, GQR0 != 0 and
+// the checked access mode.
+//
+// Kept exactly on the fast path (cross-checked with the translation in qemu-aarch64, see the
+// snippet header): every guest store (frame, saved registers, the 3x4 copies, the descriptor
+// flip, the UV pairs, the stack scratch, the sqrt native's frame below sp), the registers each
+// callee sees (0x80059350 saves r27-r31 and LR into its frame: r21-r31 track the original,
+// ctx->lr is 0x8000DC08 there as the translation sets it), r1, r2, r13, r14-r31, f14-f31, LR,
+// CR2-CR4 and GQRs at return. The volatile registers (r0, r3-r12, f0-f13, CR0/1/5-7, XER, CTR)
+// are left as the EABI allows: the translation itself leaves different values there depending
+// on whether its callees run state-free, and the only caller reloads none of them.
+//
+// This file builds like the translated code (-O2 -fno-fast-math -ffp-contract=off, outside the
+// unity build: runtime/CMakeLists.txt): a contracted multiply-add or a reassociated sum would
+// change bits, and -ffinite-math-only would fold the NaN tests away.
+#if defined(__SWITCH__)
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+#include "abi_bridge.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+
+extern "C" void func_8000D770(CpuContext* ctx);              // the translation (kept: _AS registration)
+extern "C" void MLB_PSMTXConcat_800A890C(CpuContext* ctx);   // hle/mlb/mtx_natives.cpp
+
+namespace mlb_envmap {
+
+// ---- guest memory, flat view (callers have proven the range plain) ----
+
+inline uint8_t* Host(uint32_t address) { return MKW_FLAT_GUEST_BASE + address; }
+
+inline uint32_t Bits(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof bits);
+    return bits;
+}
+
+inline float Float(uint32_t bits) {
+    float value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+inline uint32_t Load32(uint32_t address) {
+    uint32_t raw;
+    std::memcpy(&raw, Host(address), sizeof raw);
+    return __builtin_bswap32(raw);
+}
+
+inline float LoadF(uint32_t address) { return Float(Load32(address)); }
+
+inline void Store32(uint32_t address, uint32_t value) {
+    const uint32_t raw = __builtin_bswap32(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
+}
+
+inline void Store64(uint32_t address, uint64_t value) {
+    const uint64_t raw = __builtin_bswap64(value);
+    std::memcpy(Host(address), &raw, sizeof raw);
+}
+
+// psq_st's single narrowing of a non-NaN lane: a subnormal or zero keeps only its sign.
+inline float PsqStored(float value) {
+    const uint32_t bits = Bits(value);
+    return (bits & 0x7FFFFFFFu) < 0x00800000u ? Float(bits & 0x80000000u) : value;
+}
+
+// One instruction each, so nothing can be fused, reassociated or widened.
+inline float Mul(float a, float b) { float r; __asm__("fmul %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+inline float Add(float a, float b) { float r; __asm__("fadd %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+inline float Sub(float a, float b) { float r; __asm__("fsub %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+inline float Div(float a, float b) { float r; __asm__("fdiv %s0, %s1, %s2" : "=w"(r) : "w"(a), "w"(b)); return r; }
+inline float Fma(float a, float c, float b) {  // a * c + b, one rounding (ps_madd's lane)
+    float r;
+    __asm__("fmadd %s0, %s1, %s2, %s3" : "=w"(r) : "w"(a), "w"(c), "w"(b));
+    return r;
+}
+inline float SqrtS(float a) { float r; __asm__("fsqrt %s0, %s1" : "=w"(r) : "w"(a)); return r; }
+inline double SqrtD(double a) { double r; __asm__("fsqrt %d0, %d1" : "=w"(r) : "w"(a)); return r; }
+inline double Widen(float a) { double r; __asm__("fcvt %d0, %s1" : "=w"(r) : "w"(a)); return r; }
+
+// ---- ranges ----
+
+constexpr uint32_t kStackBelow = 32u;    // the sqrt native's frame under sp
+constexpr uint32_t kStackAbove = 0x100u; // scratch, matrices and the palette pointer up to sp+0xFC
+
+// [address, address + length) neither wraps nor touches 0xCC000000-0xCDFFFFFF.
+inline bool Plain(uint32_t address, uint64_t length) {
+    const uint64_t end = static_cast<uint64_t>(address) + length;
+    return end <= 0x100000000ull && (end <= 0xCC000000ull || address >= 0xCE000000u);
+}
+
+inline bool Disjoint(uint64_t a, uint64_t aLength, uint64_t b, uint64_t bLength) {
+    return a + aLength <= b || b + bLength <= a;
+}
+
+// ---- rollback ----
+
+// The UV words and the buffer flip, with the values they replaced. Guest code runs on the main
+// thread only and no guest call happens while the log is live, so one log serves every call.
+struct UndoLog {
+    static constexpr uint32_t kCapacity = 16384;
+    uint32_t address[kCapacity];
+    uint32_t old[kCapacity];
+    uint32_t count;
+};
+UndoLog g_undo;
+
+[[gnu::always_inline]] inline void LoggedStore32(uint32_t address, uint32_t value) {
+    g_undo.address[g_undo.count] = address;
+    g_undo.old[g_undo.count] = Load32(address);
+    ++g_undo.count;
+    Store32(address, value);
+}
+
+struct Call {
+    CpuContext* ctx;
+    uint32_t sp, r2;
+    uint64_t stackGuard;  // sp - 32
+    uint64_t sdataGuard;  // r2 - 0x8000
+};
+
+// A read or write the loops make: plain RAM outside the stack area they write or cache.
+inline bool Clear(const Call& c, uint32_t address, uint64_t length) {
+    return Plain(address, length) && Disjoint(address, length, c.stackGuard, kStackBelow + kStackAbove);
+}
+
+// ---- the loop's constants and stack inputs ----
+
+struct Consts {
+    float two, one, zero, half, su, sv;  // registers set up before the mesh loop
+    float nz, nh, n3, alt;              // loaded per vertex by the translation (normalize, zero root)
+};
+
+struct Scratch {  // the last vertex's stack values, written once after the loops
+    float p[3], n[3], r[3];
+    float sum;
+    bool pending;
+};
+
+struct Layout {   // stack offsets of one of the two loops
+    uint32_t p, n, r;
+};
+
+// ---- one vertex in host singles ----
+
+struct Vec { float x, y, z; };
+
+// PSMTXMultVec, each row: (m0 x + m2 z) + (m1 y + m3) with ps_mul, ps_madd and ps_sum0, stored by psq_st.
+inline float Row(const float* m, float x, float y, float z) {
+    return PsqStored(Add(Fma(m[2], z, Mul(m[0], x)), Fma(m[3], 1.0f, Mul(m[1], y))));
+}
+
+inline Vec MultVec(const float* m, const Vec& v) {
+    return {Row(m, v.x, v.y, v.z), Row(m + 4, v.x, v.y, v.z), Row(m + 8, v.x, v.y, v.z)};
+}
+
+// PSMTXMultVecSR, each row: (m0 x + m1 y) + m2 z with ps_mul, ps_sum0 and ps_madd.
+inline float RowSR(const float* m, float x, float y, float z) {
+    return PsqStored(Fma(m[2], z, Add(Mul(m[0], x), Mul(m[1], y))));
+}
+
+inline Vec MultVecSR(const float* m, const Vec& v) {
+    return {RowSR(m, v.x, v.y, v.z), RowSR(m + 4, v.x, v.y, v.z), RowSR(m + 8, v.x, v.y, v.z)};
+}
+
+// PSVECNormalize in place (0x800635B4): s = (z z + x x) + y y; unchanged when s equals its zero
+// constant; else k from frsqrte and one Newton step (the translation's helpers), p *= k.
+inline Vec Normalize(const Vec& p, const Consts& k) {
+    const float s = Add(Fma(p.z, p.z, Mul(p.x, p.x)), Mul(p.y, p.y));
+    if (Widen(s) == Widen(k.nz)) return p;
+    const double sd = Widen(s);
+    const double e = PPC_Frsqrte(sd);
+    double f6 = PpcFmulsInline(e, e);
+    const double f0 = PpcFmulsInline(e, Widen(k.nh));
+    f6 = PPC_Fnmsubs(f6, sd, Widen(k.n3));
+    const float scale = static_cast<float>(PpcFmulsInline(f6, f0));
+    return {PsqStored(Mul(p.x, scale)), PsqStored(Mul(p.y, scale)), PsqStored(Mul(p.z, scale))};
+}
+
+inline Vec LoadVec(uint32_t address) { return {LoadF(address), LoadF(address + 4u), LoadF(address + 8u)}; }
+
+inline void LoadMatrix(uint32_t address, float* m) {
+    for (int i = 0; i < 12; ++i) m[i] = LoadF(address + 4u * static_cast<uint32_t>(i));
+}
+
+// One vertex; false (nothing stored) when it is not for the fast path.
+template <bool Skinned>
+[[gnu::always_inline]] inline bool Vertex(const float* m, const float* rot, uint32_t pos, uint32_t nrm,
+                                          uint32_t out, const Consts& k, Scratch& s) {
+    const Vec p = Normalize(MultVec(m, LoadVec(pos)), k);
+    const Vec n = Skinned ? MultVecSR(m, LoadVec(nrm)) : MultVec(rot, LoadVec(nrm));
+    const float t = Mul(k.two, Add(Mul(p.z, n.z), Add(Mul(p.x, n.x), Mul(p.y, n.y))));
+    const float rx = Sub(p.x, Mul(n.x, t));
+    const float ry = Sub(p.y, Mul(n.y, t));
+    const float rz = Add(k.one, Sub(p.z, Mul(n.z, t)));
+    const float sum = Add(Mul(rz, rz), Add(Mul(rx, rx), Mul(ry, ry)));
+    if (!(sum > 0.0f) || !(sum < INFINITY)) [[unlikely]] return false;
+    float root = SqrtS(sum);
+    if (Widen(k.zero) == Widen(root)) root = k.alt;
+    const float scale = Div(k.half, root);
+    const float u = Mul(k.su, Sub(k.half, Mul(rx, scale)));
+    const float v = Mul(k.sv, Sub(k.half, Mul(ry, scale)));
+    if (std::isnan(u) || std::isnan(v)) [[unlikely]] return false;
+    LoggedStore32(out, Bits(u));
+    LoggedStore32(out + 4u, Bits(v));
+    s.p[0] = p.x; s.p[1] = p.y; s.p[2] = p.z;
+    s.n[0] = n.x; s.n[1] = n.y; s.n[2] = n.z;
+    s.r[0] = rx; s.r[1] = ry; s.r[2] = rz;
+    s.sum = sum;
+    s.pending = true;
+    return true;
+}
+
+// The stack as the last vertex left it, the sqrt native's frame included.
+inline void Flush(uint32_t sp, const Layout& l, Scratch& s) {
+    if (!s.pending) return;
+    for (uint32_t i = 0; i < 3; ++i) {
+        Store32(sp + l.p + 4u * i, Bits(s.p[i]));
+        Store32(sp + l.n + 4u * i, Bits(s.n[i]));
+        Store32(sp + l.r + 4u * i, Bits(s.r[i]));
+    }
+    const double x = Widen(s.sum);
+    const double root = SqrtD(x);
+    uint64_t xBits, rootBits;
+    std::memcpy(&xBits, &x, sizeof xBits);
+    std::memcpy(&rootBits, &root, sizeof rootBits);
+    Store32(sp - 32u, sp);
+    Store64(sp - 24u, xBits);
+    Store32(sp - 16u, static_cast<uint32_t>(rootBits >> 32));
+    Store32(sp - 12u, static_cast<uint32_t>(rootBits));
+    s.pending = false;
+}
+
+// A mesh's arrays: plain, clear of the stack area, the UV buffer clear of the constants, and
+// room in the log for its UV words.
+inline bool MeshFits(const Call& c, uint32_t pos, uint32_t nrm, uint32_t out, uint64_t vertices) {
+    return 2u * vertices <= UndoLog::kCapacity - g_undo.count && Clear(c, pos, 12u * vertices) &&
+           Clear(c, nrm, 12u * vertices) && Clear(c, out, 8u * vertices) &&
+           Disjoint(out, 8u * vertices, c.sdataGuard, 0x8000u);
+}
+
+// ---- the shape descriptor accessors (leaves 0x80059278-0x80059314, inlined); false = rollback ----
+
+struct Mesh { uint32_t pos, nrm, uv, vertices; };
+
+inline bool ReadMesh(const Call& c, uint32_t shape, uint32_t index, Mesh& mesh) {
+    if (!Clear(c, shape + 0x18u, 16u)) return false;
+    const uint32_t buffer = Load32(shape + 0x18u);
+    const uint32_t meshes = Load32(shape + 0x24u);
+    const uint32_t entry = Load32(shape + 0x20u) + (index + buffer * meshes) * 0x1Cu;  // mullw, add, mulli
+    if (!Clear(c, entry, 0x1Cu)) return false;
+    mesh.pos = Load32(entry + 8u);                                                     // 0x800592CC
+    mesh.nrm = Load32(entry + 12u);                                                    // 0x800592F0
+    if (((*Host(entry + 0x18u) >> 3) & 1u) != 0) {                                     // 0x80059290
+        const uint32_t holder = Load32(entry);
+        if (!Clear(c, holder + 0x18u, 4u)) return false;
+        mesh.uv = Load32(holder + 0x18u);
+    } else {
+        mesh.uv = 0;
+    }
+    mesh.vertices = static_cast<uint32_t>((static_cast<uint64_t>(mesh.nrm - mesh.pos) * 0xAAAAAAABull) >> 32) >> 3;
+    return true;                                                                       // 0x80059314
+}
+
+// Undo every write since entry and run the translation from the entry state.
+[[gnu::noinline, gnu::cold]] void Rollback(CpuContext* ctx, const CpuContext& entry, uint32_t stackLow,
+                                           const uint8_t* stack, uint32_t stackLength) {
+    while (g_undo.count != 0) {
+        --g_undo.count;
+        Store32(g_undo.address[g_undo.count], g_undo.old[g_undo.count]);
+    }
+    std::memcpy(Host(stackLow), stack, stackLength);
+    *ctx = entry;
+    func_8000D770(ctx);
+}
+
+}  // namespace mlb_envmap
+
+extern "C" void MLB_EnvMapCoords_8000D770(CpuContext* ctx) {
