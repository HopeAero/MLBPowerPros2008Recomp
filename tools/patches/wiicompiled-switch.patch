diff --git a/aurora-main/lib/gx/fifo_async.inc b/aurora-main/lib/gx/fifo_async.inc
new file mode 100644
index 0000000..8db0e1b
--- /dev/null
+++ b/aurora-main/lib/gx/fifo_async.inc
@@ -0,0 +1,1187 @@
+// GX FIFO processing modes, WIICOMPILED_GX_FIFO=sync|deferred|thread (switch phase 22). Included
+// at the end of fifo.cpp.
+//
+//  sync      (default) every caller behaves as before: the producer decodes its FIFO inline each
+//            time it drains (each draw, display list, raw draw and sync point).
+//  deferred  the producer queues what it would have decoded as segments and decodes them itself,
+//            on the same thread, only at a sync point. A correctness test of the reordering.
+//  thread    a worker thread decodes the segments while the game keeps running.
+//
+// What makes deferred and thread decode exactly what sync decodes:
+//  * MAIN segments are the FIFO bytes written since the last point where sync drained, published
+//    at that same point (publish_draw, call_display_list, raw draws, drains).
+//  * Work sync did directly on the decoder state at the call (GXApplyBPReg, the copy setters,
+//    GXSetSourceVtxDesc, TLUT replacement metadata, comparisons with the decoder's vertex state) is
+//    queued as records in a side buffer that goes in front of the unpublished FIFO tail: the
+//    decoder applies it after everything sync had decoded and before what sync still held unread.
+//  * Where sync decided from the decoder's vertex state whether to re-send the VCD/VAT, those
+//    comparisons are records ("probes") and the flush is a GX_LOAD_AURORA subcommand in the FIFO
+//    bytes that sends what the probes found sync would have sent.
+//  * A producer read of decoder state (bounding box, PeekZ fallback, ...) waits until every queued
+//    segment is decoded (quiesce): that is the state sync read there.
+//  * Full sync points (copies, DrawDone, end of frame, ...) publish everything and wait (drain).
+//  * Copies, not pointers: display lists and raw draws are copied when submitted.
+// Guest memory the decoder reads through pointers (textures, TLUTs, vertex and matrix arrays) is
+// read when decoded, as the real GPU does; WIICOMPILED_GX_FIFO_CHECK=1 counts display lists whose
+// arrays the guest wrote between submit and decode.
+
+#include "gx.hpp"
+
+#include <atomic>
+#include <bit>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <mutex>
+#include <thread>
+
+#if defined(__SWITCH__)
+extern "C" void SwitchPinCurrentThread(int core, int priority); // runtime platform/switch
+extern "C" void SwitchProfilerRegisterGxThread();
+#endif
+
+namespace aurora::gx::fifo {
+// command_processor.cpp: the decoder half of submit_raw_draw.
+void execute_raw_draw(uint8_t prim, uint8_t fmt, const uint8_t* vertices, uint16_t vtxCount, uint32_t vertexBytes,
+                      bool accepted);
+
+namespace detail {
+Mode sMode = Mode::Sync;
+bool sModeResolved = false;
+uint32_t sVirtualBase = 0;
+#if defined(__SWITCH__)
+bool sA3 = true;
+bool sG6 = true;
+#endif
+
+Mode resolve_mode() noexcept {
+#if defined(__SWITCH__)
+  {
+    const char* a3 = std::getenv("WIICOMPILED_GX_A3");
+    sA3 = !(a3 != nullptr && a3[0] == '0');
+  }
+#endif
+#if defined(__SWITCH__)
+  {
+    const char* g6 = std::getenv("WIICOMPILED_GX_G6");
+    sG6 = !(g6 != nullptr && g6[0] == '0');
+  }
+#endif
+  const char* env = std::getenv("WIICOMPILED_GX_FIFO");
+#if defined(__SWITCH__)
+  // Measured on the console: same frames, 43.8 -> 58 fps in the match benchmark.
+  Mode mode = Mode::Thread;
+  if (env != nullptr && std::strcmp(env, "sync") == 0) {
+    mode = Mode::Sync;
+  } else if (env != nullptr && std::strcmp(env, "deferred") == 0) {
+#else
+  Mode mode = Mode::Sync;
+  if (env != nullptr && std::strcmp(env, "deferred") == 0) {
+#endif
+    mode = Mode::Deferred;
+  } else if (env != nullptr && std::strcmp(env, "thread") == 0) {
+    mode = Mode::Thread;
+  }
+  sMode = mode;
+  sModeResolved = true;
+  if (mode != Mode::Sync) {
+    Log.info("GX FIFO: {} processing (WIICOMPILED_GX_FIFO)", mode == Mode::Thread ? "thread" : "deferred");
+  }
+  return mode;
+}
+} // namespace detail
+
+namespace {
+using Clock = std::chrono::steady_clock;
+
+uint64_t nanos_since(Clock::time_point start) noexcept {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count());
+}
+
+inline void cpu_relax() noexcept {
+#if defined(__aarch64__)
+  asm volatile("yield" ::: "memory");
+#elif defined(__x86_64__) || defined(__i386__)
+  __builtin_ia32_pause();
+#else
+  std::this_thread::yield();
+#endif
+}
+
+// Producer-side counters are plain (one thread); the decoder's are atomic.
+struct Stats {
+  uint64_t drains[static_cast<size_t>(DrainReason::Count)]{};
+  uint64_t quiesces[static_cast<size_t>(QuiesceReason::Count)]{};
+  uint64_t segments = 0;
+  uint64_t bytes = 0;
+  uint64_t waitNs = 0;
+  uint64_t copiesQueued = 0; // EFB copies decoded in stream order (no producer wait)
+  uint64_t copiesInline = 0; // EFB copies the producer ran itself after a drain
+  std::atomic<uint64_t> decodeNs{0};
+  std::atomic<uint64_t> rawMismatches{0};
+  std::atomic<uint64_t> drainSplits{0};
+  std::atomic<uint64_t> listSplits{0};
+  std::atomic<uint64_t> arrayHazards{0};
+  std::atomic<uint64_t> decodeErrors{0};
+};
+Stats sStats;
+
+struct Snapshot {
+  uint64_t drains[static_cast<size_t>(DrainReason::Count)]{};
+  uint64_t quiesces[static_cast<size_t>(QuiesceReason::Count)]{};
+  uint64_t segments = 0, bytes = 0, waitNs = 0, decodeNs = 0, rawMismatches = 0, drainSplits = 0, listSplits = 0,
+           arrayHazards = 0, decodeErrors = 0, copiesQueued = 0, copiesInline = 0;
+#if defined(__SWITCH__)
+  uint64_t a3[kA3CounterCount]{};
+  uint64_t g6[kG6CounterCount]{};
+  uint64_t g7[kG7CounterCount]{};
+  uint64_t p19[16]{};
+#endif
+};
+#if defined(__SWITCH__)
+extern "C" uint64_t aurora_gx_p19_counters[16];
+extern "C" int aurora_gx_p19_enabled(void);
+#endif
+Snapshot sMark;
+
+Snapshot take_snapshot() noexcept {
+  Snapshot s;
+  std::memcpy(s.drains, sStats.drains, sizeof(s.drains));
+  std::memcpy(s.quiesces, sStats.quiesces, sizeof(s.quiesces));
+  s.segments = sStats.segments;
+  s.bytes = sStats.bytes;
+  s.waitNs = sStats.waitNs;
+  s.decodeNs = sStats.decodeNs.load(std::memory_order_relaxed);
+  s.rawMismatches = sStats.rawMismatches.load(std::memory_order_relaxed);
+  s.drainSplits = sStats.drainSplits.load(std::memory_order_relaxed);
+  s.listSplits = sStats.listSplits.load(std::memory_order_relaxed);
+  s.arrayHazards = sStats.arrayHazards.load(std::memory_order_relaxed);
+  s.decodeErrors = sStats.decodeErrors.load(std::memory_order_relaxed);
+  s.copiesQueued = sStats.copiesQueued;
+  s.copiesInline = sStats.copiesInline;
+#if defined(__SWITCH__)
+  std::memcpy(s.a3, aurora_gx_a3_counters, sizeof(s.a3));
+  std::memcpy(s.g6, aurora_gx_g6_counters, sizeof(s.g6));
+  std::memcpy(s.g7, aurora_gx_g7_counters, sizeof(s.g7));
+  std::memcpy(s.p19, aurora_gx_p19_counters, sizeof(s.p19));
+#endif
+  return s;
+}
+
+void note_drain(DrainReason reason) noexcept { ++sStats.drains[static_cast<size_t>(reason)]; }
+
+// Sync mode: one process() run over `bytes` (the counterpart of a queued segment).
+void note_decode(uint32_t bytes) noexcept {
+  ++sStats.segments;
+  sStats.bytes += bytes;
+}
+
+void note_split(bool displayList) noexcept {
+  (displayList ? sStats.listSplits : sStats.drainSplits).fetch_add(1, std::memory_order_relaxed);
+}
+
+// ---- Queue ---------------------------------------------------------------------------------------
+
+enum : uint8_t { kSegMain = 0, kSegSide = 1 };
+struct Segment {
+  uint32_t begin = 0;
+  uint32_t end = 0;
+  uint8_t source = kSegMain;
+};
+constexpr uint64_t kRingSize = 1u << 14;
+
+// Side-buffer records: an 8-byte header, then the payload padded to 8 bytes.
+enum : uint8_t { kRecStream = 1, kRecRawDraw, kRecCall, kRecProbeVcd, kRecProbeVat, kRecStreamRef };
+// kRecStreamRef payload (call_display_list_ref): the stream's host address and length.
+struct StreamRefArgs {
+  uint64_t data;
+  uint32_t length;
+  uint32_t pad;
+};
+static_assert(sizeof(StreamRefArgs) == 16);
+constexpr uint8_t kRecBigEndian = 1u << 0; // stream: big-endian bytes
+constexpr uint8_t kRecSealed = 1u << 1;    // sync drained (and so waited for SEALED) before this work
+constexpr uint8_t kRecList = 1u << 2;      // stream: a display list
+constexpr uint8_t kRecArrayCheck = 1u << 3; // stream: starts with the producer's array fingerprint
+struct RecordHeader {
+  uint8_t type;
+  uint8_t flags;
+  uint16_t aux; // probes: the conditional vertex flush they belong to
+  uint32_t length;
+};
+static_assert(sizeof(RecordHeader) == 8);
+constexpr uint32_t align8(uint32_t v) noexcept { return (v + 7u) & ~7u; }
+
+struct RawDrawArgs {
+  uint8_t prim;
+  uint8_t fmt;
+  uint8_t accepted;
+  uint8_t pad0;
+  uint16_t vtxCount;
+  uint16_t pad1;
+  uint32_t vertexBytes;
+  uint32_t pad2;
+};
+static_assert(sizeof(RawDrawArgs) == 16);
+
+// The payload of the in-stream kAuroraVtxCondSubCmd (queue_vtx_cond), then the VCD block and one
+// VAT block per candidate format, as __GXSetVCD/__GXSetVAT wrote them.
+struct VtxCondArgs {
+  uint8_t vcdForce;
+  uint8_t vcdProbed;
+  uint8_t vatForce;
+  uint8_t vatProbed;
+  uint16_t id;
+  uint16_t pad;
+  uint32_t vcdBytes;
+};
+static_assert(sizeof(VtxCondArgs) == 12);
+constexpr uint32_t kVatBlockBytes = 18; // __GXSetVAT: three CP writes per format
+
+// Probes of flush `id` are decoded before the flush's block, but probes of the next flush can be
+// decoded before it too (they go in front of the unpublished bytes that hold it), hence per id.
+struct ProbeSlot {
+  uint32_t id = UINT32_MAX;
+  bool vcd = false;
+  uint8_t vat = 0;
+};
+constexpr uint32_t kProbeSlots = 64;
+
+// Shared with the worker; never destroyed, since the worker may still sleep on it at exit.
+// One cache line per writer: `pushed` (producer, read by the spinning worker) and `processed`
+// (worker, after every segment) used to share a line with each other and with the sleep flags, so
+// each producer publish and each kick missed on a line the worker had just written.
+struct Shared {
+  alignas(64) std::atomic<uint64_t> pushed{0};
+  alignas(64) std::atomic<uint64_t> processed{0};
+  alignas(64) std::atomic<bool> workerSleeping{false};
+  alignas(64) std::atomic<uint64_t> mainWaitTarget{0};
+  alignas(64) std::mutex mutex;
+  std::condition_variable workerCv;
+  std::condition_variable mainCv;
+  alignas(64) Segment ring[kRingSize];
+};
+
+constexpr uint32_t kMainCapacity = 8u << 20;
+constexpr uint32_t kSideCapacity = 4u << 20;
+constexpr uint32_t kKickDraws = 16;
+constexpr uint32_t kKickBytes = 32u << 10;
+constexpr auto kWorkerSpin = std::chrono::microseconds(40);
+constexpr auto kMainSpin = std::chrono::microseconds(50);
+
+Shared* sShared = nullptr;
+bool sStarted = false;
+thread_local bool tWorker = false;
+thread_local bool tStreamCall = false; // decoding a stream-ordered call (GXCopyTex/GXCopyDisp)
+// The guest's alarm/retrace/audio pump the frame-worker waits run (aurora_set_frame_worker_wait_callback).
+std::atomic<void (*)()> sWaitService{nullptr};
+
+// Producer state. The decoder reads detail::sBufferData[segment) and sSide[segment) only for
+// pushed segments, and the producer moves or reallocates a buffer only when every pushed segment
+// is decoded.
+uint8_t* sSide = nullptr;
+uint32_t sSideSize = 0;
+uint32_t sSideCapacity = 0;
+uint32_t sSideOpen = 0;             // [sSideOpen, sSideSize): records not in a segment yet
+uint32_t sLastRecord = UINT32_MAX;  // the newest open record, which a like record may extend
+uint32_t sMainPublished = 0;        // detail::sBufferData[0, sMainPublished) is in segments
+uint64_t sPushed = 0;               // segments in the ring; Shared::pushed lags until publish_pushed
+uint64_t sPublished = 0;            // the last value stored to Shared::pushed
+uint64_t sProcessedSeen = 0;        // a Shared::processed value read earlier (never ahead of it)
+uint32_t sKickDraws = 0;
+uint32_t sKickBytes = 0;
+uint32_t sVtxProbes = 0;            // bit 8: VCD probed; bits 0-7: VAT formats probed (since the last flush)
+uint16_t sNextCondId = 0;           // the conditional vertex flush the queued probes belong to
+uint16_t sPublishedCondId = 0;      // sNextCondId when the main buffer was last published
+uint64_t sFrameEpoch = 0;           // completed end-of-frame drains
+bool sExactRawDraws = false;
+bool sCheckArrays = false;
+struct ArrayShadow {
+  const void* data = nullptr;
+  uint32_t size = 0;
+};
+std::array<ArrayShadow, MaxVtxAttr> sArrayShadow{};
+
+// Decoder state (the worker, or the producer itself in deferred mode).
+std::array<ProbeSlot, kProbeSlots> sProbeSlots{};
+
+ProbeSlot& probe_slot(uint16_t id) noexcept {
+  ProbeSlot& slot = sProbeSlots[id % kProbeSlots];
+  if (slot.id != id) {
+    slot = ProbeSlot{id, false, 0};
+  }
+  return slot;
+}
+
+void worker_main() noexcept;
+
+// A frame of FIFO bytes stays queued, so start large enough not to move it mid-frame. Only called
+// with nothing queued.
+void ensure_main_capacity() {
+  if (detail::sBufferCapacity < kMainCapacity) {
+    auto* grown = static_cast<uint8_t*>(realloc(detail::sBufferData, kMainCapacity));
+    ASSERT(grown != nullptr, "GX FIFO: cannot allocate {} bytes", kMainCapacity);
+    detail::sBufferData = grown;
+    detail::sBufferCapacity = kMainCapacity;
+  }
+}
+
+void ensure_started() {
+  if (sStarted) LIKELY {
+    return;
+  }
+  sStarted = true;
+  sShared = new Shared();
+  const char* exact = std::getenv("WIICOMPILED_GX_FIFO_EXACT_RAW");
+  sExactRawDraws = exact != nullptr && exact[0] == '1';
+  const char* check = std::getenv("WIICOMPILED_GX_FIFO_CHECK");
+  sCheckArrays = check != nullptr && check[0] == '1';
+  ensure_main_capacity();
+  sSide = static_cast<uint8_t*>(malloc(kSideCapacity));
+  ASSERT(sSide != nullptr, "GX FIFO: cannot allocate {} bytes", kSideCapacity);
+  sSideCapacity = kSideCapacity;
+  if (mode() == Mode::Thread) {
+    // Lives as long as the process. Not detached: libnx's pthread_detach fails, and
+    // std::thread::detach turns that into std::terminate.
+    static auto* worker = new std::thread(worker_main);
+    (void)worker;
+  }
+}
+
+void wait_sealed() {
+  // SEALED, not DONE, as drain() waits in sync mode.
+  const auto waited = aurora::wait_for_frame_worker_sealed();
+  if (waited.count() > 0) UNLIKELY {
+    note_drain_wait(static_cast<uint64_t>(waited.count()));
+  }
+}
+
+// ---- Decoder ---------------------------------------------------------------------------------------
+
+uint64_t decoder_array_fingerprint() noexcept {
+  uint64_t sum = 0;
+  for (const auto& array : g_gxState.arrays) {
+    if (array.data != nullptr && array.size != 0) {
+      const uint64_t generation = guest_write_generation(array.data, array.size);
+      if (generation != kGuestWriteUntracked) {
+        sum += generation;
+      }
+    }
+  }
+  return sum;
+}
+
+uint64_t producer_array_fingerprint() noexcept {
+  uint64_t sum = 0;
+  for (const auto& array : sArrayShadow) {
+    if (array.data != nullptr && array.size != 0) {
+      const uint64_t generation = guest_write_generation(array.data, array.size);
+      if (generation != kGuestWriteUntracked) {
+        sum += generation;
+      }
+    }
+  }
+  return sum;
+}
+
+void run_vtx_cond(const uint8_t* payload, uint32_t length) {
+  if (length < sizeof(VtxCondArgs)) UNLIKELY {
+    Log.error("GX FIFO: truncated conditional vertex flush ({} bytes)", length);
+    return;
+  }
+  VtxCondArgs args;
+  std::memcpy(&args, payload, sizeof(args));
+  const uint8_t candidates = args.vatForce | args.vatProbed;
+  const uint32_t expected = sizeof(args) + args.vcdBytes + kVatBlockBytes * std::popcount(candidates);
+  const uint8_t* vcd = payload + sizeof(args);
+  const uint8_t* vat = vcd + args.vcdBytes;
+  // GXGeometry.cpp's AuroraVtx*Differs, evaluated by the probes where sync evaluated them.
+  ProbeSlot& slot = probe_slot(args.id);
+  const bool vcdDiff = slot.vcd;
+  const uint8_t vatDiff = slot.vat;
+  // __GXSetDirtyState clears the VCD/VAT dirty state whether or not it sent anything.
+  slot = ProbeSlot{};
+  uint8_t bytes[64 + 8 * kVatBlockBytes];
+  uint32_t size = 0;
+  if (expected != length || args.vcdBytes > 64) UNLIKELY {
+    Log.error("GX FIFO: malformed conditional vertex flush ({} != {}); applying it whole", length, expected);
+    size = std::min<uint32_t>(length - sizeof(args), sizeof(bytes));
+    std::memcpy(bytes, vcd, size);
+  } else {
+    if (args.vcdBytes != 0 && (args.vcdForce != 0 || (args.vcdProbed != 0 && vcdDiff))) {
+      std::memcpy(bytes, vcd, args.vcdBytes);
+      size = args.vcdBytes;
+    }
+    for (uint32_t fmt = 0; fmt < 8; ++fmt) {
+      const uint8_t bit = static_cast<uint8_t>(1u << fmt);
+      if ((candidates & bit) == 0) {
+        continue;
+      }
+      if ((args.vatForce & bit) != 0 || ((args.vatProbed & bit) != 0 && (vatDiff & bit) != 0)) {
+        std::memcpy(bytes + size, vat, kVatBlockBytes);
+        size += kVatBlockBytes;
+      }
+      vat += kVatBlockBytes;
+    }
+  }
+  if (size != 0) {
+    // Plain CP/XF register writes: decoded inside the process() that met the subcommand.
+    process_all(bytes, size, true, false);
+  }
+}
+
+void run_records(const uint8_t* data, uint32_t size) {
+  uint32_t pos = 0;
+  while (pos + sizeof(RecordHeader) <= size) {
+    RecordHeader header;
+    std::memcpy(&header, data + pos, sizeof(header));
+    const uint8_t* payload = data + pos + sizeof(header);
+    pos += sizeof(header) + align8(header.length);
+    if ((header.flags & kRecSealed) != 0) {
+      wait_sealed();
+    }
+    switch (header.type) {
+    case kRecStream: {
+      const uint8_t* bytes = payload;
+      uint32_t length = header.length;
+      if ((header.flags & kRecArrayCheck) != 0) {
+        uint64_t submitted = 0;
+        std::memcpy(&submitted, bytes, sizeof(submitted));
+        bytes += sizeof(submitted);
+        length -= sizeof(submitted);
+        if (decoder_array_fingerprint() != submitted) UNLIKELY {
+          const uint64_t n = sStats.arrayHazards.fetch_add(1, std::memory_order_relaxed);
+          if (n < 16) {
+            Log.warn("GX FIFO: guest RAM behind a vertex/matrix array changed between submit and decode");
+          }
+        }
+      }
+      process_all(bytes, length, (header.flags & kRecBigEndian) != 0, (header.flags & kRecList) != 0);
+      break;
+    }
+    case kRecStreamRef: {
+      // A kRecStream whose bytes stayed where the producer's caller keeps them (call_display_list_ref).
+      StreamRefArgs args;
+      std::memcpy(&args, payload, sizeof(args));
+      process_all(reinterpret_cast<const uint8_t*>(static_cast<uintptr_t>(args.data)), args.length,
+                  (header.flags & kRecBigEndian) != 0, (header.flags & kRecList) != 0);
+      break;
+    }
+    case kRecRawDraw: {
+      RawDrawArgs args;
+      std::memcpy(&args, payload, sizeof(args));
+      execute_raw_draw(args.prim, args.fmt, payload + sizeof(args), args.vtxCount, args.vertexBytes,
+                       args.accepted != 0);
+      break;
+    }
+    case kRecCall: {
+      DecoderCall call;
+      std::memcpy(&call, payload, sizeof(call));
+      // A stream-ordered call (queue_decoder_call_in_stream) runs the work sync did after its drain.
+      struct StreamCallScope {
+        explicit StreamCallScope(bool on) { tStreamCall = on; }
+        ~StreamCallScope() { tStreamCall = false; }
+      } scope{(header.flags & kRecSealed) != 0};
+      call(payload + 8);
+      break;
+    }
+    case kRecProbeVcd: {
+      ProbeSlot& slot = probe_slot(header.aux);
+      for (uint32_t i = 0; i + 2 <= header.length; i += 2) {
+        slot.vcd = slot.vcd || g_gxState.vtxDesc[payload[i]] != static_cast<GXAttrType>(payload[i + 1]);
+      }
+      break;
+    }
+    case kRecProbeVat: {
+      ProbeSlot& slot = probe_slot(header.aux);
+      for (uint32_t i = 0; i + 5 <= header.length; i += 5) {
+        const auto& fmt = g_gxState.vtxFmts[payload[i]].attrs[payload[i + 1]];
+        if (fmt.cnt != static_cast<GXCompCnt>(payload[i + 2]) || fmt.type != static_cast<GXCompType>(payload[i + 3]) ||
+            fmt.frac != payload[i + 4]) {
+          slot.vat = static_cast<uint8_t>(slot.vat | (1u << payload[i]));
+        }
+      }
+      break;
+    }
+    default:
+      Log.error("GX FIFO: unknown queued record {}", header.type);
+      return;
+    }
+  }
+}
+
+void run_segment(const Segment& segment) {
+  ZoneScopedN("GX FIFO segment");
+  try {
+    if (segment.source == kSegMain) {
+      wait_sealed();
+      process_all(detail::sBufferData + segment.begin, segment.end - segment.begin, true, false);
+    } else {
+      run_records(sSide + segment.begin, segment.end - segment.begin);
+    }
+  } catch (const std::exception& e) {
+    // Sync mode let this reach the GX call that drained; there is no such caller here.
+    if (sStats.decodeErrors.fetch_add(1, std::memory_order_relaxed) < 16) {
+      Log.error("GX FIFO: decoding a queued segment failed: {}", e.what());
+    }
+  } catch (...) {
+    if (sStats.decodeErrors.fetch_add(1, std::memory_order_relaxed) < 16) {
+      Log.error("GX FIFO: decoding a queued segment failed");
+    }
+  }
+}
+
+void worker_main() noexcept {
+  tWorker = true;
+#if defined(__SWITCH__)
+  // Core 1 at the game's priority; the frame worker moves to core 2 in this mode (aurora.cpp).
+  SwitchPinCurrentThread(1, 0x2C);
+  SwitchProfilerRegisterGxThread();
+#endif
+  Shared& shared = *sShared;
+  uint64_t done = shared.processed.load(std::memory_order_acquire);
+  for (;;) {
+    uint64_t available = shared.pushed.load(std::memory_order_acquire);
+    if (available == done) {
+      // The producer usually publishes its next draw within a few tens of microseconds.
+      const auto spinUntil = Clock::now() + kWorkerSpin;
+      for (uint32_t i = 1;; ++i) {
+        cpu_relax();
+        available = shared.pushed.load(std::memory_order_acquire);
+        if (available != done || ((i & 63) == 0 && Clock::now() >= spinUntil)) {
+          break;
+        }
+      }
+      if (available == done) {
+        std::unique_lock lock(shared.mutex);
+        shared.workerSleeping.store(true, std::memory_order_seq_cst);
+        shared.workerCv.wait(lock, [&] { return shared.pushed.load(std::memory_order_seq_cst) != done; });
+        shared.workerSleeping.store(false, std::memory_order_relaxed);
+        continue;
+      }
+    }
+    const auto start = Clock::now();
+    while (done < available) {
+      run_segment(shared.ring[done % kRingSize]);
+      ++done;
+      shared.processed.store(done, std::memory_order_seq_cst);
+      // P11: only reaching the requested segment can satisfy the producer's predicate.
+      const uint64_t target = shared.mainWaitTarget.load(std::memory_order_seq_cst);
+      if (target != 0 && done >= target) {
+        std::lock_guard lock(shared.mutex);
+        shared.mainCv.notify_all();
+      }
+      available = shared.pushed.load(std::memory_order_acquire);
+    }
+    sStats.decodeNs.fetch_add(nanos_since(start), std::memory_order_relaxed);
+  }
+}
+
+// ---- Producer --------------------------------------------------------------------------------------
+
+// Hands the segments pushed so far to the worker: one release store per producer call (a draw, a
+// display list...) instead of one per segment. Every path that pushes ends in kick() or waits.
+void publish_pushed() {
+  if (sPublished != sPushed) {
+    sPublished = sPushed;
+    sShared->pushed.store(sPushed, std::memory_order_release);
+  }
+}
+
+void kick(bool urgent) {
+  if (mode() != Mode::Thread) {
+    return;
+  }
+  publish_pushed();
+  Shared& shared = *sShared;
+  if (urgent) {
+    // The worker stores workerSleeping, then loads pushed (both seq_cst, under the mutex). With
+    // this fence between our pushed store and workerSleeping load, either we see it asleep and
+    // wake it, or it sees the new segments and does not sleep.
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+  }
+  // Not urgent: a plain load. Missing a worker that is falling asleep right now only delays its
+  // wake to a later kick, as the draw/byte thresholds below already do on purpose; every wait
+  // (drain, quiesce, full ring) kicks urgently.
+  if (!shared.workerSleeping.load(std::memory_order_relaxed)) {
+    // Awake (spinning or decoding): it will see the new segments on its own.
+    sKickDraws = 0;
+    sKickBytes = 0;
+    return;
+  }
+  if (!urgent && sKickDraws < kKickDraws && sKickBytes < kKickBytes) {
+    return;
+  }
+  sKickDraws = 0;
+  sKickBytes = 0;
+  {
+    // Pairs with the worker's check under the mutex: the wake cannot fall between check and wait.
+    std::lock_guard lock(shared.mutex);
+  }
+  shared.workerCv.notify_one();
+}
+
+// Decodes queued segments on this thread (deferred mode).
+void run_inline_until(uint64_t target) {
+  Shared& shared = *sShared;
+  uint64_t done = shared.processed.load(std::memory_order_relaxed);
+  if (done >= target) {
+    return;
+  }
+  const auto start = Clock::now();
+  while (done < target) {
+    run_segment(shared.ring[done % kRingSize]);
+    ++done;
+    shared.processed.store(done, std::memory_order_relaxed);
+  }
+  sStats.decodeNs.fetch_add(nanos_since(start), std::memory_order_relaxed);
+}
+
+void wait_processed(uint64_t target) {
+  Shared& shared = *sShared;
+  if (mode() != Mode::Thread) {
+    run_inline_until(target);
+    return;
+  }
+  // (Unpublished segments are never processed, so a target among them falls through to kick.)
+  if (shared.processed.load(std::memory_order_acquire) >= target) {
+    return;
+  }
+  ZoneScopedN("GX FIFO wait");
+  const auto start = Clock::now();
+  kick(true);
+  const auto spinUntil = start + kMainSpin;
+  for (uint32_t i = 1; shared.processed.load(std::memory_order_acquire) < target; ++i) {
+    if ((i & 63) != 0 || Clock::now() < spinUntil) {
+      cpu_relax();
+      continue;
+    }
+    bool reached;
+    {
+      std::unique_lock lock(shared.mutex);
+      shared.mainWaitTarget.store(target, std::memory_order_seq_cst);
+      reached = shared.mainCv.wait_for(lock, std::chrono::milliseconds(1), [&] {
+        return shared.processed.load(std::memory_order_seq_cst) >= target;
+      });
+      shared.mainWaitTarget.store(0, std::memory_order_relaxed);
+    }
+    if (!reached) {
+      // As the frame-worker waits do: keep the guest's VI/alarm/audio timing alive. This thread
+      // runs the guest; the worker never calls it (aurora.cpp checks on_worker_thread()).
+      if (const auto service = sWaitService.load(std::memory_order_acquire)) {
+        service();
+      }
+    }
+  }
+  sStats.waitNs += nanos_since(start);
+}
+
+void wait_idle() { wait_processed(sPushed); }
+
+void push_segment(uint32_t begin, uint32_t end, uint8_t source) {
+  Shared& shared = *sShared;
+  // Slot sPushed is free once segment sPushed - kRingSize is processed. sProcessedSeen trails the
+  // worker, so this reads its cache line only when the ring may be full, not once per segment.
+  if (sPushed - sProcessedSeen >= kRingSize) UNLIKELY {
+    sProcessedSeen = shared.processed.load(std::memory_order_acquire);
+    if (sPushed - sProcessedSeen >= kRingSize) {
+      wait_processed(sPushed - kRingSize + 1);
+      sProcessedSeen = shared.processed.load(std::memory_order_acquire);
+    }
+  }
+  shared.ring[sPushed % kRingSize] = Segment{begin, end, source};
+  ++sPushed; // published by publish_pushed (kick, or the wait of whoever pushed)
+  ++sStats.segments;
+  sStats.bytes += end - begin;
+  sKickBytes += end - begin;
+}
+
+void flush_records() {
+  if (sSideOpen == sSideSize) {
+    return;
+  }
+  const uint32_t begin = sSideOpen;
+  sSideOpen = sSideSize;
+  sLastRecord = UINT32_MAX;
+  push_segment(begin, sSideSize, kSegSide);
+}
+
+void publish_main() {
+  flush_records();
+  sPublishedCondId = sNextCondId;
+  if (sMainPublished == detail::sBufferSize) {
+    return;
+  }
+  const uint32_t begin = sMainPublished;
+  sMainPublished = detail::sBufferSize;
+  push_segment(begin, sMainPublished, kSegMain);
+}
+
+// Everything queued is decoded: move the unpublished FIFO tail (a GXBegin block being written,
+// say) to the front. Offsets the producer keeps are virtual (get_buffer_size).
+void compact_main() {
+  const uint32_t tail = detail::sBufferSize - sMainPublished;
+  if (sMainPublished != 0 && tail != 0) {
+    std::memmove(detail::sBufferData, detail::sBufferData + sMainPublished, tail);
+  }
+  detail::sVirtualBase += sMainPublished;
+  detail::sBufferSize = tail;
+  sMainPublished = 0;
+}
+
+void reserve_side(uint32_t bytes) {
+  if (bytes <= sSideCapacity - sSideSize) LIKELY {
+    return;
+  }
+  ++sStats.quiesces[static_cast<size_t>(QuiesceReason::Room)];
+  flush_records();
+  wait_idle();
+  sSideSize = 0;
+  sSideOpen = 0;
+  sLastRecord = UINT32_MAX;
+  if (bytes > sSideCapacity) {
+    const uint32_t capacity = std::max(sSideCapacity * 2, bytes);
+    auto* grown = static_cast<uint8_t*>(realloc(sSide, capacity));
+    ASSERT(grown != nullptr, "GX FIFO: cannot allocate {} bytes", capacity);
+    sSide = grown;
+    sSideCapacity = capacity;
+  }
+}
+
+// A record in the open (not yet pushed) part of the side buffer; `extend` appends to the newest
+// open record instead when it has the same type, flags and aux.
+uint8_t* open_record(uint8_t type, uint8_t flags, uint32_t payload, bool extend, uint16_t aux = 0) {
+  ensure_started();
+  if (extend && sLastRecord != UINT32_MAX) {
+    RecordHeader header;
+    std::memcpy(&header, sSide + sLastRecord, sizeof(header));
+    const uint32_t end = sLastRecord + sizeof(header) + align8(header.length + payload);
+    if (header.type == type && header.flags == flags && header.aux == aux && end <= sSideCapacity) {
+      uint8_t* out = sSide + sLastRecord + sizeof(header) + header.length;
+      header.length += payload;
+      std::memcpy(sSide + sLastRecord, &header, sizeof(header));
+      sSideSize = end;
+      return out;
+    }
+  }
+  const uint32_t total = sizeof(RecordHeader) + align8(payload);
+  reserve_side(total);
+  const RecordHeader header{type, flags, aux, payload};
+  std::memcpy(sSide + sSideSize, &header, sizeof(header));
+  sLastRecord = sSideSize;
+  sSideSize += total;
+  return sSide + sLastRecord + sizeof(header);
+}
+
+void async_drain(DrainReason reason) {
+  ensure_started();
+  note_drain(reason);
+  // A guest timing callback run while waiting could queue more; finish only on a quiet FIFO.
+  do {
+    publish_main();
+    wait_idle();
+  } while (sMainPublished != detail::sBufferSize || sSideOpen != sSideSize);
+  // Sync drained after waiting for SEALED even with nothing to decode; callers rely on it.
+  wait_sealed();
+  detail::sVirtualBase += detail::sBufferSize;
+  detail::sBufferSize = 0;
+  sMainPublished = 0;
+  sSideSize = 0;
+  sSideOpen = 0;
+  sLastRecord = UINT32_MAX;
+  if (reason == DrainReason::EndFrame) {
+    ++sFrameEpoch;
+  }
+}
+
+void async_write_grow(const void* data, uint32_t length) {
+  ensure_started();
+  if (length > detail::sBufferCapacity - detail::sBufferSize) {
+    if (sMainPublished != 0) {
+      ++sStats.quiesces[static_cast<size_t>(QuiesceReason::Room)];
+      flush_records();
+      wait_idle();
+      compact_main();
+    }
+    if (length > detail::sBufferCapacity - detail::sBufferSize) {
+      // Nothing queued reads the main buffer now (sMainPublished == 0).
+      const uint64_t needed = static_cast<uint64_t>(detail::sBufferSize) + length;
+      const auto capacity = static_cast<uint32_t>(
+          std::min<uint64_t>(std::max<uint64_t>(static_cast<uint64_t>(detail::sBufferCapacity) * 2, needed),
+                             UINT32_MAX));
+      auto* grown = static_cast<uint8_t*>(realloc(detail::sBufferData, capacity));
+      ASSERT(grown != nullptr, "GX FIFO: cannot allocate {} bytes", capacity);
+      detail::sBufferData = grown;
+      detail::sBufferCapacity = capacity;
+    }
+  }
+  std::memcpy(detail::sBufferData + detail::sBufferSize, data, length);
+  detail::sBufferSize += length;
+}
+
+void async_init_begin() {
+  if (sStarted) {
+    flush_records();
+    wait_idle();
+  }
+}
+
+void async_init_end() {
+  sMainPublished = 0;
+  sSideSize = 0;
+  sSideOpen = 0;
+  sLastRecord = UINT32_MAX;
+  sVtxProbes = 0;
+  sPublishedCondId = sNextCondId;
+  sArrayShadow = {};
+  ensure_started();
+  ensure_main_capacity(); // init() just reallocated it at 64 KiB
+}
+} // namespace
+
+// ---- Producer API (fifo.hpp) ---------------------------------------------------------------------
+
+bool on_worker_thread() noexcept { return tWorker; }
+
+void set_wait_service(void (*service)()) noexcept { sWaitService.store(service, std::memory_order_release); }
+
+bool exact_raw_draws() noexcept { return sExactRawDraws; }
+
+void publish_draw() {
+  if (!async_mode()) LIKELY {
+    drain(DrainReason::Draw);
+    return;
+  }
+  ensure_started();
+  note_drain(DrainReason::Draw);
+  publish_main();
+  ++sKickDraws;
+  kick(false);
+}
+
+void call_display_list(const void* data, uint32_t nbytes, bool bigEndian) {
+  if (!async_mode()) LIKELY {
+    drain(DrainReason::DisplayList);
+    note_decode(nbytes);
+    process_all(static_cast<const uint8_t*>(data), nbytes, bigEndian, true);
+    return;
+  }
+  ensure_started();
+  note_drain(DrainReason::DisplayList);
+  publish_main(); // what sync drained before decoding the list
+#if defined(__SWITCH__)
+  ++aurora_gx_g6_counters[kG6DlCopies];
+  aurora_gx_g6_counters[kG6DlCopyBytes] += nbytes;
+#endif
+  const uint32_t check = sCheckArrays ? 8u : 0u;
+  const uint8_t flags = static_cast<uint8_t>(kRecSealed | kRecList | (bigEndian ? kRecBigEndian : 0) |
+                                             (sCheckArrays ? kRecArrayCheck : 0));
+  uint8_t* out = open_record(kRecStream, flags, check + nbytes, false);
+  if (sCheckArrays) {
+    const uint64_t fingerprint = producer_array_fingerprint();
+    std::memcpy(out, &fingerprint, sizeof(fingerprint));
+  }
+  if (nbytes != 0) {
+    std::memcpy(out + check, data, nbytes);
+  }
+  flush_records();
+  if (nbytes >= 64) {
+    ++sKickDraws;
+  }
+  kick(false);
+}
+
+#if defined(__SWITCH__)
+// call_display_list with the bytes left where the caller keeps them: the record holds their address,
+// and the decoder reads them where it would have read the copy. Same drain note, publish, record flags
+// (minus the array check, which needs its fingerprint in front of a copy) and kick accounting.
+void call_display_list_ref(const void* data, uint32_t nbytes, bool bigEndian) {
+  if (!async_mode() || sCheckArrays || nbytes == 0) {
+    call_display_list(data, nbytes, bigEndian);
+    return;
+  }
+  ensure_started();
+  note_drain(DrainReason::DisplayList);
+  publish_main(); // what sync drained before decoding the list
+  ++aurora_gx_g6_counters[kG6DlRefs];
+  aurora_gx_g6_counters[kG6DlRefBytes] += nbytes;
+  const uint8_t flags = static_cast<uint8_t>(kRecSealed | kRecList | (bigEndian ? kRecBigEndian : 0));
+  const StreamRefArgs args{static_cast<uint64_t>(reinterpret_cast<uintptr_t>(data)), nbytes, 0};
+  uint8_t* out = open_record(kRecStreamRef, flags, sizeof(args), false);
+  std::memcpy(out, &args, sizeof(args));
+  flush_records();
+  // The worker-wake byte threshold counts the list as the copy did.
+  sKickBytes += nbytes;
+  if (nbytes >= 64) {
+    ++sKickDraws;
+  }
+  kick(false);
+}
+#endif
+
+bool has_unprocessed() {
+  if (!async_mode() || !sStarted) LIKELY {
+    return detail::sBufferSize != 0;
+  }
+  return detail::sBufferSize != sMainPublished || sSideSize != sSideOpen ||
+         sShared->processed.load(std::memory_order_acquire) != sPushed;
+}
+
+void quiesce(QuiesceReason reason) {
+  aurora::gx::HleProducerScope hleScope;
+  if (!async_mode()) LIKELY {
+    return;
+  }
+  ensure_started();
+  ++sStats.quiesces[static_cast<size_t>(reason)];
+  // Records already queued are state sync had applied by now.
+  flush_records();
+  wait_idle();
+}
+
+void queue_bp(uint32_t word) {
+  uint8_t* out = open_record(kRecStream, kRecBigEndian, 5, true);
+  out[0] = 0x61; // GX_LOAD_BP_REG
+  const uint32_t be = bswap(word);
+  std::memcpy(out + 1, &be, sizeof(be));
+}
+
+void queue_decoder_call(DecoderCall call, const void* args, uint32_t size) {
+  static_assert(sizeof(DecoderCall) == 8);
+  uint8_t* out = open_record(kRecCall, 0, 8 + size, false);
+  std::memcpy(out, &call, sizeof(call));
+  std::memcpy(out + 8, args, size);
+}
+
+// Work sync did right after a drain (an EFB copy): behind everything written so far, decoded once
+// the frame worker has sealed, as that drain waited (kRecSealed).
+void queue_decoder_call_in_stream(DecoderCall call, const void* args, uint32_t size) {
+  ensure_started();
+  publish_main(); // what sync's drain decoded before the call
+  uint8_t* out = open_record(kRecCall, kRecSealed, 8 + size, false);
+  std::memcpy(out, &call, sizeof(call));
+  std::memcpy(out + 8, args, size);
+  flush_records();
+  ++sKickDraws;
+  kick(false);
+}
+
+bool decoding_stream_call() noexcept { return tStreamCall; }
+
+void note_copy(bool queued) noexcept { ++(queued ? sStats.copiesQueued : sStats.copiesInline); }
+
+void queue_raw_draw(uint8_t prim, uint8_t fmt, const uint8_t* vertices, uint16_t vtxCount, uint32_t vertexBytes,
+                    bool accepted) {
+  ensure_started();
+  note_drain(DrainReason::RawDraw);
+  publish_main(); // what sync drained before the draw
+  const RawDrawArgs args{prim, fmt, static_cast<uint8_t>(accepted ? 1 : 0), 0, vtxCount, 0, vertexBytes, 0};
+  const uint32_t copy = accepted ? vertexBytes : 0;
+  uint8_t* out = open_record(kRecRawDraw, kRecSealed, sizeof(args) + copy, false);
+  std::memcpy(out, &args, sizeof(args));
+  if (copy != 0) {
+    std::memcpy(out + sizeof(args), vertices, copy);
+  }
+  flush_records();
+  ++sKickDraws;
+  kick(false);
+}
+
+void note_raw_draw_mismatch() noexcept {
+  const uint64_t n = sStats.rawMismatches.fetch_add(1, std::memory_order_relaxed);
+  if (n < 16) {
+    Log.warn("GX FIFO: a raw draw's vertex size differed between the producer shadow and the decoder");
+  }
+}
+
+// Probes are records (decoded in front of the unpublished bytes, where sync compared); each belongs
+// to the next conditional flush, which goes into the FIFO bytes at its place.
+void probe_vtx_desc(uint32_t attr, uint32_t type) {
+#if defined(__SWITCH__)
+  ++aurora_gx_a3_counters[kA3VtxProbes];
+#endif
+  uint8_t* out = open_record(kRecProbeVcd, 0, 2, true, sNextCondId);
+  out[0] = static_cast<uint8_t>(attr);
+  out[1] = static_cast<uint8_t>(type);
+  sVtxProbes |= 0x100u;
+}
+
+void probe_vtx_attr_fmt(uint32_t fmt, uint32_t attr, uint32_t cnt, uint32_t type, uint32_t frac) {
+#if defined(__SWITCH__)
+  ++aurora_gx_a3_counters[kA3VtxProbes];
+#endif
+  uint8_t* out = open_record(kRecProbeVat, 0, 5, true, sNextCondId);
+  out[0] = static_cast<uint8_t>(fmt);
+  out[1] = static_cast<uint8_t>(attr);
+  out[2] = static_cast<uint8_t>(cnt);
+  out[3] = static_cast<uint8_t>(type);
+  out[4] = static_cast<uint8_t>(frac);
+  sVtxProbes |= 1u << fmt;
+}
+
+uint32_t vtx_probes() noexcept { return sVtxProbes; }
+
+// GXManage.cpp's __GXSetDirtyState has just written the VCD block [start, vcdEnd) and the VAT
+// blocks of every candidate format [vcdEnd, end) as sync would have. They are wrapped, in place,
+// into an Aurora subcommand the decoder applies in part (run_vtx_cond).
+void queue_vtx_cond(uint32_t start, uint32_t vcdEnd, bool vcdForce, uint8_t vatForce) {
+  const uint32_t probes = sVtxProbes;
+  sVtxProbes = 0;
+  // Flushes whose blocks are still unpublished hold probe slots; keep them well below the slots.
+  if (static_cast<uint16_t>(sNextCondId - sPublishedCondId) >= kProbeSlots / 2) UNLIKELY {
+    publish_main();
+  }
+  // Virtual positions: the blocks are unpublished, so compaction kept them.
+  const uint32_t begin = start - detail::sVirtualBase;
+  const uint32_t vcdBytes = vcdEnd - start;
+  const uint32_t total = detail::sBufferSize - begin;
+  uint8_t block[64 + 8 * kVatBlockBytes];
+  ASSERT(total <= sizeof(block) && vcdBytes <= total, "GX FIFO: vertex flush of {} bytes", total);
+  std::memcpy(block, detail::sBufferData + begin, total);
+  detail::sBufferSize = begin;
+  const VtxCondArgs args{static_cast<uint8_t>(vcdForce ? 1 : 0),
+                         static_cast<uint8_t>((probes & 0x100u) != 0 ? 1 : 0),
+                         vatForce,
+                         static_cast<uint8_t>(probes & 0xFFu),
+                         sNextCondId,
+                         0,
+                         vcdBytes};
+  ++sNextCondId;
+  write_u8(0x50); // GX_LOAD_AURORA
+  write_u16(kAuroraVtxCondSubCmd);
+  write_u32(static_cast<uint32_t>(sizeof(args)) + total);
+  write_data(&args, sizeof(args));
+  write_data(block, total);
+}
+
+// command_processor.cpp's handle_aurora, on kAuroraVtxCondSubCmd.
+void run_vtx_cond_record(const uint8_t* payload, uint32_t length) { run_vtx_cond(payload, length); }
+
+void note_array(uint32_t attr, const void* data, uint32_t size) {
+  if (sCheckArrays && attr < sArrayShadow.size() && !in_display_list()) UNLIKELY {
+    sArrayShadow[attr] = {data, size};
+  }
+}
