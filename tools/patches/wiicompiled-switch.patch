+}
+// GXCallDisplayList of host bytes the caller keeps valid and unchanged until the end-of-frame drain
+// after this call has completed (aurora_gx_fifo_frame_epoch() moved past its value at the call).
+// Deferred/thread queue a reference, decoded where the copy would have been; sync decodes them now.
+void call_display_list_ref(const void* data, uint32_t nbytes, bool bigEndian);
+// Producer-thread counters for the benchmark summary (gx_g6_per_frame).
+enum G6Counter : uint32_t {
+  kG6DlRefs = 0,        // display lists queued by reference
+  kG6DlRefBytes,        // their bytes (not copied)
+  kG6DlCopies,          // display lists still copied (deferred/thread)
+  kG6DlCopyBytes,       // their bytes
+  kG6RegOnlyHits,       // register-only lists served from the runtime's host copies
+  kG6RegOnlyStores,     // register-only lists copied into that cache
+  kG6CheckMismatches,   // WIICOMPILED_GX_G6_CHECK=1: host copy != guest bytes (the copy path ran)
+  kG6ScanCacheClears,   // display-list scan cache full: cleared
+  kG6MirrorSyncs,       // applied vertex-state mirror resyncs (gx_dl.cpp)
+  kG6MirrorRowsCopied,  // vtxAttrFmt rows those copied (8 each before G6)
+  kG6HostBytesLive,     // gauge: bytes of host copies the runtime holds (not a per-frame delta)
+  kG6CounterCount
+};
+} // namespace aurora::gx::fifo
+extern "C" uint64_t aurora_gx_g6_counters[aurora::gx::fifo::kG6CounterCount];
+namespace aurora::gx::fifo {
+#endif
+
 // Internal buffer inspection
 const uint8_t* get_buffer_data();
 uint32_t get_buffer_size();
 void clear_buffer();
 
 } // namespace aurora::gx::fifo
