new file mode 100644
index 0000000..e8aa273
--- /dev/null
+++ b/runtime/src/platform/switch/switch_threads.cpp
@@ -0,0 +1,11 @@
+// Core and priority for threads that libnx would start at 0x3B on the default core
+// (aurora.cpp's frame worker and presenter, the AX mixer). Lower number = higher priority;
+// the game's main thread runs at 0x2C on core 0.
+#if defined(__SWITCH__)
+#include <switch.h>
+
+extern "C" void SwitchPinCurrentThread(int core, int priority) {
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1u << core);
+    svcSetThreadPriority(CUR_THREAD_HANDLE, priority);
+}
+#endif
