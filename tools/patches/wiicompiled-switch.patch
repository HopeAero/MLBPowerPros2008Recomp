+    // (decode 1) or back to the loop start (+1), so it stays in [min(loop, cur), max(loop, end, cur) +
+    // 3 * reads + 3]; positions >= 2^30 (mask/wrap territory) are refused.
+    static bool VoiceReadsClear(const AXPBWii* states, size_t stateCount, uint64_t reads, uintptr_t pbLo,
+                                uintptr_t pbHi) {
+        uint64_t lo = UINT64_MAX;
+        uint64_t top = 0;
+        for (size_t s = 0; s < stateCount; ++s) {
+            const PBAudioAddr& a = states[s].audio_addr;
+            const uint64_t start = Hilo(a.loop_addr_hi, a.loop_addr_lo) & 0x3fffffffu;
+            const uint64_t end = Hilo(a.end_addr_hi, a.end_addr_lo) & 0x3fffffffu;
+            const uint64_t cur = Hilo(a.cur_addr_hi, a.cur_addr_lo) & 0xbfffffffu;
