+    // Accelerator byte span [lo, hi] (DSP ARAM addressing) against the PB envelope, resolved like
+    // ResolveAramWindow/AramAliasesFor: bit 28 selects MEM2 (offset masked to kMem2Size), otherwise
+    // MEM1 masked to 32 MB. A span inside one 32 MB block is one contiguous host range in both.
+    static bool AramSpanClear(uint64_t lo, uint64_t hi, uintptr_t pbLo, uintptr_t pbHi) {
+        if (((lo ^ hi) >> 25) != 0) {
+            return false;
+        }
+        const bool mem2 = (lo & 0x10000000u) != 0;
+        const uint8_t* base = (mem2 ? g_mixMem2 : g_mixMem1).load(std::memory_order_relaxed);
+        if (base == nullptr) {
+            return true;  // nothing resolves there: the accelerator reads silence
+        }
+        const uint64_t mask = mem2 ? static_cast<uint64_t>(Memory::kMem2Size - 1u) : 0x01ffffffu;
+        const uintptr_t first = reinterpret_cast<uintptr_t>(base) + static_cast<uintptr_t>(lo & mask);
+        const uintptr_t last = reinterpret_cast<uintptr_t>(base) + static_cast<uintptr_t>(hi & mask);
+        return last < pbLo || first >= pbHi;
+    }
