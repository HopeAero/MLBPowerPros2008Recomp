+// MLB Life saves (pm3usmy<slot>.dat, 0xF8000 bytes) are the same kind of block copy: the year index is
+// at file 0x47EE8 and the game's data end before 0xF4000 (the last 16 KB chunk a load reads ends
+// there). A season pack's start year travels in a small tail of their own at kLifeTailOffset:
+// "PPLIFE01", u32 start shift (big-endian).
+constexpr uint32_t kLifeFileSize = 0xF8000, kLifeLoadEnd = 0xF4000, kLifeIndexOffset = 0x47EE8;
+constexpr uint32_t kLifeTailOffset = 0xF7FC0;
+constexpr size_t kLifeTailSize = 12;
+constexpr char kLifeTailMagic[8] = {'P', 'P', 'L', 'I', 'F', 'E', '0', '1'};
+inline void WriteLifeTail(uint32_t startShift, uint8_t* out) {
+    std::memcpy(out, kLifeTailMagic, 8);
+    PutBe32(out + 8, startShift);
+}
+inline bool ReadLifeTail(const uint8_t* in, uint32_t& startShift) {
+    startShift = 0;
+    if (std::memcmp(in, kLifeTailMagic, 8) != 0) return false;
+    startShift = GetBe32(in + 8);
+    return true;
+}
+// The part of a write chunk that covers the life tail gets it.
+inline void OverlayLifeTail(uint32_t startShift, uint32_t fileOffset, uint8_t* data, size_t length) {
+    const uint32_t from = fileOffset > kLifeTailOffset ? fileOffset : kLifeTailOffset;
+    const uint32_t end = kLifeTailOffset + static_cast<uint32_t>(kLifeTailSize);
+    const uint32_t to = fileOffset + length < end ? fileOffset + static_cast<uint32_t>(length) : end;
+    if (from >= to) return;
+    uint8_t bytes[kLifeTailSize];
+    WriteLifeTail(startShift, bytes);
+    std::memcpy(data + (from - fileOffset), bytes + (from - kLifeTailOffset), to - from);
+}
+inline bool IsLifeSaveName(const char* fileName) {
+    return fileName && std::strncmp(fileName, "pm3usmy", 7) == 0 && fileName[7] >= '0' && fileName[7] <= '2' &&
+           std::strcmp(fileName + 8, ".dat") == 0;
+}
+
 // pm3usse0.dat .. pm3usse2.dat, the three Season mode slots.
 inline bool IsSeasonSaveName(const char* fileName) {
     return fileName && std::strncmp(fileName, "pm3usse", 7) == 0 && fileName[7] >= '0' && fileName[7] <= '2' &&
@@ -296,5 +329,9 @@ void OnHostFrame();        // settings_overlay.cpp, once per presented frame
 // data (a copy the hook may change).
 void OnSeasonSaveRead(uint32_t fileOffset, const uint8_t* data, size_t length, const uint8_t* tail);
 void OnSeasonSaveWrite(uint32_t fileOffset, uint8_t* data, size_t length);
+// The same for MLB Life saves (IsLifeSaveName); `tail` (kLifeTailSize bytes from kLifeTailOffset) comes
+// with the chunk that holds the year index.
+void OnLifeSaveRead(uint32_t fileOffset, const uint8_t* data, size_t length, const uint8_t* tail);
+void OnLifeSaveWrite(uint32_t fileOffset, uint8_t* data, size_t length);
 
 }  // namespace season_cap
