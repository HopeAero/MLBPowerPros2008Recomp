+void OnLifeSaveRead(uint32_t fileOffset, const uint8_t* data, size_t length, const uint8_t* tail) {
+    std::lock_guard<std::mutex> lock(g_candidateLock);
+    if (fileOffset >= kLifeLoadEnd) {
+        g_candidate.set = false;  // past the data: a save's read, not a load
+        return;
+    }
+    if (!tail || fileOffset > kLifeIndexOffset || kLifeIndexOffset >= fileOffset + length) return;
+    g_candidate = {};
+    g_candidate.life = true;
+    g_candidate.ours = ReadLifeTail(tail, g_candidate.tail.startShift);
+    g_candidate.index = static_cast<int8_t>(data[kLifeIndexOffset - fileOffset]);
+    g_candidate.frame = g_frame.load();
+    g_candidate.set = true;
+}
+
+void OnLifeSaveWrite(uint32_t fileOffset, uint8_t* data, size_t length) {
+    if (!LifeModeActive() || g_tail.startShift == 0) return;  // anything else stays byte for byte
+    OverlayLifeTail(g_tail.startShift, fileOffset, data, length);
+}
