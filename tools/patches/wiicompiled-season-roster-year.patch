+// MLB Life's family (wife and up to 5 children): records of 0x20 bytes from [0x8104B59C] + 0x678C, the
+// birth date in each first word: bits 31..24 year - 1900, 23..20 month, 19..15 day. Made when the
+// career is created, against the game's own 2007/2008 dates.
+constexpr uint32_t kFamilyBirths = 0x678C, kFamilyStride = 0x20;
+constexpr int kFamilyMembers = 6;
+inline bool FamilyBirthValid(uint32_t word) {
+    const uint32_t year = word >> 24, month = (word >> 20) & 0xF, day = (word >> 15) & 0x1F;
+    return year >= 50 && year < 200 && month >= 1 && month <= 12 && day >= 1 && day <= 31;
+}
+inline uint32_t FamilyBirthShifted(uint32_t word, uint32_t years) {
+    return word + (years << 24);
+}
+
 inline bool IsLifeSaveName(const char* fileName) {
     return fileName && std::strncmp(fileName, "pm3usmy", 7) == 0 && fileName[7] >= '0' && fileName[7] <= '2' &&
            std::strcmp(fileName + 8, ".dat") == 0;
