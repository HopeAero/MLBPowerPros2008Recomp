@@ -242,14 +242,33 @@ bool UniversalDh() {
     return fromMod || RuntimeConfigFile::UniversalDh(false);
 }
 
-bool BeginNewGame(int startYear) {
+// MLB Life: the wife and children were born against the game's 2007 dates; same age in the year shown.
+void ShiftFamily(uint32_t shift) {
+    const uint32_t first = Memory::Read32(0x8104B59Cu) + kFamilyBirths;
+    if (!Memory::Contains(first, kFamilyMembers * kFamilyStride)) return;
+    int moved = 0;
+    for (int k = 0; k < kFamilyMembers; ++k) {
+        const uint32_t at = first + static_cast<uint32_t>(k) * kFamilyStride;
+        const uint32_t word = Memory::Read32(at);
+        if (!FamilyBirthValid(word)) continue;
+        Memory::Write32(at, FamilyBirthShifted(word, shift));
+        ++moved;
+    }
+    std::fprintf(stderr, "[season] MLB Life: %d family birth dates moved %u years\n", moved, shift);
+}
+
+bool BeginNewGame(int startYear, int rosterYear) {
     // A new game of either mode (MLB Life's starts at index 0 too, then goes back to its off-season).
     if ((!SeasonModeActive() && !LifeModeActive()) || CurrentIndex() != 0) return false;
     g_tail = {};
     g_tail.startShift = startYear > 2008 ? static_cast<uint32_t>(startYear - 2008) : 0;
     if (g_tail.startShift) {
-        std::fprintf(stderr, "[season] new game: the first season is %d\n", startYear);
-        ShiftBirthYears(g_tail.startShift);
+        // The roster's ages are for its own season (rosterYear, by default the first one): its players
+        // are born rosterYear - 2008 years later, so they are startYear - rosterYear years older.
+        const int roster = rosterYear >= 2008 ? rosterYear : startYear;
+        std::fprintf(stderr, "[season] new game: the first season is %d, roster of %d\n", startYear, roster);
+        ShiftBirthYears(static_cast<uint32_t>(roster - 2008));
+        if (LifeModeActive()) ShiftFamily(g_tail.startShift);
     }
     return true;
 }
