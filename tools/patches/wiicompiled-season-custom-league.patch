+// The Custom League screen (Season > Start > Major League Mode; object at r3): 42 slots of 0x24 bytes at
+// +0x2FD8, 7 a division, league * 3 + division; a slot has its team's code (1..30, 0 empty) at +0, its
+// league at +8, its division at +0xC. The screen's start (0x80BB8AEC) fills them from the leagues
+// set so far and calls 0x80BB8FC4, which every move calls too.
+namespace season_schedule {
+namespace {
+namespace custom_league {
+
+constexpr uint32_t kSlots = 0x2FD8, kSlotBytes = 0x24;
+constexpr int kDivisionSlots = 7, kScreenSlots = 42;
+
+uint32_t SlotAt(uint32_t screen, int slot) { return screen + kSlots + static_cast<uint32_t>(slot) * kSlotBytes; }
+
+// The screen opens on 2008's leagues: with a pack's divisions or the 15/15 option, it opens on those.
+void Prefill(CpuContext* ctx, uint32_t screen) {
+    std::vector<std::string> listed[6];
+    std::string source;
+    if (!WantedDivisions(listed, source)) return;
+    std::array<int, kTeams> current;
+    current.fill(-1);
+    for (int s = 0; s < kScreenSlots; ++s) {
+        const int code = static_cast<int>(Memory::Read32(SlotAt(screen, s)));
+        if (code >= 1 && code <= kTeams) current[kCodeTeam[code - 1]] = s / kDivisionSlots;
+    }
+    for (int t = 0; t < kTeams; ++t) {
+        if (current[t] != DefaultDivision(t)) return;  // not 2008's leagues (or not the 30 teams): as they are
+    }
+    const Realignment realigned = Realign(current, listed);
+    if (!realigned.error.empty()) return;
+    // Each division's teams in their order, those that come in after those that stay.
+    std::array<std::vector<std::array<uint8_t, kSlotBytes>>, 6> divisions;
+    for (int pass = 0; pass < 2; ++pass) {
+        for (int s = 0; s < kScreenSlots; ++s) {
+            const uint32_t at = SlotAt(screen, s);
+            const int code = static_cast<int>(Memory::Read32(at));
+            if (code < 1 || code > kTeams) continue;
+            const int to = realigned.division[kCodeTeam[code - 1]];
+            if ((to == s / kDivisionSlots) != (pass == 0)) continue;
+            std::array<uint8_t, kSlotBytes> bytes;
+            for (uint32_t i = 0; i < kSlotBytes; ++i) bytes[i] = Memory::Read8(at + i);
+            divisions[to].push_back(bytes);
+        }
+    }
+    for (int d = 0; d < 6; ++d) {
+        for (int i = 0; i < kDivisionSlots; ++i) {
+            const uint32_t at = SlotAt(screen, d * kDivisionSlots + i);
+            if (i < static_cast<int>(divisions[d].size())) {
+                for (uint32_t b = 0; b < kSlotBytes; ++b) Memory::Write8(at + b, divisions[d][i][b]);
+            } else {
+                Memory::Write32(at, 0);  // an empty slot, as the screen's start leaves one
+            }
+            Memory::Write32(at + 8, static_cast<uint32_t>(d / 3));
+            Memory::Write32(at + 12, static_cast<uint32_t>(d % 3));
+        }
+    }
+    // Redrawn as the screen's start draws them: each slot (0x80BB8E6C), each division (0x80BB8EF8).
+    for (int s = 0; s < kScreenSlots; ++s) {
+        ctx->gpr[3] = screen, ctx->gpr[4] = static_cast<uint32_t>(s), ctx->gpr[5] = 0;
+        Call(ctx, 0x80BB8E6Cu, InvokeDirectCpu<0x80BB8E6Cu>);
+    }
+    for (int d = 0; d < 6; ++d) {
+        ctx->gpr[3] = screen, ctx->gpr[4] = static_cast<uint32_t>(d * kDivisionSlots);
+        Call(ctx, 0x80BB8EF8u, InvokeDirectCpu<0x80BB8EF8u>);
+    }
+    std::fprintf(stderr, "[season] Custom League opens on the divisions of %s\n", source.c_str());
+}
+
+}  // namespace custom_league
+
+}  // namespace
+
+}  // namespace season_schedule
+
+// 0x80BB8FC4 (Custom League screen): checks the leagues after each move. As the original: every
+// division needs 4 teams and the American League an even number (the game's schedule is made for
+// even leagues), or OK is off and, for an odd league, a message says so. 15 and 15 also pass with a
+// pack's divisions or the 15/15 option, whose schedule generator makes them a season. Called by the
+// screen's start (return 0x80BB8C44), it first puts the teams in those divisions.
+extern "C" void MLB_CustomLeagueCheck_80BB8FC4(CpuContext* ctx) {
+    using namespace season_schedule;
+    using custom_league::SlotAt;
+    const uint32_t screen = ctx->gpr[3];
+    if (ctx->lr == 0x80BB8C44u) custom_league::Prefill(ctx, screen);
+    bool invalid = false;
+    int american = 0;
+    for (int d = 0; d < 6; ++d) {
+        int teams = 0;
+        for (int i = 0; i < custom_league::kDivisionSlots; ++i)
+            teams += Memory::Read32(SlotAt(screen, d * custom_league::kDivisionSlots + i)) != 0;
+        invalid = invalid || teams < 4;
+        if (d < 3) american += teams;
+    }
+    std::vector<std::string> listed[6];
+    std::string source;
+    const bool odd = american % 2 != 0 && !(american == kTeams / 2 && WantedDivisions(listed, source));
+    invalid = invalid || odd;
+    // The player's team (code at +0x2FD0, +0x2FD4 against a slot's +0x14) is drawn again where it is;
+    // the reset button is on when a slot differs from the screen's start (copies at +0x35C0).
+    bool unchanged = true;
+    for (int s = 0; s < custom_league::kScreenSlots; ++s) {
+        const uint32_t at = SlotAt(screen, s);
+        if (Memory::Read32(screen + 0x2FD0) == Memory::Read32(at) && Memory::Read32(screen + 0x2FD4) == Memory::Read32(at + 0x14)) {
+            const uint32_t leagues = Call(ctx, 0x80C12F20u, InvokeDirectCpu<0x80C12F20u>);
+            ctx->gpr[3] = leagues, ctx->gpr[4] = at;
+            const uint32_t team = Call(ctx, 0x80C14254u, InvokeDirectCpu<0x80C14254u>);
+            ctx->gpr[3] = Memory::Read32(screen + 0x3BCC), ctx->gpr[4] = team, ctx->gpr[5] = Memory::Read32(at + 8);
+            ctx->gpr[6] = Memory::Read32(at + 0x10), ctx->gpr[7] = Memory::Read32(at + 0x14) & 0xFF;
+            Call(ctx, 0x80B2EC80u, InvokeDirectCpu<0x80B2EC80u>);
+        }
+        if (Memory::Read32(at + 0x5E8) != Memory::Read32(at) || Memory::Read32(at + 0x5FC) != Memory::Read32(at + 0x14))
+            unchanged = false;
+    }
+    ctx->gpr[3] = Memory::Read32(screen + 0x3C78), ctx->gpr[4] = odd;  // the odd league message
+    {
+        const uint32_t target = Memory::Read32(Memory::Read32(ctx->gpr[3]) + 0x10);
+        const uint32_t lr = ctx->lr;
+        ctx->ctr = target, ctx->lr = target;
+        InvokeIndirectCpu(target, ctx);
+        ctx->lr = lr;
+    }
+    ctx->gpr[3] = Memory::Read32(screen + 0x3BC4), ctx->gpr[4] = invalid;  // OK off
+    Call(ctx, 0x80AB49C8u, InvokeDirectCpu<0x80AB49C8u>);
+    ctx->gpr[3] = Memory::Read32(screen + 0x3BC8), ctx->gpr[4] = unchanged;
+    Call(ctx, 0x80AB49C8u, InvokeDirectCpu<0x80AB49C8u>);
+}
+PPC_NATIVE_OVERRIDE_VOID(80BB8FC4, MLB_CustomLeagueCheck_80BB8FC4, (CpuContext* ctx), (ctx));
