+// The divisions wanted: a pack's [divisions], else the MEJORAS option (today's leagues, Houston in
+// the AL West). False with neither.
+bool WantedDivisions(std::vector<std::string> (&listed)[6], std::string& source) {
+    const auto all = mods::Discover();
+    if (const mods::Mod* mod = DivisionsMod(all)) {
+        for (int d = 0; d < 6; ++d) listed[d] = mod->divisions[d];
+        source = "mod \"" + mod->name + "\"";
+        return true;
+    }
+    if (!RuntimeConfigFile::ModernLeagues(false)) return false;
+    for (auto& d : listed) d.clear();
+    listed[2] = {"HOU"};
+    source = "the 15/15 option";
+    return true;
+}
+
+// 2008's division (league * 3 + division) of each team number (kTeamCodes).
+int DefaultDivision(int team) {
+    static constexpr int kFirst[6] = {0, 5, 10, 14, 19, 25};
+    int d = 5;
+    while (team < kFirst[d]) --d;
+    return d;
+}
+
+// Where each team number (kTeamCodes, 2008's order) is in the season's team words: each word keeps
+// its team's code (kCodeTeam) in bits 23..8. A Custom League (Season > Start)
+// renumbers the teams in the order of its screen; Quick Start keeps 2008's. 2008's order when the
+// codes are not the 30 teams.
+std::array<int, kTeams> TeamSlots() {
+    std::array<int, kTeams> slot{};
+    for (int t = 0; t < kTeams; ++t) slot[t] = t;
+    const uint32_t words = Memory::Read32(0x8104B5A0u) + 128;
+    if (!Memory::Contains(words, kTeams * 4)) return slot;
+    std::array<int, kTeams> found;
+    found.fill(-1);
+    for (int t = 0; t < kTeams; ++t) {
+        const int code = static_cast<int>((Memory::Read32(words + 4 * t) >> 8) & 0xFFFF);
+        if (code < 1 || code > kTeams || found[kCodeTeam[code - 1]] >= 0) return slot;
+        found[kCodeTeam[code - 1]] = t;
+    }
+    return found;
+}
