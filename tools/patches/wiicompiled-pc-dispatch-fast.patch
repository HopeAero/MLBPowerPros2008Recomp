index 0000000..1bc00a0
--- /dev/null
+++ b/runtime/src/abi_dispatch_fast.cpp
@@ -0,0 +1,163 @@
+// Switch phase 79: portable table; the header declaration makes linkage explicit on COFF and ELF.
+#include "abi_bridge.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// P25-LOGIC-BEGIN (pure logic: extracted verbatim by local/tmp/cpu/P25-test; needs <atomic>,
+// <cstdint>, RawDispatchRecord and CpuContext only)
+namespace mkw_fast_dispatch {
+
+// 2-way sets of two adjacent words (one 16-byte pair, one cache line): 1024 sets, 2048 words, 16 KiB.
+// (The old thread-local memo was direct-mapped with 512 entries of 16 bytes.)
+inline constexpr uint32_t kSets = 1024;
+inline constexpr uint32_t kEntries = kSets * 2u;
+// ApplyRuntimeCallOptions rewrites r4 of this target's call (ScnRenderer::createPath): its calls
+// always take the old body. If ApplyRuntimeCallOptions ever handles another target, list it here.
+inline constexpr uint32_t kCreatePathTarget = 0x8023BD38u;
+
+inline uint32_t Index(uint32_t target) noexcept {  // first word of the target's set
+    return (((target >> 2) ^ (target >> 13)) & (kSets - 1u)) * 2u;
+}
+
+// What the old fast branch needs to run `record` for `target`, as one word: the low half is the
+// guest target (0 = empty slot; target 0 never reaches the table), the high half the signed
+// distance from `anchor` (the table's own address) to the host entry. False: not representable /
+// not eligible, the caller leaves the slot alone.
+inline bool Pack(uint32_t target, const RawDispatchRecord* record, uintptr_t anchor,
+                 uint64_t* word) noexcept {
+    if (target == 0u || target == kCreatePathTarget || record == nullptr || record->entry == nullptr ||
+        record->nonvolatileFprWriteMask != 0u || record->preserveNonvolatileGprs ||
+        record->address != target) {
+        return false;
+    }
+    const int64_t distance = static_cast<int64_t>(reinterpret_cast<uintptr_t>(record->entry)) -
+                             static_cast<int64_t>(anchor);
+    if (distance < INT32_MIN || distance > INT32_MAX) {
+        return false;
+    }
+    *word = (static_cast<uint64_t>(static_cast<uint32_t>(static_cast<int32_t>(distance))) << 32) | target;
+    return true;
+}
+
+inline void (*Unpack(uint64_t word, uintptr_t anchor) noexcept)(CpuContext*) {
+    return reinterpret_cast<void (*)(CpuContext*)>(
+        static_cast<uintptr_t>(static_cast<int64_t>(anchor) + (static_cast<int64_t>(word) >> 32)));
+}
+
+// The word that holds `target` in its set, or 0. A word that is present is never 0 (its low half is a
+// nonzero target), so "word != 0" is the whole hit test, and target 0 (the empty slots' value) never
+// hits.
+inline uint64_t Find(const std::atomic<uint64_t>* table, uint32_t target) noexcept {
+    const std::atomic<uint64_t>* set = table + Index(target);
+    uint64_t word = set[0].load(std::memory_order_relaxed);
+    if (static_cast<uint32_t>(word) == target) {
+        return word;
+    }
+    word = set[1].load(std::memory_order_relaxed);
+    return static_cast<uint32_t>(word) == target ? word : 0u;
+}
+
+// Store `word` (made by Pack for `target`, which Find just missed): an empty way first, else the way
+// `victim` selects. Nothing is ever removed, and a slot only ever changes between valid words.
+inline void Insert(std::atomic<uint64_t>* table, uint32_t target, uint64_t word, uint32_t victim) noexcept {
+    std::atomic<uint64_t>* set = table + Index(target);
+    if (static_cast<uint32_t>(set[0].load(std::memory_order_relaxed)) == 0u) {
+        set[0].store(word, std::memory_order_relaxed);
+    } else if (static_cast<uint32_t>(set[1].load(std::memory_order_relaxed)) == 0u) {
+        set[1].store(word, std::memory_order_relaxed);
+    } else {
+        set[victim & 1u].store(word, std::memory_order_relaxed);
+    }
+}
+
+}  // namespace mkw_fast_dispatch
+// P25-LOGIC-END
+
+namespace {
+// Global, shared by every thread that calls InvokeIndirectCpu (the guest thread, audio and callback
+// threads): a slot is one 64-bit word, written and read atomically, and any word that is present
+// is valid for every thread (the table is immutable data after Finalize).
+alignas(64) std::atomic<uint64_t> g_fastDispatch[mkw_fast_dispatch::kEntries];
+
+// RecompMod::ScopedTranslatedExecutionAddress for an address known to be nonzero (the hit path's
+// target is: a present word never has a zero low half), without its zero test.
+class NonzeroExecutionAddressScope {
+public:
+    explicit NonzeroExecutionAddressScope(uint32_t address) noexcept
+        : previous_(RecompMod::g_currentTranslatedExecutionAddress) {
+        RecompMod::g_currentTranslatedExecutionAddress = address;
+    }
+    ~NonzeroExecutionAddressScope() noexcept {
+        RecompMod::g_currentTranslatedExecutionAddress = previous_;
+    }
+    NonzeroExecutionAddressScope(const NonzeroExecutionAddressScope&) = delete;
+    NonzeroExecutionAddressScope& operator=(const NonzeroExecutionAddressScope&) = delete;
+
+private:
+    uint32_t previous_;
+};
+
+bool FastDispatchEnabled() noexcept {
+    static const bool enabled = [] {
+        const char* env = std::getenv("WIICOMPILED_DISPATCH_FAST");
+        const bool on = env == nullptr || env[0] != '0';
+        std::fprintf(stderr, "[dispatch] indirect fast table %s (WIICOMPILED_DISPATCH_FAST)\n",
+                     on ? "on" : "off");
+        return on;
+    }();
+    return enabled;
+}
+
+// Cold: runs once per slot (re)fill.
+__attribute__((noinline)) void FastDispatchFill(uint32_t target, const RawDispatchRecord* record) noexcept {
+    if (!FastDispatchEnabled()) {
+        return;
+    }
+    uint64_t word;
+    if (mkw_fast_dispatch::Pack(target, record, reinterpret_cast<uintptr_t>(&g_fastDispatch[0]), &word)) {
+        static std::atomic<uint32_t> victim{0};
+        mkw_fast_dispatch::Insert(g_fastDispatch, target, word,
+                                  victim.fetch_add(1, std::memory_order_relaxed));
+    }
+}
+
+// The old InvokeIndirectCpu body (abi_bridge.h), plus the fill. The hit path above it has already
+// failed (or was never eligible), so this decides exactly what the old code decided.
+__attribute__((noinline)) void InvokeIndirectCpuSlow(uint32_t target, CpuContext* ctx) {
+    CpuContext* cpu = ctx ? ctx : &GetPersistentCpuContext();
+    if (target == 0) {
+        ReportMissingCpuTarget(target, cpu);
+    }
+    ApplyRuntimeCallOptions(target, cpu);
+    const RawDispatchRecord* record = TranslatedFunctionRegistry::FindRawByAddressPtr(target);
+    if (record != nullptr && record->entry != nullptr && record->nonvolatileFprWriteMask == 0 &&
+        !record->preserveNonvolatileGprs && TryGetCpuContext() == cpu) {
+        FastDispatchFill(target, record);
+        RecompMod::ScopedTranslatedExecutionAddress translatedExecution(record->address);
+        record->entry(cpu);
+        return;
+    }
+    if (TryDispatchRawCpuTarget(record, cpu) ||
+        TryDispatchResolvedCpuTarget(TranslatedFunctionRegistry::FindByAddressPtr(target), cpu)) return;
+    ReportMissingCpuTarget(target, cpu);
+}
+}  // namespace
+
+void InvokeIndirectCpu(uint32_t target, CpuContext* ctx) {
+    if (__builtin_expect(ctx != nullptr, 1)) {
+        // 0 = not in the table (target 0 included: it goes to the old body).
+        const uint64_t word = mkw_fast_dispatch::Find(g_fastDispatch, target);
+        if (__builtin_expect(word != 0 && TryGetCpuContext() == ctx, 1)) {
+            const auto entry =
+                mkw_fast_dispatch::Unpack(word, reinterpret_cast<uintptr_t>(&g_fastDispatch[0]));
+            NonzeroExecutionAddressScope translatedExecution(target);
+            entry(ctx);
+            return;
+        }
+    }
+    InvokeIndirectCpuSlow(target, ctx);
+}
