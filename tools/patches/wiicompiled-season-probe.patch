diff --git a/runtime/src/hle/mlb/season_probe.cpp b/runtime/src/hle/mlb/season_probe.cpp
new file mode 100644
index 0000000..04a0487
--- /dev/null
+++ b/runtime/src/hle/mlb/season_probe.cpp
@@ -0,0 +1,86 @@
+#include "season_probe.h"
+#include "memory.h"
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+
+namespace season_probe {
+
+void OnHostFrame() {
+#if defined(WIICOMPILED_GAME_RL8E54)
+    static const bool log = std::getenv("WIICOMPILED_SEASON_LOG") != nullptr;
+    static std::optional<int> force = ParseSeasonIndex(std::getenv("WIICOMPILED_SEASON_INDEX"));
+    if (!log && !force) return;
+    const uint32_t state = Memory::Read32(0x8104B5A8u);
+    if (!state || !Memory::Contains(state, 16)) return;
+    if (force) {
+        Memory::Write8(state + 8, static_cast<uint8_t>(*force));
+        std::fprintf(stderr, "[season] forced index=%d year=%d state=0x%08X\n", *force, 2008 + *force, state);
+        force.reset();
+    }
+    static int last = -1000;
+    const int index = static_cast<int8_t>(Memory::Read8(state + 8));
+    if (log && index != last) {
+        std::fprintf(stderr, "[season] index=%d year=%d state=0x%08X\n", index, 2008 + index, state);
+        last = index;
+    }
+    static int lastDay = -1;
+    const int day = Memory::Read16(state + 4);
+    if (log && day != lastDay) {
+        std::fprintf(stderr, "[season] day=%d index=%d\n", day, index);
+        lastDay = day;
+    }
+#endif
+}
+
+static const char* LivePath() {
+    static const char* path = std::getenv("WIICOMPILED_PAD_LIVE");
+    return path && *path ? path : nullptr;
+}
+
+bool LiveEnabled() { return LivePath() != nullptr; }
+
+static void Dump(const std::filesystem::path& base, uint32_t address, uint32_t size, const char* ext) {
+    if (!Memory::Contains(address, size)) return;
+    std::filesystem::path file = base;
+    file += ext;
+    std::ofstream(file, std::ios::binary).write(reinterpret_cast<const char*>(Memory::GetPointer(address, size)), size);
+}
+
+uint32_t LiveButtons() {
+    if (!LiveEnabled()) return 0;
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point holdUntil{};
+    static uint32_t held = 0;
+    const std::filesystem::path file = std::filesystem::u8path(LivePath());
+    std::error_code ec;
+    if (Clock::now() >= holdUntil && std::filesystem::exists(file, ec)) {
+        held = 0;
+        std::stringstream text;
+        text << std::ifstream(file).rdbuf();
+        if (const auto command = ParseLiveCommand(text.str())) {
+            if (command->kind == LiveCommand::Pad) {
+                held = command->buttons;
+                holdUntil = Clock::now() + std::chrono::milliseconds(command->ms);
+            } else if (command->kind == LiveCommand::Poke) {
+                for (size_t i = 0; i < command->bytes.size(); ++i)
+                    Memory::Write8(command->address + static_cast<uint32_t>(i), command->bytes[i]);
+            } else {
+                // Guest RAM in its own big-endian layout, read inside PADRead while the game waits on it.
+                const std::filesystem::path base = file.parent_path() / command->name;
+                Dump(base, 0x80000000u, 0x01800000u, ".mem1");
+                Dump(base, 0x90000000u, 0x08000000u, ".mem2");  // the runtime's MEM2 is 128 MB
+            }
+            std::fprintf(stderr, "[season] live: %s\n", text.str().c_str());
+        } else {
+            std::fprintf(stderr, "[season] live: bad command '%s'\n", text.str().c_str());
+        }
+        std::filesystem::remove(file, ec);
+    }
+    if (Clock::now() >= holdUntil) held = 0;
+    return held;
+}
+
+}  // namespace season_probe
