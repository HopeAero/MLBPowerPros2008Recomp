diff --git a/runtime/include/season_probe.h b/runtime/include/season_probe.h
new file mode 100644
index 0000000..1382572
--- /dev/null
+++ b/runtime/include/season_probe.h
@@ -0,0 +1,24 @@
+#pragma once
+// Season probe: research aid for Season mode past ten seasons. Does nothing without its variables.
+//   WIICOMPILED_SEASON_LOG=1    logs "[season] index=N year=Y state=0xADDR" whenever the season index changes
+//   WIICOMPILED_SEASON_INDEX=N  writes N (0..9) to the season index once, the first time the state exists
+// The year is 2008 + the signed byte at [[0x8104B5A8] + 8] (docs/ingenieria-inversa.md, "Año de la temporada").
+// Plan: docs/superpowers/plans/2026-10-19-season-archive-research.md
+#include <cstdlib>
+#include <cstring>
+#include <optional>
+
+namespace season_probe {
+
+// 0..9, the indices the game's per-year tables have room for; anything else is empty.
+inline std::optional<int> ParseSeasonIndex(const char* text) {
+    if (!text || !*text) return std::nullopt;
+    char* end = nullptr;
+    const long value = std::strtol(text, &end, 10);
+    if (*end != '\0' || value < 0 || value > 9) return std::nullopt;
+    return static_cast<int>(value);
+}
+
+void OnHostFrame();
+
+}  // namespace season_probe
diff --git a/runtime/src/hle/mlb/season_probe.cpp b/runtime/src/hle/mlb/season_probe.cpp
new file mode 100644
index 0000000..0c83b2f
--- /dev/null
+++ b/runtime/src/hle/mlb/season_probe.cpp
@@ -0,0 +1,28 @@
+#include "season_probe.h"
+#include "memory.h"
+#include <cstdio>
+
+namespace season_probe {
+
+void OnHostFrame() {
+#if defined(WIICOMPILED_GAME_RL8E54)
+    static const bool log = std::getenv("WIICOMPILED_SEASON_LOG") != nullptr;
+    static std::optional<int> force = ParseSeasonIndex(std::getenv("WIICOMPILED_SEASON_INDEX"));
+    if (!log && !force) return;
+    const uint32_t state = Memory::Read32(0x8104B5A8u);
+    if (!state || !Memory::Contains(state, 16)) return;
+    if (force) {
+        Memory::Write8(state + 8, static_cast<uint8_t>(*force));
+        std::fprintf(stderr, "[season] forced index=%d year=%d state=0x%08X\n", *force, 2008 + *force, state);
+        force.reset();
+    }
+    static int last = -1000;
+    const int index = static_cast<int8_t>(Memory::Read8(state + 8));
+    if (log && index != last) {
+        std::fprintf(stderr, "[season] index=%d year=%d state=0x%08X\n", index, 2008 + index, state);
+        last = index;
+    }
+#endif
+}
+
+}  // namespace season_probe
