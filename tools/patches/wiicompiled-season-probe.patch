diff --git a/runtime/tests/season_probe_tests.cpp b/runtime/tests/season_probe_tests.cpp
new file mode 100644
index 0000000..a4f51f5
--- /dev/null
+++ b/runtime/tests/season_probe_tests.cpp
@@ -0,0 +1,41 @@
+#include "season_probe.h"
+#include <cstdio>
+
+static int failures = 0;
+static void Check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+int main() {
+    using season_probe::ParseSeasonIndex;
+    Check(ParseSeasonIndex("0") == 0, "0");
+    Check(ParseSeasonIndex("9") == 9, "9");
+    Check(!ParseSeasonIndex("10"), "10 is past the game's table");
+    Check(!ParseSeasonIndex("-1"), "-1");
+    Check(!ParseSeasonIndex("x"), "x");
+    Check(!ParseSeasonIndex("3x"), "3x");
+    Check(!ParseSeasonIndex(""), "empty");
+    Check(!ParseSeasonIndex(nullptr), "null");
+    using season_probe::LiveCommand;
+    using season_probe::ParseLiveCommand;
+    auto pad = ParseLiveCommand("pad 100 150");
+    Check(pad && pad->kind == LiveCommand::Pad && pad->buttons == 0x100 && pad->ms == 150, "pad A for 150 ms");
+    auto stick = ParseLiveCommand("pad 80000 200\n");
+    Check(stick && stick->buttons == 0x80000 && stick->ms == 200, "pad C-stick down, trailing newline");
+    auto dump = ParseLiveCommand("dump day0");
+    Check(dump && dump->kind == LiveCommand::Dump && dump->name == "day0", "dump day0");
+    Check(!ParseLiveCommand("dump ../x"), "dump name with a path is refused");
+    Check(!ParseLiveCommand("dump "), "dump without a name");
+    Check(!ParseLiveCommand("pad zz 10"), "pad with bad buttons");
+    Check(!ParseLiveCommand("jump 1"), "unknown command");
+    auto poke = ParseLiveCommand("poke 90DC4FFC 01210120");
+    Check(poke && poke->kind == LiveCommand::Poke && poke->address == 0x90DC4FFCu && poke->bytes.size() == 4 &&
+              poke->bytes[0] == 0x01 && poke->bytes[3] == 0x20, "poke four bytes");
+    Check(!ParseLiveCommand("poke 90DC4FFC 012"), "poke with an odd number of digits");
+    Check(!ParseLiveCommand("poke 90DC4FFC"), "poke without bytes");
+    if (failures == 0) std::puts("season_probe_tests: OK");
+    return failures != 0;
+}
