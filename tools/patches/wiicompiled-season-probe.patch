diff --git a/runtime/tests/season_probe_tests.cpp b/runtime/tests/season_probe_tests.cpp
new file mode 100644
index 0000000..ff209c0
--- /dev/null
+++ b/runtime/tests/season_probe_tests.cpp
@@ -0,0 +1,24 @@
+#include "season_probe.h"
+#include <cstdio>
+
+static int failures = 0;
+static void Check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+int main() {
+    using season_probe::ParseSeasonIndex;
+    Check(ParseSeasonIndex("0") == 0, "0");
+    Check(ParseSeasonIndex("9") == 9, "9");
+    Check(!ParseSeasonIndex("10"), "10 is past the game's table");
+    Check(!ParseSeasonIndex("-1"), "-1");
+    Check(!ParseSeasonIndex("x"), "x");
+    Check(!ParseSeasonIndex("3x"), "3x");
+    Check(!ParseSeasonIndex(""), "empty");
+    Check(!ParseSeasonIndex(nullptr), "null");
+    if (failures == 0) std::puts("season_probe_tests: OK");
+    return failures != 0;
+}
