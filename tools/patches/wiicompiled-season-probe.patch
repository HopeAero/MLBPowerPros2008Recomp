diff --git a/runtime/include/season_probe.h b/runtime/include/season_probe.h
new file mode 100644
index 0000000..8560836
--- /dev/null
+++ b/runtime/include/season_probe.h
@@ -0,0 +1,81 @@
+#pragma once
+// Season probe: research aid for Season mode past ten seasons. Does nothing without its variables.
+//   WIICOMPILED_SEASON_LOG=1    logs "[season] index=N year=Y state=0xADDR" whenever the season index changes
+//   WIICOMPILED_SEASON_INDEX=N  writes N (0..9) to the season index once, the first time the state exists
+//   WIICOMPILED_PAD_LIVE=FILE   a driver writes one command to FILE; the game reads it at its next pad read
+//                               and deletes FILE when done:
+//                                 "pad HEX MS"  hold pad 0 buttons (PAD_BUTTON_* bits, 0x10000-0x80000 C-stick
+//                                               right/left/up/down as in WIICOMPILED_PAD_SCRIPT) for MS ms
+//                                 "dump NAME"   write MEM1 and MEM2 to NAME.mem1 / NAME.mem2 next to FILE
+//                                 "poke ADDR HEX"  write the bytes HEX (two digits each) from guest ADDR
+// The year is 2008 + the signed byte at [[0x8104B5A8] + 8] (docs/ingenieria-inversa.md, "Año de la temporada").
+// Plan: docs/superpowers/plans/2026-10-19-season-archive-research.md
+#include <cctype>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace season_probe {
+
+// 0..9, the indices the game's per-year tables have room for; anything else is empty.
+inline std::optional<int> ParseSeasonIndex(const char* text) {
+    if (!text || !*text) return std::nullopt;
+    char* end = nullptr;
+    const long value = std::strtol(text, &end, 10);
+    if (*end != '\0' || value < 0 || value > 9) return std::nullopt;
+    return static_cast<int>(value);
+}
+
+struct LiveCommand {
+    enum Kind { Pad, Dump, Poke } kind;
+    uint32_t buttons = 0;
+    uint32_t ms = 0;
+    std::string name;  // Dump: letters, digits, '_' and '-' only, so it stays next to the command file
+    uint32_t address = 0;        // Poke: guest address
+    std::vector<uint8_t> bytes;  // Poke: written in order from address (big-endian as the guest sees them)
+};
+
+inline std::optional<LiveCommand> ParseLiveCommand(std::string_view text) {
+    while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' ')) text.remove_suffix(1);
+    const std::string line(text);
+    if (line.rfind("pad ", 0) == 0) {
+        unsigned buttons = 0, ms = 0;
+        int used = 0;
+        if (std::sscanf(line.c_str() + 4, "%x %u%n", &buttons, &ms, &used) != 2 || line[4 + used] != '\0')
+            return std::nullopt;
+        return LiveCommand{LiveCommand::Pad, buttons, ms, {}};
+    }
+    if (line.rfind("dump ", 0) == 0) {
+        const std::string name = line.substr(5);
+        if (name.empty()) return std::nullopt;
+        for (char c : name)
+            if (!std::isalnum(static_cast<unsigned char>(c)) && c != '_' && c != '-') return std::nullopt;
+        return LiveCommand{LiveCommand::Dump, 0, 0, name};
+    }
+    if (line.rfind("poke ", 0) == 0) {
+        unsigned address = 0;
+        char hex[513] = {};
+        int used = 0;
+        if (std::sscanf(line.c_str() + 5, "%x %512[0-9A-Fa-f]%n", &address, hex, &used) != 2 || line[5 + used] != '\0')
+            return std::nullopt;
+        const std::string digits(hex);
+        if (digits.size() % 2) return std::nullopt;
+        LiveCommand poke{LiveCommand::Poke};
+        poke.address = address;
+        for (size_t i = 0; i < digits.size(); i += 2)
+            poke.bytes.push_back(static_cast<uint8_t>(std::stoul(digits.substr(i, 2), nullptr, 16)));
+        return poke;
+    }
+    return std::nullopt;
+}
+
+void OnHostFrame();
+// Live driver (WIICOMPILED_PAD_LIVE): enabled, and the pad 0 bits it holds right now; runs dump commands.
+bool LiveEnabled();
+uint32_t LiveButtons();
+
+}  // namespace season_probe
