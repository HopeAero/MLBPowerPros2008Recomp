+// PowerUp+ ships next to the game in powerupplus/ (tools/powerupplus.ps1 -Publish). It runs in its
+// MLB Power Pros 2008 mode: the base roster comes from the player's project.bin and 2008 mods are
+// written into the game's mods folder. Its data (database, libraries) lives in the user data folder.
+void OpenRosterEditor() {
+#if defined(_WIN32)
+    namespace fs = std::filesystem;
+    const auto exeDir = RuntimeConfigFile::ExecutableDirectory();
+    if (!exeDir) return;
+    const fs::path app = *exeDir / "powerupplus";
+    const fs::path server = app / "PowerUp.ElectronUI.exe";
+    std::error_code ec;
+    if (!fs::is_regular_file(server, ec)) {
+        RT_LOG(RT_TAG_RUNTIME) << "launcher: PowerUp+ is not installed (" << RuntimeConfigFile::PathToUtf8(server) << ")" << std::endl;
+        return;
+    }
+    const fs::path data = RuntimeConfigFile::ApplicationDataDirectory() / "PowerUpPlus";
+    fs::create_directories(data, ec);
+    fs::copy(app / "Data", data / "Data", fs::copy_options::recursive | fs::copy_options::skip_existing, ec);
+
+    // One server per game session, closed with the game through a job object.
+    static HANDLE job = nullptr;
+    static HANDLE process = nullptr;
+    if (process == nullptr || WaitForSingleObject(process, 0) != WAIT_TIMEOUT) {
+        if (job == nullptr) {
+            job = CreateJobObjectW(nullptr, nullptr);
+            JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits{};
+            limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+            SetInformationJobObject(job, JobObjectExtendedLimitInformation, &limits, sizeof(limits));
+        }
+        std::wstring command = Quoted(server) + L" --urls http://127.0.0.1:5123 --contentRoot " + Quoted(app) +
+                               L" " + Quoted(L"--DataDirectory=" + (data / "Data").wstring()) +
+                               L" " + Quoted(L"--PowerPros2008ProjectBin=" + (RuntimeConfigFile::ResolvedDvdRoot() / "files" / "project.bin").wstring()) +
+                               L" " + Quoted(L"--PowerPros2008ModsDirectory=" + mods::Directory().wstring());
+        // The server starts inside the job instead of suspended and assigned afterwards: antivirus
+        // behaviour rules flag CREATE_SUSPENDED + ResumeThread. 0x0002000D is
+        // PROC_THREAD_ATTRIBUTE_JOB_LIST, which mingw hides below _WIN32_WINNT 0x0A00.
+        constexpr DWORD_PTR kJobListAttribute = 0x0002000D;
+        SIZE_T attributeSize = 0;
+        InitializeProcThreadAttributeList(nullptr, 1, 0, &attributeSize);
+        std::vector<char> attributes(attributeSize);
+        STARTUPINFOEXW startup{};
+        startup.StartupInfo.cb = sizeof(startup);
+        startup.lpAttributeList = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attributes.data());
+        InitializeProcThreadAttributeList(startup.lpAttributeList, 1, 0, &attributeSize);
+        if (job != nullptr) {
+            UpdateProcThreadAttribute(startup.lpAttributeList, 0, kJobListAttribute, &job, sizeof(job), nullptr, nullptr);
+        }
+        PROCESS_INFORMATION info{};
+        const bool started = CreateProcessW(nullptr, command.data(), nullptr, nullptr, FALSE,
+                                            CREATE_NO_WINDOW | EXTENDED_STARTUPINFO_PRESENT, nullptr,
+                                            data.wstring().c_str(), &startup.StartupInfo, &info);
+        const DWORD error = started ? 0 : GetLastError();
+        DeleteProcThreadAttributeList(startup.lpAttributeList);
+        if (!started) {
+            RT_LOG(RT_TAG_RUNTIME) << "launcher: cannot start PowerUp+ (error " << error << ")" << std::endl;
+            return;
+        }
+        CloseHandle(info.hThread);
+        if (process != nullptr) CloseHandle(process);
+        process = info.hProcess;
+    }
+    const fs::path page = data / "abrir.html";
+    std::ofstream(page, std::ios::binary | std::ios::trunc) << kRosterEditorPage;
+    ShellExecuteW(nullptr, L"open", page.wstring().c_str(), nullptr, nullptr, SW_SHOWNORMAL);
+#endif
+}
