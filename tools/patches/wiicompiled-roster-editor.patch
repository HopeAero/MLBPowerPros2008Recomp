+// A small, softened copy of an image: averaged down 24x, then box-blurred. Drawn stretched over the
+// window, the GPU's filtering turns it into a smooth blur.
+ImTextureID BlurredTexture(const std::vector<unsigned char>& pixels, int w, int h) {
+    constexpr int kDown = 24;
+    const int sw = std::max(1, w / kDown);
+    const int sh = std::max(1, h / kDown);
+    std::vector<float> small(static_cast<size_t>(sw) * sh * 4, 0.0f);
+    for (int y = 0; y < sh * kDown && y < h; ++y) {
+        for (int x = 0; x < sw * kDown && x < w; ++x) {
+            const unsigned char* p = pixels.data() + (static_cast<size_t>(y) * w + x) * 4;
+            float* d = small.data() + (static_cast<size_t>(y / kDown) * sw + x / kDown) * 4;
+            for (int c = 0; c < 4; ++c) d[c] += p[c];
+        }
+    }
+    for (float& v : small) v /= static_cast<float>(kDown * kDown);
+    for (int pass = 0; pass < 2; ++pass) {  // 3x3 box blur, twice
+        std::vector<float> out(small.size());
+        for (int y = 0; y < sh; ++y) {
+            for (int x = 0; x < sw; ++x) {
+                float sum[4] = {};
+                int n = 0;
+                for (int dy = -1; dy <= 1; ++dy) {
+                    for (int dx = -1; dx <= 1; ++dx) {
+                        const int xx = std::clamp(x + dx, 0, sw - 1);
+                        const int yy = std::clamp(y + dy, 0, sh - 1);
+                        const float* q = small.data() + (static_cast<size_t>(yy) * sw + xx) * 4;
+                        for (int c = 0; c < 4; ++c) sum[c] += q[c];
+                        ++n;
+                    }
+                }
+                for (int c = 0; c < 4; ++c) out[(static_cast<size_t>(y) * sw + x) * 4 + c] = sum[c] / static_cast<float>(n);
+            }
+        }
+        small.swap(out);
+    }
+    std::vector<unsigned char> bytes(small.size());
+    for (size_t i = 0; i < small.size(); ++i) bytes[i] = static_cast<unsigned char>(std::clamp(small[i], 0.0f, 255.0f));
+    return aurora_imgui_add_texture(static_cast<uint32_t>(sw), static_cast<uint32_t>(sh), bytes.data());
+}
