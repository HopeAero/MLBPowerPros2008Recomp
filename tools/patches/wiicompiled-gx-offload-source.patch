+  ~HleProducerScope() {
+#if defined(__SWITCH__)
+    if (GX_HLE_OffloadLeave != nullptr) GX_HLE_OffloadLeave();
+#endif
+  }
+  HleProducerScope(const HleProducerScope&) = delete;
+  HleProducerScope& operator=(const HleProducerScope&) = delete;
+};
