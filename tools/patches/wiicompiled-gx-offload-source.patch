+extern "C" void GXLoadLightObjImmBE(const void*, GXLightID);
+extern "C" void GXLoadNrmMtxImmBE(const void*, u32, u32);
+extern "C" void GXSetVtxDescRun(const GXVtxDescList*, u32);
+extern "C" void GXSetVtxAttrFmtRun(GXVtxFmt, const GXVtxAttrFmtList*, u32);
+extern "C" void GXCallDisplayListRef(const void*, u32);
+
+namespace hle::gx::offload {
+
+extern GxOffloadQueue::Queue queue;
+void Initialize();
+void Fence();
+void EnterSynchronous();
+void LeaveSynchronous() noexcept;
+bool Synchronous() noexcept;
+bool Intercept() noexcept;
+void SetVtxDescShadow(GXAttr attr, GXAttrType type) noexcept;
+void ClearVtxDescShadow() noexcept;
+void GetVtxDesc(GXAttr attr, GXAttrType* type);
+void GetVtxDescv(GXVtxDescList* list);
+void GetVcdState(uint32_t* lo, uint32_t* hi, uint32_t* flags);
+
+struct SynchronousScope {
+    SynchronousScope() { EnterSynchronous(); }
+    ~SynchronousScope() { LeaveSynchronous(); }
+    SynchronousScope(const SynchronousScope&) = delete;
+    SynchronousScope& operator=(const SynchronousScope&) = delete;
+};
+
+// These functions operate on producer-owned host objects, never on __gx or FIFO.
+template <auto Function> inline constexpr bool LocalObjectOperation = false;
+#define GX_LOCAL_OBJECT_OPERATION(name) \
+    template <> inline constexpr bool LocalObjectOperation<&::name> = true
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObj);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjCI);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjLOD);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjWrapMode);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjFilter);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjLODBias);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjUserData);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjTlut);
+GX_LOCAL_OBJECT_OPERATION(GXInitTexObjData);
+GX_LOCAL_OBJECT_OPERATION(GXGetTexBufferSize);
+#undef GX_LOCAL_OBJECT_OPERATION
+
+template <auto Function> inline constexpr bool AsyncOperation = false;
+#include "gx_offload_async.inc"
+
+template <auto Function> struct BeforeScalar {
+    template <typename... Args> static void Apply(Args...) noexcept {}
+};
+template <> struct BeforeScalar<&::GXSetVtxDesc> {
+    static void Apply(GXAttr attr, GXAttrType type) noexcept { SetVtxDescShadow(attr, type); }
+};
+template <> struct BeforeScalar<&::GXClearVtxDesc> {
+    static void Apply() noexcept { ClearVtxDescShadow(); }
+};
+
+template <typename Value> uint64_t PackValue(const Value& value) noexcept {
+    static_assert(std::is_trivially_copyable_v<Value> && sizeof(Value) <= sizeof(uint64_t));
+    uint64_t word = 0;
+    std::memcpy(&word, &value, sizeof(Value));
+    return word;
+}
+template <typename Value> Value UnpackValue(uint64_t word) noexcept {
+    Value value{};
+    std::memcpy(&value, &word, sizeof(Value));
+    return value;
+}
+
+template <auto Function, typename... Args> struct ScalarCommand {
+    uint64_t words[sizeof...(Args) + 1]{};
+    template <size_t... Index> void Run(std::index_sequence<Index...>) const {
+        Function(UnpackValue<Args>(words[Index])...);
+    }
+    static void Execute(const void* bytes) {
+        ScalarCommand command;
+        std::memcpy(&command, bytes, sizeof(command));
+        command.Run(std::index_sequence_for<Args...>{});
+    }
+};
+
+template <auto Policy> struct Dispatch {
+    template <auto Function = Policy, typename... Args> static decltype(auto) Invoke(Args... args) {
+        using Result = std::invoke_result_t<decltype(Function), Args...>;
+        if (!Intercept() || Synchronous()) return Function(args...);
+        if constexpr (LocalObjectOperation<Policy>) {
+            return Function(args...);
+        } else if constexpr (AsyncOperation<Policy> && std::is_void_v<Result> &&
+                             ((!std::is_pointer_v<Args> && std::is_trivially_copyable_v<Args> &&
+                               sizeof(Args) <= sizeof(uint64_t)) && ...)) {
+            using Command = ScalarCommand<Function, Args...>;
+            Command command{{PackValue(args)...}};
+            queue.Submit(&Command::Execute, command);
+            // A full-queue wait may run a nested guest callback before this record is published.
+            BeforeScalar<Policy>::Apply(args...);
+        } else {
+            // Borrowed pointers and result-bearing calls retain their original observation point.
+            SynchronousScope scope;
+            return Function(args...);
+        }
+    }
+};
+
+template <> struct Dispatch<&::GXGetVtxDesc> {
+    template <auto Function = &::GXGetVtxDesc> static void Invoke(GXAttr attr, GXAttrType* type) {
+        if (!Intercept() || Synchronous()) return Function(attr, type);
+        GetVtxDesc(attr, type);
+    }
+};
+template <> struct Dispatch<&::GXGetVtxDescv> {
+    template <auto Function = &::GXGetVtxDescv> static void Invoke(GXVtxDescList* list) {
+        if (!Intercept() || Synchronous()) return Function(list);
+        GetVtxDescv(list);
+    }
+};
+
+template <auto Function, typename... Args> decltype(auto) Call(Args... args) {
+    return Dispatch<Function>::Invoke(args...);
+}
+template <auto Policy, auto Function, typename... Args> decltype(auto) CallReal(Args... args) {
+    return Dispatch<Policy>::template Invoke<Function>(args...);
+}
+
+#include "gx_offload_snapshots.h"
+#include "gx_offload_array.h"
+#include "gx_offload_nrm_snapshot.h"
+#include "gx_offload_run_snapshots.h"
+#include "gx_offload_display_list.h"
+
+} // namespace hle::gx::offload
+
+// Paired scopes also fence renderer/VI entry points outside the HLE bridge.
+extern "C" void GX_HLE_OffloadEnter() noexcept;
+extern "C" void GX_HLE_OffloadLeave() noexcept;
+extern "C" void GX_HLE_OffloadStop();
diff --git a/runtime/src/hle/gx/gx_offload_array.h b/runtime/src/hle/gx/gx_offload_array.h
new file mode 100644
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_array.h
@@ -0,0 +1,28 @@
+#pragma once
+
+// GXSetArray emits an address and layout; Aurora reads vertex bytes later in FIFO order.
+namespace array_detail {
+using FunctionType = void (*)(GXAttr, const void*, u32, u8, bool);
+struct Command {
+    GXAttr attr;
+    const void* data;
+    u32 size;
+    u8 stride;
+    bool le;
+};
+static_assert(sizeof(Command) <= GxOffloadQueue::kMaxPayloadBytes);
+
+template <auto Function> void Run(const void* bytes) {
+    Command command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.attr, command.data, command.size, command.stride, command.le);
+}
+} // namespace array_detail
+
+template <> struct Dispatch<static_cast<array_detail::FunctionType>(&::GXSetArray)> {
+    template <auto Function> static void Invoke(GXAttr attr, const void* data, u32 size, u8 stride, bool le) {
+        if (!Intercept() || Synchronous()) return Function(attr, data, size, stride, le);
+        const array_detail::Command command{attr, data, size, stride, le};
+        queue.Submit(&array_detail::Run<Function>, command);
+    }
+};
diff --git a/runtime/src/hle/gx/gx_offload_display_list.h b/runtime/src/hle/gx/gx_offload_display_list.h
new file mode 100644
--- /dev/null
+++ b/runtime/src/hle/gx/gx_offload_display_list.h
@@ -0,0 +1,47 @@
+#pragma once
+
+template <auto Function> struct DisplayListCommand {
+    u32 nbytes;
+    uint8_t bytes[GxOffloadQueue::kMaxPayloadBytes - sizeof(u32)];
+    static void Execute(const void* payload) {
+        const auto& command = *static_cast<const DisplayListCommand*>(payload);
+        Function(command.bytes, command.nbytes);
+    }
+};
+
+template <> struct Dispatch<&::GXCallDisplayList> {
+    template <auto Function = &::GXCallDisplayList>
+    static void Invoke(const void* list, u32 nbytes) {
+        if (!Intercept() || Synchronous()) return Function(list, nbytes);
+        if (list == nullptr || nbytes == 0 ||
+            nbytes > GxOffloadQueue::kMaxPayloadBytes - sizeof(u32)) {
+            SynchronousScope scope;
+            return Function(list, nbytes);
+        }
+        using Command = DisplayListCommand<Function>;
+        static_assert(sizeof(Command) == GxOffloadQueue::kMaxPayloadBytes);
+        Command command;
+        command.nbytes = nbytes;
+        std::memcpy(command.bytes, list, nbytes);
+        queue.Submit(&Command::Execute, &command, sizeof(u32) + nbytes);
+    }
+};
+
+template <auto Function> struct DisplayListRefCommand {
+    const void* list;
+    u32 nbytes;
+    static void Execute(const void* bytes) {
+        const auto& command = *static_cast<const DisplayListRefCommand*>(bytes);
+        Function(command.list, command.nbytes);
+    }
+};
+
+template <> struct Dispatch<&::GXCallDisplayListRef> {
+    template <auto Function = &::GXCallDisplayListRef>
+    static void Invoke(const void* list, u32 nbytes) {
+        if (!Intercept() || Synchronous()) return Function(list, nbytes);
+        // G6 keeps reference streams alive until the completed end-of-frame drain.
+        using Command = DisplayListRefCommand<Function>;
+        queue.Submit(&Command::Execute, Command{list, nbytes});
+    }
+};
