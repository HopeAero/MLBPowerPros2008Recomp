@@ -0,0 +1,81 @@
+#pragma once
+
+// Included by gx_offload.h inside hle::gx::offload, after CallReal is declared.
+// Queue only the host-side FIFO emitters below; their guest-visible reads are copied first.
+
+namespace snapshot_detail {
+
+struct PosMtxImmBE {
+    u32 id;
+    unsigned char words[48];
+};
+
+struct LightObjImmBE {
+    GXLightID id;
+    alignas(u32) unsigned char words[52];
+};
+
+struct TexMtxImm {
+    u32 id;
+    GXTexMtxType type;
+    f32 matrix[3][4];
+};
+
+static_assert(sizeof(PosMtxImmBE) <= GxOffloadQueue::kMaxPayloadBytes);
+static_assert(sizeof(LightObjImmBE) <= GxOffloadQueue::kMaxPayloadBytes);
+static_assert(sizeof(TexMtxImm) <= GxOffloadQueue::kMaxPayloadBytes);
+
+template <auto Function> void RunPosMtxImmBE(const void* bytes) {
+    PosMtxImmBE command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.words, command.id);
+}
+
+template <auto Function> void RunLightObjImmBE(const void* bytes) {
+    LightObjImmBE command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.words, command.id);
+}
+
+template <auto Function> void RunTexMtxImm(const void* bytes) {
+    TexMtxImm command;
+    std::memcpy(&command, bytes, sizeof(command));
+    Function(command.matrix, command.id, command.type);
+}
+
+} // namespace snapshot_detail
+
+template <> struct Dispatch<&::GXLoadPosMtxImmBE> {
+    template <auto Function = &::GXLoadPosMtxImmBE>
+    static void Invoke(const void* matrix, u32 id) {
+        if (!Intercept() || Synchronous()) return Function(matrix, id);
+        snapshot_detail::PosMtxImmBE command{};
+        command.id = id;
+        std::memcpy(command.words, matrix, sizeof(command.words));
+        queue.Submit(&snapshot_detail::RunPosMtxImmBE<Function>, command);
+    }
+};
+
+template <> struct Dispatch<&::GXLoadLightObjImmBE> {
+    template <auto Function = &::GXLoadLightObjImmBE>
+    static void Invoke(const void* light, GXLightID id) {
+        if (!Intercept() || Synchronous()) return Function(light, id);
+        snapshot_detail::LightObjImmBE command{};
+        command.id = id;
+        std::memcpy(command.words, light, sizeof(command.words));
+        queue.Submit(&snapshot_detail::RunLightObjImmBE<Function>, command);
+    }
+};
+
+template <> struct Dispatch<&::GXLoadTexMtxImm> {
+    template <auto Function = &::GXLoadTexMtxImm, typename Matrix>
+    static void Invoke(Matrix matrix, u32 id, GXTexMtxType type) {
+        if (!Intercept() || Synchronous()) return Function(matrix, id, type);
+        snapshot_detail::TexMtxImm command{};
+        command.id = id;
+        command.type = type;
+        const size_t bytes = (type == GX_MTX2x4 ? 8 : 12) * sizeof(u32);
+        std::memcpy(command.matrix, matrix, bytes);
+        queue.Submit(&snapshot_detail::RunTexMtxImm<Function>, command);
+    }
+};
