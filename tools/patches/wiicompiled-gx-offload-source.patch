@@ -0,0 +1,150 @@
+#pragma once
+
+#include "gx_offload_queue.h"
+
+#include <dolphin/gx/GXStruct.h>
+#include <dolphin/gx/GXGeometry.h>
+#include <dolphin/gx/GXGet.h>
+#include <dolphin/gx/GXTexture.h>
+#include <dolphin/gx.h>
+
+#include <cstring>
+#include <type_traits>
+#include <utility>
+
