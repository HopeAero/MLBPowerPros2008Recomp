+// 0x806DEFAC(char): the game fills the character's texture / palette slots from its uniform
+// descriptor (char+0x1BC0). After it, overwrite body / cap / helmet / chest if the descriptor's
+// manager idx has a chosen imported uniform. Hooked here, not at 0x806DC9E8(char, desc): that one
+// only stores the descriptor and, while the character is not ready (+0x1BD5 == 0), marks it pending
+// (+0x1BC6 = 1); the slots are filled later, by this function, from another path (0x806BF728,
+// 0x806BFA18, 0x806DCFB4), which overwrote anything written right after 0x806DC9E8 (seen in game:
+// Original Team showed the game uniform after OK although the apply had run).
+extern "C" void MLB_ArrangeUniformFillSlots_806DEFAC(CpuContext* ctx) {
+    const uint32_t ch = ctx->gpr[3];
+    func_806DEFAC(ctx);
+    if (!Enabled() || ch < 0x80000000u || !Memory::Contains(ch, 0x1BC4)) return;
+    const uint32_t desc = Memory::Read32(ch + 0x1BC0);
+    const int idx = IdxOfDescriptor(desc);
+    if (g_trace)
+        std::fprintf(stderr, "[arrange-uniform] 806DEFAC char=%08x desc=%08x mgr=%08x idx=%d\n", ch, desc, Manager(),
+                     idx);
+    if (idx < 0) return;
+    g_idxBuilt[size_t(idx)] = {};  // this idx's number layout, if any, is set again below
+    const std::string& folder = g_idxFolder[size_t(idx)];
+    if (folder.empty()) return;
+    Built b;
+    const bool ok = LoadUniform(folder, b);
+    if (g_trace)
+        std::fprintf(stderr, "[arrange-uniform] 806DEFAC char=%08x idx=%d folder='%s' ok=%d\n", ch, idx, folder.c_str(),
+                     ok ? 1 : 0);
+    if (ok) ApplyUniform(ch, b);
+    g_idxBuilt[size_t(idx)] = ok ? b : Built{};
+    // The chest number: the game takes its position from the uniform's number style (desc+0x3C ->
+    // 0x80D73A1C -> number info char+0x44 +0xB4: -1 none, 0..7 a position), just set by the original.
+    if (ok && b.layout && b.chest != 0) Memory::Write32(ch + 0x44 + 0xB4, b.chest == 1 ? 0xFFFFFFFFu : uint32_t(b.chest - 2));
+}
+REGISTER_NATIVE_FUNCTION_AS(0x806DEFAC, MLB_ArrangeUniformFillSlots_806DEFAC, "MLB_ArrangeUniformFillSlots_806DEFAC");
