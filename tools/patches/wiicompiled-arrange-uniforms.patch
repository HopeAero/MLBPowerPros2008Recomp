new file mode 100644
index 0000000..b0c91de
--- /dev/null
+++ b/runtime/src/hle/mlb/arrange_uniforms.cpp
@@ -0,0 +1,1070 @@
+// Imported uniforms for Arrange teams ([arrange] custom_uniforms): a team that chose an imported
+// uniform (a .ppu baked by Uniform Studio, in UserData/arrange/uniforms/<folder>) wears it natively
+// wherever the game draws that team. Addresses and evidence: docs/ingenieria-inversa.md ("Uniforme
+// importado: ganchos verificados G1-G4") and local/analysis/arrange/uniform/{re.md,spike/spike.md}.
+//
+// Design (verified in-game by Task 1):
+// - The character composes its body per character at 0x806CC2EC from its own slots: body texture
+//   char+0x8C, body palette char+0x9C; cap char+0x11C/+0x14C, helmet char+0x12C/+0x15C, chest
+//   char+0x10C/+0x13C; back number char+0xAC/+0xBC/+0xCC/+0xDC. 0x806DC9E8(char, desc) stores a
+//   uniform descriptor at char+0x1BC0 and 0x806DEFAC(char) fills those slots from it (at once, or
+//   later when the character was not ready). We hook 0x806DEFAC: after the original, if the descriptor is an Arrange uniform descriptor (manager [0x81033438],
+//   gestor+0x2908+idx*0x44) whose idx has a chosen uniform, we overwrite the body / cap / helmet /
+//   chest slots with our own texture+palette objects, and leave the number slots untouched (G4).
+//   The body MUST be done there, not at 0x806BDC3C: desc+0x04 is a pack id resolved by
+//   fn_8000C330(0x6A1, id); only the resolved pointer char+0x8C+0xC can point at our texels.
+// - Per-character isolation (G1): we only write the character's own slots, never the global body
+//   atlas (0x977A2720) or the global cap/chest letter structs (0x974A2F80 / 0x974B3C20), which are
+//   shared by every team (R2: confirmed global in Task 1).
+// - The initial's red letter is removed because our cap / chest textures replace those slots (an
+//   opaque texture with the cap colour baked in by Uniform Studio, so no dark box: G2).
+// - idx -> (slot, side) -> folder: when the game fills a manager idx from a record we learn which
+//   folder (home or away) that idx should wear. Editor / Original Team: 0x805A83F0(record) fills
+//   idx 0 (home) and 1 (away). Match / Exhibition: 0x806C10FC(idx, bytes, initial) with bytes at
+//   record+0x1C (home) or +0x26 (away). The map is cleared when the manager is (re)loaded or
+//   destroyed (0x806BD974 / 0x806BD8D0).
+// - Textures live in a MEM2 arena reserved at boot (ReserveGuestMemory, chained after the marks
+//   arena in game_heaps.cpp); a small LRU cache holds the uniforms being shown (R1: arena lifetime,
+//   recycled, nothing leaks). With the option off nothing is reserved and every hook calls the
+//   original unchanged.
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "abi_bridge.h"
+#include "arrange_marks_save.h"
+#include "arrange_uniforms.h"
+#include "gx_guest_write.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+
+// choiceFor and Enabled live in arrange_marks.cpp (the shared save/choice state).
+namespace arrange_marks {
+const Choice& choiceFor(uint32_t teamRecordAddress);
+}
+
+#define ORIGINAL(address) extern "C" void func_##address(CpuContext*)
+ORIGINAL(806DEFAC);
+ORIGINAL(806CD258);  // draws the shirt number over the composed body
+ORIGINAL(805A83F0);
+ORIGINAL(806C10FC);
+ORIGINAL(806BD974);
+ORIGINAL(806BD8D0);
+ORIGINAL(805CA37C);  // Uniform screen build (vt +0x30)
+ORIGINAL(805C8CE8);  // LINE TYPE window build (vt +0x60)
+ORIGINAL(805C8F28);  // LINE TYPE window refresh
+ORIGINAL(805CACC8);  // Uniform screen: open a row's window
+ORIGINAL(805CB0BC);  // Uniform screen: cursor moved in the window
+ORIGINAL(805CAF4C);  // Uniform screen: A in the window
+ORIGINAL(805CB064);  // Uniform screen: B in the window
+ORIGINAL(805CB1F4);  // Uniform screen confirm / OK (vt +0xDC)
+ORIGINAL(805CC0F8);  // Uniform screen open / reload from the slot
+ORIGINAL(805C9EF4);  // Uniform screen destructor (vt +0x08)
+#undef ORIGINAL
+
+namespace arrange_uniforms {
+namespace {
+namespace fs = std::filesystem;
+using arrange_marks::Choice;
+
+// --- Guest game data ----------------------------------------------------------------------------
+constexpr uint32_t kManagerPtr = 0x81033438;  // [.] = uniform manager (gestor)
+constexpr uint32_t kDescOffset = 0x2908, kDescStride = 0x44, kMaxIdx = 64;
+constexpr uint32_t kSlotBlock = 0x8104E1D8, kSlotsOffset = 0x3AC, kSlotStride = 0x2448, kRecord = 0x42;
+constexpr uint32_t kMatchSlot = 0x8102D730, kEditingSlot = 0x8102B2C8;
+const bool g_trace = std::getenv("WIICOMPILED_ARRANGE_TRACE") != nullptr;
+// Character slots {type, pack, id/v, resolved@+0xC}; textures are drawn through the resolved pointer
+// (+0xC), palettes through the whole palette-object pointer (+0xC).
+constexpr uint32_t kChBodyTex = 0x8C, kChBodyPal = 0x9C, kChCapTex = 0x11C, kChCapPal = 0x14C,
+                   kChHelmetTex = 0x12C, kChHelmetPal = 0x15C, kChChestTex = 0x10C, kChChestPal = 0x13C;
+// Back number: two digit textures and their palettes. Left intact (G4) unless the .ppu has a number.
+constexpr uint32_t kChNumTex0 = 0xAC, kChNumTex1 = 0xBC, kChNumPal0 = 0xCC, kChNumPal1 = 0xDC;
+constexpr uint32_t kSlotResolved = 0xC;
+
+// --- Cache arena --------------------------------------------------------------------------------
+// A head with one transparent 64x32 decal (shared, to blank the chest initial), then kCacheSlots
+// entries. Each entry: body (128x128) then cap, helmet, number (64x32 each); each part is texels +
+// palette (256 x RGB5A3) + a texture descriptor (0x40) + a palette object (0x20), the game's own.
+constexpr uint32_t kBodyPixels = 128 * 128, kDecalPixels = 64 * 32, kPaletteBytes = 512;
+constexpr uint32_t kTexDescBytes = 0x40, kPalObjBytes = 0x20;
+constexpr uint32_t kBodyTexels = 0;
+constexpr uint32_t kBodyPalette = kBodyTexels + kBodyPixels;            // 0x4000
+constexpr uint32_t kBodyTexDesc = kBodyPalette + kPaletteBytes;         // 0x4200
+constexpr uint32_t kBodyPalObj = kBodyTexDesc + kTexDescBytes;          // 0x4240
+constexpr uint32_t kDecal0 = kBodyPalObj + kPalObjBytes;                // 0x4260
+constexpr uint32_t kDecalStride = kDecalPixels + kPaletteBytes + kTexDescBytes + kPalObjBytes;  // 0xA60
+constexpr uint32_t kEntryBytes = (kDecal0 + 3 * kDecalStride + 0x1Fu) & ~0x1Fu;  // body + cap/helmet/number
+// The transparent decal, then a scratch for one font string (the LINE TYPE window's names).
+constexpr uint32_t kRowLabelBytes = 0x40;
+// Then the LINE TYPE window's pictures: three 64x64 thumbnails (one per cell, each texels + palette +
+// texture descriptor + palette object, the game's formats) and one SURF of our own for them (header
+// 0x24, up to kSurfMaxQuads quads, texture list {n, ptr} + entries, palette list {n, ptr} + entries;
+// lists = the game's entries then our three).
+constexpr uint32_t kThumbPixels = 64 * 64;
+constexpr uint32_t kThumb0 = (kDecalStride + kRowLabelBytes + 0x1Fu) & ~0x1Fu;
+constexpr uint32_t kThumbStride = (kThumbPixels + kPaletteBytes + kTexDescBytes + kPalObjBytes + 0x1Fu) & ~0x1Fu;
+constexpr uint32_t kThumbSurf = kThumb0 + 3 * kThumbStride;
+constexpr uint32_t kSurfMaxQuads = 8, kSurfMaxEntries = 8;
+constexpr uint32_t kSurfQuads = 0x24, kSurfTexList = kSurfQuads + kSurfMaxQuads * 0x1C, kSurfTexEntries = kSurfTexList + 8,
+                   kSurfPalList = kSurfTexEntries + kSurfMaxEntries * 4, kSurfPalEntries = kSurfPalList + 8,
+                   kSurfBytes = kSurfPalEntries + kSurfMaxEntries * 4;
+constexpr uint32_t kHeadBytes = (kThumbSurf + kSurfBytes + 0x1Fu) & ~0x1Fu;
+constexpr uint32_t kCacheSlots = 8;
+constexpr uint32_t kArenaBytes = kHeadBytes + kCacheSlots * kEntryBytes;
+
+uint32_t g_arena = 0;
+bool Enabled() { return g_arena != 0; }
+uint32_t EntryAddress(int slot) { return g_arena + kHeadBytes + uint32_t(slot) * kEntryBytes; }
+
+struct Part {
+    uint32_t texels, palette, texDesc, palObj, pixels;
+};
+// kind: 0 body, 1 cap, 2 helmet, 3 number.
+Part PartOf(uint32_t base, int kind) {
+    if (kind == 0) return {base + kBodyTexels, base + kBodyPalette, base + kBodyTexDesc, base + kBodyPalObj, kBodyPixels};
+    const uint32_t d = base + kDecal0 + uint32_t(kind - 1) * kDecalStride;
+    return {d, d + kDecalPixels, d + kDecalPixels + kPaletteBytes,
+            d + kDecalPixels + kPaletteBytes + kTexDescBytes, kDecalPixels};
+}
+// The shared transparent decal (head of the arena): a 64x32 all-index-0 texture with an all-zero
+// palette (entry 0 = 0x0000, fully transparent). Its descriptors stay fixed; built once at boot.
+Part TransparentDecal() {
+    const uint32_t d = g_arena;
+    return {d, d + kDecalPixels, d + kDecalPixels + kPaletteBytes,
+            d + kDecalPixels + kPaletteBytes + kTexDescBytes, kDecalPixels};
+}
+
+// The texture + its two descriptors into guest memory (the game's C8 format; same as marks).
+void PutTexture(const Part& p, uint16_t w, uint16_t h, const uint8_t* indices, const uint8_t* palette512) {
+    std::memcpy(Memory::GetPointer(p.texels, size_t(w) * h), indices, size_t(w) * h);
+    std::memcpy(Memory::GetPointer(p.palette, kPaletteBytes), palette512, kPaletteBytes);  // already big-endian
+    const uint32_t tex[16] = {uint32_t(h) << 16 | w, 9, p.texels, 0, 0, 1, 1};
+    for (uint32_t i = 0; i < 16; ++i) Memory::Write32(p.texDesc + i * 4, tex[i]);
+    const uint32_t pal[8] = {256u << 16, 2, p.palette};
+    for (uint32_t i = 0; i < 8; ++i) Memory::Write32(p.palObj + i * 4, pal[i]);
+}
+
+// --- Uniform cache ------------------------------------------------------------------------------
+struct Built {
+    // Per kind (body, cap, helmet, chest): texture-descriptor and palette-object addresses, 0 if the
+    // .ppu has no atlas for that kind (that slot is then left as the game set it).
+    uint32_t texDesc[4] = {}, palObj[4] = {};
+    bool valid = false;
+    // The number layout chosen in Uniform Studio (.ppu v2, flags bit 1), see arrange_uniforms.h Uniform.
+    bool layout = false;
+    uint8_t chest = 0, backSize = 100;
+    int8_t chestDx = 0, chestDy = 0, backDx = 0, backDy = 0;
+};
+struct Cached {
+    Built built;
+    fs::file_time_type time{};
+    uintmax_t size = 0;
+    uint64_t used = 0;
+    int slot = -1;
+    bool failed = false;
+    std::chrono::steady_clock::time_point checked{};
+};
+std::map<std::string, Cached> g_cache;           // folder -> cached build
+std::array<std::string, kCacheSlots> g_owner;    // arena slot -> folder
+uint64_t g_clock = 0;
+
+fs::path UniformsRoot() { return RuntimeConfigFile::ApplicationDataDirectory() / "arrange" / "uniforms"; }
+
+int FreeSlot() {
+    for (uint32_t i = 0; i < kCacheSlots; ++i)
+        if (g_owner[i].empty()) return int(i);
+    int oldest = 0;
+    uint64_t when = UINT64_MAX;
+    for (const auto& [folder, c] : g_cache)
+        if (c.slot >= 0 && c.used < when) { when = c.used; oldest = c.slot; }
+    g_cache[g_owner[size_t(oldest)]].slot = -1;
+    g_owner[size_t(oldest)].clear();
+    return oldest;
+}
+
+// Build (or reuse) the guest objects for a folder's uniform; false if missing/invalid (fallback).
+bool LoadUniform(const std::string& folder, Built& out) {
+    out = {};
+    if (!Enabled() || folder.empty()) return false;
+    const auto now = std::chrono::steady_clock::now();
+    const fs::path ppu = UniformsRoot() / folder / "uniform.ppu";
+    std::error_code ec;
+    const bool exists = fs::is_regular_file(ppu, ec) && !ec;
+    fs::file_time_type time = exists ? fs::last_write_time(ppu, ec) : fs::file_time_type{};
+    uintmax_t size = exists ? fs::file_size(ppu, ec) : 0;
+
+    Cached& c = g_cache[folder];
+    const bool fresh = exists && c.time == time && c.size == size;
+    if (fresh && c.slot >= 0 && g_owner[size_t(c.slot)] == folder) {
+        c.used = ++g_clock;
+        out = c.built;
+        return out.valid;
+    }
+    if (fresh && c.failed) return false;
+    if (!exists) {
+        if (!c.failed) std::fprintf(stderr, "[arrange] uniform '%s' not found: the game uniform is shown\n", folder.c_str());
+        c = {}; c.failed = true; c.time = time; c.size = size;
+        return false;
+    }
+
+    std::vector<uint8_t> bytes;
+    {
+        std::ifstream f(ppu, std::ios::binary);
+        if (f) bytes.assign(std::istreambuf_iterator<char>(f), {});
+    }
+    Uniform u;
+    const ReadStatus st = readPpu(bytes.data(), bytes.size(), u);
+    if (st != ReadStatus::Valid) {
+        std::fprintf(stderr, "[arrange] uniform '%s' not used (%s): the game uniform is shown\n", folder.c_str(),
+                     st == ReadStatus::Missing ? "empty" : "invalid");
+        if (c.slot >= 0 && g_owner[size_t(c.slot)] == folder) g_owner[size_t(c.slot)].clear();
+        c = {}; c.failed = true; c.time = time; c.size = size; c.slot = -1;
+        return false;
+    }
+
+    const int slot = (c.slot >= 0 && g_owner[size_t(c.slot)] == folder) ? c.slot : FreeSlot();
+    const uint32_t base = EntryAddress(slot);
+    static constexpr const char* kKinds[4] = {"body", "cap", "helmet", "number"};
+    Built built;
+    for (int kind = 0; kind < 4; ++kind) {
+        const auto it = u.atlases.find(kKinds[kind]);
+        if (it == u.atlases.end()) continue;
+        const Atlas& a = it->second;
+        const Part p = PartOf(base, kind);
+        if (size_t(a.w) * a.h != p.pixels || a.indices.size() != p.pixels) continue;
+        PutTexture(p, a.w, a.h, a.indices.data(), a.palette.data());
+        built.texDesc[kind] = p.texDesc;
+        built.palObj[kind] = p.palObj;
+    }
+    built.valid = built.texDesc[0] != 0 || built.texDesc[1] != 0 || built.texDesc[2] != 0 || built.texDesc[3] != 0;
+    if (u.flags & kPpuNumberLayout) {
+        built.layout = true;
+        built.chest = u.chest;
+        built.chestDx = u.chestDx;
+        built.chestDy = u.chestDy;
+        built.backDx = u.backDx;
+        built.backDy = u.backDy;
+        built.backSize = u.backSize;
+    }
+    GxGuestWrite::NotifyWrite(base, kEntryBytes);
+    g_owner[size_t(slot)] = folder;
+    c = {built, time, size, ++g_clock, slot, false, now};
+    std::fprintf(stderr, "[arrange] uniform '%s' loaded (cache slot %d)\n", folder.c_str(), slot);
+    out = built;
+    return built.valid;
+}
+
+// --- (manager idx) -> folder --------------------------------------------------------------------
+// Set by the mapping hooks, read by the apply hook; cleared when the manager is (re)loaded/destroyed.
+std::array<std::string, kMaxIdx> g_idxFolder;
+// The number layout each manager idx's uniform brings (set when its slots are filled, read by the number
+// draw every frame without touching the disk).
+std::array<Built, kMaxIdx> g_idxBuilt;
+void ClearIdx() {
+    for (auto& s : g_idxFolder) s.clear();
+    for (auto& b : g_idxBuilt) b = {};
+}
+
+uint32_t Manager() { return Memory::Read32(kManagerPtr); }
+
+// desc is gestor+0x2908+idx*0x44 -> idx, or -1 if not an Arrange uniform descriptor.
+int IdxOfDescriptor(uint32_t desc) {
+    const uint32_t g = Manager();
+    if (!g || desc < g + kDescOffset) return -1;
+    const uint32_t off = desc - (g + kDescOffset);
+    if (off % kDescStride) return -1;
+    const uint32_t idx = off / kDescStride;
+    return idx < kMaxIdx ? int(idx) : -1;
+}
+
+bool ValidRecord(uint32_t record) { return record >= 0x80000000u && Memory::Contains(record, 0x37); }
+
+// The record of the slot being edited ([0x8102B2C8] + 0x42), or 0. The editor / Original Team work on
+// the real slot; 0x805A83F0 is handed a stack copy of its record, so choiceFor needs the real one.
+uint32_t EditingRecord() {
+    const uint32_t slot = Memory::Read32(kEditingSlot);
+    if (!slot) return 0;
+    const uint32_t block = Memory::Read32(kSlotBlock);
+    const uint32_t first = block ? block + kSlotsOffset : 0;
+    if (!block || slot < first || slot >= first + 32 * kSlotStride || (slot - first) % kSlotStride) return 0;
+    return slot + kRecord;
+}
+
+// bytes points at a record's home uniform (record+0x1C) or away (record+0x26); return the record and
+// whether it is the home side, by checking which candidate is a real team record.
+bool RecordFromBytes(uint32_t bytes, uint32_t& record, bool& home) {
+    for (int side = 0; side < 2; ++side) {
+        const uint32_t cand = bytes - (side == 0 ? 0x1C : 0x26);
+        if (cand < kRecord || !ValidRecord(cand)) continue;
+        const uint32_t block = Memory::Read32(kSlotBlock);
+        const uint32_t first = block ? block + kSlotsOffset : 0;
+        const bool inBlock = block && cand >= first + kRecord &&
+                             (cand - kRecord - first) % kSlotStride == 0 &&
+                             (cand - kRecord - first) / kSlotStride < 32;
+        const bool matchSlot = cand == kMatchSlot + kRecord;
+        if (inBlock || matchSlot) { record = cand; home = side == 0; return true; }
+    }
+    return false;
+}
+
+void SetIdxFromRecord(int idx, uint32_t record, bool home) {
+    if (idx < 0 || idx >= int(kMaxIdx) || !ValidRecord(record)) return;
+    const Choice& ch = arrange_marks::choiceFor(record);
+    g_idxFolder[size_t(idx)] = home ? ch.uniformHome : ch.uniformRoad;
+}
+
+// --- Apply --------------------------------------------------------------------------------------
+void WriteSlot(uint32_t ch, uint32_t texOffset, uint32_t palOffset, uint32_t texDesc, uint32_t palObj) {
+    if (texDesc) Memory::Write32(ch + texOffset + kSlotResolved, texDesc);
+    if (palObj) Memory::Write32(ch + palOffset + kSlotResolved, palObj);
+}
+
+void ApplyUniform(uint32_t ch, const Built& b) {
+    // Body (G1). Cap/helmet (G2): the .ppu's cap atlas covers the cap (char+0x11C) and the helmet
+    // (char+0x12C, falling back to the cap); both resolve to the game's shared letter struct (Task 1),
+    // so the red initial is gone from the cap. A .ppu with its own helmet atlas overrides that one.
+    const uint32_t helmetTex = b.texDesc[2] ? b.texDesc[2] : b.texDesc[1];
+    const uint32_t helmetPal = b.texDesc[2] ? b.palObj[2] : b.palObj[1];
+    WriteSlot(ch, kChBodyTex, kChBodyPal, b.texDesc[0], b.palObj[0]);
+    WriteSlot(ch, kChCapTex, kChCapPal, b.texDesc[1], b.palObj[1]);
+    WriteSlot(ch, kChHelmetTex, kChHelmetPal, helmetTex, helmetPal);
+    // Chest (G2): the chest wordmark/art is baked into the body atlas, so the chest letter slot
+    // (char+0x10C, the small initial seen from the front, 0x974B3C20) is set transparent to remove it.
+    const Part t = TransparentDecal();
+    WriteSlot(ch, kChChestTex, kChChestPal, t.texDesc, t.palObj);
+    // Back number (G4): kept as the game set it, unless the .ppu brings a "number" atlas (kind 3),
+    // which then drives both digit textures and their palettes.
+    if (b.texDesc[3]) {
+        WriteSlot(ch, kChNumTex0, kChNumPal0, b.texDesc[3], b.palObj[3]);
+        WriteSlot(ch, kChNumTex1, kChNumPal1, b.texDesc[3], b.palObj[3]);
+    }
+}
+
+}  // namespace
+
+// --- Interfaces ---------------------------------------------------------------------------------
+uint32_t ReserveGuestMemory(uint32_t low, uint32_t high) {
+    g_arena = 0;
+    if (!RuntimeConfigFile::ArrangeCustomUniforms(false)) return high;
+    const uint32_t arena = (high - kArenaBytes) & ~0xFFFu;
+    if (high <= low || arena < low || high - low < kArenaBytes + 0x1000 || !Memory::Contains(arena, kArenaBytes)) {
+        std::fprintf(stderr, "[arrange] custom uniforms off: no room in the MEM2 arena\n");
+        return high;
+    }
+    std::memset(Memory::GetPointer(arena, kArenaBytes), 0, kArenaBytes);
+    g_arena = arena;
+    // The shared transparent 64x32 decal: all-index-0 texels (already zeroed) with its two descriptors
+    // (its palette is all zero, so index 0 reads as RGB5A3 0x0000 = fully transparent).
+    const Part t = TransparentDecal();
+    const uint32_t tex[16] = {uint32_t(32) << 16 | 64, 9, t.texels, 0, 0, 1, 1};
+    for (uint32_t i = 0; i < 16; ++i) Memory::Write32(t.texDesc + i * 4, tex[i]);
+    const uint32_t pal[8] = {256u << 16, 2, t.palette};
+    for (uint32_t i = 0; i < 8; ++i) Memory::Write32(t.palObj + i * 4, pal[i]);
+    GxGuestWrite::NotifyWrite(arena, kHeadBytes);
+    std::fprintf(stderr, "[arrange] custom uniforms on: %u KB of MEM2 at 0x%08x\n", kArenaBytes / 1024, arena);
+    return arena;
+}
+
+// ================================================================================================
+// Choosing an imported uniform: the game's own LINE TYPE window (Uniform editor, screen vtable
+// 0x80D3E1E0, scene 0x5B). Evidence: docs/ingenieria-inversa.md ("Framework de pantallas y menús de
+// Arrange") and local/analysis/arrange/ghidra/notas-uniform-listas.md.
+//
+// The LINE TYPE row opens a window (0x805C8AD8, vtable 0x80D3E0E0) whose cursor is the game's
+// generic list (window+0x1F0, 0x805F75BC) set to one line of 3 entries. An imported uniform is one
+// more choice of that list: it grows to 3 + N, the window pages its 3 cells (index / 3), and page 0
+// stays the game's three line types. Everything else is still the game's code: input (0x805CA8A4,
+// left/right through the list, wrap included), sounds, open/close animation, cursor box, help text,
+// the HOME/ROAD models' live preview and B/OK. We only:
+// - window build (0x805C8CE8, vt +0x60): count 3 + N, and a name text per cell plus a label text,
+//   children of the window's own cells / label (positions copied from them, not invented);
+// - window refresh (0x805C8F28, also through its interface thunk 0x805CCF70): for an imported index
+//   the original runs on index % 3 (so it places the cursor box on the right cell), then the line
+//   type pictures (+0x270) and the type label (+0x370) are hidden and the names shown;
+// - open (0x805CACC8): start on the side's imported uniform if it has one;
+// - move / A (0x805CB0BC / 0x805CAF4C): an imported index sets the side's pending uniform and lets
+//   the original write the side's current line type back unchanged (the line type byte only holds
+//   0..2); a game index clears it;
+// - B (0x805CB064): the pending uniform goes back to what it was when the window opened.
+// The pending choice per side is the working copy flushed on OK (0x805CB1F4), as before. With the
+// option off, or no imported uniform, every hook runs the original unchanged.
+// ================================================================================================
+namespace picker {
+
+// --- Calls into the game (local copies; arrange_marks.cpp has its own in its own TU) -------------
+uint32_t Call(CpuContext* ctx, uint32_t target, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0) {
+    const uint32_t lr = ctx->lr;
+    ctx->gpr[3] = a;
+    ctx->gpr[4] = b;
+    ctx->gpr[5] = c;
+    ctx->lr = target;
+    InvokeIndirectCpu(target, ctx);
+    ctx->lr = lr;
+    return ctx->gpr[3];
+}
+uint32_t CallF(CpuContext* ctx, uint32_t target, uint32_t a, float f1, float f2) {
+    ctx->fpr[1].d = double(f1);
+    ctx->fpr[2].d = double(f2);
+    return Call(ctx, target, a);
+}
+uint32_t VCall(CpuContext* ctx, uint32_t object, uint32_t offset, uint32_t b = 0) {
+    if (!object || !Memory::Contains(object, 4)) return 0;
+    const uint32_t table = Memory::Read32(object);
+    if (!Memory::Contains(table + offset, 4)) return 0;
+    const uint32_t function = Memory::Read32(table + offset);
+    return function ? Call(ctx, function, object, b) : 0;
+}
+void SetVisible(CpuContext* ctx, uint32_t node, bool visible) {
+    if (node) VCall(ctx, node, 0x10, visible ? 1 : 0);
+}
+float F(uint32_t address) { return Memory::ReadFloat32(address); }
+
+// --- Game data ----------------------------------------------------------------------------------
+// Uniform screen.
+constexpr uint32_t kSide = 0x487C;          // int (stw/lwz in 0x805EF5F4 / 0x805EF564): 0 HOME, 1 ROAD
+constexpr uint32_t kLineTypeWin = 0x4860;   // the LINE TYPE window object
+constexpr uint32_t kOpenItf = 0x4868;       // interface (window + 0xDC) of the open window, or 0
+constexpr uint32_t kItf = 0xDC;             // window -> its interface
+// LINE TYPE window.
+constexpr uint32_t kList = 0x1F0;           // generic list: +0x1C count, +0x20 per line, +0x28 index
+constexpr uint32_t kTypePictures = 0x270;   // the three line-type pictures (one SURF group)
+constexpr uint32_t kTypeLabel = 0x370;      // the type name (a picture of pack 0x93B)
+constexpr uint32_t kCells = 0x470;          // 3 cell panels (0x807127FC), positions from pack 0x94C
+constexpr int kGameTypes = 3;
+constexpr uint32_t kCellW = 0x80CEE4EC, kCellH = 0x80CEE4F0;  // the game's cell size (floats)
+// Text: the team-name widget (0x805C28D4, vtable +0x40 = set string, up to 10 characters).
+constexpr uint32_t kTextStyle = 0x80CFFBB8;  // team-name style, as the marks lists
+constexpr uint32_t kTextColour = 1;          // the colour the game uses for list names
+constexpr float kGlyphHeight = 34.0f;        // glyph height of that font (docs: «la letra mide 34»)
+constexpr float kMaxScale = 0.45f;           // the scale the game's Team Mark list gives its names
+constexpr size_t kLineChars = 10;            // what the widget shows
+constexpr uint32_t kLabelScratch = kDecalStride;  // arena head scratch for one font string
+static_assert(kDecalStride + (kLineChars + 1) * 2 <= kHeadBytes, "no room for the font string");
+
+struct Text {
+    uint32_t holder = 0, text = 0;
+};
+struct State {
+    uint32_t screen = 0, window = 0;
+    std::vector<Entry> entries;
+    std::vector<std::array<int, 2>> numberColours;  // per entry: UNIFORM # / # OUTLINE from its .ppu, or -1
+    int slot = -1;
+    std::string home, road;     // the working copy, per side
+    std::string atOpen;         // the side's pending uniform when the window opened (B restores it)
+    Text names[kGameTypes][2];  // two lines per cell (uniforms without a thumbnail)
+    Text label;                 // replaces the type label on imported pages: the hovered uniform's name
+    uint32_t gameSurf = 0, gameTexList = 0, gamePalList = 0;  // +0x270's own picture, while we show ours
+    uint32_t firstThumb = 0;          // our textures' index in the lists (after the game's entries)
+    std::string thumbOf[kGameTypes];  // which folder's thumbnail each cell's texture holds
+    bool hasThumb[kGameTypes] = {};
+} g;
+
+bool Active(uint32_t screen) { return Enabled() && screen && g.screen == screen; }
+bool OnWindow(uint32_t window) { return Enabled() && window && g.window == window && !g.entries.empty(); }
+uint8_t Side(uint32_t s) { return Memory::Read32(s + kSide) ? 1 : 0; }
+std::string& Pending(uint32_t s) { return Side(s) ? g.road : g.home; }
+uint32_t ListOf(uint32_t window) { return window + kList; }
+uint32_t Index(uint32_t window) { return Memory::Read32(ListOf(window) + 0x28); }
+bool LineTypeOpen(uint32_t s) {
+    const uint32_t w = Memory::Read32(s + kLineTypeWin);
+    return w && Memory::Read32(s + kOpenItf) == w + kItf;
+}
+int ImportedOf(const std::string& folder) {
+    for (size_t i = 0; i < g.entries.size(); ++i)
+        if (g.entries[i].folder == folder) return int(i);
+    return -1;
+}
+std::string NameOf(const Entry& e) { return e.label.empty() ? e.folder : e.label; }
+
+// The game's font codes: ASCII + 0x9B for letters and digits, 0 space, 0x1D hyphen, 0xFFFF end.
+// Upper-cased; anything else is dropped so no garbage glyph is drawn.
+std::string FontSafe(const std::string& name) {
+    std::string out;
+    for (char ch : name) {
+        if (ch >= 'a' && ch <= 'z') ch = char(ch - 'a' + 'A');
+        if (ch == '_') ch = ' ';
+        if ((ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == ' ' || ch == '-') out += ch;
+    }
+    return out;
+}
+uint32_t WriteFont(const std::string& s) {
+    const uint32_t at = g_arena + kLabelScratch;
+    size_t n = 0;
+    for (; n < s.size() && n < kLineChars; ++n) {
+        const char ch = s[n];
+        Memory::Write16(at + uint32_t(n) * 2, ch == ' ' ? 0 : ch == '-' ? 0x1D : uint16_t(uint8_t(ch) + 0x9B));
+    }
+    Memory::Write16(at + uint32_t(n) * 2, 0xFFFF);
+    return at;
+}
+// Up to two lines of kLineChars, broken at a space when there is one.
+std::array<std::string, 2> SplitLines(const std::string& name) {
+    std::string s = FontSafe(name);
+    if (s.size() <= kLineChars) return {s, ""};
+    size_t cut = s.rfind(' ', kLineChars);
+    if (cut == std::string::npos || cut == 0) cut = kLineChars;
+    std::string rest = s.substr(cut);
+    while (!rest.empty() && rest.front() == ' ') rest.erase(rest.begin());
+    return {s.substr(0, cut), rest.substr(0, kLineChars)};
+}
+
+Text NewText(CpuContext* ctx, uint32_t parent) {
+    Text t;
+    t.holder = Call(ctx, 0x8005B060, 0x100);
+    if (!t.holder) return {};
+    Call(ctx, 0x8001E9BC, t.holder);          // image node
+    Call(ctx, 0x8057A180, t.holder, parent);  // attach
+    Call(ctx, 0x8001AC60, t.holder, 0);
+    t.text = Call(ctx, 0x805C28D4, t.holder, 0, Memory::Read32(kTextStyle) & 0xFFFF);
+    if (t.text) {
+        Call(ctx, 0x8001AC60, t.text, 0);
+        CallF(ctx, 0x8001A7B0, t.text, 0, 0);
+    }
+    SetVisible(ctx, t.holder, false);
+    return t;
+}
+void FreeText(CpuContext* ctx, Text& t) {
+    if (t.text) VCall(ctx, t.text, 0x08, 1);
+    if (t.holder) VCall(ctx, t.holder, 0x08, 1);
+    t = {};
+}
+// Set the string; returns its width in font units (right edge of the last glyph).
+float SetString(CpuContext* ctx, const Text& t, const std::string& s) {
+    if (!t.text) return 0;
+    Call(ctx, 0x807B4090, t.text, kTextColour);
+    VCall(ctx, t.text, 0x40, WriteFont(s));
+    Call(ctx, 0x807B4090, t.text, kTextColour);
+    const uint32_t glyphs = Memory::Read32(t.text + 0x130), count = Memory::Read16(t.text + 0x10A);
+    if (!count || !Memory::Contains(glyphs + (count - 1) * 0x1C, 0x1C)) return 0;
+    return float(Memory::Read16(glyphs + (count - 1) * 0x1C + 8));
+}
+// Centre a text of `width` font units at (cx, cy) in its parent's space, at `scale`.
+void Place(CpuContext* ctx, const Text& t, float cx, float cy, float width, float scale) {
+    if (!t.holder) return;
+    CallF(ctx, 0x8001ABA0, t.holder, scale, scale);
+    CallF(ctx, 0x8001A7B0, t.holder, cx - width * scale / 2, cy - kGlyphHeight * scale / 2);
+}
+
+// Name of imported entry k in cell c (2 lines, sized to the game's cell), or hidden past the end.
+void ShowCell(CpuContext* ctx, int c, int k) {
+    Text* lines = g.names[c];
+    if (k < 0 || k >= int(g.entries.size())) {
+        SetVisible(ctx, lines[0].holder, false);
+        SetVisible(ctx, lines[1].holder, false);
+        return;
+    }
+    const auto text = SplitLines(NameOf(g.entries[size_t(k)]));
+    const float w0 = SetString(ctx, lines[0], text[0]), w1 = SetString(ctx, lines[1], text[1]);
+    const float cellW = F(kCellW), cellH = F(kCellH);
+    const float widest = std::max(w0, w1);
+    float scale = kMaxScale;
+    if (widest > 0 && widest * scale > cellW * 0.9f) scale = cellW * 0.9f / widest;
+    const int rows = text[1].empty() ? 1 : 2;
+    const float lineH = kGlyphHeight * scale;
+    // The cell node's origin is its top-left corner (seen in game: text centred on the origin sat on
+    // the corner), so the centre is half the game's cell size. Children use the cell's space.
+    const float cx = cellW / 2, top = cellH / 2 - lineH * float(rows) / 2 + lineH / 2;
+    Place(ctx, lines[0], cx, top, w0, scale);
+    SetVisible(ctx, lines[0].holder, true);
+    if (rows == 2) {
+        Place(ctx, lines[1], cx, top + lineH, w1, scale);
+        SetVisible(ctx, lines[1].holder, true);
+    } else {
+        SetVisible(ctx, lines[1].holder, false);
+    }
+}
+
+// --- Thumbnails: the game's line-type picture, with our textures ---------------------------------
+// +0x270 is an image node showing ONE SURF (seen in game: 4 quads; quad 0 the word "LINE" of the bar
+// "LINE OFF", texture 0; quads 1-3 the three line types, 70x64 each, texture 1). On an imported page the
+// node shows our SURF instead: the game's header and quads, the three line-type quads (the three sharing
+// one texture) mapping a whole 64x64 thumbnail (UV 0..64) each, so every picture keeps the game's place
+// and size in its cell, and the other quads drawn transparent (the bar then names the uniform). The
+// node draws its SURF every frame (docs: «Nodo imagen»).
+struct Thumb {
+    uint32_t texels, palette, texDesc, palObj;
+};
+Thumb ThumbPart(int c) {
+    const uint32_t b = g_arena + kThumb0 + uint32_t(c) * kThumbStride;
+    return {b, b + kThumbPixels, b + kThumbPixels + kPaletteBytes, b + kThumbPixels + kPaletteBytes + kTexDescBytes};
+}
+
+// Put folder's thumbnail into cell c's texture (cached by folder); false if the .ppu has none.
+bool LoadThumb(int c, const std::string& folder) {
+    if (g.thumbOf[c] == folder) return g.hasThumb[c];
+    g.thumbOf[c] = folder;
+    g.hasThumb[c] = false;
+    std::vector<uint8_t> bytes;
+    {
+        std::ifstream f(UniformsRoot() / folder / "uniform.ppu", std::ios::binary);
+        if (f) bytes.assign(std::istreambuf_iterator<char>(f), {});
+    }
+    Uniform u;
+    if (readPpu(bytes.data(), bytes.size(), u) != ReadStatus::Valid) return false;
+    const auto it = u.atlases.find("thumb");
+    if (it == u.atlases.end()) return false;
+    const Thumb t = ThumbPart(c);
+    PutTexture({t.texels, t.palette, t.texDesc, t.palObj, kThumbPixels}, 64, 64, it->second.indices.data(),
+               it->second.palette.data());
+    GxGuestWrite::NotifyWrite(t.texels, kThumbStride);
+    g.hasThumb[c] = true;
+    return true;
+}
+
+// Point +0x270 at our SURF (built from the game's on first use) or back at the game's.
+bool ShowThumbs(uint32_t window, bool ours) {
+    const uint32_t node = window + kTypePictures;
+    if (!ours) {
+        if (g.gameSurf) {
+            Memory::Write32(node + 0xDC, g.gameSurf);
+            Memory::Write32(node + 0xE0, g.gameTexList);
+            Memory::Write32(node + 0xE4, g.gamePalList);
+        }
+        return true;
+    }
+    const uint32_t block = g_arena + kThumbSurf;
+    if (!g.gameSurf) {
+        const uint32_t game = Memory::Read32(node + 0xDC);
+        if (!game || !Memory::Contains(game, 0x24)) return false;
+        const uint32_t n = Memory::Read16(game + 0x16), quads = Memory::Read32(game + 0x18);
+        const uint32_t texList = Memory::Read32(node + 0xE0), palList = Memory::Read32(node + 0xE4);
+        if (n == 0 || n > kSurfMaxQuads || !Memory::Contains(quads, n * 0x1C) || !Memory::Contains(texList, 8) ||
+            !Memory::Contains(palList, 8))
+            return false;
+        const uint32_t texCount = Memory::Read32(texList), palCount = Memory::Read32(palList);
+        if (texCount + 4 > kSurfMaxEntries || palCount + 4 > kSurfMaxEntries) return false;
+        // The line-type quads: the texture three quads share, left to right = cells 0..2.
+        std::vector<int> types;
+        for (uint32_t t = 0; t < texCount && types.size() != 3; ++t) {
+            types.clear();
+            for (uint32_t i = 0; i < n; ++i)
+                if (Memory::Read8(quads + i * 0x1C + 0x18) == t) types.push_back(int(i));
+        }
+        if (types.size() != 3) return false;
+        std::sort(types.begin(), types.end(), [&](int a, int b) {
+            return int16_t(Memory::Read16(quads + uint32_t(a) * 0x1C + 4)) <
+                   int16_t(Memory::Read16(quads + uint32_t(b) * 0x1C + 4));
+        });
+        g.gameSurf = game;
+        g.gameTexList = texList;
+        g.gamePalList = palList;
+        g.firstThumb = std::max(texCount, palCount);
+        std::memcpy(Memory::GetPointer(block, 0x24), Memory::GetPointer(game, 0x24), 0x24);
+        Memory::Write16(block + 0x14, uint16_t(Memory::Read16(block + 0x14) & ~1u));  // palette per quad
+        Memory::Write32(block + 0x18, block + kSurfQuads);
+        Memory::Write32(block + 0x1C, block + kSurfTexList);
+        Memory::Write32(block + 0x20, block + kSurfPalList);
+        std::memcpy(Memory::GetPointer(block + kSurfQuads, n * 0x1C), Memory::GetPointer(quads, n * 0x1C), n * 0x1C);
+        for (uint32_t i = 0; i < n; ++i) {  // every other quad: the transparent entry (after our three)
+            Memory::Write8(block + kSurfQuads + i * 0x1C + 0x18, uint8_t(g.firstThumb + 3));
+            Memory::Write8(block + kSurfQuads + i * 0x1C + 0x19, uint8_t(g.firstThumb + 3));
+        }
+        for (int c = 0; c < 3; ++c) {
+            const uint32_t q = block + kSurfQuads + uint32_t(types[size_t(c)]) * 0x1C;
+            const uint16_t uv[4] = {0, 0, 64, 64};
+            for (uint32_t i = 0; i < 4; ++i) Memory::Write16(q + 0xC + i * 2, uv[i]);
+            Memory::Write8(q + 0x18, uint8_t(g.firstThumb + uint32_t(c)));
+            Memory::Write8(q + 0x19, uint8_t(g.firstThumb + uint32_t(c)));
+        }
+        // The game's entries first (its other quads keep their indices), padded with its last.
+        const uint32_t texEntries = Memory::Read32(texList + 4), palEntries = Memory::Read32(palList + 4);
+        for (uint32_t i = 0; i < g.firstThumb; ++i) {
+            Memory::Write32(block + kSurfTexEntries + i * 4, Memory::Read32(texEntries + std::min(i, texCount - 1) * 4));
+            Memory::Write32(block + kSurfPalEntries + i * 4, Memory::Read32(palEntries + std::min(i, palCount - 1) * 4));
+        }
+        const Part none = TransparentDecal();
+        Memory::Write32(block + kSurfTexEntries + (g.firstThumb + 3) * 4, none.texDesc);
+        Memory::Write32(block + kSurfPalEntries + (g.firstThumb + 3) * 4, none.palObj);
+        Memory::Write32(block + kSurfTexList, g.firstThumb + 4);
+        Memory::Write32(block + kSurfTexList + 4, block + kSurfTexEntries);
+        Memory::Write32(block + kSurfPalList, g.firstThumb + 4);
+        Memory::Write32(block + kSurfPalList + 4, block + kSurfPalEntries);
+    }
+    // Each cell: its thumbnail, or the transparent decal (no picture; the name is shown instead).
+    for (int c = 0; c < 3; ++c) {
+        const Thumb t = ThumbPart(c);
+        const Part none = TransparentDecal();
+        const uint32_t at = (g.firstThumb + uint32_t(c)) * 4;
+        Memory::Write32(block + kSurfTexEntries + at, g.hasThumb[c] ? t.texDesc : none.texDesc);
+        Memory::Write32(block + kSurfPalEntries + at, g.hasThumb[c] ? t.palObj : none.palObj);
+    }
+    Memory::Write32(node + 0xDC, block);
+    Memory::Write32(node + 0xE0, block + kSurfTexList);
+    Memory::Write32(node + 0xE4, block + kSurfPalList);
+    return true;
+}
+
+// Draw the window's state for its current index (after the original refresh ran on index % 3).
+void ShowPage(CpuContext* ctx, uint32_t window) {
+    const int index = int(Index(window));
+    const bool imported = index >= kGameTypes;
+    const int first = imported ? (index / kGameTypes - 1) * kGameTypes : 0;
+    bool thumbs = false;
+    if (imported) {
+        for (int c = 0; c < kGameTypes; ++c) {
+            const int k = first + c;
+            if (k < int(g.entries.size())) {
+                LoadThumb(c, g.entries[size_t(k)].folder);
+            } else {
+                g.thumbOf[c].clear();
+                g.hasThumb[c] = false;
+            }
+        }
+        thumbs = ShowThumbs(window, true);
+    } else {
+        ShowThumbs(window, false);
+    }
+    SetVisible(ctx, window + kTypePictures, !imported || thumbs);
+    SetVisible(ctx, window + kTypeLabel, !imported);
+    // Names in the cells only where there is no picture.
+    for (int c = 0; c < kGameTypes; ++c) ShowCell(ctx, c, imported && !(thumbs && g.hasThumb[c]) ? first + c : -1);
+    if (!g.label.holder) return;
+    if (!imported) {
+        SetVisible(ctx, g.label.holder, false);
+        return;
+    }
+    // The label names the hovered uniform, as the game's names the hovered line type, at the type
+    // label's own position (pack locator 0x400001D4, set by the game): the node is the picture's top
+    // centre (seen in game), so the text hangs from it.
