+// 0x806CD258(compose): draws the shirt number on the body being composed, from fixed tables in MEM1:
+// back number rects 0x810337A8 (6 x 16 bytes: 3 digits, 2 digits, 1 digit) and chest rects 0x810334A8
+// (6 tables x 8 positions x 16 bytes), each {x0, y0, x1, y1} as floats in body-atlas pixels (docs:
+// «El número del uniforme»). For a character wearing an imported uniform with a number layout, those
+// rects are moved (and the back ones scaled about the block's centre, 96, 104) just for this call and
+// put back right after; every other character draws the game's own numbers.
+extern "C" void MLB_ArrangeUniformNumber_806CD258(CpuContext* ctx) {
+    const uint32_t compose = ctx->gpr[3];
+    const Built* b = nullptr;
+    if (Enabled() && compose >= 0x80000000u && Memory::Contains(compose, 8)) {
+        const uint32_t info = Memory::Read32(compose + 4);  // the character's number info, char + 0x44
+        const uint32_t ch = info - 0x44;
+        if (info >= 0x80000044u && Memory::Contains(ch, 0x1BC4)) {
+            const int idx = IdxOfDescriptor(Memory::Read32(ch + 0x1BC0));
+            if (idx >= 0 && g_idxBuilt[size_t(idx)].layout) b = &g_idxBuilt[size_t(idx)];
+        }
+    }
+    const bool move = b && (b->chestDx || b->chestDy || b->backDx || b->backDy || b->backSize != 100);
+    if (!move) {
+        func_806CD258(ctx);
+        return;
+    }
+    constexpr uint32_t kChest = 0x810334A8, kChestRects = 6 * 8, kBack = 0x810337A8, kBackRects = 6;
+    float saved[(kChestRects + kBackRects) * 4];
+    for (uint32_t i = 0; i < kChestRects * 4; ++i) saved[i] = Memory::ReadFloat32(kChest + i * 4);
+    for (uint32_t i = 0; i < kBackRects * 4; ++i) saved[kChestRects * 4 + i] = Memory::ReadFloat32(kBack + i * 4);
+    for (uint32_t i = 0; i < kChestRects * 4; ++i)
+        Memory::WriteFloat32(kChest + i * 4, saved[i] + float(i % 2 == 0 ? b->chestDx : b->chestDy));
+    const float s = b->backSize / 100.0f;
+    for (uint32_t i = 0; i < kBackRects * 4; ++i) {
+        const bool x = i % 2 == 0;
+        const float c = x ? 96.0f : 104.0f, v = saved[kChestRects * 4 + i];
+        Memory::WriteFloat32(kBack + i * 4, c + (v - c) * s + float(x ? b->backDx : b->backDy));
+    }
+    func_806CD258(ctx);
+    for (uint32_t i = 0; i < kChestRects * 4; ++i) Memory::WriteFloat32(kChest + i * 4, saved[i]);
+    for (uint32_t i = 0; i < kBackRects * 4; ++i) Memory::WriteFloat32(kBack + i * 4, saved[kChestRects * 4 + i]);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x806CD258, MLB_ArrangeUniformNumber_806CD258, "MLB_ArrangeUniformNumber_806CD258");
