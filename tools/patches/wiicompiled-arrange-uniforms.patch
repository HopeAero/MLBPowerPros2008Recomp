+// pad.cpp: held state of the Uniform editor's free "cycle" button this frame (device-agnostic).
+extern "C" bool MLB_UniCycleButtonHeld();
+
+namespace arrange_uniforms {
+namespace {
+namespace fs = std::filesystem;
+using arrange_marks::Choice;
+
+// --- Guest game data ----------------------------------------------------------------------------
+constexpr uint32_t kManagerPtr = 0x81033438;  // [.] = uniform manager (gestor)
+constexpr uint32_t kDescOffset = 0x2908, kDescStride = 0x44, kMaxIdx = 64;
+constexpr uint32_t kSlotBlock = 0x8104E1D8, kSlotsOffset = 0x3AC, kSlotStride = 0x2448, kRecord = 0x42;
+constexpr uint32_t kMatchSlot = 0x8102D730, kEditingSlot = 0x8102B2C8;
+const bool g_trace = std::getenv("WIICOMPILED_ARRANGE_TRACE") != nullptr;
+// Character slots {type, pack, id/v, resolved@+0xC}; textures are drawn through the resolved pointer
+// (+0xC), palettes through the whole palette-object pointer (+0xC).
+constexpr uint32_t kChBodyTex = 0x8C, kChBodyPal = 0x9C, kChCapTex = 0x11C, kChCapPal = 0x14C,
+                   kChHelmetTex = 0x12C, kChHelmetPal = 0x15C, kChChestTex = 0x10C, kChChestPal = 0x13C;
+// Back number: two digit textures and their palettes. Left intact (G4) unless the .ppu has a number.
+constexpr uint32_t kChNumTex0 = 0xAC, kChNumTex1 = 0xBC, kChNumPal0 = 0xCC, kChNumPal1 = 0xDC;
+constexpr uint32_t kSlotResolved = 0xC;
+
+// --- Cache arena --------------------------------------------------------------------------------
+// A head with one transparent 64x32 decal (shared, to blank the chest initial), then kCacheSlots
+// entries. Each entry: body (128x128) then cap, helmet, number (64x32 each); each part is texels +
+// palette (256 x RGB5A3) + a texture descriptor (0x40) + a palette object (0x20), the game's own.
+constexpr uint32_t kBodyPixels = 128 * 128, kDecalPixels = 64 * 32, kPaletteBytes = 512;
+constexpr uint32_t kTexDescBytes = 0x40, kPalObjBytes = 0x20;
+constexpr uint32_t kBodyTexels = 0;
+constexpr uint32_t kBodyPalette = kBodyTexels + kBodyPixels;            // 0x4000
+constexpr uint32_t kBodyTexDesc = kBodyPalette + kPaletteBytes;         // 0x4200
+constexpr uint32_t kBodyPalObj = kBodyTexDesc + kTexDescBytes;          // 0x4240
+constexpr uint32_t kDecal0 = kBodyPalObj + kPalObjBytes;                // 0x4260
+constexpr uint32_t kDecalStride = kDecalPixels + kPaletteBytes + kTexDescBytes + kPalObjBytes;  // 0xA60
+constexpr uint32_t kEntryBytes = (kDecal0 + 3 * kDecalStride + 0x1Fu) & ~0x1Fu;  // body + cap/helmet/number
+// The transparent decal, then a scratch for the IMPORTED prompt's font string (Task 9).
+constexpr uint32_t kRowLabelBytes = 0x40;
+constexpr uint32_t kHeadBytes = (kDecalStride + kRowLabelBytes + 0x1Fu) & ~0x1Fu;
+constexpr uint32_t kCacheSlots = 8;
+constexpr uint32_t kArenaBytes = kHeadBytes + kCacheSlots * kEntryBytes;
+
+uint32_t g_arena = 0;
+bool Enabled() { return g_arena != 0; }
+uint32_t EntryAddress(int slot) { return g_arena + kHeadBytes + uint32_t(slot) * kEntryBytes; }
+
+struct Part {
+    uint32_t texels, palette, texDesc, palObj, pixels;
+};
+// kind: 0 body, 1 cap, 2 helmet, 3 number.
+Part PartOf(uint32_t base, int kind) {
+    if (kind == 0) return {base + kBodyTexels, base + kBodyPalette, base + kBodyTexDesc, base + kBodyPalObj, kBodyPixels};
+    const uint32_t d = base + kDecal0 + uint32_t(kind - 1) * kDecalStride;
+    return {d, d + kDecalPixels, d + kDecalPixels + kPaletteBytes,
+            d + kDecalPixels + kPaletteBytes + kTexDescBytes, kDecalPixels};
+}
+// The shared transparent decal (head of the arena): a 64x32 all-index-0 texture with an all-zero
+// palette (entry 0 = 0x0000, fully transparent). Its descriptors stay fixed; built once at boot.
+Part TransparentDecal() {
+    const uint32_t d = g_arena;
+    return {d, d + kDecalPixels, d + kDecalPixels + kPaletteBytes,
+            d + kDecalPixels + kPaletteBytes + kTexDescBytes, kDecalPixels};
+}
+
+// The texture + its two descriptors into guest memory (the game's C8 format; same as marks).
+void PutTexture(const Part& p, uint16_t w, uint16_t h, const uint8_t* indices, const uint8_t* palette512) {
+    std::memcpy(Memory::GetPointer(p.texels, size_t(w) * h), indices, size_t(w) * h);
+    std::memcpy(Memory::GetPointer(p.palette, kPaletteBytes), palette512, kPaletteBytes);  // already big-endian
+    const uint32_t tex[16] = {uint32_t(h) << 16 | w, 9, p.texels, 0, 0, 1, 1};
+    for (uint32_t i = 0; i < 16; ++i) Memory::Write32(p.texDesc + i * 4, tex[i]);
+    const uint32_t pal[8] = {256u << 16, 2, p.palette};
+    for (uint32_t i = 0; i < 8; ++i) Memory::Write32(p.palObj + i * 4, pal[i]);
+}
+
+// --- Uniform cache ------------------------------------------------------------------------------
+struct Built {
+    // Per kind (body, cap, helmet, chest): texture-descriptor and palette-object addresses, 0 if the
+    // .ppu has no atlas for that kind (that slot is then left as the game set it).
+    uint32_t texDesc[4] = {}, palObj[4] = {};
+    bool valid = false;
+};
+struct Cached {
+    Built built;
+    fs::file_time_type time{};
+    uintmax_t size = 0;
+    uint64_t used = 0;
+    int slot = -1;
+    bool failed = false;
+    std::chrono::steady_clock::time_point checked{};
+};
+std::map<std::string, Cached> g_cache;           // folder -> cached build
+std::array<std::string, kCacheSlots> g_owner;    // arena slot -> folder
+uint64_t g_clock = 0;
+
+fs::path UniformsRoot() { return RuntimeConfigFile::ApplicationDataDirectory() / "arrange" / "uniforms"; }
+
+int FreeSlot() {
+    for (uint32_t i = 0; i < kCacheSlots; ++i)
+        if (g_owner[i].empty()) return int(i);
+    int oldest = 0;
+    uint64_t when = UINT64_MAX;
+    for (const auto& [folder, c] : g_cache)
+        if (c.slot >= 0 && c.used < when) { when = c.used; oldest = c.slot; }
+    g_cache[g_owner[size_t(oldest)]].slot = -1;
+    g_owner[size_t(oldest)].clear();
+    return oldest;
+}
+
+// Build (or reuse) the guest objects for a folder's uniform; false if missing/invalid (fallback).
+bool LoadUniform(const std::string& folder, Built& out) {
+    out = {};
+    if (!Enabled() || folder.empty()) return false;
+    const auto now = std::chrono::steady_clock::now();
+    const fs::path ppu = UniformsRoot() / folder / "uniform.ppu";
+    std::error_code ec;
+    const bool exists = fs::is_regular_file(ppu, ec) && !ec;
+    fs::file_time_type time = exists ? fs::last_write_time(ppu, ec) : fs::file_time_type{};
+    uintmax_t size = exists ? fs::file_size(ppu, ec) : 0;
+
+    Cached& c = g_cache[folder];
+    const bool fresh = exists && c.time == time && c.size == size;
+    if (fresh && c.slot >= 0 && g_owner[size_t(c.slot)] == folder) {
+        c.used = ++g_clock;
+        out = c.built;
+        return out.valid;
+    }
+    if (fresh && c.failed) return false;
+    if (!exists) {
+        if (!c.failed) std::fprintf(stderr, "[arrange] uniform '%s' not found: the game uniform is shown\n", folder.c_str());
+        c = {}; c.failed = true; c.time = time; c.size = size;
+        return false;
+    }
+
+    std::vector<uint8_t> bytes;
+    {
+        std::ifstream f(ppu, std::ios::binary);
+        if (f) bytes.assign(std::istreambuf_iterator<char>(f), {});
+    }
+    Uniform u;
+    const ReadStatus st = readPpu(bytes.data(), bytes.size(), u);
+    if (st != ReadStatus::Valid) {
+        std::fprintf(stderr, "[arrange] uniform '%s' not used (%s): the game uniform is shown\n", folder.c_str(),
+                     st == ReadStatus::Missing ? "empty" : "invalid");
+        if (c.slot >= 0 && g_owner[size_t(c.slot)] == folder) g_owner[size_t(c.slot)].clear();
+        c = {}; c.failed = true; c.time = time; c.size = size; c.slot = -1;
+        return false;
+    }
+
+    const int slot = (c.slot >= 0 && g_owner[size_t(c.slot)] == folder) ? c.slot : FreeSlot();
+    const uint32_t base = EntryAddress(slot);
+    static constexpr const char* kKinds[4] = {"body", "cap", "helmet", "number"};
+    Built built;
+    for (int kind = 0; kind < 4; ++kind) {
+        const auto it = u.atlases.find(kKinds[kind]);
+        if (it == u.atlases.end()) continue;
+        const Atlas& a = it->second;
+        const Part p = PartOf(base, kind);
+        if (size_t(a.w) * a.h != p.pixels || a.indices.size() != p.pixels) continue;
+        PutTexture(p, a.w, a.h, a.indices.data(), a.palette.data());
+        built.texDesc[kind] = p.texDesc;
+        built.palObj[kind] = p.palObj;
+    }
+    built.valid = built.texDesc[0] != 0 || built.texDesc[1] != 0 || built.texDesc[2] != 0 || built.texDesc[3] != 0;
+    GxGuestWrite::NotifyWrite(base, kEntryBytes);
+    g_owner[size_t(slot)] = folder;
+    c = {built, time, size, ++g_clock, slot, false, now};
+    std::fprintf(stderr, "[arrange] uniform '%s' loaded (cache slot %d)\n", folder.c_str(), slot);
+    out = built;
+    return built.valid;
+}
+
+// --- (manager idx) -> folder --------------------------------------------------------------------
+// Set by the mapping hooks, read by the apply hook; cleared when the manager is (re)loaded/destroyed.
+std::array<std::string, kMaxIdx> g_idxFolder;
+void ClearIdx() { for (auto& s : g_idxFolder) s.clear(); }
+
+uint32_t Manager() { return Memory::Read32(kManagerPtr); }
+
+// desc is gestor+0x2908+idx*0x44 -> idx, or -1 if not an Arrange uniform descriptor.
+int IdxOfDescriptor(uint32_t desc) {
+    const uint32_t g = Manager();
+    if (!g || desc < g + kDescOffset) return -1;
+    const uint32_t off = desc - (g + kDescOffset);
+    if (off % kDescStride) return -1;
+    const uint32_t idx = off / kDescStride;
+    return idx < kMaxIdx ? int(idx) : -1;
+}
+
+bool ValidRecord(uint32_t record) { return record >= 0x80000000u && Memory::Contains(record, 0x37); }
+
+// The record of the slot being edited ([0x8102B2C8] + 0x42), or 0. The editor / Original Team work on
+// the real slot; 0x805A83F0 is handed a stack copy of its record, so choiceFor needs the real one.
+uint32_t EditingRecord() {
+    const uint32_t slot = Memory::Read32(kEditingSlot);
+    if (!slot) return 0;
+    const uint32_t block = Memory::Read32(kSlotBlock);
+    const uint32_t first = block ? block + kSlotsOffset : 0;
+    if (!block || slot < first || slot >= first + 32 * kSlotStride || (slot - first) % kSlotStride) return 0;
+    return slot + kRecord;
+}
+
+// bytes points at a record's home uniform (record+0x1C) or away (record+0x26); return the record and
+// whether it is the home side, by checking which candidate is a real team record.
+bool RecordFromBytes(uint32_t bytes, uint32_t& record, bool& home) {
+    for (int side = 0; side < 2; ++side) {
+        const uint32_t cand = bytes - (side == 0 ? 0x1C : 0x26);
+        if (cand < kRecord || !ValidRecord(cand)) continue;
+        const uint32_t block = Memory::Read32(kSlotBlock);
+        const uint32_t first = block ? block + kSlotsOffset : 0;
+        const bool inBlock = block && cand >= first + kRecord &&
+                             (cand - kRecord - first) % kSlotStride == 0 &&
+                             (cand - kRecord - first) / kSlotStride < 32;
+        const bool matchSlot = cand == kMatchSlot + kRecord;
+        if (inBlock || matchSlot) { record = cand; home = side == 0; return true; }
+    }
+    return false;
+}
+
+void SetIdxFromRecord(int idx, uint32_t record, bool home) {
+    if (idx < 0 || idx >= int(kMaxIdx) || !ValidRecord(record)) return;
+    const Choice& ch = arrange_marks::choiceFor(record);
+    g_idxFolder[size_t(idx)] = home ? ch.uniformHome : ch.uniformRoad;
+}
+
+// --- Apply --------------------------------------------------------------------------------------
+void WriteSlot(uint32_t ch, uint32_t texOffset, uint32_t palOffset, uint32_t texDesc, uint32_t palObj) {
+    if (texDesc) Memory::Write32(ch + texOffset + kSlotResolved, texDesc);
+    if (palObj) Memory::Write32(ch + palOffset + kSlotResolved, palObj);
+}
+
+void ApplyUniform(uint32_t ch, const Built& b) {
+    // Body (G1). Cap/helmet (G2): the .ppu's cap atlas covers the cap (char+0x11C) and the helmet
+    // (char+0x12C, falling back to the cap); both resolve to the game's shared letter struct (Task 1),
+    // so the red initial is gone from the cap. A .ppu with its own helmet atlas overrides that one.
+    const uint32_t helmetTex = b.texDesc[2] ? b.texDesc[2] : b.texDesc[1];
+    const uint32_t helmetPal = b.texDesc[2] ? b.palObj[2] : b.palObj[1];
+    WriteSlot(ch, kChBodyTex, kChBodyPal, b.texDesc[0], b.palObj[0]);
+    WriteSlot(ch, kChCapTex, kChCapPal, b.texDesc[1], b.palObj[1]);
+    WriteSlot(ch, kChHelmetTex, kChHelmetPal, helmetTex, helmetPal);
+    // Chest (G2): the chest wordmark/art is baked into the body atlas, so the chest letter slot
+    // (char+0x10C, the small initial seen from the front, 0x974B3C20) is set transparent to remove it.
+    const Part t = TransparentDecal();
+    WriteSlot(ch, kChChestTex, kChChestPal, t.texDesc, t.palObj);
+    // Back number (G4): kept as the game set it, unless the .ppu brings a "number" atlas (kind 3),
+    // which then drives both digit textures and their palettes.
+    if (b.texDesc[3]) {
+        WriteSlot(ch, kChNumTex0, kChNumPal0, b.texDesc[3], b.palObj[3]);
+        WriteSlot(ch, kChNumTex1, kChNumPal1, b.texDesc[3], b.palObj[3]);
+    }
+}
+
+}  // namespace
+
+// --- Interfaces ---------------------------------------------------------------------------------
+uint32_t ReserveGuestMemory(uint32_t low, uint32_t high) {
+    g_arena = 0;
+    if (!RuntimeConfigFile::ArrangeCustomUniforms(false)) return high;
+    const uint32_t arena = (high - kArenaBytes) & ~0xFFFu;
+    if (high <= low || arena < low || high - low < kArenaBytes + 0x1000 || !Memory::Contains(arena, kArenaBytes)) {
+        std::fprintf(stderr, "[arrange] custom uniforms off: no room in the MEM2 arena\n");
+        return high;
+    }
+    std::memset(Memory::GetPointer(arena, kArenaBytes), 0, kArenaBytes);
+    g_arena = arena;
+    // The shared transparent 64x32 decal: all-index-0 texels (already zeroed) with its two descriptors
+    // (its palette is all zero, so index 0 reads as RGB5A3 0x0000 = fully transparent).
+    const Part t = TransparentDecal();
+    const uint32_t tex[16] = {uint32_t(32) << 16 | 64, 9, t.texels, 0, 0, 1, 1};
+    for (uint32_t i = 0; i < 16; ++i) Memory::Write32(t.texDesc + i * 4, tex[i]);
+    const uint32_t pal[8] = {256u << 16, 2, t.palette};
+    for (uint32_t i = 0; i < 8; ++i) Memory::Write32(t.palObj + i * 4, pal[i]);
+    GxGuestWrite::NotifyWrite(arena, kHeadBytes);
+    std::fprintf(stderr, "[arrange] custom uniforms on: %u KB of MEM2 at 0x%08x\n", kArenaBytes / 1024, arena);
+    return arena;
+}
+
+// ================================================================================================
+// Task 9: the "IMPORTED" row in the Uniform editor (screen vtable 0x80D3E1E0).
+//
+// A 13th, virtual row below the 12 colour / line-type rows of the left column. It is NOT a real
+// selector entry (the game clamps the column cursor to 0..11 in 0x805CBD04), so, exactly as the Logo
+// Text row does in arrange_marks.cpp, we track being on it ourselves (g_uni.onRow) by intercepting
+// the column input (0x805CA548). A / left / right cycle the imported uniform of the current side
+// (HOME / ROAD at screen+0x487C) through scan()'s folders plus a "NONE" entry; the choice is kept per
+// side in a working copy and flushed to liveChoices()[slot].uniformHome / uniformRoad on OK
+// (0x805CB1F4). Open / reload (0x805CC0F8) restores the working copy from the slot. With the option
+// off nothing is built and every hook calls the original unchanged.
+//
+// ponytail: selection is shown by the row's text colour (kColSelected), with the game's cursor box
+// left on row 11; reversing the cursor-tile system (0x805CB528, field +0x1B4) buys only a moving box.
+// Upgrade path: frame g_uni.holder with the game cursor if a user asks.
+//
+// All of this lives in a named sub-namespace so that these helpers (Call / VCall / ...) do NOT leak
+// through the file-scope `using namespace arrange_uniforms;` into other files sharing this unity TU.
+// ================================================================================================
+namespace row_ui {
+
+// --- Calls into the game (local copies; arrange_marks.cpp has its own in its own TU) -------------
+uint32_t Call(CpuContext* ctx, uint32_t target, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0, uint32_t d = 0,
+              uint32_t e = 0) {
+    const uint32_t lr = ctx->lr;
+    ctx->gpr[3] = a;
+    ctx->gpr[4] = b;
+    ctx->gpr[5] = c;
+    ctx->gpr[6] = d;
+    ctx->gpr[7] = e;
+    ctx->lr = target;
+    InvokeIndirectCpu(target, ctx);
+    ctx->lr = lr;
+    return ctx->gpr[3];
+}
+uint32_t CallF(CpuContext* ctx, uint32_t target, uint32_t a, float f1, float f2) {
+    ctx->fpr[1].d = double(f1);
+    ctx->fpr[2].d = double(f2);
+    return Call(ctx, target, a);
+}
+uint32_t VCall(CpuContext* ctx, uint32_t object, uint32_t offset, uint32_t b = 0, uint32_t c = 0) {
+    if (!object || !Memory::Contains(object, 4)) return 0;
+    const uint32_t table = Memory::Read32(object);
+    if (!Memory::Contains(table + offset, 4)) return 0;
+    const uint32_t function = Memory::Read32(table + offset);
+    return function ? Call(ctx, function, object, b, c) : 0;
+}
+void Sound(CpuContext* ctx, uint32_t id) { Call(ctx, 0x80020254, Call(ctx, 0x80010F8C), id); }
+float F(uint32_t address) { return Memory::ReadFloat32(address); }
+
+// The game's font codes: ASCII + 0x9B for letters and digits, 0 space, 0x1D hyphen, 0xFFFF end.
+// Sanitised like the marks labels: upper-case and keep only [A-Z0-9 _-], so a raw folder name with
+// lower case or accents never emits a garbage glyph.
+uint32_t WriteName(uint32_t at, const std::string& name) {
+    size_t written = 0;
+    for (size_t i = 0; i < name.size() && written < 24; ++i) {
+        char ch = name[i];
+        if (ch >= 'a' && ch <= 'z') ch = char(ch - 'a' + 'A');
+        const bool ok = (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == ' ' || ch == '-' ||
+                        ch == '_';
+        if (!ok) continue;  // drop punctuation / accented bytes
+        const uint16_t code = ch == ' ' ? 0 : ch == '-' ? 0x1D : uint16_t(uint8_t(ch) + 0x9B);
+        Memory::Write16(at + uint32_t(written) * 2, code);
+        ++written;
+    }
+    Memory::Write16(at + uint32_t(written) * 2, 0xFFFF);
+    return at;
+}
+// Cycle an index through [0, count) with a "none" (-1) slot, like arrange_marks.h's cycleChoice.
+int CycleChoice(int count, int current, int step) {
+    if (count <= 0) return -1;
+    if (current < -1 || current >= count) return -1;
+    const int span = count + 1, at = current + 1;
+    return (at + (step < 0 ? span - 1 : 1)) % span - 1;
+}
+
+// The Arrange slot being edited (0..31), or -1.
+int EditingSlotIndex() {
+    const uint32_t slot = Memory::Read32(kEditingSlot);
+    if (!slot) return -1;
+    const uint32_t block = Memory::Read32(kSlotBlock);
+    const uint32_t first = block ? block + kSlotsOffset : 0;
+    if (!block || slot < first || slot >= first + 32 * kSlotStride || (slot - first) % kSlotStride) return -1;
+    return int((slot - first) / kSlotStride);
+}
+
+// --- The IMPORTED button + uniform list ---------------------------------------------------------
+// The Uniform editor gets a bottom-bar hint "Z IMPORT" in the game font. A free button the screen
+// ignores (GC Z-trigger / Wii Remote 1-2 / Classic Minus, read device-agnostically from pad.cpp via
+// MLB_UniCycleButtonHeld) opens a selection list of the imported uniforms (scan() folders by name,
+// plus "NONE"): up/down move, A chooses, B cancels. Choosing sets the current side's (HOME/ROAD)
+// uniform in the working copy and refreshes the preview (the editor-map hook 0x805A83F0 feeds the
+// working copy to the preview recompose); OK flushes to v3, cancel/reload restores.
+constexpr uint32_t kUniSide = 0x487C;          // 0 HOME, 1 ROAD (R switches it)
+constexpr uint32_t kUniChanged = 0x41C4;       // "there are changes" flag
+constexpr uint32_t kUniStyle = 0x80CFFBB8;     // team-name text style (as the marks rows)
+constexpr uint32_t kUniLabelScratch = kDecalStride;  // scratch for one font string at a time
+static_assert(kDecalStride + 25 * 2 <= kHeadBytes, "no room for the font string in the arena head");
+constexpr uint32_t kUniButtons = 0x29C0, kNodeParent = 0x14;  // a column node, to parent in its layer
+constexpr uint32_t kColNormal = 1, kColSelected = 4;  // text colour indices (kColSelected: tune in-game)
+// All positions are in the column layer's units (column row 0 is at y 33, 26 per row). Tunable from
+// in-game screenshots.
+constexpr float kPromptX = 14.0f, kPromptY = 338.0f, kPromptScale = 0.55f;  // bottom-bar hint
+constexpr float kListX = 150.0f, kListY = 40.0f, kListStep = 28.0f, kListScale = 0.62f,
+                kListSelScale = 0.82f;  // the pop-up list
+
+enum { kClosed = 0, kListOpen = 1 };
+
+struct UniRow {
+    uint32_t screen = 0, holder = 0, text = 0;  // the bottom-bar hint
+    std::vector<Entry> entries;
+    int slot = -1;
+    std::string home, road;  // the working copy, per side
+    bool prevBtn = false, built = false;
+    int mode = kClosed, cursor = 0;             // the list
+    std::vector<uint32_t> itemHolders, itemTexts;
+} g_uni;
+
+bool UniActive(uint32_t s) { return Enabled() && s && g_uni.screen == s; }
+bool UniEditorOpen() { return Enabled() && g_uni.built && g_uni.screen != 0; }
+uint8_t UniSide(uint32_t s) { return Memory::Read8(s + kUniSide) ? 1 : 0; }
+std::string& UniPending(uint32_t s) { return UniSide(s) ? g_uni.road : g_uni.home; }
+
+int UniPendingIndex(uint32_t s) {
+    const std::string& p = UniPending(s);
+    for (size_t i = 0; i < g_uni.entries.size(); ++i)
+        if (g_uni.entries[i].folder == p) return int(i);
+    return p.empty() ? -1 : int(g_uni.entries.size());  // chosen before but no longer listed
+}
+// List item name: index 0 is "NONE", then one per scan() folder.
+std::string UniItemName(int i) {
+    if (i <= 0) return "NONE";
+    const size_t e = size_t(i - 1);
+    if (e >= g_uni.entries.size()) return "IMPORTED";
+    return g_uni.entries[e].label.empty() ? g_uni.entries[e].folder : g_uni.entries[e].label;
+}
+
+uint32_t UniNewNode(CpuContext* ctx, uint32_t parent) {
+    const uint32_t node = Call(ctx, 0x8005B060, 0x100);
+    if (!node) return 0;
+    Call(ctx, 0x8001E9BC, node);
+    Call(ctx, 0x8057A180, node, parent);
+    Call(ctx, 0x8001AC60, node, 0);
+    return node;
+}
+
+// Keep the bottom-bar hint ("Z IMPORT") placed and visible.
+void UniSync(CpuContext* ctx, uint32_t s) {
+    if (!g_uni.text) return;
+    Call(ctx, 0x807B4090, g_uni.text, kColNormal);
+    VCall(ctx, g_uni.text, 0x40, WriteName(g_arena + kUniLabelScratch, "Z IMPORT"));
+    Call(ctx, 0x807B4090, g_uni.text, kColNormal);
+    CallF(ctx, 0x8001ABA0, g_uni.holder, kPromptScale, kPromptScale);
+    CallF(ctx, 0x8001A7B0, g_uni.holder, kPromptX, kPromptY);
+    (void)s;
+}
+
+void UniBuildPrompt(CpuContext* ctx, uint32_t s) {
+    g_uni.screen = s;
+    const uint32_t parent = Memory::Read32(s + kUniButtons + kNodeParent);  // the column's layer
+    g_uni.holder = UniNewNode(ctx, parent ? parent : s);
+    if (g_uni.holder) {
+        g_uni.text = Call(ctx, 0x805C28D4, g_uni.holder, 0, Memory::Read32(kUniStyle) & 0xFFFF);
+        if (g_uni.text) {
+            Call(ctx, 0x8001AC60, g_uni.text, 0);
+            CallF(ctx, 0x8001A7B0, g_uni.text, 0, 0);
+        }
+    }
+    g_uni.built = g_uni.holder != 0;
+}
+
+// Highlight the cursor row (bigger + a different colour) and place every item.
+void UniRefreshList(CpuContext* ctx, uint32_t) {
+    for (size_t i = 0; i < g_uni.itemHolders.size(); ++i) {
+        const bool sel = int(i) == g_uni.cursor;
+        if (g_uni.itemHolders[i]) {
+            const float sc = sel ? kListSelScale : kListScale;
+            CallF(ctx, 0x8001ABA0, g_uni.itemHolders[i], sc, sc);
+            CallF(ctx, 0x8001A7B0, g_uni.itemHolders[i], kListX, kListY + float(i) * kListStep);
+        }
+        if (g_uni.itemTexts[i]) Call(ctx, 0x807B4090, g_uni.itemTexts[i], sel ? kColSelected : kColNormal);
+    }
+}
+
+void UniOpenList(CpuContext* ctx, uint32_t s) {
+    if (g_uni.mode == kListOpen) return;
+    const uint32_t parent = Memory::Read32(s + kUniButtons + kNodeParent);
+    const uint32_t layer = parent ? parent : s;
+    const uint32_t style = Memory::Read32(kUniStyle) & 0xFFFF;
+    const int n = int(g_uni.entries.size()) + 1;  // "NONE" + folders
+    for (int i = 0; i < n; ++i) {
+        const uint32_t h = UniNewNode(ctx, layer);
+        uint32_t t = 0;
+        if (h) {
+            t = Call(ctx, 0x805C28D4, h, 0, style);
+            if (t) {
+                Call(ctx, 0x8001AC60, t, 0);
+                CallF(ctx, 0x8001A7B0, t, 0, 0);
+                VCall(ctx, t, 0x40, WriteName(g_arena + kUniLabelScratch, UniItemName(i)));
+            }
+        }
+        g_uni.itemHolders.push_back(h);
+        g_uni.itemTexts.push_back(t);
+    }
+    const int pi = UniPendingIndex(s);
+    g_uni.cursor = (pi < 0 || pi + 1 >= n) ? 0 : pi + 1;
+    g_uni.mode = kListOpen;
+    UniRefreshList(ctx, s);
+}
+
+void UniCloseList(CpuContext* ctx) {
+    for (uint32_t t : g_uni.itemTexts)
+        if (t) VCall(ctx, t, 0x08, 1);
+    for (uint32_t h : g_uni.itemHolders)
+        if (h) VCall(ctx, h, 0x08, 1);
+    g_uni.itemTexts.clear();
+    g_uni.itemHolders.clear();
+    g_uni.mode = kClosed;
+}
+
+void UniPreviewRefresh(CpuContext* ctx, uint32_t s) { Call(ctx, 0x805CC73C, s, 1); }
+
+void UniChoose(CpuContext* ctx, uint32_t s) {
+    UniPending(s) = g_uni.cursor == 0 ? std::string() : g_uni.entries[size_t(g_uni.cursor - 1)].folder;
+    Memory::Write8(s + kUniChanged, 1);
+    Sound(ctx, 0x1001);
+    UniCloseList(ctx);
+    UniPreviewRefresh(ctx, s);
+    UniSync(ctx, s);
+}
+
+// List input (A/B/up/down) via the global edge queries; the game's column input is NOT run while open.
+void UniListInput(CpuContext* ctx, uint32_t s) {
+    const auto pressed = [&](uint32_t q) { return Call(ctx, q, 0) != 0; };
+    const int n = int(g_uni.itemHolders.size());
+    if (n <= 0) { UniCloseList(ctx); return; }
+    if (pressed(0x805EF2D8)) {  // up
+        g_uni.cursor = (g_uni.cursor + n - 1) % n;
+        Sound(ctx, 0x1004);
+        UniRefreshList(ctx, s);
+    } else if (pressed(0x805EF2E0)) {  // down
+        g_uni.cursor = (g_uni.cursor + 1) % n;
+        Sound(ctx, 0x1004);
+        UniRefreshList(ctx, s);
+    } else if (pressed(0x805EF2F8)) {  // A: choose
+        UniChoose(ctx, s);
+    } else if (pressed(0x805EF300)) {  // B: cancel
+        Sound(ctx, 0x1002);
+        UniCloseList(ctx);
+        UniSync(ctx, s);
+    }
+}
+
+void UniTeardown(CpuContext* ctx) {
+    UniCloseList(ctx);
+    for (uint32_t node : {g_uni.text, g_uni.holder})
+        if (node) VCall(ctx, node, 0x08, 1);
+    g_uni = {};
+}
+
+// Once per frame while the Uniform column is up and the list is closed: the free button (rising edge)
+// opens the list; the bottom-bar hint is kept placed.
+void UniFrame(CpuContext* ctx, uint32_t s) {
+    const bool held = MLB_UniCycleButtonHeld();
+    const bool edge = held && !g_uni.prevBtn;
+    g_uni.prevBtn = held;
+    if (edge) {
+        Sound(ctx, 0x1004);
+        UniOpenList(ctx, s);
+        return;
+    }
+    UniSync(ctx, s);
+}
+
+}  // namespace row_ui
+
+// For arrange_marks.cpp: the save/choice system is on when marks OR uniforms reserved their arena.
+bool Reserved() { return g_arena != 0; }
+
+}  // namespace arrange_uniforms
+
+using namespace arrange_uniforms;
+
+// 0x806DC9E8(char, desc): after the game applies the uniform, overwrite this character's body / cap /
+// helmet / chest slots if its manager idx has a chosen imported uniform.
+extern "C" void MLB_ArrangeUniformApply_806DC9E8(CpuContext* ctx) {
+    const uint32_t ch = ctx->gpr[3], desc = ctx->gpr[4];
+    func_806DC9E8(ctx);
+    if (!Enabled()) return;
+    const int idx = IdxOfDescriptor(desc);
+    if (g_trace)
+        std::fprintf(stderr, "[arrange-uniform] 806DC9E8 enter char=%08x desc=%08x mgr=%08x idx=%d\n", ch, desc,
+                     Manager(), idx);
+    if (idx < 0 || ch < 0x80000000u || !Memory::Contains(ch, 0x170)) return;
+    const std::string& folder = g_idxFolder[size_t(idx)];
+    if (folder.empty()) return;
+    Built b;
+    const bool ok = LoadUniform(folder, b);
+    if (g_trace)
+        std::fprintf(stderr, "[arrange-uniform] 806DC9E8 char=%08x idx=%d folder='%s' ok=%d\n", ch, idx,
+                     folder.c_str(), ok ? 1 : 0);
+    if (ok) ApplyUniform(ch, b);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x806DC9E8, MLB_ArrangeUniformApply_806DC9E8, "MLB_ArrangeUniformApply_806DC9E8");
+
+// 0x805A83F0(record): the editor / Original Team path composes idx 0 (home) and 1 (away) of `record`.
+extern "C" void MLB_ArrangeUniformEditorMap_805A83F0(CpuContext* ctx) {
+    if (Enabled()) {
+        // The editor / Original Team hand a stack copy of the record; choiceFor needs the real slot.
+        uint32_t record = EditingRecord();
+        if (!record && ValidRecord(ctx->gpr[3])) record = ctx->gpr[3];
+        if (record) {
+            SetIdxFromRecord(0, record, true);
+            SetIdxFromRecord(1, record, false);
+            // While the Uniform editor is open, the preview must show the working copy (not the saved
+            // choice), so the list selection previews live before OK.
+            if (row_ui::UniEditorOpen()) {
+                g_idxFolder[0] = row_ui::g_uni.home;
+                g_idxFolder[1] = row_ui::g_uni.road;
+            }
+            if (g_trace)
+                std::fprintf(stderr, "[arrange-uniform] 805A83F0 rec=%08x home='%s' road='%s'\n", record,
+                             g_idxFolder[0].c_str(), g_idxFolder[1].c_str());
+        }
+    }
+    func_805A83F0(ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x805A83F0, MLB_ArrangeUniformEditorMap_805A83F0, "MLB_ArrangeUniformEditorMap_805A83F0");
+
+// 0x806C10FC(idx, bytes, initial): match / exhibition fill of one manager idx from a record's home
+// (record+0x1C) or away (record+0x26) uniform bytes.
+extern "C" void MLB_ArrangeUniformMatchMap_806C10FC(CpuContext* ctx) {
+    if (Enabled()) {
+        const uint32_t idx = ctx->gpr[3], bytes = ctx->gpr[4];
+        uint32_t record = 0;
+        bool home = false;
+        if (idx < kMaxIdx && RecordFromBytes(bytes, record, home)) SetIdxFromRecord(int(idx), record, home);
+    }
+    func_806C10FC(ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x806C10FC, MLB_ArrangeUniformMatchMap_806C10FC, "MLB_ArrangeUniformMatchMap_806C10FC");
+
+// 0x806BD974(manager, mode): the manager is (re)loaded; forget the previous idx->folder map.
+extern "C" void MLB_ArrangeUniformManagerLoad_806BD974(CpuContext* ctx) {
+    if (Enabled()) ClearIdx();
+    func_806BD974(ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x806BD974, MLB_ArrangeUniformManagerLoad_806BD974, "MLB_ArrangeUniformManagerLoad_806BD974");
+
+// 0x806BD8D0: the manager is destroyed; forget the map.
+extern "C" void MLB_ArrangeUniformManagerFree_806BD8D0(CpuContext* ctx) {
+    if (Enabled()) ClearIdx();
+    func_806BD8D0(ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x806BD8D0, MLB_ArrangeUniformManagerFree_806BD8D0, "MLB_ArrangeUniformManagerFree_806BD8D0");
+
+// --- Task 9: the IMPORTED row in the Uniform editor ---------------------------------------------
+
+// 0x805CA37C (vt +0x30): the game builds the screen, then we add the IMPORTED row when the slot has
+// something to pick or a choice to take back.
+extern "C" void MLB_ArrangeUniformScreenBuild_805CA37C(CpuContext* ctx) {
+    const uint32_t s = ctx->gpr[3];
+    func_805CA37C(ctx);
+    const uint32_t ret = ctx->gpr[3];  // M1: keep the original's return for the caller
+    if (!Enabled() || !s || row_ui::g_uni.screen == s) return;
+    const int slot = row_ui::EditingSlotIndex();
+    if (slot < 0) return;
+    std::vector<Entry> entries = scan(UniformsRoot());
+    const Choice& live = arrange_marks::liveChoices()[size_t(slot)];
+    if (entries.empty() && live.uniformHome.empty() && live.uniformRoad.empty()) return;
+    const uint32_t lr = ctx->lr;
+    row_ui::g_uni.entries = std::move(entries);
+    row_ui::g_uni.slot = slot;
+    // I2: start the working copy on the slot's saved choice here too, not only in open/reload, so OK
+    // never flushes an empty choice over a saved one when build runs without a following open.
+    row_ui::g_uni.home = live.uniformHome;
+    row_ui::g_uni.road = live.uniformRoad;
+    row_ui::g_uni.prevBtn = false;
+    row_ui::UniBuildPrompt(ctx, s);
+    row_ui::UniSync(ctx, s);
+    ctx->lr = lr;
+    ctx->gpr[3] = ret;
+}
+REGISTER_NATIVE_FUNCTION_AS(0x805CA37C, MLB_ArrangeUniformScreenBuild_805CA37C, "MLB_ArrangeUniformScreenBuild_805CA37C");
+
+// 0x805CC0F8: open / reload from the slot. The working copy starts on the slot's saved choice.
+extern "C" void MLB_ArrangeUniformScreenOpen_805CC0F8(CpuContext* ctx) {
+    const uint32_t s = ctx->gpr[3];
+    func_805CC0F8(ctx);
+    const uint32_t ret = ctx->gpr[3];  // M1: keep the original's return for the caller
+    if (!row_ui::UniActive(s)) return;
+    const uint32_t lr = ctx->lr;
+    row_ui::g_uni.slot = row_ui::EditingSlotIndex();
+    const Choice live =
+        row_ui::g_uni.slot >= 0 ? arrange_marks::liveChoices()[size_t(row_ui::g_uni.slot)] : Choice{};
+    row_ui::g_uni.home = live.uniformHome;
+    row_ui::g_uni.road = live.uniformRoad;
+    row_ui::g_uni.prevBtn = false;
+    row_ui::UniSync(ctx, s);
+    ctx->lr = lr;
+    ctx->gpr[3] = ret;
+}
+REGISTER_NATIVE_FUNCTION_AS(0x805CC0F8, MLB_ArrangeUniformScreenOpen_805CC0F8, "MLB_ArrangeUniformScreenOpen_805CC0F8");
+
+// 0x805CA548: the Uniform column input (runs each frame in column mode). With the list open we take
+// all input (and do NOT run the game's column input); otherwise the game runs, then our per-frame
+// step watches the free button and keeps the hint placed.
+extern "C" void MLB_ArrangeUniformColumnInput_805CA548(CpuContext* ctx) {
+    const uint32_t s = ctx->gpr[3];
+    if (row_ui::UniActive(s) && row_ui::g_uni.built && row_ui::g_uni.mode == row_ui::kListOpen) {
+        const uint32_t lr = ctx->lr;
+        row_ui::UniListInput(ctx, s);
+        ctx->lr = lr;
+        ctx->gpr[3] = 1;  // handled
+        return;
+    }
+    func_805CA548(ctx);
+    const uint32_t ret = ctx->gpr[3];
+    if (row_ui::UniActive(s) && row_ui::g_uni.built) {
+        const uint32_t lr = ctx->lr;
+        row_ui::UniFrame(ctx, s);
+        ctx->lr = lr;
+    }
+    ctx->gpr[3] = ret;
+}
+REGISTER_NATIVE_FUNCTION_AS(0x805CA548, MLB_ArrangeUniformColumnInput_805CA548, "MLB_ArrangeUniformColumnInput_805CA548");
+
+// 0x805CB1F4 (vt +0xDC): OK. The working copy goes to the slot's choice (the game still writes the
+// record's backup bytes and flags as usual).
+extern "C" void MLB_ArrangeUniformScreenConfirm_805CB1F4(CpuContext* ctx) {
+    const uint32_t s = ctx->gpr[3];
+    if (row_ui::UniActive(s) && row_ui::g_uni.slot >= 0) {
+        Choice& live = arrange_marks::liveChoices()[size_t(row_ui::g_uni.slot)];
+        live.uniformHome = row_ui::g_uni.home;
+        live.uniformRoad = row_ui::g_uni.road;
+    }
+    func_805CB1F4(ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x805CB1F4, MLB_ArrangeUniformScreenConfirm_805CB1F4, "MLB_ArrangeUniformScreenConfirm_805CB1F4");
+
+// 0x805C9EF4 (vt +0x08): the screen is destroyed; the row's nodes go first.
+extern "C" void MLB_ArrangeUniformScreenDtor_805C9EF4(CpuContext* ctx) {
+    const uint32_t s = ctx->gpr[3], r4 = ctx->gpr[4], r5 = ctx->gpr[5];
+    if (row_ui::UniActive(s)) {
+        const uint32_t lr = ctx->lr;
+        row_ui::UniTeardown(ctx);  // its VCall(...,0x08,1) clobbers r4/r5
+        ctx->lr = lr;
+        ctx->gpr[3] = s;
+        ctx->gpr[4] = r4;  // I1: restore the caller's args so vt+0x08 frees exactly as asked
+        ctx->gpr[5] = r5;
+    }
+    func_805C9EF4(ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x805C9EF4, MLB_ArrangeUniformScreenDtor_805C9EF4, "MLB_ArrangeUniformScreenDtor_805C9EF4");
