diff --git a/runtime/tests/mod_saves_tests.cpp b/runtime/tests/mod_saves_tests.cpp
new file mode 100644
index 0000000..b82b2bc
--- /dev/null
+++ b/runtime/tests/mod_saves_tests.cpp
@@ -0,0 +1,23 @@
+#include "mods.h"
+#include <cstdlib>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    using mods::Mod;
+    auto mod = [](const char* id, const char* name, bool enabled, bool roster) {
+        Mod m;
+        m.id = id;
+        m.name = name;
+        m.enabled = enabled;
+        m.changesRoster = roster;
+        return m;
+    };
+    // No roster mod on: the normal saves.
+    require(mods::SaveSetName({}).empty());
+    require(mods::SaveSetName({mod("Tex", "HD textures", true, false), mod("R26", "2026 Rosters", false, true)}).empty());
+    // Roster mods on: their names, in the order of their folders (as SaveDirectoryFor sorts them).
+    require(mods::SaveSetName({mod("R26", "2026 Rosters", true, true)}) == "2026 Rosters");
+    require(mods::SaveSetName({mod("Zz", "Zeta", true, true), mod("Tex", "HD textures", true, false), mod("Aa", "Alpha", true, true)}) ==
+            "Alpha + Zeta");
+    // A mod with no name shows its folder.
+    require(mods::SaveSetName({mod("R26", "", true, true)}) == "R26");
+}
