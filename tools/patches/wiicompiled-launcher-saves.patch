 #include <aurora/aurora.h>
 
+#include <algorithm>
 #include <cstdint>
 #include <filesystem>
 #include <string>
@@ -93,5 +94,16 @@ void Apply(AuroraConfig& config);
 // enabled data-changing mods, or empty for the normal saves. Valid after Apply.
 std::filesystem::path SaveDirectory();
 std::filesystem::path SaveDirectoryFor(const std::vector<Mod>& mods);
+// The enabled roster-changing mods whose saves are in use, by name in folder order ("Alpha + Zeta"),
+// or empty for the normal saves (the launcher shows it).
+inline std::string SaveSetName(const std::vector<Mod>& all) {
+    std::vector<const Mod*> on;
+    for (const Mod& mod : all)
+        if (mod.enabled && mod.changesRoster) on.push_back(&mod);
+    std::sort(on.begin(), on.end(), [](const Mod* a, const Mod* b) { return a->id < b->id; });
+    std::string name;
+    for (const Mod* mod : on) name += (name.empty() ? "" : " + ") + (mod->name.empty() ? mod->id : mod->name);
+    return name;
+}
 
 } // namespace mods
