diff --git a/runtime/include/callnames.h b/runtime/include/callnames.h
new file mode 100644
index 0000000..287b89f
--- /dev/null
+++ b/runtime/include/callnames.h
@@ -0,0 +1,148 @@
+// New player callnames from mods (mods/<mod>/callnames/callnames.toml + WAVs): encoded to the
+// game's DSP-ADPCM, appended to voice banks 14/15/17 and added to the editor's name lists.
+// docs/superpowers/specs/2026-10-31-callnames-design.md; RE in docs/ingenieria-inversa.md
+// ("Bancos de voz y nombres de jugador").
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "hle/dvd_contract.h"
+#include "mods.h"
+
+namespace callnames {
+
+constexpr uint32_t kRate = 22050;
+constexpr uint32_t kMaxSeconds = 5;
+
+// 16-bit PCM WAV (mono or stereo, any rate) to mono at kRate. False with `error` set for anything
+// else (8/24-bit, float, empty, longer than kMaxSeconds, broken header); never throws.
+bool ReadWav(const std::filesystem::path& path, std::vector<int16_t>& mono, std::string& error);
+// Scales so the loudest sample is `peak` (the game's names peak around 29000). Silence stays.
+void Normalize(std::vector<int16_t>& samples, int16_t peak = 29000);
+
+struct Adpcm {
+    std::array<int16_t, 16> coefs{};
+    std::vector<uint8_t> data;  // 8-byte frames (header byte + 14 nibbles), the last one partial
+    uint32_t samples = 0;
+};
+// Bytes of DSP-ADPCM for `samples` samples; the nibble count the phrase header stores is twice this.
+uint32_t AdpcmBytes(uint32_t samples);
+Adpcm Encode(const std::vector<int16_t>& samples);  // deterministic
+std::vector<int16_t> Decode(const Adpcm& adpcm);
+
+constexpr uint32_t kFirstVoice = 7223;  // VoiceIds whose phrase ids fall in gaps no bank uses
+constexpr uint32_t kLastVoice = 10239;
+constexpr size_t kMaxListChars = 15;
+
+struct Callname {
+    uint32_t voice = 0;
+    std::string list;            // as written in callnames.toml
+    std::u16string listGame;     // list B text in the game's character codes (accents removed)
+    std::u16string listUpper;    // list A text: upper case, only A-Z, '-' and '.'
+    std::filesystem::path normal, excited, full;  // excited/full fall back to normal
+    std::string mod;             // mod folder, for messages
+};
+
+// The game's 16-bit character codes for UTF-8 text: accents removed (Acuña -> Acuna), anything the
+// game cannot show dropped and listed in `dropped`.
+std::u16string ToGameText(const std::string& utf8, std::string& dropped);
+// The callnames of the enabled mods with a callnames/ folder, in mod order. A bad entry is skipped
+// with a line in `warnings`; a voice already taken by an earlier mod too.
+std::vector<Callname> Collect(const std::vector<mods::Mod>& enabled, std::vector<std::string>& warnings);
+
+// A WAV read, normalized and encoded; the result is kept in cacheDir under a hash of the WAV's bytes
+// (and the encoder version), so a changed file is encoded again even with the same name and size.
+bool EncodeCached(const std::filesystem::path& wav, const std::filesystem::path& cacheDir, Adpcm& out,
+                  std::string& error);
+
+constexpr uint32_t kSector = 0x800;
+
+// A voice bank served as a virtual file: header and index rewritten for the larger phrase count,
+// the original phrases, then the new ones (cacheDir/voice<bank>.ext holds them and the new index).
+struct BankBuild {
+    DvdReadContract::Virtual::File file;
+    uint32_t count = 0;               // phrases in the new index
+    std::vector<uint32_t> added;      // locals that got a phrase
+    std::vector<std::string> warnings;
+};
+// `phrases`: (local index, audio). Locals between the original count and a new one point to the
+// filler phrase (local 0); a phrase whose sector would reach 0x10000 is dropped with a warning.
+bool BuildBank(int bank, const std::filesystem::path& original,
+               const std::vector<std::pair<uint32_t, Adpcm>>& phrases, const std::filesystem::path& cacheDir,
+               BankBuild& out, std::string& error, uint32_t sectorLimit = 0x10000);
+
+// The game's phrase id -> bank (0x8003B398) and -> local index (0x8003B530, -1 for none), with the
+// hard-coded ranges of banks 14, 15 and 17 grown to the phrase counts their callname builds have
+// (0: the original count). Bit-identical to the original for every id when nothing grew.
+void SetBankCounts(uint32_t bank14, uint32_t bank15, uint32_t bank17);
+uint32_t PhraseBank(uint32_t id);
+int32_t PhraseLocal(uint32_t id);
+
+// The commentary's voice-key converters (key = 0x8000 + VoiceId; docs/ingenieria-inversa.md), each the
+// original's for every input except a callname's, which they also accept:
+//   RemapKey (0x80659DE8): key -> bank-14 id (normal surname); bank-7 id -> bank-15 id
+//   Excited  (0x80659C98): key -> bank-7 id; bank-14 id -> bank-15 id (excited surname)
+//   ColourName (0x80659F70): key -> bank-17 id (full name, colour commentator)
+//   Variant  (0x8065A14C): key -> list B's 4th recording (bank 14) or, with `other`, a bank-6 id;
+//            a callname has no 4th recording: its normal surname, and nothing with `other`.
+uint32_t RemapKey(uint32_t x);
+uint32_t Excited(uint32_t x);
+uint32_t ColourName(uint32_t x);
+uint32_t Variant(uint32_t x, bool other);
+
+// env_voice_data.pack (file 3081): where its name lists are. Offsets are from the pack's start, as the
+// game asks for them (0x8000BBFC(3081, 0x40000000 | offset)); names are 15 game characters (30 bytes).
+struct VoiceListLayout {
+    uint32_t keysA = 0x20, namesA = 0x1E0C, countA = 0x77B;      // generic surnames (Search Type)
+    uint32_t keysB = 0xFEB4, namesB = 0x10ED0, countB = 0x3CA;  // MLB players by initial (Select Type)
+    uint32_t letters = 0xFE80;                                  // 26 s16: list B position of each letter
+    uint32_t keysC = 0x10DDC, namesC = 0x1807C, countC = 0x3D;  // legends
+};
+constexpr uint16_t kLetterHeading = 0xFEFE;  // list B key of a letter's heading row (name 0x2000 | letter)
+// The pack with the names added: list A sorted (upper-case form), list B inside its initial's group
+// (a new group, and its letter entry, when the initial had none). The original lists stay where they
+// were; the grown A and B and the letter table go at the end. `layout` comes in as the original's
+// and goes out as the new pack's.
+bool BuildVoiceList(const std::vector<uint8_t>& original, const std::vector<Callname>& names,
+                    std::vector<uint8_t>& out, VoiceListLayout& layout);
+void SetVoiceListLayout(const VoiceListLayout& layout);
+const VoiceListLayout& CurrentVoiceListLayout();
+
+// The lookups of 0x807EDF4C (name offset by key, 0 = none) and 0x807EE0C8 (1 = list B or C,
+// 2 = list A, 0 = none), with the original's order: list B for keys 0x8803-0x8DF5, list C for
+// 0x8E40-0x91BB, then list A; a callname key (0x8000 + a callname voice) is looked up in B then A.
+// `read32(offset)` reads the pack.
+template <typename Read32>
+uint32_t FindVoiceName(const VoiceListLayout& l, uint32_t key, Read32&& read32, int* list = nullptr) {
+    auto search = [&](uint32_t keys, uint32_t names, uint32_t count) -> uint32_t {
+        for (uint32_t i = 0; i < count; ++i)
+            if (read32(keys + 4 * i) == key) return names + 30 * i;
+        return 0;
+    };
+    if (list) *list = 0;
+    if (key == 0) return 0;
+    const bool isNew = key - 0x8000 >= kFirstVoice && key - 0x8000 <= kLastVoice;
+    uint32_t at = 0;
+    if ((key > 0x8802 && key < 0x8DF6) || isNew) at = search(l.keysB, l.namesB, l.countB);
+    else if (key > 0x8E3F && key < 0x91BC) at = search(l.keysC, l.namesC, l.countC);
+    if (at) {
+        if (list) *list = 1;
+        return at;
+    }
+    at = search(l.keysA, l.namesA, l.countA);
+    if (at && list) *list = 2;
+    return at;
+}
+
+// Start-up (mods::Apply, before DVDInit): encodes the enabled mods' callnames (cached in cacheDir),
+// registers the grown voice banks as virtual files and grows the phrase-id ranges. Returns the
+// callnames that got into the banks (mods::Apply then adds them to the editor's list); none, and
+// nothing changed, without callname mods.
+std::vector<Callname> Mount(const std::vector<mods::Mod>& mods, const std::filesystem::path& cacheDir);
+
+}  // namespace callnames
