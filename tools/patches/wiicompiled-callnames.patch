+// A RIFF/WAVE file with a PCM-style fmt chunk; `format` 1 = PCM, 3 = float.
+static void WriteWav(const fs::path& path, uint16_t format, uint16_t channels, uint32_t rate, uint16_t bits,
+                     const std::vector<uint8_t>& data) {
+    auto u32 = [](std::vector<uint8_t>& out, uint32_t v) { for (int i = 0; i < 4; ++i) out.push_back(uint8_t(v >> (8 * i))); };
+    auto u16 = [](std::vector<uint8_t>& out, uint16_t v) { out.push_back(uint8_t(v)); out.push_back(uint8_t(v >> 8)); };
+    std::vector<uint8_t> out;
+    out.insert(out.end(), {'R', 'I', 'F', 'F'});
+    u32(out, uint32_t(36 + data.size()));
+    out.insert(out.end(), {'W', 'A', 'V', 'E', 'f', 'm', 't', ' '});
+    u32(out, 16);
+    u16(out, format);
+    u16(out, channels);
+    u32(out, rate);
+    u32(out, rate * channels * bits / 8);
+    u16(out, uint16_t(channels * bits / 8));
+    u16(out, bits);
+    out.insert(out.end(), {'d', 'a', 't', 'a'});
+    u32(out, uint32_t(data.size()));
+    out.insert(out.end(), data.begin(), data.end());
+    std::ofstream(path, std::ios::binary).write(reinterpret_cast<const char*>(out.data()), std::streamsize(out.size()));
+}
+
+static std::vector<uint8_t> Pcm16(const std::vector<int16_t>& samples) {
+    std::vector<uint8_t> out;
+    for (int16_t s : samples) { out.push_back(uint8_t(s)); out.push_back(uint8_t(uint16_t(s) >> 8)); }
+    return out;
+}
+
+static std::vector<int16_t> Sine(double hz, uint32_t rate, uint32_t count, double amplitude) {
+    std::vector<int16_t> out(count);
+    for (uint32_t i = 0; i < count; ++i) out[i] = int16_t(std::lround(amplitude * std::sin(2 * 3.14159265358979 * hz * i / rate)));
+    return out;
+}
