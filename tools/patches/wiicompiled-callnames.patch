+static void Put32(std::vector<uint8_t>& b, size_t at, uint32_t v) { for (int i = 0; i < 4; ++i) b[at + i] = uint8_t(v >> (24 - 8 * i)); }
+static void Put16(std::vector<uint8_t>& b, size_t at, uint16_t v) { b[at] = uint8_t(v >> 8); b[at + 1] = uint8_t(v); }
+static uint32_t Get32(const std::vector<uint8_t>& b, size_t at) { return uint32_t(b[at]) << 24 | b[at + 1] << 16 | b[at + 2] << 8 | b[at + 3]; }
+static uint16_t Get16(const std::vector<uint8_t>& b, size_t at) { return uint16_t(b[at] << 8 | b[at + 1]); }
+
+// A bank like voiceN.bin: sector 0 header, 4 phrases (header sector + 1 data sector each, ms = 100 + i),
+// the index (sectors then ms) and a 0x80-byte tail.
+static fs::path SyntheticBank(const fs::path& dir) {
+    const uint32_t count = 4, indexSector = 1 + 2 * count;
+    std::vector<uint8_t> b((indexSector + 1) * callnames::kSector, 0);
+    Put32(b, 0, 0x005A8AAB);
+    Put32(b, 4, indexSector);
+    Put32(b, 8, count);
+    Put32(b, 12, count * 4);
+    Put32(b, 16, count);
+    Put32(b, 20, 0x80);
+    for (uint32_t i = 0; i < count; ++i) {
+        const size_t h = (1 + 2 * i) * callnames::kSector;
+        Put32(b, h + 0, 16);
+        Put32(b, h + 4, 0xB4u << 16 | 22050);
+        Put32(b, h + 0x10, 100 + i);
+        Put32(b, h + 0x88, 32);
+        Put32(b, h + 0x8C, 2);
+        b[h + callnames::kSector] = uint8_t(0xA0 + i);  // first data byte, to recognise the phrase
+        Put16(b, indexSector * callnames::kSector + 2 * i, uint16_t(1 + 2 * i));
+        Put16(b, indexSector * callnames::kSector + 2 * count + 2 * i, uint16_t(100 + i));
+    }
+    const size_t tail = indexSector * callnames::kSector + 4 * count;
+    for (size_t i = tail; i < tail + 0x80; ++i) b[i] = 0x5C;
+    const fs::path path = dir / "voice15.bin";
+    std::ofstream(path, std::ios::binary).write(reinterpret_cast<const char*>(b.data()), std::streamsize(b.size()));
+    return path;
+}
+
+static std::vector<uint8_t> ReadVirtual(const callnames::BankBuild& build) {
+    std::vector<uint8_t> out;
+    DvdReadContract::HostReadFailure failure;
+    const bool ok = DvdReadContract::Virtual::Read(build.file, 0, uint32_t(build.file.size), out, failure,
+        [](const fs::path& path, uint64_t offset, uint32_t length, uint8_t* dst, DvdReadContract::HostReadFailure&) {
+            std::ifstream in(path, std::ios::binary);
+            in.seekg(std::streamoff(offset));
+            in.read(reinterpret_cast<char*>(dst), length);
+            return in.gcount() == std::streamsize(length);
+        });
+    CHECK(ok);
+    return out;
+}
+
+static void TestBuildBank(const fs::path& dir) {
+    const fs::path original = SyntheticBank(dir);
+    const callnames::Adpcm six = callnames::Encode(Sine(300, callnames::kRate, 2205, 9000));   // 100 ms
+    const callnames::Adpcm nine = callnames::Encode(Sine(500, callnames::kRate, 4410, 9000));  // 200 ms
+    callnames::BankBuild build;
+    std::string error;
+    CHECK(callnames::BuildBank(15, original, {{6, six}, {9, nine}}, dir / "cache", build, error));
+    CHECK(error.empty());
+    CHECK(build.count == 10);
+    CHECK((build.added == std::vector<uint32_t>{6, 9}));
+    const std::vector<uint8_t> v = ReadVirtual(build);
+    if (v.size() < 0x1000) return;
+    CHECK(Get32(v, 0) == 0x005A8AAB);
+    const uint32_t indexSector = Get32(v, 4);
+    CHECK(Get32(v, 8) == 10 && Get32(v, 12) == 40 && Get32(v, 16) == 10 && Get32(v, 20) == 0x80);
+    const size_t index = size_t(indexSector) * callnames::kSector;
+    CHECK(v.size() >= index + 40 + 0x80);
+    if (v.size() < index + 40 + 0x80) return;
+    auto sector = [&](uint32_t local) { return Get16(v, index + 2 * local); };
+    auto ms = [&](uint32_t local) { return Get16(v, index + 20 + 2 * local); };
+    for (uint32_t i = 0; i < 4; ++i) {
+        CHECK(sector(i) == 1 + 2 * i);
+        CHECK(ms(i) == 100 + i);
+        CHECK(v[(sector(i) + 1) * callnames::kSector] == 0xA0 + i);  // original phrases untouched
+    }
+    for (uint32_t i : {4u, 5u, 7u, 8u}) CHECK(sector(i) == sector(0) && ms(i) == ms(0));
+    CHECK(sector(9) > sector(6) && sector(6) >= 9);
+    const size_t h9 = size_t(sector(9)) * callnames::kSector;
+    CHECK(Get32(v, h9 + 0x10) == 200 && ms(9) == 200);
+    CHECK(Get32(v, h9 + 0) == callnames::AdpcmBytes(4410));
+    CHECK(Get32(v, h9 + 0x88) == 2 * callnames::AdpcmBytes(4410));
+    CHECK(Get32(v, h9 + 4) == (0xB4u << 16 | 22050));
+    CHECK(Get32(v, h9 + 0x8C) == 2);
+    CHECK(int16_t(Get16(v, h9 + 0x92)) == nine.coefs[1]);
+    CHECK(Get16(v, h9 + 0xB2) == nine.data[0]);
+    CHECK(std::memcmp(&v[h9 + callnames::kSector], nine.data.data(), nine.data.size()) == 0);
+    CHECK(v[index + 40] == 0x5C && v[index + 40 + 0x7F] == 0x5C);  // the tail follows the new index
+
+    // A phrase that would start at the sector limit (0x10000 in the game; 11 here) or later is dropped.
+    callnames::BankBuild big;
+    CHECK(callnames::BuildBank(15, original, {{5, six}, {6, six}, {7, six}}, dir / "cache", big, error, 11));
+    CHECK((big.added == std::vector<uint32_t>{5}));
+    CHECK(big.warnings.size() == 2);
+}
