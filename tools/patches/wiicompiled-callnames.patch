+static void CheckConverter(const char* name, const ConvRun* runs, size_t count, uint32_t (*fn)(uint32_t)) {
+    int mismatches = 0;
+    for (size_t r = 0; r < count; ++r)
+        for (uint32_t x = runs[r].first; x <= runs[r].last; ++x) {
+            const bool isCallname = (x - 0x8000 >= 7223 && x - 0x8000 <= 10239) || (x - 0xA000 >= 7223 && x - 0xA000 <= 10239) ||
+                                    (x - 0x10800 >= 7223 && x - 0x10800 <= 10239);
+            if (isCallname) continue;  // the callname inputs are the only ones allowed to differ
+            const uint32_t expected = runs[r].zero ? 0 : x + runs[r].delta;
+            if (fn(x) != expected && mismatches++ < 3) std::fprintf(stderr, "%s(%X) = %X, original %X\n", name, x, fn(x), expected);
+        }
+    CHECK(mismatches == 0);
+}
