+// WAV reading and the DSP-ADPCM encoder for callnames (callnames.h).
+#include "callnames.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <fstream>
+#include <limits>
+
+namespace callnames {
+
+namespace {
+
+uint32_t Le32(const uint8_t* p) { return p[0] | p[1] << 8 | p[2] << 16 | uint32_t(p[3]) << 24; }
+uint16_t Le16(const uint8_t* p) { return uint16_t(p[0] | p[1] << 8); }
+
+int16_t Clamp16(int64_t v) { return int16_t(std::clamp<int64_t>(v, -32768, 32767)); }
+
+// One frame: 14 samples coded against the decoder's history (h1, h2) with a coefficient pair and a
+// scale exponent; returns the squared error and fills the nibbles and the new history.
+int64_t CodeFrame(const int16_t* x, int count, int c1, int c2, int exponent, int& h1, int& h2, int8_t* nibbles) {
+    const int scale = 1 << exponent;
+    int64_t error = 0;
+    for (int i = 0; i < count; ++i) {
+        const int64_t predicted = int64_t(c1) * h1 + int64_t(c2) * h2;
+        const double ideal = (double(x[i]) * 2048 - double(predicted)) / (double(scale) * 2048);
+        const int n = int(std::clamp<long>(std::lround(ideal), -8, 7));
+        const int v = Clamp16((int64_t(n) * scale * 2048 + predicted + 1024) >> 11);
+        nibbles[i] = int8_t(n);
+        error += int64_t(x[i] - v) * (x[i] - v);
+        h2 = h1;
+        h1 = v;
+    }
+    return error;
+}
+
+// Least-squares order-2 predictor of a frame (x[n] ~ a x[n-1] + b x[n-2]), as 11-bit fixed point.
+std::array<int, 2> FramePredictor(const std::vector<int16_t>& s, size_t start, size_t count) {
+    double r11 = 0, r12 = 0, r22 = 0, q1 = 0, q2 = 0;
+    for (size_t i = start; i < start + count; ++i) {
+        const double x = s[i], p1 = i >= 1 ? s[i - 1] : 0, p2 = i >= 2 ? s[i - 2] : 0;
+        r11 += p1 * p1;
+        r12 += p1 * p2;
+        r22 += p2 * p2;
+        q1 += x * p1;
+        q2 += x * p2;
+    }
+    const double det = r11 * r22 - r12 * r12;
+    double a = 0, b = 0;
+    if (std::fabs(det) > 1e-6 * (r11 * r22 + 1)) {
+        a = (q1 * r22 - q2 * r12) / det;
+        b = (q2 * r11 - q1 * r12) / det;
+    } else if (r11 > 0) {
+        a = q1 / r11;
+    }
+    auto fixed = [](double c) { return int(std::clamp<long>(std::lround(c * 2048), -32768, 32767)); };
+    return {fixed(std::clamp(a, -15.9, 15.9)), fixed(std::clamp(b, -15.9, 15.9))};
+}
+
+// Eight coefficient pairs: pair 0 is (0, 0) (silence and noise); the other seven are an
+// energy-weighted k-means of the frames' own predictors, seeded deterministically.
+std::array<int16_t, 16> ChooseCoefs(const std::vector<int16_t>& s) {
+    struct Point { double a, b, w; };
+    std::vector<Point> points;
+    for (size_t start = 0; start < s.size(); start += 14) {
+        const size_t count = std::min<size_t>(14, s.size() - start);
+        double energy = 0;
+        for (size_t i = start; i < start + count; ++i) energy += double(s[i]) * s[i];
+        if (energy < 1.0) continue;
+        const auto p = FramePredictor(s, start, count);
+        points.push_back({double(p[0]), double(p[1]), std::sqrt(energy)});
+    }
+    std::array<int16_t, 16> coefs{};
+    if (points.empty()) return coefs;
+    std::vector<Point> sorted = points;
+    std::stable_sort(sorted.begin(), sorted.end(), [](const Point& l, const Point& r) { return l.a < r.a; });
+    std::array<double, 7> ca{}, cb{};
+    for (int k = 0; k < 7; ++k) {
+        const Point& p = sorted[(sorted.size() - 1) * (2 * k + 1) / 14];
+        ca[k] = p.a;
+        cb[k] = p.b;
+    }
+    for (int iteration = 0; iteration < 24; ++iteration) {
+        std::array<double, 7> sa{}, sb{}, sw{};
+        for (const Point& p : points) {
+            int best = 0;
+            double bestDistance = std::numeric_limits<double>::max();
+            for (int k = 0; k < 7; ++k) {
+                const double d = (p.a - ca[k]) * (p.a - ca[k]) + (p.b - cb[k]) * (p.b - cb[k]);
+                if (d < bestDistance) { bestDistance = d; best = k; }
+            }
+            sa[best] += p.a * p.w;
+            sb[best] += p.b * p.w;
+            sw[best] += p.w;
+        }
+        for (int k = 0; k < 7; ++k) {
+            if (sw[k] > 0) { ca[k] = sa[k] / sw[k]; cb[k] = sb[k] / sw[k]; }
+        }
+    }
+    for (int k = 0; k < 7; ++k) {
+        coefs[2 + 2 * k] = int16_t(std::clamp<long>(std::lround(ca[k]), -32768, 32767));
+        coefs[3 + 2 * k] = int16_t(std::clamp<long>(std::lround(cb[k]), -32768, 32767));
+    }
+    return coefs;
+}
+
+}  // namespace
+
+bool ReadWav(const std::filesystem::path& path, std::vector<int16_t>& mono, std::string& error) {
+    mono.clear();
+    std::ifstream in(path, std::ios::binary);
+    if (!in) { error = "cannot open " + path.string(); return false; }
+    std::vector<uint8_t> file((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (file.size() < 12 || std::memcmp(file.data(), "RIFF", 4) || std::memcmp(file.data() + 8, "WAVE", 4)) {
+        error = "not a RIFF/WAVE file";
+        return false;
+    }
+    uint16_t format = 0, channels = 0, bits = 0;
+    uint32_t rate = 0;
+    const uint8_t* data = nullptr;
+    uint32_t dataSize = 0;
+    for (size_t pos = 12; pos + 8 <= file.size();) {
+        const uint32_t size = Le32(&file[pos + 4]);
+        if (size > file.size() - pos - 8) { error = "truncated chunk"; return false; }
+        if (!std::memcmp(&file[pos], "fmt ", 4) && size >= 16) {
+            format = Le16(&file[pos + 8]);
+            channels = Le16(&file[pos + 10]);
+            rate = Le32(&file[pos + 12]);
+            bits = Le16(&file[pos + 22]);
+        } else if (!std::memcmp(&file[pos], "data", 4)) {
+            data = &file[pos + 8];
+            dataSize = size;
+        }
+        pos += 8 + size + (size & 1);
+    }
+    if ((format != 1 && format != 0xFFFE) || bits != 16) { error = "only 16-bit PCM WAV is supported"; return false; }
+    if (channels == 0 || rate == 0) { error = "bad fmt chunk"; return false; }
+    if (!data) { error = "no data chunk"; return false; }
+    const size_t frames = dataSize / (2u * channels);
+    if (frames == 0) { error = "empty WAV"; return false; }
+    std::vector<int16_t> downmix(frames);
+    for (size_t i = 0; i < frames; ++i) {
+        int64_t sum = 0;
+        for (uint16_t c = 0; c < channels; ++c) sum += int16_t(Le16(data + 2 * (i * channels + c)));
+        downmix[i] = Clamp16(sum / channels);
+    }
+    if (rate == kRate) {
+        mono = std::move(downmix);
+    } else {
+        const size_t out = size_t(uint64_t(frames) * kRate / rate);
+        mono.resize(out);
+        for (size_t i = 0; i < out; ++i) {
+            const double x = double(i) * rate / kRate;
+            const size_t k = size_t(x);
+            const double t = x - double(k);
+            const double a = downmix[std::min(k, frames - 1)], b = downmix[std::min(k + 1, frames - 1)];
+            mono[i] = Clamp16(std::lround(a + (b - a) * t));
+        }
+    }
+    if (mono.empty()) { error = "empty WAV"; return false; }
+    if (mono.size() > size_t(kMaxSeconds) * kRate) {
+        mono.clear();
+        error = "longer than 5 seconds";
+        return false;
+    }
+    return true;
+}
+
+void Normalize(std::vector<int16_t>& samples, int16_t peak) {
+    int top = 0;
+    for (int16_t s : samples) top = std::max(top, std::abs(int(s)));
+    if (top == 0) return;
+    const double gain = double(peak) / top;
+    for (int16_t& s : samples) s = Clamp16(std::lround(s * gain));
+}
+
+uint32_t AdpcmBytes(uint32_t samples) {
+    const uint32_t rest = samples % 14;
+    return samples / 14 * 8 + (rest ? 1 + (rest + 1) / 2 : 0);
+}
+
+Adpcm Encode(const std::vector<int16_t>& samples) {
+    Adpcm out;
+    out.samples = uint32_t(samples.size());
+    out.coefs = ChooseCoefs(samples);
+    out.data.reserve(AdpcmBytes(out.samples));
+    int h1 = 0, h2 = 0;
+    for (size_t start = 0; start < samples.size(); start += 14) {
+        const int count = int(std::min<size_t>(14, samples.size() - start));
+        int bestPair = 0, bestExponent = 0;
+        int64_t bestError = std::numeric_limits<int64_t>::max();
+        int8_t nibbles[14];
+        for (int pair = 0; pair < 8; ++pair) {
+            for (int exponent = 0; exponent <= 11; ++exponent) {
+                int t1 = h1, t2 = h2;
+                const int64_t error = CodeFrame(&samples[start], count, out.coefs[2 * pair], out.coefs[2 * pair + 1], exponent, t1, t2, nibbles);
+                if (error < bestError) { bestError = error; bestPair = pair; bestExponent = exponent; }
+            }
+        }
+        CodeFrame(&samples[start], count, out.coefs[2 * bestPair], out.coefs[2 * bestPair + 1], bestExponent, h1, h2, nibbles);
+        out.data.push_back(uint8_t(bestPair << 4 | bestExponent));
+        for (int i = 0; i < count; i += 2) {
+            const int hi = nibbles[i] & 15, lo = i + 1 < count ? nibbles[i + 1] & 15 : 0;
+            out.data.push_back(uint8_t(hi << 4 | lo));
+        }
+    }
+    return out;
+}
+
+std::vector<int16_t> Decode(const Adpcm& adpcm) {
+    std::vector<int16_t> out;
+    out.reserve(adpcm.samples);
+    int h1 = 0, h2 = 0;
+    for (size_t frame = 0; frame < adpcm.data.size() && out.size() < adpcm.samples; frame += 8) {
+        const uint8_t ps = adpcm.data[frame];
+        const int scale = 1 << (ps & 15);
+        const int c1 = adpcm.coefs[(ps >> 4) * 2], c2 = adpcm.coefs[(ps >> 4) * 2 + 1];
+        for (size_t b = frame + 1; b < frame + 8 && b < adpcm.data.size(); ++b) {
+            for (int n : {adpcm.data[b] >> 4, adpcm.data[b] & 15}) {
+                if (out.size() == adpcm.samples) return out;
+                if (n >= 8) n -= 16;
+                const int v = Clamp16((int64_t(n) * scale * 2048 + int64_t(c1) * h1 + int64_t(c2) * h2 + 1024) >> 11);
+                h2 = h1;
+                h1 = v;
+                out.push_back(int16_t(v));
+            }
+        }
+    }
+    return out;
+}
+
+}  // namespace callnames
