+static void TestAdpcmSizes() {
+    // Jeter's bank-14 phrase: 8738 samples, 0x1382 bytes, 0x2704 nibbles.
+    CHECK(callnames::AdpcmBytes(8738) == 0x1382);
+    CHECK(callnames::AdpcmBytes(8738) * 2 == 0x2704);
+    CHECK(callnames::AdpcmBytes(14) == 8);
+    CHECK(callnames::AdpcmBytes(15) == 10);
+    CHECK(callnames::AdpcmBytes(0) == 0);
+}
+
+static void TestRoundTrip() {
+    const std::vector<int16_t> sine = Sine(440, callnames::kRate, callnames::kRate, 20000);
+    const callnames::Adpcm adpcm = callnames::Encode(sine);
+    CHECK(adpcm.samples == sine.size());
+    CHECK(adpcm.data.size() == callnames::AdpcmBytes(uint32_t(sine.size())));
+    const std::vector<int16_t> back = callnames::Decode(adpcm);
+    CHECK(back.size() == sine.size());
+    double signal = 0, noise = 0;
+    for (size_t i = 0; i < sine.size() && i < back.size(); ++i) {
+        signal += double(sine[i]) * sine[i];
+        noise += double(sine[i] - back[i]) * (sine[i] - back[i]);
+    }
+    const double snr = 10 * std::log10(signal / (noise + 1));
+    std::printf("round trip SNR %.1f dB\n", snr);
+    CHECK(snr >= 20);
+}
