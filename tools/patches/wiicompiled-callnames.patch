+static void TestReadWav(const fs::path& dir) {
+    std::string error;
+    std::vector<int16_t> mono;
+    // Stereo 44.1 kHz, one second: one second of mono at 22050.
+    std::vector<int16_t> stereo;
+    for (int16_t s : Sine(440, 44100, 44100, 10000)) { stereo.push_back(s); stereo.push_back(s); }
+    WriteWav(dir / "stereo.wav", 1, 2, 44100, 16, Pcm16(stereo));
+    CHECK(callnames::ReadWav(dir / "stereo.wav", mono, error));
+    CHECK(mono.size() >= callnames::kRate - 2 && mono.size() <= callnames::kRate + 2);
+
+    auto rejects = [&](const char* name) {
+        error.clear();
+        const bool ok = callnames::ReadWav(dir / name, mono, error);
+        if (ok || error.empty()) std::fprintf(stderr, "should reject %s\n", name);
+        return !ok && !error.empty();
+    };
+    WriteWav(dir / "8bit.wav", 1, 1, 22050, 8, std::vector<uint8_t>(1000, 128));
+    CHECK(rejects("8bit.wav"));
+    WriteWav(dir / "24bit.wav", 1, 1, 22050, 24, std::vector<uint8_t>(3000, 0));
+    CHECK(rejects("24bit.wav"));
+    WriteWav(dir / "float.wav", 3, 1, 22050, 32, std::vector<uint8_t>(4000, 0));
+    CHECK(rejects("float.wav"));
+    WriteWav(dir / "empty.wav", 1, 1, 22050, 16, {});
+    CHECK(rejects("empty.wav"));
+    WriteWav(dir / "long.wav", 1, 1, 22050, 16, Pcm16(std::vector<int16_t>(22050 * 6, 100)));
+    CHECK(rejects("long.wav"));
+    WriteWav(dir / "cut.wav", 1, 1, 22050, 16, Pcm16(Sine(440, 22050, 1000, 1000)));
+    fs::resize_file(dir / "cut.wav", 30);
+    CHECK(rejects("cut.wav"));
+    CHECK(rejects("missing.wav"));
+}
