+// Voice banks with new callnames appended, served as virtual files, and the encode cache (callnames.h).
+#include "callnames.h"
+
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+
+namespace callnames {
+
+namespace {
+
+constexpr char kEncoderVersion[] = "callnames-adpcm-1";  // bump when Encode/Normalize change their output
+
+uint32_t Be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | p[1] << 16 | p[2] << 8 | p[3]; }
+uint16_t Be16(const uint8_t* p) { return uint16_t(p[0] << 8 | p[1]); }
+void SetBe32(uint8_t* p, uint32_t v) { p[0] = uint8_t(v >> 24); p[1] = uint8_t(v >> 16); p[2] = uint8_t(v >> 8); p[3] = uint8_t(v); }
+void SetBe16(uint8_t* p, uint16_t v) { p[0] = uint8_t(v >> 8); p[1] = uint8_t(v); }
+
+bool ReadAt(const std::filesystem::path& path, uint64_t offset, size_t size, std::vector<uint8_t>& out) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    in.seekg(std::streamoff(offset));
+    out.resize(size);
+    in.read(reinterpret_cast<char*>(out.data()), std::streamsize(size));
+    return in.gcount() == std::streamsize(size);
+}
+
+bool ReadAll(const std::filesystem::path& path, std::vector<uint8_t>& out) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    out.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+    return true;
+}
+
+bool WriteAll(const std::filesystem::path& path, const std::vector<uint8_t>& bytes) {
+    const std::filesystem::path partial = path.string() + ".partial";
+    {
+        std::ofstream out(partial, std::ios::binary | std::ios::trunc);
+        out.write(reinterpret_cast<const char*>(bytes.data()), std::streamsize(bytes.size()));
+        if (!out) return false;
+    }
+    std::error_code ec;
+    std::filesystem::rename(partial, path, ec);
+    return !ec;
+}
+
+uint64_t Fnv1a(const std::vector<uint8_t>& bytes, uint64_t hash = 0xCBF29CE484222325ull) {
+    for (uint8_t b : bytes) hash = (hash ^ b) * 0x100000001B3ull;
+    return hash;
+}
+
+}  // namespace
+
+bool EncodeCached(const std::filesystem::path& wav, const std::filesystem::path& cacheDir, Adpcm& out,
+                  std::string& error) {
+    std::vector<uint8_t> bytes;
+    if (!ReadAll(wav, bytes)) {
+        error = "cannot open " + wav.string();
+        return false;
+    }
+    const std::vector<uint8_t> version(std::begin(kEncoderVersion), std::end(kEncoderVersion));
+    char name[32];
+    std::snprintf(name, sizeof(name), "%016llx.adpcm", static_cast<unsigned long long>(Fnv1a(bytes, Fnv1a(version))));
+    const std::filesystem::path cached = cacheDir / name;
+    std::vector<uint8_t> blob;
+    // Cache file: u32 samples, 16 s16 coefficients, then the ADPCM bytes (big-endian).
+    if (ReadAll(cached, blob) && blob.size() >= 36) {
+        out.samples = Be32(blob.data());
+        for (int i = 0; i < 16; ++i) out.coefs[i] = int16_t(Be16(&blob[4 + 2 * i]));
+        out.data.assign(blob.begin() + 36, blob.end());
+        if (out.data.size() == AdpcmBytes(out.samples)) return true;
+    }
+    std::vector<int16_t> mono;
+    if (!ReadWav(wav, mono, error)) return false;
+    Normalize(mono);
+    out = Encode(mono);
+    blob.assign(36, 0);
+    SetBe32(blob.data(), out.samples);
+    for (int i = 0; i < 16; ++i) SetBe16(&blob[4 + 2 * i], uint16_t(out.coefs[i]));
+    blob.insert(blob.end(), out.data.begin(), out.data.end());
+    std::error_code ec;
+    std::filesystem::create_directories(cacheDir, ec);
+    WriteAll(cached, blob);  // a cache that cannot be written only costs encoding again next time
+    return true;
+}
+
+bool BuildBank(int bank, const std::filesystem::path& original,
+               const std::vector<std::pair<uint32_t, Adpcm>>& phrases, const std::filesystem::path& cacheDir,
+               BankBuild& out, std::string& error, uint32_t sectorLimit) {
+    out = BankBuild{};
+    std::vector<uint8_t> header;
+    if (!ReadAt(original, 0, kSector, header) || Be32(header.data()) != 0x005A8AAB) {
+        error = original.string() + ": not a voice bank";
+        return false;
+    }
+    std::error_code ec;
+    const uint64_t fileSize = std::filesystem::file_size(original, ec);
+    const uint32_t indexSector = Be32(&header[4]), oldCount = Be32(&header[8]);
+    const uint64_t indexAt = uint64_t(indexSector) * kSector;
+    std::vector<uint8_t> index;
+    if (ec || oldCount < 4 || !ReadAt(original, indexAt, size_t(oldCount) * 4, index)) {
+        error = original.string() + ": unreadable index";
+        return false;
+    }
+    std::vector<uint16_t> sectors(oldCount), ms(oldCount);
+    for (uint32_t i = 0; i < oldCount; ++i) {
+        sectors[i] = Be16(&index[2 * i]);
+        ms[i] = Be16(&index[2 * oldCount + 2 * i]);
+    }
+    std::vector<uint8_t> templ;  // a real phrase header of this bank (local 3; 0-2 are filler)
+    if (!ReadAt(original, uint64_t(sectors[3]) * kSector, kSector, templ)) {
+        error = original.string() + ": unreadable phrase header";
+        return false;
+    }
+
+    std::vector<uint8_t> ext;  // new phrases, then the new index and the original tail
+    uint32_t next = indexSector;
+    for (const auto& [local, adpcm] : phrases) {
+        const uint32_t dataSectors = uint32_t((adpcm.data.size() + kSector - 1) / kSector);
+        if (next >= sectorLimit) {
+            out.warnings.push_back("voice" + std::to_string(bank) + ".bin: no room for phrase " + std::to_string(local) +
+                                   " (sector " + std::to_string(next) + ")");
+            continue;
+        }
+        std::vector<uint8_t> phrase = templ;
+        SetBe32(&phrase[0x00], uint32_t(adpcm.data.size()));
+        SetBe32(&phrase[0x04], (Be32(&templ[4]) & 0xFFFF0000u) | kRate);
+        const uint32_t millis = uint32_t((uint64_t(adpcm.samples) * 1000 + kRate / 2) / kRate);
+        SetBe32(&phrase[0x10], millis);
+        SetBe32(&phrase[0x88], 2 * uint32_t(adpcm.data.size()));
+        SetBe32(&phrase[0x8C], 2);
+        for (int i = 0; i < 16; ++i) SetBe16(&phrase[0x90 + 2 * i], uint16_t(adpcm.coefs[i]));
+        SetBe16(&phrase[0xB0], 0);
+        SetBe16(&phrase[0xB2], adpcm.data.empty() ? 0 : adpcm.data[0]);
+        SetBe16(&phrase[0xB4], 0);
+        SetBe16(&phrase[0xB6], 0);
+        phrase.insert(phrase.end(), adpcm.data.begin(), adpcm.data.end());
+        phrase.resize(size_t(1 + dataSectors) * kSector, 0);
+        ext.insert(ext.end(), phrase.begin(), phrase.end());
+        if (local >= sectors.size()) {
+            sectors.resize(local + 1, sectors[0]);
+            ms.resize(local + 1, ms[0]);
+        }
+        sectors[local] = uint16_t(next);
+        ms[local] = uint16_t(std::min<uint32_t>(millis, 0xFFFF));
+        out.added.push_back(local);
+        next += 1 + dataSectors;
+    }
+    out.count = uint32_t(sectors.size());
+    const uint32_t newIndexSector = next;
+    for (uint16_t s : sectors) ext.push_back(uint8_t(s >> 8)), ext.push_back(uint8_t(s));
+    for (uint16_t m : ms) ext.push_back(uint8_t(m >> 8)), ext.push_back(uint8_t(m));
+    std::vector<uint8_t> tail;
+    const uint64_t tailAt = indexAt + uint64_t(oldCount) * 4;
+    if (fileSize > tailAt && !ReadAt(original, tailAt, size_t(fileSize - tailAt), tail)) {
+        error = original.string() + ": unreadable tail";
+        return false;
+    }
+    ext.insert(ext.end(), tail.begin(), tail.end());
+
+    const std::filesystem::path extPath = cacheDir / ("voice" + std::to_string(bank) + ".ext");
+    std::filesystem::create_directories(cacheDir, ec);
+    if (!WriteAll(extPath, ext)) {
+        error = "cannot write " + extPath.string();
+        return false;
+    }
+    SetBe32(&header[4], newIndexSector);
+    SetBe32(&header[8], out.count);
+    SetBe32(&header[12], out.count * 4);
+    SetBe32(&header[16], out.count);
+    auto& file = out.file;
+    file.key = cacheDir / ("voice" + std::to_string(bank) + ".virtual");
+    file.dvdPath = "/sound/voice" + std::to_string(bank) + ".bin";
+    file.bytes = header;
+    file.AppendBytes(0, kSector);
+    file.AppendSource(original, kSector, uint64_t(indexSector - 1) * kSector);
+    file.AppendSource(extPath, 0, ext.size());
+    return true;
+}
+
+}  // namespace callnames
