     return "unknown host read error";
 }
 
+// A disc file that exists only as a list of pieces: byte ranges of other host files, bytes held in
+// memory and zeros. The Switch serves its modded PROJECT.BIN this way (mods.cpp): the PC writes a
+// merged 406 MB copy, which on the SD card meant reading and writing 406 MB before the first frame.
+// The DVD index stores `key` as the entry's host path (it is never opened); ReadExact recognises it
+// and assembles the range. Register every virtual file before DVDInit (mods::Apply runs before
+// aurora_initialize and any guest code) and never change the registry after that: reads take no lock.
+namespace Virtual {
+
+inline constexpr int32_t kBytes = -1;  // Piece::source: File::bytes from Piece::from
+inline constexpr int32_t kZeros = -2;  // Piece::source: zeros
+
+struct Piece {
+    uint64_t start = 0;  // offset in the virtual file
+    uint64_t length = 0;
+    int32_t source = kZeros;  // index into File::sources, kBytes or kZeros
+    uint64_t from = 0;        // offset in the source file or in File::bytes
+};
+
+struct File {
+    std::filesystem::path key;
+    std::string dvdPath;  // e.g. "/project.bin"
+    std::vector<uint8_t> bytes;
+    std::vector<std::filesystem::path> sources;
+    std::vector<Piece> pieces;  // contiguous from offset 0
+    uint64_t size = 0;
+
+    // Pieces go on at the end; one that continues the last piece (zeros after zeros, the next bytes of
+    // the same source) extends it.
+    void Append(int32_t source, uint64_t from, uint64_t length) {
+        if (length == 0) {
+            return;
+        }
+        if (!pieces.empty()) {
+            Piece& last = pieces.back();
+            if (last.source == source && (source == kZeros || last.from + last.length == from)) {
+                last.length += length;
+                size += length;
+                return;
+            }
+        }
+        pieces.push_back({size, length, source, from});
+        size += length;
+    }
+    void AppendBytes(uint64_t from, uint64_t length) { Append(kBytes, from, length); }
+    void AppendZeros(uint64_t length) { Append(kZeros, 0, length); }
+    void AppendSource(const std::filesystem::path& path, uint64_t from, uint64_t length) {
+        if (length == 0) {
+            return;
+        }
+        size_t index = 0;
+        while (index < sources.size() && !(sources[index] == path)) {
+            ++index;
+        }
+        if (index == sources.size()) {
+            sources.push_back(path);
+        }
+        Append(static_cast<int32_t>(index), from, length);
+    }
+};
+
+inline std::vector<File>& Files() {
+    static std::vector<File> files;
+    return files;
+}
+
+// A file with the same key replaces the earlier one.
+inline void Register(File file) {
+    for (File& existing : Files()) {
+        if (existing.key == file.key) {
+            existing = std::move(file);
+            return;
+        }
+    }
+    Files().push_back(std::move(file));
+}
+
+inline const File* Find(const std::filesystem::path& key) {
+    for (const File& file : Files()) {
+        if (file.key == key) {
+            return &file;
+        }
+    }
+    return nullptr;
+}
+
+// The same contract as ReadExact on a real file with these bytes. `readSource(path, offset, length,
+// out, failure)` reads one complete range of a source file into `out`.
+template <typename ReadSource>
+inline bool Read(const File& file, uint64_t offset, uint32_t length, std::vector<uint8_t>& destination,
+                 HostReadFailure& failure, ReadSource&& readSource) {
+    failure = HostReadFailure::None;
+    if (offset >= file.size) {
+        failure = HostReadFailure::BadOffset;
+        return false;
+    }
+    if (static_cast<uint64_t>(length) > file.size - offset) {
+        failure = HostReadFailure::ShortRead;
+        return false;
+    }
+    std::vector<uint8_t> staged(length);
+    // The last piece starting at or before `offset` (the first starts at 0).
+    auto piece = std::upper_bound(file.pieces.begin(), file.pieces.end(), offset,
+                                  [](uint64_t value, const Piece& p) { return value < p.start; });
+    --piece;
+    for (uint64_t done = 0; done < length; ++piece) {
+        const uint64_t at = offset + done - piece->start;
+        const uint64_t n = std::min<uint64_t>(piece->length - at, length - done);
+        uint8_t* const out = staged.data() + done;
+        if (piece->source == kBytes) {
+            std::memcpy(out, file.bytes.data() + piece->from + at, static_cast<size_t>(n));
+        } else if (piece->source >= 0 &&
+                   !readSource(file.sources[static_cast<size_t>(piece->source)], piece->from + at,
+                               static_cast<uint32_t>(n), out, failure)) {
+            return false;
+        }
+        done += n;
+    }
+    destination = std::move(staged);
+    return true;
+}
+
+} // namespace Virtual
+
 // Read into private storage first and publish it only after the complete host
 // range has been obtained. Callers can therefore leave a guest DMA destination
 // untouched for every failure, including a host file truncated after indexing.
@@ -292,6 +416,16 @@ inline bool ReadExact(const std::filesystem::path& hostPath,
                       uint32_t length,
                       std::vector<uint8_t>& destination,
                       HostReadFailure& failure) {
+    if (const Virtual::File* file = Virtual::Find(hostPath)) {
+        return Virtual::Read(*file, offset, length, destination, failure,
+                             [](const std::filesystem::path& source, uint64_t from, uint32_t n, uint8_t* out,
+                                HostReadFailure& why) {
+                                 std::vector<uint8_t> range;
+                                 if (!ReadExact(source, from, n, range, why)) return false;
+                                 std::copy(range.begin(), range.end(), out);
+                                 return true;
+                             });
+    }
     failure = HostReadFailure::None;
 
     std::ifstream file(hostPath, std::ios::binary);
