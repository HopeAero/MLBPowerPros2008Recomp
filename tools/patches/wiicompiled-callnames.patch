+static void TestPhraseIds() {
+    callnames::SetBankCounts(0, 0, 0);
+    for (const RefRun& run : kRefBank)
+        for (uint32_t id : {run.first, run.last, (run.first + run.last) / 2})
+            CHECK(callnames::PhraseBank(id) == uint32_t(run.value));
+    for (const RefRun& run : kRefBase)
+        for (uint32_t id : {run.first, run.last, (run.first + run.last) / 2})
+            CHECK(callnames::PhraseLocal(id) == (run.value < 0 ? -1 : int32_t(id - uint32_t(run.value))));
+    // Every id, against the runs (a run never splits, so the endpoints above are not enough alone).
+    size_t b = 0, l = 0;
+    int mismatches = 0;
+    for (uint32_t id = 0; id < 0x40000; ++id) {
+        while (kRefBank[b].last < id) ++b;
+        while (kRefBase[l].last < id) ++l;
+        const int32_t local = kRefBase[l].value < 0 ? -1 : int32_t(id - uint32_t(kRefBase[l].value));
+        mismatches += callnames::PhraseBank(id) != uint32_t(kRefBank[b].value) || callnames::PhraseLocal(id) != local;
+    }
+    CHECK(mismatches == 0);
+    // Past 0x3FFFF the original answers bank 0 and no local.
+    CHECK(callnames::PhraseBank(0x40000) == 0 && callnames::PhraseLocal(0x40000) == -1);
+    CHECK(callnames::PhraseBank(0xFFFFFFFFu) == 0 && callnames::PhraseLocal(0xFFFFFFFFu) == -1);
+
+    // With callnames up to VoiceId 7300 (local 0x1484): banks 14, 15 and 17 grow, nothing else moves.
+    callnames::SetBankCounts(0x1485, 0x1485, 0x1485);
+    CHECK(callnames::PhraseBank(0x12484) == 14 && callnames::PhraseLocal(0x12484) == 0x1484);
+    CHECK(callnames::PhraseBank(0x14484) == 15 && callnames::PhraseLocal(0x14484) == 0x1484);
+    CHECK(callnames::PhraseBank(0x17484) == 17 && callnames::PhraseLocal(0x17484) == 0x1484);
+    CHECK(callnames::PhraseBank(0x14485) == 0 && callnames::PhraseLocal(0x14485) == -1);
+    CHECK(callnames::PhraseBank(0x15000) == 16 && callnames::PhraseLocal(0x15000) == 0);
+    CHECK(callnames::PhraseBank(0x12437) == 14);  // inside the grown bank 14
+    // A count below the original never shrinks a bank.
+    callnames::SetBankCounts(10, 10, 10);
+    CHECK(callnames::PhraseBank(0x13E41) == 15 && callnames::PhraseLocal(0x13E41) == 0xE41);
+    callnames::SetBankCounts(0, 0, 0);
+}
