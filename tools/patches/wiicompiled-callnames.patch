+// callnames/callnames.toml of the enabled mods (callnames.h).
+#include "callnames.h"
+
+#include <fstream>
+#include <set>
+
+#include <toml.hpp>
+
+namespace callnames {
+
+namespace {
+
+std::filesystem::path FromUtf8(const std::string& text) {
+    return std::filesystem::path(std::u8string(text.begin(), text.end()));
+}
+
+std::string Utf8(const std::filesystem::path& path) {
+    const std::u8string text = path.u8string();
+    return std::string(text.begin(), text.end());
+}
+
+// Latin-1 letters with accents (U+00C0..U+00FF) to their plain letter; 0 for the rest.
+char Plain(char32_t c) {
+    static constexpr const char* kLatin1 =
+        "AAAAAAACEEEEIIII"   // C0-CF
+        "DNOOOOO\0OUUUUY\0s" // D0-DF
+        "aaaaaaaceeeeiiii"   // E0-EF
+        "dnooooo\0ouuuuy\0y";// F0-FF
+    if (c >= 0xC0 && c <= 0xFF) return kLatin1[c - 0xC0];
+    return 0;
+}
+
+// The game's code for an ASCII character, or -1.
+int GameCode(char c) {
+    if (c >= 'A' && c <= 'Z') return 220 + (c - 'A');
+    if (c >= 'a' && c <= 'z') return 252 + (c - 'a');
+    if (c >= '0' && c <= '9') return 203 + (c - '0');
+    switch (c) {
+    case ' ': return 0;
+    case '.': return 4;
+    case ';': return 7;
+    case '?': return 8;
+    case '!': return 9;
+    case '/': return 30;
+    case '\'': return 38;
+    case '(': return 41;
+    case ')': return 42;
+    case '+': return 59;
+    case '-': return 60;
+    case '=': return 64;
+    default: return -1;
+    }
+}
+
+}  // namespace
+
+std::u16string ToGameText(const std::string& utf8, std::string& dropped) {
+    dropped.clear();
+    std::u16string out;
+    for (size_t i = 0; i < utf8.size();) {
+        const unsigned char lead = static_cast<unsigned char>(utf8[i]);
+        const size_t length = lead < 0x80 ? 1 : (lead >> 5) == 6 ? 2 : (lead >> 4) == 14 ? 3 : (lead >> 3) == 30 ? 4 : 1;
+        char32_t c = length == 1 ? lead : lead & (0x7F >> length);
+        for (size_t k = 1; k < length && i + k < utf8.size(); ++k) c = c << 6 | (static_cast<unsigned char>(utf8[i + k]) & 0x3F);
+        const char ascii = c < 0x80 ? static_cast<char>(c) : Plain(c);
+        const int code = ascii ? GameCode(ascii) : -1;
+        if (code >= 0) out.push_back(static_cast<char16_t>(code));
+        else dropped += utf8.substr(i, length);
+        i += length;
+    }
+    return out;
+}
+
+std::vector<Callname> Collect(const std::vector<mods::Mod>& enabled, std::vector<std::string>& warnings) {
+    std::vector<Callname> out;
+    std::set<uint32_t> taken;
+    for (const mods::Mod& mod : enabled) {
+        if (!mod.enabled || !mod.callnames) continue;
+        const std::filesystem::path folder = mod.root / "callnames";
+        const std::filesystem::path manifest = folder / "callnames.toml";
+        toml::value document;
+        try {
+            std::ifstream input(manifest, std::ios::binary);
+            document = toml::parse(input, Utf8(manifest));
+        } catch (const std::exception& error) {
+            warnings.push_back(mod.id + ": unreadable callnames.toml: " + error.what());
+            continue;
+        }
+        if (!document.contains("callname") || !document.at("callname").is_array()) {
+            warnings.push_back(mod.id + ": callnames.toml has no [[callname]]");
+            continue;
+        }
+        for (const toml::value& entry : document.at("callname").as_array()) {
+            if (!entry.is_table()) continue;
+            Callname name;
+            name.mod = mod.id;
+            const int64_t voice = toml::find_or<int64_t>(entry, "voice", 0);
+            name.list = toml::find_or<std::string>(entry, "list", "");
+            const std::string label = mod.id + ": " + (name.list.empty() ? "voice " + std::to_string(voice) : "\"" + name.list + "\"");
+            if (voice < kFirstVoice || voice > kLastVoice) {
+                warnings.push_back(label + ": voice " + std::to_string(voice) + " outside " + std::to_string(kFirstVoice) + "-" +
+                                   std::to_string(kLastVoice));
+                continue;
+            }
+            name.voice = static_cast<uint32_t>(voice);
+            std::string dropped;
+            name.listGame = ToGameText(name.list, dropped);
+            if (name.listGame.empty() || name.listGame.size() > kMaxListChars) {
+                warnings.push_back(label + ": list must have 1-15 characters the game can show");
+                continue;
+            }
+            if (!dropped.empty()) warnings.push_back(label + ": characters the game cannot show were dropped: " + dropped);
+            for (char16_t code : name.listGame) {
+                if (code >= 252 && code <= 277) code = static_cast<char16_t>(code - 32);  // a-z -> A-Z
+                if ((code >= 220 && code <= 245) || code == 4 || code == 60) name.listUpper.push_back(code);
+            }
+            auto file = [&](const char* key) { return toml::find_or<std::string>(entry, key, ""); };
+            if (file("normal").empty()) {
+                warnings.push_back(label + ": no normal WAV");
+                continue;
+            }
+            name.normal = folder / FromUtf8(file("normal"));
+            name.excited = file("excited").empty() ? name.normal : folder / FromUtf8(file("excited"));
+            name.full = file("full").empty() ? name.normal : folder / FromUtf8(file("full"));
+            std::error_code ec;
+            bool missing = false;
+            for (const auto* path : {&name.normal, &name.excited, &name.full}) {
+                if (!std::filesystem::is_regular_file(*path, ec)) {
+                    warnings.push_back(label + ": missing " + Utf8(path->filename()));
+                    missing = true;
+                    break;
+                }
+            }
+            if (missing) continue;
+            if (!taken.insert(name.voice).second) {
+                warnings.push_back(label + ": voice " + std::to_string(name.voice) + " already used by an earlier mod");
+                continue;
+            }
+            out.push_back(std::move(name));
+        }
+    }
+    return out;
+}
+
+}  // namespace callnames
diff --git a/runtime/src/callnames/mount.cpp b/runtime/src/callnames/mount.cpp
new file mode 100644
index 0000000..8af435e
--- /dev/null
+++ b/runtime/src/callnames/mount.cpp
@@ -0,0 +1,54 @@
+// Start-up: the enabled mods' callnames encoded (cached), voice banks 14/15/17 registered as
+// virtual files and the phrase-id ranges grown (callnames.h). Runs from mods::Apply, before DVDInit.
+#include "callnames.h"
+
+#include <chrono>
+
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+namespace callnames {
+
+std::vector<Callname> Mount(const std::vector<mods::Mod>& mods, const std::filesystem::path& cacheDir) {
+    std::vector<std::string> warnings;
+    const std::vector<Callname> names = Collect(mods, warnings);
+    for (const std::string& warning : warnings) RT_LOG(RT_TAG_RUNTIME) << "[callnames] " << warning << std::endl;
+    if (names.empty()) return {};
+    const auto started = std::chrono::steady_clock::now();
+    const std::filesystem::path sound = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "sound";
+    uint32_t counts[3] = {0, 0, 0};
+    int index = 0;
+    for (const int bank : {14, 15, 17}) {
+        std::vector<std::pair<uint32_t, Adpcm>> phrases;
+        for (const Callname& name : names) {
+            const std::filesystem::path& wav = bank == 14 ? name.normal : bank == 15 ? name.excited : name.full;
+            Adpcm adpcm;
+            std::string error;
+            if (!EncodeCached(wav, cacheDir / "encoded", adpcm, error)) {
+                RT_LOG(RT_TAG_RUNTIME) << "[callnames] " << name.mod << ": \"" << name.list << "\": " << error << std::endl;
+                continue;
+            }
+            phrases.emplace_back(name.voice - 0x800, std::move(adpcm));
+        }
+        BankBuild build;
+        std::string error;
+        if (!BuildBank(bank, sound / ("voice" + std::to_string(bank) + ".bin"), phrases, cacheDir, build, error)) {
+            RT_LOG(RT_TAG_RUNTIME) << "[callnames] voice" << bank << ".bin: " << error << std::endl;
+            ++index;
+            continue;
+        }
+        for (const std::string& warning : build.warnings) RT_LOG(RT_TAG_RUNTIME) << "[callnames] " << warning << std::endl;
+        counts[index++] = build.count;
+        RT_LOG(RT_TAG_RUNTIME) << "[callnames] voice" << bank << ".bin: " << build.added.size() << " new phrase(s), "
+                               << build.count << " in the index" << std::endl;
+        DvdReadContract::Virtual::Register(std::move(build.file));
+    }
+    SetBankCounts(counts[0], counts[1], counts[2]);
+    if (counts[0] == 0 && counts[1] == 0 && counts[2] == 0) return {};
+    RT_LOG(RT_TAG_RUNTIME) << "[callnames] " << names.size() << " name(s) in "
+                           << std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count()
+                           << " ms" << std::endl;
+    return names;
+}
+
+}  // namespace callnames
diff --git a/runtime/src/callnames/phrase_ids.cpp b/runtime/src/callnames/phrase_ids.cpp
new file mode 100644
index 0000000..479be7c
--- /dev/null
+++ b/runtime/src/callnames/phrase_ids.cpp
@@ -0,0 +1,98 @@
+// Phrase id -> bank and local index, as 0x8003B398 / 0x8003B530 compute them (callnames.h).
+#include "callnames.h"
+
+#include <algorithm>
+#include <atomic>
+
+namespace callnames {
+
+namespace {
+
+struct Range {
+    uint32_t base, count;
+};
+
+// The ranges written in 0x8003B398/0x8003B530, in their order; [18] (0x30000) has no voice18.bin.
+constexpr Range kRanges[19] = {
+    {0x4000, 0x3E3},  {0x4800, 0x653},  {0x5000, 0x960},   {0x6000, 0x76E},  {0x6800, 0xACD},
+    {0x7800, 0xAB5},  {0x8800, 0x182A}, {0xA800, 0x1235},  {0xC800, 0x36A},  {0xD000, 0x631},
+    {0xD800, 0x97F},  {0xE800, 0x67B},  {0xF000, 0xA21},   {0x10000, 0xAB1}, {0x11000, 0x1437},
+    {0x13000, 0xE42}, {0x15000, 0x334}, {0x16000, 0xE42},  {0x30000, 0x10000},
+};
+
+std::atomic<uint32_t> g_grown[3];  // banks 14, 15, 17
+
+uint32_t Count(uint32_t bank) {
+    const int grown = bank == 14 ? 0 : bank == 15 ? 1 : bank == 17 ? 2 : -1;
+    const uint32_t original = kRanges[bank].count;
+    return grown < 0 ? original : std::max(original, g_grown[grown].load(std::memory_order_relaxed));
+}
+
+}  // namespace
+
+void SetBankCounts(uint32_t bank14, uint32_t bank15, uint32_t bank17) {
+    g_grown[0] = bank14;
+    g_grown[1] = bank15;
+    g_grown[2] = bank17;
+}
+
+uint32_t PhraseBank(uint32_t id) {
+    if (id == 0) return 0;
+    for (uint32_t bank = 0; bank < 19; ++bank) {
+        if (id - kRanges[bank].base < Count(bank)) return bank;
+    }
+    return 0;
+}
+
+namespace {
+
+struct Span {
+    uint32_t first, last;
+};
+// The key ranges the converters accept (list B, the in-between gaps the game keeps, list C, list A,
+// and 0x963F-0x9A31), and the same + 0x8800 (bank-14 ids).
+constexpr Span kKeys[] = {{0x8803, 0x8DF5}, {0x8DF8, 0x8E3D}, {0x8E40, 0x91BB}, {0x91BE, 0x963C}, {0x963F, 0x9A31}};
+
+bool In(uint32_t x, const Span& s) { return x >= s.first && x <= s.last; }
+bool InKeys(uint32_t x, uint32_t offset, size_t count = std::size(kKeys)) {
+    for (size_t i = 0; i < count; ++i)
+        if (In(x - offset, kKeys[i]) && x >= offset) return true;
+    return false;
+}
+// A callname's key, bank-7 id or bank-14 id: x - base is a callname VoiceId.
+bool IsCallname(uint32_t x, uint32_t base) { return x >= base && x - base >= kFirstVoice && x - base <= kLastVoice; }
+
+}  // namespace
+
+uint32_t RemapKey(uint32_t x) {
+    if (IsCallname(x, 0x8000) || IsCallname(x, 0xA000)) return x + 0x8800;
+    if (In(x, kKeys[4])) return 0;
+    if (InKeys(x, 0, 4) || InKeys(x, 0x2000)) return x + 0x8800;
+    return x;
+}
+
+uint32_t Excited(uint32_t x) {
+    if (IsCallname(x, 0x8000) || IsCallname(x, 0x10800)) return x + 0x2000;
+    return InKeys(x, 0) || InKeys(x, 0x8800, 4) ? x + 0x2000 : 0;
+}
+
+uint32_t ColourName(uint32_t x) {
+    if (IsCallname(x, 0x8000)) return x + 0xD800;
+    return InKeys(x, 0) || InKeys(x, 0x8800, 4) ? x + 0xD800 : 0;
+}
+
+uint32_t Variant(uint32_t x, bool other) {
+    if (IsCallname(x, 0x8000)) return other ? 0 : x + 0x8800;
+    if (IsCallname(x, 0x10800)) return other ? 0 : x;
+    if (!In(x, kKeys[0]) && !In(x - 0x8800, kKeys[0])) return 0;
+    return other ? x + 0x1231 : RemapKey(x) + 0xE3E;
+}
+
+int32_t PhraseLocal(uint32_t id) {
+    for (uint32_t bank = 0; bank < 19; ++bank) {
+        if (id - kRanges[bank].base < Count(bank)) return int32_t(id - kRanges[bank].base);
+    }
+    return -1;
+}
+
+}  // namespace callnames
diff --git a/runtime/src/callnames/voice_list.cpp b/runtime/src/callnames/voice_list.cpp
new file mode 100644
index 0000000..1c27e25
--- /dev/null
+++ b/runtime/src/callnames/voice_list.cpp
@@ -0,0 +1,141 @@
+// The editor's name lists (env_voice_data.pack) with callnames added (callnames.h).
+#include "callnames.h"
+
+#include <algorithm>
+#include <map>
+
+namespace callnames {
+
+namespace {
+
+constexpr uint32_t kNameBytes = 30;
+
+uint32_t Be32(const std::vector<uint8_t>& b, size_t at) { return uint32_t(b[at]) << 24 | b[at + 1] << 16 | b[at + 2] << 8 | b[at + 3]; }
+uint16_t Be16(const std::vector<uint8_t>& b, size_t at) { return uint16_t(b[at] << 8 | b[at + 1]); }
+void Push32(std::vector<uint8_t>& b, uint32_t v) { for (int i = 0; i < 4; ++i) b.push_back(uint8_t(v >> (24 - 8 * i))); }
+void Push16(std::vector<uint8_t>& b, uint16_t v) { b.push_back(uint8_t(v >> 8)); b.push_back(uint8_t(v)); }
+
+struct Entry {
+    uint32_t key = 0;
+    std::vector<uint8_t> name;  // 30 bytes as stored
+    std::u16string sortKey;
+};
+
+std::vector<uint8_t> StoredName(const std::u16string& text) {
+    std::vector<uint8_t> out;
+    for (size_t i = 0; i < 15; ++i) Push16(out, i < text.size() ? text[i] : i == text.size() ? 0xFFFF : 0);
+    return out;
+}
+
+std::u16string NameText(const std::vector<uint8_t>& stored) {
+    std::u16string out;
+    for (size_t i = 0; i < 15 && Be16(stored, 2 * i) != 0xFFFF; ++i) out.push_back(Be16(stored, 2 * i));
+    return out;
+}
+
+char16_t Upper(char16_t c) { return c >= 252 && c <= 277 ? char16_t(c - 32) : c; }
+
+// List B order: by surname, an initial ("T." of "T.Abreu") skipped, case folded.
+std::u16string SortKeyB(const std::u16string& text) {
+    std::u16string key = text.size() > 2 && text[1] == 4 ? text.substr(2) : text;
+    for (char16_t& c : key) c = Upper(c);
+    return key;
+}
+
+int LetterOf(char16_t c) {
+    c = Upper(c);
+    return c >= 220 && c <= 245 ? c - 220 : -1;
+}
+
+std::vector<Entry> ReadList(const std::vector<uint8_t>& pack, uint32_t keys, uint32_t names, uint32_t count) {
+    std::vector<Entry> out(count);
+    for (uint32_t i = 0; i < count; ++i) {
+        out[i].key = Be32(pack, keys + 4 * i);
+        out[i].name.assign(pack.begin() + names + kNameBytes * i, pack.begin() + names + kNameBytes * (i + 1));
+    }
+    return out;
+}
+
+// Inserts after every entry whose key is not greater: originals keep their order.
+void Insert(std::vector<Entry>& list, size_t first, size_t end, Entry entry) {
+    size_t at = first;
+    while (at < end && !(entry.sortKey < list[at].sortKey)) ++at;
+    list.insert(list.begin() + at, std::move(entry));
+}
+
+void Align4(std::vector<uint8_t>& b) {
+    while (b.size() % 4) b.push_back(0);
+}
+
+}  // namespace
+
+bool BuildVoiceList(const std::vector<uint8_t>& original, const std::vector<Callname>& names,
+                    std::vector<uint8_t>& out, VoiceListLayout& layout) {
+    const VoiceListLayout in = layout;
+    auto fits = [&](uint32_t at, uint32_t size) { return at <= original.size() && size <= original.size() - at; };
+    if (!fits(in.keysA, 4 * in.countA) || !fits(in.namesA, kNameBytes * in.countA) || !fits(in.keysB, 4 * in.countB) ||
+        !fits(in.namesB, kNameBytes * in.countB) || !fits(in.letters, 2 * 26)) {
+        return false;
+    }
+    // List A: sorted by its upper-case text.
+    std::vector<Entry> listA = ReadList(original, in.keysA, in.namesA, in.countA);
+    for (Entry& e : listA) e.sortKey = NameText(e.name);
+    // List B: groups, each a heading row (key kLetterHeading, name 0x2000 | letter) and its names.
+    std::map<int, std::vector<Entry>> groups;
+    int current = -1;
+    for (Entry& e : ReadList(original, in.keysB, in.namesB, in.countB)) {
+        const std::u16string text = NameText(e.name);
+        if (e.key == kLetterHeading && !text.empty()) current = LetterOf(char16_t(text[0] & 0x1FFF));
+        e.sortKey = SortKeyB(text);
+        groups[current].push_back(std::move(e));
+    }
+    for (const Callname& name : names) {
+        const uint32_t key = 0x8000 + name.voice;
+        if (!name.listUpper.empty()) {
+            Entry a{key, StoredName(name.listUpper), name.listUpper.substr(0, 15)};
+            Insert(listA, 0, listA.size(), std::move(a));
+        }
+        const std::u16string text = name.listGame.substr(0, 15);
+        const int letter = text.empty() ? -1 : LetterOf(SortKeyB(text).empty() ? 0 : SortKeyB(text)[0]);
+        if (letter < 0) continue;
+        std::vector<Entry>& group = groups[letter];
+        if (group.empty()) group.push_back({kLetterHeading, StoredName({char16_t(0x2000 | (220 + letter))}), {}});
+        Insert(group, 1, group.size(), {key, StoredName(text), SortKeyB(text)});
+    }
+    std::vector<Entry> listB;
+    int16_t letters[26];
+    std::fill(std::begin(letters), std::end(letters), int16_t(-1));
+    for (auto& [letter, group] : groups) {
+        if (letter >= 0 && letter < 26) letters[letter] = int16_t(listB.size());
+        for (Entry& e : group) listB.push_back(std::move(e));
+    }
+
+    out = original;
+    Align4(out);
+    layout = in;
+    layout.countA = uint32_t(listA.size());
+    layout.keysA = uint32_t(out.size());
+    for (const Entry& e : listA) Push32(out, e.key);
+    layout.namesA = uint32_t(out.size());
+    for (const Entry& e : listA) out.insert(out.end(), e.name.begin(), e.name.end());
+    Align4(out);
+    layout.countB = uint32_t(listB.size());
+    layout.keysB = uint32_t(out.size());
+    for (const Entry& e : listB) Push32(out, e.key);
+    layout.namesB = uint32_t(out.size());
+    for (const Entry& e : listB) out.insert(out.end(), e.name.begin(), e.name.end());
+    Align4(out);
+    layout.letters = uint32_t(out.size());
+    for (int16_t l : letters) Push16(out, uint16_t(l));
+    Align4(out);
+    return true;
+}
+
+namespace {
+VoiceListLayout g_layout;
+}
+
+void SetVoiceListLayout(const VoiceListLayout& layout) { g_layout = layout; }
+const VoiceListLayout& CurrentVoiceListLayout() { return g_layout; }
+
+}  // namespace callnames
diff --git a/runtime/src/hle/mlb/callnames_natives.cpp b/runtime/src/hle/mlb/callnames_natives.cpp
new file mode 100644
index 0000000..b153d55
--- /dev/null
+++ b/runtime/src/hle/mlb/callnames_natives.cpp
@@ -0,0 +1,121 @@
+// Phrase id -> bank / local index with the ranges of the callname banks grown (callnames.h). With no
+// callname mod the answers are the original's for every id (callnames_tests.cpp checks all of them).
+#include "abi_bridge.h"
+#include "callnames.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+
+extern "C" void MLB_VoicePhraseBank_8003B398(CpuContext* ctx) {
+    ctx->gpr[3] = callnames::PhraseBank(static_cast<uint32_t>(ctx->gpr[3]));
+}
+PPC_NATIVE_OVERRIDE_VOID(8003B398, MLB_VoicePhraseBank_8003B398, (CpuContext* ctx), (ctx));
+
+extern "C" void MLB_VoicePhraseLocal_8003B530(CpuContext* ctx) {
+    ctx->gpr[3] = static_cast<uint32_t>(callnames::PhraseLocal(static_cast<uint32_t>(ctx->gpr[3])));
+}
+PPC_NATIVE_OVERRIDE_VOID(8003B530, MLB_VoicePhraseLocal_8003B530, (CpuContext* ctx), (ctx));
+
+// The editor's name lists (env_voice_data.pack, file 3081): the readers of 0x807EDF4C-0x807EE35C with
+// the lists' places and sizes from callnames::CurrentVoiceListLayout() instead of constants. Without
+// callnames the layout is the original's, so they read what the original did.
+extern "C" void func_8000BBFC(CpuContext*);
+
+namespace {
+
+constexpr uint32_t kVoiceDataFile = 3081;
+
+// 0x8000BBFC(3081, 0x40000000 | offset): the pack's bytes at `offset`, in guest memory.
+uint32_t PackAddress(CpuContext* ctx, uint32_t offset) {
+    const uint32_t lr = ctx->lr, r4 = ctx->gpr[4];
+    ctx->gpr[3] = kVoiceDataFile;
+    ctx->gpr[4] = 0x40000000u | offset;
+    ctx->lr = 0x807EDF9Cu;  // as if called from the original reader
+    func_8000BBFC(ctx);
+    ctx->lr = lr;
+    ctx->gpr[4] = r4;
+    return static_cast<uint32_t>(ctx->gpr[3]);
+}
+
+uint32_t NameByKey(CpuContext* ctx, uint32_t key, int* list) {
+    const callnames::VoiceListLayout& layout = callnames::CurrentVoiceListLayout();
+    const uint32_t base = PackAddress(ctx, 0);
+    if (base == 0) {
+        if (list) *list = 0;
+        return 0;
+    }
+    const uint32_t offset = callnames::FindVoiceName(layout, key, [&](uint32_t at) { return Memory::Read32(base + at); }, list);
+    return offset ? base + offset : 0;
+}
+
+}  // namespace
+
+extern "C" void MLB_VoiceNameByKey_807EDF4C(CpuContext* ctx) {
+    ctx->gpr[3] = NameByKey(ctx, static_cast<uint32_t>(ctx->gpr[3]), nullptr);
+}
+PPC_NATIVE_OVERRIDE_VOID(807EDF4C, MLB_VoiceNameByKey_807EDF4C, (CpuContext* ctx), (ctx));
+
+extern "C" void MLB_VoiceListOfKey_807EE0C8(CpuContext* ctx) {
+    int list = 0;
+    NameByKey(ctx, static_cast<uint32_t>(ctx->gpr[3]), &list);
+    ctx->gpr[3] = static_cast<uint32_t>(list);
+}
+PPC_NATIVE_OVERRIDE_VOID(807EE0C8, MLB_VoiceListOfKey_807EE0C8, (CpuContext* ctx), (ctx));
+
+extern "C" void MLB_VoiceLetterStartB_807EE200(CpuContext* ctx) {
+    const uint32_t letter = static_cast<uint32_t>(ctx->gpr[3]);
+    const uint32_t at = PackAddress(ctx, callnames::CurrentVoiceListLayout().letters);
