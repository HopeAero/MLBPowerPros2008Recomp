+static void TestEncodeCached(const fs::path& dir) {
+    const fs::path wav = dir / "cached.wav", cache = dir / "encodecache";
+    WriteWav(wav, 1, 1, 22050, 16, Pcm16(Sine(300, 22050, 3000, 5000)));
+    callnames::Adpcm first, again, changed;
+    std::string error;
+    CHECK(callnames::EncodeCached(wav, cache, first, error));
+    CHECK(callnames::EncodeCached(wav, cache, again, error));
+    CHECK(first.data == again.data && first.samples == 3000);
+    size_t files = 0;
+    std::error_code ec;
+    for (const auto& entry : fs::directory_iterator(cache, ec)) files += entry.is_regular_file();
+    CHECK(files == 1);
+    WriteWav(wav, 1, 1, 22050, 16, Pcm16(Sine(700, 22050, 3000, 5000)));  // same name and size
+    CHECK(callnames::EncodeCached(wav, cache, changed, error));
+    CHECK(changed.data != first.data);
+    CHECK(!callnames::EncodeCached(dir / "nope.wav", cache, changed, error) && !error.empty());
+}
