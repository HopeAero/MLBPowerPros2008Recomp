+static void TestVoiceList() {
+    // A small pack with the game's structure: A = ABAD, BELL, ZITO; B = [A] Aardsma, T.Abreu, [B] Bell,
+    // [Z] Zito; C = one legend.
+    callnames::VoiceListLayout in;
+    in.keysA = 0x20; in.namesA = 0x40; in.countA = 3;
+    in.letters = 0x100;
+    in.keysB = 0x140; in.namesB = 0x180; in.countB = 7;
+    in.keysC = 0x300; in.namesC = 0x310; in.countC = 1;
+    std::vector<uint8_t> pack(0x340, 0);
+    std::memcpy(pack.data(), "PACKWII ", 8);
+    const char* a[] = {"ABAD", "BELL", "ZITO"};
+    for (uint32_t i = 0; i < 3; ++i) { Put32(pack, in.keysA + 4 * i, 0x8E40 + i); PutName(pack, in.namesA + 30 * i, G(a[i])); }
+    const std::pair<uint32_t, std::u16string> b[] = {
+        {0xFEFE, {char16_t(0x2000 | 220)}}, {0x8804, G("Aardsma")}, {0x8805, G("T.Abreu")},
+        {0xFEFE, {char16_t(0x2000 | 221)}}, {0x8806, G("Bell")}, {0xFEFE, {char16_t(0x2000 | 245)}}, {0x8807, G("Zito")}};
+    for (uint32_t i = 0; i < 7; ++i) { Put32(pack, in.keysB + 4 * i, b[i].first); PutName(pack, in.namesB + 30 * i, b[i].second); }
+    for (int l = 0; l < 26; ++l) Put16(pack, in.letters + 2 * l, 0xFFFF);
+    Put16(pack, in.letters + 0, 0);
+    Put16(pack, in.letters + 2, 3);
+    Put16(pack, in.letters + 50, 5);
+    Put32(pack, in.keysC, 0x9172);
+    PutName(pack, in.namesC, G("Great Ruth"));
+
+    callnames::Callname acuna, xander;
+    acuna.voice = 7300; acuna.listGame = G("Acuna Jr."); acuna.listUpper = G("ACUNAJR.");
+    xander.voice = 7301; xander.listGame = G("Xander"); xander.listUpper = G("XANDER");
+    std::vector<uint8_t> out;
+    callnames::VoiceListLayout layout = in;
+    CHECK(callnames::BuildVoiceList(pack, {acuna, xander}, out, layout));
+    CHECK(std::equal(pack.begin(), pack.end(), out.begin()));  // the original bytes stay
+    CHECK(layout.countA == 5 && layout.countB == 10 && layout.countC == 1 && layout.keysC == in.keysC);
+    std::vector<std::u16string> namesA;
+    for (uint32_t i = 0; i < layout.countA; ++i) namesA.push_back(GetName(out, layout.namesA + 30 * i));
+    CHECK((namesA == std::vector<std::u16string>{G("ABAD"), G("ACUNAJR."), G("BELL"), G("XANDER"), G("ZITO")}));
+    CHECK(Get32(out, layout.keysA + 4) == 0x8000 + 7300 && Get32(out, layout.keysA + 12) == 0x8000 + 7301);
+    std::vector<std::u16string> namesB;
+    for (uint32_t i = 0; i < layout.countB; ++i) namesB.push_back(GetName(out, layout.namesB + 30 * i));
+    CHECK((namesB == std::vector<std::u16string>{{char16_t(0x2000 | 220)}, G("Aardsma"), G("T.Abreu"), G("Acuna Jr."),
+                                                 {char16_t(0x2000 | 221)}, G("Bell"), {char16_t(0x2000 | 243)}, G("Xander"),
+                                                 {char16_t(0x2000 | 245)}, G("Zito")}));
+    CHECK(Get32(out, layout.keysB + 4 * 6) == 0xFEFE && Get32(out, layout.keysB + 4 * 7) == 0x8000 + 7301);
+    CHECK(int16_t(Get16(out, layout.letters + 0)) == 0 && int16_t(Get16(out, layout.letters + 2)) == 4);
+    CHECK(int16_t(Get16(out, layout.letters + 2 * 23)) == 6);  // X now has a group
+    CHECK(int16_t(Get16(out, layout.letters + 2 * 25)) == 8);
+    CHECK(int16_t(Get16(out, layout.letters + 2 * 2)) == -1);
+
+    auto read32 = [&](uint32_t at) { return Get32(out, at); };
+    int list = -1;
+    CHECK(GetName(out, callnames::FindVoiceName(layout, 0x8000 + 7300, read32, &list)) == G("Acuna Jr.") && list == 1);
+    CHECK(GetName(out, callnames::FindVoiceName(layout, 0x8804, read32, &list)) == G("Aardsma") && list == 1);
+    CHECK(GetName(out, callnames::FindVoiceName(layout, 0x8E41, read32, &list)) == G("BELL") && list == 2);
+    CHECK(GetName(out, callnames::FindVoiceName(layout, 0x9172, read32, &list)) == G("Great Ruth") && list == 1);
+    CHECK(callnames::FindVoiceName(layout, 0x1234, read32, &list) == 0 && list == 0);
+    CHECK(callnames::FindVoiceName(layout, 0, read32, &list) == 0);
+    // Without callnames every original key finds the same name as before.
+    auto readIn = [&](uint32_t at) { return Get32(pack, at); };
+    for (uint32_t key : {0x8804u, 0x8805u, 0x8806u, 0x8807u, 0x8E40u, 0x8E41u, 0x8E42u, 0x9172u})
+        CHECK(GetName(pack, callnames::FindVoiceName(in, key, readIn)) == GetName(out, callnames::FindVoiceName(layout, key, read32)));
+}
