+static void TestKeyConverters() {
+    CheckConverter("RemapKey", kRefDE8, std::size(kRefDE8), callnames::RemapKey);
+    CheckConverter("ColourName", kRefF70, std::size(kRefF70), callnames::ColourName);
+    CheckConverter("Excited", kRefC98, std::size(kRefC98), callnames::Excited);
+    CheckConverter("Variant0", kRefA14C0, std::size(kRefA14C0), [](uint32_t x) { return callnames::Variant(x, false); });
+    CheckConverter("Variant1", kRefA14C1, std::size(kRefA14C1), [](uint32_t x) { return callnames::Variant(x, true); });
+    const uint32_t key = 0x8000 + 7300;  // local 0x1484
+    CHECK(callnames::RemapKey(key) == 0x12484);                      // bank 14: normal surname
+    CHECK(callnames::Excited(callnames::RemapKey(key)) == 0x14484);  // bank 15: excited
+    CHECK(callnames::RemapKey(callnames::Excited(key)) == 0x14484);  // the other order the game uses
+    CHECK(callnames::ColourName(key) == 0x17484);                    // bank 17: full name
+    CHECK(callnames::Variant(key, false) == 0x12484);                // no 4th recording: the normal one
+    CHECK(callnames::Variant(key, true) == 0);
+    CHECK(callnames::RemapKey(0x8000 + 7222) == 0x8000 + 7222);      // outside the range: as the original
+}
