+// The game's reads go through DvdReadContract::ReadExact: a registered virtual file is assembled
+// from its pieces, across piece boundaries, and a read past its end fails.
+static void TestReadExactVirtual(const fs::path& dir) {
+    const fs::path source = dir / "source.bin";
+    std::ofstream(source, std::ios::binary) << "0123456789";
+    DvdReadContract::Virtual::File file;
+    file.key = dir / "virtual.key";
+    file.dvdPath = "/sound/test.bin";
+    file.bytes = {'a', 'b', 'c'};
+    file.AppendBytes(0, 3);
+    file.AppendSource(source, 2, 5);  // "23456"
+    file.AppendZeros(2);
+    DvdReadContract::Virtual::Register(file);
+    std::vector<uint8_t> out;
+    DvdReadContract::HostReadFailure failure;
+    CHECK(DvdReadContract::ReadExact(file.key, 1, 8, out, failure));
+    CHECK((out == std::vector<uint8_t>{'b', 'c', '2', '3', '4', '5', '6', 0}));
+    CHECK(!DvdReadContract::ReadExact(file.key, 5, 10, out, failure));
+}
+
+// Game text of ASCII letters (A-Z 220.., a-z 252..), '.' 4, ' ' 0.
+static std::u16string G(const char* text) {
+    std::u16string out;
+    for (const char* p = text; *p; ++p) {
+        const char c = *p;
+        out.push_back(char16_t(c >= 'A' && c <= 'Z' ? 220 + (c - 'A') : c >= 'a' && c <= 'z' ? 252 + (c - 'a') : c == '.' ? 4 : 0));
+    }
+    return out;
+}
+
+static void PutName(std::vector<uint8_t>& b, size_t at, const std::u16string& name) {
+    for (size_t i = 0; i < 15; ++i) Put16(b, at + 2 * i, i < name.size() ? name[i] : i == name.size() ? 0xFFFF : 0);
+}
+
+static std::u16string GetName(const std::vector<uint8_t>& b, size_t at) {
+    std::u16string out;
+    for (size_t i = 0; i < 15 && Get16(b, at + 2 * i) != 0xFFFF; ++i) out.push_back(Get16(b, at + 2 * i));
+    return out;
+}
