+// The first enabled mod (by name) with a [divisions] table, or null.
+const mods::Mod* DivisionsMod(const std::vector<mods::Mod>& all) {
+    for (const auto& mod : all) {
+        if (mod.enabled && mod.hasDivisions) return &mod;
+    }
+    return nullptr;
+}
+
+// A new game, before the game lays out its standings (0x80BAF2B4): puts the teams in the mod's
+// divisions (their words) and has the game rebuild its division and league lists (0x80B719EC, whose
+// argument only gives the team count at +4). The standings, the schedule generator's check
+// (0x80B97E08) and the screens then follow the lists.
+void ApplyDivisions(CpuContext* ctx) {
+    const auto all = mods::Discover();
+    const mods::Mod* mod = DivisionsMod(all);
+    if (!mod) return;
+    const uint32_t words = Memory::Read32(0x8104B5A0u) + 128;
+    if (!Memory::Contains(words, kTeams * 4)) return;
+    std::array<int, kTeams> current{};
+    for (int t = 0; t < kTeams; ++t) {
+        const uint32_t word = Memory::Read32(words + 4 * t);
+        current[t] = static_cast<int>((word >> 24) & 0xF) * 3 + static_cast<int>(word >> 28);
+    }
+    const Realignment realigned = Realign(current, mod->divisions);
+    if (!realigned.error.empty()) {
+        std::fprintf(stderr, "[season] divisions of mod \"%s\" not used: %s\n", mod->name.c_str(),
+                     realigned.error.c_str());
+        return;
+    }
+    for (int t = 0; t < kTeams; ++t) {
+        const uint32_t at = words + 4 * t;
+        Memory::Write32(at, TeamWordWithDivision(Memory::Read32(at), realigned.division[t]));
+    }
+    // A team count object for 0x80B719EC, on the guest stack below the caller's frame.
+    const uint32_t sp = ctx->gpr[1];
+    ctx->gpr[1] = sp - 64;
+    Memory::Write32(sp - 64, sp);  // back chain, as a frame would have
+    Memory::Write32(sp - 32 + 4, static_cast<uint32_t>(kTeams));
+    ctx->gpr[3] = sp - 32;
+    Call(ctx, 0x80B719ECu, InvokeDirectCpu<0x80B719ECu>);
+    ctx->gpr[1] = sp;
+    std::array<int, 2> perLeague{};
+    for (int d : realigned.division) ++perLeague[d / 3];
+    std::fprintf(stderr, "[season] divisions from mod \"%s\": %d American League teams, %d National League\n",
+                 mod->name.c_str(), perLeague[0], perLeague[1]);
+}
+
+// Whether a mod has schedule/<year>.csv for the year being built.
+bool HasSchedule() {
+    std::filesystem::path path;
+    std::string name;
+    const int year = Year();
+    return year && FindSchedule(year, path, name);
+}
