     return index >= 0 && index < kDays ? index : -1;
 }
 
+// Divisions: league 0 (American) or 1 (National), division 0 East, 1 Central, 2 West; index =
+// league * 3 + division, as in mod.toml's [divisions] keys (kDivisionKeys). Each team's word at
+// X + 128 + team * 4 carries its division in bits 31..28 and its league in bits 27..24; 0x80B719EC
+// rebuilds the division and league lists (up to 7 teams a division) from those words.
+inline constexpr const char* kDivisionKeys[6] = {"al_east", "al_central", "al_west",
+                                                 "nl_east", "nl_central", "nl_west"};
+constexpr int kMaxDivisionTeams = 7;
+inline uint32_t TeamWordWithDivision(uint32_t word, int index) {
+    const uint32_t league = static_cast<uint32_t>(index / 3), division = static_cast<uint32_t>(index % 3);
+    return (word & 0x00FFFFFFu) | (division << 28) | (league << 24);
+}
+// The division (0..5) of every team after a realignment: listed[i] holds division i's team codes;
+// unlisted teams keep `current`. Empty with an error when a code is unknown or repeated, or a
+// division ends up with more than kMaxDivisionTeams or none.
+struct Realignment {
+    std::array<int, kTeams> division{};
+    std::string error;
+};
+inline Realignment Realign(const std::array<int, kTeams>& current, const std::vector<std::string> (&listed)[6]) {
+    Realignment out;
+    out.division = current;
+    std::array<bool, kTeams> seen{};
+    for (int d = 0; d < 6; ++d) {
+        for (const auto& code : listed[d]) {
+            const int team = TeamNumber(code);
+            if (team < 0) { out.error = "unknown team '" + code + "'"; return out; }
+            if (seen[team]) { out.error = "team '" + code + "' listed twice"; return out; }
+            seen[team] = true;
+            out.division[team] = d;
+        }
+    }
+    std::array<int, 6> count{};
+    for (int d : out.division) ++count[d];
+    for (int d = 0; d < 6; ++d) {
+        if (count[d] == 0 || count[d] > kMaxDivisionTeams) {
+            out.error = std::string(kDivisionKeys[d]) + " would have " + std::to_string(count[d]) + " teams";
+            return out;
+        }
+    }
+    return out;
+}
+
 inline uint32_t TimeWord(int minutes) { return static_cast<uint32_t>((minutes / 60) * 400 + (minutes % 60) * 4); }
 inline uint32_t FlagsWord(int minutes) { return kGameFlags | (minutes >= kNightFrom ? kNightFlag : 0u); }
 
