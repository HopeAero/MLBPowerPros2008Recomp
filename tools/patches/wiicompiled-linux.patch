+    // job object for the same thing).
+    static pid_t serverPid = 0;
+    int status = 0;
+    if (serverPid <= 0 || waitpid(serverPid, &status, WNOHANG) != 0) {
+        // Everything the child needs is built before fork: only async-signal-safe calls after it.
+        std::vector<std::string> args{server.string(), "--urls", "http://127.0.0.1:5123", "--contentRoot", app.string(),
+                                      "--DataDirectory=" + (data / "Data").string(),
