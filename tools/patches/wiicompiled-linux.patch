+#if !defined(_WIN32)
+// Font paths differ per distribution (Fedora and SteamOS have no DejaVu where Debian and Arch keep
+// it): when none of the listed files exists, ask fontconfig for the closest match to the pattern.
+inline ImFont* LoadFontconfigFont(const char* pattern, float size) {
+    const std::string command = std::string("fc-match -f '%{file}' '") + pattern + "' 2>/dev/null";
+    FILE* pipe = popen(command.c_str(), "r");
+    if (pipe == nullptr) return nullptr;
+    char path[4096] = {};
+    const size_t length = std::fread(path, 1, sizeof(path) - 1, pipe);
+    pclose(pipe);
+    if (length == 0) return nullptr;
+    path[length] = '\0';
+    return LoadFirstFont({path}, size);
+}
+#endif
