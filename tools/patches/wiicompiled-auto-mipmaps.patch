diff --git a/aurora-main/lib/gfx/auto_mips.hpp b/aurora-main/lib/gfx/auto_mips.hpp
new file mode 100644
index 0000000..58190c7
--- /dev/null
+++ b/aurora-main/lib/gfx/auto_mips.hpp
@@ -0,0 +1,133 @@
+#pragma once
+
+// Mip chains for RGBA8 textures the game ships without mipmaps (most stadium textures).
+// Header-only and free of WebGPU so runtime/tests/auto_mips_tests.cpp can check it.
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace aurora::gfx::auto_mips {
+
+// Same rule as WebGPU and GX: each level halves, never below 1.
+inline uint32_t level_count(uint32_t width, uint32_t height) noexcept {
+  uint32_t dimension = std::max(width, height);
+  uint32_t count = 1;
+  while (dimension > 1) {
+    dimension >>= 1;
+    ++count;
+  }
+  return count;
+}
+
+inline size_t chain_bytes(uint32_t width, uint32_t height, uint32_t levels) noexcept {
+  size_t total = 0;
+  for (uint32_t i = 0; i < levels; ++i) {
+    total += static_cast<size_t>(std::max(width >> i, 1u)) * std::max(height >> i, 1u) * 4;
+  }
+  return total;
+}
+
+namespace detail {
+// Alpha-test threshold assumed for coverage; GX alpha compare refs vary per draw, 0.5 is the usual one.
+constexpr uint32_t kCoverageRef = 128;
+
+inline float coverage(const uint8_t* rgba, size_t pixels, float scale) noexcept {
+  size_t covered = 0;
+  for (size_t i = 0; i < pixels; ++i) {
+    covered += rgba[i * 4 + 3] * scale >= kCoverageRef;
+  }
+  return pixels != 0 ? static_cast<float>(covered) / static_cast<float>(pixels) : 0.f;
+}
+
+// Cut-out textures (crowd, trees, flags, fences) are mostly fully opaque or fully transparent texels.
+inline bool is_cutout(const uint8_t* rgba, size_t pixels) noexcept {
+  size_t transparent = 0;
+  size_t partial = 0;
+  for (size_t i = 0; i < pixels; ++i) {
+    const uint8_t a = rgba[i * 4 + 3];
+    transparent += a < 16;
+    partial += a >= 16 && a < 240;
+  }
+  return transparent != 0 && partial * 10 < pixels;
+}
+} // namespace detail
+
+// Returns the whole chain, level 0 first (a copy of base), or empty when the texture is too small to bother.
+// Colour is averaged weighted by alpha, so transparent black texels don't darken edges. For cut-out textures
+// each level's alpha is rescaled to keep level 0's alpha-test coverage, so distant crowd and trees don't thin out.
+inline std::vector<uint8_t> build_chain(const uint8_t* base, uint32_t width, uint32_t height) {
+  const uint32_t levels = level_count(width, height);
+  if (levels < 2) {
+    return {};
+  }
+  std::vector<uint8_t> chain(chain_bytes(width, height, levels));
+  const size_t basePixels = static_cast<size_t>(width) * height;
+  std::copy(base, base + basePixels * 4, chain.begin());
+
+  const bool cutout = detail::is_cutout(base, basePixels);
+  const float baseCoverage = cutout ? detail::coverage(base, basePixels, 1.f) : 0.f;
+
+  // The unscaled previous level feeds the next one; only the stored copy gets the coverage scale.
+  std::vector<uint8_t> prev(base, base + basePixels * 4);
+  std::vector<uint8_t> cur;
+  uint32_t pw = width;
+  uint32_t ph = height;
+  size_t offset = basePixels * 4;
+  for (uint32_t level = 1; level < levels; ++level) {
+    const uint32_t w = std::max(pw >> 1, 1u);
+    const uint32_t h = std::max(ph >> 1, 1u);
+    cur.assign(static_cast<size_t>(w) * h * 4, 0);
+    for (uint32_t y = 0; y < h; ++y) {
+      for (uint32_t x = 0; x < w; ++x) {
+        const uint32_t xs[2] = {std::min(x * 2, pw - 1), std::min(x * 2 + 1, pw - 1)};
+        const uint32_t ys[2] = {std::min(y * 2, ph - 1), std::min(y * 2 + 1, ph - 1)};
+        uint32_t sum[3] = {};
+        uint32_t weighted[3] = {};
+        uint32_t alpha = 0;
+        for (uint32_t sy : ys) {
+          for (uint32_t sx : xs) {
+            const uint8_t* p = &prev[(static_cast<size_t>(sy) * pw + sx) * 4];
+            for (int c = 0; c < 3; ++c) {
+              sum[c] += p[c];
+              weighted[c] += p[c] * p[3];
+            }
+            alpha += p[3];
+          }
+        }
+        uint8_t* d = &cur[(static_cast<size_t>(y) * w + x) * 4];
+        for (int c = 0; c < 3; ++c) {
+          d[c] = static_cast<uint8_t>(alpha != 0 ? (weighted[c] + alpha / 2) / alpha : (sum[c] + 2) / 4);
+        }
+        d[3] = static_cast<uint8_t>((alpha + 2) / 4);
+      }
+    }
+
+    float scale = 1.f;
+    const size_t pixels = static_cast<size_t>(w) * h;
+    if (cutout) {
+      // Coverage grows with scale: bisect for the scale that matches level 0.
+      float lo = 0.f;
+      float hi = 4.f;
+      for (int i = 0; i < 12; ++i) {
+        const float mid = (lo + hi) * 0.5f;
+        (detail::coverage(cur.data(), pixels, mid) < baseCoverage ? lo : hi) = mid;
+      }
+      scale = hi;
+    }
+    for (size_t i = 0; i < pixels; ++i) {
+      chain[offset + i * 4 + 0] = cur[i * 4 + 0];
+      chain[offset + i * 4 + 1] = cur[i * 4 + 1];
+      chain[offset + i * 4 + 2] = cur[i * 4 + 2];
+      chain[offset + i * 4 + 3] = static_cast<uint8_t>(std::min(cur[i * 4 + 3] * scale + 0.5f, 255.f));
+    }
+    offset += pixels * 4;
+    prev.swap(cur);
+    pw = w;
+    ph = h;
+  }
+  return chain;
+}
+
+} // namespace aurora::gfx::auto_mips
