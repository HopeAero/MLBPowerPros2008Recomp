new file mode 100644
index 0000000..a13f502
--- /dev/null
+++ b/runtime/tests/auto_mips_tests.cpp
@@ -0,0 +1,50 @@
+#include "../../aurora-main/lib/gfx/auto_mips.hpp"
+#include <cstdlib>
+#include <vector>
+int main() {
+    const auto require = [](bool ok) { if (!ok) std::abort(); };
+    using namespace aurora::gfx::auto_mips;
+    require(level_count(256, 256) == 9 && level_count(256, 32) == 9 && level_count(1, 1) == 1);
+    require(level_count(6, 3) == 3); // 6x3, 3x1, 1x1
+
+    // Checkerboard: level 1 averages to grey, and the chain ends at 1x1.
+    std::vector<uint8_t> checker(8 * 8 * 4);
+    for (int i = 0; i < 64; ++i) {
+        const uint8_t v = ((i % 8) + (i / 8)) % 2 ? 255 : 0;
+        checker[i * 4 + 0] = checker[i * 4 + 1] = checker[i * 4 + 2] = v;
+        checker[i * 4 + 3] = 255;
+    }
+    auto chain = build_chain(checker.data(), 8, 8);
+    require(chain.size() == chain_bytes(8, 8, 4));
+    require(std::equal(checker.begin(), checker.end(), chain.begin()));
+    require(chain[64 * 4] == 128 && chain[64 * 4 + 3] == 255);
+
+    // Transparent black next to opaque red: colour must stay red, not darken to 128.
+    std::vector<uint8_t> edge(8 * 8 * 4, 0);
+    for (int i = 0; i < 64; i += 2) {
+        edge[i * 4 + 0] = 255;
+        edge[i * 4 + 3] = 255;
+    }
+    chain = build_chain(edge.data(), 8, 8);
+    require(chain[64 * 4 + 0] == 255);
+
+    // Cut-out: a sparse dither (1 texel in 4 opaque, like distant crowd or leaves). Plain averaging gives
+    // alpha 64 everywhere and the alpha test drops it all; the rescale keeps it visible.
+    std::vector<uint8_t> sparse(16 * 16 * 4, 0);
+    for (int y = 0; y < 16; y += 2) {
+        for (int x = (y / 2) % 2; x < 16; x += 2) {
+            uint8_t* p = &sparse[(y * 16 + x) * 4];
+            p[1] = 200;
+            p[3] = 255;
+        }
+    }
+    chain = build_chain(sparse.data(), 16, 16);
+    for (size_t offset = 256 * 4, w = 8; w >= 2; offset += w * w * 4, w /= 2) {
+        size_t covered = 0;
+        for (size_t i = 0; i < w * w; ++i) covered += chain[offset + i * 4 + 3] >= 128;
+        require(covered > 0);
+    }
+
+    // Too small to mip: nothing generated.
+    require(build_chain(checker.data(), 1, 1).empty());
+}
