+void draw() {
+    if (!enabled()) return;
+    if (!error.empty()) {
+        ImGui::SetNextWindowBgAlpha(0.95f);
+        if (ImGui::Begin("Postseason", nullptr, ImGuiWindowFlags_AlwaysAutoResize))
+            ImGui::TextWrapped("12-team postseason could not start: %s", error.c_str());
+        ImGui::End();
+    }
+    // The bracket screen (0x80B8A250), shown whole while it is not simulating ([screen + 2044] == 0).
+    static int shown = 0;
+    const auto* row = current();
+    if (!bracket || !Memory::Contains(bracket, 2048) || Memory::Read8(bracket + 2044) != 0 || !row || !row->qualified) {
+        shown = 0;
+        return;
+    }
+    if (shown == 0 && !Ready()) return;
+    ++shown;
+    const ImVec2 window = ImGui::GetIO().DisplaySize;
+    // As SCGetAspectRatio answers the game (sc_aspect_ratio.cpp): 16:9 with either setting.
+    const bool wide = widescreen();
+    const Layout& layout = wide ? kWide : kNarrowLayout;
+    // 4:3 shows the game's 640 x 528 picture (the 1225 x 1009 measured above).
+    const float aspect = !wide ? layout.width / layout.height : MkwForceAspect169Requested() ? 16.0f / 9.0f : window.x / window.y;
+    const float w = std::min(window.x, window.y * aspect), h = w / aspect;
+    const ImVec4 game((window.x - w) * 0.5f, (window.y - h) * 0.5f, w, h);
+    const float alpha = std::min(1.0f, shown / 20.0f);  // the screen fades in
+    for (int league = 0; league < 2; ++league) {
+        pair(Frame{game, layout, alpha, false, league == 1}, league, 9 + league * 2);  // 4 vs 5, next to seed 1
+        pair(Frame{game, layout, alpha, true, league == 1}, league, 8 + league * 2);   // 3 vs 6, next to seed 2
+    }
+}
