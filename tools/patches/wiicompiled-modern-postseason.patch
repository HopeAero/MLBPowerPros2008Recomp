--- /dev/null
+++ b/runtime/include/modern_postseason.h
@@ -0,0 +1,254 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+// MLB Rule 34(c), 35 and 38; current explainer: https://www.mlb.com/news/mlb-playoff-tiebreaker-rules
+namespace modern_postseason {
+constexpr int pending = 44;
+struct Team { int id=44, division=0, wins=0, losses=0; };
+struct GameResult { int home=44, away=44, homeRuns=0, awayRuns=0, day=0; };
+struct Series { int higher=44, lower=44, higherWins=0, lowerWins=0, target=0, winner=44; };
+using Seeds = std::array<std::array<int,6>,2>;
+struct State {
+    std::array<Team,30> teams{};
+    Seeds seeds = [] { Seeds s{}; for(auto& league:s) league.fill(pending); return s; }();
+    std::array<Series,12> series{};
+};
+
+namespace detail {
+struct Record { std::int64_t wins=0, games=0; };
+inline int compare(Record a, Record b) {
+    const auto left=a.wins*std::max<std::int64_t>(1,b.games);
+    const auto right=b.wins*std::max<std::int64_t>(1,a.games);
+    return (left>right)-(left<right);
+}
+inline Record standing(const Team& t) { return {t.wins,std::int64_t(t.wins)+t.losses}; }
+inline std::array<Team,30> validate(const std::array<Team,30>& teams,const std::vector<GameResult>& games) {
+    std::array<Team,30> result{};
+    std::array<bool,30> seen{};
+    std::array<int,6> counts{};
+    for(const auto& t:teams) {
+        if(t.id<0 || t.id>=30 || seen[t.id] || t.division<0 || t.division>=6 || t.wins<0 || t.losses<0)
+            throw std::invalid_argument("invalid postseason team standings");
+        seen[t.id]=true; ++counts[t.division]; result[t.id]=t;
+    }
+    for(int n:counts) if(n==0) throw std::invalid_argument("each division requires at least one team");
+    for(int league=0;league<2;++league)
+        if(counts[league*3]+counts[league*3+1]+counts[league*3+2]<6)
+            throw std::invalid_argument("each league requires at least six teams");
+    for(const auto& g:games)
+        if(g.home<0 || g.home>=30 || g.away<0 || g.away>=30 || g.home==g.away ||
+           g.homeRuns<0 || g.awayRuns<0 || g.homeRuns==g.awayRuns || g.day<0)
+            throw std::invalid_argument("invalid regular-season game result");
+    return result;
+}
+inline bool contains(const std::vector<int>& ids,int id) { return std::find(ids.begin(),ids.end(),id)!=ids.end(); }
+struct TieBreaker {
+    const std::array<Team,30>& teams;
+    const std::vector<GameResult>& games;
+    int allStarDay;
+    Record record(int id,const std::vector<int>& tied,int kind) const {
+        Record r;
+        for(const auto& g:games) {
+            if(g.home!=id && g.away!=id) continue;
+            int other=g.home==id?g.away:g.home;
+            if(kind==0 && !contains(tied,other)) continue;
+            if(kind==1 && teams[id].division!=teams[other].division) continue;
+            if(kind==2 && teams[id].division/3!=teams[other].division/3) continue;
+            ++r.games;
+            r.wins+=(g.home==id)==(g.homeRuns>g.awayRuns);
+        }
+        return r;
+    }
+    template<class Metric> std::vector<int> leaders(const std::vector<int>& ids,Metric metric) const {
+        std::vector<int> best;
+        Record score;
+        for(int id:ids) {
+            auto value=metric(id);
+            int cmp=best.empty()?1:compare(value,score);
+            if(cmp>0) { best.clear(); score=value; }
+            if(cmp>=0) best.push_back(id);
+        }
+        return best;
+    }
+    int winner(const std::vector<int>& ids) const {
+        if(ids.empty()) throw std::invalid_argument("empty tiebreak group");
+        if(ids.size()==1) return ids.front();
+        // Rule 34(c) spells out ties of up to four clubs; larger ties follow the same steps (user decision).
+        // Rule 34(c): a club beating every tied opponent precedes aggregate percentages.
+        if(ids.size()>2) for(int id:ids) {
+            bool dominant=true;
+            for(int other:ids) if(other!=id) {
+                auto r=record(id,{other},0);
+                if(r.wins*2<=r.games || r.games==0) dominant=false;
+            }
+            if(dominant) return id;
+        }
+        for(int kind=0;kind<3;++kind) {
+            // No evidence is not a losing record; skip criteria lacking a club's results.
+            if(std::any_of(ids.begin(),ids.end(),[&](int id){return record(id,ids,kind).games==0;})) continue;
+            auto best=leaders(ids,[&](int id){return record(id,ids,kind);});
+            if(best.size()==1) return best.front();
+            if(best.size()<ids.size()) return winner(best);
+        }
+        // Rule 34(c) defines last half as after the All-Star break, not N/2 games.
+        if(allStarDay<0) throw std::runtime_error("unresolved MLB tie requires the All-Star break day");
+        std::vector<std::vector<const GameResult*>> history;
+        std::vector<std::size_t> starts;
+        for(int id:ids) {
+            std::vector<const GameResult*> list;
+            for(const auto& g:games) {
+                if(g.home!=id && g.away!=id) continue;
+                int other=g.home==id?g.away:g.home;
+                if(teams[id].division/3==teams[other].division/3) list.push_back(&g);
+            }
+            // Stable ordering preserves caller's doubleheader order within a day.
+            std::stable_sort(list.begin(),list.end(),[](auto a,auto b){return a->day<b->day;});
+            std::size_t start=0;
+            while(start<list.size() && list[start]->day<=allStarDay) ++start;
+            if(start==list.size()) throw std::runtime_error("unresolved MLB tie lacks post-All-Star intraleague results");
+            starts.push_back(start); history.push_back(std::move(list));
+        }
+        for(;;) {
+            auto best=leaders(ids,[&](int id) {
+                auto i=std::find(ids.begin(),ids.end(),id)-ids.begin();
+                Record r;
+                for(auto j=starts[i];j<history[i].size();++j) {
+                    const auto& g=*history[i][j];
+                    ++r.games; r.wins+=(g.home==id)==(g.homeRuns>g.awayRuns);
+                }
+                return r;
+            });
+            if(best.size()==1) return best.front();
+            if(best.size()<ids.size()) return winner(best);
+            bool extended=false;
+            for(std::size_t i=0;i<ids.size();++i) {
+                // In multi-club ties the added game must exclude the tied opponents.
+                while(starts[i]>0) {
+                    const auto& g=*history[i][--starts[i]];
+                    int other=g.home==ids[i]?g.away:g.home;
+                    if(ids.size()==2 || !contains(ids,other)) { extended=true; break; }
+                    // Excluded tied-club games must not enter the extended window.
+                    history[i].erase(history[i].begin()+starts[i]);
+                }
+            }
+            if(!extended) return draw(ids);
+        }
+    }
+    // Every league game compared and still tied: Rule 34(c) leaves it to the Commissioner. Here a draw
+    // seeded by the season's results, so the same season (and a reloaded save) always draws the same club.
+    int draw(std::vector<int> ids) const {
+        std::sort(ids.begin(),ids.end());
+        std::uint32_t hash=2166136261u;
+        auto mix=[&](int value){ hash=(hash^static_cast<std::uint32_t>(value))*16777619u; };
+        for(const auto& g:games) { mix(g.home); mix(g.away); mix(g.homeRuns); mix(g.awayRuns); mix(g.day); }
+        for(int id:ids) mix(id);
+        return ids[hash%ids.size()];
+    }
+    int best(const std::vector<int>& ids) const {
+        return winner(leaders(ids,[&](int id){return standing(teams[id]);}));
+    }
+};
+}
+
+inline int resolveTie(const std::array<Team,30>& teams,const std::vector<GameResult>& games,
+                      const std::vector<int>& tied,int allStarDay=-1) {
+    const auto normalized=detail::validate(teams,games);
+    std::vector<int> seen;
+    for(int id:tied) {
+        if(id<0 || id>=30 || detail::contains(seen,id)) throw std::invalid_argument("invalid tiebreak group");
+        seen.push_back(id);
+    }
+    return detail::TieBreaker{normalized,games,allStarDay}.winner(tied);
+}
+
+inline Seeds selectSeeds(const std::array<Team,30>& teams,const std::vector<GameResult>& games,int allStarDay=-1) {
+    const auto normalized=detail::validate(teams,games);
+    detail::TieBreaker rank{normalized,games,allStarDay};
+    Seeds seeds{};
+    for(int league=0;league<2;++league) {
+        std::vector<int> champions,others;
+        for(int division=league*3;division<league*3+3;++division) {
+            std::vector<int> members;
+            for(const auto& t:normalized) if(t.division==division) members.push_back(t.id);
+            champions.push_back(rank.best(members));
+        }
+        for(const auto& t:normalized)
+            if(t.division/3==league && !detail::contains(champions,t.id)) others.push_back(t.id);
+        for(int seed=0;seed<6;++seed) {
+            auto& pool=seed<3?champions:others;
+            int id=rank.best(pool);
+            seeds[league][seed]=id;
+            pool.erase(std::find(pool.begin(),pool.end(),id));
+        }
+    }
+    return seeds;
+}
+
+inline int homeTeam(const Series& s,int game) {
+    if(s.higher<0 || s.higher>=30 || s.lower<0 || s.lower>=30 || s.higher==s.lower ||
+       (s.target!=2 && s.target!=3 && s.target!=4) || game<0 || game>=s.target*2-1)
+        throw std::invalid_argument("invalid postseason series game");
+    bool higher=s.target==2 || game<2 || (s.target==3?game==4:game>=5);
+    return higher?s.higher:s.lower;
+}
+inline int seedOf(const State& state,int id) {
+    for(const auto& league:state.seeds)
+        for(int i=0;i<6;++i) if(league[i]==id) return i;
+    throw std::invalid_argument("team is not a postseason qualifier");
+}
+inline void advance(State& state,const std::vector<GameResult>& games,int allStarDay=-1) {
+    auto next=state;
+    auto setup=[&](int index,int a,int b,int target,bool world=false) {
+        if(a==pending || b==pending || next.series[index].higher!=pending) return;
+        if(a<0 || a>=30 || b<0 || b>=30 || a==b)
+            throw std::invalid_argument("invalid postseason bracket participants");
+        int higher;
+        if(world) {
+            const auto teams=detail::validate(next.teams,games);
+            higher=detail::TieBreaker{teams,games,allStarDay}.best({a,b});
+        } else higher=seedOf(next,a)<seedOf(next,b)?a:b;
+        next.series[index]={higher,higher==a?b:a,0,0,target,pending};
+    };
+    for(int league=0;league<2;++league) {
+        int ds=league*2,wc=8+league*2;
+        setup(ds,next.seeds[league][0],next.series[wc+1].winner,3);
+        setup(ds+1,next.seeds[league][1],next.series[wc].winner,3);
+        setup(4+league,next.series[ds].winner,next.series[ds+1].winner,4);
+    }
+    setup(6,next.series[4].winner,next.series[5].winner,4,true);
+    state=next;
+}
+inline State create(const std::array<Team,30>& teams,const std::vector<GameResult>& games,int allStarDay=-1) {
+    State state;
+    state.teams=detail::validate(teams,games);
+    state.seeds=selectSeeds(state.teams,games,allStarDay);
+    for(int league=0;league<2;++league) {
+        const auto& s=state.seeds[league];
+        state.series[8+league*2]={s[2],s[5],0,0,2,pending};
+        state.series[9+league*2]={s[3],s[4],0,0,2,pending};
+    }
+    return state;
+}
+inline void recordWin(State& state,int index,int team,const std::vector<GameResult>& games,int allStarDay=-1) {
+    if(index<0 || index>=12 || index==7) throw std::invalid_argument("invalid postseason series index");
+    auto next=state;
+    auto& s=next.series[index];
+    if(s.higher<0 || s.higher>=30 || s.lower<0 || s.lower>=30 || s.higher==s.lower ||
+       s.winner!=pending || (team!=s.higher && team!=s.lower) ||
+       (s.target!=2 && s.target!=3 && s.target!=4) || s.higherWins<0 || s.lowerWins<0 ||
+       s.higherWins>=s.target || s.lowerWins>=s.target)
+        throw std::invalid_argument("postseason series is not accepting results");
+    int& wins=team==s.higher?s.higherWins:s.lowerWins;
+    if(++wins==s.target) s.winner=team;
+    advance(next,games,allStarDay);
+    state=next;
+}
+}
+
+
+
+
diff --git a/runtime/include/modern_postseason_save.h b/runtime/include/modern_postseason_save.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/modern_postseason_save.h
@@ -0,0 +1,120 @@
+#pragma once
+#include "modern_postseason.h"
+#include <cstddef>
+
+namespace modern_postseason {
+constexpr size_t saveBytes=6144;
+struct SavedYear {
+    bool qualified=false;
+    uint32_t firstDay=0;
+    Seeds seeds=[] { Seeds value{}; for(auto& league:value) league.fill(pending); return value; }();
+    std::array<std::array<uint8_t,20>,4> wildCards{};
+};
+struct SavedArchive { uint32_t year=0; SavedYear data; };
+struct SavedState {
+    bool enabled=false;
+    std::array<SavedYear,20> years{};
+    std::vector<SavedArchive> archive;
+};
+enum class SaveStatus { Missing, Valid, Invalid };
+
+namespace save_detail {
+constexpr std::array<uint8_t,8> magic{'M','L','B','P','O','S','T','S'};
+constexpr size_t yearBytes=100;
+constexpr size_t archiveOffset=17+20*yearBytes, archiveLimit=28;
+static_assert(archiveOffset+4+archiveLimit*(4+yearBytes)<=saveBytes);
+inline uint32_t get32(const uint8_t* data) {
+    return uint32_t(data[0])<<24 | uint32_t(data[1])<<16 | uint32_t(data[2])<<8 | data[3];
+}
+inline void put32(uint8_t* data,uint32_t value) {
+    for(int i=3;i>=0;--i) { data[i]=uint8_t(value); value>>=8; }
+}
+inline uint32_t checksum(const uint8_t* data) {
+    uint32_t hash=2166136261u;
+    for(size_t i=0;i<saveBytes;++i) hash=(hash^(i>=12&&i<16?0:data[i]))*16777619u;
+    return hash;
+}
+inline bool zero(const uint8_t* begin,const uint8_t* end) {
+    return std::all_of(begin,end,[](uint8_t byte){return byte==0;});
+}
+inline void writeYear(const SavedYear& year,uint8_t* row) {
+    if(!year.qualified) return;
+    row[0]=1;
+    put32(row+4,year.firstDay);
+    for(int l=0;l<2;++l) for(int s=0;s<6;++s) row[8+l*6+s]=uint8_t(year.seeds[l][s]);
+    for(int s=0;s<4;++s) std::copy(year.wildCards[s].begin(),year.wildCards[s].end(),row+20+s*20);
+}
+inline bool readYear(const uint8_t* row,SavedYear& year) {
+    if(row[0]>1 || !zero(row+1,row+4)) return false;
+    if(!row[0]) return zero(row,row+yearBytes);
+    year.qualified=true;
+    year.firstDay=get32(row+4);
+    if(year.firstDay!=275) return false;
+    std::array<bool,30> seen{};
+    for(int l=0;l<2;++l) for(int s=0;s<6;++s) {
+        const auto id=row[8+l*6+s];
+        if(id>=seen.size() || seen[id]) return false;
+        seen[id]=true; year.seeds[l][s]=id;
+    }
+    for(int s=0;s<4;++s) {
+        auto& series=year.wildCards[s];
+        std::copy_n(row+20+s*20,20,series.begin());
+        const auto home=get32(series.data()+8), away=get32(series.data()+12);
+        const auto& league=year.seeds[s/2];
+        const auto winner=(series[19]>>4)&7;
+        if(home!=uint32_t(league[2+s%2]) || away!=uint32_t(league[5-s%2]) ||
+           series[16]>2 || series[17]>2 || winner>2 ||
+           (winner==0 && (series[16]!=2 || series[17]>=2)) ||
+           (winner==1 && (series[17]!=2 || series[16]>=2)) ||
+           (winner==2 && (series[16]>=2 || series[17]>=2))) return false;
+    }
+    return true;
+}
+}
+
+// v1: magic[8], BE version/checksum, enabled byte, 20 x 100-byte years, BE archive count,
+// at most 28 x (BE calendar year + 100-byte year), zero padding.
+// Each year: qualified byte, 3 reserved bytes, BE firstDay, 12 seed bytes, 4 x 20 guest bytes.
+// Caller supplies saveBytes writable bytes; checksum is FNV-1a with bytes12..15 treated as zero.
+inline void writeSave(const SavedState& state,uint8_t* out) {
+    std::fill_n(out,saveBytes,uint8_t(0));
+    std::copy(save_detail::magic.begin(),save_detail::magic.end(),out);
+    save_detail::put32(out+8,1);
+    out[16]=state.enabled;
+    for(size_t y=0;y<state.years.size();++y)
+        save_detail::writeYear(state.years[y],out+17+y*save_detail::yearBytes);
+    const auto count=std::min(state.archive.size(),save_detail::archiveLimit);
+    save_detail::put32(out+save_detail::archiveOffset,uint32_t(count));
+    for(size_t i=0;i<count;++i) {
+        const auto& entry=state.archive[state.archive.size()-count+i];
+        auto* row=out+save_detail::archiveOffset+4+i*(4+save_detail::yearBytes);
+        save_detail::put32(row,entry.year);
+        save_detail::writeYear(entry.data,row+4);
+    }
+    save_detail::put32(out+12,save_detail::checksum(out));
+}
+
+inline SaveStatus readSave(const uint8_t* data,size_t size,SavedState& out) {
+    if(!data || size<save_detail::magic.size() ||
+       !std::equal(save_detail::magic.begin(),save_detail::magic.end(),data)) return SaveStatus::Missing;
+    if(size<saveBytes || save_detail::get32(data+8)!=1 ||
+       save_detail::get32(data+12)!=save_detail::checksum(data) || data[16]>1) return SaveStatus::Invalid;
+    const auto count=save_detail::get32(data+save_detail::archiveOffset);
+    if(count>save_detail::archiveLimit ||
+       !save_detail::zero(data+save_detail::archiveOffset+4+count*(4+save_detail::yearBytes),data+saveBytes))
+        return SaveStatus::Invalid;
+    SavedState state;
+    state.enabled=data[16]!=0;
+    for(size_t y=0;y<state.years.size();++y)
+        if(!save_detail::readYear(data+17+y*save_detail::yearBytes,state.years[y])) return SaveStatus::Invalid;
+    for(size_t i=0;i<count;++i) {
+        const auto* row=data+save_detail::archiveOffset+4+i*(4+save_detail::yearBytes);
+        SavedArchive entry; entry.year=save_detail::get32(row);
+        if(entry.year<2008 || entry.year>9999 || (!state.archive.empty() && entry.year<=state.archive.back().year) ||
+           !save_detail::readYear(row+4,entry.data) || !entry.data.qualified) return SaveStatus::Invalid;
+        state.archive.push_back(entry);
+    }
+    out=state;
+    return SaveStatus::Valid;
+}
+}
diff --git a/runtime/include/postseason_guest.h b/runtime/include/postseason_guest.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/postseason_guest.h
@@ -0,0 +1,42 @@
+#pragma once
+#include "modern_postseason_save.h"
+
+namespace modern_postseason {
+enum class GameStatus { Scheduled, Finished, Tied, Invalid };
+inline GameStatus decodeGame(const uint8_t* bytes,int day,GameResult& out) {
+    const uint32_t a=save_detail::get32(bytes),b=save_detail::get32(bytes+4);
+    const uint32_t flags=save_detail::get32(bytes+12),status=(flags>>23)&7,winner=(flags>>20)&7;
+    if(a>=30 || b>=30 || a==b || status>2) return GameStatus::Invalid;
+    if(status!=2) return GameStatus::Scheduled;
+    const int ar=bytes[8],br=bytes[9];
+    if(winner==2 && ar==br) return GameStatus::Tied;
+    if(winner>1 || (winner==0)!=(ar>br) || ar==br) return GameStatus::Invalid;
+    out={static_cast<int>(a),static_cast<int>(b),ar,br,day};
+    return GameStatus::Finished;
+}
+inline bool wildCardDay(int day) { return day>=275 && day<=277; }
+inline int classifyPostseasonDay(int day) {
+    if(day>=275 && day<=285) return 2;
+    if(day>=286 && day<=295) return 3;
+    if(day>=296 && day<=304) return 4;
+    return -1;
+}
+inline int roundSeries(int round,int slot) {
+    const int first[]={0,4,6},count[]={4,2,1};
+    return round>=0 && round<3 && slot>=0 && slot<count[round]?first[round]+slot:-1;
+}
+inline Series decodeSeries(const uint8_t* bytes,int target) {
+    const uint32_t state=(save_detail::get32(bytes+16)>>4)&7;
+    const int a=static_cast<int>(save_detail::get32(bytes+8)),b=static_cast<int>(save_detail::get32(bytes+12));
+    return {a,b,bytes[16],bytes[17],target,state==0?a:state==1?b:pending};
+}
+inline void encodeSeries(const Series& s,int day,uint8_t* bytes) {
+    save_detail::put32(bytes,8);
+    save_detail::put32(bytes+4,8);
+    save_detail::put32(bytes+8,static_cast<uint32_t>(s.higher));
+    save_detail::put32(bytes+12,static_cast<uint32_t>(s.lower));
+    const uint32_t state=s.winner==pending?2:s.winner==s.higher?0:1;
+    save_detail::put32(bytes+16,(static_cast<uint32_t>(s.higherWins)<<24)|
+        (static_cast<uint32_t>(s.lowerWins)<<16)|(static_cast<uint32_t>(day)<<7)|(state<<4)|8);
+}
+}
