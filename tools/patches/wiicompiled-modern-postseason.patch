+    if(!Memory::Contains(header,12) || Memory::Read32(header)!=0x01000100u || Memory::Read32(header+4)!=9) return false;
+    out.texels=Memory::Read32(header+8);
+    out.palette=out.texels+256*256;  // the RGB5A3 palette follows the texels
+    return Memory::Contains(out.texels,256*256+512);
+}
+// WILD CARD from the letters of WORLD (x 14..), DIVISION (x 71..) and ALL-STAR (x 139..), rows 104..129.
+void paint(const Atlas& t) {
+    struct Span { char ch; int x0,x1; };
+    static constexpr Span kSpans[]={{'W',14,25},{'I',81,84},{'L',155,161},{'D',71,81},{' ',0,0},
+                                    {'C',111,122},{'A',184,192},{'R',36,45},{'D',71,81}};
+    std::array<std::array<int16_t,kRows>,128> out{};
+    for(auto& col:out) col.fill(-1);
+    // DIVISION's colours by row, darkest first: each source colour takes the one of similar brightness.
+    std::array<std::vector<uint8_t>,kRows> rowColours;
+    for(int y=0;y<kRows;++y) {
+        for(int x=71;x<131;++x) {
+            const uint8_t i=t.index(x,kSrcY+y);
+            if(t.fill(i) && std::find(rowColours[y].begin(),rowColours[y].end(),i)==rowColours[y].end()) rowColours[y].push_back(i);
+        }
+    }
+    uint8_t white=0;  // the rim's white, from DIVISION's top rim
+    for(int x=71;x<131 && !white;++x) { int r,g,b,a; t.rgba(t.index(x,kSrcY+3),r,g,b,a); if(a==255 && std::min({r,g,b})>235) white=t.index(x,kSrcY+3); }
+    int x=2;
+    std::vector<std::pair<Span,int>> placed;
+    for(const Span& s:kSpans) {
+        if(s.ch==' ') { x+=3; continue; }
+        placed.push_back({s,x});
+        x+=s.x1-s.x0;  // letters touch as in DIVISION
+    }
+    g_width=std::min(x+2,128);
+    for(const auto& [s,dx]:placed)  // rims first, so that no rim covers a neighbour's colour
+        for(int sx=s.x0-2;sx<s.x1+2;++sx) for(int y=0;y<kRows;++y) {
+            const uint8_t i=t.index(sx,kSrcY+y);
+            int r,g,b,a; t.rgba(i,r,g,b,a);
+            const int ox=dx+sx-s.x0;
+            if(a && !t.fill(i) && ox>=0 && ox<128 && out[ox][y]<0) out[ox][y]=i;
+        }
+    for(const auto& [s,dx]:placed) {
+        for(int sx=s.x0;sx<s.x1;++sx) for(int y=0;y<kRows;++y) {
+            const uint8_t i=t.index(sx,kSrcY+y);
+            if(!t.fill(i)) continue;
+            uint8_t best=i; float d=1e9f;
+            for(uint8_t c:rowColours[y]) if(std::abs(t.lum(c)-t.lum(i))<d) { d=std::abs(t.lum(c)-t.lum(i)); best=c; }
+            out[dx+sx-s.x0][y]=best;
+        }
+        if(s.ch=='C') {  // open the O's right side and rim the cut
+            const int mid=kRows/2-1;
+            for(int sx=s.x0+6;sx<s.x1+2;++sx) for(int y=mid-3;y<=mid+3;++y) out[dx+sx-s.x0][y]=-1;
+            for(int sx=s.x0+5;sx<s.x1+2;++sx) for(int y=mid-4;y<=mid+4;++y) {
+                int16_t& v=out[dx+sx-s.x0][y];
+                if(v<0 || !t.fill(static_cast<uint8_t>(v))) continue;
+                bool edge=false;
+                for(int ax=-1;ax<=1;++ax) for(int ay=-1;ay<=1;++ay) {
+                    const int qx=dx+sx-s.x0+ax,qy=y+ay;
+                    if(qx>=0 && qx<128 && qy>=0 && qy<kRows && out[qx][qy]<0) edge=true;
+                }
+                if(edge) v=white;
+            }
+        }
+    }
+    for(int ox=0;ox<g_width;++ox) for(int y=0;y<kRows;++y)
+        Memory::Write8(t.texels+texelAt(kDstX+ox,kDstY+y),static_cast<uint8_t>(out[ox][y]<0?0:out[ox][y]));
+    GxGuestWrite::NotifyWrite(t.texels,256*256);  // the renderer uploads the atlas again
+}
+// The atlas's free part (x 123..255, y 164..193) is index 0; a painted label is not.
+bool painted(const Atlas& t) {
+    return g_painted==t.texels && t.index(kDstX+5,kDstY+12)!=0;
+}
+uint32_t wildCardSurf(uint32_t divisionSurf) {
+    Atlas t;
+    if(!atlasOf(divisionSurf,t)) return 0;
+    if(!painted(t)) { paint(t); g_painted=t.texels; }
+    for(uint32_t i=0;i<0x2C;i+=4) Memory::Write32(kSurf+i,Memory::Read32(divisionSurf+i));
+    Memory::Write32(kSurf+0x18,kRect);
+    // {0, 0, shown width << 16 | height, u0 << 16 | v0, u1 << 16 | v1, -1, 0}: shown 68 x 22 like
+    // DIVISION, so the wider label is squeezed into the cell.
+    const uint32_t rows[7]={0,0,(68u<<16)|22u,(uint32_t(kDstX)<<16)|uint32_t(kDstY+2),
+                            (uint32_t(kDstX+g_width)<<16)|uint32_t(kDstY+24),0xFFFFFFFFu,0};
+    for(uint32_t i=0;i<7;++i) Memory::Write32(kRect+i*4,rows[i]);
+    return kSurf;
+}
+int userTeam(CpuContext* ctx) {
+    const CpuContext saved=*ctx;
+    func_80BA6854(ctx);
+    const int team=static_cast<int>(ctx->gpr[3]);
+    *ctx=saved;
+    return team;
+}
+int rival(int day,int team) {
+    for(int slot=0;slot<16;++slot) {
+        const uint32_t at=gameAddress(day,slot);
+        if(!at || !Memory::Contains(at,16)) continue;
+        const int a=static_cast<int>(Memory::Read32(at)),b=static_cast<int>(Memory::Read32(at+4));
+        if(a==team) return b;
+        if(b==team) return a;
+    }
+    return pending;
+}
+}  // namespace calendar
+
+extern "C" void MLB_CalendarLabel_80B9B5F8(CpuContext* ctx) {
+    // The month's first DIVISION day is event 0, day 278 (October 5): its cell places the others.
+    if(calendar::g_building && ctx->gpr[4]==3 && !calendar::g_oct5) {
+        calendar::g_oct5=ctx->gpr[3];
+        const uint32_t node=Memory::Read32(ctx->gpr[3]+0xF4+12);
+        if(Memory::Contains(node,0xE0) && Memory::Read32(node+0xDC)!=calendar::kSurf) calendar::g_divisionSurf=Memory::Read32(node+0xDC);
+    }
+    func_80B9B5F8(ctx);
+}
+REGISTER_NATIVE_FUNCTION_AS(0x80B9B5F8, MLB_CalendarLabel_80B9B5F8, "MLB_CalendarLabel_80B9B5F8");
+extern "C" void MLB_CalendarMonth_80B9C4C0(CpuContext* ctx) {
+    const uint32_t screen=ctx->gpr[3],month=ctx->gpr[4];
+    const uint32_t grid=Memory::Contains(screen,0x48)?Memory::Read32(screen+0x44)+0xE0:0;
+    // Cells are reused for every month: put DIVISION's picture back before the game fills them.
+    if(grid && calendar::g_divisionSurf && Memory::Contains(grid,37*4))
+        for(uint32_t k=0;k<37;++k) {
+            const uint32_t cell=Memory::Read32(grid+k*4);
+            if(!Memory::Contains(cell,0xF4+40)) continue;
+            const uint32_t node=Memory::Read32(cell+0xF4+12);
+            if(Memory::Contains(node,0xE0) && Memory::Read32(node+0xDC)==calendar::kSurf)
+                Memory::Write32(node+0xDC,calendar::g_divisionSurf);
+        }
+    calendar::g_building=true; calendar::g_oct5=0;
+    func_80B9C4C0(ctx);
+    calendar::g_building=false;
+    if(!enabled() || month!=10 || !calendar::g_oct5 || !calendar::g_divisionSurf || !grid || !Memory::Contains(grid,37*4)) return;
+    int k5=-1;
+    for(int k=0;k<37;++k) if(Memory::Read32(grid+static_cast<uint32_t>(k)*4)==calendar::g_oct5) k5=k;
+    const uint32_t surf=calendar::wildCardSurf(calendar::g_divisionSurf);
+    if(k5<3 || !surf) return;
+    const int team=calendar::userTeam(ctx);
+    for(int day=275;day<=277;++day) {
+        const uint32_t cell=Memory::Read32(grid+static_cast<uint32_t>(k5+day-278)*4);
+        if(!Memory::Contains(cell,0xF4+40)) continue;
+        const uint32_t node=Memory::Read32(cell+0xF4+12);
+        if(!Memory::Contains(node,0xE0)) continue;
+        Memory::Write32(node+0xDC,surf);
+        const int other=calendar::rival(day,team);
+        const CpuContext saved=*ctx;
+        // The day's pass has drawn the rival's logo already (a rival here adds a second, small one);
+        // a day without the user's game gets the EVENTS background, as the other postseason days.
+        ctx->gpr[3]=cell; ctx->gpr[4]=3; ctx->gpr[5]=static_cast<uint32_t>(pending); ctx->gpr[6]=other==pending?1u:0u;
+        func_80B9B5F8(ctx);
+        *ctx=saved;
+    }
+}
+REGISTER_NATIVE_FUNCTION_AS(0x80B9C4C0, MLB_CalendarMonth_80B9C4C0, "MLB_CalendarMonth_80B9C4C0");
diff --git a/runtime/tests/modern_postseason_test.cpp b/runtime/tests/modern_postseason_test.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/tests/modern_postseason_test.cpp
@@ -0,0 +1,141 @@
+#include "modern_postseason.h"
+#include <cassert>
+#include <iostream>
+using namespace modern_postseason;
+template<class F> void rejects(F f) {
+    bool threw=false;
+    try { f(); } catch(const std::exception&) { threw=true; }
+    assert(threw);
+}
+static std::array<Team,30> fixture() {
+    std::array<Team,30> teams{};
+    for(int i=0;i<30;++i) teams[i]={i,i/5,120-i,42+i};
+    return teams;
+}
+static void add(std::vector<GameResult>& games,int winner,int loser,int count=1,int day=0) {
+    for(int n=0;n<count;++n) games.push_back({winner,loser,4,2,day+n});
+}
+int main() {
+    auto teams=fixture();
+    auto state=create(teams,{});
+    assert((state.seeds[0]==std::array<int,6>{0,5,10,1,2,3}));
+    assert((state.seeds[1]==std::array<int,6>{15,20,25,16,17,18}));
+    assert(state.series[8].higher==10 && state.series[8].lower==3);
+    assert(state.series[9].higher==1 && state.series[9].lower==2);
+    assert(state.series[0].higher==pending && state.series[7].target==0);
+    for(int i=8;i<12;++i) for(int g=0;g<3;++g) assert(homeTeam(state.series[i],g)==state.series[i].higher);
+    // Fixed bracket, upset routing, early termination and all home-field patterns.
+    recordWin(state,9,2,{}); recordWin(state,9,2,{});
+    assert(state.series[0].higher==0 && state.series[0].lower==2);
+    rejects([&]{recordWin(state,9,2,{});});
+    assert(state.series[9].lowerWins==2);
+    for(int g=0;g<5;++g) assert(homeTeam(state.series[0],g)==(g==2||g==3?2:0));
+    for(int i:{8,10,11}) {
+        int winner=state.series[i].higher;
+        recordWin(state,i,winner,{}); recordWin(state,i,winner,{});
+    }
+    for(int i=0;i<4;++i) for(int n=0;n<3;++n) recordWin(state,i,state.series[i].lower,{});
+    assert(state.series[4].higher==10 && state.series[4].lower==2);
+    for(int g=0;g<7;++g) assert(homeTeam(state.series[4],g)==(g>=2&&g<=4?2:10));
+    for(int i=4;i<6;++i) for(int n=0;n<4;++n) recordWin(state,i,state.series[i].higher,{});
+    assert(state.series[6].target==4 && state.series[6].higher==10);
+    for(int n=0;n<4;++n) recordWin(state,6,10,{});
+    assert(state.series[6].winner==10 && state.series[7].higher==pending);
+    rejects([&]{recordWin(state,6,10,{});});
+    rejects([&]{recordWin(state,7,10,{});});
+    rejects([&]{homeTeam(state.series[6],7);});
+    rejects([&]{homeTeam(Series{-1,2,0,0,2,pending},0);});
+
+    // Percentage beats raw wins; division winners stay above wild cards.
+    auto pct=teams; pct[1].wins=70; pct[1].losses=20;
+    auto seeded=selectSeeds(pct,{});
+    assert(seeded[0][0]==1 && seeded[0][3]==0);
+    // Original alignment has 14/16 clubs with divisions of four, five and six.
+    auto original=teams;
+    for(int i=0;i<30;++i)
+        original[i].division=i<5?0:i<10?1:i<14?2:i<19?3:i<25?4:5;
+    auto originalSeeds=selectSeeds(original,{});
+    assert((originalSeeds[0]==std::array<int,6>{0,5,10,1,2,3}));
+    assert((originalSeeds[1]==std::array<int,6>{14,19,25,15,16,17}));
+    assert(resolveTie(original,{{14,0,5,1,1}},{0,14})==14);
+    auto emptyDivision=original;
+    for(auto& t:emptyDivision) if(t.division==2) t.division=1;
+    rejects([&]{selectSeeds(emptyDivision,{});});
+    auto shortLeague=original;
+    for(int i=5;i<14;++i) shortLeague[i].division=3;
+    shortLeague[3].division=1; shortLeague[4].division=2;
+    rejects([&]{selectSeeds(shortLeague,{});});
+    auto reordered=teams; std::reverse(reordered.begin(),reordered.end());
+    assert(selectSeeds(reordered,{})==selectSeeds(teams,{}));
+
+    std::vector<GameResult> games;
+    add(games,1,0,2);
+    auto tied=teams; tied[1].wins=tied[0].wins; tied[1].losses=tied[0].losses;
+    assert(selectSeeds(tied,games)[0][0]==1);
+    assert(selectSeeds(tied,games)[0][3]==0);
+    assert(resolveTie(teams,games,{0,1})==1);
+    // Dominant series winner has lower aggregate percentage than its opponent.
+    games.clear(); add(games,0,1,2); add(games,1,0); add(games,0,2); add(games,1,2,20);
+    assert(resolveTie(teams,games,{0,1,2})==0);
+    // Circular head-to-head requires group totals, independent of input order.
+    games.clear(); add(games,0,1,3); add(games,1,2,2); add(games,2,0);
+    assert(resolveTie(teams,games,{2,1,0})==0);
+    assert(resolveTie(teams,games,{1,0,2})==0);
+    // Two tied aggregate leaders revert to their direct matchup.
+    games.clear(); add(games,0,1); add(games,1,2); add(games,2,0); add(games,0,3); add(games,1,3);
+    assert(resolveTie(teams,games,{0,1,2,3})==0);
+    // Four-way dominant winner overrides aggregate games.
+    games.clear(); add(games,0,1,2); add(games,1,0); add(games,0,2); add(games,0,3);
+    add(games,1,2,20); add(games,1,3,20);
+    assert(resolveTie(teams,games,{3,2,1,0})==0);
+    // Identical group results fall through division, then league records.
+    games.clear(); add(games,0,2); add(games,3,5);
+    assert(resolveTie(teams,games,{0,5})==0);
+    games.clear(); add(games,0,10); add(games,10,5);
+    assert(resolveTie(teams,games,{0,5})==0);
+    // All-Star cutoff uses actual dates, independent of input result order.
+    games={{0,2,4,2,20},{2,0,4,2,1},{5,7,4,2,1},{7,5,4,2,20}};
+    assert(resolveTie(teams,games,{0,5},10)==0);
+    rejects([&]{resolveTie(teams,games,{0,5});});
+    // Late records tie; one earlier league game decides.
+    games={{0,2,4,2,20},{2,0,4,2,21},{0,2,4,2,9},{2,0,4,2,1},
+           {5,7,4,2,20},{7,5,4,2,21},{7,5,4,2,9},{5,7,4,2,1}};
+    assert(resolveTie(teams,games,{0,5},10)==0);
+    // Multi-club late extension skips mutual games, retaining actual chronological order.
+    games.clear();
+    for(int id:{0,5,10}) {
+        add(games,id,id+1,1,20); add(games,id+1,id,1,21);
+        if(id==0) { add(games,id,id+1,1,7); add(games,id+1,id,1,1); }
+        else { add(games,id+1,id,1,7); add(games,id,id+1,1,1); }
+    }
+    add(games,0,5,1,9); add(games,5,10,1,9); add(games,10,0,1,9);
+    assert(resolveTie(teams,games,{10,5,0},10)==0);
+    // A missing opponent history cannot silently become a zero winning percentage.
+    rejects([&]{resolveTie(teams,{{0,2,4,2,20}}, {0,5},10);});
+    rejects([&]{resolveTie(teams,{}, {0,5},10);});
+    // Five clubs follow the four-club steps: a club beating each of the others goes first.
+    games.clear(); for(int k=1;k<5;++k) add(games,0,k);
+    assert(resolveTie(teams,games,{0,1,2,3,4},10)==0 && resolveTie(teams,games,{4,3,2,1,0},10)==0);
+    // Every league game compared and still tied: a draw fixed by the season's results.
+    games={{0,2,4,2,20},{5,7,4,2,20}};
+    const int drawn=resolveTie(teams,games,{0,5},10);
+    assert((drawn==0 || drawn==5) && resolveTie(teams,games,{5,0},10)==drawn);
+    rejects([&]{resolveTie(teams,{}, {0,0},10);});
+    rejects([&]{create(teams,{{0,1,2,2,0}});});
+    auto corrupt=state; corrupt.series[8]={-1,3,0,0,2,pending};
+    rejects([&]{recordWin(corrupt,8,-1,{});});
+    auto invalid=teams; invalid[0].id=1;
+    rejects([&]{create(invalid,{});});
+    // A World Series tiebreak failure must leave the accepted-result state untouched.
+    auto ws=create(teams,{});
+    ws.teams[15].wins=ws.teams[0].wins; ws.teams[15].losses=ws.teams[0].losses;
+    ws.series[4]={0,5,4,0,4,0}; ws.series[5]={15,20,3,0,4,pending};
+    rejects([&]{recordWin(ws,5,15,{});});
+    assert(ws.series[5].higherWins==3 && ws.series[5].winner==pending);
+    recordWin(ws,5,15,{{15,0,5,1,0}});
+    assert(ws.series[6].higher==15 && ws.series[6].lower==0);
+    std::cout << "modern postseason tests passed\n";
+}
+
+
+
diff --git a/runtime/tests/modern_postseason_save_test.cpp b/runtime/tests/modern_postseason_save_test.cpp
