+ORIGINAL(80B739AC); ORIGINAL(80B9841C); ORIGINAL(80B9849C); ORIGINAL(80B9853C);
+ORIGINAL(80B8ED34); ORIGINAL(80B8EF78); ORIGINAL(80B8A250); ORIGINAL(80B8A054);
+ORIGINAL(80B89FE0); ORIGINAL(80B8AC38); ORIGINAL(80B8AD28); ORIGINAL(80B899B8); ORIGINAL(80B897F0); ORIGINAL(80B88880);
+ORIGINAL(80B8D69C); ORIGINAL(80B8D6F4); ORIGINAL(80B9C4C0); ORIGINAL(80B9B5F8); ORIGINAL(80BA6854);
+#undef ORIGINAL
+
+namespace modern_postseason {
+namespace {
+SavedState saved;
+// The IOS-reserved top of MEM2, below the two-way dialogue's 0x97FFF000 area.
+constexpr uint32_t arena=0x97FFC000u;
+std::string error;
+uint32_t bracket=0;
+bool qualifying=false;
+int year() {
+    const uint32_t state=Memory::Read32(0x8104B5A8u);
+    return state && Memory::Contains(state,9)?static_cast<int8_t>(Memory::Read8(state+8)):-1;
+}
+int today() {
+    const uint32_t state=Memory::Read32(0x8104B5A8u);
+    return state && Memory::Contains(state,9)?Memory::Read16(state+4):-1;
+}
+uint32_t base() { return Memory::Read32(0x8104B5ACu); }
+SavedYear* current() {
+    const int y=year();
+    return y>=0 && y<20?&saved.years[y]:nullptr;
+}
+uint32_t seriesAddress(int y,int index) {
+    if(y<0 || y>=20 || index<0 || index>=12) return 0;
+    return index>=8?arena+static_cast<uint32_t>(y*80+(index-8)*20):
+        base()+648+static_cast<uint32_t>(y*160+index*20);
+}
+Series series(int index) {
+    const uint32_t at=seriesAddress(year(),index);
+    const auto* bytes=static_cast<const uint8_t*>(Memory::GetPointer(at,20));
+    return bytes?decodeSeries(bytes,index>=8?2:index<4?3:4):Series{};
+}
+void putSeries(int index,const Series& value,int completed=0) {
+    const uint32_t at=seriesAddress(year(),index);
+    std::array<uint8_t,20> bytes{};
+    encodeSeries(value,completed,bytes.data());
+    // Original highlighting stores the position in the eight-team qualifier row.
+    for(int side=0;side<2;++side)
+        for(int p=0;p<8;++p)
+            if(Memory::Read32(base()+static_cast<uint32_t>(year()*32+p*4))==
+               static_cast<uint32_t>(side?value.lower:value.higher)) {
+                save_detail::put32(bytes.data()+side*4,static_cast<uint32_t>(p)); break;
+            }
+    for(uint32_t i=0;i<20;++i) Memory::Write8(at+i,bytes[i]);
+}
+uint32_t gameAddress(int day,int slot) {
+    if(day<60 || day>304 || slot<0 || slot>=16) return 0;
+    return Memory::Read32(0x8104B5A0u)+season_schedule::kTableOffset+
+        static_cast<uint32_t>((day-60)*256+slot*16);
+}
+void clearGame(int day,int slot) {
+    const uint32_t at=gameAddress(day,slot);
+    if(!at || !Memory::Contains(at,16)) return;
+    // As the game empties a slot (0x80BA0DAC -> 0x80B72B8C): teams 44, no status, winner field 2
+    // (none) and bit 15. All-zero flags read as a decided game to parts of the simulation.
+    Memory::Write32(at,44); Memory::Write32(at+4,44);
+    Memory::Write32(at+8,0); Memory::Write32(at+12,(2u<<20)|(1u<<15));
+}
+void schedule(int round) {
+    static constexpr int dates[4][7]={{278,279,281,282,284,0,0},{286,287,289,290,291,293,294},
+        {296,297,299,300,301,303,304},{275,276,277,0,0,0,0}};
+    const int count=round==0?5:round==3?3:7,slots=round==1?2:round==2?1:4;
+    for(int slot=0;slot<slots;++slot) {
+        const int index=round==3?8+slot:roundSeries(round,slot);
+        const Series value=series(index);
+        if(value.higher==pending || value.lower==pending) continue;
+        for(int g=0;g<count;++g) {
+            const uint32_t at=gameAddress(dates[round][g],slot);
+            if(!at || !Memory::Contains(at,16) || ((Memory::Read32(at+12)>>23)&7)==2) continue;
+            if(value.winner!=pending) { clearGame(dates[round][g],slot); continue; }
+            const int home=homeTeam(value,g),away=home==value.higher?value.lower:value.higher;
+            Memory::Write32(at,static_cast<uint32_t>(home));
+            Memory::Write32(at+4,static_cast<uint32_t>(away));
+            Memory::Write32(at+8,season_schedule::TimeWord(18*60));
+            // 0x80B72928 (the original postseason game builder) marks the kind field, bits 17-19, as 1.
+            Memory::Write32(at+12,(season_schedule::FlagsWord(18*60)&~(7u<<17))|(1u<<17));
+        }
+    }
+}
+struct Regular {
+    std::array<Team,30> teams{};
+    std::vector<GameResult> games;
+    int allStar=-1;
+};
+Regular regular(bool requireFinished) {
+    Regular result;
+    const uint32_t words=Memory::Read32(0x8104B5A0u)+128;
+    for(int t=0;t<30;++t) {
+        const uint32_t word=Memory::Read32(words+static_cast<uint32_t>(t*4));
+        result.teams[t]={t,static_cast<int>((word>>24)&15)*3+static_cast<int>(word>>28),0,0};
+    }
+    for(int d=78;d<=274;++d) for(int slot=0;slot<16;++slot) {
+        const uint32_t at=gameAddress(d,slot),a=Memory::Read32(at),b=Memory::Read32(at+4);
+        if(a==44 || b==44) continue;
+        if(a>=30 || b>=30) { result.allStar=d; continue; }
+        GameResult game;
+        const auto status=decodeGame(static_cast<const uint8_t*>(Memory::GetPointer(at,16)),d,game);
+        if(status==GameStatus::Tied) continue;  // MLB standings exclude completed draws.
+        if(status!=GameStatus::Finished) {
+            if(requireFinished) throw std::runtime_error(status==GameStatus::Invalid?
+                "invalid regular-season result":"regular-season results are incomplete");
+            continue;
+        }
+        result.games.push_back(game);
+        const bool win=game.homeRuns>game.awayRuns;
+        ++result.teams[win?a:b].wins; ++result.teams[win?b:a].losses;
+    }
+    return result;
+}
+// Division within its league (0 East, 1 Central, 2 West), from the team's word as regular() reads it.
+int divisionOf(int id) {
+    return id>=0 && id<30?static_cast<int>(Memory::Read32(Memory::Read32(0x8104B5A0u)+128+static_cast<uint32_t>(id*4))>>28):0;
+}
+void fail(const char* message) {
+    if(error==message) return;
+    error=message;
+    std::fprintf(stderr,"[postseason] %s\n",message);
+}
+// Postponed games, as MLB does at the end of a season: the postseason dates never move. Once no
+// regular-season game is scheduled from today on, a game left unplayed on an earlier day is made up on
+// a free day before the Wild Card round (2008's schedule ends 9/28, leaving 9/29-10/1) if its result
+// can change the qualifiers or their seeds (seeds decide byes and home field); if it cannot, it is
+// dropped and the teams finish with fewer than 162 games. Without room before day 275 it is dropped
+// too (qualify() then counts only the games played).
+bool pendingGame(int day,int slot,int& a,int& b) {
+    const uint32_t at=gameAddress(day,slot);
+    if(!at || !Memory::Contains(at,16)) return false;
+    a=static_cast<int>(Memory::Read32(at)); b=static_cast<int>(Memory::Read32(at+4));
+    if(a>=30 || b>=30) return false;
+    GameResult unused;
+    return decodeGame(static_cast<const uint8_t*>(Memory::GetPointer(at,16)),day,unused)==GameStatus::Scheduled;
+}
+bool decides(const Regular& r,int home,int away,int day) {
+    try {
+        Seeds outcome[2];
+        for(int homeWins=0;homeWins<2;++homeWins) {
+            auto teams=r.teams; auto games=r.games;
+            ++teams[homeWins?home:away].wins; ++teams[homeWins?away:home].losses;
+            games.push_back({home,away,homeWins?1:0,homeWins?0:1,day});
+            outcome[homeWins]=selectSeeds(teams,games,r.allStar);
+        }
+        return outcome[0]!=outcome[1];
+    } catch(const std::exception&) { return true; }  // an unresolved tie: let the game decide it
+}
+bool playsOn(int day,int team) {
+    int a,b;
+    for(int slot=0;slot<16;++slot) {
+        const uint32_t at=gameAddress(day,slot);
+        if(!at || !Memory::Contains(at,16)) continue;
+        a=static_cast<int>(Memory::Read32(at)); b=static_cast<int>(Memory::Read32(at+4));
+        if(a==team || b==team) return true;
+    }
+    return false;
+}
+void makeups() {
+    const int now=today();
+    static int checked=-1;
+    if(now<78 || now>274 || now==checked || current()==nullptr || current()->qualified) return;
+    checked=now;
+    int a,b;
+    for(int d=now;d<=274;++d) for(int slot=0;slot<16;++slot) if(pendingGame(d,slot,a,b)) return;  // still scheduled
+    const Regular r=regular(false);
+    static std::vector<uint32_t> dropped;
+    for(int d=78;d<now;++d) for(int slot=0;slot<16;++slot) {
+        if(!pendingGame(d,slot,a,b)) continue;
+        const uint32_t at=gameAddress(d,slot);
+        if(std::find(dropped.begin(),dropped.end(),at)!=dropped.end()) continue;
+        int target=-1,free=-1;
+        if(decides(r,a,b,d))
+            for(int t=now;t<=274 && target<0;++t) {
+                if(playsOn(t,a) || playsOn(t,b)) continue;
+                for(int s=0;s<16 && free<0;++s) {
+                    const uint32_t to=gameAddress(t,s);
+                    if(to && Memory::Contains(to,16) && Memory::Read32(to)==44 && Memory::Read32(to+4)==44) free=s;
+                }
+                if(free>=0) target=t;
+            }
+        if(target<0) {
+            dropped.push_back(at);
+            std::fprintf(stderr,"[postseason] day %d: %d at %d not made up (%s)\n",d,b,a,
+                decides(r,a,b,d)?"no free day before the postseason":"it cannot change the postseason");
+            continue;
+        }
+        const uint32_t to=gameAddress(target,free);
+        for(uint32_t i=0;i<16;i+=4) Memory::Write32(to+i,Memory::Read32(at+i));
+        clearGame(d,slot);
+        std::fprintf(stderr,"[postseason] day %d: %d at %d made up on day %d\n",d,b,a,target);
+    }
+}
+void qualify() {
+    auto* row=current();
+    if(!enabled() || !row || row->qualified || qualifying || today()<274 || !error.empty()) return;
+    qualifying=true;
+    try {
+        // On the last regular day the early queries come before its games finish: wait for them.
+        // From the first postseason day on, a game left unplayed simply does not count, as in MLB
+        // (otherwise the year would have no postseason at all).
+        const Regular r=regular(today()<=274);
+        if(r.games.empty()) throw std::runtime_error("no completed regular-season games");
+        const State state=create(r.teams,r.games,r.allStar);
+        row->seeds=state.seeds; row->firstDay=275; row->qualified=true;
+        // The game reads the row as East, Central and West winners then the wild card (0x80B8D69C).
+        for(int league=0;league<2;++league) for(int s=0;s<4;++s) {
+            const int at=s<3?divisionOf(state.seeds[league][s]):3;
+            Memory::Write32(base()+static_cast<uint32_t>(year()*32+(league*4+at)*4),
+                static_cast<uint32_t>(state.seeds[league][s]));
+        }
+        for(int i=0;i<7;++i) putSeries(i,Series{});
+        for(int i=8;i<12;++i) putSeries(i,state.series[i]);
+        Memory::Write32(base()+640,0);
+        schedule(3);
+        std::fprintf(stderr,"[postseason] year %d: 12 qualifiers; Wild Card days 275-277\n",year());
+    } catch(const std::exception& e) {
+        // The last regular day's early queries occur before every game has finished.
+        if(today()>274) fail(e.what());
+    }
+    qualifying=false;
+}
+int seed(int id) {
+    auto* row=current();
+    if(row) for(const auto& league:row->seeds)
+        for(int s=0;s<6;++s) if(league[s]==id) return s;
+    return 99;
+}
+void setup(int index,int a,int b,int target) {
+    if(a==pending || b==pending || series(index).higher!=pending) return;
+    if(seed(a)>seed(b)) std::swap(a,b);
+    putSeries(index,{a,b,0,0,target,pending});
+}
+void finishWildCards() {
+    for(int i=8;i<12;++i) {
+        Series value=series(i);
+        if(value.winner==pending && (value.higherWins>=2 || value.lowerWins>=2)) {
+            value.winner=value.higherWins>=2?value.higher:value.lower;
+            putSeries(i,value,today());
+            std::fprintf(stderr,"[postseason] Wild Card %d won by team %d\n",i-8,value.winner);
+        }
+    }
+    schedule(3);
+    auto* row=current();
+    if(!row || !row->qualified) return;
+    for(int l=0;l<2;++l) {
+        setup(l*2,row->seeds[l][0],series(9+l*2).winner,3);
+        setup(l*2+1,row->seeds[l][1],series(8+l*2).winner,3);
+    }
+    schedule(0);
+}
+const char* teamName(int id) {
+    if(id==pending) return "--";
+    if(id<0 || id>=30) return "?";
+    const uint32_t word=Memory::Read32(Memory::Read32(0x8104B5A0u)+128+static_cast<uint32_t>(id*4));
+    const int code=static_cast<int>((word>>8)&0xFFFF);
+    if(code>=1 && code<=30)
+        for(const auto& t:season_schedule::kTeamCodes) if(t.number==season_schedule::kCodeTeam[code-1]) return t.code;
+    return "Team";
+}
+}
+bool enabled() {
+    const uint16_t first=Memory::Read16(0x8104B608u);
+    return saved.enabled && (first==7001 || first==9001);
+}
+void restore(const SavedState& state) {
+    saved=state; error.clear(); bracket=0;
+    for(int y=0;y<20;++y) for(int s=0;s<4;++s)
+        for(uint32_t b=0;b<20;++b) Memory::Write8(arena+static_cast<uint32_t>(y*80+s*20)+b,saved.years[y].wildCards[s][b]);
+}
+void beginNewGame() {
+    SavedState state;
+    state.enabled=RuntimeConfigFile::ModernPostseason(false);
+    for(const auto& mod:mods::Discover()) if(mod.enabled && (mod.modernPostseason || mod.originalPostseason)) {
+        state.enabled=mod.modernPostseason; break;
+    }
+    restore(state);
+    std::fprintf(stderr,"[postseason] new game: %s\n",saved.enabled?"12 teams":"original 8 teams");
+}
+SavedState snapshot() {
+    for(int y=0;y<20;++y) if(saved.years[y].qualified)
+        for(int s=0;s<4;++s) for(uint32_t b=0;b<20;++b)
+            saved.years[y].wildCards[s][b]=Memory::Read8(arena+static_cast<uint32_t>(y*80+s*20)+b);
+    return saved;
+}
+void shiftWindow(uint32_t realYear) {
+    auto next=snapshot();
+    if(next.years[0].qualified) next.archive.push_back({realYear,next.years[0]});
+    if(next.archive.size()>28) next.archive.erase(next.archive.begin());
+    std::move(next.years.begin()+1,next.years.end(),next.years.begin());
+    next.years.back()={}; restore(next);
+}
+// The Wild Card round on the game's postseason bracket (MLB DATA > Postseason and the screen between
+// games), drawn from the bracket's own pictures in MEM2: the team tile (64 x 256 C8), the small logos
+// (512 x 128 C8, cells of 36 x 42 by team code), the score digits (512 x 32 C8 with a blue and a red
+// palette) and the bracket lines (512 x 256 C8; the grey fill is the colour the game tints at draw
+// time). Each is found by the XXH64 of its texels, like two_way.cpp's help bar; nothing leaves the
+// running game. The pair of Wild Card series that feeds each Division Series slot goes in the side
+// margin next to that slot (0x80B899B8 below keeps the Wild Card winners on the outer slots).
+namespace {
+struct Atlas {
+    uint64_t hash;
+    int width, height;
+    uint32_t texels = 0;
+};
+Atlas g_tiles{0xEF74AAA7240C1F12ull, 64, 256}, g_logos{0xFAD79D2C4C04C957ull, 512, 128},
+    g_digits{0xB25BAC2CEE66C321ull, 512, 32}, g_lines{0xD6CE3E1468270ED9ull, 512, 256};
+enum Picture { kTiles, kLogos, kBlueDigits, kRedDigits, kWonLines, kLines, kPictures };
+std::array<ImTextureID, kPictures> g_pictures{};
+
+bool Valid(const Atlas& a) {
+    const uint32_t bytes = uint32_t(a.width * a.height);
+    if (!a.texels || !Memory::Contains(a.texels - 0x40, bytes + 0x40 + 0x420) || Memory::Read32(a.texels - 0x38) != a.texels)
+        return false;
+    return XXH64(Memory::GetPointer(a.texels, bytes), bytes, 0) == a.hash;
+}
+
+void Find(Atlas& a) {
+    a.texels = 0;
+    const uint32_t size = uint32_t(a.height) << 16 | uint32_t(a.width);
+    constexpr uint32_t kBlock = 0x1000;
+    for (uint32_t block = 0x90000000u; block < 0x98000000u; block += kBlock) {
+        if (!Memory::Contains(block, kBlock)) continue;
+        const uint8_t* p = static_cast<const uint8_t*>(Memory::GetPointer(block, kBlock));
+        for (uint32_t o = 0; o + 12 <= kBlock; o += 4) {
+            if (save_detail::get32(p + o) != size || save_detail::get32(p + o + 4) != 9 ||
+                save_detail::get32(p + o + 8) != block + o + 0x40) continue;
+            a.texels = block + o + 0x40;
+            if (Valid(a)) return;
+            a.texels = 0;
+        }
+    }
+}
+
+// C8 with an RGB5A3 palette `palette` bytes after the texels; `fill` replaces the lines' grey.
+ImTextureID Decode(const Atlas& a, uint32_t palette, const ImU32* fill = nullptr) {
+    std::vector<uint8_t> rgba(size_t(a.width) * a.height * 4);
+    for (int y = 0; y < a.height; ++y)
+        for (int x = 0; x < a.width; ++x) {
+            const uint8_t index = Memory::Read8(a.texels + season_cap::C8Offset(x, y, a.width));
+            const uint16_t v = Memory::Read16(a.texels + palette + index * 2u);
+            uint8_t* out = &rgba[(size_t(y) * a.width + x) * 4];
+            if (v & 0x8000) {
+                out[0] = ((v >> 10) & 31) * 255 / 31, out[1] = ((v >> 5) & 31) * 255 / 31, out[2] = (v & 31) * 255 / 31;
+                out[3] = 255;
+            } else {
+                out[0] = ((v >> 8) & 15) * 17, out[1] = ((v >> 4) & 15) * 17, out[2] = (v & 15) * 17;
+                out[3] = ((v >> 12) & 7) * 255 / 7;
+            }
+            // The fill is a flat grey (65) that the game tints: yellow on a winner's path, olive otherwise.
+            if (fill && out[3] == 255 && out[0] == out[1] && out[1] == out[2] && out[0] >= 40 && out[0] <= 120) {
+                const float k = out[0] / 65.0f;
+                for (int c = 0; c < 3; ++c) out[c] = uint8_t(std::min(255.0f, ((*fill >> (8 * c)) & 255) * k));
+            }
+        }
+    return aurora_imgui_add_texture(uint32_t(a.width), uint32_t(a.height), rgba.data());
+}
+
+bool Ready() {
+    bool fresh = false;
+    for (Atlas* a : {&g_tiles, &g_logos, &g_digits, &g_lines})
+        if (!Valid(*a)) {
+            Find(*a);
+            if (!a->texels) return false;
+            fresh = true;
+        }
+    if (fresh || !g_pictures[kTiles]) {
+        // Measured on the game's bracket: the winner's line is (231, 197, 0), the others (98, 84, 0).
+        static const ImU32 won = IM_COL32(231, 197, 0, 255), other = IM_COL32(98, 84, 0, 255);
+        const uint32_t bytes = uint32_t(g_digits.width * g_digits.height);
+        g_pictures = {Decode(g_tiles, 64 * 256), Decode(g_logos, 512 * 128), Decode(g_digits, bytes),
+                      Decode(g_digits, bytes + 0x220), Decode(g_lines, 512 * 256, &won), Decode(g_lines, 512 * 256, &other)};
+    }
+    return true;
+}
+
+// Where the Wild Card pairs go, in the coordinates of a screenshot of the game's bracket (its picture
+// spans x0 .. x0 + width, 0 .. height). The American League's left pair is given; the others mirror it
+// about mirrorX (right side) and mirrorY (National League).
+struct Layout {
+    float x0, width, height, mirrorX, mirrorY;
+    float tileW, tileH, stem, bar, digitW, digitH;
+    float ax, bx, tileY, barY, digitY, slotX, slotY;  // tile lefts, rows, the Division Series slot it feeds
+};
+// 16:9: the margins beside the untouched bracket (its slot tiles are 178 x 109), 1920 x 1009 window.
+constexpr Layout kWide{63, 1794, 1009, 960, 538.5f, 125, 76, 34, 26, 50, 32, 70, 215, 368, 303, 324, 340, 197.5f};
+// 4:3: beside the bracket shrunk by kNarrow (its slot tiles become 85 x 78), picture 1225 x 1009.
+constexpr Layout kNarrowLayout{347, 1225, 1009, 969, 548.5f, 80, 70, 20, 16, 32, 28, 378, 478, 392, 345, 356, 655, 291};
+// 4:3: the game's bracket shrunk about its centre (layout 270.5, 254.5) to make room at the sides.
+constexpr float kNarrow = 0.75f;
+
+struct Frame {
+    ImVec4 game;
+    const Layout& l;
+    float alpha;
+    bool flipX, flipY;  // right side, National League
+    ImVec2 at(float x, float y) const {
+        if (flipX) x = 2 * l.mirrorX - x;
+        if (flipY) y = 2 * l.mirrorY - y;
+        return ImVec2(game.x + (x - l.x0) * game.z / l.width, game.y + y * game.w / l.height);
+    }
+    void image(Picture p, float x0, float y0, float x1, float y1, ImVec2 uv0, ImVec2 uv1, float a = 1.0f) const {
+        ImVec2 p0 = at(x0, y0), p1 = at(x1, y1);
+        if (p0.x > p1.x) std::swap(p0.x, p1.x);
+        if (p0.y > p1.y) std::swap(p0.y, p1.y);
+        ImGui::GetForegroundDrawList()->AddImage(g_pictures[p], p0, p1, uv0, uv1,
+                                                 IM_COL32(255, 255, 255, int(255 * a * alpha)));
+    }
+};
+
+bool widescreen() { return RuntimeConfigFile::WidescreenEnabled(true) || MkwForceAspect169Requested(); }
+
+int teamCode(int id) {
+    if (id < 0 || id >= 30) return 0;
+    return int((Memory::Read32(Memory::Read32(0x8104B5A0u) + 128 + uint32_t(id * 4)) >> 8) & 0xFFFF);
+}
+
+// Out of the postseason: lost a series that has a winner.
+bool eliminated(int id) {
+    for (int i : {0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11}) {
+        const Series s = series(i);
+        if (s.winner != pending && (s.higher == id || s.lower == id) && s.winner != id) return true;
+    }
+    return false;
+}
+
+void tile(const Frame& f, int league, int id, float x, float y) {
+    const Layout& l = f.l;
+    const float a = eliminated(id) ? 0.45f : 1.0f;
+    const float row = league == 0 ? 48.0f : 0.0f;  // red tile for the American League, blue for the National
+    f.image(kTiles, x, y, x + l.tileW, y + l.tileH, ImVec2(0, row / 256), ImVec2(1, (row + 48) / 256), a);
+    const int code = teamCode(id);
+    if (code < 1 || code > 30) return;
+    const float u = float((code - 1) % 14 * 36), v = float((code - 1) / 14 * 42);
+    const float w = l.tileW * 0.64f, h = l.tileH * 0.82f, lx = x + (l.tileW - w) / 2, ly = y + (l.tileH - h) / 2;
+    f.image(kLogos, lx, ly, lx + w, ly + h, ImVec2(u / 512, v / 128), ImVec2((u + 36) / 512, (v + 42) / 128), a);
+}
+
+void digit(const Frame& f, int value, bool blue, float x, float y) {
+    static constexpr int kLeft[10] = {1, 35, 59, 89, 117, 146, 175, 204, 233, 262};
+    static constexpr int kRight[10] = {28, 53, 85, 114, 144, 173, 202, 230, 260, 289};
+    value = std::clamp(value, 0, 9);
+    const float w = f.l.digitW * (kRight[value] - kLeft[value]) / 27.0f;
+    f.image(blue ? kBlueDigits : kRedDigits, x - w / 2, y, x + w / 2, y + f.l.digitH, ImVec2(kLeft[value] / 512.0f, 1 / 32.0f),
+            ImVec2(kRight[value] / 512.0f, 28 / 32.0f));
+}
+
+// Straight pieces of the game's bracket lines: horizontal texels x 24..48, y 151..169; vertical x 1..17, y 136..149.
+void hline(const Frame& f, bool won, float x0, float x1, float y) {
+    f.image(won ? kWonLines : kLines, std::min(x0, x1), y - f.l.bar / 2, std::max(x0, x1), y + f.l.bar / 2,
+            ImVec2(24 / 512.0f, 151 / 256.0f), ImVec2(48 / 512.0f, 169 / 256.0f));
+}
+void vline(const Frame& f, bool won, float x, float y0, float y1) {
+    f.image(won ? kWonLines : kLines, x - f.l.stem / 2, std::min(y0, y1), x + f.l.stem / 2, std::max(y0, y1),
+            ImVec2(1 / 512.0f, 136 / 256.0f), ImVec2(17 / 512.0f, 149 / 256.0f));
+}
+
+// One Wild Card series: its two tiles under a bracket whose stem goes up and across into the
+// Division Series slot it feeds.
+void pair(const Frame& f, int league, int index) {
+    const Series s = series(index);
+    if (s.higher == pending || s.lower == pending) return;
+    const Layout& l = f.l;
+    const float ac = l.ax + l.tileW / 2, bc = l.bx + l.tileW / 2, mid = (ac + bc) / 2;
+    // As the game draws its own lines: yellow while the team is still in, olive once it is out.
+    const bool aWon = s.winner == s.higher, bWon = s.winner == s.lower;
+    const bool aIn = !eliminated(s.higher), bIn = !eliminated(s.lower);
+    const bool through = s.winner == pending ? aIn || bIn : !eliminated(s.winner);
+    vline(f, aIn, ac, l.tileY, l.barY);
+    vline(f, bIn, bc, l.tileY, l.barY);
+    hline(f, aIn, ac, mid, l.barY);
+    hline(f, bIn, mid, bc, l.barY);
+    vline(f, through, mid, l.barY, l.slotY - l.bar / 2);
+    hline(f, through, mid - l.stem / 2, l.slotX, l.slotY);
+    tile(f, league, s.higher, l.ax, l.tileY);
+    tile(f, league, s.lower, l.bx, l.tileY);
+    digit(f, s.higherWins, !bWon, ac + l.stem / 2 + l.digitW / 2 + 4, l.digitY);
+    digit(f, s.lowerWins, !aWon, bc - l.stem / 2 - l.digitW / 2 - 4, l.digitY);
+}
