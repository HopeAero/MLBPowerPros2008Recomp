@@ -0,0 +1,138 @@
+#include "modern_postseason_save.h"
+#include <cassert>
+#include <iostream>
+
+using namespace modern_postseason;
+
+static void be32(uint8_t* out,uint32_t value) {
+    for(int i=3;i>=0;--i) { out[i]=uint8_t(value); value>>=8; }
+}
+static uint32_t checksum(const std::array<uint8_t,saveBytes>& bytes) {
+    uint32_t hash=2166136261u;
+    for(size_t i=0;i<bytes.size();++i) hash=(hash^(i>=12&&i<16?0:bytes[i]))*16777619u;
+    return hash;
+}
+static void resign(std::array<uint8_t,saveBytes>& bytes) { be32(bytes.data()+12,checksum(bytes)); }
+static bool sameYear(const SavedYear& left,const SavedYear& right) {
+    return left.qualified==right.qualified && left.firstDay==right.firstDay &&
+           left.seeds==right.seeds && left.wildCards==right.wildCards;
+}
+static bool same(const SavedState& a,const SavedState& b) {
+    if(a.enabled!=b.enabled || a.archive.size()!=b.archive.size()) return false;
+    for(size_t y=0;y<a.years.size();++y) if(!sameYear(a.years[y],b.years[y])) return false;
+    for(size_t i=0;i<a.archive.size();++i)
+        if(a.archive[i].year!=b.archive[i].year || !sameYear(a.archive[i].data,b.archive[i].data)) return false;
+    return true;
+}
+static SavedState fixture() {
+    SavedState state; state.enabled=true;
+    for(size_t y=0;y<state.years.size();++y) {
+        auto& year=state.years[y]; year.qualified=true; year.firstDay=275;
+        for(int l=0;l<2;++l) for(int s=0;s<6;++s) year.seeds[l][s]=l*15+s;
+        for(int s=0;s<4;++s) {
+            auto& series=year.wildCards[s];
+            be32(series.data()+8,uint32_t((s/2)*15+2+s%2));
+            be32(series.data()+12,uint32_t((s/2)*15+5-s%2));
+            series[16]=y%3==0?2:1; series[17]=y%3==1?2:1;
+            series[0]=8; series[4]=8; series[18]=uint8_t(y); series[19]=uint8_t((y%3)<<4)|8;
+        }
+    }
+    return state;
+}
+int main() {
+    SavedState original=fixture(), loaded;
+    std::array<uint8_t,saveBytes> bytes{};
+    writeSave(original,bytes.data());
+    assert(readSave(bytes.data(),bytes.size(),loaded)==SaveStatus::Valid && same(original,loaded));
+    assert(bytes[8]==0 && bytes[9]==0 && bytes[10]==0 && bytes[11]==1);
+    assert(bytes[16]==1 && bytes[17]==1 && bytes[21]==0 && bytes[23]==1 && bytes[24]==19);
+    std::array<uint8_t,saveBytes+2> guarded{}; guarded.front()=0xa5; guarded.back()=0x5a;
+    writeSave(original,guarded.data()+1);
+    assert(guarded.front()==0xa5 && guarded.back()==0x5a);
+    assert(std::equal(bytes.begin(),bytes.end(),guarded.begin()+1));
+    auto reject=[&](const auto& bad,size_t size,SaveStatus expected=SaveStatus::Invalid) {
+        auto out=original;
+        out.archive.push_back({2008,original.years[0]});
+        const auto before=out;
+        assert(readSave(bad.data(),size,out)==expected && same(out,before));
+    };
+    for(size_t size:{size_t(0),size_t(7),size_t(8),size_t(16),saveBytes-1})
+        reject(bytes,size,size<8?SaveStatus::Missing:SaveStatus::Invalid);
+    std::array<uint8_t,8> magicOnly{}; std::copy_n(bytes.begin(),8,magicOnly.begin());
+    reject(magicOnly,magicOnly.size());
+    auto unchanged=original;
+    assert(readSave(nullptr,saveBytes,unchanged)==SaveStatus::Missing && same(unchanged,original));
+    auto bad=bytes; bad[0]^=1; reject(bad,bad.size(),SaveStatus::Missing);
+    bad=bytes; bad[11]=2; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[30]^=1; reject(bad,bad.size());
+    for(size_t offset:{size_t(16),size_t(17)}) {
+        bad=bytes; bad[offset]=2; resign(bad); reject(bad,bad.size());
+    }
+    for(uint32_t day:{59u,60u,274u,276u,330u,331u,0xffffffffu}) {
+        bad=bytes; be32(bad.data()+21,day); resign(bad); reject(bad,bad.size());
+    }
+    for(uint8_t team:{uint8_t(30),uint8_t(44),uint8_t(255),uint8_t(1),uint8_t(15)}) {
+        bad=bytes; bad[25]=team; resign(bad); reject(bad,bad.size());
+    }
+    bad=bytes; be32(bad.data()+37+8,30); resign(bad); reject(bad,bad.size());
+    bad=bytes; be32(bad.data()+37+8,6); resign(bad); reject(bad,bad.size());
+    bad=bytes; be32(bad.data()+37+8,15); resign(bad); reject(bad,bad.size());
+    bad=bytes; be32(bad.data()+37+8,5); resign(bad); reject(bad,bad.size());
+    // Seeded clubs alone are insufficient: each Wild Card slot has a fixed ordered pairing.
+    for(const auto& pair:std::array<std::array<uint32_t,2>,3>{{{0,5},{5,2},{3,4}}}) {
+        bad=bytes; be32(bad.data()+37+8,pair[0]); be32(bad.data()+37+12,pair[1]);
+        resign(bad); reject(bad,bad.size());
+    }
+    // Winner flags and best-of-three win totals must describe the same series state.
+    for(const auto& result:std::array<std::array<uint8_t,3>,9>{{
+            {0,0,0x08},{1,0,0x08},{0,2,0x08},{0,0,0x18},{2,0,0x18},
+            {2,0,0x28},{0,2,0x28},{2,2,0x08},{2,2,0x18}}}) {
+        bad=bytes; bad[37+16]=result[0]; bad[37+17]=result[1]; bad[37+19]=result[2];
+        resign(bad); reject(bad,bad.size());
+    }
+    bad=bytes; bad[37+16]=3; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[37+17]=3; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[37+19]=0x38; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[18]=1; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[17+19*100]=2; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad.back()=1; resign(bad); reject(bad,bad.size());
+    auto disabled=original; disabled.enabled=false;
+    writeSave(disabled,bytes.data());
+    assert(readSave(bytes.data(),bytes.size(),loaded)==SaveStatus::Valid && same(disabled,loaded));
+    SavedState empty;
+    for(const auto& year:empty.years) for(const auto& league:year.seeds) for(int id:league) assert(id==pending);
+    writeSave(empty,bytes.data());
+    assert(readSave(bytes.data(),bytes.size(),loaded)==SaveStatus::Valid && same(empty,loaded));
+    auto unused=empty; unused.years[0].firstDay=275;
+    for(auto& league:unused.years[0].seeds) league.fill(0);
+    for(auto& series:unused.years[0].wildCards) series.fill(255);
+    writeSave(unused,bytes.data());
+    assert(std::all_of(bytes.begin()+17,bytes.begin()+117,[](uint8_t value){return value==0;}));
+    assert(readSave(bytes.data(),bytes.size(),loaded)==SaveStatus::Valid && same(empty,loaded));
+    bad=bytes; bad[25]=1; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[2017]=1; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[2021]=1; resign(bad); reject(bad,bad.size());
+    // Archive rows are qualified, chronological, and bounded to the newest 28 entries.
+    auto archived=original;
+    for(uint32_t y=2008;y<2038;++y) archived.archive.push_back({y,original.years[(y-2008)%20]});
+    writeSave(archived,bytes.data());
+    archived.archive.erase(archived.archive.begin(),archived.archive.begin()+2);
+    assert(readSave(bytes.data(),bytes.size(),loaded)==SaveStatus::Valid && same(archived,loaded));
+    assert(bytes[2020]==28 && loaded.archive.front().year==2010 && loaded.archive.back().year==2037);
+    for(size_t size:{size_t(2017),size_t(2021),size_t(4932),saveBytes-1}) reject(bytes,size);
+    bad=bytes; be32(bad.data()+2017,29); resign(bad); reject(bad,bad.size());
+    for(uint32_t year:{2007u,10000u,0xffffffffu}) {
+        bad=bytes; be32(bad.data()+2021,year); resign(bad); reject(bad,bad.size());
+    }
+    bad=bytes; be32(bad.data()+2021+104,2010); resign(bad); reject(bad,bad.size());
+    bad=bytes; be32(bad.data()+2021+104,2009); resign(bad); reject(bad,bad.size());
+    bad=bytes; std::fill_n(bad.begin()+2025,100,0); resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[2025+8]=30; resign(bad); reject(bad,bad.size());
+    bad=bytes; bad[4933]=1; resign(bad); reject(bad,bad.size());
+    for(uint32_t year:{2008u,9999u}) {
+        auto one=original; one.archive.push_back({year,original.years[0]});
+        writeSave(one,bytes.data());
+        assert(readSave(bytes.data(),bytes.size(),loaded)==SaveStatus::Valid && same(one,loaded));
+    }
+    std::cout<<"modern postseason save tests passed\n";
+}
diff --git a/runtime/tests/postseason_guest_test.cpp b/runtime/tests/postseason_guest_test.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/tests/postseason_guest_test.cpp
@@ -0,0 +1,36 @@
+#include "postseason_guest.h"
+#include <cassert>
+int main() {
+    using namespace modern_postseason;
+    std::array<uint8_t,20> bytes{};
+    Series series{4,9,2,1,2,4};
+    encodeSeries(series,275,bytes.data());
+    assert(save_detail::get32(bytes.data()+8)==4);
+    assert(save_detail::get32(bytes.data()+12)==9);
+    assert(bytes[16]==2 && bytes[17]==1);
+    assert(((save_detail::get32(bytes.data()+16)>>4)&7)==0);
+    assert(((save_detail::get32(bytes.data()+16)>>7)&511)==275);
+    auto read=decodeSeries(bytes.data(),2);
+    assert(read.higher==4 && read.lower==9 && read.winner==4);
+    series.winner=pending; series.higherWins=1;
+    encodeSeries(series,0,bytes.data());
+    assert(decodeSeries(bytes.data(),2).winner==pending);
+    assert(wildCardDay(275) && wildCardDay(277) && !wildCardDay(278));
+    assert(roundSeries(0,3)==3 && roundSeries(1,1)==5 && roundSeries(2,0)==6);
+    assert(roundSeries(0,4)==-1 && roundSeries(2,1)==-1);
+    assert(classifyPostseasonDay(277)==2 && classifyPostseasonDay(278)==2);
+    assert(classifyPostseasonDay(286)==3 && classifyPostseasonDay(296)==4);
+    assert(classifyPostseasonDay(274)==-1 && classifyPostseasonDay(305)==-1);
+    std::array<uint8_t,16> game{};
+    save_detail::put32(game.data(),4); save_detail::put32(game.data()+4,9);
+    game[8]=3; game[9]=2;
+    save_detail::put32(game.data()+12,2u<<23);
+    GameResult result;
+    assert(decodeGame(game.data(),200,result)==GameStatus::Finished && result.home==4);
+    save_detail::put32(game.data()+12,(2u<<23)|(2u<<20)); game[9]=3;
+    assert(decodeGame(game.data(),200,result)==GameStatus::Tied);
+    game[9]=1;
+    assert(decodeGame(game.data(),200,result)==GameStatus::Invalid);
+    save_detail::put32(game.data()+12,1u<<23);
+    assert(decodeGame(game.data(),200,result)==GameStatus::Scheduled);
+}
diff --git a/runtime/tests/season_cap_modern_test.cpp b/runtime/tests/season_cap_modern_test.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/tests/season_cap_modern_test.cpp
@@ -0,0 +1,35 @@
+#include "season_cap.h"
+#include "postseason_guest.h"
+#include <cassert>
+int main() {
+    using namespace season_cap;
+    SeasonTail original;
+    original.startShift=18;
+    std::array<uint8_t,kTailSize> bytes{};
+    WriteTail(original,bytes.data());
+    assert(GetBe32(bytes.data()+8)==3);
+    SeasonTail loaded;
+    assert(ReadTail(bytes.data(),bytes.size(),loaded) && !loaded.postseason.enabled && loaded.startShift==18);
+    original.postseason.enabled=true;
+    auto& row=original.postseason.years[0];
+    row.qualified=true; row.firstDay=275;
+    for(int l=0;l<2;++l) for(int i=0;i<6;++i) row.seeds[l][i]=l*6+i;
+    for(int l=0;l<2;++l) {
+        modern_postseason::encodeSeries({l*6+2,l*6+5,0,0,2,44},0,row.wildCards[l*2].data());
+        modern_postseason::encodeSeries({l*6+3,l*6+4,2,0,2,l*6+3},276,row.wildCards[l*2+1].data());
+    }
+    for(size_t i=0;i<kArchiveCapacity;++i) {
+        ArchivedYear year{}; year.fill(static_cast<uint8_t>(i)); AddArchived(original,year);
+    }
+    assert(original.archive.size()==ArchiveCapacity(original) && original.archive.size()<kArchiveCapacity);
+    WriteTail(original,bytes.data());
+    assert(GetBe32(bytes.data()+8)==4);
+    assert(ReadTail(bytes.data(),bytes.size(),loaded));
+    assert(loaded.postseason.enabled && loaded.postseason.years[0].qualified);
+    assert(loaded.postseason.years[0].wildCards==row.wildCards);
+    assert(loaded.archive==original.archive && loaded.startShift==18);
+    bytes.back()^=1;
+    assert(!ReadTail(bytes.data(),bytes.size(),loaded));
+    static_assert(kLifePostseasonOffset>=kLifeLoadEnd);
+    static_assert(kLifePostseasonOffset+modern_postseason::saveBytes<=kLifeTailOffset);
+}
