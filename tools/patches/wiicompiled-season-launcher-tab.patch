+// "2025, 2026-2028" from sorted years.
+std::string YearRanges(const std::vector<int>& years) {
+    std::string out;
+    for (size_t i = 0; i < years.size();) {
+        size_t j = i;
+        while (j + 1 < years.size() && years[j + 1] == years[j] + 1) ++j;
+        out += (out.empty() ? "" : ", ") + std::to_string(years[i]) + (j > i ? "-" + std::to_string(years[j]) : "");
+        i = j + 1;
+    }
+    return out;
+}
