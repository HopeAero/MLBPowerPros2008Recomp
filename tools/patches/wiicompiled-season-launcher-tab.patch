+SeasonText DescribeSeason(const season_pack::Plan& plan, int maxSeasons) {
+    SeasonText out;
+    auto from = [](const std::string& mod) { return std::string(Tr(" (mod «", " (mod «")) + mod + "»)"; };
+    const int last = plan.startYear + (maxSeasons ? maxSeasons : 20) - 1;
+    std::vector<int> real;
+    for (const auto& [year, mod] : plan.schedules)
+        if (year >= plan.startYear && year <= last) real.push_back(year);
+    std::string& h = out.help;
+    h = Tr("Una temporada nueva del modo Temporada o una carrera nueva de MLB Life empieza así:\n\n",
+           "A new Season mode game or MLB Life career starts like this:\n\n");
+    h += std::string(Tr("Año: ", "Year: ")) + std::to_string(plan.startYear) +
+         (plan.startFrom.empty() ? std::string(Tr(" (el del juego)", " (the game's)")) : from(plan.startFrom)) + ".";
+    if (plan.rosterYear != plan.startYear)
+        h += std::string(Tr(" Edades del roster de ", " Ages of a ")) + std::to_string(plan.rosterYear) + Tr(".", " roster.");
+    h += "\n\n";
+    std::vector<std::string> parts;
+    if (!plan.schedules.count(plan.startYear))
+        parts.push_back(plan.startYear == 2008 && !plan.modernLeagues
+                            ? std::string(Tr("el oficial de 2008", "2008's official one"))
+                            : std::string(Tr("generado por el juego en ", "generated by the game in ")) + std::to_string(plan.startYear));
+    if (!real.empty()) {
+        std::string sources;
+        for (int y : real)
+            if (sources.find(plan.schedules.at(y)) == std::string::npos)
+                sources += (sources.empty() ? "" : ", ") + plan.schedules.at(y);
+        parts.push_back(std::string(Tr("real en ", "real in ")) + YearRanges(real) + from(sources));
+    }
+    const auto generated = season_pack::GeneratedYears(plan, plan.startYear + 1, last);
+    if (!generated.empty())
+        parts.push_back(std::string(Tr("generado en ", "generated in ")) + YearRanges(generated) +
+                        (maxSeasons ? "" : Tr(" y siguientes", " and later")));
+    h += Tr("Calendario: ", "Schedule: ");
+    for (size_t i = 0; i < parts.size(); ++i) h += (i ? "; " : "") + parts[i];
+    h += ".\n\n";
+    h += std::string("DH: ") + (plan.dh ? Tr("en ambas ligas", "in both leagues") : Tr("solo en los estadios de la Liga Americana", "only in American League parks")) +
+         (plan.dh ? (plan.dhFrom.empty() ? std::string(Tr(" (MEJORAS)", " (ENHANCEMENTS)")) : from(plan.dhFrom)) : std::string()) + ".\n\n";
+    h += std::string(Tr("Ligas: ", "Leagues: ")) +
+         (!plan.modernLeagues ? std::string(Tr("las de 2008 (14 y 16)", "2008's (14 and 16)"))
+          : !plan.leaguesHouOnly ? std::string(Tr("divisiones propias", "its own divisions")) + from(plan.leaguesFrom)
+                                 : std::string(Tr("15 y 15, Houston en la AL West", "15 and 15, Houston in the AL West")) +
+                                       (plan.leaguesFrom.empty() ? std::string(Tr(" (MEJORAS)", " (ENHANCEMENTS)")) : from(plan.leaguesFrom))) +
+         ".";
+    if (!plan.conflicts.empty()) {
+        h += Tr("\n\nAvisos (cuando dos mods activos piden cosas distintas, se usa el primero por nombre):",
+                "\n\nWarnings (when two enabled mods ask for different things, the first by name is used):");
+        for (const auto& c : plan.conflicts) {
+            h += "\n- «" + c.loser + "»";
+            if (c.what == "start_year") h += std::string(Tr(" empezaría en ", " would start in ")) + std::to_string(c.year);
+            else if (c.what == "schedule") h += std::string(Tr(" trae el calendario de ", " has the schedule of ")) + std::to_string(c.year);
+            else h += Tr(" trae divisiones", " has divisions");
+            h += std::string(Tr(": se usa lo de «", ": «")) + c.winner + Tr("».", "»'s is used.");
+        }
+        h += Tr(" Desactiva uno en MODS si no es lo que quieres.", " Switch one off in MODS if that is not what you want.");
+    }
+    h += Tr("\n\nLas partidas ya empezadas siguen como estaban.", "\n\nGames already started stay as they were.");
+
+    out.choice = std::to_string(plan.startYear);
+    if (plan.schedules.count(plan.startYear)) out.choice += Tr(" · calendario real", " · real schedule");
+    if (!plan.conflicts.empty()) out.choice += Tr(" · ¡aviso!", " · warning!");
+    out.footer = std::string(Tr("Próxima partida nueva: ", "Next new game: ")) + std::to_string(plan.startYear) +
+                 (plan.schedules.count(plan.startYear) ? Tr(", calendario real", ", real schedule") : "") +
+                 (plan.dh ? Tr(", DH en ambas ligas", ", DH in both leagues") : "") +
+                 (plan.modernLeagues ? Tr(", ligas 15 y 15", ", 15 and 15 leagues") : "") +
+                 (plan.dhFrom.empty() && plan.leaguesFrom.empty() && plan.startFrom.empty()
+                      ? std::string()
+                      : std::string(Tr(". Lo que viene de un mod manda sobre estas opciones", ". What comes from a mod overrides these options"))) +
+                 (plan.conflicts.empty() ? "" : Tr(". Hay avisos", ". There are warnings")) +
+                 Tr(". Detalles en MODS > TEMPORADA.", ". Details in MODS > SEASON.");
+    return out;
+}
