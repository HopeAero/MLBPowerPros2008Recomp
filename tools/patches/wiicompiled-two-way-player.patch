+// The manager talk (FREE > CHAT > FRIENDS > the manager) is MLB Life event script 249 or 250 of bank 1
+// (mylife_event2.pack; 0x809EE598 / 0x809EE5A8 queue them): "What is it? You want to talk to me about
+// something?", then I need some advice / (I want to retire) / Nothing at all. The scripts run on an
+// interpreter (vtable 0x80E732D0; +0x40 code, +0x48 the current word, +0x4C PC in words, +0x50 script id,
+// +0x54 bank) whose opcodes are u32 words with a fixed operand count (table 0x80E8B1B8, 36 bytes each,
+// count at +24): 19 speaker, text: a line; 24 wait for A; 34 ... 35 25: a choice list, each row 36 text
+// followed by its branch; 33 pc: jump; 29 the end. For a two-way player the talk runs a copy with one
+// more row after the advice, "About my two-way role.", which asks for two-way / batter only / pitcher
+// only and answers; the answer is taken when the copy jumps to it (0x80B5C334). Copies and texts live in
+// the top of MEM2 the IOS keeps (unused here), in the game's font codes (ASCII + 0x9B; 0 space, 3 comma,
+// 4 period, 8 question mark, 0x1D hyphen, 0x26 apostrophe, 0xD000 new line, 0xFFFF end).
+constexpr uint32_t kTalkArea = 0x97FFF000u, kTalkTexts = kTalkArea + 0x400;
+constexpr uint32_t kTextBase = 30001;  // private text ids, only for the copies
+enum TalkText : uint32_t { kTxLabel, kTxQuestion, kTxTwoWay, kTxBatter, kTxPitcher, kTxAckTwoWay, kTxAckBatter, kTxAckPitcher, kTexts };
+const char* const kTalkStrings[kTexts] = {
+    "    About my two-way role.",
+    "Your two-way role, eh?|How do you want to play|for us now?",
+    "    Two-way player",
+    "    Batter only",
+    "    Pitcher only",
+    "Alright, two-way it is.|You pitch every fifth game|and hit in the others.",
+    "Ok, just hitting then.|No pitching for now.|Tell me if that changes.",
+    "Ok, just pitching then.|You won't bat for now.|Tell me if that changes.",
+};
+
+struct TalkCopy {
+    uint32_t script = 0;               // 249 or 250, 0 unused
+    uint32_t code = 0;                 // guest address of the copy
+    uint32_t answers[3] = {0, 0, 0};   // word PCs of the two-way / batter / pitcher answers
+};
+std::array<TalkCopy, 2> g_talks{};
+
+uint32_t Operands(uint32_t op) { return op < 45 ? Memory::Read32(0x80E8B1B8u + op * 36 + 24) : ~0u; }
+
+void WriteTalkTexts() {
+    uint32_t at = kTalkTexts;
+    for (uint32_t t = 0; t < kTexts; ++t) {
+        for (const char* c = kTalkStrings[t]; *c; ++c) {
+            const unsigned char ch = static_cast<unsigned char>(*c);
+            const uint16_t code = std::isalnum(ch) ? ch + 0x9B : ch == ' ' ? 0 : ch == ',' ? 3 : ch == '.' ? 4
+                                : ch == '?' ? 8 : ch == '-' ? 0x1D : ch == '\'' ? 0x26 : ch == '|' ? 0xD000 : 0;
+            Memory::Write16(at, code), at += 2;
+        }
+        Memory::Write16(at, 0xFFFF), at += 2;
+    }
+}
+
+uint32_t TalkText(uint32_t id) {  // the guest string of a private text id
+    uint32_t at = kTalkTexts;
+    for (uint32_t t = 0; t < id - kTextBase; ++t) {
+        while (Memory::Read16(at) != 0xFFFF) at += 2;
+        at += 2;
+    }
+    return at;
+}
+
+// The copy of the manager's script at `code` (the original, parsed until its end) into slot `slot`.
+uint32_t MakeTalk(uint32_t code, uint32_t script, size_t slot) {
+    std::vector<uint32_t> w;
+    for (uint32_t pc = 0; pc < 256;) {
+        const uint32_t op = Memory::Read32(code + pc * 4), n = Operands(op);
+        if (n > 4) return 0;
+        for (uint32_t k = 0; k <= n; ++k) w.push_back(Memory::Read32(code + (pc + k) * 4));
+        pc += n + 1;
+        if (op == 29) break;
+    }
+    if (w.empty() || w.back() != 29) return 0;
+    // The new row goes before the second row of the first choice list.
+    std::vector<uint32_t> rows;
+    for (uint32_t pc = 0; pc < w.size(); pc += Operands(w[pc]) + 1)
+        if (w[pc] == 36) rows.push_back(pc);
+    if (rows.size() < 2) return 0;
+    const uint32_t at = rows[1];
+    for (uint32_t pc = 0; pc < w.size(); pc += Operands(w[pc]) + 1)
+        if (w[pc] == 33 && w[pc + 1] >= at) w[pc + 1] += 4;
+    // A row's end is found by scanning its words for the next 36 or 35 (the 36 opcode), so no operand
+    // here may be 35 or 36: the question starts at word 40 or later, after unreachable ends (29).
+    const uint32_t r = std::max<uint32_t>(static_cast<uint32_t>(w.size()) + 4, 40);
+    const uint32_t row[] = {36, kTextBase + kTxLabel, 33, r};
+    w.insert(w.begin() + at, std::begin(row), std::end(row));
+    w.resize(r, 29);
+    // The question: rows whose branches jump to their answers, then the end as "Nothing at all" ends.
+    const uint32_t a1 = r + 25, a2 = a1 + 6, a3 = a2 + 6, end = a3 + 6;
+    const uint32_t question[] = {19, 1, kTextBase + kTxQuestion, 24, 3, 0, 1, 34, 8,
+                                 36, kTextBase + kTxTwoWay, 33, a1, 36, kTextBase + kTxBatter, 33, a2,
+                                 36, kTextBase + kTxPitcher, 33, a3, 35, 25, 33, end,
+                                 19, 1, kTextBase + kTxAckTwoWay, 24, 33, end,
+                                 19, 1, kTextBase + kTxAckBatter, 24, 33, end,
+                                 19, 1, kTextBase + kTxAckPitcher, 24, 33, end,
+                                 10, 41, 13, 29};
+    w.insert(w.end(), std::begin(question), std::end(question));
+    TalkCopy& t = g_talks[slot];
+    t.script = script, t.code = kTalkArea + static_cast<uint32_t>(slot) * 0x200;
+    t.answers[0] = a1, t.answers[1] = a2, t.answers[2] = a3;
+    if (w.size() * 4 > 0x200) return 0;
+    for (uint32_t i = 0; i < w.size(); ++i) Memory::Write32(t.code + i * 4, w[i]);
+    return t.code;
+}
+
+const TalkCopy* TalkOf(uint32_t code) {
+    for (const TalkCopy& t : g_talks)
+        if (t.script && t.code == code) return &t;
+    return nullptr;
+}
