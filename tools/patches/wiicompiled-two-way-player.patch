+
+uint32_t Get(CpuContext* ctx, void (*invoke)(CpuContext*), uint32_t target, uint32_t a = 0, uint32_t b = 0) {
+    ctx->gpr[3] = a, ctx->gpr[4] = b;
+    Call(ctx, target, invoke);
+    return ctx->gpr[3];
+}
+
+void MenuStats(CpuContext* ctx, uint32_t menu, bool batter) {
+    const uint32_t panel = Memory::Read32(menu + kMenuStats);
+    if (!Memory::Contains(panel, 0x200)) return;
+    const uint32_t layout = Memory::Read32(Memory::Read32(panel) + 0x3C), lr = ctx->lr;
+    ctx->gpr[3] = panel, ctx->gpr[4] = batter ? 1 : 0, ctx->ctr = layout, ctx->lr = layout;
+    InvokeIndirectCpu(layout, ctx);
+    ctx->lr = lr;
