+// A game's lineup: whether the MLB Life player is its P (a start, or a change).
+void NoteLifePitcher(uint32_t entries, uint32_t players, uint32_t count, bool start) {
+    if (!LifeMode()) return;
+    const uint16_t id = LifeId();
+    bool found = false, pitching = false;  // a two-way starter has two entries, P and DH
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t e = entries + i * kEntry;
+        if (Memory::Read16(players + Memory::Read8(e + 1) * 0x2Cu) != id) continue;
+        found = true;
