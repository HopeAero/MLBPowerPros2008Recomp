diff --git a/runtime/src/hle/mlb/two_way.cpp b/runtime/src/hle/mlb/two_way.cpp
new file mode 100644
index 0000000..d0d4100
--- /dev/null
+++ b/runtime/src/hle/mlb/two_way.cpp
@@ -0,0 +1,511 @@
+// The two-way player rule ("Ohtani rule", MLB since 2022), behind [season] two_way_player: with the DH,
+// a starting pitcher can also be the DH and keep batting after he leaves the mound.
+//
+// A game's lineup is per team at 0x8103D090 + team * 12: {+0 entries, +4 players, +8 groups}. The
+// entries are 6 bytes each: [1] roster index, [2] position (1 P .. 9 RF, 10 DH), [3] on the MLB
+// roster, [4] in the lineup, [5] batting order (0 for the P). Each roster index appears once. The
+// players are 0x2C bytes per roster index (+0xC the player record; record +0x62 == 1: a pitcher).
+// The groups block (0x17 bytes) holds where each group of entries starts and ends and how many it
+// has; +0x16 is the number of entries in use (40 of 44). 0x808863E0 / 0x808866FC rebuild it from the
+// entries, 0x8088A090 sorts them.
+//
+// Every lineup change goes through 0x80886C08 (team, i, j, sort), which swaps the roster indices of
+// entries i and j. With the rule:
+//   - the DH (a pitcher) swapped with the starting P: he takes the P entry and keeps the DH one; the
+//     pitcher he replaces gets a new entry on the bench, so he can still pitch in relief;
+//   - when one player is both, a swap that would put him on the bench (a new P, or a new DH) drops
+//     that bench entry instead, so he is never listed twice.
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+#include "abi_bridge.h"
+#include "gx_guest_write.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+#include "season_cap.h"
+
+namespace two_way {
+namespace {
+
+constexpr uint32_t kLineups = 0x8103D090u;
+constexpr uint32_t kEntry = 6, kCapacity = 44;
+constexpr uint32_t kPosition = 2, kOnRoster = 3, kInLineup = 4;
+constexpr uint8_t kPitcher = 1, kDh = 10;
+constexpr uint32_t kGroupsCount = 0x16, kBenchPitchersLast = 5, kBenchPitchersCount = 0x10;
+
+void Call(CpuContext* ctx, uint32_t target, void (*invoke)(CpuContext*)) {
+    const uint32_t lr = ctx->lr;
+    ctx->lr = target;
+    invoke(ctx);
+    ctx->lr = lr;
+}
+
+struct Lineup {
+    uint32_t entries, players, groups;
+    uint32_t Entry(uint32_t i) const { return entries + i * kEntry; }
+    uint8_t Count() const { return Memory::Read8(groups + kGroupsCount); }
+    uint8_t Player(uint32_t i) const { return Memory::Read8(Entry(i) + 1); }
+    bool Starter(uint32_t i, uint8_t position) const {
+        return Memory::Read8(Entry(i) + kInLineup) != 0 && Memory::Read8(Entry(i) + kPosition) == position;
+    }
+    bool IsPitcher(uint8_t player) const {
+        const uint32_t record = Memory::Read32(players + player * 0x2Cu + 0xC);
+        return record != 0 && Memory::Read8(record + 0x62) == 1;
+    }
+    int Find(uint8_t position) const {
+        for (uint32_t i = 0; i < Count(); ++i)
+            if (Starter(i, position)) return static_cast<int>(i);
+        return -1;
+    }
+};
+
+// A bench entry for `player`, right after the bench pitchers (the group rebuild needs each group to
+// stay in one run).
+void InsertBenchPitcher(const Lineup& l, uint8_t player) {
+    const uint8_t count = l.Count();
+    if (count >= kCapacity) return;
+    uint32_t at = count;
+    if (Memory::Read8(l.groups + kBenchPitchersCount) != 0) at = Memory::Read8(l.groups + kBenchPitchersLast) + 1u;
+    else
+        for (uint32_t i = 0; i < count; ++i)
+            if (Memory::Read8(l.Entry(i) + kOnRoster) == 0) { at = i; break; }  // before the minor leaguers
+    for (uint32_t i = count; i > at; --i)
+        for (uint32_t b = 0; b < kEntry; ++b) Memory::Write8(l.Entry(i) + b, Memory::Read8(l.Entry(i - 1) + b));
+    const uint8_t entry[kEntry] = {0, player, 0, 1, 0, 0};
+    for (uint32_t b = 0; b < kEntry; ++b) Memory::Write8(l.Entry(at) + b, entry[b]);
+    Memory::Write8(l.groups + kGroupsCount, static_cast<uint8_t>(count + 1));
+}
+
+void Remove(const Lineup& l, uint32_t at) {
+    const uint8_t count = l.Count();
+    for (uint32_t i = at; i + 1 < count; ++i)
+        for (uint32_t b = 0; b < kEntry; ++b) Memory::Write8(l.Entry(i) + b, Memory::Read8(l.Entry(i + 1) + b));
+    // The freed slot as the game leaves its unused ones: an empty roster index (40..43 hold 40..43).
+    const uint32_t last = count - 1u;
+    for (uint32_t b = 0; b < kEntry; ++b) Memory::Write8(l.Entry(last) + b, b == 1 ? static_cast<uint8_t>(last) : 0);
+    Memory::Write8(l.groups + kGroupsCount, static_cast<uint8_t>(last));
+}
+
+// Applies the swap of entries i and j the rule's way; false when the rule has nothing to do with it.
+bool Swap(const Lineup& l, uint32_t i, uint32_t j) {
+    const int p = l.Find(kPitcher), d = l.Find(kDh);
+    if (p < 0 || d < 0 || i == j) return false;
+    const uint32_t up = static_cast<uint32_t>(p), ud = static_cast<uint32_t>(d);
+    const bool both = l.Player(up) == l.Player(ud);
+    if (!both && ((i == up && j == ud) || (i == ud && j == up)) && l.IsPitcher(l.Player(ud))) {
+        const uint8_t starter = l.Player(up);
+        Memory::Write8(l.Entry(up) + 1, l.Player(ud));
+        InsertBenchPitcher(l, starter);
+        return true;
+    }
+    if (both && (i == up || i == ud || j == up || j == ud) && !((i == up && j == ud) || (i == ud && j == up))) {
+        const uint32_t starter = (i == up || i == ud) ? i : j, other = starter == i ? j : i;
+        if (Memory::Read8(l.Entry(other) + kInLineup) != 0) return false;  // two starters: the game's swap
+        Memory::Write8(l.Entry(starter) + 1, l.Player(other));
+        Remove(l, other);
+        return true;
+    }
+    return false;
+}
+
+}  // namespace
+}  // namespace two_way
+
+// 0x80886C08 (team, i, j, sort): swaps two lineup entries, then sorts them (sort != 0) and rebuilds
+// the groups, as the original; with the two-way player rule the swap may keep one player in both
+// the P and the DH entries (see above).
+extern "C" void MLB_LineupSwap_80886C08(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t team = ctx->gpr[3], i = ctx->gpr[4], j = ctx->gpr[5], sort = ctx->gpr[6];
+    const uint32_t table = kLineups + team * 12;
+    const Lineup l{Memory::Read32(table), Memory::Read32(table + 4), Memory::Read32(table + 8)};
+    if (!(RuntimeConfigFile::TwoWayPlayer(false) && Swap(l, i, j))) {
+        const uint8_t a = l.Player(i), b = l.Player(j);
+        Memory::Write8(l.Entry(i) + 1, b);
+        Memory::Write8(l.Entry(j) + 1, a);
+    }
+    if (sort != 0) {
+        ctx->gpr[3] = l.entries, ctx->gpr[4] = l.players, ctx->gpr[5] = l.Count(), ctx->gpr[6] = 1;
+        Call(ctx, 0x8088A090u, InvokeDirectCpu<0x8088A090u>);
+        ctx->gpr[3] = l.groups, ctx->gpr[4] = l.entries, ctx->gpr[5] = l.players, ctx->gpr[6] = l.Count();
+        Call(ctx, 0x808863E0u, InvokeDirectCpu<0x808863E0u>);
+    } else {
+        ctx->gpr[3] = l.groups, ctx->gpr[4] = l.entries, ctx->gpr[5] = l.players, ctx->gpr[6] = l.Count();
+        Call(ctx, 0x808866FCu, InvokeDirectCpu<0x808866FCu>);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(80886C08, MLB_LineupSwap_80886C08, (CpuContext* ctx), (ctx));
+
+// Lineup backups hold 40 entries and the groups (0xF0 + 0x17 bytes): the PITCHER screen's, at
+// [screen + 0x2B30], restored on B (0x8066CC2C saves, 0x8066CE48 restores), and Season mode's
+// temporary one at [[0x8104B7E0] + team * 0x1E24 + 8] (0x80B6BC64 saves, 0x80B6C4E4 restores).
+// With a two-way player 41 entries are in use, so the slots past 40 are kept here, by backup.
+namespace two_way {
+namespace {
+struct Extra {
+    uint32_t backup = 0, team = 0;
+    uint8_t bytes[(kCapacity - 40) * kEntry] = {};
+};
+std::array<Extra, 4> g_extra;  // the latest backups
+size_t g_extraNext = 0;
+
+void KeepExtra(uint32_t team, uint32_t backup) {
+    if (team > 1 || backup == 0) return;
+    Extra* slot = nullptr;
+    for (Extra& e : g_extra)
+        if (e.backup == backup && e.team == team) slot = &e;
+    if (!slot) slot = &g_extra[g_extraNext++ % g_extra.size()];
+    slot->backup = backup, slot->team = team;
+    const uint32_t entries = Memory::Read32(kLineups + team * 12);
+    for (uint32_t b = 0; b < sizeof slot->bytes; ++b) slot->bytes[b] = Memory::Read8(entries + 40 * kEntry + b);
+}
+
+uint32_t GroupsOf(uint32_t team) { return Memory::Read32(0x8104E1D8u) + team * 0x17 + 0x103; }
+}  // namespace
+}  // namespace two_way
+
+// 0x8066CD74 (backup, groups): copies the groups into the backup (+0xF0), and keeps the entries past 40.
+extern "C" void MLB_LineupBackupGroups_8066CD74(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t backup = ctx->gpr[3], groups = ctx->gpr[4];
+    for (uint32_t b = 0; b < 0x17; ++b) Memory::Write8(backup + 0xF0 + b, Memory::Read8(groups + b));
+    for (uint32_t team = 0; team < 2; ++team)
+        if (Memory::Read32(kLineups + team * 12 + 8) == groups) KeepExtra(team, backup);
+}
+PPC_NATIVE_OVERRIDE_VOID(8066CD74, MLB_LineupBackupGroups_8066CD74, (CpuContext* ctx), (ctx));
+
+// 0x805F1040 (team): the team's groups. Season mode's backup (0x80B6BC64, the call returning to
+// 0x80B6BCE4, its backup in r31 + 8) copies them next: the entries past 40 are kept then.
+extern "C" void MLB_LineupGroups_805F1040(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t team = ctx->gpr[3];
+    if (ctx->lr == 0x80B6BCE4u) KeepExtra(team, Memory::Read32(ctx->gpr[31] + 8));
+    ctx->gpr[3] = GroupsOf(team);
+}
+PPC_NATIVE_OVERRIDE_VOID(805F1040, MLB_LineupGroups_805F1040, (CpuContext* ctx), (ctx));
+
+// 0x805F10A4 (team, groups): sets a team's groups; from a backup, it also puts back the entries past 40.
+extern "C" void MLB_LineupSetGroups_805F10A4(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t team = ctx->gpr[3], source = ctx->gpr[4];
+    const uint32_t target = GroupsOf(team);
+    for (uint32_t b = 0; b < 0x17; ++b) Memory::Write8(target + b, Memory::Read8(source + b));
+    for (const Extra& e : g_extra) {
+        if (e.backup == 0 || e.team != team || e.backup + 0xF0 != source) continue;
+        const uint32_t entries = Memory::Read32(kLineups + team * 12);
+        for (uint32_t b = 0; b < sizeof e.bytes; ++b) Memory::Write8(entries + 40 * kEntry + b, e.bytes[b]);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(805F10A4, MLB_LineupSetGroups_805F10A4, (CpuContext* ctx), (ctx));
+
+// 0x80579DF8 (record): the record's +0x62, 1 for pitchers. The PITCHER screen's list (0x8066D754)
+// asks it of every starter but the P, to offer a pitcher who is the DH as the starter; when that
+// player already is the starter (two-way), he is not offered again.
+extern "C" void MLB_IsPitcher_80579DF8(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t record = ctx->gpr[3];
+    uint32_t value = Memory::Read8(record + 0x62);
+    if (ctx->lr == 0x8066D844u && value == 1 && RuntimeConfigFile::TwoWayPlayer(false)) {
+        for (uint32_t team = 0; team < 2; ++team) {
+            const uint32_t table = kLineups + team * 12;
+            const Lineup l{Memory::Read32(table), Memory::Read32(table + 4), Memory::Read32(table + 8)};
+            if (!l.entries) continue;
+            const int p = l.Find(kPitcher), d = l.Find(kDh);
+            if (p < 0 || d < 0) continue;
+            const uint8_t player = l.Player(static_cast<uint32_t>(p));
+            if (player == l.Player(static_cast<uint32_t>(d)) && Memory::Read32(l.players + player * 0x2Cu + 0xC) == record)
+                value = 0;
+        }
+    }
+    ctx->gpr[3] = value;
+}
+PPC_NATIVE_OVERRIDE_VOID(80579DF8, MLB_IsPitcher_80579DF8, (CpuContext* ctx), (ctx));
+
+// MLB Career's new player (with the rule on): choosing Pitcher in "Select Fielding Position" asks
+// again, on the same panel, for a second position, as Pawapuro's two-way players have one; the
+// Pitcher button there reads "None". The panel (vtable 0x80E77830) keeps its button grid at +0xB44,
+// the cursor at +0xB6C (0 Pitcher .. 8 Right Fielder). Its update 0x80A364E4 asks 0x805EF2F8 for A
+// (returning to 0x80A36630) and 0x805EF300 for B (0x80A36688); a cursor move calls +0x64,
+// 0x80A367A0, which sets the new player's main position (0x81048B00, setter 0x8082C8C4). The
+// aptitudes come later from a table by main position (0x80A233E8: the loop setting P..RF through
+// 0x80A5B1F4, returning to 0x80A23830), and the second position gets kSecondAptitude there.
+//
+// The panel's title and buttons are pictures of pack 4003 (0xFA3), all in one 512 x 256 C8 atlas with
+// its palette (256 RGB5A3 right after the texels): the title "Select Fielding Position" (0x400934E4, 384 x 28 at
+// 0, 0) and the nine buttons (0x40093550 + 0x48 each, 138 x 30, three a row from y 28). While the
+// question is up, the atlas itself is repainted from its own letters: the title reads "Select
+// Second Position" and the Pitcher button "None" (letters of "Second Baseman" over the button's own
+// background); the original texels come back when the question ends.
+namespace two_way {
+namespace {
+constexpr uint32_t kNewPlayer = 0x81048B00u, kPanelCursor = 0xB44 + 0x28;
+constexpr uint32_t kSecondAptitude = 5;  // the table: 7 the main position, 6 the closest ones
+constexpr uint32_t kPositionPack = 0xFA3, kTitlePicture = 0x400934E4u, kPitcherButton = 0x40093550u;
+constexpr int kAtlasWidth = 512, kTitleW = 384, kTitleH = 28, kButtonW = 138, kButtonH = 30;
+int g_stage = 0;        // 1 while the panel asks for the second position, 2 once answered
+uint32_t g_second = 0;  // 2..9 (C..RF) for the latest new pitcher, 0 none
+
+void Sound(CpuContext* ctx, uint32_t id) {
+    Call(ctx, 0x80010F8Cu, InvokeDirectCpu<0x80010F8Cu>);
+    ctx->gpr[4] = id;
+    Call(ctx, 0x80020254u, InvokeDirectCpu<0x80020254u>);
+}
+
+uint32_t Resolve(CpuContext* ctx, uint32_t handle) {  // 0x8000BBFC: a pointer into the pack
+    ctx->gpr[3] = kPositionPack;
+    ctx->gpr[4] = handle;
+    Call(ctx, 0x8000BBFCu, InvokeDirectCpu<0x8000BBFCu>);
+    return ctx->gpr[3];
+}
+
+// A picture's corner in the atlas and the atlas texels, after checking the layout above.
+bool Picture(CpuContext* ctx, uint32_t handle, int w, int h, uint32_t& texels, int& u0, int& v0) {
+    const uint32_t surf = Resolve(ctx, handle);
+    if (!Memory::Contains(surf, 0x20) || Memory::Read32(surf) != 0x53555246u) return false;  // "SURF"
+    const uint32_t rect = Resolve(ctx, Memory::Read32(surf + 0x18)), set = Resolve(ctx, Memory::Read32(surf + 0x1C));
+    if (!Memory::Contains(rect, 20) || !Memory::Contains(set, 8)) return false;
+    const uint32_t list = Resolve(ctx, Memory::Read32(set + 4));
+    if (!Memory::Contains(list, 4)) return false;
+    const uint32_t texture = Resolve(ctx, Memory::Read32(list));
+    if (!Memory::Contains(texture, 12) || Memory::Read32(texture) != 0x01000200u || Memory::Read32(texture + 4) != 9)
+        return false;  // 512 x 256 (height first), C8
+    u0 = Memory::Read16(rect + 12), v0 = Memory::Read16(rect + 14);
+    if (Memory::Read16(rect + 16) - u0 != w || Memory::Read16(rect + 18) - v0 != h) return false;
+    texels = Resolve(ctx, Memory::Read32(texture + 8));
+    return Memory::Contains(texels, kAtlasWidth * 256);
+}
+
+uint32_t g_texels = 0;
+std::vector<uint8_t> g_titleBackup, g_buttonBackup;
+int g_titleU = 0, g_titleV = 0, g_buttonU = 0, g_buttonV = 0;
+
+uint8_t Texel(int x, int y) { return Memory::Read8(g_texels + season_cap::C8Offset(x, y, kAtlasWidth)); }
+void SetTexel(int x, int y, uint8_t v) { Memory::Write8(g_texels + season_cap::C8Offset(x, y, kAtlasWidth), v); }
+
+void Restore() {
+    if (!g_texels) return;
+    for (int y = 0; y < kTitleH; ++y)
+        for (int x = 0; x < kTitleW; ++x) SetTexel(g_titleU + x, g_titleV + y, g_titleBackup[y * kTitleW + x]);
+    for (int y = 0; y < kButtonH; ++y)
+        for (int x = 0; x < kButtonW; ++x) SetTexel(g_buttonU + x, g_buttonV + y, g_buttonBackup[y * kButtonW + x]);
+    GxGuestWrite::NotifyWrite(g_texels, kAtlasWidth * 256);
+    g_texels = 0;
+}
+
+// Column runs of the title's own letters (x in the title picture): "Select ", then S E C O N D
+// from "Select Fielding Position", the end of "Fielding" (closing the word) and "Position".
+constexpr std::array<std::pair<int, int>, 9> kTitleRuns{
+    {{59, 136}, {59, 77}, {77, 89}, {111, 123}, {295, 309}, {202, 213}, {182, 193}, {225, 229}, {229, 324}}};
+// Letters of "Second Baseman" (the fourth button, x in the button): N O N E.
+constexpr std::array<std::pair<int, int>, 4> kNoneRuns{{{42, 51}, {32, 42}, {42, 51}, {17, 25}}};
+
+void Paint(CpuContext* ctx) {
+    uint32_t texels = 0, pitcherTexels = 0, sourceTexels = 0;
+    int su = 0, sv = 0;
+    if (!Picture(ctx, kTitlePicture, kTitleW, kTitleH, texels, g_titleU, g_titleV) ||
+        !Picture(ctx, kPitcherButton, kButtonW, kButtonH, pitcherTexels, g_buttonU, g_buttonV) ||
+        !Picture(ctx, kPitcherButton + 3 * 0x48, kButtonW, kButtonH, sourceTexels, su, sv) ||
+        pitcherTexels != texels || sourceTexels != texels || !Memory::Contains(texels, kAtlasWidth * 256 + 512))
+        return;
+    g_texels = texels;
+    g_titleBackup.resize(kTitleW * kTitleH);
+    g_buttonBackup.resize(kButtonW * kButtonH);
+    for (int y = 0; y < kTitleH; ++y)
+        for (int x = 0; x < kTitleW; ++x) g_titleBackup[y * kTitleW + x] = Texel(g_titleU + x, g_titleV + y);
+    for (int y = 0; y < kButtonH; ++y)
+        for (int x = 0; x < kButtonW; ++x) g_buttonBackup[y * kButtonW + x] = Texel(g_buttonU + x, g_buttonV + y);
+
+    // The title: the runs side by side, centred.
+    std::vector<int> columns;
+    for (const auto& [a, b] : kTitleRuns)
+        for (int x = a; x < b; ++x) columns.push_back(x);
+    const int start = (kTitleW - static_cast<int>(columns.size())) / 2;
+    for (int x = 0; x < kTitleW; ++x) {
+        const int from = x - start;
+        const bool inside = from >= 0 && from < static_cast<int>(columns.size());
+        for (int y = 0; y < kTitleH; ++y)
+            SetTexel(g_titleU + x, g_titleV + y,
+                     inside ? g_titleBackup[y * kTitleW + columns[static_cast<size_t>(from)]] : 0);
+    }
+
+    // The button, in the atlas palette's colours (a TLUT of 256 RGB5A3 right after the texels): its
+    // own background with the label wiped (each row blended across it, back to the nearest colour
+    // the button already uses), then N O N E with their rim, each colour moved to the Pitcher
+    // label's colour of the same relative brightness.
+    std::array<std::array<int, 4>, 256> palette{};
+    for (uint32_t i = 0; i < 256; ++i) {
+        const uint16_t v = Memory::Read16(g_texels + kAtlasWidth * 256 + i * 2);
+        palette[i] = v & 0x8000 ? std::array<int, 4>{((v >> 10) & 31) * 255 / 31, ((v >> 5) & 31) * 255 / 31,
+                                                      (v & 31) * 255 / 31, 255}
+                                : std::array<int, 4>{((v >> 8) & 15) * 17, ((v >> 4) & 15) * 17, (v & 15) * 17,
+                                                      ((v >> 12) & 7) * 255 / 7};
+    }
+    const auto lum = [&](uint8_t i) {
+        return 0.299f * palette[i][0] + 0.587f * palette[i][1] + 0.114f * palette[i][2];
+    };
+    const auto button = [&](int x, int y) { return g_buttonBackup[y * kButtonW + x]; };
+    std::vector<uint8_t> used;
+    for (uint8_t v : g_buttonBackup)
+        if (std::find(used.begin(), used.end(), v) == used.end()) used.push_back(v);
+    const auto nearest = [&](const std::array<int, 4>& c) {
+        uint8_t best = used[0];
+        long bestDistance = -1;
+        for (uint8_t i : used) {
+            long d = palette[i][3] == c[3] ? 0 : 1000000;
+            for (int k = 0; k < 3; ++k) d += (palette[i][k] - c[k]) * (palette[i][k] - c[k]);
+            if (bestDistance < 0 || d < bestDistance) best = i, bestDistance = d;
+        }
+        return best;
+    };
+    constexpr int kLabelLeft = 29, kLabelRight = 109;
+    std::vector<uint8_t> wiped(g_buttonBackup);
+    for (int y = 0; y < kButtonH; ++y) {
+        const auto& a = palette[button(kLabelLeft, y)];
+        const auto& b = palette[button(kLabelRight, y)];
+        for (int x = kLabelLeft + 1; x < kLabelRight; ++x) {
+            std::array<int, 4> c{};
+            for (int k = 0; k < 4; ++k) c[k] = a[k] + (b[k] - a[k]) * (x - kLabelLeft) / (kLabelRight - kLabelLeft);
+            wiped[y * kButtonW + x] = nearest(c);
+        }
+    }
+    const auto source = [&](int x, int y) { return Texel(su + x, sv + y); };
+    const auto core = [&](int x, int y) {
+        if (y < 9 || y > 21) return false;
+        bool inside = false;
+        for (const auto& [a, b] : kNoneRuns) inside = inside || (x >= a && x < b);
+        return inside && lum(source(x, y)) < 100;
+    };
+    const auto nearCore = [&](int x, int y, int r) {
+        for (int yy = std::max(0, y - r); yy <= std::min(kButtonH - 1, y + r); ++yy)
+            for (int xx = std::max(0, x - r); xx <= std::min(kButtonW - 1, x + r); ++xx)
+                if (core(xx, yy)) return true;
+        return false;
+    };
+    // The Pitcher label's colours (where it stands out from the wiped background), and the
+    // letters' own range, by brightness.
+    std::vector<uint8_t> labelColours, letterColours;
+    for (int y = 8; y < 24; ++y)
+        for (int x = kLabelLeft + 2; x < kLabelRight - 2; ++x) {
+            const uint8_t v = button(x, y);
+            if (std::abs(lum(v) - lum(wiped[y * kButtonW + x])) > 40 &&
+                std::find(labelColours.begin(), labelColours.end(), v) == labelColours.end())
+                labelColours.push_back(v);
+        }
+    for (int y = 8; y < 24; ++y)
+        for (int x = 0; x < kButtonW; ++x)
+            if (nearCore(x, y, 2)) letterColours.push_back(source(x, y));
+    if (labelColours.empty() || letterColours.empty()) return;
+    float lo = 255, hi = 0, plo = 255, phi = 0;
+    for (uint8_t v : letterColours) lo = std::min(lo, lum(v)), hi = std::max(hi, lum(v));
+    for (uint8_t v : labelColours) plo = std::min(plo, lum(v)), phi = std::max(phi, lum(v));
+    const auto recolour = [&](uint8_t v) {
+        const float target = plo + (lum(v) - lo) / std::max(1.0f, hi - lo) * (phi - plo);
+        uint8_t best = labelColours[0];
+        for (uint8_t c : labelColours)
+            if (std::abs(lum(c) - target) < std::abs(lum(best) - target)) best = c;
+        return best;
+    };
+    columns.clear();
+    for (const auto& [a, b] : kNoneRuns)
+        for (int x = a; x < b; ++x) columns.push_back(x);
+    const int left = kButtonW / 2 - static_cast<int>(columns.size()) / 2;
+    for (size_t i = 0; i < columns.size(); ++i)
+        for (int y = 8; y < 24; ++y) {
+            const int sx = columns[i];
+            const float l = lum(source(sx, y));
+            if (nearCore(sx, y, 1) || (nearCore(sx, y, 2) && (l > 250 || l < 100)))
+                wiped[y * kButtonW + left + static_cast<int>(i)] = recolour(source(sx, y));
+        }
+    for (int y = 0; y < kButtonH; ++y)
+        for (int x = 0; x < kButtonW; ++x) SetTexel(g_buttonU + x, g_buttonV + y, wiped[y * kButtonW + x]);
+    GxGuestWrite::NotifyWrite(g_texels, kAtlasWidth * 256);  // the renderer uploads the atlas again
+}
+}  // namespace
+}  // namespace two_way
+
+// 0x805EF2F8 (pad): A pressed, as the original (0x805EEB70, button 4). On the position panel, A on
+// Pitcher asks for the second position instead of going on; A there keeps the answer and goes on.
+extern "C" void MLB_PressedA_805EF2F8(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t lr = ctx->lr, panel = ctx->gpr[31];
+    ctx->gpr[4] = 4;
+    Call(ctx, 0x805EEB70u, InvokeDirectCpu<0x805EEB70u>);
+    if (lr != 0x80A36630u || ctx->gpr[3] == 0 || !RuntimeConfigFile::TwoWayPlayer(false)) return;
+    const uint32_t cursor = Memory::Read32(panel + kPanelCursor);
+    if (g_stage == 1) {
+        g_second = cursor == 0 ? 0 : cursor + 1;
+        g_stage = 2;  // the game confirms through 0x80A367A0, which keeps Pitcher
+        Restore();
+        return;  // the game goes on to the next step
+    }
+    g_second = 0;
+    if (cursor != 0) return;
+    g_stage = 1;
+    Paint(ctx);
+    Sound(ctx, 0x1001);
+    ctx->gpr[3] = 0;
+}
+PPC_NATIVE_OVERRIDE_VOID(805EF2F8, MLB_PressedA_805EF2F8, (CpuContext* ctx), (ctx));
+
+// 0x805EF300 (pad): B pressed (button 5). While asking for the second position, B goes back to the
+// main one, Pitcher selected.
+extern "C" void MLB_PressedB_805EF300(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t lr = ctx->lr, panel = ctx->gpr[31];
+    ctx->gpr[4] = 5;
+    Call(ctx, 0x805EEB70u, InvokeDirectCpu<0x805EEB70u>);
+    if (lr != 0x80A36688u || g_stage != 1 || ctx->gpr[3] == 0) return;
+    g_stage = 0;
+    Restore();
+    ctx->gpr[3] = panel + 0xB44, ctx->gpr[4] = 0;
+    Call(ctx, 0x805F77E8u, InvokeDirectCpu<0x805F77E8u>);
+    Sound(ctx, 0x1002);
+    ctx->gpr[3] = 0;
+}
+PPC_NATIVE_OVERRIDE_VOID(805EF300, MLB_PressedB_805EF300, (CpuContext* ctx), (ctx));
+
+// 0x80A367A0 (panel): the cursor moved, or A confirmed: marks the panel and sets the main position,
+// as the original; not while asking for the second position, and Pitcher when it was answered.
+extern "C" void MLB_PositionCursor_80A367A0(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t panel = ctx->gpr[3];
+    Memory::Write8(panel + 0x126, 1);
+    if (g_stage == 1) return;
+    ctx->gpr[3] = kNewPlayer;
+    ctx->gpr[4] = g_stage == 2 ? 1 : (Memory::Read32(panel + kPanelCursor) + 1) & 0xFF;
+    g_stage = 0;
+    Call(ctx, 0x8082C8C4u, InvokeDirectCpu<0x8082C8C4u>);
+}
+PPC_NATIVE_OVERRIDE_VOID(80A367A0, MLB_PositionCursor_80A367A0, (CpuContext* ctx), (ctx));
+
+// 0x80A5B1F4 (record, position 1..9, aptitude 0..7): sets a position's aptitude, 3 bits each from
+// bit 0x2FA of the record (P, C, then 1B..RF from bit 0x300), as the original. A new career sets the
+// main position's 7 at 0x80A210D0 (returning to 0x80A210D4), then either keeps the rest (a high
+// school player, 0x80A22554) or fills them from the table (0x80A233E8, returning to 0x80A23830):
+// a new two-way pitcher's second position gets kSecondAptitude in both.
+namespace two_way {
+namespace {
+void SetAptitude(uint32_t record, uint32_t position, uint32_t value) {
+    const uint32_t bit = position == 1 ? 0x2FA : position == 2 ? 0x2FD : 0x300 + 3 * (position - 3);
+    const uint32_t word = record + bit / 32 * 4, shift = 32 - bit % 32 - 3;
+    Memory::Write32(word, (Memory::Read32(word) & ~(7u << shift)) | value << shift);
+}
+}  // namespace
+}  // namespace two_way
+
+extern "C" void MLB_SetAptitude_80A5B1F4(CpuContext* ctx) {
+    using namespace two_way;
+    const uint32_t record = ctx->gpr[3], position = ctx->gpr[4];
+    uint32_t value = std::min<uint32_t>(ctx->gpr[5], 7);
+    if (position == 0 || position > 9) return;
+    const bool newPitcher = g_second != 0 && ((Memory::Read32(record + 0x5C) >> 6) & 0xF) == 1;
+    if (ctx->lr == 0x80A23830u && newPitcher && position == g_second) value = std::max(value, kSecondAptitude);
+    SetAptitude(record, position, value);
+    if (ctx->lr == 0x80A210D4u && newPitcher && position == 1) SetAptitude(record, g_second, kSecondAptitude);
+}
+PPC_NATIVE_OVERRIDE_VOID(80A5B1F4, MLB_SetAptitude_80A5B1F4, (CpuContext* ctx), (ctx));
