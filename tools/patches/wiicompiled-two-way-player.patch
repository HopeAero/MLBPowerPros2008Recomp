+    uint32_t words[7] = {Get(ctx, InvokeDirectCpu<0x80A178D4u>, 0x80A178D4u), Get(ctx, InvokeDirectCpu<0x80A17C34u>, 0x80A17C34u)};
+    const uint16_t id = Get(ctx, InvokeDirectCpu<0x80A16F38u>, 0x80A16F38u) & 0xFFFF;
+    const bool season = Get(ctx, InvokeDirectCpu<0x80B06CD0u>, 0x80B06CD0u, id) != 0;
+    const std::array<uint32_t, 5> pitcher{35, 33, 34, 40, 49}, hitter{15, 6, 7, 11, 0};
+    const auto& stats = batter ? hitter : pitcher;
