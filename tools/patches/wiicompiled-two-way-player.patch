+// 0x80887900 (entries, players, 44, rules): the automatic lineup, as the original: 0x808879D0
+// readies the entries, 0x80887C48 picks the starting pitcher, 0x80887F68 the fielders by position
+// (the DH only when rules[0] says so), 0x808880FC improves them, then the batting order from the
+// table at 0x80D10EA4 through 0x808881CC. Season mode, MLB Life and Exhibition build their lineups
+// with it (0x80973664, 0x80650B10), on 44 working entries, sorted and copied to the game afterwards.
+// With the rule on and the DH in use, before the batting order: a two-way pitcher (main position P
+// with an aptitude of 4 or more in the field: record +0x63.. P, C, 1B .. RF; or with a hitter's
+// batting: contact +0x72 and power +0x73, 1 and 16 for every other pitcher) is the DH on the days
+// he does not start, and the DH as well as the starter on the days he does (the Ohtani rule; the
+// displaced DH takes a free entry on the bench). The MLB Life player starts on his own turn (see
+// LifeStarter).
+namespace two_way {
+namespace {
+constexpr uint32_t kOrder = 5;
+
+bool TwoWay(uint32_t players, uint8_t index) {
+    const uint32_t record = Memory::Read32(players + index * 0x2Cu + 0xC);
+    if (!record || Memory::Read8(record + 0x62) != 1) return false;
+    for (uint32_t p = 1; p < 9; ++p)
+        if (Memory::Read8(record + 0x64 + p - 1) >= 4) return true;
+    // ponytail: rosters' Ohtani (PowerUp+ 2025: P only, contact 9, power 238); hitters start at 3 / 124.
+    return Memory::Read8(record + 0x72) >= 5 && Memory::Read8(record + 0x73) >= 100;
+}
+
+void ApplyTwoWay(uint32_t entries, uint32_t players, uint32_t count) {
+    const auto at = [&](uint32_t i) { return entries + i * kEntry; };
+    int starter = -1, dh = -1, twoWay = -1;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (!Memory::Read8(at(i) + kInLineup)) continue;
+        if (Memory::Read8(at(i) + kPosition) == kPitcher) starter = static_cast<int>(i);
+        if (Memory::Read8(at(i) + kPosition) == kDh) dh = static_cast<int>(i);
+    }
+    if (starter < 0 || dh < 0) return;
+    const uint8_t starterPlayer = Memory::Read8(at(static_cast<uint32_t>(starter)) + 1);
+    if (TwoWay(players, starterPlayer) && !LifePitcherOnly(players, starterPlayer)) {
+        // He starts: he is the DH too; the DH goes to a free entry (an empty player, record +0x51 == 0,
+        // as the group rebuild 0x808863E0 tells them apart), which the caller's sort puts on the bench.
+        int free = -1;
+        for (uint32_t i = 0; i < count && free < 0; ++i) {
+            const uint32_t record = Memory::Read32(players + Memory::Read8(at(i) + 1) * 0x2Cu + 0xC);
+            if (!Memory::Read8(at(i) + kOnRoster) && !Memory::Read8(at(i) + kInLineup) &&
+                (record == 0 || Memory::Read8(record + 0x51) == 0))
+                free = static_cast<int>(i);
+        }
+        if (free < 0) return;
+        const uint32_t d = at(static_cast<uint32_t>(dh)), f = at(static_cast<uint32_t>(free));
+        const uint8_t displaced = Memory::Read8(d + 1);
+        Memory::Write8(f + 1, displaced);  // the free entry's empty player index goes unused
+        Memory::Write8(f + kPosition, 0);
+        Memory::Write8(f + kOnRoster, 1);
+        Memory::Write8(f + kInLineup, 0);
+        Memory::Write8(f + kOrder, 0);
+        Memory::Write8(d + 1, starterPlayer);
+        return;
+    }
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint8_t index = Memory::Read8(at(i) + 1);
+        if (Memory::Read8(at(i) + kOnRoster) && !Memory::Read8(at(i) + kInLineup) && TwoWay(players, index) &&
+            !LifePitcherOnly(players, index)) {
+            twoWay = static_cast<int>(i);
+            break;
+        }
+    }
+    if (twoWay < 0) return;
+    const uint32_t d = at(static_cast<uint32_t>(dh)), t = at(static_cast<uint32_t>(twoWay));
+    Memory::Write8(d + kPosition, 0);
+    Memory::Write8(d + kInLineup, 0);
+    Memory::Write8(t + kPosition, kDh);
+    Memory::Write8(t + kInLineup, 1);
+}
