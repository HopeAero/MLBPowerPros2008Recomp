+            words[2 + i] = Get(ctx, InvokeDirectCpu<0x80A4B590u>, 0x80A4B590u, stats[i],
+                               static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(year))));
+        } else {
+            words[2 + i] = Get(ctx, InvokeDirectCpu<0x80A4B618u>, 0x80A4B618u, stats[i]);
+        }
+    }
+    const uint32_t sp = ctx->gpr[1];
+    ctx->gpr[1] = (sp - 0x40) & ~0xFu;
+    Memory::Write32(ctx->gpr[1], sp);
+    const uint32_t array = ctx->gpr[1] + 0x10;
+    for (uint32_t i = 0; i < 7; ++i) Memory::Write32(array + i * 4, words[i]);
+    Get(ctx, InvokeDirectCpu<0x80A4D850u>, 0x80A4D850u, panel, array);
+    ctx->gpr[1] = sp;
+}
