+        g_logo.pending = g_logo.original;
+        SyncLogo(ctx, s);
+    } else if (!g_logo.pending.empty() && KeyboardText(ctx, s) != before) {
+        g_logo.pending.clear();  // typed or deleted letters: the letter logo
+        SyncLogo(ctx, s);
+    }
