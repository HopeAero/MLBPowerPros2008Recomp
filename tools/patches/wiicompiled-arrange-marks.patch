+using namespace arrange_marks;
+
+namespace {
+// A mark widget (0x805BE408 / 0x805BE664, +0xDC mark) showing a custom mark: the game's set-up for
+// a fallback game mark first (material, colour, size), then the custom texture and palettes.
+bool ApplyCustomMark(CpuContext* ctx, uint32_t widget, uint32_t index) {
+    const std::string* file = markFileFor(index);
+    TextureRef ref;
+    if (!widget || !file || !markTexture(Choice{*file, {}}, ref)) return false;
+    Memory::Write32(widget + 0xDC, index);
+    Memory::Write32(widget + 0xE4, ref.texture);
+    for (uint32_t i = 0; i < 4; ++i) Memory::Write32(widget + 0xE8 + i * 4, ref.palette);
+    const uint32_t material = Memory::Read32(widget + 0xF8);
+    Call(ctx, 0x8000A77C, material, 1, widget + 0xE4);
+    Call(ctx, 0x8000A790, material, 4, widget + 0xE8);
+    return true;
+}
+}  // namespace
+
+// --- Task 8: a team's custom mark and logo wherever the game draws that team ---------------------
+// The game draws a team from its slot or record through a few widgets; each hook below learns the
+// team from the slot or record it is given (choiceFor), never from the screen, so MLB and AAA teams,
+// Season/League copies and Arrange teams without a custom choice keep the game's drawing:
+// - the team flag (class 0x80D3D960: the mark icon is the image node +0x3E0, the initial is the
+//   letter sprite +0x4EC) gets an image SURF of the custom 64 x 64 icon with the game quad's
+//   geometry, and no initial;
+// - the TEAM FLAG field (class 0x805C6898: the initial is the letter sprite +0x300 over the cap
+//   colour) shows the icon in the letter's cell instead of the letter;
+// - the big mark widget of an icon (0x807B34FC / 0x807B336C mode 2, +0x208) gets the custom texture;
+// - the logo (0x807B4740) takes the letters path and its letters widget (+0x7D0) shows the custom
+//   logo with a sprite of its own (as Logo Text's preview, Task 7);
+// - the MARK legend of Team Name/Mark shows the mark's list name in the game's font.
+// All of it happens when the game sets a widget up. In a match that is once per widget; the Exhibition
+// team select sets its VS logos on every frame, and then the logo hook only finds the picture already
+// shown. Nothing is decoded while drawing, and a cached picture is checked on disk at most once a
+// second (LoadPicture).
+namespace {
+const bool g_trace = std::getenv("WIICOMPILED_ARRANGE_TRACE") != nullptr;
+std::map<std::pair<std::string, uint32_t>, int> g_traced;
+// WIICOMPILED_ARRANGE_TRACE=1: the first calls of each draw hook from each call site, then how many
+// calls each site has made (at 64, 128, 256... calls: a site called on every frame shows up).
+void Trace(const char* what, uint32_t lr, uint32_t a, uint32_t b, uint32_t record, bool custom) {
+    if (!g_trace) return;
+    const int n = ++g_traced[{what, lr}];
+    if (n >= 64 && (n & (n - 1)) == 0)
+        std::fprintf(stderr, "[arrange-trace] %s lr=%08x called %d times\n", what, lr, n);
+    if (n > 3) return;
+    const int slot = record >= kRecord ? SlotOf(record - kRecord) : -1;
+    std::fprintf(stderr, "[arrange-trace] %s lr=%08x a=%08x b=%08x rec=%08x slot=%d custom=%d\n", what, lr, a, b,
+                 record, slot, custom ? 1 : 0);
+}
+
+// A pointer to a game object (cached RAM: low addresses also map, to physical memory).
+bool GuestObject(uint32_t address, uint32_t size) { return address >= 0x80000000u && Memory::Contains(address, size); }
+bool ValidRecord(uint32_t record) { return GuestObject(record, 0x37); }
+
+// The record's custom mark: an Arrange slot's (choiceFor) imported PNG, with the record's "own mark"
+// flag (0x02, set by Task 6 when the PNG is chosen), loaded.
+bool TeamMark(uint32_t record, TextureRef& ref) {
+    if (!Enabled() || !ValidRecord(record)) return false;
+    const Choice& choice = choiceFor(record);
+    return !choice.mark.empty() && (Memory::Read8(record + 0x1B) & 0x02) && markTexture(choice, ref);
+}
+bool TeamLogo(uint32_t record, TextureRef& ref) {
+    if (!Enabled() || !ValidRecord(record)) return false;
+    const Choice& choice = choiceFor(record);
+    return !choice.logo.empty() && logoTexture(choice, ref);
+}
+uint32_t BaseOf(const TextureRef& ref) { return ref.texture - kTexDesc; }
+
+// The flag's mark icon (+0x3E0, already set by the game with a fallback game mark): a SURF of its own
+// for each flag, with the game SURF's header and first quad (its place and size in this flag, which
+// the fallback mark decides), whose single quad maps the whole 64 x 64 icon (texels 0-64), texture and
+// palette from its own lists (palette mode 0: the quad's palette index 0). The draw reads the SURF on
+// every frame, so it cannot be shared by flags of different fallback marks: each flag gets a block
+// from the game's MEM2 heap (fn_8005B1B8(size, 1); fn_8005B088 frees from either heap by address),
+// freed after the flag's destructor (0x805BE7FC). The game's next 0x805BEFB8 on the flag points it
+// back at the game's own descriptors.
+constexpr uint32_t kFlagBlock = 0x60;  // SURF 0x24, quad 0x1C, texture list 8 + entry 4, palette list 8 + entry 4
+constexpr uint32_t kFbQuad = 0x24, kFbTexList = 0x40, kFbTexEntry = 0x48, kFbPalList = 0x4C, kFbPalEntry = 0x54;
+static_assert(kFbPalEntry + 4 <= kFlagBlock);
+constexpr uint32_t kFlagVtable = 0x80D3D960;
+std::map<uint32_t, uint32_t> g_flagBlocks;  // flag -> its block
+
+uint32_t FlagBlock(CpuContext* ctx, uint32_t flag) {
+    if (const auto found = g_flagBlocks.find(flag); found != g_flagBlocks.end()) return found->second;
+    // Blocks of flags that are gone without their destructor (not expected) are freed here.
+    for (auto it = g_flagBlocks.begin(); it != g_flagBlocks.end();) {
+        if (GuestObject(it->first, 0x500) && Memory::Read32(it->first) == kFlagVtable) { ++it; continue; }
+        Call(ctx, 0x8005B088, it->second);
+        it = g_flagBlocks.erase(it);
+    }
+    const uint32_t block = Call(ctx, 0x8005B1B8, kFlagBlock, 1);  // MEM2 heap
+    if (block) g_flagBlocks[flag] = block;
+    return block;
+}
+
+// The flag's block, out of the table (0 if it has none); the caller frees it.
+uint32_t TakeFlagBlock(uint32_t flag) {
+    const auto found = g_flagBlocks.find(flag);
+    if (found == g_flagBlocks.end()) return 0;
+    const uint32_t block = found->second;
+    g_flagBlocks.erase(found);
+    return block;
+}
+
+bool IsFlagBlock(uint32_t flag, uint32_t surf) {
+    const auto found = g_flagBlocks.find(flag);
+    return found != g_flagBlocks.end() && found->second == surf;
+}
+
+bool FlagIcon(CpuContext* ctx, uint32_t flag, const TextureRef& ref) {
+    const uint32_t node = flag + 0x3E0, game = Memory::Read32(node + 0xDC);
+    if (!ref.iconTexture || !GuestObject(game, 0x24) || Memory::Read32(flag) != kFlagVtable) return false;
+    const uint32_t quads = Memory::Read32(game + 0x18);
+    if (!Memory::Read16(game + 0x16) || !GuestObject(quads, 0x1C)) return false;
+    // Already ours (no fallback set up since): the geometry stays, the picture and the initial are
+    // set again (another team's mark may have come to this flag).
+    const bool ours = IsFlagBlock(flag, game);
+    const uint32_t block = ours ? game : FlagBlock(ctx, flag);
+    if (!GuestObject(block, kFlagBlock)) return false;
+    if (!ours) {
+        uint8_t head[0x24], quad[0x1C];
+        std::memcpy(head, Memory::GetPointer(game, sizeof head), sizeof head);
+        std::memcpy(quad, Memory::GetPointer(quads, sizeof quad), sizeof quad);
+        std::memcpy(Memory::GetPointer(block, sizeof head), head, sizeof head);
+        std::memcpy(Memory::GetPointer(block + kFbQuad, sizeof quad), quad, sizeof quad);
+        Memory::Write16(block + 0x14, uint16_t(Memory::Read16(block + 0x14) & ~1u));
+        Memory::Write16(block + 0x16, 1);
+        Memory::Write32(block + 0x18, block + kFbQuad);
+        Memory::Write32(block + 0x1C, block + kFbTexList);
+        Memory::Write32(block + 0x20, block + kFbPalList);
+        const uint16_t uv[4] = {0, 0, 64, 64};
+        for (uint32_t i = 0; i < 4; ++i) Memory::Write16(block + kFbQuad + 0xC + i * 2, uv[i]);
+        Memory::Write8(block + kFbQuad + 0x18, 0);
+        Memory::Write8(block + kFbQuad + 0x19, 0);
+    }
+    Memory::Write32(block + kFbTexList, 1);
+    Memory::Write32(block + kFbTexList + 4, block + kFbTexEntry);
+    Memory::Write32(block + kFbTexEntry, ref.iconTexture);
+    Memory::Write32(block + kFbPalList, 1);
+    Memory::Write32(block + kFbPalList + 4, block + kFbPalEntry);
+    Memory::Write32(block + kFbPalEntry, ref.iconPalette);
+    Memory::Write32(node + 0xDC, block);
+    Memory::Write32(node + 0xE0, block + kFbTexList);
+    Memory::Write32(node + 0xE4, block + kFbPalList);
+    SetVisible(ctx, Memory::Read32(flag + 0x4EC), false);  // no initial
+    return true;
+}
+
+// TEAM FLAG field (0x805C6898): the letter sprite +0x300 (class 0x805B76E4, SPRD at +0x110: pivot
+// +0x120, cell size +0x128) shows the 64 x 64 icon centred on the letter's cell. The SPRD is the
+// image's own and the same for every sprite (pivot at the icon's centre); each sprite is moved to its
+// cell's centre and scaled to the cell (iconInCell) with its own translation and scale, which go back
+// before the game sets a letter again (0x805C6A98).
+struct FieldPose {
+    float x = 0, y = 0, sx = 1, sy = 1;  // the game's
+    float setX = 0, setY = 0, setSx = 1, setSy = 1;  // ours
+    uint64_t order = 0;  // when it was set (the oldest go first when the table is full)
+};
+std::map<uint32_t, FieldPose> g_fieldPoses;  // letter sprite -> its pose before / with the icon
+constexpr size_t kMaxFieldPoses = 256;
+uint64_t g_poseClock = 0;
+
+// Position and scale are checked apart: the game may set one again and leave ours in the other.
+bool OurPosition(uint32_t letter, const FieldPose& pose) {
+    return GuestObject(letter, 0x140) && F(letter + 0x40) == pose.setX && F(letter + 0x44) == pose.setY;
+}
+bool OurScale(uint32_t letter, const FieldPose& pose) {
+    return GuestObject(letter, 0x140) && F(letter + 0x60) == pose.setSx && F(letter + 0x64) == pose.setSy;
+}
+
+void FieldRestore(CpuContext* ctx, uint32_t letter) {
+    const auto found = g_fieldPoses.find(letter);
+    if (found == g_fieldPoses.end()) return;
+    const FieldPose pose = found->second;
+    g_fieldPoses.erase(found);
+    // Only what is still as we left it (not a sprite destroyed and allocated again, nor a value the
+    // game has set since).
+    if (OurPosition(letter, pose)) CallF(ctx, 0x8001A7B0, letter, pose.x, pose.y);
+    if (OurScale(letter, pose)) CallF(ctx, 0x8001ABA0, letter, pose.sx, pose.sy);
+}
+
+// Sprites the game reset or freed since are forgotten; over the cap, the oldest go.
+void PruneFieldPoses() {
+    for (auto it = g_fieldPoses.begin(); it != g_fieldPoses.end();)
+        it = OurPosition(it->first, it->second) || OurScale(it->first, it->second) ? std::next(it)
+                                                                                   : g_fieldPoses.erase(it);
+    while (g_fieldPoses.size() >= kMaxFieldPoses) {
+        auto oldest = g_fieldPoses.begin();
+        for (auto it = g_fieldPoses.begin(); it != g_fieldPoses.end(); ++it)
+            if (it->second.order < oldest->second.order) oldest = it;
+        g_fieldPoses.erase(oldest);
+    }
+}
+
+bool FieldIcon(CpuContext* ctx, uint32_t field, const TextureRef& ref) {
+    const uint32_t letter = Memory::Read32(field + 0x300);
+    if (!ref.iconTexture || !GuestObject(letter, 0x140)) return false;
+    FieldRestore(ctx, letter);
+    const float w = float(int16_t(Memory::Read16(letter + 0x128))), h = float(int16_t(Memory::Read16(letter + 0x12A)));
+    const float px = float(int16_t(Memory::Read16(letter + 0x120))), py = float(int16_t(Memory::Read16(letter + 0x122)));
+    // The square icon as tall as the letter's cell (a letter is taller than wide, the field box wider).
+    const IconInCell cell = iconInCell(w, h, px, py);
+    if (cell.scale <= 0) return false;
+    const uint32_t desc = BaseOf(ref) + kFieldSprd;
+    Memory::Write32(desc + 0x00, 0x53505244);  // "SPRD"
+    Memory::Write32(desc + 0x04, 0x1C);
+    Memory::Write32(desc + 0x08, ref.iconTexture);
+    Memory::Write32(desc + 0x0C, ref.iconPalette);
+    const int16_t rect[6] = {32, 32, 0, 0, 64, 64};
+    for (uint32_t i = 0; i < 6; ++i) Memory::Write16(desc + 0x10 + i * 2, uint16_t(rect[i]));
+    Call(ctx, 0x8001D25C, letter, desc);
+    PruneFieldPoses();
+    FieldPose pose{F(letter + 0x40), F(letter + 0x44), F(letter + 0x60), F(letter + 0x64)};
+    CallF(ctx, 0x8001A7B0, letter, pose.x + cell.dx * pose.sx, pose.y + cell.dy * pose.sy);
+    CallF(ctx, 0x8001ABA0, letter, pose.sx * cell.scale, pose.sy * cell.scale);
+    pose.setX = F(letter + 0x40);
+    pose.setY = F(letter + 0x44);
+    pose.setSx = F(letter + 0x60);
+    pose.setSy = F(letter + 0x64);
+    pose.order = ++g_poseClock;
+    g_fieldPoses[letter] = pose;
+    SetVisible(ctx, letter, true);
+    return true;
+}
+
+// The logo: the letters widget (class 0x805BA65C) of a team logo widget gets a child sprite with the
+// custom logo, centred on its letters (their container +0x210 is hidden meanwhile), as Logo Text's
+// preview (Task 7: 0.6 scale; centre 79.6, 42.5 from the container, which mode 1 puts at -79, -43).
+// The sprite goes with the letters widget (its destructor, 0x805B9F14).
+constexpr float kLogoCentreX = 79.6f, kLogoCentreY = 42.5f, kLogoScale = 0.6f;
+std::map<uint32_t, uint32_t> g_logoSprites;  // letters widget -> our sprite
+
+uint32_t LogoSprite(uint32_t letters) {
+    const auto found = g_logoSprites.find(letters);
+    if (found == g_logoSprites.end()) return 0;
+    const uint32_t sprite = found->second;
+    if (GuestObject(sprite, 0x110) && Memory::Read32(sprite) == 0x80146A48 && Memory::Read32(sprite + 0x14) == letters)
+        return sprite;
+    g_logoSprites.erase(found);  // gone with a widget we did not see go
+    return 0;
+}
+
+bool ShowLogo(CpuContext* ctx, uint32_t letters, const TextureRef& ref) {
+    if (!GuestObject(letters, 0x300)) return false;
+    uint32_t sprite = LogoSprite(letters);
+    if (!sprite) {
+        sprite = Call(ctx, 0x8005B060, 0x110);
+        if (!sprite) return false;
+        Call(ctx, 0x8001D098, sprite);
+        Call(ctx, 0x8057A180, sprite, letters);
+        Call(ctx, 0x8001AC60, sprite, 0);
+        g_logoSprites[letters] = sprite;
+    }
+    const uint32_t desc = BaseOf(ref) + kLogoSprd, box = letters + 0x210;
+    // Already shown (some screens, the Exhibition team select, set their logos on every frame).
+    const auto visible = [](uint32_t node) { return (Memory::Read8(node + 0x24) & 0x40) != 0; };
+    const bool shown = Memory::Read32(sprite + 0xE8) == desc && Memory::Read32(desc + 0x08) == ref.texture &&
+                       visible(sprite) && !visible(box);
+    if (g_trace) {  // WIICOMPILED_ARRANGE_TRACE: how often the fast path is taken
+        static uint64_t hits = 0, misses = 0;
+        ++(shown ? hits : misses);
+        if ((hits + misses) % 256 == 0)
+            std::fprintf(stderr, "[arrange-trace] logo fast path: %llu hits, %llu misses\n",
+                         (unsigned long long)hits, (unsigned long long)misses);
+    }
+    if (shown) return true;
+    Memory::Write32(desc + 0x00, 0x53505244);  // "SPRD"
+    Memory::Write32(desc + 0x04, 0x1C);
+    Memory::Write32(desc + 0x08, ref.texture);
+    Memory::Write32(desc + 0x0C, ref.palette);
+    const uint16_t rect[6] = {uint16_t(kLogoWidth / 2), uint16_t(kLogoHeight / 2), 0, 0, uint16_t(kLogoWidth),
+                              uint16_t(kLogoHeight)};
+    for (uint32_t i = 0; i < 6; ++i) Memory::Write16(desc + 0x10 + i * 2, rect[i]);
+    Call(ctx, 0x8001D25C, sprite, desc);
+    CallF(ctx, 0x8001A7B0, sprite, F(box + 0x40) + kLogoCentreX, F(box + 0x44) + kLogoCentreY);
+    CallF(ctx, 0x8001ABA0, sprite, kLogoScale, kLogoScale);
+    SetVisible(ctx, sprite, true);
+    SetVisible(ctx, box, false);
+    return true;
+}
+
+void HideLogo(CpuContext* ctx, uint32_t letters) {
+    const uint32_t sprite = letters ? LogoSprite(letters) : 0;
+    if (!sprite) return;
+    SetVisible(ctx, sprite, false);
+    SetVisible(ctx, letters + 0x210, true);
+}
+
+// The MARK legend (class 0x8059A9D0: the list-name picture of a game mark, 0x8059AB98): with a custom
+// mark, no picture and the mark's list name (as in the Team Mark list) in the game's font, centred
+// where the picture was. Its nodes go with the label (destructor 0x8059AA90).
+struct Legend {
+    uint32_t holder = 0, text = 0;
+};
+std::map<uint32_t, Legend> g_legends;  // label -> our name
+
+Legend* LegendOf(uint32_t label) {
+    const auto found = g_legends.find(label);
+    if (found == g_legends.end()) return nullptr;
+    if (GuestObject(found->second.holder, 0x100) && Memory::Read32(found->second.holder + 0x14) == label)
+        return &found->second;
+    g_legends.erase(found);
+    return nullptr;
+}
+
+// The name a mark file has in the Team Mark list (shownLabels over the folder), else its own label.
+// Kept from the last list built (BuildCustomCells); a file it did not have scans the folder once.
+std::string MarkLabel(const std::string& file) {
+    if (const auto found = g_markLabels.find(file); found != g_markLabels.end()) return found->second;
+    if (!g_markLabelsScanned) {
+        g_markLabelsScanned = true;
+        const std::vector<Entry> entries = Catalog(Kind::Mark);
+        RememberMarkLabels(entries, shownLabels(entries));
+        if (const auto found = g_markLabels.find(file); found != g_markLabels.end()) return found->second;
+    }
+    std::string stem = file;
+    if (stem.size() > 4 && (stem.compare(stem.size() - 4, 4, ".png") == 0 || stem.compare(stem.size() - 4, 4, ".PNG") == 0))
+        stem.resize(stem.size() - 4);
+    std::string shown = label(stem);
+    if (shown.empty()) shown = "IMG";
+    return g_markLabels[file] = shownLabels({Entry{file, shown}})[0];
+}
+}  // namespace
