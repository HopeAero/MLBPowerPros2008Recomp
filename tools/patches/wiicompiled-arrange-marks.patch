@@ -0,0 +1,393 @@
+#include "arrange_marks_save.h"
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <vector>
+
+using namespace arrange_marks;
+// The game's data end in pm3usma.dat (save descriptor 0xD0000 + 0x50 header): past the load end.
+constexpr uint32_t kDataEnd = 0xD0050;
+
+static std::vector<uint8_t> slurp(const std::filesystem::path& p) {
+    std::ifstream in(p, std::ios::binary);
+    return {std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
+}
+static void spit(const std::filesystem::path& p, const std::vector<uint8_t>& data) {
+    std::ofstream o(p, std::ios::binary);
+    o.write(reinterpret_cast<const char*>(data.data()), std::streamsize(data.size()));
+}
+
+// A team record as guest memory holds it (big endian): name in font codes (ASCII + 0x9B), 0xFFFF end.
+static std::array<uint8_t, 0x37> record(const char* name, uint8_t initial, uint8_t base) {
+    std::array<uint8_t, 0x37> r{};
+    size_t i = 0;
+    for (; name[i] && i < 10; ++i) {
+        const uint16_t code = uint16_t(uint8_t(name[i]) + 0x9B);
+        r[2 * i] = uint8_t(code >> 8);
+        r[2 * i + 1] = uint8_t(code);
+    }
+    for (; i < 10; ++i) r[2 * i] = r[2 * i + 1] = 0xFF;
+    r[0x15] = initial;
+    r[0x1A] = base;
+    r[0x17] = 2;     // LION
+    r[0x1B] = 0x43;  // name, mark, initial
+    for (size_t k = 0; k < 6; ++k) r[0x30 + k] = uint8_t(k + 1);
+    r[0x36] = 0xFF;
+    return r;
+}
+
+// A version 1 block (no fingerprints, 2064 bytes, its own valid checksum), as the unpublished first
+// format wrote it: "leones.png" as slot 2's mark.
+static std::vector<uint8_t> versionOneBlock() {
+    std::vector<uint8_t> v1(2064, 0);
+    const char magic[] = "MLBARRMK";
+    std::copy(magic, magic + 8, v1.begin());
+    v1[11] = 1;
+    const char mark[] = "leones.png";
+    std::copy(mark, mark + 10, v1.begin() + 16 + 2 * 64);
+    uint32_t h = 2166136261u;
+    for (size_t i = 16; i < v1.size(); ++i) h = (h ^ v1[i]) * 16777619u;
+    for (int i = 0; i < 4; ++i) v1[12 + i] = uint8_t(h >> (24 - 8 * i));
+    return v1;
+}
+
+int main() {
+    // round trip, Lions in slot 2, with the team's fingerprint
+    Choices c;
+    c[2] = {"leones.png", "leones_logo.png"};
+    Fingerprints prints{};
+    prints[2] = 0x12345678;
+    prints[5] = 0x9ABCDEF0;  // slot 5 has no choice: its row stores 0
+    auto bytes = writeChoices(c, prints);
+    assert(bytes.size() == 2192 && kSaveFileOffset + bytes.size() == 0xD3890);
+    assert(bytes[8] == 0 && bytes[11] == 2);
+    // isChosen: by kind, any slot, never for an empty name
+    assert(isChosen(c, false, "leones.png") && isChosen(c, true, "leones_logo.png"));
+    assert(!isChosen(c, true, "leones.png") && !isChosen(c, false, "leones_logo.png"));
+    assert(!isChosen(c, false, "") && !isChosen(c, true, "") && !isChosen(Choices{}, false, "x.png"));
+    Choices back;
+    Fingerprints backPrints{};
+    assert(readChoices(bytes.data(), bytes.size(), back, backPrints) == ReadStatus::Valid);
+    assert(back[2].mark == "leones.png" && back[2].logo == "leones_logo.png");
+    assert(back[0].mark.empty() && back[3].logo.empty());
+    assert(backPrints[2] == 0x12345678 && backPrints[5] == 0 && backPrints[0] == 0);
+
+    // all zeros
+    std::array<uint8_t, kSaveBytes> zeros{};
+    assert(readChoices(zeros.data(), zeros.size(), back, backPrints) == ReadStatus::Missing);
+    assert(back[2].mark.empty() && backPrints[2] == 0);
+
+    // altered checksum, payload, fingerprint, version, short block
+    auto bad = bytes; bad[12] ^= 1;
+    assert(readChoices(bad.data(), bad.size(), back, backPrints) == ReadStatus::Invalid);
+    bad = bytes; bad[100] ^= 1;
+    assert(readChoices(bad.data(), bad.size(), back, backPrints) == ReadStatus::Invalid);
+    bad = bytes; bad[16 + 2 * kRowBytes + 64] ^= 1;  // slot 2's fingerprint
+    assert(readChoices(bad.data(), bad.size(), back, backPrints) == ReadStatus::Invalid);
+    bad = bytes; bad[11] = 3;
+    assert(readChoices(bad.data(), bad.size(), back, backPrints) == ReadStatus::Invalid);
+    assert(back[2].mark.empty() && backPrints[2] == 0);  // nothing out of an Invalid block
+    assert(readChoices(bytes.data(), 100, back, backPrints) == ReadStatus::Invalid);
+
+    // version 1 (2064 bytes, no fingerprints, its own valid checksum) is not read: Invalid
+    {
+        auto v1 = versionOneBlock();
+        assert(readChoices(v1.data(), v1.size(), back, backPrints) == ReadStatus::Invalid);
+        v1.resize(kSaveBytes, 0);  // as it sits in the file: followed by zeros
+        assert(readChoices(v1.data(), v1.size(), back, backPrints) == ReadStatus::Invalid);
+        assert(back[2].mark.empty());
+    }
+
+    // 31-byte name kept; 40-byte rejected
+    Choices n;
+    n[0].mark = std::string(31, 'a');
+    n[0].logo = std::string(31, 'b');
+    bytes = writeChoices(n, Fingerprints{});
+    assert(readChoices(bytes.data(), bytes.size(), back, backPrints) == ReadStatus::Valid);
+    assert(back[0].mark == n[0].mark && back[0].logo == n[0].logo);
+    n[1].mark = std::string(40, 'x');
+    bool threw = false;
+    try { writeChoices(n, Fingerprints{}); } catch (const std::invalid_argument&) { threw = true; }
+    assert(threw);
+
+    // the record fingerprint: the team's identity as the save keeps it
+    {
+        const auto leones = record("LEONES", 0x0B, 7);
+        const uint32_t print = recordFingerprint(leones.data());
+        auto same = leones;
+        same[0x36] = 0x1F;               // letters are 5 bits in the file (0xFF reads back 0x1F)
+        same[0x1B] = 0x03;               // flags 0x40 and 0x20 are lost (5 bits)
+        same[0x17] = 5; same[0x18] = 1;  // another game mark and colour: an edit, same team
+        same[0x14] = 2; same[0x21] = 9;  // underline, cap colour
+        assert(recordFingerprint(same.data()) == print);
+        auto stored = leones;            // a name code of 0x1FFF or more reads back 0xFFFF
+        stored[2 * 7] = 0x3F; stored[2 * 7 + 1] = 0xFF;
+        assert(recordFingerprint(stored.data()) == print);
+        stored = leones;                 // fields wider in memory than in the file: their low bits
+        stored[0x15] = uint8_t(0x0B | 0x20); stored[0x1A] = uint8_t(7 | 0x40);
+        assert(recordFingerprint(stored.data()) == print);
+        assert(recordFingerprint(record("LEONEZ", 0x0B, 7).data()) != print);  // renamed
+        assert(recordFingerprint(record("LEONES", 0x0C, 7).data()) != print);  // another initial
+        assert(recordFingerprint(record("LEONES", 0x0B, 8).data()) != print);  // another base team
+        assert(recordFingerprint(record("TIGRES", 0x13, 7).data()) != print);
+        std::array<uint8_t, 0x37> empty{};  // a deleted slot (zeros)
+        assert(recordFingerprint(empty.data()) != print);
+    }
+
+    // loaded choices against the slots' teams now
+    {
+        Choices loaded;
+        loaded[1] = {"a.png", ""};
+        loaded[2] = {"leones.png", "leones_logo.png"};
+        loaded[3] = {"", "logo.png"};
+        loaded[4] = {"b.png", "b.png"};
+        Fingerprints saved{};
+        saved[1] = 11; saved[2] = 22; saved[3] = 33; saved[4] = 44;
+        std::array<SlotNow, kSlots> now{};
+        now[1] = {true, 11};  // same team
+        now[2] = {true, 99};  // replaced while the option was off
+        now[3] = {false, 0};  // deleted
+        now[4] = {true, 44};
+        now[6] = {true, 66};  // no choice: untouched
+        const auto dropped = dropChangedTeams(loaded, saved, now);
+        assert((dropped == std::vector<int>{2, 3}));
+        assert(loaded[1].mark == "a.png" && loaded[4].logo == "b.png");
+        assert(loaded[2].empty() && loaded[3].empty() && loaded[6].empty());
+    }
+
+    // copy / clear (COPY copies the whole slot but its index: the copy's record has the same
+    // fingerprint, and the store gives both rows the same one)
+    Choices k;
+    k[2] = {"a.png", "b.png"};
+    copySlot(k, 2, 5);
+    assert(k[5].mark == "a.png" && k[5].logo == "b.png" && k[2].mark == "a.png");
+    {
+        const auto from = record("LEONES", 0x0B, 7);
+        const auto to = from;  // 0x8059E2E8 copies 0x2448 bytes but +0x01: the record is identical
+        Fingerprints current{};
+        current[2] = recordFingerprint(from.data());
+        current[5] = recordFingerprint(to.data());
+        const auto block = writeChoices(k, current);
+        Choices r;
+        Fingerprints rp{};
+        assert(readChoices(block.data(), block.size(), r, rp) == ReadStatus::Valid);
+        assert(r[5] == k[5] && rp[5] == rp[2] && rp[2] == recordFingerprint(from.data()));
+    }
+    clearSlot(k, 2);
+    assert(k[2].mark.empty() && k[2].logo.empty() && k[5].mark == "a.png");
+
+    assert(IsMainSaveName("pm3usma.dat") && !IsMainSaveName("pm3usse0.dat") && !IsMainSaveName("pm3usmy0.dat"));
+
+    // nand hook functions end to end on a copy of a real save (ARRANGE_SAVE_FIXTURE), else synthetic
+    const char* src = std::getenv("ARRANGE_SAVE_FIXTURE");
+    std::filesystem::path dir = std::filesystem::temp_directory_path() / "arrange_marks_save_test";
+    std::filesystem::create_directories(dir);
+    auto file = dir / "pm3usma.dat";
+    if (src && std::filesystem::exists(src)) {
+        std::filesystem::copy_file(src, file, std::filesystem::copy_options::overwrite_existing);
+        auto data = slurp(file);  // a fixture saved by an earlier version may carry a block: start without
+        std::fill(data.begin() + kSaveFileOffset, data.begin() + kSaveFileOffset + kSaveBytes, 0);
+        spit(file, data);
+    } else {
+        std::ofstream o(file, std::ios::binary);
+        std::vector<char> z(kSaveFileSize, 0x5A);
+        o.write(z.data(), z.size());
+    }
+    const auto original = slurp(file);
+    assert(original.size() == kSaveFileSize);
+
+    // option off: nothing read, nothing written
+    Fingerprints current{};
+    current[4] = 0x44444444;
+    liveChoices() = Choices{};
+    liveChoices()[4] = {"x.png", "y.png"};
+    {
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        std::fseek(f, 1234, SEEK_SET);
+        assert(OnMainSaveStore(f, false, current) == StoreResult::Disabled);
+        assert(OnMainSaveLoad(f, false) == ReadStatus::Missing);
+        assert(std::ftell(f) == 1234);
+        std::fclose(f);
+    }
+    assert(slurp(file) == original);
+    assert(liveChoices()[4].mark == "x.png");
+
+    // option on: the block lands at 0xD3000, everything else is unchanged
+    {
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        std::fseek(f, 777, SEEK_SET);
+        assert(OnMainSaveStore(f, true, current) == StoreResult::Written);
+        assert(std::ftell(f) == 777);
+        std::fclose(f);
+    }
+    const auto after = slurp(file);
+    const auto block = writeChoices(liveChoices(), current);
+    assert(after.size() == original.size());
+    assert(std::equal(original.begin(), original.begin() + kSaveFileOffset, after.begin()));
+    assert(std::equal(original.begin() + kSaveFileOffset + kSaveBytes, original.end(),
+                      after.begin() + kSaveFileOffset + kSaveBytes));
+    assert(std::equal(block.begin(), block.end(), after.begin() + kSaveFileOffset));
+
+    // load trigger: a read from 0 that stops short of 0xD0000 must not reload; the load's last chunk does
+    assert(!LoadChunkReachesLoadEnd(0, 0x4000) && !LoadChunkReachesLoadEnd(0, kMainSaveLoadEnd - 1));
+    assert(LoadChunkReachesLoadEnd(0, kMainSaveLoadEnd) && LoadChunkReachesLoadEnd(0xCC000, 0x4000));  // the game's last chunk
+    assert(LoadChunkReachesLoadEnd(0xD0000 - 0x4000, 0x4000) && !LoadChunkReachesLoadEnd(0xC8000, 0x4000));
+    assert(!LoadChunkReachesLoadEnd(kMainSaveLoadEnd, 0x4000));
+    assert(ShouldLoadOnRead(0xCC000, 0x4000, false) && ShouldLoadOnRead(0, kDataEnd, false));
+    assert(!ShouldLoadOnRead(0xCC000, 0x4000, true) && !ShouldLoadOnRead(0, kDataEnd, true));
+    assert(!ShouldLoadOnRead(0, 0x4000, false) && !ShouldLoadOnRead(kMainSaveLoadEnd, 0x4000, false));
+    {
+        liveChoices() = Choices{};
+        liveChoices()[9] = {"unsaved.png", "unsaved_logo.png"};
+        const Choices picks = liveChoices();
+        FILE* f = std::fopen(file.string().c_str(), "rb");
+        if (LoadChunkReachesLoadEnd(0, 0x4000)) OnMainSaveLoad(f, true);  // not taken
+        std::fclose(f);
+        assert(liveChoices()[9].mark == picks[9].mark && liveChoices()[4].mark.empty());
+        f = std::fopen(file.string().c_str(), "rb");
+        if (LoadChunkReachesLoadEnd(0, 0xD4000)) assert(OnMainSaveLoad(f, true) == ReadStatus::Valid);
+        std::fclose(f);
+        assert(liveChoices()[9].mark.empty() && liveChoices()[4].mark == "x.png");
+        // loaded, still to be checked against the teams once the game has unpacked them
+        assert(saveState().unchecked && saveState().fingerprints[4] == 0x44444444);
+    }
+
+    // a file that does not span the block is never grown or written
+    {
+        auto shortFile = dir / "short.dat";
+        { std::ofstream o(shortFile, std::ios::binary); std::vector<char> z(kDataEnd + 0x400, 1); o.write(z.data(), z.size()); }
+        const auto before = slurp(shortFile);
+        FILE* f = std::fopen(shortFile.string().c_str(), "r+b");
+        assert(OnMainSaveStore(f, true, current) == StoreResult::NotSpanned);
+        std::fclose(f);
+        assert(slurp(shortFile) == before);
+    }
+
+    // a name over 32 bytes makes the store fail without touching the file
+    {
+        const auto beforeBad = slurp(file);
+        const Choices keep = liveChoices();
+        liveChoices()[1].mark = std::string(40, 'z');
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        assert(OnMainSaveStore(f, true, current) == StoreResult::Failed);
+        std::fclose(f);
+        liveChoices() = keep;
+        assert(slurp(file) == beforeBad);
+    }
+
+    // read back
+    liveChoices() = Choices{};
+    {
+        FILE* f = std::fopen(file.string().c_str(), "rb");
+        assert(OnMainSaveLoad(f, true) == ReadStatus::Valid);
+        std::fclose(f);
+    }
+    assert(liveChoices()[4].mark == "x.png" && liveChoices()[4].logo == "y.png");
+
+    // renamed while the option is on: the next store saves the new fingerprint, so after a reload the
+    // check finds the same team and the choice stays
+    {
+        Fingerprints renamed = current;
+        renamed[4] = 0x55555555;
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        assert(OnMainSaveStore(f, true, renamed) == StoreResult::Written);
+        std::fclose(f);
+        liveChoices() = Choices{};
+        f = std::fopen(file.string().c_str(), "rb");
+        assert(OnMainSaveLoad(f, true) == ReadStatus::Valid);
+        std::fclose(f);
+        std::array<SlotNow, kSlots> now{};
+        now[4] = {true, 0x55555555};
+        assert(dropChangedTeams(liveChoices(), saveState().fingerprints, now).empty());
+        assert(liveChoices()[4].mark == "x.png");
+        // ... while the same block against a team changed with the option off loses it
+        Choices other = liveChoices();
+        now[4] = {true, 0x44444444};
+        assert((dropChangedTeams(other, saveState().fingerprints, now) == std::vector<int>{4}) && other[4].empty());
+        f = std::fopen(file.string().c_str(), "r+b");  // back to the first fingerprint for what follows
+        assert(OnMainSaveStore(f, true, current) == StoreResult::Written);
+        std::fclose(f);
+    }
+
+    // the game rewrites below the tail (option off, so no hook runs): the block survives
+    {
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        uint8_t b = 7;
+        std::fseek(f, 0x100, SEEK_SET);
+        std::fwrite(&b, 1, 1, f);
+        std::fclose(f);
+    }
+    assert(std::equal(block.begin(), block.end(), slurp(file).begin() + kSaveFileOffset));
+
+    // corrupted block: Invalid and live choices empty
+    {
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        uint8_t b = 0xEE;
+        std::fseek(f, long(kSaveFileOffset + 500), SEEK_SET);
+        std::fwrite(&b, 1, 1, f);
+        std::fclose(f);
+        liveChoices()[4] = {"stale", "stale"};
+        f = std::fopen(file.string().c_str(), "rb");
+        assert(OnMainSaveLoad(f, true) == ReadStatus::Invalid);
+        std::fclose(f);
+        assert(liveChoices()[4].mark.empty() && !saveState().unchecked);
+    }
+
+    // after an Invalid load the block on disk is kept by every save until a choice changes
+    {
+        const auto invalid = slurp(file);
+        for (int save = 0; save < 3; ++save) {
+            FILE* f = std::fopen(file.string().c_str(), "r+b");
+            assert(OnMainSaveStore(f, true, current) == StoreResult::KeptInvalid);
+            std::fclose(f);
+        }
+        assert(slurp(file) == invalid);
+        liveChoices()[7] = {"new.png", ""};  // the user picks a mark in this run
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        assert(OnMainSaveStore(f, true, current) == StoreResult::Written);
+        std::fclose(f);
+        liveChoices()[7] = Choice{};  // and takes it back: from now on the block follows the run
+        f = std::fopen(file.string().c_str(), "r+b");
+        assert(OnMainSaveStore(f, true, current) == StoreResult::Written);
+        std::fclose(f);
+        f = std::fopen(file.string().c_str(), "rb");
+        assert(OnMainSaveLoad(f, true) == ReadStatus::Valid);
+        std::fclose(f);
+        assert(liveChoices()[7].empty() && !saveState().unchecked);
+    }
+
+    // a version 1 block in the file: Invalid, and kept until a choice changes
+    {
+        auto data = slurp(file);
+        const auto v1 = versionOneBlock();
+        std::fill(data.begin() + kSaveFileOffset, data.begin() + kSaveFileOffset + kSaveBytes, 0);
+        std::copy(v1.begin(), v1.end(), data.begin() + kSaveFileOffset);
+        spit(file, data);
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        assert(OnMainSaveLoad(f, true) == ReadStatus::Invalid);
+        assert(liveChoices()[2].empty());
+        assert(OnMainSaveStore(f, true, current) == StoreResult::KeptInvalid);
+        std::fclose(f);
+        assert(slurp(file) == data);
+    }
+
+    // a missing block (zeros) is written by the first save
+    {
+        auto data = slurp(file);
+        std::fill(data.begin() + kSaveFileOffset, data.begin() + kSaveFileOffset + kSaveBytes, 0);
+        spit(file, data);
+        FILE* f = std::fopen(file.string().c_str(), "r+b");
+        assert(OnMainSaveLoad(f, true) == ReadStatus::Missing);
+        assert(OnMainSaveStore(f, true, current) == StoreResult::Written);
+        std::fclose(f);
+        f = std::fopen(file.string().c_str(), "rb");
+        assert(OnMainSaveLoad(f, true) == ReadStatus::Valid);
+        std::fclose(f);
+    }
+    std::filesystem::remove_all(dir);
+    std::cout << "arrange_marks_save ok" << (src ? " (real save fixture)" : " (synthetic file)") << "\n";
+}
