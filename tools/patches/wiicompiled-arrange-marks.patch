+                Sound(ctx, a ? 0x1004 : 0x1002);
+            }
+            return;
+        }
+        if (!g_logo.onRow && ((selected == 0 && down) || (selected == 1 && up))) {
+            InputPrologue(ctx, s);
+            g_logo.onRow = true;
+            VCall(ctx, s, 0xF0);
+            Sound(ctx, 0x1004);
+            return;
+        }
+        if (!g_logo.onRow && a && selected == 3 && !g_logo.pending.empty()) {
+            // OK with a custom logo: the game's OK (vt +0xB8, confirm vt +0xF4, close) without its
+            // letters check; a new choice whose file cannot be used is refused as the game refuses.
+            InputPrologue(ctx, s);
+            TextureRef ref;
+            if (g_logo.pending != g_logo.original && !logoTexture(Choice{{}, g_logo.pending}, ref)) {
+                Sound(ctx, 0x1003);
+                return;
+            }
