+        const uint32_t selected = Memory::Read32(s + kLtSelector + 0x28);
+        const bool a = pressed(0x805EF2F8), b = pressed(0x805EF300), up = pressed(0x805EF2D8),
+                   down = pressed(0x805EF2E0), left = pressed(0x805EF2F0), right = pressed(0x805EF2E8);
+        if (g_logo.onRow && (a || b || up || down || left || right)) {
+            InputPrologue(ctx, s);
+            if (up || down) {
