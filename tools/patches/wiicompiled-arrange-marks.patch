+// --- Guest memory -------------------------------------------------------------------------------
+// [arena, arena + kArenaBytes): a scratch page (anchor vectors, list names), then kCacheSlots marks.
+// The cache holds every picture the 32 slots can have chosen (a mark and a logo each) and two more, so
+// browsing a list never has to evict a chosen picture (Chosen, FreeSlot).
+constexpr uint32_t kCacheSlots = uint32_t(2 * kSlots + 2);
+static_assert(kCacheSlots >= 2 * kSlots + 1);
+constexpr uint32_t kSlotBytes = 0x11540;
+constexpr uint32_t kHeadBytes = 0x1000;
+constexpr uint32_t kArenaBytes = kHeadBytes + kCacheSlots * kSlotBytes;
+constexpr uint32_t kRetailMem2Heap = 0x033E0000u - 0x800u;  // as game_heaps.cpp keeps it
+// Within a slot: texels, palette, texture and palette descriptors, then the same for the icon.
+constexpr uint32_t kTexels = 0, kPalette = 0x10000, kTexDesc = 0x10200, kPalDesc = 0x10240;
+constexpr uint32_t kIconTexels = 0x10280, kIconPalette = 0x11280, kIconTexDesc = 0x11480, kIconPalDesc = 0x114C0;
+// Then the sprite descriptors (SPRD, 0x1C) that draw the slot's picture in the game's widgets (Task 8):
+// the mark's icon in a TEAM FLAG field and the logo. Both are the same for every widget that uses the
+// picture (whole texture, pivot at its centre); each widget's place and size are its own.
+constexpr uint32_t kFieldSprd = 0x11500, kLogoSprd = 0x11520;
+static_assert(kIconPalDesc + 0x20 <= kFieldSprd && kLogoSprd + 0x1C <= kSlotBytes && kSlotBytes % 32 == 0);
+constexpr uint32_t kScratch = 0x0, kNames = 0x100, kNameStride = 0x20;
+static_assert(kNames + kMaxEntries * kNameStride <= kHeadBytes);
+
+uint32_t g_arena = 0;
+
+bool Enabled() { return g_arena != 0; }
+
+// --- Game data ----------------------------------------------------------------------------------
+constexpr uint32_t kSlotBlock = 0x8104E1D8, kSlotsOffset = 0x3AC, kSlotStride = 0x2448, kRecord = 0x42;
+constexpr uint32_t kEditingSlot = 0x8102B2C8, kMatchSlot = 0x8102D730;
+constexpr uint32_t kStyle = 0x80CFFBB8;      // the team name's text style
+// Team Mark screen fields.
+constexpr uint32_t kCursor = 0x2938, kChoice = 0x293C, kColour = 0x29A8, kRow = 0x2A14, kColumn = 0x2A18,
+                   kScroll = 0x2A1C, kRowStep = 0x2A20, kBar = 0x2A44, kContainer = 0x2E50, kCells = 0x3050,
+                   kLabels = 0x5650;
+constexpr uint32_t kVisibleRows = 12;
+// Floats of the screen's layout (rodata 0x80CEDD90 + 0x108 / 0x10C / 0xE0).
+constexpr uint32_t kCursorX = 0x80CEDE98, kCursorY = 0x80CEDE9C, kContainerX = 0x80CEDE70;
+
+int SlotOf(uint32_t slot) {
+    const uint32_t block = Memory::Read32(kSlotBlock);
+    if (!block) return -1;
+    const uint32_t first = block + kSlotsOffset;
+    if (slot < first || slot >= first + kSlots * kSlotStride || (slot - first) % kSlotStride) return -1;
+    return int((slot - first) / kSlotStride);
+}
+int EditingSlot() {
+    const uint32_t slot = Memory::Read32(kEditingSlot);
+    return slot ? SlotOf(slot) : -1;
+}
+uint32_t EditingRecord() {
+    const uint32_t slot = Memory::Read32(kEditingSlot);
+    return slot && Memory::Contains(slot + kRecord, 0x37) ? slot + kRecord : 0;
+}
+uint8_t GameMarkOf(uint32_t record) {
+    const uint8_t mark = record ? Memory::Read8(record + 0x17) : 0;
+    return mark < kGameMarks ? mark : 0;
+}
+
+// A team record's fingerprint (recordFingerprint: name, initial, base team), read from guest memory.
+bool RecordPrint(uint32_t record, uint32_t& out) {
+    if (!record || !Memory::Contains(record, uint32_t(kRecordIdentityBytes))) return false;
+    uint8_t bytes[kRecordIdentityBytes];
+    for (uint32_t i = 0; i < kRecordIdentityBytes; ++i) bytes[i] = Memory::Read8(record + i);
+    out = recordFingerprint(bytes);
+    return true;
+}
+// Slot i of the main block now: whether it holds a team (+0x00) and its record's fingerprint.
+SlotNow SlotState(uint32_t i) {
+    SlotNow now;
+    const uint32_t block = i < kSlots ? Memory::Read32(kSlotBlock) : 0;
+    const uint32_t slot = block ? block + kSlotsOffset + i * kSlotStride : 0;
+    if (slot && Memory::Contains(slot, kRecord + uint32_t(kRecordIdentityBytes)) && Memory::Read8(slot))
+        now.used = RecordPrint(slot + kRecord, now.fingerprint);
+    return now;
+}
+
+// --- Calls into the game ------------------------------------------------------------------------
+uint32_t Call(CpuContext* ctx, uint32_t target, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0, uint32_t d = 0,
+              uint32_t e = 0) {
+    const uint32_t lr = ctx->lr;
+    ctx->gpr[3] = a;
+    ctx->gpr[4] = b;
+    ctx->gpr[5] = c;
+    ctx->gpr[6] = d;
+    ctx->gpr[7] = e;
+    ctx->lr = target;
+    InvokeIndirectCpu(target, ctx);
+    ctx->lr = lr;
+    return ctx->gpr[3];
+}
+uint32_t CallF(CpuContext* ctx, uint32_t target, uint32_t a, float f1, float f2) {
+    ctx->fpr[1].d = double(f1);
+    ctx->fpr[2].d = double(f2);
+    return Call(ctx, target, a);
+}
+uint32_t VCall(CpuContext* ctx, uint32_t object, uint32_t offset, uint32_t b = 0, uint32_t c = 0) {
+    if (!object || !Memory::Contains(object, 4)) return 0;
+    const uint32_t table = Memory::Read32(object);
+    if (!Memory::Contains(table + offset, 4)) return 0;
+    const uint32_t function = Memory::Read32(table + offset);
+    return function ? Call(ctx, function, object, b, c) : 0;
+}
+void SetVisible(CpuContext* ctx, uint32_t node, bool visible) { VCall(ctx, node, 0x10, visible ? 1 : 0); }
+void Sound(CpuContext* ctx, uint32_t id) { Call(ctx, 0x80020254, Call(ctx, 0x80010F8C), id); }
+float F(uint32_t address) { return Memory::ReadFloat32(address); }
+// A layout point of pack `pack` (fn_80020CA0 fills a 2D vector initialised by 0x80584748).
+std::array<float, 2> Anchor(CpuContext* ctx, uint32_t pack, uint32_t id) {
+    const uint32_t vec = g_arena + kScratch;
+    Call(ctx, 0x80584748, vec);
+    Call(ctx, 0x80020CA0, vec, pack, id);
+    return {F(vec), F(vec + 4)};
+}
+
+// --- Logging ------------------------------------------------------------------------------------
+std::set<std::string> g_logged;
+void LogOnce(const std::string& key, const std::string& message) {
+    if (g_logged.insert(key).second) std::fprintf(stderr, "[arrange] %s\n", message.c_str());
+}
+
+// --- Catalog ------------------------------------------------------------------------------------
+// The two kinds of custom picture: marks (UserData/arrange/marks) and logos (UserData/arrange/logos).
+enum class Kind { Mark, Logo };
+const char* KindName(Kind kind) { return kind == Kind::Mark ? "mark" : "logo"; }
+fs::path FolderOf(Kind kind) {
+    return RuntimeConfigFile::ApplicationDataDirectory() / "arrange" / (kind == Kind::Mark ? "marks" : "logos");
+}
+fs::path MarksFolder() { return FolderOf(Kind::Mark); }
+// Cache and slot owner key: the kind and the file name.
+std::string KeyOf(Kind kind, const std::string& file) { return std::string(KindName(kind)) + "/" + file; }
+
+std::vector<std::string> g_registry;  // virtual index kGameMarks + i <-> file
+
+struct Cached {
+    int slot = -1;
+    bool failed = false;
+    fs::file_time_type time{};
+    uintmax_t size = 0;
+    uint64_t used = 0;
+    std::chrono::steady_clock::time_point checked{};  // the last stat of the file
+};
+// A loaded picture is re-checked on disk (stat) at most this often: the draw hooks may run on many
+// frames in a row, and a file changed or removed meanwhile is picked up on the next check.
+constexpr std::chrono::milliseconds kRecheck{1000};
+std::map<std::string, Cached> g_cache;
+std::array<std::string, kCacheSlots> g_owner;
+uint64_t g_clock = 0;
+
+bool Stat(const fs::path& path, fs::file_time_type& time, uintmax_t& size) {
+    std::error_code e1, e2;
+    size = fs::file_size(path, e1);
+    time = fs::last_write_time(path, e2);
+    return !e1 && !e2;
+}
+
+bool ReadFile(const fs::path& path, std::vector<uint8_t>& data, size_t limit) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    in.seekg(0, std::ios::end);
+    const std::streamoff size = in.tellg();
+    if (size <= 0 || size_t(size) > limit) return false;
+    in.seekg(0);
+    data.resize(size_t(size));
+    return bool(in.read(reinterpret_cast<char*>(data.data()), size));
+}
+
+// A PNG worth offering: a valid start (signature, IHDR with its CRC, at most 4096 x 4096) and chunk
+// headers that end with IEND exactly at the end of the file. Seeks over the data, decodes nothing.
+bool Header(const fs::path& path, PngInfo& info) {
+    std::ifstream in(path, std::ios::binary);
+    uint8_t head[33] = {};
+    if (!in || !in.read(reinterpret_cast<char*>(head), sizeof head) || !pngHeader(head, sizeof head, info)) return false;
+    std::error_code ec;
+    const uintmax_t size = fs::file_size(path, ec);
+    return !ec && pngChunksComplete(size, [&](uint64_t at, uint8_t* out) {
+        in.clear();
+        in.seekg(std::streamoff(at));
+        return bool(in.read(reinterpret_cast<char*>(out), 8));
+    });
+}
+
+// The folder's marks or logos a list offers: scan() (PNG by name, sorted, labelled), minus names
+// that do not fit a Choice (31 bytes), files that are not a whole PNG of at most 4096 x 4096
+// (Header), and files that already failed to decode (until they change). Nothing without a PNG
+// decoder.
+std::vector<Entry> Catalog(Kind kind = Kind::Mark) {
+    std::vector<Entry> out;
+    const std::string what = KindName(kind);
+#ifndef MKW_HAVE_LIBPNG
+    LogOnce("nodecoder", "custom marks and logos unavailable: this build has no PNG decoder");
+    return out;  // never offer pictures that cannot load
+#endif
+    const fs::path folder = FolderOf(kind);
+    for (Entry& entry : scan(folder)) {
+        if (entry.file.size() >= kNameBytes) {
+            LogOnce("long:" + what + entry.file, what + " '" + entry.file + "' skipped: file names are limited to 31 bytes");
+            continue;
+        }
+        const fs::path path = pathOf(folder, entry);
+        PngInfo info;
+        if (!Header(path, info)) {
+            LogOnce("bad:" + what + entry.file, what + " '" + entry.file + "' skipped: not a whole PNG of at most 4096 x 4096");
+            continue;
+        }
+        const auto cached = g_cache.find(KeyOf(kind, entry.file));
+        fs::file_time_type time;
+        uintmax_t size = 0;
+        if (cached != g_cache.end() && cached->second.failed && Stat(path, time, size) &&
+            time == cached->second.time && size == cached->second.size)
+            continue;
+        out.push_back(std::move(entry));
+    }
+    return out;
+}
+
+// The game's font codes: ASCII + 0x9B for letters and digits, 0 space, 0x1D hyphen, 0xFFFF end.
+uint32_t WriteName(uint32_t at, const std::string& name) {
+    size_t i = 0;
+    for (; i < name.size() && i < 10; ++i) {
+        const char c = name[i];
+        const uint16_t code = c == ' ' ? 0 : c == '-' ? 0x1D : uint16_t(uint8_t(c) + 0x9B);
+        Memory::Write16(at + uint32_t(i) * 2, code);
+    }
+    Memory::Write16(at + uint32_t(i) * 2, 0xFFFF);
+    return at;
+}
+
+// --- Textures -----------------------------------------------------------------------------------
+bool Decode(const fs::path& path, Rgba& out, std::string& why) {
+#ifdef MKW_HAVE_LIBPNG
+    std::vector<uint8_t> data;
+    if (!ReadFile(path, data, kMaxFileBytes)) { why = "unreadable"; return false; }
+    png_image image{};
+    image.version = PNG_IMAGE_VERSION;
+    if (!png_image_begin_read_from_memory(&image, data.data(), data.size())) { why = "not a PNG"; return false; }
+    if (!image.width || !image.height || image.width > kMaxPngSide || image.height > kMaxPngSide) {
+        png_image_free(&image);
+        why = "larger than 4096 x 4096";
+        return false;
+    }
+    image.format = PNG_FORMAT_RGBA;
+    out.width = image.width;
+    out.height = image.height;
+    out.pixels.assign(PNG_IMAGE_SIZE(image), 0);
+    if (!png_image_finish_read(&image, nullptr, out.pixels.data(), 0, nullptr)) {
+        why = image.message[0] ? image.message : "damaged PNG";
+        png_image_free(&image);
+        return false;
+    }
+    return true;
+#else
+    (void)path; (void)out;
+    why = "no PNG decoder in this build";
+    return false;
+#endif
+}
+
+// The game's marks draw texels (0, 0)-(158, 190) of their 256 x 256 texture (the mark widget's
+// rectangle, 0x805BE408); the picture is fitted there. The icon fills its 64 x 64 texture.
+constexpr uint32_t kMarkArtWidth = 0x9E, kMarkArtHeight = 0xBE;
+Rgba Canvas(const Rgba& picture, uint32_t side) {
+    if (side != 256) return fit(picture, side, side);
+    const Rgba art = fit(picture, kMarkArtWidth, kMarkArtHeight);
+    Rgba out;
+    out.width = out.height = side;
+    out.pixels.assign(size_t(side) * side * 4, 0);
+    for (uint32_t y = 0; y < art.height; ++y)
+        std::memcpy(&out.pixels[size_t(y) * side * 4], &art.pixels[size_t(y) * art.width * 4], size_t(art.width) * 4);
+    return out;
+}
+
+// A canvas (already fitted) as a C8 texture with its RGB5A3 palette, made on the host (it may throw
+// std::bad_alloc) before any guest memory is touched.
+struct Texture {
+    uint32_t width = 0, height = 0;
+    std::vector<uint8_t> c8;
+    std::array<uint16_t, 256> palette{};
+};
+Texture MakeTexture(const Rgba& canvas) {
+    const Indexed indexed = quantize(canvas);
+    return {canvas.width, canvas.height, toC8(indexed), indexed.palette};
+}
+
+// The texture into guest memory, with its two descriptors.
+void PutTexture(uint32_t texels, uint32_t palette, uint32_t texDesc, uint32_t palDesc, const Texture& texture) {
+    std::memcpy(Memory::GetPointer(texels, texture.c8.size()), texture.c8.data(), texture.c8.size());
+    for (uint32_t i = 0; i < 256; ++i) Memory::Write16(palette + i * 2, texture.palette[i]);
+    const uint32_t tex[16] = {texture.height << 16 | texture.width, 9, texels, 0, 0, 1, 1};
+    for (uint32_t i = 0; i < 16; ++i) Memory::Write32(texDesc + i * 4, tex[i]);
+    const uint32_t pal[8] = {256u << 16, 2, palette};
+    for (uint32_t i = 0; i < 8; ++i) Memory::Write32(palDesc + i * 4, pal[i]);
+}
+
+uint32_t SlotAddress(int slot) { return g_arena + kHeadBytes + uint32_t(slot) * kSlotBytes; }
+
+void Fill(int slot, TextureRef& out) {
+    const uint32_t base = SlotAddress(slot);
+    out = {base + kTexDesc, base + kPalDesc, base + kIconTexDesc, base + kIconPalDesc};
+}
+
+// A free cache slot, else the least recently used one. Pictures some slot has chosen (liveChoices)
+// are kept while another can go: the widgets showing a team's mark or logo keep pointing at their
+// slot's texels and are not redrawn when the cache moves on (browsing many logos must not repaint
+// them). Only when every slot holds a chosen picture does plain LRU apply.
+bool Chosen(const std::string& key) {  // key = KeyOf(kind, file)
+    const size_t slash = key.find('/');
+    return slash != std::string::npos &&
+           isChosen(liveChoices(), key.compare(0, slash, "logo") == 0, key.substr(slash + 1));
+}
+int FreeSlot() {
+    for (uint32_t i = 0; i < kCacheSlots; ++i)
+        if (g_owner[i].empty()) return int(i);
+    int oldest = -1, oldestAny = 0;
+    uint64_t when = UINT64_MAX, whenAny = UINT64_MAX;
+    for (const auto& [key, cached] : g_cache) {
+        if (cached.slot < 0) continue;
+        if (cached.used < whenAny) { whenAny = cached.used; oldestAny = cached.slot; }
+        if (cached.used < when && !Chosen(key)) { when = cached.used; oldest = cached.slot; }
+    }
+    if (oldest < 0) oldest = oldestAny;
+    g_cache[g_owner[size_t(oldest)]].slot = -1;  // keys are KeyOf(kind, file)
+    std::fprintf(stderr, "[arrange] cache slot %d reused (was '%s')\n", oldest, g_owner[size_t(oldest)].c_str());
+    return oldest;
+}
+
+// --- The Team Mark list -------------------------------------------------------------------------
+// The list names of the folder's marks, from the last list built (the MARK legend shows them).
+std::map<std::string, std::string> g_markLabels;
+bool g_markLabelsScanned = false;
+void RememberMarkLabels(const std::vector<Entry>& entries, const std::vector<std::string>& names) {
+    g_markLabels.clear();
+    for (size_t i = 0; i < entries.size() && i < names.size(); ++i) g_markLabels[entries[i].file] = names[i];
+}
+
+struct List {
+    uint32_t screen = 0;
+    // Per custom entry: cell panel, name holder node, name text widget, virtual mark index.
+    std::vector<uint32_t> cells, labels, texts, marks;
+};
+List g_list;
+// The team-name font is 34 units high; colour 1 is the blue of the list's own names (0 pink, 2 green).
+constexpr float kNameScale = 0.45f, kGlyphHeight = 34.0f;
+constexpr uint32_t kNameColour = 1;
+
+bool Active(uint32_t screen) { return Enabled() && screen && g_list.screen == screen && !g_list.marks.empty(); }
+uint32_t Total() { return kGameMarks + uint32_t(g_list.marks.size()); }
+uint32_t Rows() { return (Total() + 1) / 2; }
+uint32_t Cell(uint32_t screen, uint32_t i) {
+    return i < kGameMarks ? screen + kCells + i * 0x100 : g_list.cells[i - kGameMarks];
+}
+uint32_t Label(uint32_t screen, uint32_t i) {
+    return i < kGameMarks ? Memory::Read32(screen + kLabels + i * 4) : g_list.labels[i - kGameMarks];
+}
+
+void Teardown(CpuContext* ctx, uint32_t screen) {
+    if (!screen || g_list.screen != screen) return;
+    for (uint32_t text : g_list.texts)
+        if (text) VCall(ctx, text, 0x08, 1);
+    for (uint32_t label : g_list.labels)
+        if (label) VCall(ctx, label, 0x08, 1);
+    for (uint32_t cell : g_list.cells)
+        if (cell) VCall(ctx, cell, 0x08, 1);
+    g_list = {};
+}
+
+// After the game built its 38 cells (0x805BD300): one more cell and name per folder mark, placed by
+// the same layout points (pack 0x929: cell 0x400736B8, next column 0x400736BC, next row 0x400736C0)
+// and hidden until the refresh shows them.
+void BuildCustomCells(CpuContext* ctx, uint32_t screen) {
+    const std::vector<Entry> entries = Catalog();
+    const std::vector<std::string> names = shownLabels(entries);
+    RememberMarkLabels(entries, names);
+    g_markLabelsScanned = true;
+    if (entries.empty()) return;
+    const auto origin = Anchor(ctx, 0x929, 0x400736B8), column = Anchor(ctx, 0x929, 0x400736BC),
+               row = Anchor(ctx, 0x929, 0x400736C0);
+    const float dx = column[0] - origin[0], dy = row[1] - origin[1];
+    const uint32_t container = screen + kContainer;
+    const uint32_t style = Memory::Read32(kStyle) & 0xFFFF;
+    g_list.screen = screen;
+    for (size_t k = 0; k < entries.size(); ++k) {
+        const uint32_t position = kGameMarks + uint32_t(k);
+        const float x = origin[0] + float(position % 2) * dx, y = origin[1] + float(position / 2) * dy;
+        const uint32_t cell = Call(ctx, 0x8005B060, 0x100);
+        if (!cell) break;
+        Call(ctx, 0x8001E9BC, cell);
+        Call(ctx, 0x8057A180, cell, container);
+        Call(ctx, 0x8001AC60, cell, 0);
+        Call(ctx, 0x8001DFB8, cell, 0x929, 0x40073EB0);
+        CallF(ctx, 0x8001A7B0, cell, x, y);
+        SetVisible(ctx, cell, false);
+        // The name: the team-name text widget, in a holder node that scales it to the cell's height
+        // and centres it (the widget animates its own scale, and lays its glyphs out from its origin).
+        const uint32_t holder = Call(ctx, 0x8005B060, 0x100);
+        uint32_t text = 0;
+        if (holder) {
+            Call(ctx, 0x8001E9BC, holder);
+            Call(ctx, 0x8057A180, holder, container);
+            Call(ctx, 0x8001AC60, holder, 0);
+            CallF(ctx, 0x8001ABA0, holder, kNameScale, kNameScale);
+            text = Call(ctx, 0x805C28D4, holder, 0, style);
+        }
+        float width = 0;
+        if (text) {
+            Call(ctx, 0x8001AC60, text, 0);
+            CallF(ctx, 0x8001A7B0, text, 0, 0);
+            Call(ctx, 0x807B4090, text, kNameColour);
+            VCall(ctx, text, 0x40, WriteName(g_arena + kNames + uint32_t(k) * kNameStride, names[k]));
+            Call(ctx, 0x807B4090, text, kNameColour);
+            const uint32_t glyphs = Memory::Read32(text + 0x130), count = Memory::Read16(text + 0x10A);
+            if (count && Memory::Contains(glyphs + (count - 1) * 0x1C, 0x1C))
+                width = float(Memory::Read16(glyphs + (count - 1) * 0x1C + 8));
+        }
+        if (holder) {
+            const float cellWidth = dx - 3, cellHeight = dy - 4;
+            CallF(ctx, 0x8001A7B0, holder, x + (cellWidth - width * kNameScale) / 2,
+                  y + (cellHeight - kGlyphHeight * kNameScale) / 2);
+            SetVisible(ctx, holder, false);
+        }
+        g_list.cells.push_back(cell);
+        g_list.labels.push_back(holder);
+        g_list.texts.push_back(text);
+        g_list.marks.push_back(markIndexFor(entries[k].file));
+    }
+    if (g_list.marks.empty()) { g_list = {}; return; }
+    // The cursor starts on the team's custom mark, as the game starts it on its game mark.
+    const int slot = EditingSlot();
+    const uint32_t record = EditingRecord();
+    if (slot < 0 || !record || !(Memory::Read8(record + 0x1B) & 0x02)) return;
+    const std::string& chosen = liveChoices()[size_t(slot)].mark;
+    for (size_t k = 0; k < entries.size() && k < g_list.marks.size(); ++k) {
+        if (entries[k].file != chosen) continue;
+        const uint32_t position = kGameMarks + uint32_t(k);
+        Memory::Write32(screen + kRow, 0);
+        Memory::Write32(screen + kScroll, 0);
+        Memory::Write32(screen + kColumn, position % 2);
+        for (uint32_t n = 0; n < position / 2; ++n) Call(ctx, 0x805BD28C, screen);
+        break;
+    }
+}
+
+// 0x805BDCE0 for 38 + N entries: cursor, the 12 visible rows, scroll bar, list position, preview.
+void Refresh(CpuContext* ctx, uint32_t s) {
+    const uint32_t cursor = Memory::Read32(s + kCursor);
+    SetVisible(ctx, cursor, true);
+    const uint32_t row = Memory::Read32(s + kRow), column = Memory::Read32(s + kColumn),
+                   scroll = Memory::Read32(s + kScroll);
+    const int32_t step = int32_t(Memory::Read32(s + kRowStep));
+    CallF(ctx, 0x8001A7B0, cursor, F(kCursorX) + float(int32_t(column * 0x74)), F(kCursorY) + float(step * int32_t(row)));
+    const uint32_t total = Total();
+    for (uint32_t i = 0; i < total; ++i) {
+        SetVisible(ctx, Cell(s, i), false);
+        SetVisible(ctx, Label(s, i), false);
+    }
+    for (uint32_t i = scroll * 2; i < std::min(total, scroll * 2 + kVisibleRows * 2); ++i) {
+        SetVisible(ctx, Cell(s, i), true);
+        SetVisible(ctx, Label(s, i), true);
+    }
+    const uint32_t bar = Memory::Read32(s + kBar);
+    Call(ctx, 0x8072FBE8, bar, Rows());
+    Call(ctx, 0x8072FC18, bar, scroll + 0xB, 1);
+    CallF(ctx, 0x8001A7B0, s + kContainer, F(kContainerX), float(-(int32_t(scroll) * step)));
+    Call(ctx, 0x805BDF44, s);
+}
+
+// The column on a last row with a single entry.
+void ClampColumn(uint32_t s) {
+    const uint32_t position = (Memory::Read32(s + kScroll) + Memory::Read32(s + kRow)) * 2 + Memory::Read32(s + kColumn);
+    if (position >= Total()) Memory::Write32(s + kColumn, 0);
+}
+
+uint32_t Position(uint32_t s) {
+    return (Memory::Read32(s + kScroll) + Memory::Read32(s + kRow)) * 2 + Memory::Read32(s + kColumn);
+}
+
+// One row up (0x805BD240) or down (0x805BD28C), then the refresh; the cursor sound only if it moved.
+void Move(CpuContext* ctx, uint32_t s, uint32_t step) {
+    const uint32_t before = Memory::Read32(s + kScroll) + Memory::Read32(s + kRow);
+    Call(ctx, step, s);
+    ClampColumn(s);
+    Call(ctx, 0x805BDCE0, s);
+    if (Memory::Read32(s + kScroll) + Memory::Read32(s + kRow) != before) Sound(ctx, 0x1000);
+}
+void Colour(CpuContext* ctx, uint32_t s, uint32_t step) {
+    if (Call(ctx, 0x805BE158, s) >= 0x18) return;
+    Call(ctx, step, s + kColour);
+    Call(ctx, 0x805BDCE0, s);
+    Sound(ctx, 0x1004);
+}
+
+// 0x805BCEE8 (vt +0x38) for 38 + N entries; the same buttons, calls and sounds as the game's.
+void Input(CpuContext* ctx, uint32_t s) {
+    Call(ctx, 0x807A58E8, s);
+    const auto pressed = [&](uint32_t query) { return Call(ctx, query, 0) != 0; };
+    const auto line = [&]() { return Memory::Read32(s + kScroll) + Memory::Read32(s + kRow); };
+    if (pressed(0x805EF2F8)) {  // A
+        // A PNG that cannot be used (damaged, changed into something else since the list was built)
+        // is refused as Logo Text refuses one (0x1003), and the list stays open.
+        const uint32_t position = Position(s);
+        if (position >= kGameMarks && position < Total()) {
+            const std::string* file = markFileFor(g_list.marks[position - kGameMarks]);
+            TextureRef ref;
+            if (!file || EditingSlot() < 0 || !EditingRecord() || !markTexture(Choice{*file, {}}, ref)) {
+                Sound(ctx, 0x1003);
+                return;
+            }
+        }
+        const uint32_t value = Call(ctx, 0x805F7A60, s + kChoice);
+        if (VCall(ctx, s, 0xB8, value)) {
+            VCall(ctx, s, 0xDC);
+            Call(ctx, 0x80588710, s, 7);
+            Sound(ctx, 0x1001);
+            SetVisible(ctx, Memory::Read32(s + kCursor), false);
+        }
+    } else if (pressed(0x805EF300)) {  // B
+        if (VCall(ctx, s, 0xBC)) {
+            Call(ctx, 0x80588710, s, 7);
+            Sound(ctx, 0x1002);
+            SetVisible(ctx, Memory::Read32(s + kCursor), false);
+        }
+    } else if (pressed(0x805EF2F0)) {  // left
+        Call(ctx, 0x805F83B8, s + kChoice);
+        if (Memory::Read32(s + kColumn) == 1) {
+            Memory::Write32(s + kColumn, 0);
+            Call(ctx, 0x805BDCE0, s);
+            Sound(ctx, 0x1000);
+        }
+    } else if (pressed(0x805EF2E8)) {  // right
+        if (Memory::Read32(s + kColumn) == 0 && line() * 2 + 1 < Total()) {
+            Memory::Write32(s + kColumn, 1);
+            Call(ctx, 0x805BDCE0, s);
+            Sound(ctx, 0x1000);
+        }
+    } else if (pressed(0x805EF2D8)) {  // up
+        Move(ctx, s, 0x805BD240);
+    } else if (pressed(0x805EF2E0)) {  // down
+        Move(ctx, s, 0x805BD28C);
+    } else if (pressed(0x805EF5F4)) {  // L: the colour, game marks below 24 only
+        Colour(ctx, s, 0x805F83B8);
+    } else if (pressed(0x805EF564)) {  // R
+        Colour(ctx, s, 0x805F8690);
+    }
+}
+
+// Choices of the two "Cancel" copies of the record being edited (0x8102FB78 + i * 0x38).
+struct Snapshot {
+    int slot = -1;
+    Choice choice;
+};
+std::array<Snapshot, 2> g_snapshots;
+
+bool SameChoice(const Choice& a, const Choice& b) { return a.mark == b.mark && a.logo == b.logo; }
+
+}  // namespace
+
+// --- Interfaces ---------------------------------------------------------------------------------
+uint32_t ReserveGuestMemory(uint32_t low, uint32_t high) {
+    g_arena = 0;
+    if (!RuntimeConfigFile::ArrangeCustomMarks(false)) return high;
+    const uint32_t arena = (high - kArenaBytes) & ~0xFFFu;
+    if (high <= low || high - low < kArenaBytes + 0x1000 || arena - low < kRetailMem2Heap ||
+        !Memory::Contains(arena, kArenaBytes)) {
+        std::fprintf(stderr, "[arrange] custom marks off: no room in the MEM2 arena\n");
+        return high;
+    }
+    std::memset(Memory::GetPointer(arena, kArenaBytes), 0, kArenaBytes);
+    g_arena = arena;
+    std::fprintf(stderr, "[arrange] custom marks on: %u KB of MEM2 at 0x%08x\n", kArenaBytes / 1024, arena);
+    return arena;
+}
+
+const Choice& choiceFor(uint32_t teamRecordAddress) {
+    static const Choice kNone;
+    if (!Enabled() || teamRecordAddress < kRecord) return kNone;
+    int slot = SlotOf(teamRecordAddress - kRecord);
+    if (slot < 0 && teamRecordAddress == kMatchSlot + kRecord) {
+        // The match's copy of a slot: only while it is that slot's team (a stale copy, or another
+        // team's, must not take the slot's choice).
+        const uint32_t index = Memory::Read8(kMatchSlot + 1);
+        const SlotNow now = SlotState(index);
+        uint32_t print = 0;
+        if (now.used && RecordPrint(teamRecordAddress, print) && print == now.fingerprint) slot = int(index);
+    }
+    return slot >= 0 && slot < int(kSlots) ? liveChoices()[size_t(slot)] : kNone;
+}
+
+bool SaveHooksEnabled() { return RuntimeConfigFile::ArrangeCustomMarks(false) && Enabled(); }
+
+Fingerprints CurrentFingerprints() {
+    Fingerprints out{};
+    for (uint32_t i = 0; i < kSlots; ++i) out[i] = SlotState(i).fingerprint;
+    return out;
+}
+
+uint32_t markIndexFor(const std::string& file) {
+    const auto found = std::find(g_registry.begin(), g_registry.end(), file);
+    if (found != g_registry.end()) return kGameMarks + uint32_t(found - g_registry.begin());
+    g_registry.push_back(file);
+    return kGameMarks + uint32_t(g_registry.size() - 1);
+}
+
+const std::string* markFileFor(uint32_t index) {
+    return index >= kGameMarks && index - kGameMarks < g_registry.size() ? &g_registry[index - kGameMarks] : nullptr;
+}
+
+namespace {
+// One custom picture, loaded lazily (only this file) into a cache slot: a mark as its 256 x 256
+// texture (art in 158 x 190) and 64 x 64 icon, a logo as its kLogoWidth x kLogoHeight texture.
+bool LoadPicture(Kind kind, const std::string& file, TextureRef& out) {
+    out = {};
+    if (!Enabled() || file.empty()) return false;
+    const std::string what = KindName(kind), key = KeyOf(kind, file);
+    const auto now = std::chrono::steady_clock::now();
+    if (const auto found = g_cache.find(key); found != g_cache.end() && found->second.slot >= 0 &&
+        g_owner[size_t(found->second.slot)] == key && now - found->second.checked < kRecheck) {
+        found->second.used = ++g_clock;
+        Fill(found->second.slot, out);
+        if (kind == Kind::Logo) out.iconTexture = out.iconPalette = 0;
+        return true;
+    }
+    static std::map<std::string, std::chrono::steady_clock::time_point> missing;  // file -> last failed stat
+    if (const auto gone = missing.find(key); gone != missing.end() && now - gone->second < kRecheck) return false;
+    const fs::path path = pathOf(FolderOf(kind), Entry{file, {}});
+    fs::file_time_type time;
+    uintmax_t size = 0;
+    if (!Stat(path, time, size)) {
+        LogOnce("missing:" + key, what + " '" + file + "' not found: the game " + what + " is shown");
+        missing[key] = now;
+        return false;
+    }
+    missing.erase(key);
+    Cached& cached = g_cache[key];
+    const bool same = cached.time == time && cached.size == size;
+    if (same && cached.slot >= 0 && g_owner[size_t(cached.slot)] == key) {
+        cached.used = ++g_clock;
+        cached.checked = now;
+        Fill(cached.slot, out);
+        if (kind == Kind::Logo) out.iconTexture = out.iconPalette = 0;
+        return true;
+    }
+    if (same && cached.failed) return false;
+    Rgba picture;
+    std::string why;
+    PngInfo info;
+    // Decode, fit and quantize on the host first: a picture this machine has no memory for (a
+    // 4096 x 4096 PNG is 64 MB of RGBA; Switch applet mode is short) fails like a damaged file.
+    Texture main, icon;
+    bool ok = false;
+    try {
+        ok = size <= kMaxFileBytes && Header(path, info) && Decode(path, picture, why);
+        if (ok && kind == Kind::Mark) {
+            main = MakeTexture(Canvas(picture, 256));
+            icon = MakeTexture(Canvas(picture, 64));
+        } else if (ok) {
+            main = MakeTexture(fit(picture, kLogoWidth, kLogoHeight));
+        }
+    } catch (const std::bad_alloc&) {
+        ok = false;
+        why = "out of memory";
+    }
+    if (!ok) {
+        if (why.empty()) why = size > kMaxFileBytes ? "larger than 8 MB" : "not a PNG of at most 4096 x 4096";
+        // The cache slot the file had (an older version of it) is free again.
+        if (cached.slot >= 0 && g_owner[size_t(cached.slot)] == key) g_owner[size_t(cached.slot)].clear();
+        cached = {-1, true, time, size, 0};
+        LogOnce("decode:" + key + ":" + std::to_string(size), what + " '" + file + "' not used: " + why);
+        return false;
+    }
+    const int slot = cached.slot >= 0 && g_owner[size_t(cached.slot)] == key ? cached.slot : FreeSlot();
+    const uint32_t base = SlotAddress(slot);
+    PutTexture(base + kTexels, base + kPalette, base + kTexDesc, base + kPalDesc, main);
+    if (kind == Kind::Mark) PutTexture(base + kIconTexels, base + kIconPalette, base + kIconTexDesc, base + kIconPalDesc, icon);
+    GxGuestWrite::NotifyWrite(base, kSlotBytes);
+    g_owner[size_t(slot)] = key;
+    cached = {slot, false, time, size, ++g_clock, now};
+    std::fprintf(stderr, "[arrange] %s '%s' loaded (%ux%u)\n", what.c_str(), file.c_str(), picture.width, picture.height);
+    Fill(slot, out);
+    if (kind == Kind::Logo) out.iconTexture = out.iconPalette = 0;
+    return true;
+}
+}  // namespace
+
+bool markTexture(const Choice& choice, TextureRef& out) { return LoadPicture(Kind::Mark, choice.mark, out); }
+
+bool logoTexture(const Choice& choice, TextureRef& out) { return LoadPicture(Kind::Logo, choice.logo, out); }
