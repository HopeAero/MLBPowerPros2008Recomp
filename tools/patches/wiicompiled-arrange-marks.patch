+                InputPrologue(ctx, s);
+                g_logo.pending = g_logo.original;
+                SyncLogo(ctx, s);
+                Sound(ctx, 0x1002);
+                return;
+            }
+        }
+    }
+    const std::vector<uint16_t> before = KeyboardText(ctx, s);
+    ctx->gpr[3] = s;
+    func_805B7FEC(ctx);
