diff --git a/runtime/include/arrange_marks.h b/runtime/include/arrange_marks.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/arrange_marks.h
@@ -0,0 +1,238 @@
+#pragma once
+// Custom PNG marks and logos per Arrange team: folder catalog and image fit (pure, no game
+// dependencies). Names the game draws come from label(); pixels are fitted to the game's texture
+// size by fit().
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+namespace arrange_marks {
+
+constexpr size_t kMaxEntries = 64;
+constexpr size_t kMaxFileBytes = 8u << 20;
+constexpr size_t kNameChars = 12;
+
+// file is UTF-8 (not the ANSI code page); rebuild the path with pathOf().
+struct Entry {
+    std::string file;   // real file name on disk
+    std::string label;  // text the game draws
+};
+
+namespace catalog_detail {
+
+// ASCII fold of U+0100..U+017F (Latin Extended-A).
+inline constexpr char kLatinExtA[] =
+    "AaAaAaCcCcCcCcDd"
+    "DdEeEeEeEeEeGgGg"
+    "GgGgHhHhIiIiIiIi"
+    "IiIiJjKkkLlLlLlL"
+    "lLlNnNnNnnNnOoOo"
+    "OoOoRrRrRrSsSsSs"
+    "SsTtTtTtUuUuUuUu"
+    "UuUuWwYyYZzZzZzs";
+
+inline char fold(uint32_t cp) {
+    if (cp < 0x80) return static_cast<char>(cp);
+    if (cp >= 0xC0 && cp <= 0xFF) {
+        switch (cp) {
+        case 0xC0: case 0xC1: case 0xC2: case 0xC3: case 0xC4: case 0xC5: return 'A';
+        case 0xC7: return 'C';
+        case 0xC8: case 0xC9: case 0xCA: case 0xCB: return 'E';
+        case 0xCC: case 0xCD: case 0xCE: case 0xCF: return 'I';
+        case 0xD0: return 'D';
+        case 0xD1: return 'N';
+        case 0xD2: case 0xD3: case 0xD4: case 0xD5: case 0xD6: case 0xD8: return 'O';
+        case 0xD9: case 0xDA: case 0xDB: case 0xDC: return 'U';
+        case 0xDD: return 'Y';
+        case 0xE0: case 0xE1: case 0xE2: case 0xE3: case 0xE4: case 0xE5: return 'A';
+        case 0xE7: return 'C';
+        case 0xE8: case 0xE9: case 0xEA: case 0xEB: return 'E';
+        case 0xEC: case 0xED: case 0xEE: case 0xEF: return 'I';
+        case 0xF0: return 'D';
+        case 0xF1: return 'N';
+        case 0xF2: case 0xF3: case 0xF4: case 0xF5: case 0xF6: case 0xF8: return 'O';
+        case 0xF9: case 0xFA: case 0xFB: case 0xFC: return 'U';
+        case 0xFD: case 0xFF: return 'Y';
+        default: return 0;  // AE, Thorn, sharp s, multiplication and division signs
+        }
+    }
+    if (cp >= 0x100 && cp <= 0x17F) return kLatinExtA[cp - 0x100];
+    return 0;
+}
+
+// Lenient UTF-8 decode: invalid bytes yield 0xFFFD (dropped later).
+inline uint32_t next(std::string_view s, size_t& i) {
+    unsigned char c = static_cast<unsigned char>(s[i++]);
+    if (c < 0x80) return c;
+    int extra = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : -1;
+    if (extra < 0 || c >= 0xF8) return 0xFFFD;
+    uint32_t cp = c & (0x3F >> extra);
+    for (int k = 0; k < extra; k++) {
+        if (i >= s.size() || (static_cast<unsigned char>(s[i]) & 0xC0) != 0x80) return 0xFFFD;
+        cp = (cp << 6) | (static_cast<unsigned char>(s[i++]) & 0x3F);
+    }
+    return cp;
+}
+
+inline std::string utf8(const std::filesystem::path& p) {
+    const std::u8string t = p.u8string();
+    return std::string(t.begin(), t.end());
+}
+
+inline std::string lower(std::string s) {
+    for (char& c : s)
+        if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+    return s;
+}
+
+}  // namespace catalog_detail
+
+// Text the game draws for a file stem: A-Z 0-9 space '-', Latin diacritics stripped, uppercase,
+// everything else dropped, spaces collapsed and trimmed, at most kNameChars characters.
+inline std::string label(std::string_view stem) {
+    std::string out;
+    for (size_t i = 0; i < stem.size();) {
+        char c = catalog_detail::fold(catalog_detail::next(stem, i));
+        if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+        bool keep = (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == ' ' || c == '-';
+        if (!keep) continue;
+        if (c == ' ' && (out.empty() || out.back() == ' ')) continue;
+        out.push_back(c);
+    }
+    if (out.size() > kNameChars) out.resize(kNameChars);
+    while (!out.empty() && out.back() == ' ') out.pop_back();
+    return out;
+}
+
+inline std::filesystem::path pathOf(const std::filesystem::path& folder, const Entry& entry) {
+    return folder / std::filesystem::path(std::u8string(entry.file.begin(), entry.file.end()));
+}
+
+// PNG files of a folder (by extension, size at most kMaxFileBytes), sorted case-insensitively by
+// stem, at most kMaxEntries. Equal labels get " 2", " 3"... A missing folder gives an empty list.
+inline std::vector<Entry> scan(const std::filesystem::path& folder) {
+    namespace fs = std::filesystem;
+    struct Found {
+        std::string file, stem, key;
+    };
+    std::vector<Found> found;
+    std::error_code ec;
+    fs::directory_iterator it(folder, ec), end;
+    for (; !ec && it != end; it.increment(ec)) {
+        std::error_code e1, e2;
+        if (!it->is_regular_file(e1) || e1) continue;
+        const fs::path& p = it->path();
+        std::string ext = catalog_detail::lower(catalog_detail::utf8(p.extension()));
+        if (ext != ".png") continue;
+        auto size = it->file_size(e2);
+        if (e2 || size == 0 || size > kMaxFileBytes) continue;
+        std::string stem = catalog_detail::utf8(p.stem());
+        found.push_back({catalog_detail::utf8(p.filename()), stem, catalog_detail::lower(stem)});
+    }
+    std::sort(found.begin(), found.end(), [](const Found& a, const Found& b) {
+        return a.key != b.key ? a.key < b.key : a.file < b.file;
+    });
+    std::vector<Entry> out;
+    for (const Found& f : found) {
+        if (out.size() >= kMaxEntries) break;
+        std::string base = label(f.stem);
+        if (base.empty()) base = "IMG";
+        std::string name = base;
+        for (int n = 2;; n++) {
+            bool taken = std::any_of(out.begin(), out.end(), [&](const Entry& e) { return e.label == name; });
+            if (!taken) break;
+            std::string suffix = " " + std::to_string(n);
+            std::string head = base.substr(0, kNameChars - suffix.size());
+            while (!head.empty() && head.back() == ' ') head.pop_back();
+            name = head + suffix;
+        }
+        out.push_back({f.file, name});
+    }
+    return out;
+}
+
+// The labels as the game shows them in a cell: at most `chars` characters (the room of the game's
+// text widget), trailing spaces trimmed, still unique (" 2", " 3"... replace the tail).
+inline std::vector<std::string> shownLabels(const std::vector<Entry>& entries, size_t chars = 10) {
+    std::vector<std::string> out;
+    for (const Entry& e : entries) {
+        std::string base = e.label.substr(0, chars);
+        while (!base.empty() && base.back() == ' ') base.pop_back();
+        std::string name = base;
+        for (int n = 2; std::find(out.begin(), out.end(), name) != out.end(); ++n) {
+            const std::string suffix = " " + std::to_string(n);
+            std::string head = base.substr(0, chars - std::min(chars, suffix.size()));
+            while (!head.empty() && head.back() == ' ') head.pop_back();
+            name = head + suffix;
+        }
+        out.push_back(name);
+    }
+    return out;
+}
+
+// A selector over "none" (-1) and `count` entries (0..count-1), one step left (-1) or right (+1),
+// wrapping at both ends. A current value outside -1..count-1 (a choice whose file is gone) moves
+// to "none" first.
+inline int cycleChoice(int count, int current, int step) {
+    if (count <= 0) return -1;
+    if (current < -1 || current >= count) return -1;
+    const int span = count + 1, at = current + 1;
+    return (at + (step < 0 ? span - 1 : 1)) % span - 1;
+}
+
+struct Rgba {
+    uint32_t width = 0, height = 0;
+    std::vector<uint8_t> pixels;
+};
+
+// Scale source uniformly to fit inside width x height (area-average box filter, alpha-weighted),
+// centered over transparent (all-zero) padding. Empty or malformed source gives a transparent image.
+inline Rgba fit(const Rgba& source, uint32_t width, uint32_t height) {
+    Rgba out;
+    out.width = width;
+    out.height = height;
+    out.pixels.assign(static_cast<size_t>(width) * height * 4, 0);
+    if (!width || !height || !source.width || !source.height ||
+        source.pixels.size() < static_cast<size_t>(source.width) * source.height * 4)
+        return out;
+    double scale = std::min(double(width) / source.width, double(height) / source.height);
+    uint32_t nw = std::clamp<uint32_t>(static_cast<uint32_t>(std::lround(source.width * scale)), 1, width);
+    uint32_t nh = std::clamp<uint32_t>(static_cast<uint32_t>(std::lround(source.height * scale)), 1, height);
+    uint32_t ox = (width - nw) / 2, oy = (height - nh) / 2;
+    double stepX = double(source.width) / nw, stepY = double(source.height) / nh;
+    for (uint32_t y = 0; y < nh; y++) {
+        double y0 = y * stepY, y1 = std::min<double>(source.height, y0 + stepY);
+        for (uint32_t x = 0; x < nw; x++) {
+            double x0 = x * stepX, x1 = std::min<double>(source.width, x0 + stepX);
+            double sr = 0, sg = 0, sb = 0, sa = 0, sw = 0;
+            for (uint32_t sy = static_cast<uint32_t>(y0); sy < y1 && sy < source.height; sy++) {
+                double wy = std::min<double>(sy + 1, y1) - std::max<double>(sy, y0);
+                for (uint32_t sx = static_cast<uint32_t>(x0); sx < x1 && sx < source.width; sx++) {
+                    double w = wy * (std::min<double>(sx + 1, x1) - std::max<double>(sx, x0));
+                    const uint8_t* px = &source.pixels[(static_cast<size_t>(sy) * source.width + sx) * 4];
+                    double a = px[3] * w;
+                    sr += px[0] * a;
+                    sg += px[1] * a;
+                    sb += px[2] * a;
+                    sa += a;
+                    sw += w;
+                }
+            }
+            if (sw <= 0 || sa <= 0) continue;
+            uint8_t* dst = &out.pixels[(static_cast<size_t>(oy + y) * width + ox + x) * 4];
+            dst[0] = static_cast<uint8_t>(std::lround(sr / sa));
+            dst[1] = static_cast<uint8_t>(std::lround(sg / sa));
+            dst[2] = static_cast<uint8_t>(std::lround(sb / sa));
+            dst[3] = static_cast<uint8_t>(std::lround(sa / sw));
+        }
+    }
+    return out;
+}
+
+}  // namespace arrange_marks
diff --git a/runtime/include/arrange_marks_native.h b/runtime/include/arrange_marks_native.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/arrange_marks_native.h
@@ -0,0 +1,64 @@
+#pragma once
+// Custom PNG marks for Arrange teams in the running game (src/hle/mlb/arrange_marks.cpp), behind the
+// launcher option [arrange] custom_marks. A custom mark is a virtual mark index >= kGameMarks that is
+// never written to the team record (+0x17 keeps a game mark, valid for the original game); the
+// chosen file lives in liveChoices() and travels in the main save's tail (arrange_marks_save.h).
+#include <cstdint>
+#include <string>
+
+#include "arrange_marks_save.h"
+
+namespace arrange_marks {
+
+constexpr uint32_t kGameMarks = 38;
+
+// Called once at boot by the heap setup (game_heaps.cpp) with the MEM2 arena [low, high): with the
+// option on, the marks' guest memory is taken from the top of the arena; returns the new high
+// (unchanged with the option off, or when the game's retail heap would not fit).
+uint32_t ReserveGuestMemory(uint32_t low, uint32_t high);
+
+// A custom mark in the game's own texture format, in guest memory reserved at boot. The two
+// descriptors are what the game's loaders return for a mark pack (fn_8000C330 / fn_8000C3E0):
+//   texture: {height << 16 | width, 9 (GX_TF_C8), texels, 0, 0, 1, 1, 0...}   (0x40 bytes)
+//   palette: {256 << 16, 2 (GX_TL_RGB5A3), entries, 0...}                     (0x20 bytes)
+// A mark widget (class 0x805BE408, vtable 0x80D3D920) draws it with +0xE4 = texture, the four
+// palette slots +0xE8..+0xF4 = palette, then fn_8000A77C(material +0xF8, 1, widget + 0xE4) and
+// fn_8000A790(material, 4, widget + 0xE8), as 0x805BE664 does for a game mark. The icon pair is the
+// same picture fitted to 64 x 64 (the size of the team-flag mark cells of pack 0x219).
+struct TextureRef {
+    uint32_t texture = 0, palette = 0;          // 256 x 256
+    uint32_t iconTexture = 0, iconPalette = 0;  // 64 x 64
+};
+
+// The main save hooks (nand_isfs.cpp) run only with the option on and its guest memory reserved: if
+// the reservation failed, a block already in the save is neither loaded nor rewritten.
+bool SaveHooksEnabled();
+// The fingerprints (recordFingerprint) of the 32 slots' team records as they are now, for the store.
+Fingerprints CurrentFingerprints();
+
+// The choice of the Arrange slot a team record belongs to: a record of the 32 slots of the main
+// block ([0x8104E1D8] + 0x3AC + i * 0x2448 + 0x42) or of the match's temporary slot (0x8102D730,
+// slot index at +1, used only while its record is that slot's team: same fingerprint). Empty for any
+// other record, and with the option off.
+const Choice& choiceFor(uint32_t teamRecordAddress);
+// The choice's mark, loaded lazily (only this file, cached by file name and date). False when the
+// option is off, nothing is chosen, or the file is missing, not a PNG, damaged or over 4096 x 4096.
+bool markTexture(const Choice& choice, TextureRef& out);
+// A custom logo replaces the letter logo of the TEAM LOGO box (the letters widget 0x805BA65C; on
+// Logo Text a box of about 160 x 87 of the widget's units, 560 x 199 px inside at 1920 x 1080 since
+// the 2D units are not square on 16:9), so it keeps about that box's proportions: the PNG is
+// fitted, centred and unstretched, into a kLogoWidth x kLogoHeight (2:1, the nearest the game's
+// sprites take: both sides powers of two, fn_8001D25C) C8 texture with an RGB5A3 palette (texture
+// and palette descriptors as above; iconTexture and iconPalette are 0). A wordmark fills the width
+// as the game's letters do; a tall picture gets the box's height. Same caps, lazy load and cache as
+// marks; from UserData/arrange/logos.
+constexpr uint32_t kLogoWidth = 256, kLogoHeight = 128;
+bool logoTexture(const Choice& choice, TextureRef& out);
+// The virtual mark index (>= kGameMarks, stable while the game runs) of a mark file, and back.
+uint32_t markIndexFor(const std::string& file);
+const std::string* markFileFor(uint32_t index);
+// COPY / DELETE (and every other path that rewrites a slot) keep the choices with the slots.
+void onSlotCopied(int from, int to);
+void onSlotDeleted(int slot);
+
+}  // namespace arrange_marks
diff --git a/runtime/include/arrange_marks_save.h b/runtime/include/arrange_marks_save.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/arrange_marks_save.h
@@ -0,0 +1,267 @@
+#pragma once
+// Custom PNG marks and logos per Arrange team (launcher option [arrange] custom_marks).
+//
+// The choices (a file name for the mark and one for the logo, per Arrange slot) travel in the free
+// tail of the main save pm3usma.dat. The game's data end at 0xD0050 (save descriptor 0xD0000 + 0x50
+// header): a save kept markers placed at 0xD0060, 0xD0410, 0xD2000 and 0xD3F00, and a save with
+// foreign bytes at 0xD3F00 loads (proven in game, docs/ingenieria-inversa.md, Arrange save). The block
+// sits at 0xD3000, beyond anything the save descriptor (0xD0400) may verify, and the record stays
+// valid for the original game.
+// Block (version 2): "MLBARRMK" (8), version u32 BE (4), FNV-1a 32 of the slot bytes u32 BE (4), then
+// 32 x (mark 32 bytes + logo 32 bytes, UTF-8, zero padded + fingerprint u32 BE of the slot's team
+// record when the choice was saved, recordFingerprint). Version 1 (no fingerprints) was never
+// published: it reads as Invalid.
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace arrange_marks {
+
+constexpr size_t kSlots = 32;
+constexpr size_t kNameBytes = 32;
+constexpr size_t kFingerprintBytes = 4;
+constexpr size_t kRowBytes = 2 * kNameBytes + kFingerprintBytes;
+constexpr size_t kHeaderBytes = 16;
+constexpr size_t kSaveBytes = 2192;
+static_assert(kSaveBytes == kHeaderBytes + kSlots * kRowBytes);
+constexpr uint32_t kVersion = 2;
+// File offset of the block in pm3usma.dat (ends 0xD3890); the game's data end at 0xD0050 (save
+// descriptor 0xD0000 + 0x50 header), the file at 0xD4000.
+// The game's load reads the file from 0 in 16 KB chunks and stops at 0xD0000 (NAND trace, Task 6):
+// it never reaches the data end. The load hook keys on this offset.
+constexpr uint32_t kMainSaveLoadEnd = 0xD0000;
+constexpr uint32_t kSaveFileOffset = 0xD3000;
+constexpr uint32_t kSaveFileSize = 0xD4000;
+static_assert(kSaveFileOffset >= 0xD0400 && kSaveFileOffset + kSaveBytes <= kSaveFileSize);
+
+struct Choice {
+    std::string mark, logo;
+    bool empty() const { return mark.empty() && logo.empty(); }
+    bool operator==(const Choice& other) const { return mark == other.mark && logo == other.logo; }
+    bool operator!=(const Choice& other) const { return !(*this == other); }
+};
+using Choices = std::array<Choice, kSlots>;
+using Fingerprints = std::array<uint32_t, kSlots>;
+enum class ReadStatus { Missing, Valid, Invalid };
+
+// Process-wide current choices: loaded when the main save is read, written when it is saved.
+inline Choices& liveChoices() {
+    static Choices choices;
+    return choices;
+}
+
+// What the last load of the main save brought, and what the store must respect.
+struct SaveState {
+    ReadStatus status = ReadStatus::Missing;  // of the last load (Missing before any)
+    Choices loaded;                           // the choices it brought (empty unless Valid)
+    Fingerprints fingerprints{};              // their teams' fingerprints (0 for empty rows)
+    bool unchecked = false;                   // loaded choices not yet checked against the records
+    bool changed = false;                     // a choice differed from the loaded ones at a store
+};
+inline SaveState& saveState() {
+    static SaveState state;
+    return state;
+}
+
+namespace detail {
+inline uint32_t fnv1a(const uint8_t* data, size_t size) {
+    uint32_t hash = 2166136261u;
+    for (size_t i = 0; i < size; ++i) hash = (hash ^ data[i]) * 16777619u;
+    return hash;
+}
+inline void put32(uint8_t* out, uint32_t value) {
+    for (int i = 3; i >= 0; --i) { out[i] = uint8_t(value); value >>= 8; }
+}
+inline uint32_t get32(const uint8_t* in) {
+    return uint32_t(in[0]) << 24 | uint32_t(in[1]) << 16 | uint32_t(in[2]) << 8 | in[3];
+}
+constexpr std::array<uint8_t, 8> magic{'M', 'L', 'B', 'A', 'R', 'R', 'M', 'K'};
+}  // namespace detail
+
+// The team record's identity (record = slot + 0x42, 0x37 bytes, big endian as in guest memory): the
+// name (+0x00, 10 font codes), the initial (+0x15) and the base team (+0x1A), each reduced to the bits
+// the main save keeps (field table 0x80CEB828 of the slot (un)packer 0x805A2738 / 0x805A31EC: a name
+// code is 13 bits, 0x1FFF and up reading back as 0xFFFF; the initial 5 bits; the base team 6 bits), so
+// a record and the same record after a save and a reload give the same value. Mark, colours, flags,
+// letters and uniform are left out: editing them is not a different team.
+constexpr size_t kRecordIdentityBytes = 0x1B;
+inline uint32_t recordFingerprint(const uint8_t* record) {
+    uint8_t identity[22];
+    for (size_t i = 0; i < 10; ++i) {
+        uint16_t code = uint16_t((record[2 * i] << 8 | record[2 * i + 1]) & 0x1FFF);
+        if (code == 0x1FFF) code = 0xFFFF;
+        identity[2 * i] = uint8_t(code >> 8);
+        identity[2 * i + 1] = uint8_t(code);
+    }
+    identity[20] = uint8_t(record[0x15] & 0x1F);
+    identity[21] = uint8_t(record[0x1A] & 0x3F);
+    return detail::fnv1a(identity, sizeof identity);
+}
+
+// fingerprints[i] goes with a non-empty choice only (an empty row stores 0).
+inline std::array<uint8_t, kSaveBytes> writeChoices(const Choices& choices, const Fingerprints& fingerprints) {
+    std::array<uint8_t, kSaveBytes> out{};
+    for (const auto& choice : choices)
+        if (choice.mark.size() > kNameBytes || choice.logo.size() > kNameBytes)
+            throw std::invalid_argument("arrange marks: file name longer than 32 bytes");
+    std::copy(detail::magic.begin(), detail::magic.end(), out.begin());
+    detail::put32(out.data() + 8, kVersion);
+    for (size_t i = 0; i < kSlots; ++i) {
+        uint8_t* row = out.data() + kHeaderBytes + i * kRowBytes;
+        std::copy(choices[i].mark.begin(), choices[i].mark.end(), row);
+        std::copy(choices[i].logo.begin(), choices[i].logo.end(), row + kNameBytes);
+        detail::put32(row + 2 * kNameBytes, choices[i].empty() ? 0 : fingerprints[i]);
+    }
+    detail::put32(out.data() + 12, detail::fnv1a(out.data() + kHeaderBytes, kSaveBytes - kHeaderBytes));
+    return out;
+}
+
+// out and fingerprints are left empty unless the result is Valid. Any other version (version 1 had
+// no fingerprints) is Invalid.
+inline ReadStatus readChoices(const uint8_t* data, size_t size, Choices& out, Fingerprints& fingerprints) {
+    out = Choices{};
+    fingerprints = Fingerprints{};
+    if (!data) return ReadStatus::Missing;
+    if (std::all_of(data, data + std::min(size, kSaveBytes), [](uint8_t b) { return b == 0; }))
+        return ReadStatus::Missing;
+    if (size < kSaveBytes || !std::equal(detail::magic.begin(), detail::magic.end(), data) ||
+        detail::get32(data + 8) != kVersion ||
+        detail::get32(data + 12) != detail::fnv1a(data + kHeaderBytes, kSaveBytes - kHeaderBytes))
+        return ReadStatus::Invalid;
+    Choices read;
+    Fingerprints prints{};
+    for (size_t i = 0; i < kSlots; ++i) {
+        const uint8_t* row = data + kHeaderBytes + i * kRowBytes;
+        const char* text = reinterpret_cast<const char*>(row);
+        size_t markLen = 0, logoLen = 0;
+        while (markLen < kNameBytes && text[markLen]) ++markLen;
+        while (logoLen < kNameBytes && text[kNameBytes + logoLen]) ++logoLen;
+        read[i].mark.assign(text, markLen);
+        read[i].logo.assign(text + kNameBytes, logoLen);
+        prints[i] = detail::get32(row + 2 * kNameBytes);
+    }
+    out = std::move(read);
+    fingerprints = prints;
+    return ReadStatus::Valid;
+}
+
+// Loaded choices against the records they were saved for: current[i] is the fingerprint of slot i's
+// record now, or nothing when the slot holds no team. A choice whose slot is empty or holds another
+// team (changed while the option was off: another run, Dolphin or a Wii) is dropped. Returns the
+// dropped slots.
+struct SlotNow {
+    bool used = false;
+    uint32_t fingerprint = 0;
+};
+inline std::vector<int> dropChangedTeams(Choices& choices, const Fingerprints& saved,
+                                         const std::array<SlotNow, kSlots>& current) {
+    std::vector<int> dropped;
+    for (size_t i = 0; i < kSlots; ++i) {
+        if (choices[i].empty()) continue;
+        if (current[i].used && current[i].fingerprint == saved[i]) continue;
+        choices[i] = Choice{};
+        dropped.push_back(int(i));
+    }
+    return dropped;
+}
+
+// Whether some slot has chosen `file` as its logo (logo = true) or its mark.
+inline bool isChosen(const Choices& choices, bool logo, const std::string& file) {
+    if (file.empty()) return false;
+    return std::any_of(choices.begin(), choices.end(),
+                       [&](const Choice& c) { return (logo ? c.logo : c.mark) == file; });
+}
+
+inline void copySlot(Choices& choices, int from, int to) {
+    if (from < 0 || to < 0 || from >= int(kSlots) || to >= int(kSlots)) return;
+    choices[to] = choices[from];
+}
+inline void clearSlot(Choices& choices, int slot) {
+    if (slot < 0 || slot >= int(kSlots)) return;
+    choices[slot] = Choice{};
+}
+
+inline bool IsMainSaveName(const char* fileName) {
+    return fileName && std::strcmp(fileName, "pm3usma.dat") == 0;
+}
+
+// A read of the main save loads the choices only when its chunk reaches the end of what the game's
+// load reads (kMainSaveLoadEnd, the Season precedent): the single-chunk reads from offset 0 the game
+// also makes (open checks) must not discard unsaved picks.
+inline bool LoadChunkReachesLoadEnd(uint32_t readAt, size_t bytesRead) {
+    return readAt < kMainSaveLoadEnd && uint64_t(readAt) + bytesRead >= kMainSaveLoadEnd;
+}
+// Reading the whole file is not always a load: to save, the SDK's NANDSafeOpen copies the old file
+// (read-only handle on pm3usma.dat) into /tmp/sys/pm3usma.dat (write handle) before the game writes
+// it, and that copy crosses the load end too. Loading then would replace unsaved picks with the old
+// file's (seen in game, Task 6). So no load while any main-save handle is open for writing.
+inline bool ShouldLoadOnRead(uint32_t readAt, size_t bytesRead, bool mainSaveWriteOpen) {
+    return !mainSaveWriteOpen && LoadChunkReachesLoadEnd(readAt, bytesRead);
+}
+
+// Main save hooks on the host file. `enabled` is the option with its guest memory reserved
+// (SaveHooksEnabled): off, nothing is read or written, so a block the file already has stays as it
+// is. The file position is preserved.
+// Load: fills liveChoices() and saveState(); a missing or Invalid block leaves the choices empty
+// (Invalid is reported). The loaded choices still have to be checked against the records once the
+// game has unpacked them (saveState().unchecked; dropChangedTeams).
+inline ReadStatus OnMainSaveLoad(FILE* file, bool enabled) {
+    if (!enabled || !file) return ReadStatus::Missing;
+    const long at = std::ftell(file);
+    if (at < 0) return ReadStatus::Missing;
+    std::array<uint8_t, kSaveBytes> block{};
+    size_t got = 0;
+    if (std::fseek(file, long(kSaveFileOffset), SEEK_SET) == 0)
+        got = std::fread(block.data(), 1, block.size(), file);
+    std::fseek(file, at, SEEK_SET);
+    SaveState& state = saveState();
+    state.status = readChoices(block.data(), got, state.loaded, state.fingerprints);
+    state.unchecked = state.status == ReadStatus::Valid &&
+                      std::any_of(state.loaded.begin(), state.loaded.end(), [](const Choice& c) { return !c.empty(); });
+    state.changed = false;
+    liveChoices() = state.loaded;
+    return state.status;
+}
+
+// Store: writes the block from liveChoices() with `current` (the fingerprints of the slots' records
+// now) at kSaveFileOffset, only when the file already spans it (a partial or fresh file is never
+// grown). After an Invalid load (a later version, a torn write) the block on disk is kept until a
+// choice differs from the loaded (empty) ones in this run: a save without changes must not erase
+// what a newer runtime wrote.
+enum class StoreResult { Written, NotSpanned, KeptInvalid, Disabled, Failed };
+inline StoreResult OnMainSaveStore(FILE* file, bool enabled, const Fingerprints& current) {
+    if (!enabled || !file) return StoreResult::Disabled;
+    SaveState& state = saveState();
+    if (liveChoices() != state.loaded) state.changed = true;
+    if (state.status == ReadStatus::Invalid && !state.changed) return StoreResult::KeptInvalid;
+    std::array<uint8_t, kSaveBytes> block;
+    try {
+        block = writeChoices(liveChoices(), current);
+    } catch (const std::invalid_argument&) {
+        return StoreResult::Failed;
+    }
+    const long at = std::ftell(file);
+    if (at < 0) return StoreResult::Failed;
+    bool ok = std::fseek(file, 0, SEEK_END) == 0;
+    if (ok) {
+        const long end = std::ftell(file);
+        if (end < 0) ok = false;
+        else if (uint64_t(end) < uint64_t(kSaveFileOffset) + kSaveBytes) {
+            std::fseek(file, at, SEEK_SET);
+            return StoreResult::NotSpanned;
+        }
+    }
+    ok = ok && std::fseek(file, long(kSaveFileOffset), SEEK_SET) == 0 &&
+         std::fwrite(block.data(), 1, block.size(), file) == block.size();
+    std::fflush(file);
+    std::fseek(file, at, SEEK_SET);
+    return ok ? StoreResult::Written : StoreResult::Failed;
+}
+
+}  // namespace arrange_marks
diff --git a/runtime/include/arrange_marks_texture.h b/runtime/include/arrange_marks_texture.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/arrange_marks_texture.h
@@ -0,0 +1,234 @@
+#pragma once
+// Custom PNG marks for Arrange teams: the game-side texture format (pure, no game dependencies).
+// The game's marks (env_arrange_logoNN) are C8 textures with RGB5A3 palettes; a custom mark is
+// converted to the same format so the game's own widgets draw it: pngHeader() checks a file
+// cheaply before it is listed, quantize() reduces the fitted RGBA picture to 256 RGB5A3 colours and
+// toC8() lays the indices out in GX 8x4 tiles.
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "arrange_marks.h"
+
+namespace arrange_marks {
+
+// Larger decoded pictures are rejected (a 4096 x 4096 RGBA picture is 64 MB while it is fitted).
+constexpr uint32_t kMaxPngSide = 4096;
+
+struct PngInfo {
+    uint32_t width = 0, height = 0;
+};
+
+namespace texture_detail {
+inline uint32_t crc32(const uint8_t* data, size_t size) {
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < size; ++i) {
+        crc ^= data[i];
+        for (int k = 0; k < 8; ++k) crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+inline uint32_t be32(const uint8_t* p) {
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+}
+}  // namespace texture_detail
+
+// The first 33 bytes of a PNG file: signature, then an IHDR chunk with a valid CRC and a size of
+// 1..kMaxPngSide on each side. Anything else (another format, a damaged start) is not a mark.
+inline bool pngHeader(const uint8_t* data, size_t size, PngInfo& out) {
+    static constexpr uint8_t kSignature[8] = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
+    out = {};
+    if (!data || size < 33 || !std::equal(kSignature, kSignature + 8, data)) return false;
+    if (texture_detail::be32(data + 8) != 13 || data[12] != 'I' || data[13] != 'H' || data[14] != 'D' || data[15] != 'R')
+        return false;
+    if (texture_detail::crc32(data + 12, 17) != texture_detail::be32(data + 29)) return false;
+    const uint32_t width = texture_detail::be32(data + 16), height = texture_detail::be32(data + 20);
+    if (!width || !height || width > kMaxPngSide || height > kMaxPngSide) return false;
+    out = {width, height};
+    return true;
+}
+
+// The chunk headers (length, type) from the signature to IEND, which must end the file exactly: a
+// file cut short (or padded) is not offered, without decompressing anything. read(offset, out8)
+// reads 8 bytes of the file. Walks at most kMaxPngChunks chunks.
+constexpr uint32_t kMaxPngChunks = 100000;
+template <typename Read>
+bool pngChunksComplete(uint64_t fileSize, Read read) {
+    uint64_t at = 8;
+    for (uint32_t n = 0; n < kMaxPngChunks; ++n) {
+        uint8_t head[8];
+        if (at + 12 > fileSize || !read(at, head)) return false;
+        const uint64_t next = at + 12 + texture_detail::be32(head);
+        if (next > fileSize) return false;
+        if (head[4] == 'I' && head[5] == 'E' && head[6] == 'N' && head[7] == 'D') return next == fileSize;
+        at = next;
+    }
+    return false;
+}
+
+// RGB5A3 as GX reads it: opaque 1RRRRRGGGGGBBBBB, otherwise 0AAARRRRGGGGBBBB. Nearly invisible
+// pixels become the single transparent value 0.
+inline uint16_t toRgb5a3(uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
+    if (a >= 0xE0) return uint16_t(0x8000 | (r >> 3) << 10 | (g >> 3) << 5 | (b >> 3));
+    if (a < 0x20) return 0;
+    return uint16_t((a >> 5) << 12 | (r >> 4) << 8 | (g >> 4) << 4 | (b >> 4));
+}
+inline std::array<uint8_t, 4> fromRgb5a3(uint16_t v) {
+    if (v & 0x8000)
+        return {uint8_t(((v >> 10) & 31) * 255 / 31), uint8_t(((v >> 5) & 31) * 255 / 31), uint8_t((v & 31) * 255 / 31), 255};
+    return {uint8_t(((v >> 8) & 15) * 17), uint8_t(((v >> 4) & 15) * 17), uint8_t((v & 15) * 17),
+            uint8_t(((v >> 12) & 7) * 255 / 7)};
+}
+
+struct Indexed {
+    uint32_t width = 0, height = 0;
+    std::array<uint16_t, 256> palette{};  // RGB5A3; unused entries are 0 (transparent)
+    std::vector<uint8_t> indices;         // row-major, one per pixel
+};
+
+// At most 256 RGB5A3 colours: the picture's own colours when they fit, otherwise a median cut of
+// them (weighted by how many pixels use each). Transparent pixels keep palette entry 0.
+inline Indexed quantize(const Rgba& image) {
+    Indexed out;
+    out.width = image.width;
+    out.height = image.height;
+    const size_t count = size_t(image.width) * image.height;
+    out.indices.assign(count, 0);
+    if (image.pixels.size() < count * 4) return out;
+    std::vector<uint16_t> values(count);
+    std::vector<uint32_t> uses(65536, 0);
+    for (size_t i = 0; i < count; ++i) {
+        const uint8_t* p = &image.pixels[i * 4];
+        values[i] = toRgb5a3(p[0], p[1], p[2], p[3]);
+        ++uses[values[i]];
+    }
+    struct Colour {
+        uint16_t value;
+        uint32_t weight;
+        std::array<int, 4> c;
+    };
+    std::vector<Colour> colours;
+    for (uint32_t v = 1; v < 65536; ++v)
+        if (uses[v]) {
+            const auto e = fromRgb5a3(uint16_t(v));
+            colours.push_back({uint16_t(v), uses[v], {e[0], e[1], e[2], e[3]}});
+        }
+    std::vector<int16_t> map(65536, -1);
+    map[0] = 0;  // transparent
+    const size_t room = 255;  // entry 0 stays transparent
+    if (colours.size() <= room) {
+        for (size_t i = 0; i < colours.size(); ++i) {
+            out.palette[i + 1] = colours[i].value;
+            map[colours[i].value] = int16_t(i + 1);
+        }
+    } else {
+        struct Box {
+            size_t begin, end;
+        };
+        std::vector<Box> boxes{{0, colours.size()}};
+        const auto spread = [&](const Box& b, int& channel) {
+            int best = -1;
+            for (int ch = 0; ch < 4; ++ch) {
+                int lo = 255, hi = 0;
+                for (size_t i = b.begin; i < b.end; ++i) {
+                    lo = std::min(lo, colours[i].c[ch]);
+                    hi = std::max(hi, colours[i].c[ch]);
+                }
+                if (hi - lo > best) { best = hi - lo; channel = ch; }
+            }
+            return best;
+        };
+        while (boxes.size() < room) {
+            size_t pick = boxes.size();
+            int pickChannel = 0;
+            uint64_t pickScore = 0;
+            for (size_t k = 0; k < boxes.size(); ++k) {
+                if (boxes[k].end - boxes[k].begin < 2) continue;
+                int channel = 0;
+                const int s = spread(boxes[k], channel);
+                uint64_t weight = 0;
+                for (size_t i = boxes[k].begin; i < boxes[k].end; ++i) weight += colours[i].weight;
+                const uint64_t score = uint64_t(s + 1) * weight;
+                if (s > 0 && score > pickScore) { pickScore = score; pick = k; pickChannel = channel; }
+            }
+            if (pick == boxes.size()) break;
+            Box b = boxes[pick];
+            std::sort(colours.begin() + long(b.begin), colours.begin() + long(b.end),
+                      [&](const Colour& x, const Colour& y) { return x.c[pickChannel] < y.c[pickChannel]; });
+            uint64_t total = 0, half = 0;
+            for (size_t i = b.begin; i < b.end; ++i) total += colours[i].weight;
+            size_t cut = b.begin + 1;
+            for (size_t i = b.begin; i < b.end - 1; ++i) {
+                half += colours[i].weight;
+                cut = i + 1;
+                if (half * 2 >= total) break;
+            }
+            boxes[pick] = {b.begin, cut};
+            boxes.push_back({cut, b.end});
+        }
+        std::vector<std::array<int, 4>> entries;
+        for (const Box& b : boxes) {
+            double sum[4] = {0, 0, 0, 0}, weight = 0;
+            for (size_t i = b.begin; i < b.end; ++i) {
+                for (int ch = 0; ch < 4; ++ch) sum[ch] += double(colours[i].c[ch]) * colours[i].weight;
+                weight += colours[i].weight;
+            }
+            uint8_t avg[4];
+            for (int ch = 0; ch < 4; ++ch) avg[ch] = uint8_t(std::clamp(sum[ch] / weight + 0.5, 0.0, 255.0));
+            const uint16_t value = toRgb5a3(avg[0], avg[1], avg[2], std::max<uint8_t>(avg[3], 0x20));
+            out.palette[entries.size() + 1] = value;
+            const auto e = fromRgb5a3(value);
+            entries.push_back({e[0], e[1], e[2], e[3]});
+        }
+        for (const Colour& c : colours) {
+            int best = 0;
+            long bestDistance = -1;
+            for (size_t k = 0; k < entries.size(); ++k) {
+                long d = 0;
+                for (int ch = 0; ch < 4; ++ch) {
+                    const long diff = long(c.c[ch]) - entries[k][ch];
+                    d += diff * diff * (ch == 3 ? 2 : 1);
+                }
+                if (bestDistance < 0 || d < bestDistance) { bestDistance = d; best = int(k); }
+            }
+            map[c.value] = int16_t(best + 1);
+        }
+    }
+    for (size_t i = 0; i < count; ++i) out.indices[i] = uint8_t(map[values[i]] < 0 ? 0 : map[values[i]]);
+    return out;
+}
+
+// GX C8: 8 x 4 texel tiles, tiles row by row. Width and height must be multiples of 8 and 4.
+inline size_t c8Offset(uint32_t x, uint32_t y, uint32_t width) {
+    return (size_t(y / 4) * (width / 8) + x / 8) * 32 + (y % 4) * 8 + x % 8;
+}
+inline std::vector<uint8_t> toC8(const Indexed& image) {
+    std::vector<uint8_t> out(size_t(image.width) * image.height, 0);
+    if (image.width % 8 || image.height % 4 || image.indices.size() < out.size()) return out;
+    for (uint32_t y = 0; y < image.height; ++y)
+        for (uint32_t x = 0; x < image.width; ++x)
+            out[c8Offset(x, y, image.width)] = image.indices[size_t(y) * image.width + x];
+    return out;
+}
+
+// A side x side icon drawn by a letter sprite of the game (cell w x h, pivot px, py: the sprite draws
+// its cell from -pivot to size - pivot, in its units) instead of the letter: the icon's sprite has its
+// pivot at the icon's centre, is moved by (dx, dy) of the sprite's units (the cell's centre) and scaled
+// by `scale` (the icon as tall as the cell's longer side).
+struct IconInCell {
+    float dx = 0, dy = 0;
+    float scale = 0;  // 0: no cell
+};
+inline IconInCell iconInCell(float w, float h, float px, float py, uint32_t side = 64) {
+    IconInCell out;
+    if (w <= 0 || h <= 0 || !side) return out;
+    out.scale = std::max(w, h) / float(side);
+    out.dx = w / 2 - px;
+    out.dy = h / 2 - py;
+    return out;
+}
+
+}  // namespace arrange_marks
