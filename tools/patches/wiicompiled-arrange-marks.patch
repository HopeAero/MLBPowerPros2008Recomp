diff --git a/runtime/src/hle/mlb/arrange_marks.cpp b/runtime/src/hle/mlb/arrange_marks.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/src/hle/mlb/arrange_marks.cpp
@@ -0,0 +1,2051 @@
+// Custom PNG marks for Arrange teams ([arrange] custom_marks): the Team Mark list of the Arrange team
+// creator ("Please set the team's mark", vtable 0x80D3D4B0) gets the user's PNG files after its 38
+// game marks, as cells of its own kind (pack 0x929 cell picture, the game's team-name text widget for
+// the name), chosen with the game's cursor, sounds and confirm, previewed in its TEAM MARK box.
+// Addresses and evidence: docs/ingenieria-inversa.md (Arrange teams; custom marks and logos).
+//
+// - A custom mark is a virtual mark index >= 38 (markIndexFor). It is never written to the team
+//   record: +0x17 keeps the game mark the team had (the original game, and anything not hooked,
+//   keeps reading a valid mark) and +0x1B keeps the 0x02 "own mark" flag. The file name goes to
+//   liveChoices()[slot] (saved in the main save's tail with the team's fingerprint, nand_isfs.cpp;
+//   checked against the teams when the game unpacks the slots, 0x805A263C).
+// - Its texture is the PNG fitted to the 158 x 190 art area of a 256 x 256 mark (and to 64 x 64),
+//   converted to the game's mark format (C8 with an RGB5A3 palette), in guest memory reserved at boot
+//   at the top of the MEM2 arena
+//   (ReserveGuestMemory, called by game_heaps.cpp). Only the file being shown is loaded.
+// - With the option off nothing is reserved, every override calls the original unchanged and the
+//   list is the game's 38 marks.
+// - Custom logos (UserData/arrange/logos) are chosen on the Logo Text screen (section at the end):
+//   one more row in its side column, previewed in its TEAM LOGO box; liveChoices()[slot].logo.
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <new>
+#include <set>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+#ifdef MKW_HAVE_LIBPNG
