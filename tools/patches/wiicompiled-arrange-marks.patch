+#include "arrange_marks.h"
+#include <cassert>
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+using namespace arrange_marks;
+namespace fs = std::filesystem;
+
+static void touch(const fs::path& p, const std::string& content = "png") {
+    std::ofstream(p, std::ios::binary) << content;
+}
+
+static int alpha(const Rgba& i, uint32_t x, uint32_t y) { return i.pixels[(y * i.width + x) * 4 + 3]; }
+
+int main() {
+    assert(label("Leones") == "LEONES");
+    assert(label("\xC3\x81guila \xC3\x91") == "AGUILA N");  // Águila Ñ
+    assert(label("los leones del caracas") == "LOS LEONES D");
+    assert(label("  a!!  b__c ") == "A BC");
+    assert(label("ni\xC3\xB1o-\xC3\xBC\xC3\xA7") == "NINO-UC");
+    assert(label("\xE2\x98\x85\xE2\x98\x85").empty());
+
+    fs::path tmp = fs::temp_directory_path() /
+                   ("mlb_arrange_marks_test_" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    fs::remove_all(tmp);
+    fs::create_directories(tmp / "sub");
+    touch(tmp / "b.png");
+    touch(tmp / "A.PNG");
+    touch(tmp / "x.txt");
+    touch(tmp / "big.png");
+    fs::resize_file(tmp / "big.png", kMaxFileBytes + 1);
+    touch(tmp / "dup.png");
+    touch(tmp / "DUP!.png");
+    auto e = scan(tmp);
+    assert(e.size() == 4);
+    assert(e[0].label == "A" && e[1].label == "B");
+    assert(e[2].label == "DUP" && e[3].label == "DUP 2");
+    assert(e[0].file == "A.PNG" && e[1].file == "b.png");
+    assert(scan(tmp / "no-existe").empty());
+    fs::remove_all(tmp);
+
+    // non-ASCII file name really on disk (UTF-8 end to end)
+    fs::create_directories(tmp);
+    {
+        fs::path real(u8"Águila niño.png");
+        touch(tmp / real);
+        auto u = scan(tmp);
+        assert(u.size() == 1 && u[0].label == "AGUILA NINO");
+        assert(fs::exists(pathOf(tmp, u[0])));
+    }
+    fs::remove_all(tmp);
+
+    // entry cap
+    fs::create_directories(tmp);
+    for (size_t i = 0; i < kMaxEntries + 5; i++) {
+        char name[32];
+        std::snprintf(name, sizeof name, "t%03zu.png", i);
+        touch(tmp / name);
+    }
+    assert(scan(tmp).size() == kMaxEntries);
+    fs::remove_all(tmp);
+
+    // fit
+    Rgba wide{4, 2, std::vector<uint8_t>(4 * 2 * 4, 255)};
+    auto f = fit(wide, 8, 8);
+    assert(f.width == 8 && f.height == 8);
+    assert(alpha(f, 0, 0) == 0 && alpha(f, 4, 4) == 255);
+    assert(alpha(f, 4, 1) == 0 && alpha(f, 4, 6) == 0);
+    assert(alpha(f, 0, 2) == 255 && alpha(f, 7, 5) == 255);
+    assert(fit(Rgba{}, 8, 8).pixels == std::vector<uint8_t>(8 * 8 * 4, 0));
+    Rgba bad{4, 4, std::vector<uint8_t>(3, 255)};
+    assert(fit(bad, 2, 2).pixels == std::vector<uint8_t>(2 * 2 * 4, 0));
+    // downscale keeps colour
+    Rgba red{16, 16, std::vector<uint8_t>(16 * 16 * 4)};
+    for (size_t i = 0; i < 256; i++) { red.pixels[i * 4] = 200; red.pixels[i * 4 + 3] = 255; }
+    auto d = fit(red, 4, 4);
+    assert(d.pixels[0] == 200 && d.pixels[3] == 255 && d.pixels[1] == 0);
+    // shownLabels: 10 characters, trailing spaces trimmed, unique
+    {
+        std::vector<Entry> in{{"a.png", "LOS LEONES D"}, {"b.png", "LOS LEONES X"}, {"c.png", "ESCUDO"},
+                              {"d.png", "ABCDEFGHI J"}};
+        auto s = shownLabels(in);
+        assert(s.size() == 4 && s[0] == "LOS LEONES" && s[1] == "LOS LEON 2" && s[2] == "ESCUDO");
+        assert(s[3] == "ABCDEFGHI");
+        assert(shownLabels({}).empty());
+    }
+    // cycleChoice: none (-1) and 0..count-1, both directions, wrapping
+    assert(cycleChoice(3, -1, +1) == 0 && cycleChoice(3, 0, +1) == 1 && cycleChoice(3, 2, +1) == -1);
+    assert(cycleChoice(3, -1, -1) == 2 && cycleChoice(3, 0, -1) == -1 && cycleChoice(3, 1, -1) == 0);
+    assert(cycleChoice(0, -1, +1) == -1 && cycleChoice(0, 5, -1) == -1);
+    assert(cycleChoice(2, 7, +1) == -1 && cycleChoice(2, -4, -1) == -1);  // a choice that left the list
+    std::puts("arrange_marks ok");
+}
diff --git a/runtime/tests/arrange_marks_texture_test.cpp b/runtime/tests/arrange_marks_texture_test.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/tests/arrange_marks_texture_test.cpp
@@ -0,0 +1,134 @@
+#include "arrange_marks_texture.h"
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <set>
+#include <vector>
+
+using namespace arrange_marks;
+
+static std::vector<uint8_t> header(uint32_t width, uint32_t height) {
+    std::vector<uint8_t> h = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A, 0, 0, 0, 13, 'I', 'H', 'D', 'R'};
+    for (uint32_t v : {width, height})
+        for (int s = 24; s >= 0; s -= 8) h.push_back(uint8_t(v >> s));
+    for (uint8_t b : {8, 6, 0, 0, 0}) h.push_back(b);
+    const uint32_t crc = texture_detail::crc32(h.data() + 12, 17);
+    for (int s = 24; s >= 0; s -= 8) h.push_back(uint8_t(crc >> s));
+    return h;
+}
+
+int main() {
+    // The well-known 1 x 1 RGBA PNG starts with this IHDR (CRC 0x1F15C489).
+    const std::vector<uint8_t> one = header(1, 1);
+    assert(one[29] == 0x1F && one[30] == 0x15 && one[31] == 0xC4 && one[32] == 0x89);
+    PngInfo info;
+    assert(pngHeader(one.data(), one.size(), info) && info.width == 1 && info.height == 1);
+    std::vector<uint8_t> big = header(4096, 300);
+    assert(pngHeader(big.data(), big.size(), info) && info.width == 4096 && info.height == 300);
+    big = header(4097, 10);
+    assert(!pngHeader(big.data(), big.size(), info));
+    std::vector<uint8_t> broken = header(64, 64);
+    broken[20] ^= 1;  // damaged size: the CRC no longer matches
+    assert(!pngHeader(broken.data(), broken.size(), info));
+    const std::vector<uint8_t> text = {'n', 'o', 't', ' ', 'a', ' ', 'p', 'n', 'g'};
+    assert(!pngHeader(text.data(), text.size(), info));
+    assert(!pngHeader(one.data(), 20, info));
+
+    // Chunk walk: IHDR, IDAT (5 bytes), IEND; cut short, padded, or without IEND it fails.
+    std::vector<uint8_t> file = header(1, 1);
+    for (uint8_t b : std::initializer_list<uint8_t>{0, 0, 0, 5, 'I', 'D', 'A', 'T', 1, 2, 3, 4, 5, 0, 0, 0, 0}) file.push_back(b);
+    for (uint8_t b : std::initializer_list<uint8_t>{0, 0, 0, 0, 'I', 'E', 'N', 'D', 0xAE, 0x42, 0x60, 0x82}) file.push_back(b);
+    const auto walk = [](const std::vector<uint8_t>& f, uint64_t size) {
+        return pngChunksComplete(size, [&](uint64_t at, uint8_t* out) {
+            if (at + 8 > f.size()) return false;
+            std::copy(f.begin() + long(at), f.begin() + long(at) + 8, out);
+            return true;
+        });
+    };
+    assert(walk(file, file.size()));
+    std::vector<uint8_t> cut(file.begin(), file.end() - 20);
+    assert(!walk(cut, cut.size()));
+    std::vector<uint8_t> padded = file;
+    padded.push_back(0);
+    assert(!walk(padded, padded.size()));
+    std::vector<uint8_t> noEnd(file.begin(), file.end() - 12);
+    assert(!walk(noEnd, noEnd.size()));
+
+    assert(toRgb5a3(255, 0, 0, 255) == 0xFC00);
+    assert(toRgb5a3(0, 0, 0, 0) == 0 && toRgb5a3(200, 10, 10, 0x1F) == 0);
+    assert(toRgb5a3(255, 255, 255, 0x80) == 0x4FFF);
+    const auto red = fromRgb5a3(0xFC00);
+    assert(red[0] == 255 && red[1] == 0 && red[2] == 0 && red[3] == 255);
+
+    // Few colours: kept exactly, transparent pixels on entry 0.
+    Rgba small;
+    small.width = 8;
+    small.height = 4;
+    small.pixels.assign(8 * 4 * 4, 0);
+    for (uint32_t i = 0; i < 16; ++i) {
+        small.pixels[i * 4] = 255;
+        small.pixels[i * 4 + 3] = 255;
+    }
+    Indexed q = quantize(small);
+    assert(q.indices.size() == 32 && q.indices[0] != 0 && q.indices[31] == 0);
+    assert(q.palette[q.indices[0]] == 0xFC00 && q.palette[0] == 0);
+
+    // Many colours (a 256 x 256 gradient with a transparent border): at most 256 entries, close colours.
+    Rgba grad;
+    grad.width = grad.height = 256;
+    grad.pixels.resize(256 * 256 * 4);
+    for (uint32_t y = 0; y < 256; ++y)
+        for (uint32_t x = 0; x < 256; ++x) {
+            uint8_t* p = &grad.pixels[(y * 256 + x) * 4];
+            p[0] = uint8_t(x);
+            p[1] = uint8_t(y);
+            p[2] = uint8_t((x * 7 + y * 3) & 255);
+            p[3] = (x < 8 || y < 8) ? 0 : 255;
+        }
+    q = quantize(grad);
+    std::set<uint16_t> used;
+    long worst = 0;
+    for (uint32_t y = 0; y < 256; ++y)
+        for (uint32_t x = 0; x < 256; ++x) {
+            const uint8_t index = q.indices[y * 256 + x];
+            used.insert(q.palette[index]);
+            if (x < 8 || y < 8) {
+                assert(index == 0);
+                continue;
+            }
+            assert(index != 0);
+            const auto c = fromRgb5a3(q.palette[index]);
+            const uint8_t* p = &grad.pixels[(y * 256 + x) * 4];
+            for (int ch = 0; ch < 3; ++ch) worst = std::max(worst, std::labs(long(c[ch]) - p[ch]));
+        }
+    assert(used.size() <= 256 && used.size() > 200);
+    assert(worst < 96);
+
+    // C8 tiles of 8 x 4: texel (9, 5) of a 16-wide picture is in tile (1, 1), row 1, column 1.
+    assert(c8Offset(0, 0, 16) == 0 && c8Offset(7, 0, 16) == 7 && c8Offset(0, 1, 16) == 8);
+    assert(c8Offset(8, 0, 16) == 32 && c8Offset(9, 5, 16) == 3 * 32 + 8 + 1);
+    Indexed tiles;
+    tiles.width = 16;
+    tiles.height = 8;
+    for (uint32_t i = 0; i < 128; ++i) tiles.indices.push_back(uint8_t(i));
+    const auto c8 = toC8(tiles);
+    assert(c8.size() == 128 && c8[c8Offset(9, 5, 16)] == 5 * 16 + 9);
+
+    // An icon in a letter's cell: as tall as the longer side, centred on the cell whatever the pivot.
+    {
+        const IconInCell top = iconInCell(26, 34, 0, 0);  // pivot at the cell's top left
+        assert(std::fabs(top.scale - 34.0f / 64) < 1e-6f && top.dx == 13 && top.dy == 17);
+        const IconInCell centred = iconInCell(26, 34, 13, 17);  // pivot already at the centre
+        assert(centred.dx == 0 && centred.dy == 0);
+        // The icon's box (pivot 32, 32, size 64) scaled and moved covers the cell's height, centred.
+        const float y0 = top.dy - 32 * top.scale, y1 = top.dy + 32 * top.scale;
+        assert(std::fabs(y0) < 1e-4f && std::fabs(y1 - 34) < 1e-4f);
+        const IconInCell wide = iconInCell(64, 32, 32, 16);
+        assert(wide.scale == 1.0f && wide.dx == 0 && wide.dy == 0);
+        assert(iconInCell(0, 10, 0, 0).scale == 0 && iconInCell(10, -1, 0, 0).scale == 0);
+    }
+
+    std::puts("arrange_marks_texture_test: ok");
+    return 0;
+}
