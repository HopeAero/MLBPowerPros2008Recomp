+// Blocks the calling guest thread on the retrace queue until the next retrace (VIWaitForRetrace).
+void SleepUntilNextRetrace(CpuContext* cpu)
+{
+    const int32_t irqState = OS__DisableInterrupts_801a65ac();
+    uint32_t retraceCount = 0;
+    {
+        std::lock_guard<std::mutex> lock(g_viMutex);
+        EnsureInitializedLocked();
+        retraceCount = g_vi.retraceCount;
+    }
+    for (;;) {
+        cpu->gpr[3] = kViRetraceQueueAddr;
+        OSSleepThread_HLE_801aa9b8(cpu);
+        std::lock_guard<std::mutex> lock(g_viMutex);
+        EnsureInitializedLocked();
+        if (g_vi.retraceCount != retraceCount) {
+            break;
+        }
+    }
+    OS__RestoreInterrupts_801a65d4(irqState);
+}
+
+// MLB's frame loop (func_800472B4) waits only when it is early: `if (VIGetRetraceCount() == last)
+// VIWaitForRetrace();`. On a host that cannot hold 60 fps it never blocks, and the cooperative
+// scheduler never runs a READY lower-priority thread: on a phone's little cores the boot loader
+// (priority 24) starved and the intro never ended. Hardware has idle time in that loop, so once
+// such a thread has waited kLowerPriorityStarvation the caller sleeps to the next retrace, that
+// late frame quantized to vblank as on hardware. Addresses as in hle/os/os_internal.h.
+constexpr auto kLowerPriorityStarvation = 100ms;
+constexpr uint32_t kOSRunningContextAddr = 0x800000e4u;
+constexpr uint32_t kSchedulerPendingFlagAddr = 0x8031b270u;   // READY mask, bit 31 - priority
+constexpr uint32_t kSchedulerDisableCountAddr = 0x8031b268u;
+constexpr uint32_t kThreadStateOffset = 0x2C8u;
+constexpr uint32_t kThreadPriorityOffset = 0x2D0u;
+Clock::time_point s_lowerPriorityReadySince{};  // guest threads only, one host thread
+
+bool LowerPriorityThreadStarved()
+{
+    if (!Fiber::GuestFiberManager::IsInitialized() || !OS_HLE_InterruptsEnabled() ||
+        ::Memory::Read32(kSchedulerDisableCountAddr) != 0 || VI_HLE_IsAdvancingRetrace()) {
+        return false;
+    }
+    const uint32_t running = ::Memory::Read32(kOSRunningContextAddr);
+    if (running == 0 || ::Memory::Read16(running + kThreadStateOffset) != 2) {
+        return false;
+    }
+    const uint32_t priority = ::Memory::Read32(running + kThreadPriorityOffset);
+    const uint32_t lowerMask = priority >= 31 ? 0u : (1u << (31 - priority)) - 1u;
+    const auto now = Clock::now();
+    if ((::Memory::Read32(kSchedulerPendingFlagAddr) & lowerMask) == 0) {
+        s_lowerPriorityReadySince = now;
+        return false;
+    }
+    return now - s_lowerPriorityReadySince >= kLowerPriorityStarvation;
+}
