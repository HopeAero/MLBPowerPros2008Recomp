index 2c46300..d1384fc 100644
--- a/runtime/src/hle/os/os_scheduler.cpp
+++ b/runtime/src/hle/os/os_scheduler.cpp
@@ -11,6 +11,53 @@
 #include "runtime_log.h"
 #include "os_internal.h"
 
+#include <algorithm>
+#include <array>
+#include <chrono>
+
+namespace {
+// When SelectThread last switched to a thread of each priority (the starvation guard reads it).
+std::array<std::chrono::steady_clock::time_point, 32> g_lastScheduledAt{};
+// When a READY lower-priority thread was first seen by the guard; guest threads, one host thread.
+std::chrono::steady_clock::time_point g_lowerPriorityReadySince{};
+} // namespace
+
+// MLB's frame loop (func_800472B4) waits only when it is early: `if (VIGetRetraceCount() == last)
+// VIWaitForRetrace();`. The console holds 60 fps there, so the wait always comes and lower-priority
+// threads run in it. A host that cannot hold 60 fps never reaches the wait, and the cooperative
+// scheduler then never runs a READY lower-priority thread: on a phone's little cores the boot loader
+// (priority 24) starved and the intro never ended. VIGetRetraceCount asks this, and sleeps to the
+// next retrace when it says so: a host-side scheduling fix, not hardware behavior. True when the
+// running thread may sleep here and a READY thread of lower priority has gone `starvation` without
+// being scheduled.
+bool OS_HLE_LowerPriorityThreadStarved(std::chrono::steady_clock::duration starvation)
+{
+    if (!Fiber::GuestFiberManager::IsInitialized() || !OS_HLE_InterruptsEnabled() ||
+        ::Memory::Read32(kSchedulerIdleFlagAddr) != 0 || VI_HLE_IsAdvancingRetrace()) {
+        return false;
+    }
+    const uint32_t running = ::Memory::Read32(kOSRunningContextAddr);
+    if (running == 0 || ::Memory::Read32(kOSCurrentContextAddr) != running ||
+        ::Memory::Read16(running + kThreadStateOffset) != 2) {
+        return false;
+    }
+    const uint32_t priority = ::Memory::Read32(running + kThreadPriorityOffset);
+    const uint32_t lowerMask = priority >= 31 ? 0u : (1u << (31 - priority)) - 1u;
+    if ((::Memory::Read32(kSchedulerPendingFlagAddr) & lowerMask) == 0) {
+        g_lowerPriorityReadySince = {};
+        return false;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (g_lowerPriorityReadySince == std::chrono::steady_clock::time_point{}) {
+        g_lowerPriorityReadySince = now;
+    }
+    auto since = g_lowerPriorityReadySince;
+    for (uint32_t p = priority + 1; p < g_lastScheduledAt.size(); ++p) {
+        since = std::max(since, g_lastScheduledAt[p]);
+    }
+    return now - since >= starvation;
+}
