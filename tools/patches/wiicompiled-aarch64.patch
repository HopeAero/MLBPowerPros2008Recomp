diff --git a/runtime/tests/aarch64_abi_tests.cpp b/runtime/tests/aarch64_abi_tests.cpp
new file mode 100644
index 0000000..f0b746f
--- /dev/null
+++ b/runtime/tests/aarch64_abi_tests.cpp
@@ -0,0 +1,12 @@
+// Linux aarch64 (and devkitA64) make plain char unsigned; x86 and macOS arm64, where the
+// translator output and the runtime were tested, make it signed. The build passes -fsigned-char.
+#include <type_traits>
+
+static_assert(std::is_signed_v<char>, "translated code and the runtime assume signed char (x86, macOS arm64)");
+
+int main() {
+    char c = static_cast<char>(0xF0);
+    if (int(c) != -16) return 1;  // sign extension like x86
+    if (sizeof(void*) != 8) return 2;
+    return 0;
+}
