diff --git a/runtime/tests/player_password_tests.cpp b/runtime/tests/player_password_tests.cpp
new file mode 100644
index 0000000..2c350c2
--- /dev/null
+++ b/runtime/tests/player_password_tests.cpp
@@ -0,0 +1,34 @@
+#include "player_password.h"
+
+#include <cstdio>
+
+static int failures = 0;
+static void Check(bool ok, const char* what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+int main() {
+    using namespace player_password;
+    Check(Palette().size() == 84 && Palette()[0] == "A" && Palette()[26] == "a" && Palette()[52] == "1" &&
+              Palette()[61] == "+" && Palette()[83] == "⇔",
+          "palette order");
+    // A row of the password in the photo, as the screen shows it and as typed in ASCII.
+    const auto screen = Parse("=+9 LFL bSS rRv 7?d 4+C\n+3b Q◇& p□% $Fs !cZ ≠h⇔");
+    const auto typed = Parse("=+9LFLbSSrRv7?d4+C +3bQ◇&p■%$Fs!cZ!=h<->");
+    Check(screen.error.empty() && screen.indices.size() == 36, "a screen row reads");
+    Check(typed.error.empty() && typed.indices == screen.indices, "ASCII stand-ins read the same");
+    Check(Format(screen.indices) == "=+9 LFL bSS rRv 7?d 4+C\n+3b Q◇& p□% $Fs !cZ ≠h⇔", "formats as the screen");
+    Check(Parse(Format(screen.indices)).indices == screen.indices, "round trip");
+    Check(Parse("ABC 0").indices.back() == 14, "zero is read as O");
+    Check(!Parse("AB~").error.empty() && Parse("AB~").indices.empty(), "an unknown character is an error");
+    Check(!Parse("   ").error.empty(), "empty text is an error");
+    std::string tooLong(157, 'A');
+    Check(!Parse(tooLong).error.empty(), "more than 156 characters is an error");
+    Check(Parse("- / @ ^ * ->").indices == std::vector<int>({62, 65, 70, 72, 81, 82}), "symbol stand-ins");
+    if (failures) return 1;
+    std::printf("player_password_tests: ok\n");
+    return 0;
+}
