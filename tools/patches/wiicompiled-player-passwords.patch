diff --git a/runtime/src/hle/mlb/player_password.cpp b/runtime/src/hle/mlb/player_password.cpp
new file mode 100644
index 0000000..09a6582
--- /dev/null
+++ b/runtime/src/hle/mlb/player_password.cpp
@@ -0,0 +1,562 @@
+// Player passwords through the clipboard or a file (player_password.h): Ctrl+V (or the Paste / Import
+// buttons) on My Data > Password Input puts a password into the screen, as if typed; then OK takes it
+// as usual. Ctrl+C (or Copy / Export) on Password Display gives the shown one.
+#include "player_password.h"
+
+#include <SDL3/SDL.h>
+#include <dolphin/pad.h>
+#include <imgui.h>
+
+#include <algorithm>
+#include <cctype>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <utility>
+
+#include "abi_bridge.h"
+#include "aurora_events.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "power_pros_ui.h"
+#include "ppc_runtime.h"
+
+namespace player_password {
+namespace {
+
+// The Password Input screen (vtable 0x80DAC73C; its update 0x8083F9E4 is slot 14): characters as
+// palette codes (u16) at +0x3FB8, their count (u32) at +0x3FB4, empty slots 0xFFFF; each slot's text
+// object at +0x3B10 + slot * 4, redrawn by its virtual +0x3C (object, &code, 1). Its state at +0x2938
+// (1: typing, 0x8083FCC8).
+constexpr uint32_t kInputCount = 0x3FB4, kInputChars = 0x3FB8, kInputCells = 0x3B10, kInputState = 0x2938;
+constexpr uint32_t kPaletteTable = 0x80DAC500u;
+
+// The text of the last Password Display grid (0x8067A764 > 0x80677CB8), or 0.
+uint32_t g_gridText = 0;
+
+std::atomic<bool> g_copyRequested{false};
+
+// The grid's password as palette indices: empty if it is not one (no grid, or another kind of text).
+std::vector<int> ShownPassword() {
+    std::vector<int> shown;
+    if (!g_gridText || !Memory::Contains(g_gridText, kMaxLength * 2)) return shown;
+    for (uint32_t i = 0; i < kMaxLength; ++i) {
+        const uint16_t code = Memory::Read16(g_gridText + i * 2);
+        if (code == 0xFFFF) break;
+        int index = -1;
+        for (int k = 0; k < kPaletteSize; ++k)
+            if ((Memory::Read16(kPaletteTable + static_cast<uint32_t>(k) * 2) & 0x1FFF) == (code & 0x1FFF)) index = k;
+        if (index < 0) return {};
+        shown.push_back(index);
+    }
+    return shown;
+}
+
+std::mutex g_mutex;
+std::string g_pending;  // text waiting for the screen (under g_mutex)
+std::atomic<bool> g_havePending{false};
+std::atomic<int64_t> g_inputSeen{0};  // when the screen last updated while typing (steady clock, ms)
+std::string g_notice;                 // shown for a few seconds
+bool g_noticeError = false;
+std::chrono::steady_clock::time_point g_noticeUntil{};
+
+int64_t NowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+// The View or Delete Custom Players screen whose grid that is (vtable 0x80DAC8F0; +0x5620 is its page,
+// 10 while a password is displayed), or 0: the Copy button shows while that page is open.
+constexpr uint32_t kPlayersVtable = 0x80DAC8F0u, kPlayersPage = 0x5620, kPasswordPage = 10;
+uint32_t g_playersScreen = 0;
+
+bool DisplayOpen() {
+    return g_playersScreen && Memory::Read32(g_playersScreen) == kPlayersVtable &&
+           Memory::Read32(g_playersScreen + kPlayersPage) == kPasswordPage;
+}
+bool InputOpen() { return NowMs() - g_inputSeen < 300; }
+
+void Notice(std::string text, bool error) {
+    std::fprintf(stderr, "[password] %s\n", text.c_str());
+    g_notice = std::move(text);
+    g_noticeError = error;
+    g_noticeUntil = std::chrono::steady_clock::now() + std::chrono::seconds(6);
+}
+
+void Queue(std::string text) {
+    std::lock_guard lock(g_mutex);
+    g_pending = std::move(text);
+    g_havePending = true;
+}
+
+// File dialogs answer on another thread: the chosen path waits here for OnHostFrame.
+std::string g_exportText, g_exportPath, g_importPath;  // under g_mutex
+
+void SDLCALL OnExportChosen(void*, const char* const* files, int) {
+    if (!files || !files[0]) return;  // cancelled, or no dialog on this system
+    std::lock_guard lock(g_mutex);
+    g_exportPath = files[0];
+}
+void SDLCALL OnImportChosen(void*, const char* const* files, int) {
+    if (!files || !files[0]) return;
+    std::lock_guard lock(g_mutex);
+    g_importPath = files[0];
+}
+
+constexpr SDL_DialogFileFilter kFileFilters[] = {{"Player password", "txt"}, {"All files", "*"}};
+
+// The shown player's name (the record's first field: up to 10 u16 font codes, 0xFFFF after the last),
+// set by the grid hook below.
+std::string g_playerName;
+
+// <user data>/Players: where Export saves with a controller and the Import list looks.
+std::filesystem::path PlayersFolder() { return RuntimeConfigFile::ApplicationDataDirectory() / "Players"; }
+
+std::string FileName() {
+    std::string name;
+    for (const char c : g_playerName)
+        name += (std::isalnum(static_cast<unsigned char>(c)) || c == '.' || c == ' ') ? c : '_';
+    while (!name.empty() && (name.back() == ' ' || name.back() == '.')) name.pop_back();
+    return (name.empty() ? "player" : name) + ".txt";
+}
+
+// Export: with the mouse, a save dialog anywhere (starting in Players); with a controller (no dialog
+// to drive), straight into Players.
+void Export(bool dialog) {
+    const std::vector<int> shown = ShownPassword();
+    if (shown.empty()) return;
+    const std::filesystem::path path = PlayersFolder() / RuntimeConfigFile::PathFromUtf8(FileName());
+    std::error_code ec;
+    std::filesystem::create_directories(path.parent_path(), ec);
+    {
+        std::lock_guard lock(g_mutex);
+        g_exportText = Format(shown) + "\n";
+        if (!dialog) {
+            g_exportPath = RuntimeConfigFile::PathToUtf8(path);
+            return;
+        }
+    }
+    // Outside the lock: a dialog may answer before returning.
+    const std::string start = RuntimeConfigFile::PathToUtf8(path);
+    SDL_ShowSaveFileDialog(OnExportChosen, nullptr, SDL_GetKeyboardFocus(), kFileFilters, 2, start.c_str());
+}
+
+// Import: a list of Players' files, driven by the D-pad and A / B or the mouse; "Browse..." opens the
+// system's open dialog for a file elsewhere.
+struct Picker {
+    bool open = false;
+    std::vector<std::filesystem::path> files;  // newest first
+    int index = 0;
+};
+Picker g_picker;  // under g_mutex
+std::atomic<int> g_pickerMove{0};
+std::atomic<bool> g_pickerChoose{false}, g_pickerCancel{false};
+
+void OpenPicker() {
+    std::vector<std::pair<std::filesystem::file_time_type, std::filesystem::path>> found;
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator(PlayersFolder(), ec))
+        if (entry.is_regular_file(ec) && entry.path().extension() == ".txt")
+            found.emplace_back(entry.last_write_time(ec), entry.path());
+    std::sort(found.begin(), found.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+    std::lock_guard lock(g_mutex);
+    g_picker = {true, {}, 0};
+    for (auto& [time, path] : found) g_picker.files.push_back(std::move(path));
+    g_pickerMove = 0, g_pickerChoose = false, g_pickerCancel = false;
+}
+
+void Browse() {
+    const std::string start = RuntimeConfigFile::PathToUtf8(PlayersFolder()) + "/";
+    SDL_ShowOpenFileDialog(OnImportChosen, nullptr, SDL_GetKeyboardFocus(), kFileFilters, 2, start.c_str(), false);
+}
+
+// The list over the game; the last row is "Browse...".
+void DrawPicker(const ImVec4& game, float fontScale) {
+    std::unique_lock lock(g_mutex);
+    if (!g_picker.open) return;
+    const int rows = static_cast<int>(g_picker.files.size()) + 1;
+    g_picker.index = std::clamp(g_picker.index + g_pickerMove.exchange(0), 0, rows - 1);
+    int chosen = g_pickerChoose.exchange(false) ? g_picker.index : -1;
+    bool close = g_pickerCancel.exchange(false);
+    ImGui::SetNextWindowPos(ImVec2(game.x + game.z * 0.5f, game.y + game.w * 0.45f), ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSize(ImVec2(game.z * 0.5f, 0), ImGuiCond_Always);
+    ImGui::SetNextWindowBgAlpha(0.95f);
+    if (ImGui::Begin("Import a player", nullptr,
+                     ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoResize |
+                         ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoNav)) {
+        ImGui::SetWindowFontScale(fontScale);
+        if (g_picker.files.empty())
+            ImGui::TextWrapped("No players in %s yet: export one, or put .txt files there.",
+                               RuntimeConfigFile::PathToUtf8(PlayersFolder()).c_str());
+        for (int i = 0; i < rows; ++i) {
+            const bool browse = i == rows - 1;
+            const std::string label = browse ? "Browse..." : RuntimeConfigFile::PathToUtf8(g_picker.files[i].stem());
+            if (ImGui::Selectable((label + "##" + std::to_string(i)).c_str(), i == g_picker.index)) chosen = i;
+            if (i == g_picker.index) ImGui::SetScrollHereY();
+        }
+        ImGui::Separator();
+        ImGui::TextDisabled("A: import    B: cancel");
+    }
+    ImGui::End();
+    const bool browse = chosen == rows - 1;
+    if (chosen >= 0 && !browse) g_importPath = RuntimeConfigFile::PathToUtf8(g_picker.files[chosen]);
+    if (chosen >= 0 || close || !InputOpen()) g_picker.open = false;
+    lock.unlock();
+    if (browse) Browse();
+}
+
+bool PickerOpen() {
+    std::lock_guard lock(g_mutex);
+    return g_picker.open;
+}
+
+// A controller presses the buttons with X and Y (the GameCube pad the game reads; the screens do not
+// use them), and drives the Import list.
+std::atomic<bool> g_padFirst{false}, g_padSecond{false};
+
+void Call(CpuContext* ctx, uint32_t target, void (*invoke)(CpuContext*)) {
+    const uint32_t lr = ctx->lr;
+    ctx->lr = target;
+    invoke(ctx);
+    ctx->lr = lr;
+}
+
+// Puts the password into the screen as if typed, redrawing every slot.
+void Paste(CpuContext* ctx, uint32_t screen, const std::string& text) {
+    const Parsed parsed = Parse(text);
+    if (!parsed.error.empty()) {
+        Notice("Not a password: " + parsed.error, true);
+        return;
+    }
+    for (int i = 0; i < kMaxLength; ++i) {
+        const uint32_t slot = screen + kInputChars + static_cast<uint32_t>(i) * 2;
+        const uint16_t code = i < static_cast<int>(parsed.indices.size())
+                                  ? Memory::Read16(kPaletteTable + static_cast<uint32_t>(parsed.indices[i]) * 2)
+                                  : 0xFFFFu;
+        Memory::Write16(slot, code);
+        const uint32_t cell = Memory::Read32(screen + kInputCells + static_cast<uint32_t>(i) * 4);
+        if (!cell) continue;
+        const uint32_t draw = Memory::Read32(Memory::Read32(cell) + 0x3C);
+        ctx->gpr[3] = cell, ctx->gpr[4] = slot, ctx->gpr[5] = 1;
+        const uint32_t lr = ctx->lr;
+        ctx->ctr = draw, ctx->lr = draw;
+        InvokeIndirectCpu(draw, ctx);
+        ctx->lr = lr;
+    }
+    Memory::Write32(screen + kInputCount, static_cast<uint32_t>(parsed.indices.size()));
+    char message[160];
+    std::snprintf(message, sizeof message,
+                  "Password pasted (%d characters). Go to OK and press A.",
+                  static_cast<int>(parsed.indices.size()));
+    Notice(message, false);
+}
+
+}  // namespace
+
+void HandleSdlEvent(const SDL_Event& event) {
+    if (event.type != SDL_EVENT_KEY_DOWN || event.key.repeat || !(event.key.mod & SDL_KMOD_CTRL)) return;
+    if (event.key.scancode == SDL_SCANCODE_C) g_copyRequested = true;
+    if (event.key.scancode == SDL_SCANCODE_V) {
+        char* text = SDL_GetClipboardText();
+        Queue(text ? text : "");
+        SDL_free(text);
+    }
+}
+
+void OnHostFrame() {
+    // WIICOMPILED_PASSWORD_PASTE=<file>: the file's text is pasted as Ctrl+V would, then the file goes
+    // (scripted tests, which cannot press keys in the window).
+    static const char* testFile = std::getenv("WIICOMPILED_PASSWORD_PASTE");
+    if (testFile && *testFile) {
+        std::error_code ec;
+        const std::filesystem::path path = std::filesystem::u8path(testFile);
+        if (std::filesystem::exists(path, ec)) {
+            std::ifstream in(path, std::ios::binary);
+            std::string text((std::istreambuf_iterator<char>(in)), {});
+            in.close();
+            std::filesystem::remove(path, ec);
+            Queue(std::move(text));
+        }
+    }
+    if (g_copyRequested.exchange(false)) {
+        const std::vector<int> shown = ShownPassword();
+        if (shown.empty()) {
+            Notice("To copy a password, open it in My Data > View or Delete Custom Players > Password Display.", true);
+        } else {
+            const std::string text = Format(shown);
+            SDL_SetClipboardText(text.c_str());
+            char message[160];
+            std::snprintf(message, sizeof message,
+                          "Password copied (%d characters): paste it anywhere as text.",
+                          static_cast<int>(shown.size()));
+            Notice(message, false);
+        }
+    }
+    // WIICOMPILED_PASSWORD_SHOWN=<file>: the shown password as Ctrl+C would copy it (scripted tests).
+    static const char* shownFile = std::getenv("WIICOMPILED_PASSWORD_SHOWN");
+    if (shownFile && *shownFile) {
+        const std::vector<int> shown = ShownPassword();
+        if (!shown.empty()) std::ofstream(std::filesystem::u8path(shownFile), std::ios::binary) << Format(shown);
+    }
+    std::string exportPath, exportText, importPath;
+    {
+        std::lock_guard lock(g_mutex);
+        exportPath = std::exchange(g_exportPath, {});
+        exportText = g_exportText;
+        importPath = std::exchange(g_importPath, {});
+    }
+    if (!exportPath.empty()) {
+        std::ofstream out(RuntimeConfigFile::PathFromUtf8(exportPath), std::ios::binary);
+        out << exportText;
+        Notice(out ? "Player saved to " + exportPath : "Could not write " + exportPath, !out);
+    }
+    if (!importPath.empty()) {
+        std::ifstream in(RuntimeConfigFile::PathFromUtf8(importPath), std::ios::binary);
+        if (!in) Notice("Could not read " + importPath, true);
+        else Queue(std::string((std::istreambuf_iterator<char>(in)), {}));
+    }
+    // Not taken by the screen within half a second: it is not open.
+    if (g_havePending && NowMs() - g_inputSeen > 500) {
+        g_havePending = false;
+        Notice("To paste a password, open My Data > Password Input.", true);
+    }
+}
+
+// Where the game's picture is in the window (x, y, width, height): 4:3 without widescreen, a 16:9 box
+// with "force 16:9", otherwise all of it (stretched).
+ImVec4 GameRect(const ImVec2& window) {
+    const float aspect = !RuntimeConfigFile::WidescreenEnabled(true) ? 4.0f / 3.0f
+                         : MkwForceAspect169Requested()              ? 16.0f / 9.0f
+                                                                     : window.x / window.y;
+    const float w = std::min(window.x, window.y * aspect), h = w / aspect;
+    return ImVec4((window.x - w) * 0.5f, (window.y - h) * 0.5f, w, h);
+}
+
+// A button drawn like the game's OK / INSERT / EXIT (power_pros_ui.h style, no game assets): dark
+// rim, white rim, glossy gradient body, the pad key as a round badge and slanted outlined lettering;
+// the game's red cursor ring while the mouse is on it.
+struct PlateColours {
+    ImU32 top, bottom, ink;
+};
+void GamePlate(ImDrawList* dl, ImVec2 a, ImVec2 b, const PlateColours& c, const char* key, const char* label,
+               bool hovered, bool held) {
+    using namespace power_pros_ui;
+    const float h = b.y - a.y, e = std::max(1.0f, h * 0.045f), r = h * 0.3f;
+    if (held) a.y += e, b.y += e;
+    dl->AddRectFilled(ImVec2(a.x, a.y + e * 2), ImVec2(b.x, b.y + e * 2), Rgba(0, 20, 70, 90), r);
+    dl->AddRectFilled(a, b, c.ink, r);
+    dl->AddRectFilled(ImVec2(a.x + e, a.y + e), ImVec2(b.x - e, b.y - e), IM_COL32_WHITE, r - e);
+    const ImVec2 ia(a.x + e * 2.2f, a.y + e * 2.2f), ib(b.x - e * 2.2f, b.y - e * 2.2f);
+    int start = dl->VtxBuffer.Size;
+    dl->AddRectFilled(ia, ib, IM_COL32_WHITE, r - e * 2);
+    Shade(dl, start, ia.y, ib.y, c.top, held ? c.ink : c.bottom);
+    const float gh = (ib.y - ia.y) * 0.45f;  // gloss on the top half
+    start = dl->VtxBuffer.Size;
+    dl->AddRectFilled(ImVec2(ia.x + r * 0.3f, ia.y + e * 0.6f), ImVec2(ib.x - r * 0.3f, ia.y + gh), Rgba(255, 255, 255, 120),
+                      gh * 0.5f);
+    Shade(dl, start, ia.y, ia.y + gh, IM_COL32_WHITE, c.top);
+    if (hovered) dl->AddRect(ImVec2(a.x - e * 2, a.y - e * 2), ImVec2(b.x + e * 2, b.y + e * 2), Rgba(240, 30, 70), r + e * 2, 0, e * 1.6f);
+
+    // The pad key, round like the game's A / B hints.
+    ImFont* font = g_title ? g_title : ImGui::GetFont();
+    const float cy = (a.y + b.y) * 0.5f, kr = h * 0.27f, kx = ia.x + kr + e * 1.5f;
+    dl->AddCircleFilled(ImVec2(kx, cy), kr, IM_COL32_WHITE, 24);
+    dl->AddCircleFilled(ImVec2(kx, cy), kr - e, c.ink, 24);
+    const float ks = kr * 1.25f;
+    const ImVec2 kz = TextSize(font, ks, key);
+    dl->AddText(font, ks, ImVec2(kx - kz.x * 0.5f, cy - kz.y * 0.5f), IM_COL32_WHITE, key);
+
+    // The label, as large as fits, slanted like the game's lettering.
+    const float left = kx + kr + e * 2.5f, room = ib.x - left - e * 2.5f;
+    const float size = std::min(h * 0.72f, h * 0.72f * room / std::max(1.0f, TextSize(font, h * 0.72f, label).x));
+    const ImVec2 tz = TextSize(font, size, label);
+    start = dl->VtxBuffer.Size;
+    LogoText(dl, font, size, ImVec2(left + (room - tz.x) * 0.5f, cy - tz.y * 0.5f), c.top, c.bottom, label,
+             IM_COL32_WHITE, c.ink);
+    for (int i = start; i < dl->VtxBuffer.Size; ++i) dl->VtxBuffer[i].pos.x += (cy - dl->VtxBuffer[i].pos.y) * 0.2f;
+}
+
+// Two buttons in a box of the game's picture (fractions of it), one under the other or side by side;
+// returns which was pressed (0 or 1), or -1.
+int ButtonPair(const char* id, const ImVec4& game, float x, float y, float w, float h, bool sideBySide,
+               const char* const labels[2], const char* const tips[2]) {
+    const ImVec2 at(game.x + x * game.z, game.y + y * game.w), size(w * game.z, h * game.w);
+    const float gap = game.w * 0.012f;
+    const ImVec2 button = sideBySide ? ImVec2((size.x - gap) * 0.5f, size.y) : ImVec2(size.x, (size.y - gap) * 0.5f);
+    ImGui::SetNextWindowPos(at, ImGuiCond_Always);
+    ImGui::SetNextWindowSize(size, ImGuiCond_Always);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(gap, gap));
+    int pressed = -1;
+    if (ImGui::Begin(id, nullptr,
+                     ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav |
+                         ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoBackground |
+                         ImGuiWindowFlags_NoScrollbar)) {
+        // Orange like the game's OK, blue for the second.
+        static const PlateColours kColours[2] = {
+            {IM_COL32(255, 196, 90, 255), IM_COL32(236, 96, 10, 255), IM_COL32(150, 30, 10, 255)},
+            {IM_COL32(120, 200, 255, 255), IM_COL32(20, 96, 214, 255), IM_COL32(10, 36, 120, 255)}};
+        static const char* const keys[2] = {"X", "Y"};
+        for (int i = 0; i < 2; ++i) {
+            if (i && sideBySide) ImGui::SameLine();
+            if (ImGui::InvisibleButton(labels[i], button)) pressed = i;
+            const bool hovered = ImGui::IsItemHovered(), held = ImGui::IsItemActive();
+            GamePlate(ImGui::GetWindowDrawList(), ImGui::GetItemRectMin(), ImGui::GetItemRectMax(), kColours[i], keys[i],
+                      labels[i], hovered, held);
+            if (hovered && ImGui::BeginTooltip()) {
+                ImGui::SetWindowFontScale(std::max(1.0f, game.w / 720.0f) * 1.1f);
+                ImGui::TextUnformatted(tips[i]);
+                ImGui::EndTooltip();
+            }
+        }
+    }
+    ImGui::End();
+    ImGui::PopStyleVar(2);
+    return pressed;
+}
+
+void DrawNotice() {
+    const ImGuiIO& io = ImGui::GetIO();
+    // Buttons over the game while a password screen is open. Password Input: Paste and Import in the
+    // empty corner under OK / INSERT / EXIT. Password Display: Copy and Export on the footer bar.
+    const bool display = DisplayOpen(), input = !display && InputOpen();
+    const ImVec4 game = GameRect(io.DisplaySize);
+    // A controller's X / Y press the first / second button.
+    const bool padFirst = g_padFirst.exchange(false), padSecond = g_padSecond.exchange(false);
+    if (input) {
+        static const char* const labels[2] = {"PASTE", "IMPORT"};
+        static const char* const tips[2] = {"Paste a password from the clipboard (or Ctrl+V)", "Import a player file saved with Export"};
+        const int pressed = ButtonPair("Password input buttons", game, 0.044f, 0.768f, 0.155f, 0.15f, false, labels, tips);
+        if (pressed == 0 || padFirst) {
+            char* text = SDL_GetClipboardText();
+            Queue(text ? text : "");
+            SDL_free(text);
+        }
+        if (pressed == 1 || padSecond) OpenPicker();
+        DrawPicker(game, std::max(1.0f, game.w / 720.0f) * 1.4f);
+    }
+    if (display) {
+        static const char* const labels[2] = {"COPY", "EXPORT"};
+        static const char* const tips[2] = {"Copy this password to the clipboard (or Ctrl+C)", "Export this player as a file to share"};
+        const int pressed = ButtonPair("Password display buttons", game, 0.52f, 0.936f, 0.32f, 0.054f, true, labels, tips);
+        if (pressed == 0 || padFirst) g_copyRequested = true;
+        if (pressed == 1 || padSecond) Export(pressed == 1);
+    }
+    if (g_notice.empty() || std::chrono::steady_clock::now() > g_noticeUntil) return;
+    // Above the footer while Password Display's buttons are on it.
+    const float noticeY = display ? game.y + game.w * 0.92f : io.DisplaySize.y - 24.0f;
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, noticeY), ImGuiCond_Always, ImVec2(0.5f, 1.0f));
+    ImGui::SetNextWindowBgAlpha(0.85f);
+    if (ImGui::Begin("Password notice", nullptr,
+                     ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs |
+                         ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav |
+                         ImGuiWindowFlags_NoSavedSettings)) {
+        ImGui::SetWindowFontScale(std::max(1.0f, io.DisplaySize.y / 720.0f) * 1.3f);
+        ImGui::TextColored(g_noticeError ? ImVec4(1, 0.55f, 0.4f, 1) : ImVec4(1, 1, 1, 1), "%s", g_notice.c_str());
+    }
+    ImGui::End();
+}
+
+}  // namespace player_password
+
+// 0x8083F9E4 (Password Input screen): its update, as the original (the state at +0x2938 picks the
+// step); while typing (state 1) it first takes a pasted password.
+extern "C" void MLB_PasswordInputUpdate_8083F9E4(CpuContext* ctx) {
+    using namespace player_password;
+    const uint32_t screen = ctx->gpr[3];
+    Call(ctx, 0x807A58E8u, InvokeDirectCpu<0x807A58E8u>);
+    const uint32_t state = Memory::Read32(screen + kInputState);
+    if (state == 1) {
+        g_inputSeen = NowMs();
+        if (g_havePending.exchange(false)) {
+            std::string text;
+            {
+                std::lock_guard lock(g_mutex);
+                text = std::move(g_pending);
+            }
+            Paste(ctx, screen, text);
+        }
+    }
+    ctx->gpr[3] = screen;
+    switch (state) {
+    case 0: Call(ctx, 0x808411D4u, InvokeDirectCpu<0x808411D4u>); break;
+    case 1: Call(ctx, 0x8083FCC8u, InvokeDirectCpu<0x8083FCC8u>); break;
+    case 2: Call(ctx, 0x8084142Cu, InvokeDirectCpu<0x8084142Cu>); break;
+    case 3: Call(ctx, 0x80841494u, InvokeDirectCpu<0x80841494u>); break;
+    case 4: Call(ctx, 0x8084150Cu, InvokeDirectCpu<0x8084150Cu>); break;
+    case 5: Call(ctx, 0x80841590u, InvokeDirectCpu<0x80841590u>); break;
+    case 6: Call(ctx, 0x808416DCu, InvokeDirectCpu<0x808416DCu>); break;
+    case 7: Call(ctx, 0x80841778u, InvokeDirectCpu<0x80841778u>); break;
+    case 8: Call(ctx, 0x80841800u, InvokeDirectCpu<0x80841800u>); break;
+    case 9: Call(ctx, 0x808418D0u, InvokeDirectCpu<0x808418D0u>); break;
+    case 10: Call(ctx, 0x80841918u, InvokeDirectCpu<0x80841918u>); break;
+    case 11: Call(ctx, 0x80842928u, InvokeDirectCpu<0x80842928u>); break;
+    case 12: Call(ctx, 0x80842960u, InvokeDirectCpu<0x80842960u>); break;
+    case 14: Call(ctx, 0x8083FAD8u, InvokeDirectCpu<0x8083FAD8u>); break;
+    default: break;
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8083F9E4, MLB_PasswordInputUpdate_8083F9E4, (CpuContext* ctx), (ctx));
+
+// 0x80677CB8 (grid text, player): as the original, `obj + 0x548` and 0x8058CCD0. Its only caller,
+// 0x8067A764, makes a player's password for a Password Display grid: it copies the player there, then
+// 0x80677D88 / 0x80677F50 encode it into `obj` (u16 codes from the tables at 0x80D52998, the colour in
+// the high bits dropped; 0xFFFF after the last). The grid is kept so Ctrl+C reads the finished text.
+extern "C" void MLB_PasswordGridText_80677CB8(CpuContext* ctx) {
+    player_password::g_gridText = ctx->gpr[3];
+    // The caller's r31 is still its own: the players screen when 0x80845760 shows a password.
+    const uint32_t caller = ctx->gpr[31];
+    player_password::g_playersScreen =
+        Memory::Contains(caller, 4) && Memory::Read32(caller) == player_password::kPlayersVtable ? caller : 0;
+    // The player's name, for Export's file name: font codes as in the palette, 0 a space, 4 a dot.
+    const uint32_t player = ctx->gpr[4];
+    std::string name;
+    for (uint32_t i = 0; i < 10 && Memory::Contains(player + i * 2, 2); ++i) {
+        const uint16_t code = Memory::Read16(player + i * 2);
+        if (code == 0xFFFF) break;
+        std::string_view c = code == 0 ? " " : code == 4 ? "." : "_";
+        for (int k = 0; k < player_password::kPaletteSize; ++k)
+            if ((Memory::Read16(player_password::kPaletteTable + static_cast<uint32_t>(k) * 2) & 0x1FFF) == (code & 0x1FFF))
+                c = player_password::Palette()[k];
+        name += c;
+    }
+    player_password::g_playerName = name;
+    ctx->gpr[3] += 0x548;
+    player_password::Call(ctx, 0x8058CCD0u, InvokeDirectCpu<0x8058CCD0u>);
+}
+PPC_NATIVE_OVERRIDE_VOID(80677CB8, MLB_PasswordGridText_80677CB8, (CpuContext* ctx), (ctx));
+
+// From PADRead (pad.cpp), before the game sees the pads: on a password screen X and Y press the
+// first and second button; while the Import list is open, the D-pad / stick, A and B drive it and
+// the game sees nothing.
+extern "C" void MLB_PasswordPadButtons(PADStatus* statuses, uint32_t count) {
+    using namespace player_password;
+    static uint16_t previous[PAD_CHANMAX] = {};
+    static int8_t previousStick[PAD_CHANMAX] = {};
+    const bool picker = PickerOpen(), display = DisplayOpen(), input = !display && InputOpen();
+    for (uint32_t i = 0; i < count && i < PAD_CHANMAX; ++i) {
+        PADStatus& pad = statuses[i];
+        const uint16_t pressed = pad.button & ~previous[i];
+        const int8_t stick = pad.stickY > 40 ? 1 : pad.stickY < -40 ? -1 : 0;
+        const int stickPressed = stick != previousStick[i] ? stick : 0;
+        previous[i] = pad.button, previousStick[i] = stick;
+        if (picker) {
+            if (pressed & PAD_BUTTON_UP || stickPressed > 0) g_pickerMove -= 1;
+            if (pressed & PAD_BUTTON_DOWN || stickPressed < 0) g_pickerMove += 1;
+            if (pressed & PAD_BUTTON_A) g_pickerChoose = true;
+            if (pressed & PAD_BUTTON_B) g_pickerCancel = true;
+            pad.button = 0, pad.stickX = pad.stickY = pad.substickX = pad.substickY = 0;
+            continue;
+        }
+        if (!display && !input) continue;
+        if (pressed & PAD_BUTTON_X) g_padFirst = true;
+        if (pressed & PAD_BUTTON_Y) g_padSecond = true;
+        pad.button &= ~(PAD_BUTTON_X | PAD_BUTTON_Y);
+    }
+}
